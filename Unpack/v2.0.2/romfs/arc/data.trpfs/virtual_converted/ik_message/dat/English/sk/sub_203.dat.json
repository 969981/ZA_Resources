  "initialKey": 0,
  "messages": [
    {
      "displayText": "Pii hya?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "0050006900690020006800790061003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>\nOh my! What is it, Hoopa?<U+0010><U+0001>븁\nDoes <U+0010><U+0002>Ā<U+0000> have something\nthat’s<U+0010><U+0001>븀\ngot<U+0010><U+0001>븀\nyou<U+0010><U+0001>븀\nexcited?<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Do I hear the crinkle of a candy packet in your\nsatchel?<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 840,
      "rawDecodedUtf16Hex": "0044006F002000490020006800650061007200200074006800650020006300720069006E006B006C00650020006F006600200061002000630061006E006400790020007000610063006B0065007400200069006E00200079006F00750072000A007300610074006300680065006C003F00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Yeah, it’s Popping Candy",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "0059006500610068002C0020006900742019007300200050006F007000700069006E0067002000430061006E006400790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Do you want to try some?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "0044006F00200079006F0075002000770061006E007400200074006F002000740072007900200073006F006D0065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Oh dear... I confess I’m a bit nervous about\nPopping Candy’s explosive sensation.<U+0010><U+0001>븁\nBut perhaps this could be educational.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "I think I would like to try some, if that’s all right.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "00490020007400680069006E006B0020004900200077006F0075006C00640020006C0069006B006500200074006F002000740072007900200073006F006D0065002C002000690066002000740068006100742019007300200061006C006C002000720069006700680074002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Goodness!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1444,
      "rawDecodedUtf16Hex": "0047006F006F0064006E006500730073002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "I’ve just had a vision—a vision of a wonderful\nnew donut!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1472,
      "rawDecodedUtf16Hex": "00492019007600650020006A00750073007400200068006100640020006100200076006900730069006F006E2014006100200076006900730069006F006E0020006F00660020006100200077006F006E00640065007200660075006C000A006E0065007700200064006F006E00750074002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Give me just a moment,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1596,
      "rawDecodedUtf16Hex": "00100002BD06000000470069007600650020006D00650020006A007500730074002000610020006D006F006D0065006E0074002C000A0010000201000000002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "All right! I’ve come up with a suitable recipe.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "0041006C006C00200072006900670068007400210020004920190076006500200063006F006D006500200075007000200077006900740068002000610020007300750069007400610062006C00650020007200650063006900700065002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "This donut’s flavor profile must have at least\n40 points in sweet, 200 in spicy, 400 in sour,<U+0010><U+0001>븀\n280 in bitter, and 40 in fresh.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Let me know when you’d like to try making it!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "004C006500740020006D00650020006B006E006F00770020007700680065006E00200079006F0075201900640020006C0069006B006500200074006F00200074007200790020006D0061006B0069006E0067002000690074002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2144,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "The <U+0010><U+0002>＀<U+0006>Plasma-Glazed Donut<U+0010><U+0002>＀<U+0000> turned out as lovely—\nand shocking—as I’d hoped. It does the Popping<U+0010><U+0001>븀\nCandy justice!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "I wonder what fascinating pocket of Hyperspace\nLumiose awaits you once Hoopa eats this donut.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "0010000201000000002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "I need you to come to the <U+0010><U+0002>＀<U+0006>station front<U+0010><U+0002>＀<U+0000>, ASAP!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 9,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2620,
      "rawDecodedUtf16Hex": "00490020006E00650065006400200079006F007500200074006F00200063006F006D006500200074006F0020007400680065002000100002FF00000600730074006100740069006F006E002000660072006F006E007400100002FF000000002C00200041005300410050002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "It sounds like trouble’s come calling again.<U+0010><U+0001>븁\nBut whatever it is, I know you can take care of it,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 7,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2960,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Look up there!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2972,
      "rawDecodedUtf16Hex": "004C006F006F006B002000750070002000740068006500720065002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "I bet even you haven’t seen a hyperspace\ndistortion quite like that before, have you?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 3012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "I sure haven’t",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 3192,
      "rawDecodedUtf16Hex": "00490020007300750072006500200068006100760065006E201900740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Yellow is new",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3224,
      "rawDecodedUtf16Hex": "00590065006C006C006F00770020006900730020006E006500770000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "I called you because I don’t know what kind of\nPokémon might be waiting in there.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Hey, kid. Got a favor to ask.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3424,
      "rawDecodedUtf16Hex": "004800650079002C0020006B00690064002E00200047006F0074002000610020006600610076006F007200200074006F002000610073006B002E00100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "We’ve picked up on a real beast of a hyperspace\ndistortion!<U+0010><U+0001>븁\nI’ll bet there’s one heck of a powerful Pokémon in\nthere. If it Rogue Mega Evolves, we’re in trouble.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3492,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 169
    },
    {
      "displayText": "Can you and the rest of your usual trio handle it?\nI’ll contact Ms. Mega Stones and your buddy.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Oh, and before I forget—the distortion’s at the\n<U+0010><U+0002>＀<U+0006>station front<U+0010><U+0002>＀<U+0000> of the Gare de Lumiose.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 9,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 4032,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Yup, I’m right there",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4228,
      "rawDecodedUtf16Hex": "005900750070002C002000492019006D0020007200690067006800740020007400680065007200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Yeah, we found it",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "0059006500610068002C00200077006500200066006F0075006E00640020006900740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Ha! I should’ve guessed. In that case, do your\nthing!<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4308,
      "rawDecodedUtf16Hex": "00480061002100200049002000730068006F0075006C006420190076006500200067007500650073007300650064002E00200049006E0020007400680061007400200063006100730065002C00200064006F00200079006F00750072000A007400680069006E0067002100100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "You know, Corbeau honestly might make a good\nmayor or something.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4424,
      "rawDecodedUtf16Hex": "0059006F00750020006B006E006F0077002C00200043006F0072006200650061007500200068006F006E006500730074006C00790020006D00690067006800740020006D0061006B00650020006100200067006F006F0064000A006D00610079006F00720020006F007200200073006F006D0065007400680069006E0067002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "It’s Korrina time!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 4564,
      "rawDecodedUtf16Hex": "00490074201900730020004B006F007200720069006E0061002000740069006D0065002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Hey, <U+0010><U+0002>Ā<U+0000>. Bad\nnews—<U+0010><U+0002>Ƌ<U+0001><U+0010><U+0001>븀\ncan’t<U+0010><U+0001>븀\nmake it.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 15,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4612,
      "rawDecodedUtf16Hex": "00100002BD060000004800650079002C00200010000201000000002E0020004200610064000A006E006500770073201400100002018B000100100001BE00000A00630061006E2019007400100001BE00000A006D0061006B0065002000690074002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "It’ll have to be just you and me on this one.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4720,
      "rawDecodedUtf16Hex": "004900742019006C006C0020006800610076006500200074006F0020006200650020006A00750073007400200079006F007500200061006E00640020006D00650020006F006E002000740068006900730020006F006E0065002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "I could fill in.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4820,
      "rawDecodedUtf16Hex": "004900200063006F0075006C0064002000660069006C006C00200069006E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Oh! You’re...Emma, right?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4864,
      "rawDecodedUtf16Hex": "004F0068002100200059006F0075201900720065002E002E002E0045006D006D0061002C002000720069006700680074003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Yes! We met in Hyperspace Lumiose just before\nOperation Mega Donut.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4924,
      "rawDecodedUtf16Hex": "00590065007300210020005700650020006D0065007400200069006E002000480079007000650072007300700061006300650020004C0075006D0069006F007300650020006A0075007300740020006200650066006F00720065000A004F007000650072006100740069006F006E0020004D00650067006100200044006F006E00750074002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "I’ve heard you’re a dab hand with Mega Evolution\nyourself!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 5068,
      "rawDecodedUtf16Hex": "004920190076006500200068006500610072006400200079006F0075201900720065002000610020006400610062002000680061006E0064002000770069007400680020004D006500670061002000450076006F006C007500740069006F006E000A0079006F0075007200730065006C0066002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Let’s do it! A new trio debuts!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5196,
      "rawDecodedUtf16Hex": "004C006500742019007300200064006F0020006900740021002000410020006E006500770020007400720069006F0020006400650062007500740073002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Let me know when you’re ready to do this,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5268,
      "rawDecodedUtf16Hex": "00100002BD060000004C006500740020006D00650020006B006E006F00770020007700680065006E00200079006F007520190072006500200072006500610064007900200074006F00200064006F00200074006800690073002C000A0010000201000000002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿*",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5380,
      "rawDecodedUtf16Hex": "00100002BDFF002A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ready to dive on in?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5392,
      "rawDecodedUtf16Hex": "0052006500610064007900200074006F002000640069007600650020006F006E00200069006E003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Let’s go!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5444,
      "rawDecodedUtf16Hex": "004C006500742019007300200067006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "I need to prepare",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 45,
      "offsetInSection": 5464,
      "rawDecodedUtf16Hex": "00490020006E00650065006400200074006F002000700072006500700061007200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "A new trio debuts! Better make sure you’re extra\nprepared.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 46,
      "offsetInSection": 5500,
      "rawDecodedUtf16Hex": "00410020006E006500770020007400720069006F0020006400650062007500740073002100200042006500740074006500720020006D0061006B00650020007300750072006500200079006F0075201900720065002000650078007400720061000A00700072006500700061007200650064002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "I’m ready to go when you are. We’ve got to keep\nLumiose safe!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 47,
      "offsetInSection": 5628,
      "rawDecodedUtf16Hex": "00492019006D00200072006500610064007900200074006F00200067006F0020007700680065006E00200079006F00750020006100720065002E00200057006520190076006500200067006F007400200074006F0020006B006500650070000A004C0075006D0069006F0073006500200073006100660065002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Hold on, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0001>븁\nDon’t go in with all your Boxes full. You’re gonna\nneed to catch whatever Pokémon’s in there!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "My detective’s instinct is telling me you’ll need a\nparticular donut for this special distortion!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "<U+0010><U+0002>뷿2",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6196,
      "rawDecodedUtf16Hex": "00100002BDFF00320000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Zeraora?!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6208,
      "rawDecodedUtf16Hex": "005A006500720061006F00720061003F002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "That’s one of the mightiest Electric-type Pokémon\nthere is...<U+0010><U+0001>븁\nI can’t imagine how bad things could get if\nRogue Mega Zeraora were on the loose!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 151
    },
    {
      "displayText": "Wow, Korrina—it’s strong enough to intimidate a\nTrainer of your caliber?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 6540,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Ha! You kidding?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 6696,
      "rawDecodedUtf16Hex": "00480061002100200059006F00750020006B0069006400640069006E0067003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "We get to go all out against the mighty Zeraora!\nI’m thrilled!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 6740,
      "rawDecodedUtf16Hex": "00570065002000670065007400200074006F00200067006F00200061006C006C0020006F0075007400200061006700610069006E0073007400200074006800650020006D006900670068007400790020005A006500720061006F007200610021000A00492019006D00200074006800720069006C006C00650064002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "And I’m glad we get to release it from the pain of\nRogue Mega Evolution too!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 6876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "The concentration of Mega Power in your vicinity\nis rising rapidly!<U+0010><U+0001>븁\nWarning: Rogue Mega Evolution is imminent!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 7040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "<U+0010><U+0002>뷿:",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7268,
      "rawDecodedUtf16Hex": "00100002BDFF003A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "GROOOAR!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7280,
      "rawDecodedUtf16Hex": "00470052004F004F004F0041005200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Go on and catch Zeraora,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 7300,
      "rawDecodedUtf16Hex": "00100002BD0600000047006F0020006F006E00200061006E00640020006300610074006300680020005A006500720061006F00720061002C000A0010000201000000002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "You were truly mighty, Zeraora. Respect.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 7380,
      "rawDecodedUtf16Hex": "0059006F0075002000770065007200650020007400720075006C00790020006D00690067006800740079002C0020005A006500720061006F00720061002E00200052006500730070006500630074002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Zeraora has occasionally turned up in human\ntowns, looking as if it’s hungry for battle.<U+0010><U+0001>븁\nI’ve heard it sometimes even acts like a bodyguard\nfor people.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 7472,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 159
    },
    {
      "displayText": "Maybe this pocket of Hyperspace Lumiose was\nborn from its hunger for a good battle.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 7792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "I guess we’re done here. Let’s head back to our\nregular old Lumiose!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 64,
      "offsetInSection": 7968,
      "rawDecodedUtf16Hex": "004900200067007500650073007300200077006520190072006500200064006F006E006500200068006500720065002E0020004C0065007420190073002000680065006100640020006200610063006B00200074006F0020006F00750072000A0072006500670075006C006100720020006F006C00640020004C0075006D0069006F00730065002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "<U+0010><U+0002>뷿A",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 8116,
      "rawDecodedUtf16Hex": "00100002BDFF00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Now I’ve got a better idea of how you two have\nbeen protecting Lumiose all this time.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 8128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "It really is hard work, so thank you for doing it!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 67,
      "offsetInSection": 8308,
      "rawDecodedUtf16Hex": "004900740020007200650061006C006C00790020006900730020006800610072006400200077006F0072006B002C00200073006F0020007400680061006E006B00200079006F007500200066006F007200200064006F0069006E0067002000690074002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Aww, Emma, we should be thanking you. We\ncouldn’t have handled Zeraora without your help!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 68,
      "offsetInSection": 8420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "I’m here, I’m here! Sorry I’m late!<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 69,
      "offsetInSection": 8608,
      "rawDecodedUtf16Hex": "00492019006D00200068006500720065002C002000492019006D00200068006500720065002100200053006F007200720079002000492019006D0020006C006100740065002100100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "I’m here, I’m here! Sorry I’m late!<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 70,
      "offsetInSection": 8688,
      "rawDecodedUtf16Hex": "00492019006D00200068006500720065002C002000492019006D00200068006500720065002100200053006F007200720079002000492019006D0020006C006100740065002100100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "We, uh... We’re done already.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 8768,
      "rawDecodedUtf16Hex": "00570065002C002000750068002E002E002E00200057006520190072006500200064006F006E006500200061006C00720065006100640079002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "You’re what?<U+0010><U+0001>븁\nWait...Emma? Don’t tell me...<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 8836,
      "rawDecodedUtf16Hex": "0059006F007520190072006500200077006800610074003F00100001BE01000A0057006100690074002E002E002E0045006D006D0061003F00200044006F006E20190074002000740065006C006C0020006D0065002E002E002E00100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "You’re what?<U+0010><U+0001>븁\nWait...Emma? Don’t tell me...<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 8936,
      "rawDecodedUtf16Hex": "0059006F007520190072006500200077006800610074003F00100001BE01000A0057006100690074002E002E002E0045006D006D0061003F00200044006F006E20190074002000740065006C006C0020006D0065002E002E002E00100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "That’s right—I did my best to fill your shoes in\nHyperspace Lumiose!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 9036,
      "rawDecodedUtf16Hex": "0054006800610074201900730020007200690067006800742014004900200064006900640020006D00790020006200650073007400200074006F002000660069006C006C00200079006F00750072002000730068006F0065007300200069006E000A00480079007000650072007300700061006300650020004C0075006D0069006F00730065002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Yup! Lumiose officially has a new toughest trio!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 9184,
      "rawDecodedUtf16Hex": "00590075007000210020004C0075006D0069006F007300650020006F006600660069006300690061006C006C00790020006800610073002000610020006E0065007700200074006F0075006700680065007300740020007400720069006F002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "N-no way!<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 9292,
      "rawDecodedUtf16Hex": "004E002D006E006F0020007700610079002100100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "N-no way!<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 9320,
      "rawDecodedUtf16Hex": "004E002D006E006F0020007700610079002100100002011400050000",
