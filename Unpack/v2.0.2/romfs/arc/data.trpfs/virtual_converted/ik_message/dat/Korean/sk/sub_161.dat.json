  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0006>잖아?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "00100002010000000010000219000006C796C544003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "가족끼리 단란한 시간을 보내는 중에\n얼굴을 내밀다니, 센스가 없는 친구군.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "AC00C871B07CB9AC0020B2E8B780D55C0020C2DCAC04C7440020BCF4B0B4B2940020C911C5D0000AC5BCAD74C7440020B0B4BC00B2E4B2C8002C0020C13CC2A4AC000020C5C6B2940020CE5CAD6CAD70002E00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "그런 적 없거든!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 440,
      "rawDecodedUtf16Hex": "ADF8B7F00020C8010020C5C6AC70B4E00021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "잠깐만요!<U+0010><U+0001>븁\n매번 <U+0010><U+0002>Ā<U+0000> 씨만...\n이번에는 저도 하고 싶은 말이 있다구요!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "C7A0AE50B9CCC694002100100001BE01000AB9E4BC88002000100002010000000020C528B9CC002E002E002E000AC774BC88C5D0B2940020C800B3C40020D558ACE00020C2F6C7400020B9D0C7740020C788B2E4AD6CC6940021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "ZZ4 여러분,\n저희와 승부해 주세요!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 568,
      "rawDecodedUtf16Hex": "005A005A00340020C5ECB7ECBD84002C000AC800D76CC6400020C2B9BD80D5740020C8FCC138C6940021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0003> 좋다면야\n얼마든지 어울려 줄 수 있어.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 620,
      "rawDecodedUtf16Hex": "001000020100000000100002190000030020C88BB2E4BA74C57C000AC5BCB9C8B4E0C9C00020C5B4C6B8B8240020C9040020C2180020C788C5B4002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "기다려 주세요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 704,
      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> 씨는 일단\n부정하고 보는 경향이 있단 말이죠...<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "00100002010000000020C528B2940020C77CB2E8000ABD80C815D558ACE00020BCF4B2940020ACBDD5A5C7740020C788B2E80020B9D0C774C8E0002E002E002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "곤율거니와 함께라면 이길 수 있을 거예요!\n아니, 이기겠어요!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 796,
      "rawDecodedUtf16Hex": "ACE4C728AC70B2C8C6400020D568AED8B77CBA740020C774AE380020C2180020C788C7440020AC70C608C6940021000AC544B2C8002C0020C774AE30ACA0C5B4C6940021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "이곳에서라면\n어떤 카친과도 싸워줄 수 있어.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 888,
      "rawDecodedUtf16Hex": "C774ACF3C5D0C11CB77CBA74000AC5B4B5A40020CE74CE5CACFCB3C40020C2F8C6CCC9040020C2180020C788C5B4002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "나도 실질적으로는 카나리나 다름없으니\n두 명의 카나리와 싸우는 거나 마찬가지라네!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "B098B3C40020C2E4C9C8C801C73CB85CB2940020CE74B098B9ACB0980020B2E4B984C5C6C73CB2C8000AB4500020BA85C7580020CE74B098B9ACC6400020C2F8C6B0B2940020AC70B0980020B9C8CC2CAC00C9C0B77CB124002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1048,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "기다려 주세요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "그러지 말고 승부하자고!\n모처럼의 기회를 버릴 셈이야?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "ADF8B7ECC9C00020B9D0ACE00020C2B9BD80D558C790ACE00021000ABAA8CC98B7FCC7580020AE30D68CB97C0020BC84B9B40020C148C774C57C003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "상대해 줄게.\n승리는 내 차지가 되겠지만 말이야!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "C0C1B300D5740020C904AC8C002E000AC2B9B9ACB2940020B0B40020CC28C9C0AC000020B418ACA0C9C0B9CC0020B9D0C774C57C0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "여기엔 뭐 하러 온 건지...<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "C5ECAE30C5D40020BB500020D558B7EC0020C6280020AC74C9C0002E002E002E00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "내가 이기면 카나리빵을 만드는 걸\n도와줘야 할 걸세!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "B0B4AC000020C774AE30BA740020CE74B098B9ACBE75C7440020B9CCB4DCB2940020AC78000AB3C4C640C918C57C0020D5600020AC78C138002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "빨리 승부를 시작하죠.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "BE68B9AC0020C2B9BD80B97C0020C2DCC791D558C8E0002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1360,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "진짜를 보여 주겠어!\n저리더프! 메가진화로 전압을 올려 보자!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "C9C4C9DCB97C0020BCF4C5EC0020C8FCACA0C5B40021000AC800B9ACB354D50400210020BA54AC00C9C4D654B85C0020C804C555C7440020C62CB8240020BCF4C7900021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "몰드류, 메가진화다!\n나의 지략을 실현하는 거다!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1452,
      "rawDecodedUtf16Hex": "BAB0B4DCB958002C0020BA54AC00C9C4D654B2E40021000AB098C7580020C9C0B7B5C7440020C2E4D604D558B2940020AC70B2E4002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "곤율거니! 메가진화한 당신의 힘을\n최대한 이끌어 내 보이겠어요!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "ACE4C728AC70B2C800210020BA54AC00C9C4D654D55C0020B2F9C2E0C7580020D798C744000ACD5CB300D55C0020C774B04CC5B40020B0B40020BCF4C774ACA0C5B4C6940021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1596,
      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "이겼어요!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "C774ACBCC5B4C6940021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "그래, MZ단의 카친.\n하고 싶은 말이 뭔데?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "ADF8B798002C0020004D005AB2E8C7580020CE74CE5C002E000AD558ACE00020C2F6C7400020B9D0C7740020BB54B370003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "저... 언젠가 카나리 님이 입을\n옷을 만들어 드리고 싶어요!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1688,
      "rawDecodedUtf16Hex": "C800002E002E002E0020C5B8C820AC000020CE74B098B9AC0020B2D8C7740020C785C744000AC637C7440020B9CCB4E4C5B40020B4DCB9ACACE00020C2F6C5B4C6940021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "좋아.\n내가 납득할 만한 디자인이라면 말이지.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1768,
      "rawDecodedUtf16Hex": "C88BC544002E000AB0B4AC000020B0A9B4DDD5600020B9CCD55C0020B514C790C778C774B77CBA740020B9D0C774C9C0002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "내 것도 만들어 주게!<U+0010><U+0001>븁\n카나리의 마음을 이해하려면\n똑같은 복장을 해야 하니 말일세!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "B0B40020AC83B3C40020B9CCB4E4C5B40020C8FCAC8C002100100001BE01000ACE74B098B9ACC7580020B9C8C74CC7440020C774D574D558B824BA74000AB611AC19C7400020BCF5C7A5C7440020D574C57C0020D558B2C80020B9D0C77CC138002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "됐거든!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "B410AC70B4E00021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, 이걸 줄게.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "0010000201000000002C0020C774AC780020C904AC8C002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001>\n카나리 코디 웨어 세트를 손에 넣었다!",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "00100002010000000010000219000001000ACE74B098B9AC0020CF54B5140020C6E8C5B40020C138D2B8B97C0020C190C5D00020B123C5C8B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "너한테는...\n자, 할아버지가 만든 카나리빵이야!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2056,
      "rawDecodedUtf16Hex": "B108D55CD14CB294002E002E002E000AC790002C0020D560C544BC84C9C0AC000020B9CCB4E00020CE74B098B9ACBE75C774C57C0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "카나리빵...\n평생 소중히 간직할게요!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "CE74B098B9ACBE75002E002E002E000AD3C9C0DD0020C18CC911D7880020AC04C9C1D560AC8CC6940021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "먹으라고 준 거거든!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "BA39C73CB77CACE00020C9000020AC70AC70B4E00021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001> 여전히 못 이기겠다니까.\n다들 열심히 단련했는데 말이지.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 2204,
      "rawDecodedUtf16Hex": "001000020100000000100002190000010020C5ECC804D7880020BABB0020C774AE30ACA0B2E4B2C8AE4C002E000AB2E4B4E40020C5F4C2ECD7880020B2E8B828D588B294B3700020B9D0C774C9C0002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "카나리빵의 인기가 아주 대단해서\n각지에 점포를 낼지 검토 중이라네!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "CE74B098B9ACBE75C7580020C778AE30AC000020C544C8FC0020B300B2E8D574C11C000AAC01C9C0C5D00020C810D3ECB97C0020B0BCC9C00020AC80D1A00020C911C774B77CB124002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "현실에서도 전할 수 있어야 할 텐데 말이죠.\n언젠가는 꼭... 노력해 볼게요.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "D604C2E4C5D0C11CB3C40020C804D5600020C2180020C788C5B4C57C0020D5600020D150B3700020B9D0C774C8E0002E000AC5B8C820AC00B2940020AF2D002E002E002E0020B178B825D5740020BCFCAC8CC694002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    }
  ],
