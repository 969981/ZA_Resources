      "rawDecodedUtf16Hex": "004320190065007300740020006200690065006E002C002000E70061002C0020007000650072007300E9007600E80072006500200021000A0043201900650073007400200063006F006D006D0065002000E700610020007100752019006F006E002000700072006F0067007200650073007300650020002100100002011401890000",
