      "rawDecodedUtf16Hex": "0053006F002000650069006E002000730063006800F6006E006500720020004B0061006E0061006C006400650063006B0065006C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "STOPP!<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "00530054004F00500050002100100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Und jetzt schau mal runter!!<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 296,
      "rawDecodedUtf16Hex": "0055006E00640020006A00650074007A00740020007300630068006100750020006D0061006C002000720075006E0074006500720021002100100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "In ganz Illumina City gibt es Kanaldeckel, die mit\nPokémon-Designs versehen sind.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Man nennt sie auch Pokémon-Kanaldeckel.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 536,
      "rawDecodedUtf16Hex": "004D0061006E0020006E0065006E006E007400200073006900650020006100750063006800200050006F006B00E9006D006F006E002D004B0061006E0061006C006400650063006B0065006C002E00100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Und einer davon befindet sich genau hier!<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "0055006E0064002000650069006E006500720020006400610076006F006E00200062006500660069006E00640065007400200073006900630068002000670065006E0061007500200068006900650072002100100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Schau nur! Manche der wunderschönen\nKanaldeckel der Zone Verte werden von<U+0010><U+0001>븀\nChevrumm geziert.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Und jetzt eine Frage an dich!<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 916,
      "rawDecodedUtf16Hex": "0055006E00640020006A00650074007A0074002000650069006E006500200046007200610067006500200061006E00200064006900630068002100100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Welches Pokémon befindet sich auf einigen\nKanaldeckeln in der Zone Rouge?<U+0010><U+0001>븁\nWenn du glaubst, dass du die Antwort weißt,\ndann zeig mir das passende Pokémon.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 161
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Zeigst du mir das Pokémon, das auf einigen\nKanaldeckeln in der Zone Rouge zu sehen ist?<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1320,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Ja, ich hab es dabei!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "004A0061002C0020006900630068002000680061006200200065007300200064006100620065006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Nein, jetzt nicht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "004E00650069006E002C0020006A00650074007A00740020006E0069006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Wenn du glaubst, dass du die Antwort weißt und\ndas Pokémon dabeihast, komm wieder zu mir.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Zeig mir das Pokémon von den Kanaldeckeln.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "005A0065006900670020006D00690072002000640061007300200050006F006B00E9006D006F006E00200076006F006E002000640065006E0020004B0061006E0061006C006400650063006B0065006C006E002E00100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Zeig mir das richtige Pokémon, sobald du es hast.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1872,
      "rawDecodedUtf16Hex": "005A0065006900670020006D00690072002000640061007300200072006900630068007400690067006500200050006F006B00E9006D006F006E002C00200073006F00620061006C006400200064007500200065007300200068006100730074002E00100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Das ist leider nicht richtig...<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020006C006500690064006500720020006E006900630068007400200072006900630068007400690067002E002E002E00100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Ein männliches Pyroleo... Das ist fast richtig,\naber leider trotzdem falsch!<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Ein weibliches Pyroleo...<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2216,
      "rawDecodedUtf16Hex": "00450069006E00200077006500690062006C006900630068006500730020005000790072006F006C0065006F002E002E002E00100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Ding, ding, diiiing! ♪<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2276,
      "rawDecodedUtf16Hex": "00440069006E0067002C002000640069006E0067002C002000640069006900690069006E006700210020266A00100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Das stimmt! Fantastisch!<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2332,
      "rawDecodedUtf16Hex": "0044006100730020007300740069006D006D00740021002000460061006E00740061007300740069007300630068002100100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Hinter jedem Design der Pokémon-Kanaldeckel\nsteckt auch ein bestimmter Schwerpunkt.<U+0010><U+0001>븁\nIn der Zone Rouge lautet dieser „Hingabe“.\nPasst doch super zu weiblichen Pyroleo, oder?<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 180
    },
    {
      "displayText": "In den anderen Zonen ist das natürlich auch so.<U+0010><U+0001>븁\nIn der Zone Verte geht es um „Freundschaft“,\nin der Zone Cyan um „Bescheidenheit“,<U+0010><U+0001>븀\nin der Zone Rose um „Eleganz“, und in der<U+0010><U+0001>븀\nZone Jaune findest du „Heiterkeit“.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2752,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 222
    },
    {
      "displayText": "Vielleicht achtest du beim nächsten Spaziergang\nmal gezielt auf die Kanaldeckel!<U+0010><U+0001>븁\nAber pass trotzdem auf, wo du hinläufst, ja?<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
