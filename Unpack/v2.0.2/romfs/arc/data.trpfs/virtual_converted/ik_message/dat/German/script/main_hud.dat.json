      "displayText": "Der Treffpunkt mit Gavin ist nicht\nmehr weit!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 4216,
      "rawDecodedUtf16Hex": "00440065007200200054007200650066006600700075006E006B00740020006D0069007400200047006100760069006E00200069007300740020006E0069006300680074000A006D0065006800720020007700650069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Kämpf bitte an seiner Seite,\nwenn du ihn erreicht hast!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 4308,
      "rawDecodedUtf16Hex": "004B00E4006D0070006600200062006900740074006500200061006E0020007300650069006E00650072002000530065006900740065002C000A00770065006E006E002000640075002000690068006E0020006500720072006500690063006800740020006800610073007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿0",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 4420,
      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du hast es also rübergeschafft!\nDiese Carany ist gleich da hinten.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4432,
      "rawDecodedUtf16Hex": "004400750020006800610073007400200065007300200061006C0073006F0020007200FC0062006500720067006500730063006800610066006600740021000A0044006900650073006500200043006100720061006E0079002000690073007400200067006C0065006900630068002000640061002000680069006E00740065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Carany?! Sie heißt Canary!\nCA-NA-RY! Merk’s dir endlich!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4568,
      "rawDecodedUtf16Hex": "0043006100720061006E0079003F00210020005300690065002000680065006900DF0074002000430061006E0061007200790021000A00430041002D004E0041002D0052005900210020004D00650072006B20190073002000640069007200200065006E0064006C00690063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "<U+0010><U+0002>뷿3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 4684,
      "rawDecodedUtf16Hex": "00100002BDFF00330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich bin am Ende meiner Kräfte...\nBeeil dich...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 4696,
      "rawDecodedUtf16Hex": "004900630068002000620069006E00200061006D00200045006E006400650020006D00650069006E006500720020004B007200E4006600740065002E002E002E000A0042006500650069006C00200064006900630068002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ich halte durch. Die Gerechtigkeit\nwird triumphieren!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 4792,
      "rawDecodedUtf16Hex": "004900630068002000680061006C00740065002000640075007200630068002E00200044006900650020004700650072006500630068007400690067006B006500690074000A007700690072006400200074007200690075006D007000680069006500720065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "<U+0010><U+0002>뷿6",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 4900,
      "rawDecodedUtf16Hex": "00100002BDFF00360000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich kämpfe gerne gegen dich!\nOder eben an deiner Seite! Egal!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4912,
      "rawDecodedUtf16Hex": "0049006300680020006B00E4006D0070006600650020006700650072006E006500200067006500670065006E002000640069006300680021000A004F0064006500720020006500620065006E00200061006E0020006400650069006E0065007200200053006500690074006500210020004500670061006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Lass uns wieder mal kämpfen,\nwenn das alles erledigt ist.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5036,
      "rawDecodedUtf16Hex": "004C00610073007300200075006E007300200077006900650064006500720020006D0061006C0020006B00E4006D007000660065006E002C000A00770065006E006E002000640061007300200061006C006C00650073002000650072006C006500640069006700740020006900730074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "<U+0010><U+0002>뷿9",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5152,
      "rawDecodedUtf16Hex": "00100002BDFF00390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Das machst du super!\nRavan ist gleich dahinten!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5164,
      "rawDecodedUtf16Hex": "0044006100730020006D006100630068007300740020006400750020007300750070006500720021000A0052006100760061006E002000690073007400200067006C006500690063006800200064006100680069006E00740065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Sehen wir zu, dass sie diesmal bei\nUNS Schulden abarbeiten müssen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5260,
      "rawDecodedUtf16Hex": "0053006500680065006E00200077006900720020007A0075002C00200064006100730073002000730069006500200064006900650073006D0061006C0020006200650069000A0055004E005300200053006300680075006C00640065006E0020006100620061007200620065006900740065006E0020006D00FC007300730065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5396,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Solange Zapplarang am Start ist,\nwerden wir safe gewinnen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5408,
      "rawDecodedUtf16Hex": "0053006F006C0061006E006700650020005A006100700070006C006100720061006E006700200061006D0020005300740061007200740020006900730074002C000A00770065007200640065006E00200077006900720020007300610066006500200067006500770069006E006E0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Denk nicht zu viel nach, sondern\nkonzentrier dich auf den Kampf!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 5528,
      "rawDecodedUtf16Hex": "00440065006E006B0020006E00690063006800740020007A00750020007600690065006C0020006E006100630068002C00200073006F006E006400650072006E000A006B006F006E007A0065006E00740072006900650072002000640069006300680020006100750066002000640065006E0020004B0061006D0070006600210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "<U+0010><U+0002>뷿?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5660,
      "rawDecodedUtf16Hex": "00100002BDFF003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Komm, kletter die Leiter hoch!\nIch will dir was Cooles zeigen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 5672,
      "rawDecodedUtf16Hex": "004B006F006D006D002C0020006B006C0065007400740065007200200064006900650020004C0065006900740065007200200068006F006300680021000A004900630068002000770069006C006C0020006400690072002000770061007300200043006F006F006C006500730020007A0065006900670065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
