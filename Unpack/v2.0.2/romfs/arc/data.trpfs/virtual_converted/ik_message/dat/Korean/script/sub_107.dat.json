      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "무슨 이유에선지\n잡을 수 없는 입치트...<U+0010><U+0002>Ĕƃ",
      "escapedControlUnits": 2,
