      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "원인을 알아봐야 마음이 놓일 텐데\n너무 무서워서...<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
