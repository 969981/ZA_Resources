      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 6312,
      "rawDecodedUtf16Hex": "004A00610077006F0068006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Warte kurz...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6328,
      "rawDecodedUtf16Hex": "005700610072007400650020006B00750072007A002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>뷿2",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6356,
      "rawDecodedUtf16Hex": "00100002BDFF00320000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Meinen herzlichen Glückwunsch zum ersten\nPlatz in Violettes Superturnier V!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 51,
