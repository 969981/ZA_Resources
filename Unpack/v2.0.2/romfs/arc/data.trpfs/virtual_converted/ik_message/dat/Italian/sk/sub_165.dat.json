  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Che ci facciamo in un posto del genere?<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 356,
      "rawDecodedUtf16Hex": "0043006800650020006300690020006600610063006300690061006D006F00200069006E00200075006E00200070006F00730074006F002000640065006C002000670065006E006500720065003F00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Dev’essere quella roba che chiamano Luminopoli\ndimensionale.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "00440065007620190065007300730065007200650020007100750065006C006C006100200072006F00620061002000630068006500200063006800690061006D0061006E006F0020004C0075006D0069006E006F0070006F006C0069000A00640069006D0065006E00730069006F006E0061006C0065002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Ne deduco che anch’io devo essere il prodotto\ndel subconscio di qualcuno.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Avrei qualcosa da chiedere a voi due del\nTeam Flare Nouveau.<U+0010><U+0001>븀\nQuindi affrontateci in una lotta Pokémon!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Tu mi aiuterai, vero, <U+0010><U+0002>Ā<U+0000>?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "005400750020006D0069002000610069007500740065007200610069002C0020007600650072006F002C00200010000201000000003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Ma certo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "004D006100200063006500720074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Solo un momento...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "0053006F006C006F00200075006E0020006D006F006D0065006E0074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Capisco. Vuoi studiare bene la situazione, prima.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "004300610070006900730063006F002E002000560075006F0069002000730074007500640069006100720065002000620065006E00650020006C0061002000730069007400750061007A0069006F006E0065002C0020007000720069006D0061002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Con <U+0010><U+0002>Ā<U+0000> dalla mia parte, la vittoria\nè assicurata!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1184,
      "rawDecodedUtf16Hex": "0043006F006E00200010000201000000002000640061006C006C00610020006D00690061002000700061007200740065002C0020006C006100200076006900740074006F007200690061000A00E800200061007300730069006300750072006100740061002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1296,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Il mio cuore brucia dalla frustrazione per non\nessere stato scelto da Zygarde...<U+0010><U+0001>븁\nAffrontarti mi aiuterà anche a spazzare via questo\nmalessere.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 150
    },
    {
      "displayText": "Ok, affrontaci pure, ma se perdi ti faccio lavorare.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "004F006B002C00200061006600660072006F006E007400610063006900200070007500720065002C0020006D0061002000730065002000700065007200640069002000740069002000660061006300630069006F0020006C00610076006F0072006100720065002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Vincerò!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "00560069006E00630065007200F200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Non mi va",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "004E006F006E0020006D00690020007600610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Bruciare non mi basta... devo ardere!<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "004200720075006300690061007200650020006E006F006E0020006D0069002000620061007300740061002E002E002E0020006400650076006F0020006100720064006500720065002100100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Charizard, esala le tue fiamme nere!<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "00430068006100720069007A006100720064002C0020006500730061006C00610020006C006500200074007500650020006600690061006D006D00650020006E006500720065002100100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "E allora perché sei qui...?<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1932,
      "rawDecodedUtf16Hex": "004500200061006C006C006F0072006100200070006500720063006800E900200073006500690020007100750069002E002E002E003F00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Ti ridurrò in cenere!<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1996,
      "rawDecodedUtf16Hex": "00540069002000720069006400750072007200F200200069006E002000630065006E006500720065002100100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Voglio capire cosa combinavano quei due nel\nTeam Flare, e anche saperne di più sulle persone<U+0010><U+0001>븀\na me care.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2272,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vai, Charizard! Megaevolviti e brucia ogni cosa\ncon le tue fiamme accecanti!<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "\"Nouveau\" significa \"nuovo\"! Megaevolviti e\nnuova vita scorrerà nelle tue vene!<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ti mostrerò quanto è forte il mio legame con\nquesto Pokémon e con chi mi ha fatto da guida!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "00100002BDFF00170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ricordate cosa ci avevate promesso prima della\nsfida?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2820,
      "rawDecodedUtf16Hex": "005200690063006F0072006400610074006500200063006F0073006100200063006900200061007600650076006100740065002000700072006F006D006500730073006F0020007000720069006D0061002000640065006C006C0061000A00730066006900640061003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Certamente.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2936,
      "rawDecodedUtf16Hex": "00430065007200740061006D0065006E00740065002E00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Allora dimmi... Perché Xante collaborava con\nil Team Flare?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "0041006C006C006F00720061002000640069006D006D0069002E002E002E00200050006500720063006800E9002000580061006E0074006500200063006F006C006C00610062006F007200610076006100200063006F006E000A0069006C0020005400650061006D00200046006C006100720065003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Faceva ricerche per capire se è possibile\npotenziare gli esseri umani in modo simile alla<U+0010><U+0001>븀\nmegaevoluzione, che potenzia i Pokémon.<U+0010><U+0001>븁\nÈ così che è nata la tuta di potenziamento.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3096,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 184
    },
    {
      "displayText": "Avrebbe dovuto fare i test su di noi, ma per\nqualche ragione scelse te come cavia.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Non sappiamo altro. Del resto non avevamo\na che fare con Xante.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3640,
      "rawDecodedUtf16Hex": "004E006F006E0020007300610070007000690061006D006F00200061006C00740072006F002E002000440065006C00200072006500730074006F0020006E006F006E002000610076006500760061006D006F000A006100200063006800650020006600610072006500200063006F006E002000580061006E00740065002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Lui era gentile con me... Per questo volevo\ncapire che tipo di persona fosse.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Sicuramente per lui la ricerca veniva prima di\ntutto. Ma la sua gentilezza nei tuoi confronti era<U+0010><U+0001>븀\nautentica.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3940,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Le persone sono piene di contraddizioni,\ndopotutto. Sei d’accordo anche tu, no?<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ciò che conta è l’impressione che ha fatto",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4340,
      "rawDecodedUtf16Hex": "0043006900F2002000630068006500200063006F006E00740061002000E80020006C20190069006D007000720065007300730069006F006E0065002000630068006500200068006100200066006100740074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "La sua gentilezza era sincera",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4428,
      "rawDecodedUtf16Hex": "004C00610020007300750061002000670065006E00740069006C0065007A007A00610020006500720061002000730069006E00630065007200610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Grazie!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4488,
      "rawDecodedUtf16Hex": "004700720061007A00690065002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Questo è per ringraziarti.<U+0010><U+0001>븁\nCredo tu mi abbia aiutato finalmente a capire\ncome mai Zygarde non ha scelto me.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "Hai ricevuto l’Uniforme da cuoco di Gris!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4744,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F0020006C20190055006E00690066006F0072006D0065002000640061002000630075006F0063006F0020006400690020004700720069007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Mettila quando ti va di venire a lavorare\nal Caffè Nouveau.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4828,
      "rawDecodedUtf16Hex": "004D0065007400740069006C00610020007100750061006E0064006F002000740069002000760061002000640069002000760065006E006900720065002000610020006C00610076006F0072006100720065000A0061006C0020004300610066006600E80020004E006F00750076006500610075002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Non se ne parla.<U+0010><U+0001>븁\n<U+0010><U+0002>Ā<U+0000> deve lavorare per il bene dei\nPokémon e della gente di questa città.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Non possiamo vincolarl<U+0010><U+0003>ᄀÿāoa con un lavoro.<U+0010><U+0001>븁\nMa non escludo che potremmo chiedere il suo\naiuto qualora al locale fossimo nei guai.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Ogni angolo di Luminopoli porta le tracce delle\nvariegate vite delle persone e dei Pokémon.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 5428,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Questa Luminopoli dimensionale ha un aspetto\ndavvero spoglio. Chi l’avrà desiderata così...?<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Quando fai il detective, ti capita di scoprire gli\naspetti più disparati della città. È interessante!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5816,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    }
  ],
