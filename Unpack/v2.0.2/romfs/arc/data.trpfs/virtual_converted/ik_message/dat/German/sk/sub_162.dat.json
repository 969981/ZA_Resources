  "initialKey": 0,
  "messages": [
    {
      "displayText": "Irgendwie habe ich das Gefühl, hier schon einmal\ngewesen zu sein.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "0049007200670065006E00640077006900650020006800610062006500200069006300680020006400610073002000470065006600FC0068006C002C002000680069006500720020007300630068006F006E002000650069006E006D0061006C000A006700650077006500730065006E0020007A00750020007300650069006E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Toll. Ich bin nicht nur hier gelandet, nein, ich hab\nauch noch weiterhin meinen Bruder an der Backe.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Ihr gehört doch zur Faust der Gerechten, oder?!<U+0010><U+0001>븁\nKommt schon, zeigt mir die Mega-Entwicklungen\neurer Pokémon!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Los geht’s, <U+0010><U+0002>Ā<U+0000>!\nEin Kampf<U+0010><U+0001>븀\nsteht an!<U+0010><U+0001>븀\nZwei gegen zwei!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "00100002BD060000004C006F00730020006700650068007420190073002C002000100002010000000021000A00450069006E0020004B0061006D0070006600100001BE00000A0073007400650068007400200061006E002100100001BE00000A005A00770065006900200067006500670065006E0020007A007700650069002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Okay, ich bin dabei!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "004F006B00610079002C0020006900630068002000620069006E00200064006100620065006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Moment noch...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1084,
      "rawDecodedUtf16Hex": "004D006F006D0065006E00740020006E006F00630068002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Ach, komm! Sei mal ein bisschen spontan!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "004100630068002C0020006B006F006D006D002100200053006500690020006D0061006C002000650069006E00200062006900730073006300680065006E002000730070006F006E00740061006E002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Als Hüterin der Mega-Entwicklung will ich\neinfach alles über das Thema wissen!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mir ist immer nach einem Kampf!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "004D00690072002000690073007400200069006D006D006500720020006E006100630068002000650069006E0065006D0020004B0061006D00700066002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "So wie’s aussieht, ist ein Nein keine Option...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "0053006F002000770069006520190073002000610075007300730069006500680074002C0020006900730074002000650069006E0020004E00650069006E0020006B00650069006E00650020004F007000740069006F006E002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Okay, ich bin dabei!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "004F006B00610079002C0020006900630068002000620069006E00200064006100620065006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Moment noch...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "004D006F006D0065006E00740020006E006F00630068002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Wahrer Fortschritt lässt sich nur durch den Sieg\ngegen einen starken Gegner erzielen!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Muskeln sind Kraft!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1820,
      "rawDecodedUtf16Hex": "004D00750073006B0065006C006E002000730069006E00640020004B0072006100660074002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Hätte nicht gedacht, dass du so unentschlossen\nbist...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "004800E40074007400650020006E006900630068007400200067006500640061006300680074002C0020006400610073007300200064007500200073006F00200075006E0065006E0074007300630068006C006F007300730065006E000A0062006900730074002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Kraft ist Gerechtigkeit!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "004B007200610066007400200069007300740020004700650072006500630068007400690067006B006500690074002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Ist es nicht großartig, dass es so viele\nverschiedene Mega-Entwicklungen gibt?<U+0010><U+0001>븁\nOb in Illumina oder im Dimensions-Illumina!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Los, Legios! Vollziehe die Mega-Entwicklung und\nverhilf der Gerechtigkeit zum Sieg!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2320,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Los, Skelabra! Vollzieh die Mega-Entwicklung und\nramm deinen Gegner ungespitzt in den Boden!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Gib alles!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "00470069006200200061006C006C00650073002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2724,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mega-Legios und Mega-Skelabra sind ja der\nWahnsinn!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "004D006500670061002D004C006500670069006F007300200075006E00640020004D006500670061002D0053006B0065006C0061006200720061002000730069006E00640020006A00610020006400650072000A005700610068006E00730069006E006E002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Ich war davon überzeugt, dass ich mit der Kraft\nder Mega-Entwicklung meine Gegner<U+0010><U+0001>븀\npulverisieren würde...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Weißt du, Gavin, Mega-entwickelte Pokémon sind\nschon stark.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3072,
      "rawDecodedUtf16Hex": "00570065006900DF0074002000640075002C00200047006100760069006E002C0020004D006500670061002D0065006E0074007700690063006B0065006C0074006500200050006F006B00E9006D006F006E002000730069006E0064000A007300630068006F006E00200073007400610072006B002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Aber um ihr volles Potenzial auszuschöpfen,\nist es entscheidend, dass der Trainer versteht,<U+0010><U+0001>븀\nwie die Mega-Entwicklung funktioniert.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Oh! Dem werde ich mich fortan widmen.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3476,
      "rawDecodedUtf16Hex": "004F00680021002000440065006D00200077006500720064006500200069006300680020006D00690063006800200066006F007200740061006E0020007700690064006D0065006E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Gavin gibt klein bei? Dann muss Connie einen\nstarken Eindruck hinterlassen haben...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3560,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Unser Kampf hat mich zutiefst bewegt.\nHier, bitte nimm diese Uniform als Dank!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Oh, danke! Aber ich habe schon so viele andere\nVerpflichtungen...<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3904,
      "rawDecodedUtf16Hex": "004F0068002C002000640061006E006B00650021002000410062006500720020006900630068002000680061006200650020007300630068006F006E00200073006F0020007600690065006C006500200061006E0064006500720065000A00560065007200700066006C00690063006800740075006E00670065006E002E002E002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Ich bin die Leiterin der Yantara-Arena, dann noch\ndie Hüterin der Mega-Entwicklung und jetzt<U+0010><U+0001>븀\ngerade auch ein Mitglied von Team MZ.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4044,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Meine Rollerskates habe ich ja auch an den Nagel\ngehängt, da wäre das Chaos groß, wenn ich jetzt<U+0010><U+0001>븀\nanfange, die Uniform der Faust der Gerechten zu<U+0010><U+0001>븀\ntragen.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4320,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 163
    },
    {
      "displayText": "Das leuchtet ein. Nun gut, dann sollst du sie\nhaben, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4648,
      "rawDecodedUtf16Hex": "0044006100730020006C0065007500630068007400650074002000650069006E002E0020004E0075006E0020006700750074002C002000640061006E006E00200073006F006C006C007300740020006400750020007300690065000A0068006100620065006E002C00200010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Du erhältst Gavins Uniform!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4776,
      "rawDecodedUtf16Hex": "00440075002000650072006800E4006C00740073007400200047006100760069006E007300200055006E00690066006F0072006D00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Du lässt auch wirklich kein Fettnäpfchen aus,\nGavin...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4832,
      "rawDecodedUtf16Hex": "004400750020006C00E4007300730074002000610075006300680020007700690072006B006C0069006300680020006B00650069006E00200046006500740074006E00E400700066006300680065006E0020006100750073002C000A0047006100760069006E002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Ich werde als Trainer ebenfalls eines Tages eine\nMega-Entwicklung vollziehen!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4952,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Wo sind wir hier? Gibt’s diesen Ort überhaupt?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5116,
      "rawDecodedUtf16Hex": "0057006F002000730069006E0064002000770069007200200068006900650072003F0020004700690062007420190073002000640069006500730065006E0020004F00720074002000FC00620065007200680061007500700074003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Übermäßige Stärke bringt auch Schmerz mit sich.<U+0010><U+0001>븁\nDas Einzige, das diesen überwinden kann, ist das\nBand zwischen Trainern und Pokémon!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5220,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    }
  ],
