      "index": 0,
      "offsetInSection": 140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "I’m such a huge fan of that event, you know.\nIt’s been a blast taking part in it.<U+0010><U+0002>Ĕƍ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 1,
