      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "¿Podrías pasar un momento por el laboratorio?\nCuando puedas, no hay prisa.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
