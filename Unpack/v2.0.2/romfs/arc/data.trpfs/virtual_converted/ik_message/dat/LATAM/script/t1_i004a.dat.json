  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Bienvenid<U+0010><U+0003>ᄀÿāoa al Restaurante Fulanito Detal.\nAmbiente familiar a precios que no cuestan<U+0010><U+0001>븀\nun ojo de la cara.",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "¡Apunta siempre a lo más alto! Ese es mi lema.\nLo llevo tatuado en el alma.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 424,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "No dejes de probar nuestro\nmenú de degustación.<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "004E006F002000640065006A00650073002000640065002000700072006F0062006100720020006E00750065007300740072006F000A006D0065006E00FA002000640065002000640065006700750073007400610063006900F3006E002E00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Nadie me felicita ni me anima ni\nme dice nada bonito. Qué triste...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 700,
      "rawDecodedUtf16Hex": "004E00610064006900650020006D0065002000660065006C006900630069007400610020006E00690020006D006500200061006E0069006D00610020006E0069000A006D0065002000640069006300650020006E00610064006100200062006F006E00690074006F002E00200051007500E90020007400720069007300740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Y tus Pokémon, ¿qué? No hablan,\npero seguro que te adoran.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 836,
      "rawDecodedUtf16Hex": "0059002000740075007300200050006F006B00E9006D006F006E002C002000BF0071007500E9003F0020004E006F0020006800610062006C0061006E002C000A007000650072006F002000730065006700750072006F0020007100750065002000740065002000610064006F00720061006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "¡Siempre hay lugar para el postre!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "00A1005300690065006D00700072006500200068006100790020006C00750067006100720020007000610072006100200065006C00200070006F007300740072006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Las crepas no son buenas, pero...\nbarriga llena, corazón contento.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "004C0061007300200063007200650070006100730020006E006F00200073006F006E0020006200750065006E00610073002C0020007000650072006F002E002E002E000A00620061007200720069006700610020006C006C0065006E0061002C00200063006F00720061007A00F3006E00200063006F006E00740065006E0074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡No hay nada mejor que ver\ncombates mientras comes!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "00A1004E006F00200068006100790020006E0061006400610020006D0065006A006F007200200071007500650020007600650072000A0063006F006D006200610074006500730020006D00690065006E007400720061007300200063006F006D0065007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Pero que no sea un combate soso,\nporque se me corta la digestión.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "005000650072006F00200071007500650020006E006F002000730065006100200075006E00200063006F006D006200610074006500200073006F0073006F002C000A0070006F00720071007500650020007300650020006D006500200063006F0072007400610020006C00610020006400690067006500730074006900F3006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Lo malo es que, si hay combate,\nla niña no prueba ni un bocado.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "004C006F0020006D0061006C006F0020006500730020007100750065002C002000730069002000680061007900200063006F006D0062006100740065002C000A006C00610020006E006900F100610020006E006F00200070007200750065006200610020006E006900200075006E00200062006F006300610064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "¡Siempre me dan ganas de darle\nuna Baya Citrón al que pierde!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1528,
      "rawDecodedUtf16Hex": "00A1005300690065006D0070007200650020006D0065002000640061006E002000670061006E006100730020006400650020006400610072006C0065000A0075006E0061002000420061007900610020004300690074007200F3006E00200061006C0020007100750065002000700069006500720064006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Entiendo totalmente.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "0045006E007400690065006E0064006F00200074006F00740061006C006D0065006E00740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Si me quitaran mi rinconcito de la\nbarra, mi vida no tendría sentido.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "005300690020006D006500200071007500690074006100720061006E0020006D0069002000720069006E0063006F006E006300690074006F0020006400650020006C0061000A00620061007200720061002C0020006D0069002000760069006400610020006E006F002000740065006E0064007200ED0061002000730065006E007400690064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Quisiera poder disfrutar de mi comida\ncon tranquilidad, si no te importa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "0051007500690073006900650072006100200070006F00640065007200200064006900730066007200750074006100720020006400650020006D006900200063006F006D006900640061000A0063006F006E0020007400720061006E007100750069006C0069006400610064002C0020007300690020006E006F00200074006500200069006D0070006F007200740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "¡Cómo se nota que Pierre está en la cocina!\nCada vez que vengo, se supera.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Ni idea... Yo al único chef que conozco\nes a Narciso, porque lo he visto en la tele.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Aquí celebramos nuestra\nboda y las bodas de plata.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "00410071007500ED002000630065006C0065006200720061006D006F00730020006E007500650073007400720061000A0062006F00640061002000790020006C0061007300200062006F00640061007300200064006500200070006C006100740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Familiar y sin pretensiones...\ncomo nuestro estilo de vida.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2412,
      "rawDecodedUtf16Hex": "00460061006D0069006C00690061007200200079002000730069006E002000700072006500740065006E00730069006F006E00650073002E002E002E000A0063006F006D006F0020006E00750065007300740072006F00200065007300740069006C006F00200064006500200076006900640061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Entrada, sopa y platillo principal.\nEl menú de siempre.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "0045006E00740072006100640061002C00200073006F007000610020007900200070006C006100740069006C006C006F0020007000720069006E0063006900700061006C002E000A0045006C0020006D0065006E00FA0020006400650020007300690065006D007000720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Antes, mi amigo venía aquí cada\ndía. ¡Lo trataban como a un rey!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2644,
      "rawDecodedUtf16Hex": "0041006E007400650073002C0020006D006900200061006D00690067006F002000760065006E00ED0061002000610071007500ED00200063006100640061000A006400ED0061002E002000A1004C006F00200074007200610074006100620061006E00200063006F006D006F0020006100200075006E002000720065007900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Para mí, el menú de este local es...\nsencillamente perfecto.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "00500061007200610020006D00ED002C00200065006C0020006D0065006E00FA002000640065002000650073007400650020006C006F00630061006C002000650073002E002E002E000A00730065006E00630069006C006C0061006D0065006E0074006500200070006500720066006500630074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Ningún platillo se destaca sobre el\notro. Eso tiene su mérito.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2900,
      "rawDecodedUtf16Hex": "004E0069006E006700FA006E00200070006C006100740069006C006C006F0020007300650020006400650073007400610063006100200073006F00620072006500200065006C000A006F00740072006F002E002000450073006F0020007400690065006E00650020007300750020006D00E9007200690074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "¡Tengo hambre! ¡Que lo traigan ya\no voy yo a buscarlo a la cocina!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "00A100540065006E0067006F002000680061006D0062007200650021002000A10051007500650020006C006F0020007400720061006900670061006E002000790061000A006F00200076006F007900200079006F002000610020006200750073006300610072006C006F002000610020006C006100200063006F00630069006E006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Pórtate bien, hijo. Mira que, si nos\nechan, sí que te quedas sin comer.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3164,
      "rawDecodedUtf16Hex": "005000F3007200740061007400650020006200690065006E002C002000680069006A006F002E0020004D0069007200610020007100750065002C0020007300690020006E006F0073000A0065006300680061006E002C0020007300ED00200071007500650020007400650020007100750065006400610073002000730069006E00200063006F006D00650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    }
