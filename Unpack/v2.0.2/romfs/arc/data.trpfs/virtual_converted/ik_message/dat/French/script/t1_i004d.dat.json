  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Bienvenue à Sushi Sans Chichis !\nIci, on se complique pas la vie ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Ici, on sert des sushis sans chichis !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 392,
      "rawDecodedUtf16Hex": "004900630069002C0020006F006E0020007300650072007400200064006500730020007300750073006800690073002000730061006E007300200063006800690063006800690073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Les sushis, ça se périme vite. Mais\nne les engloutis pas pour autant !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 472,
      "rawDecodedUtf16Hex": "004C006500730020007300750073006800690073002C002000E700610020007300650020007000E900720069006D006500200076006900740065002E0020004D006100690073000A006E00650020006C0065007300200065006E0067006C006F0075007400690073002000700061007300200070006F0075007200200061007500740061006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "J’ai mangé trop vite, j’ai failli\nm’étouffer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 616,
      "rawDecodedUtf16Hex": "004A2019006100690020006D0061006E006700E9002000740072006F007000200076006900740065002C0020006A2019006100690020006600610069006C006C0069000A006D201900E90074006F00750066006600650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Il paraît que les produits utilisés dans\nce restaurant proviennent de contrées lointaines.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Dis donc, tu en sais des choses !\n(Enfin bon, la Baie Azur, c’est pas si loin, hein...)",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "À Sushi Sans Chichis, tout\nle monde y trouve son compte !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "00C0002000530075007300680069002000530061006E007300200043006800690063006800690073002C00200074006F00750074000A006C00650020006D006F006E0064006500200079002000740072006F00750076006500200073006F006E00200063006F006D007000740065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Ce n’est pas censé être un endroit\nun peu chic ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "004300650020006E20190065007300740020007000610073002000630065006E007300E9002000EA00740072006500200075006E00200065006E00640072006F00690074000A0075006E0020007000650075002000630068006900630020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Si tu veux manger avec les mains,\nessaie de faire comme les pros.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1288,
      "rawDecodedUtf16Hex": "00530069002000740075002000760065007500780020006D0061006E006700650072002000610076006500630020006C006500730020006D00610069006E0073002C000A00650073007300610069006500200064006500200066006100690072006500200063006F006D006D00650020006C00650073002000700072006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "J’adore manger des sushis dans\nune ambiance décontractée.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1420,
      "rawDecodedUtf16Hex": "004A201900610064006F007200650020006D0061006E00670065007200200064006500730020007300750073006800690073002000640061006E0073000A0075006E006500200061006D006200690061006E006300650020006400E90063006F006E0074007200610063007400E90065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Pourquoi les gens mangent\ncomme ça ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "0050006F0075007200710075006F00690020006C00650073002000670065006E00730020006D0061006E00670065006E0074000A0063006F006D006D0065002000E700610020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Les saveurs n’ont rien à voir avec\ncelles du restaurant d’Alola...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1612,
      "rawDecodedUtf16Hex": "004C00650073002000730061007600650075007200730020006E2019006F006E00740020007200690065006E002000E000200076006F0069007200200061007600650063000A00630065006C006C00650073002000640075002000720065007300740061007500720061006E00740020006420190041006C006F006C0061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Je développe le palais de ce petit.\nUn jour, il me surpassera...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "004A00650020006400E900760065006C006F0070007000650020006C0065002000700061006C006100690073002000640065002000630065002000700065007400690074002E000A0055006E0020006A006F00750072002C00200069006C0020006D006500200073007500720070006100730073006500720061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Je pourrais peut-être devenir\nDresseur et chef sushi à la fois ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "004A006500200070006F00750072007200610069007300200070006500750074002D00EA00740072006500200064006500760065006E00690072000A0044007200650073007300650075007200200065007400200063006800650066002000730075007300680069002000E00020006C006100200066006F006900730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Profite bien\nde ton repas !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2012,
      "rawDecodedUtf16Hex": "00500072006F00660069007400650020006200690065006E000A0064006500200074006F006E002000720065007000610073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Je me demande si Sushi Sans Chichis offre\nun bon rapport qualité-prix.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2068,
      "rawDecodedUtf16Hex": "004A00650020006D0065002000640065006D0061006E00640065002000730069002000530075007300680069002000530061006E0073002000430068006900630068006900730020006F0066006600720065000A0075006E00200062006F006E00200072006100700070006F007200740020007100750061006C0069007400E9002D0070007200690078002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Le maki est un mariage de saveurs des plus\nfascinants !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "004C00650020006D0061006B0069002000650073007400200075006E0020006D00610072006900610067006500200064006500200073006100760065007500720073002000640065007300200070006C00750073000A00660061007300630069006E0061006E00740073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Mon envie de découvrir de nouvelles saveurs\npourrait être une qualité utile en combat, non ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Oui, cela permet d’apprendre à ne pas se laisser\ndésarçonner et à profiter du combat à fond !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Qu’est-ce qui te ferait plaisir ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2700,
      "rawDecodedUtf16Hex": "005100752019006500730074002D006300650020007100750069002000740065002000660065007200610069007400200070006C006100690073006900720020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Les sushis s’engouffrent tout seuls\ndans ma bouche ! C’est fou, ça !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2768,
      "rawDecodedUtf16Hex": "004C0065007300200073007500730068006900730020007320190065006E0067006F00750066006600720065006E007400200074006F007500740020007300650075006C0073000A00640061006E00730020006D006100200062006F00750063006800650020002100200043201900650073007400200066006F0075002C002000E70061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "C’est dur de s’arrêter quand\non mange des sushis.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2908,
      "rawDecodedUtf16Hex": "00432019006500730074002000640075007200200064006500200073201900610072007200EA0074006500720020007100750061006E0064000A006F006E0020006D0061006E0067006500200064006500730020007300750073006800690073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Tu risques de piquer du nez\nsi tu manges trop.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3008,
      "rawDecodedUtf16Hex": "005400750020007200690073007100750065007300200064006500200070006900710075006500720020006400750020006E0065007A000A007300690020007400750020006D0061006E006700650073002000740072006F0070002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ouaouh, mais ça pique !!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3104,
      "rawDecodedUtf16Hex": "004F00750061006F00750068002C0020006D006100690073002000E7006100200070006900710075006500200021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Oui, c’est le principe du wasabi.\nÀ Paldea, on en fait de la sauce.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3156,
      "rawDecodedUtf16Hex": "004F00750069002C0020006320190065007300740020006C00650020007000720069006E00630069007000650020006400750020007700610073006100620069002E000A00C0002000500061006C006400650061002C0020006F006E00200065006E002000660061006900740020006400650020006C0061002000730061007500630065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Le nombre de Pokémon en ville a augmenté.\nC’est une occasion en or pour faire des affaires !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "La négociation du contrat s’est bien passée.\nC’est l’occasion de fêter ça !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3480,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Sushi Sans Chichis s’est aussi\nimplanté à l’étranger !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3632,
      "rawDecodedUtf16Hex": "00530075007300680069002000530061006E007300200043006800690063006800690073002000732019006500730074002000610075007300730069000A0069006D0070006C0061006E007400E9002000E00020006C201900E9007400720061006E006700650072002000210000",
      "trailingZeroPaddingUnits": 1,
