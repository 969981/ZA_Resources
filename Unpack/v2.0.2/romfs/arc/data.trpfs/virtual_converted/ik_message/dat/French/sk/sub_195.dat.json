  "messages": [
    {
      "displayText": "Dites-moi, saviez-vous que les Pokémon de garde\nde Quazar nous posent des problèmes ?<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
