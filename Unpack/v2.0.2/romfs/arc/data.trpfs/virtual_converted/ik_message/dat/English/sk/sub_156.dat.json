      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Thanks, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4320,
      "rawDecodedUtf16Hex": "005400680061006E006B0073002C00200010000201000000002100100002011401C30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "The yeast in Fidough’s breath ferments things\naround it. I use that yeast to make bread!<U+0010><U+0001>븁\nThe bread’s been so popular that I haven’t had\ntime to take Fidough on walks lately...<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 4,
