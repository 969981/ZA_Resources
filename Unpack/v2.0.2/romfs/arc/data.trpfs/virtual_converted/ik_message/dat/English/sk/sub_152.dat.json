      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2096,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Now, off you go to Jaune Sector 6! Collect the\nmail to be sorted!<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "004E006F0077002C0020006F0066006600200079006F007500200067006F00200074006F0020004A00610075006E006500200053006500630074006F007200200036002100200043006F006C006C0065006300740020007400680065000A006D00610069006C00200074006F00200062006500200073006F0072007400650064002100100002011401BF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Miii!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2448,
      "rawDecodedUtf16Hex": "004D00690069006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Please follow after Mime Jr. from a reasonable\ndistance. Don’t lose sight of it!<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
