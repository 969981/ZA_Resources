  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Hi, ich bin Entwickler für Indie-Games.\nTrian heiß ich!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 292,
      "rawDecodedUtf16Hex": "00480069002C0020006900630068002000620069006E00200045006E0074007700690063006B006C006500720020006600FC007200200049006E006400690065002D00470061006D00650073002E000A0054007200690061006E002000680065006900DF0020006900630068002100100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Ich kenn mich vor allem gut mit Polygonen aus!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "0049006300680020006B0065006E006E0020006D00690063006800200076006F007200200061006C006C0065006D00200067007500740020006D0069007400200050006F006C00790067006F006E0065006E0020006100750073002100100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Hast du schon mal davon gehört?<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "00480061007300740020006400750020007300630068006F006E0020006D0061006C0020006400610076006F006E002000670065006800F600720074003F00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Meinst du vielleicht... das Pokémon Porygon?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "004D00650069006E007300740020006400750020007600690065006C006C00650069006300680074002E002E002E002000640061007300200050006F006B00E9006D006F006E00200050006F007200790067006F006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Sprichst du von 3D-Animation?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 680,
      "rawDecodedUtf16Hex": "0053007000720069006300680073007400200064007500200076006F006E002000330044002D0041006E0069006D006100740069006F006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Ganz falsch liegst du damit nicht.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "00470061006E007A002000660061006C0073006300680020006C00690065006700730074002000640075002000640061006D006900740020006E0069006300680074002E00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Ganz genau! Polygone sind wichtig, wenn man\nein 3D-Modell am Computer erstellt.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Videospiele sind zum Beispiel in der Regel voller\n3D-Figuren. In der Fachwelt nennen wir sie<U+0010><U+0001>븀\n„Modelle“.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Sie alle bestehen aus Polygonen, die ihnen Form\nund Ausdruck geben.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "00530069006500200061006C006C006500200062006500730074006500680065006E002000610075007300200050006F006C00790067006F006E0065006E002C0020006400690065002000690068006E0065006E00200046006F0072006D000A0075006E006400200041007500730064007200750063006B00200067006500620065006E002E00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Das Ganze nennen wir Polygonmodellierung.<U+0010><U+0001>븁\nDabei werden in einem dreidimensionalen Raum\nPolygone miteinander kombiniert, um Modelle<U+0010><U+0001>븀\nzu formen.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1356,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 152
    },
    {
      "displayText": "Je mehr Polygone zum Einsatz kommen,\ndesto glatter wird das Erscheinungsbild.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Früher war es aus technischer Sicht aber schwer,\nviele Polygone zu verwenden. Deshalb wirken die<U+0010><U+0001>븀\nFiguren aus der Zeit auch sehr kantig und blockig.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 155
    },
    {
      "displayText": "Das Pokémon Porygon wurde mit den damaligen\nHightech-Methoden erschaffen.<U+0010><U+0001>븁\nDie Technologie hat sich allerdings seitdem stark\nweiterentwickelt.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "Aber kommen wir nun zu meiner Bitte an dich.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2436,
      "rawDecodedUtf16Hex": "00410062006500720020006B006F006D006D0065006E00200077006900720020006E0075006E0020007A00750020006D00650069006E0065007200200042006900740074006500200061006E00200064006900630068002E00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Würdest du dein Porygon gegen mein Porygon\ntauschen?<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "005700FC007200640065007300740020006400750020006400650069006E00200050006F007200790067006F006E00200067006500670065006E0020006D00650069006E00200050006F007200790067006F006E000A0074006100750073006300680065006E003F00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2652,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tauschst du dein Porygon gegen mein Porygon?<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "005400610075007300630068007300740020006400750020006400650069006E00200050006F007200790067006F006E00200067006500670065006E0020006D00650069006E00200050006F007200790067006F006E003F00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Ja gerne!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2764,
      "rawDecodedUtf16Hex": "004A00610020006700650072006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Lieber nicht...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2784,
      "rawDecodedUtf16Hex": "004C006900650062006500720020006E0069006300680074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Ach, komm! Ein Porygon-Tausch ist doch total\naufregend!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2816,
      "rawDecodedUtf16Hex": "004100630068002C0020006B006F006D006D0021002000450069006E00200050006F007200790067006F006E002D005400610075007300630068002000690073007400200064006F0063006800200074006F00740061006C000A0061007500660072006500670065006E0064002100100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Dann lass uns tauschen!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2936,
      "rawDecodedUtf16Hex": "00440061006E006E0020006C00610073007300200075006E007300200074006100750073006300680065006E002100100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Ach, komm! Lass uns unsere Porygon tauschen!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "004100630068002C0020006B006F006D006D00210020004C00610073007300200075006E007300200075006E007300650072006500200050006F007200790067006F006E00200074006100750073006300680065006E002100100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Nein, nein, ich wollte ein Porygon. Bitte tausch\nein Porygon mit mir.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3092,
      "rawDecodedUtf16Hex": "004E00650069006E002C0020006E00650069006E002C002000690063006800200077006F006C006C00740065002000650069006E00200050006F007200790067006F006E002E0020004200690074007400650020007400610075007300630068000A00650069006E00200050006F007200790067006F006E0020006D006900740020006D00690072002E00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Nanu? Wird es etwa... glatter?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3240,
      "rawDecodedUtf16Hex": "004E0061006E0075003F0020005700690072006400200065007300200065007400770061002E002E002E00200067006C00610074007400650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Das ist meine kleine Überraschung für dich.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3304,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020006D00650069006E00650020006B006C00650069006E0065002000DC006200650072007200610073006300680075006E00670020006600FC007200200064006900630068002E00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Ich hatte dem Porygon, das ich eben mit dir\ngetauscht habe, vorher ein Upgrade zum Tragen<U+0010><U+0001>븀\ngegeben.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Deswegen hat es sich zu Porygon2 entwickelt!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3612,
      "rawDecodedUtf16Hex": "0044006500730077006500670065006E0020006800610074002000650073002000730069006300680020007A007500200050006F007200790067006F006E003200200065006E0074007700690063006B0065006C0074002100100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Na? Findest du nicht auch, dass es jetzt viel\nglatter aussieht? Daran merkt man, dass die<U+0010><U+0001>븀\nRechenleistung gestiegen ist.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Diese Version wurde auch mit künstlicher\nIntelligenz und einem Programm zur Erschließung<U+0010><U+0001>븀\nanderer Planeten ausgestattet, aber...<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "Tja, wie soll ich sagen... Es ist und bleibt\nausbaufähig.<U+0010><U+0001>븁\nAber gerade das macht es so unheimlich\nliebenswert.<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4240,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Nanu? Dieser Glanz...<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4476,
      "rawDecodedUtf16Hex": "004E0061006E0075003F002000440069006500730065007200200047006C0061006E007A002E002E002E00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Aha, du hattest Porygon also auch ein Upgrade\nzum Tragen gegeben!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4528,
      "rawDecodedUtf16Hex": "004100680061002C0020006400750020006800610074007400650073007400200050006F007200790067006F006E00200061006C0073006F00200061007500630068002000650069006E00200055007000670072006100640065000A007A0075006D002000540072006100670065006E0020006700650067006500620065006E002100100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Das war dann wohl deine kleine Überraschung.\nEin Hoch auf den Pokémon-Tausch!<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>뷿!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4832,
      "rawDecodedUtf16Hex": "00100002BDFF00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich frage mich, ob ich Porygon2 ebenfalls\naktualisieren soll...<U+0010><U+0002>ĔƯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4844,
      "rawDecodedUtf16Hex": "0049006300680020006600720061006700650020006D006900630068002C0020006F0062002000690063006800200050006F007200790067006F006E00320020006500620065006E00660061006C006C0073000A0061006B007400750061006C006900730069006500720065006E00200073006F006C006C002E002E002E00100002011401AF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Pory.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
