  "messages": [
    {
      "displayText": "You... Wait a tick—aren’t you the Trainer known\nas <U+0010><U+0002>Ā<U+0000>? From Team MZ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
