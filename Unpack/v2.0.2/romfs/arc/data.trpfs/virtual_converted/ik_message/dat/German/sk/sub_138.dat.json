      "offsetInSection": 2036,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hast du die vier Pokémon mitgebracht, die ich\nmir gewünscht habe?<U+0010><U+0002>ĔƵ",
