      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "但你们真是默契十足！<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 876,
