  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Rejoins mes Narickers !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "00520065006A006F0069006E00730020006D006500730020004E0061007200690063006B00650072007300200021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Nariri ! Nariri ! Narickers !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "004E00610072006900720069002000210020004E00610072006900720069002000210020004E0061007200690063006B00650072007300200021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "C’est pas Narica, c’est une arnaque !<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "0043201900650073007400200070006100730020004E00610072006900630061002C00200063201900650073007400200075006E0065002000610072006E00610071007500650020002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Elle ne dirait jamais une telle chose.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 596,
      "rawDecodedUtf16Hex": "0045006C006C00650020006E006500200064006900720061006900740020006A0061006D00610069007300200075006E0065002000740065006C006C0065002000630068006F00730065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Eh ben, on peut rien t’cacher !<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "00450068002000620065006E002C0020006F006E002000700065007500740020007200690065006E0020007420190063006100630068006500720020002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Mais avoue que cet hologramme est un bon\nmoyen d’attirer plus de fans !<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "On n’a pas besoin de pseudo-Narickers.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "004F006E0020006E2019006100200070006100730020006200650073006F0069006E002000640065002000700073006500750064006F002D004E0061007200690063006B006500720073002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Le titre de Naricker ne revient qu’aux fans\nqui aiment Narica du fond du cœur.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "BALIVERNES !<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "00420041004C0049005600450052004E004500530020002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Tout l’monde devrait pouvoir devenir Naricker,\nsans forcément avoir à aimer à la folie !<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Urgh... Alors, il faut aussi accepter\nles pseudo-fans ?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "0055007200670068002E002E002E00200041006C006F00720073002C00200069006C00200066006100750074002000610075007300730069002000610063006300650070007400650072000A006C00650073002000700073006500750064006F002D00660061006E00730020003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "PAPI !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1508,
      "rawDecodedUtf16Hex": "005000410050004900200021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Je comprends ce qu’Albia veut dire...\nMais arrêtez d’vous disputer !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "004A006500200063006F006D007000720065006E0064007300200063006500200071007520190041006C0062006900610020007600650075007400200064006900720065002E002E002E000A004D006100690073002000610072007200EA00740065007A0020006420190076006F0075007300200064006900730070007500740065007200200021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Les disputes entre Dresseurs, ça s’règle avec\nun combat ! Ça vous dit ?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Un combat ? Chouette !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "0055006E00200063006F006D0062006100740020003F002000430068006F00750065007400740065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Plus tard, peut-être.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "0050006C0075007300200074006100720064002C00200070006500750074002D00EA007400720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Allez, s’il te plaît, je dois me battre.\nJ’ai quelque chose à prouver.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1924,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Je vais montrer ce que ça représente pour moi\nd’être une Naricker.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2076,
      "rawDecodedUtf16Hex": "004A0065002000760061006900730020006D006F006E00740072006500720020006300650020007100750065002000E700610020007200650070007200E900730065006E0074006500200070006F007500720020006D006F0069000A0064201900EA00740072006500200075006E00650020004E0061007200690063006B00650072002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "J’aime pas quand papi s’fait passer pour moi,\nmais j’veux quand même me battre contre Albia !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2232,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Comme j’incarne Narica pendant les Nari-Quiz,\nc’est comme si vous alliez affronter DEUX Narica !<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2428,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Battons-nous !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2632,
      "rawDecodedUtf16Hex": "0042006100740074006F006E0073002D006E006F00750073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Attendez un instant...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "0041007400740065006E00640065007A00200075006E00200069006E007300740061006E0074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Quoi, tu te dégonfles ?\nAllez, bats-toi !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "00510075006F0069002C0020007400750020007400650020006400E90067006F006E0066006C006500730020003F000A0041006C006C0065007A002C00200062006100740073002D0074006F006900200021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Estimez-vous heureu<U+0010><U+0003>ᄀÿ́xses de pouvoir m’affronter !\nPar contre, on joue pour la « win » !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Tu vas te décider, oui ou non ?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2996,
      "rawDecodedUtf16Hex": "0054007500200076006100730020007400650020006400E900630069006400650072002C0020006F007500690020006F00750020006E006F006E0020003F00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Si on gagne, tous vos amis devront devenir\ndes Narickers !<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3068,
      "rawDecodedUtf16Hex": "005300690020006F006E0020006700610067006E0065002C00200074006F0075007300200076006F007300200061006D0069007300200064006500760072006F006E007400200064006500760065006E00690072000A0064006500730020004E0061007200690063006B0065007200730020002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Je vais montrer ce que c’est qu’être une Naricker.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3196,
      "rawDecodedUtf16Hex": "004A0065002000760061006900730020006D006F006E00740072006500720020006300650020007100750065002000632019006500730074002000710075201900EA00740072006500200075006E00650020004E0061007200690063006B00650072002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3308,
      "rawDecodedUtf16Hex": "00100002BDFF001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ohmassacre, méga-évolue !\nFull boost en puissance !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 3320,
      "rawDecodedUtf16Hex": "004F0068006D0061007300730061006300720065002C0020006D00E900670061002D00E90076006F006C0075006500200021000A00460075006C006C00200062006F006F0073007400200065006E0020007000750069007300730061006E0063006500200021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Minotaupe ! Méga-évolue, mon grand !\nMontre-leur de quel bois on s’chauffe !<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Lugulabre... Aide-moi à exprimer mon amour\nen méga-évoluant...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3596,
      "rawDecodedUtf16Hex": "004C007500670075006C0061006200720065002E002E002E00200041006900640065002D006D006F0069002000E0002000650078007000720069006D006500720020006D006F006E00200061006D006F00750072000A0065006E0020006D00E900670061002D00E90076006F006C00750061006E0074002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3732,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Je suis une vraie Naricker...\nEt je prends ce rôle très à cœur...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3744,
      "rawDecodedUtf16Hex": "004A00650020007300750069007300200075006E00650020007600720061006900650020004E0061007200690063006B00650072002E002E002E000A004500740020006A00650020007000720065006E006400730020006300650020007200F4006C006500200074007200E80073002000E000200063015300750072002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Albia...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 3884,
      "rawDecodedUtf16Hex": "0041006C006200690061002E002E002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Mais je pense que plus de gens devraient voir\nquelle personne remarquable tu es.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3912,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Mes fans sont importants pour moi...\nMais toi, Albia, t’occupes une place spéciale !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Merci... ♡<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4264,
      "rawDecodedUtf16Hex": "004D0065007200630069002E002E002E0020266100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Par contre, duper les gens avec un hologramme,\nc’est malhonnête...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4296,
      "rawDecodedUtf16Hex": "00500061007200200063006F006E007400720065002C0020006400750070006500720020006C00650073002000670065006E00730020006100760065006300200075006E00200068006F006C006F006700720061006D006D0065002C000A006320190065007300740020006D0061006C0068006F006E006E00EA00740065002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Ah ! Tu vois, papi, j’te l’avais dit !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 4440,
      "rawDecodedUtf16Hex": "004100680020002100200054007500200076006F00690073002C00200070006100700069002C0020006A2019007400650020006C201900610076006100690073002000640069007400200021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Tenez, c’est pour vous deux.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4528,
      "rawDecodedUtf16Hex": "00540065006E0065007A002C00200063201900650073007400200070006F0075007200200076006F0075007300200064006500750078002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Vous obtenez un survêtement de Narica\nd’une autre couleur !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4596,
      "rawDecodedUtf16Hex": "0056006F007500730020006F006200740065006E0065007A00200075006E0020007300750072007600EA00740065006D0065006E00740020006400650020004E00610072006900630061000A006420190075006E006500200061007500740072006500200063006F0075006C006500750072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "J’ai aussi entendu dire que quelqu’un au salon de\ncoiffure savait reproduire ma coupe à l’identique.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Je... Je ne savais pas...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4928,
      "rawDecodedUtf16Hex": "004A0065002E002E002E0020004A00650020006E006500200073006100760061006900730020007000610073002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Sur ce, j’compte sur vous pour rester mes fidèles\nNarickers ! La question s’pose pas pour toi, Albia !<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "J’ai quand même le seum d’avoir perdu, alors que\nj’avais bien entraîné Ohmassacre et mon équipe...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5204,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Quel produit j’vais bien pouvoir inventer pour\nattirer plus de fans... ?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Narica...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5568,
      "rawDecodedUtf16Hex": "004E00610072006900630061002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    }
