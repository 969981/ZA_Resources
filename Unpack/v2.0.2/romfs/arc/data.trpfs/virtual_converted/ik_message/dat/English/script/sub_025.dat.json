  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "How many times have I gotta tell ya? There’s no\nPokémon stronger than my Arbok, see!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Pshaw! The scariest thing ’bout it is a silly pattern\non its belly! Glalie’s a million times gnarlier!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "Huh? What’re you lookin’ at?!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "004800750068003F0020005700680061007420190072006500200079006F00750020006C006F006F006B0069006E2019002000610074003F0021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Actually, you’re gonna help us sort this out!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "00410063007400750061006C006C0079002C00200079006F007520190072006500200067006F006E006E0061002000680065006C007000200075007300200073006F00720074002000740068006900730020006F007500740021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "All you gotta do is face us in battle. Easy, right?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "0041006C006C00200079006F007500200067006F00740074006100200064006F0020006900730020006600610063006500200075007300200069006E00200062006100740074006C0065002E00200045006100730079002C002000720069006700680074003F001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "First, it’ll be one of your Pokémon against my\nArbok, one-on-one.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "00460069007200730074002C0020006900742019006C006C0020006200650020006F006E00650020006F006600200079006F0075007200200050006F006B00E9006D006F006E00200061006700610069006E007300740020006D0079000A004100720062006F006B002C0020006F006E0065002D006F006E002D006F006E0065002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Then, same deal with him. One of your Pokémon\nversus his Glalie.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "005400680065006E002C002000730061006D00650020006400650061006C00200077006900740068002000680069006D002E0020004F006E00650020006F006600200079006F0075007200200050006F006B00E9006D006F006E000A007600650072007300750073002000680069007300200047006C0061006C00690065002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "It’s decided! We’ll decide once and for all which\nof our Pokémon is stronger—by battling you!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "You’re up against me first! One-on-one against\nmy Arbok!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "0059006F007520190072006500200075007000200061006700610069006E007300740020006D006500200066006900720073007400210020004F006E0065002D006F006E002D006F006E006500200061006700610069006E00730074000A006D00790020004100720062006F006B0021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "I’m gonna win",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "00492019006D00200067006F006E006E0061002000770069006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "I’m not ready",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "00492019006D0020006E006F00740020007200650061006400790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Well, hurry up! Just use whatever Pokémon you\nlike and face me!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "00570065006C006C002C00200068007500720072007900200075007000210020004A007500730074002000750073006500200077006800610074006500760065007200200050006F006B00E9006D006F006E00200079006F0075000A006C0069006B006500200061006E0064002000660061006300650020006D00650021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Hold on, I’ve only got my Arbok! The deal is that\nyou’ve gotta battle with only one Pokémon too.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Hurry up and lose already!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2020,
      "rawDecodedUtf16Hex": "0048007500720072007900200075007000200061006E00640020006C006F0073006500200061006C007200650061006400790021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2084,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "You better give this loser a proper whipping!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2096,
      "rawDecodedUtf16Hex": "0059006F0075002000620065007400740065007200200067006900760065002000740068006900730020006C006F00730065007200200061002000700072006F0070006500720020007700680069007000700069006E00670021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "My Arbok...lost...<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "004D00790020004100720062006F006B002E002E002E006C006F00730074002E002E002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Pahahaha! Who’d have thought, eh? Well, guess\nthis means my Glalie really must be the strongest!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2256,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Now your Pokémon and my Glalie are going to\nhave a one-on-one!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2460,
      "rawDecodedUtf16Hex": "004E006F007700200079006F0075007200200050006F006B00E9006D006F006E00200061006E00640020006D007900200047006C0061006C00690065002000610072006500200067006F0069006E006700200074006F000A0068006100760065002000610020006F006E0065002D006F006E002D006F006E00650021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "You’re battlin’ me and my Glalie next! As a one-\non-one thing, obviously.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Gonna win again",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2764,
      "rawDecodedUtf16Hex": "0047006F006E006E0061002000770069006E00200061006700610069006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "I still need to prep",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2796,
      "rawDecodedUtf16Hex": "00490020007300740069006C006C0020006E00650065006400200074006F002000700072006500700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "That so? I’m just gonna assume that means my\nGlalie is the strongest.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2840,
      "rawDecodedUtf16Hex": "005400680061007400200073006F003F002000492019006D0020006A00750073007400200067006F006E006E006100200061007300730075006D0065002000740068006100740020006D00650061006E00730020006D0079000A0047006C0061006C0069006500200069007300200074006800650020007300740072006F006E0067006500730074002E001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "What part of “one-on-one” did you not get?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2988,
      "rawDecodedUtf16Hex": "0057006800610074002000700061007200740020006F00660020201C006F006E0065002D006F006E002D006F006E0065201D002000640069006400200079006F00750020006E006F00740020006700650074003F001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "You don’t stand a chance!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "0059006F007500200064006F006E201900740020007300740061006E0064002000610020006300680061006E006300650021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3144,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Blast... Who...who in the world are you?<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3156,
      "rawDecodedUtf16Hex": "0042006C006100730074002E002E002E002000570068006F002E002E002E00770068006F00200069006E002000740068006500200077006F0072006C0064002000610072006500200079006F0075003F001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3248,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "I can’t believe it... Even my Glalie was defeated like\nit was nothin’...<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 3260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Well, ain’t this just great! We both got stomped!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3416,
      "rawDecodedUtf16Hex": "00570065006C006C002C002000610069006E20190074002000740068006900730020006A007500730074002000670072006500610074002100200057006500200062006F0074006800200067006F0074002000730074006F006D0070006500640021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "This can only mean one thing... My Arbok isn’t\nthe strongest, and neither is your Glalie.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "That’s right! The strongest is this kid’s partner\n<U+0010><U+0002>ā<U+0002>!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3712,
      "rawDecodedUtf16Hex": "005400680061007420190073002000720069006700680074002100200054006800650020007300740072006F006E0067006500730074002000690073002000740068006900730020006B006900642019007300200070006100720074006E00650072000A00100002010100020021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "We were just big Magikarp in a small pond...<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3832,
      "rawDecodedUtf16Hex": "00570065002000770065007200650020006A00750073007400200062006900670020004D006100670069006B00610072007000200069006E0020006100200073006D0061006C006C00200070006F006E0064002E002E002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "I know what to strive for now, though—thanks to\nyou, kid!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 3932,
      "rawDecodedUtf16Hex": "00490020006B006E006F00770020007700680061007400200074006F002000730074007200690076006500200066006F00720020006E006F0077002C002000740068006F0075006700682014007400680061006E006B007300200074006F000A0079006F0075002C0020006B006900640021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Right! And I’m gonna strive way harder and leave\nthis chump and his Glalie in the dust!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4056,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "As if I’d let you get ahead of me! We’re gonna\nkeep battlin’ so I can put you in your place!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 4240,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    }
