      "rawDecodedUtf16Hex": "004900700070006F006E00210021002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "The winners are the Sawk Squad and its team\ncaptain, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6544,
      "rawDecodedUtf16Hex": "005400680065002000770069006E006E006500720073002000610072006500200074006800650020005300610077006B00200053007100750061006400200061006E006400200069007400730020007400650061006D000A006300610070007400610069006E002C00200010000201000000002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "You did it! Together, we’ve proven Sawk’s glory!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6672,
      "rawDecodedUtf16Hex": "0059006F00750020006400690064002000690074002100200054006F006700650074006800650072002C002000770065201900760065002000700072006F00760065006E0020005300610077006B2019007300200067006C006F00720079002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "You fought admirably.<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6780,
      "rawDecodedUtf16Hex": "0059006F007500200066006F0075006700680074002000610064006D0069007200610062006C0079002E00100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Thank you—but this victory truly belongs to\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0001>븁\nHonestly, our competition has given me a new\nadmiration for Throh. I hope you’ll teach me more<U+0010><U+0001>븀\nabout what makes it so cool!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 184
    },
    {
      "displayText": "The winners are the Throh Throng and its team\ncaptain, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 7200,
      "rawDecodedUtf16Hex": "005400680065002000770069006E006E006500720073002000610072006500200074006800650020005400680072006F00680020005400680072006F006E006700200061006E006400200069007400730020007400650061006D000A006300610070007400610069006E002C00200010000201000000002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "You did it! This is a victory for all Throh!<U+0010><U+0002>Ĕǉ",
