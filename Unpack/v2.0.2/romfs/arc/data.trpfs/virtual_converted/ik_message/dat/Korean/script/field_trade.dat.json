      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "흐음~ 아쉽다!\n마음이 바뀌면 얘기해 줘!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
