      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "53EF60E1FF01000A90194E0B5B50902352DD7D0093048981558A505C4E8620262026FF0100100002011401370000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "不，還沒呢！\n只要我這個搭檔獲勝，就還是連勝！<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1420,
      "rawDecodedUtf16Hex": "4E0DFF0C90846C925462FF01000A53EA898162119019500B642D6A94737252DDFF0C5C319084662F902352DDFF0100100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "所以，下一個換我上場！\n我不會讓<U+0010><U+0003>ᄀÿā你妳打斷我們的連勝紀錄的！<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "62404EE5FF0C4E0B4E00500B63DB62114E0A5834FF01000A62114E0D67038B9300100003110000FF01014F6059B3625365B7621150117684902352DD7D0093047684FF0100100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1556,
      "rawDecodedUtf16Hex": "00100002BDFF00170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "只要我獲勝，就還是連勝！\n我們快點一決勝負吧！<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "53EA89816211737252DDFF0C5C319084662F902352DDFF01000A621150115FEB9EDE4E006C7A52DD8CA05427FF0100100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "一決勝負吧",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "4E006C7A52DD8CA054270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "我準備一下",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "62116E9650994E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "我猜<U+0010><U+0003>ᄀÿā你妳是害怕我把寶可夢們變弱吧。<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1648,
      "rawDecodedUtf16Hex": "6211731C00100003110000FF01014F6059B3662F5BB360156211628A5BF653EF592250118B8A5F315427300200100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "我的寶可夢拿手的變化招式\n會讓對手的寶可夢能力下降！<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "621176845BF653EF592262FF624B76848B8A531662DB5F0F000A67038B935C0D624B76845BF653EF592280FD529B4E0B964DFF0100100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "沒錯，也就是說\n<U+0010><U+0003>ᄀÿā你妳是無法像平時那樣戰鬥的！<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1768,
      "rawDecodedUtf16Hex": "6C92932FFF0C4E5F5C31662F8AAA000A00100003110000FF01014F6059B3662F71216CD550CF5E73664290A36A2362309B257684FF0100100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我們是兩人一組的連勝搭檔！\n一個輸了也不算輸！<U+0010><U+0002>Ĕķ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "62115011662F51694EBA4E007D447684902352DD642D6A94FF01000A4E00500B8F384E864E5F4E0D7B978F38FF0100100002011401370000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1900,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我們兩個的變化招式\n竟然不管用……！<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
