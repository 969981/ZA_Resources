      "rawDecodedUtf16Hex": "621150115169500B76848B8A531662DB5F0F000A7ADF71364E0D7BA1752820262026FF0100100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "即使把自己的寶可夢變強了……<U+0010><U+0002>Ĕķ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 1960,
      "rawDecodedUtf16Hex": "53734F7F628A81EA5DF176845BF653EF59228B8A5F374E862026202600100002011401370000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "即使把對手的寶可夢變弱了……<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2000,
      "rawDecodedUtf16Hex": "53734F7F628A5C0D624B76845BF653EF59228B8A5F314E862026202600100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "光是那樣也無法拿下勝利……！<U+0010><U+0002>Ĕķ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "5149662F90A36A234E5F71216CD562FF4E0B52DD522920262026FF0100100002011401370000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "這位寶可夢訓練家，\n請告訴我們對戰的重要關鍵是什麼吧。<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "90194F4D5BF653EF59228A137DF45BB6FF0C000A8ACB544A8A34621150115C0D6230768491CD898195DC9375662F4EC09EBC5427300200100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "相信寶可夢",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2144,
      "rawDecodedUtf16Hex": "76F84FE15BF653EF59220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "鍛鍊寶可夢",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "935B934A5BF653EF59220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "的確是一點也沒錯。<U+0010><U+0002>Ĕķ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2168,
      "rawDecodedUtf16Hex": "768478BA662F4E009EDE4E5F6C92932F300200100002011401370000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "讓寶可夢變強或變弱都是追求勝利的手段，\n但並不是必勝法寶。<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "8B935BF653EF59228B8A5F3762168B8A5F3190FD662F8FFD6C4252DD52297684624B6BB5FF0C000A4F464E264E0D662F5FC552DD6CD55BF6300200100002011401380000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "我從<U+0010><U+0003>ᄀÿā你妳身上學到了重要的事。\n寶可夢對戰真是博大精深呢。<U+0010><U+0002>Ĕķ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "62115F9E00100003110000FF01014F6059B38EAB4E0A5B7852304E8691CD898176844E8B3002000A5BF653EF59225C0D6230771F662F535A59277CBE6DF15462300200100002011401370000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "能和<U+0010><U+0003>ᄀÿā你妳對戰真是太好了。\n這位陌生的訓練家！<U+0010><U+0002>Ĕĸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2340,
