  "initialKey": 0,
  "messages": [
    {
      "displayText": "Tritt ein,\nbring Glück herein!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "00540072006900740074002000650069006E002C000A006200720069006E006700200047006C00FC0063006B002000680065007200650069006E002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Im Sushi-Wok macht Sushi Bock!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "0049006D002000530075007300680069002D0057006F006B0020006D006100630068007400200053007500730068006900200042006F0063006B00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Jetzt schling doch nicht so, das\nEssen wird schon nicht schlecht!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 384,
      "rawDecodedUtf16Hex": "004A00650074007A00740020007300630068006C0069006E006700200064006F006300680020006E006900630068007400200073006F002C0020006400610073000A0045007300730065006E002000770069007200640020007300630068006F006E0020006E00690063006800740020007300630068006C006500630068007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "*hust* *keuch* *röchel*\nIch hab zu schnell gegessen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "002A0068007500730074002A0020002A006B0065007500630068002A0020002A007200F6006300680065006C002A000A00490063006800200068006100620020007A00750020007300630068006E0065006C006C00200067006500670065007300730065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Sie benutzen hier angeblich Zutaten aus weit\nentfernten Regionen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "005300690065002000620065006E00750074007A0065006E0020006800690065007200200061006E006700650062006C0069006300680020005A00750074006100740065006E002000610075007300200077006500690074000A0065006E0074006600650072006E00740065006E00200052006500670069006F006E0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Wow, was du alles weißt!<U+0010><U+0001>븁\n*murmel* Nur blöd, dass alles hier aus der\nAzurbucht kommt...",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Hier beim Sushi-Wok sind\nKampf und Stimmung alles.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "00480069006500720020006200650069006D002000530075007300680069002D0057006F006B002000730069006E0064000A004B0061006D0070006600200075006E00640020005300740069006D006D0075006E006700200061006C006C00650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Ich weiß ja nicht... Der Laden\nhier soll hip sein?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1044,
      "rawDecodedUtf16Hex": "004900630068002000770065006900DF0020006A00610020006E0069006300680074002E002E002E00200044006500720020004C006100640065006E000A006800690065007200200073006F006C006C00200068006900700020007300650069006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Wenn du mit der Hand isst, schau\ndir die Technik vom Profi ab.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "00570065006E006E0020006400750020006D006900740020006400650072002000480061006E006400200069007300730074002C002000730063006800610075000A006400690072002000640069006500200054006500630068006E0069006B00200076006F006D002000500072006F00660069002000610062002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Aaah, Sushi so ganz zwanglos zu\ngenießen ist schon was Feines!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "0041006100610068002C00200053007500730068006900200073006F002000670061006E007A0020007A00770061006E0067006C006F00730020007A0075000A00670065006E0069006500DF0065006E00200069007300740020007300630068006F006E00200077006100730020004600650069006E0065007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Wie man wohl damals auf die Idee\ngekommen ist, so was zu essen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "0057006900650020006D0061006E00200077006F0068006C002000640061006D0061006C00730020006100750066002000640069006500200049006400650065000A00670065006B006F006D006D0065006E0020006900730074002C00200073006F00200077006100730020007A007500200065007300730065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Verglichen mit der Filiale in Alola\nist der Geschmack schon anders...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "0056006500720067006C0069006300680065006E0020006D006900740020006400650072002000460069006C00690061006C006500200069006E00200041006C006F006C0061000A0069007300740020006400650072002000470065007300630068006D00610063006B0020007300630068006F006E00200061006E0064006500720073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Ich bringe meinem Enkel\nalles über Geschmack bei.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "0049006300680020006200720069006E006700650020006D00650069006E0065006D00200045006E006B0065006C000A0061006C006C00650073002000FC006200650072002000470065007300630068006D00610063006B0020006200650069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Wär schon cool, nicht nur Trainer\nzu sein, sondern auch Sushi-Koch!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1772,
      "rawDecodedUtf16Hex": "005700E400720020007300630068006F006E00200063006F006F006C002C0020006E00690063006800740020006E0075007200200054007200610069006E00650072000A007A00750020007300650069006E002C00200073006F006E006400650072006E00200061007500630068002000530075007300680069002D004B006F0063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Lassen Sie es sich\nin Ruhe schmecken.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1908,
      "rawDecodedUtf16Hex": "004C0061007300730065006E002000530069006500200065007300200073006900630068000A0069006E002000520075006800650020007300630068006D00650063006B0065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Ich frage mich, ob Geschmack und Preis hier in\neinem angemessenen Verhältnis stehen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Maki-Sushi... Welch verzaubernde Kombination...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "004D0061006B0069002D00530075007300680069002E002E002E002000570065006C006300680020007600650072007A00610075006200650072006E006400650020004B006F006D00620069006E006100740069006F006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Man muss für neue Geschmäcker offen sein.\nDiese Einstellung hilft auch beim Kämpfen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Absolut! Man sollte einfach den Kampf genießen,\negal, was einem der Gegner auftischt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Welches Menü darf’s\ndenn sein?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "00570065006C00630068006500730020004D0065006E00FC0020006400610072006620190073000A00640065006E006E0020007300650069006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Dieses Sushi... Es verschwindet\nganz von selbst in meinem Mund.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "004400690065007300650073002000530075007300680069002E002E002E002000450073002000760065007200730063006800770069006E006400650074000A00670061006E007A00200076006F006E002000730065006C00620073007400200069006E0020006D00650069006E0065006D0020004D0075006E0064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Bei Sushi muss man einfach\nimmer wieder zugreifen, was?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "0042006500690020005300750073006800690020006D0075007300730020006D0061006E002000650069006E0066006100630068000A0069006D006D0065007200200077006900650064006500720020007A0075006700720065006900660065006E002C0020007700610073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Wenn du zu viel isst,\nwirst du müde.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2900,
      "rawDecodedUtf16Hex": "00570065006E006E0020006400750020007A00750020007600690065006C00200069007300730074002C000A007700690072007300740020006400750020006D00FC00640065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Auaaa, meine Nase!\nWieso brennt das so?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2976,
      "rawDecodedUtf16Hex": "00410075006100610061002C0020006D00650069006E00650020004E0061007300650021000A0057006900650073006F0020006200720065006E006E0074002000640061007300200073006F003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Das ist Wasabi. In Paldea machen\nsie daraus wohl eine Soße.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3060,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020005700610073006100620069002E00200049006E002000500061006C0064006500610020006D0061006300680065006E000A007300690065002000640061007200610075007300200077006F0068006C002000650069006E006500200053006F00DF0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Das vermehrte Aufkommen von Pokémon in der\nStadt bietet viel Potenzial für Unternehmen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Die Vertragsverhandlungen sind gut gelaufen.\nZur Feier des Tages essen wir hier.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3356,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Der Sushi-Wok ist jetzt\nauch im Ausland vertreten.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3520,
      "rawDecodedUtf16Hex": "004400650072002000530075007300680069002D0057006F006B00200069007300740020006A00650074007A0074000A006100750063006800200069006D0020004100750073006C0061006E0064002000760065007200740072006500740065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    }
