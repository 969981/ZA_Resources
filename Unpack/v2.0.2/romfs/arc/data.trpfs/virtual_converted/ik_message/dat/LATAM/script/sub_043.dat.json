      "rawDecodedUtf16Hex": "0050006F00720020006C006F00200076006900730074006F002C002000710075006900650072006500200071007500650020006C006F00200065006E007400720065006E006500730020007400FA002E000A00A10043007500ED00640061006C006F0020006200690065006E002C00200070006F00720020006600610076006F00720021001000020114014C0000",
      "trailingZeroPaddingUnits": 1,
