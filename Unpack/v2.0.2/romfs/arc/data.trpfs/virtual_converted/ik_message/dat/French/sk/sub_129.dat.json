  "messages": [
    {
      "displayText": "Je vais créer une super galette qui dépassera\nla Galette Illumis en popularité !<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
