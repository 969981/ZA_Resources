  "initialKey": 0,
  "messages": [
    {
      "displayText": "Benvenut<U+0010><U+0003>ᄀÿāoa! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "00420065006E00760065006E0075007400100003110000FF0101006F00610021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Gira giravolta... Ogni piatto è una girandola\ndi gusto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 292,
      "rawDecodedUtf16Hex": "0047006900720061002000670069007200610076006F006C00740061002E002E002E0020004F0067006E0069002000700069006100740074006F002000E800200075006E006100200067006900720061006E0064006F006C0061000A0064006900200067007500730074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Lo so, certe pietanze vanno subito\na male, ma mangia con calma!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 404,
      "rawDecodedUtf16Hex": "004C006F00200073006F002C002000630065007200740065002000700069006500740061006E007A0065002000760061006E006E006F002000730075006200690074006F000A00610020006D0061006C0065002C0020006D00610020006D0061006E00670069006100200063006F006E002000630061006C006D006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Ho mangiato così veloce che\nrischiavo di strozzarmi...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "0048006F0020006D0061006E0067006900610074006F00200063006F007300EC002000760065006C006F006300650020006300680065000A00720069007300630068006900610076006F0020006400690020007300740072006F007A007A00610072006D0069002E002E002E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Pare che in questo posto usino ingredienti per\nil sushi provenienti da una regione lontana.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Caspita, quante ne sai!\n(Peccato che in realtà questi vengano dalla Baia<U+0010><U+0001>븀\nAzzurra...)",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Qui al Girasogno anche le lotte\nsono eccezionali!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1004,
      "rawDecodedUtf16Hex": "00510075006900200061006C002000470069007200610073006F0067006E006F00200061006E0063006800650020006C00650020006C006F007400740065000A0073006F006E006F00200065006300630065007A0069006F006E0061006C006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Secondo te questo posto si può\ndefinire \"chic\"?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "005300650063006F006E0064006F002000740065002000710075006500730074006F00200070006F00730074006F00200073006900200070007500F2000A0064006500660069006E0069007200650020002200630068006900630022003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Se vuoi mangiare con le mani,\ncerca di copiare lo chef!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "00530065002000760075006F00690020006D0061006E0067006900610072006500200063006F006E0020006C00650020006D0061006E0069002C000A0063006500720063006100200064006900200063006F007000690061007200650020006C006F0020006300680065006600210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Il sushi si può mangiare senza\ntante formalità, perciò lo adoro!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "0049006C00200073007500730068006900200073006900200070007500F20020006D0061006E00670069006100720065002000730065006E007A0061000A00740061006E0074006500200066006F0072006D0061006C0069007400E0002C00200070006500720063006900F20020006C006F002000610064006F0072006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Chissà com’è nato questo modo\ndi mangiare...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1444,
      "rawDecodedUtf16Hex": "0043006800690073007300E000200063006F006D201900E80020006E00610074006F002000710075006500730074006F0020006D006F0064006F000A006400690020006D0061006E00670069006100720065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Il gusto del sushi nei ristoranti\ndi Alola è vagamente diverso...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "0049006C00200067007500730074006F002000640065006C0020007300750073006800690020006E0065006900200072006900730074006F00720061006E00740069000A0064006900200041006C006F006C0061002000E800200076006100670061006D0065006E007400650020006400690076006500720073006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Questo piccoletto mi supererà...\nSto allenando il suo palato.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "00510075006500730074006F00200070006900630063006F006C006500740074006F0020006D00690020007300750070006500720065007200E0002E002E002E000A00530074006F00200061006C006C0065006E0061006E0064006F00200069006C002000730075006F002000700061006C00610074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Voglio diventare un Allenatore\nche sa anche fare il sushi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1792,
      "rawDecodedUtf16Hex": "0056006F0067006C0069006F00200064006900760065006E007400610072006500200075006E00200041006C006C0065006E00610074006F00720065000A00630068006500200073006100200061006E0063006800650020006600610072006500200069006C00200073007500730068006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Buon appetito!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1912,
      "rawDecodedUtf16Hex": "00420075006F006E00200061007000700065007400690074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Non sono sicura che il rapporto qualità-prezzo\ndi questo ristorante sia bilanciato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Ah, il sushi... Un connubio che ha del magico...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2116,
      "rawDecodedUtf16Hex": "00410068002C00200069006C002000730075007300680069002E002E002E00200055006E00200063006F006E006E007500620069006F0020006300680065002000680061002000640065006C0020006D0061006700690063006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Lasciarsi sorprendere da ingredienti sconosciuti...\nè necessario sia quando si mangia che quando<U+0010><U+0001>븀\nsi lotta!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Eh sì! Basta divertirsi e godersi la lotta senza\npaura, a prescindere da chi sia l’avversario!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Cosa vuole che le porti?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2628,
      "rawDecodedUtf16Hex": "0043006F00730061002000760075006F006C006500200063006800650020006C006500200070006F007200740069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Questo sushi... mi entra in bocca\ndi sua spontanea volontà!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2680,
      "rawDecodedUtf16Hex": "00510075006500730074006F002000730075007300680069002E002E002E0020006D006900200065006E00740072006100200069006E00200062006F006300630061000A006400690020007300750061002000730070006F006E00740061006E0065006100200076006F006C006F006E007400E000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Certo che con il sushi è davvero\ndifficile fermarsi.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2800,
      "rawDecodedUtf16Hex": "0043006500720074006F002000630068006500200063006F006E00200069006C002000730075007300680069002000E80020006400610076007600650072006F000A0064006900660066006900630069006C00650020006600650072006D0061007200730069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Guarda che se ne mangi troppo\npoi ti viene l’abbiocco!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2908,
      "rawDecodedUtf16Hex": "00470075006100720064006100200063006800650020007300650020006E00650020006D0061006E00670069002000740072006F00700070006F000A0070006F00690020007400690020007600690065006E00650020006C20190061006200620069006F00630063006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Ma cosa...?! Lo sento addirittura\nnel naso! È fortissimo!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3020,
      "rawDecodedUtf16Hex": "004D006100200063006F00730061002E002E002E003F00210020004C006F002000730065006E0074006F002000610064006400690072006900740074007500720061000A006E0065006C0020006E00610073006F0021002000C800200066006F007200740069007300730069006D006F002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "È wasabi. Pare che a Paldea\nci facciano una salsa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3140,
      "rawDecodedUtf16Hex": "00C80020007700610073006100620069002E00200050006100720065002000630068006500200061002000500061006C006400650061000A006300690020006600610063006300690061006E006F00200075006E0061002000730061006C00730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "L’aumento dei Pokémon in città è un’opportunità\ncommerciale da non perdere!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Sono venuta a mangiare qui per festeggiare\nla conclusione del contratto.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3396,
      "rawDecodedUtf16Hex": "0053006F006E006F002000760065006E007500740061002000610020006D0061006E0067006900610072006500200071007500690020007000650072002000660065007300740065006700670069006100720065000A006C006100200063006F006E0063006C007500730069006F006E0065002000640065006C00200063006F006E00740072006100740074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Il Ristorante Girasogno ha aperto\nanche all’estero.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3544,
      "rawDecodedUtf16Hex": "0049006C00200052006900730074006F00720061006E00740065002000470069007200610073006F0067006E006F002000680061002000610070006500720074006F000A0061006E00630068006500200061006C006C201900650073007400650072006F002E0000",
