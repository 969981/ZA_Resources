      "index": 47,
      "offsetInSection": 2484,
      "rawDecodedUtf16Hex": "833855B5FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "是上面对吗？<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "662F4E0A97625BF95417FF1F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "茸喵！！",
