  "messages": [
    {
      "displayText": "Benvenut<U+0010><U+0003>ᄀÿāoa al Ristorante Bocca Buona!<U+0010><U+0001>븁\nCibo passabile, atmosfera non male\ne prezzi modici! Vuol favorire?",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Puntare sempre più in alto! Questo è il motto che\nho scolpito nell’anima!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 424,
      "rawDecodedUtf16Hex": "00500075006E0074006100720065002000730065006D00700072006500200070006900F900200069006E00200061006C0074006F0021002000510075006500730074006F002000E800200069006C0020006D006F00740074006F0020006300680065000A0068006F002000730063006F006C007000690074006F0020006E0065006C006C20190061006E0069006D006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Speriamo che vorrà affrontare il\nnostro menu di degustazione! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 8,
      "index": 2,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Devo farmi i complimenti da sola,\nperché non me li fa mai nessuno...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "004400650076006F0020006600610072006D00690020006900200063006F006D0070006C0069006D0065006E0074006900200064006100200073006F006C0061002C000A0070006500720063006800E90020006E006F006E0020006D00650020006C00690020006600610020006D006100690020006E0065007300730075006E006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Scommetto che se potessero i tuoi\nPokémon ti ricoprirebbero di lodi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 4,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "00530063006F006D006D006500740074006F002000630068006500200073006500200070006F007400650073007300650072006F00200069002000740075006F0069000A0050006F006B00E9006D006F006E0020007400690020007200690063006F007000720069007200650062006200650072006F0020006400690020006C006F0064006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Oggi mi concentro sul dessert!\nDessert, dessert e ancora dessert!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1008,
      "rawDecodedUtf16Hex": "004F0067006700690020006D006900200063006F006E00630065006E00740072006F002000730075006C002000640065007300730065007200740021000A0044006500730073006500720074002C002000640065007300730065007200740020006500200061006E0063006F007200610020006400650073007300650072007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "La crêpe Suzette che fanno qui\nè normale... ma così buona!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1140,
      "rawDecodedUtf16Hex": "004C006100200063007200EA00700065002000530075007A00650074007400650020006300680065002000660061006E006E006F0020007100750069000A00E80020006E006F0072006D0061006C0065002E002E002E0020006D006100200063006F007300EC002000620075006F006E006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Che bello pranzare godendosi\nuna bella lotta Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "004300680065002000620065006C006C006F0020007000720061006E007A00610072006500200067006F00640065006E0064006F00730069000A0075006E0061002000620065006C006C00610020006C006F00740074006100200050006F006B00E9006D006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Una lotta insipida rende insipido\ntutto, anche quello che mangio...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "0055006E00610020006C006F00740074006100200069006E007300690070006900640061002000720065006E0064006500200069006E00730069007000690064006F000A0074007500740074006F002C00200061006E0063006800650020007100750065006C006C006F00200063006800650020006D0061006E00670069006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Se inizia un lotta, i bambini non ne\nvogliono sapere di mangiare...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "0053006500200069006E0069007A0069006100200075006E0020006C006F007400740061002C00200069002000620061006D00620069006E00690020006E006F006E0020006E0065000A0076006F0067006C0069006F006E006F00200073006100700065007200650020006400690020006D0061006E00670069006100720065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Quando un Pokémon sta perdendo\nvorrei tanto dargli una Baccacedro!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "005100750061006E0064006F00200075006E00200050006F006B00E9006D006F006E0020007300740061002000700065007200640065006E0064006F000A0076006F0072007200650069002000740061006E0074006F00200064006100720067006C006900200075006E00610020004200610063006300610063006500640072006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Vero? Anch’io!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "005600650072006F003F00200041006E0063006820190069006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Senza il cibo di questo ristorante,\nsprofonderei nella disperazione.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1808,
      "rawDecodedUtf16Hex": "00530065006E007A006100200069006C0020006300690062006F002000640069002000710075006500730074006F00200072006900730074006F00720061006E00740065002C000A007300700072006F0066006F006E006400650072006500690020006E0065006C006C006100200064006900730070006500720061007A0069006F006E0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Se non ti dispiace, preferirei mangiare in pace.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "005300650020006E006F006E002000740069002000640069007300700069006100630065002C002000700072006500660065007200690072006500690020006D0061006E0067006900610072006500200069006E00200070006100630065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Mmmh! Se le mie papille non mentono, qui c’è\nil tocco di chef Monaldo! Il suo talento si fa<U+0010><U+0001>븀\nsempre più... squisito!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Non ne so molto di cucina...\nL’unico chef che conosco è Narciso!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2288,
      "rawDecodedUtf16Hex": "004E006F006E0020006E006500200073006F0020006D006F006C0074006F00200064006900200063007500630069006E0061002E002E002E000A004C20190075006E00690063006F00200063006800650066002000630068006500200063006F006E006F00730063006F002000E80020004E00610072006300690073006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Abbiamo festeggiato qui sia il\nmatrimonio che le nozze d’argento!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2420,
      "rawDecodedUtf16Hex": "00410062006200690061006D006F00200066006500730074006500670067006900610074006F0020007100750069002000730069006100200069006C000A006D0061007400720069006D006F006E0069006F00200063006800650020006C00650020006E006F007A007A00650020006420190061007200670065006E0074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Questo ristorante si addice\nal nostro stile di vita rilassato.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "00510075006500730074006F00200072006900730074006F00720061006E007400650020007300690020006100640064006900630065000A0061006C0020006E006F007300740072006F0020007300740069006C006500200064006900200076006900740061002000720069006C00610073007300610074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Il menu fisso prevede antipasto,\nzuppa e piatto di mare.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2680,
      "rawDecodedUtf16Hex": "0049006C0020006D0065006E007500200066006900730073006F0020007000720065007600650064006500200061006E007400690070006100730074006F002C000A007A007500700070006100200065002000700069006100740074006F0020006400690020006D006100720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Qualche tempo fa il mio compagno\nera un ospite d’onore, qui dentro!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2796,
      "rawDecodedUtf16Hex": "005100750061006C006300680065002000740065006D0070006F00200066006100200069006C0020006D0069006F00200063006F006D007000610067006E006F000A00650072006100200075006E0020006F00730070006900740065002000642019006F006E006F00720065002C0020007100750069002000640065006E00740072006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "È commovente quanto tutto qui\nsia così... normale!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2932,
      "rawDecodedUtf16Hex": "00C800200063006F006D006D006F00760065006E007400650020007100750061006E0074006F00200074007500740074006F0020007100750069000A00730069006100200063006F007300EC002E002E002E0020006E006F0072006D0061006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Ogni portata è un piatto semplice\nma buono! Che meraviglia!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 3036,
      "rawDecodedUtf16Hex": "004F0067006E006900200070006F00720074006100740061002000E800200075006E002000700069006100740074006F002000730065006D0070006C006900630065000A006D0061002000620075006F006E006F002100200043006800650020006D006500720061007600690067006C0069006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
