  "messages": [
    {
      "displayText": "Más allá de\nesta estación...<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 180,
      "rawDecodedUtf16Hex": "004D00E1007300200061006C006C00E1002000640065000A0065007300740061002000650073007400610063006900F3006E002E002E002E00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Más allá de esta estación nos espera un futuro\nprometedor junto a los Pokémon.<U+0010><U+0001>븁\n¡La gente de regiones lejanas siempre se queda\nasombrada al ver las calles de Ciudad Luminalia!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 178
    },
    {
      "displayText": "Me apetece un\ncombate Pokémon.<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "004D00650020006100700065007400650063006500200075006E000A0063006F006D006200610074006500200050006F006B00E9006D006F006E002E00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "He venido a Ciudad Luminalia en busca de la\nemoción de un buen combate.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "00480065002000760065006E00690064006F0020006100200043006900750064006100640020004C0075006D0069006E0061006C0069006100200065006E0020006200750073006300610020006400650020006C0061000A0065006D006F0063006900F3006E00200064006500200075006E0020006200750065006E00200063006F006D0062006100740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¡Hay tantas cafeterías en Ciudad Luminalia!\nSeguro que mi padre se pasa cuatro horas<U+0010><U+0001>븀\neligiendo a cuál ir.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 860,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "¿Nos paramos un poco a descansar en una\ncafetería de por aquí?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1080,
      "rawDecodedUtf16Hex": "00BF004E006F007300200070006100720061006D006F007300200075006E00200070006F0063006F00200061002000640065007300630061006E00730061007200200065006E00200075006E0061000A006300610066006500740065007200ED006100200064006500200070006F0072002000610071007500ED003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "La verdad es que, después de trece horas de viaje,\nestoy hecha polvo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "004C006100200076006500720064006100640020006500730020007100750065002C00200064006500730070007500E9007300200064006500200074007200650063006500200068006F0072006100730020006400650020007600690061006A0065002C000A006500730074006F007900200068006500630068006100200070006F006C0076006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡Qué emoción! ¡A ver con qué Pokémon nos\nencontramos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1348,
      "rawDecodedUtf16Hex": "00A10051007500E900200065006D006F0063006900F3006E0021002000A10041002000760065007200200063006F006E00200071007500E900200050006F006B00E9006D006F006E0020006E006F0073000A0065006E0063006F006E007400720061006D006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "En Ciudad Luminalia hay Pokémon salvajes\npor las calles.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1456,
      "rawDecodedUtf16Hex": "0045006E00200043006900750064006100640020004C0075006D0069006E0061006C00690061002000680061007900200050006F006B00E9006D006F006E002000730061006C00760061006A00650073000A0070006F00720020006C00610073002000630061006C006C00650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¡Ya estamos aquí,\nCiudad Luminalia!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "00A10059006100200065007300740061006D006F0073002000610071007500ED002C000A0043006900750064006100640020004C0075006D0069006E0061006C00690061002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "¡Qué bolsa de viaje tan grande!\n¡Pásatelo bien visitando Ciudad Luminalia!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Quiero saber más cosas sobre cómo ha ido\ncambiando la ciudad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1824,
      "rawDecodedUtf16Hex": "00510075006900650072006F0020007300610062006500720020006D00E1007300200063006F00730061007300200073006F0062007200650020006300F3006D006F002000680061002000690064006F000A00630061006D006200690061006E0064006F0020006C00610020006300690075006400610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Esta es una ciudad con mucha historia,\npero también es una ciudad muy innovadora.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "¡Ya he llegado!\nEspero que me traten bien.<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2112,
      "rawDecodedUtf16Hex": "00A1005900610020006800650020006C006C0065006700610064006F0021000A00450073007000650072006F00200071007500650020006D0065002000740072006100740065006E0020006200690065006E002E00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Voy a aprovechar cada segundo en esta ciudad\ny ganarme esa bienvenida a pulso.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Voy a dejar las maletas en el hotel\ny luego me voy a dar una vuelta.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2388,
      "rawDecodedUtf16Hex": "0056006F007900200061002000640065006A006100720020006C006100730020006D0061006C006500740061007300200065006E00200065006C00200068006F00740065006C000A00790020006C007500650067006F0020006D006500200076006F007900200061002000640061007200200075006E00610020007600750065006C00740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "¡No me esperaba\nmenos de Kalos!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "00A1004E006F0020006D0065002000650073007000650072006100620061000A006D0065006E006F00730020006400650020004B0061006C006F0073002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Las vistas desde el tren son espectaculares!\n¡No me esperaba menos de Kalos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "La verdad es que el aeropuerto está bastante\nlejos de Ciudad Luminalia.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "004C00610020007600650072006400610064002000650073002000710075006500200065006C0020006100650072006F00700075006500720074006F002000650073007400E1002000620061007300740061006E00740065000A006C0065006A006F007300200064006500200043006900750064006100640020004C0075006D0069006E0061006C00690061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
