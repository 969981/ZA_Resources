      "rawDecodedUtf16Hex": "0055006E002E002E002E00200064006500750078002E002E002E002000740072006F00690073002E002E002E0020007100750061007400720065002E002E002E002000630069006E0071002E002E002E0020007300690078002E002E002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Sept... huit... neuf... dix... onze... douze...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5924,
      "rawDecodedUtf16Hex": "0053006500700074002E002E002E00200068007500690074002E002E002E0020006E006500750066002E002E002E0020006400690078002E002E002E0020006F006E007A0065002E002E002E00200064006F0075007A0065002E002E002E00100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "T-treize... ?<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 6028,
      "rawDecodedUtf16Hex": "0054002D0074007200650069007A0065002E002E002E0020003F00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Hein ?! D’où il sort, ce treizième ?!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6064,
      "rawDecodedUtf16Hex": "004800650069006E0020003F0021002000442019006F00F900200069006C00200073006F00720074002C00200063006500200074007200650069007A006900E8006D00650020003F002100100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Que faire ? On ne peut pas l’emmener avec nous,\nnous n’avons que six Poké Balls chacun...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 6148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Je crois que le mieux serait que notre nouvel<U+0010><U+0003>ᄀÿȀle\nami<U+0010><U+0003>ᄀÿĀe Dresseu<U+0010><U+0003>ᄀÿȁrse accepte de l’adopter.<U+0010><U+0001>븁\nSi on le laisse vadrouiller ici, il risque d’abîmer\nles œuvres, ce qui va sûrement mal finir...<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 204
    },
    {
      "displayText": "Oh ? Y a pas assez de place dans tes Boîtes\npour l’accueillir...<U+0010><U+0001>븁\nT’inquiète pas, on va veiller sur lui jusqu’à ce\nque tu puisses revenir le chercher !<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 64,
      "offsetInSection": 6744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 158
    },
    {
      "displayText": "Je me demande s’ils s’étaient tous dispersés dans\nle musée pour trouver ce treizième Pérégrain.<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 7060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Encore merci d’avoir retrouvé tous nos Pérégrain !<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 66,
      "offsetInSection": 7260,
