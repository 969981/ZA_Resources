      "rawDecodedUtf16Hex": "800C4E148FD867098BE15F02768458F097F3000A4ECE5C4B98764E0A4F20676520262026001000020114013F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "不调查原因真是让人坐立不安，\n但又觉得很害怕……<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 544,
