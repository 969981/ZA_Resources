      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "啥？你被冻成大冰坨的时候\n还在吃树果！？<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "5565FF1F4F6088AB51BB6210592751B05768768465F65019000A8FD8572854036811679CFF01FF1F00100002011401800000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
