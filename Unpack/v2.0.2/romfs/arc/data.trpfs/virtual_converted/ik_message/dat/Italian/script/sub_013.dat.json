      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "005400690020006400690073007000690061006300650072006500620062006500200070006F0072007400610072006D006900200075006E002000560061006E0069006C006C006900740065003F00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Se catturi un Vanillite, mettilo in squadra e\ntorna da me!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "005300650020006300610074007400750072006900200075006E002000560061006E0069006C006C006900740065002C0020006D0065007400740069006C006F00200069006E0020007300710075006100640072006100200065000A0074006F0072006E00610020006400610020006D0065002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
