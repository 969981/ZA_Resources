      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "푸호꼬를 위한 너의 노력이\n잘 전해진 모양이야.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
