      "rawDecodedUtf16Hex": "55095466621176845929FF01000A539F4F864E0D662F5728722D57F7FF0C800C662F572863075C0E300200100002011401400000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "這一帶正在發生的紛爭\n還有<U+0010><U+0002>Ȁ<U+0002>件。",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 94,
