      "offsetInSection": 300,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Alcuni dei macchinari si attivano in risposta alla\ntua presenza.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 312,
      "rawDecodedUtf16Hex": "0041006C00630075006E006900200064006500690020006D00610063006300680069006E0061007200690020007300690020006100740074006900760061006E006F00200069006E00200072006900730070006F00730074006100200061006C006C0061000A007400750061002000700072006500730065006E007A0061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Controllo di sicurezza...<U+0010><U+0001>븁\nSono state rilevate le Megapietre necessarie.\nVerrà riattivata una parte del sistema.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "Attivazione Progetto M.<U+0010><U+0001>븁\nProgetto ad alto rischio. Vuoi procedere?",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "004100740074006900760061007A0069006F006E0065002000500072006F0067006500740074006F0020004D002E00100001BE01000A00500072006F0067006500740074006F00200061006400200061006C0074006F0020007200690073006300680069006F002E002000560075006F0069002000700072006F006300650064006500720065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Attiva",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "0041007400740069007600610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Non attivare",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "004E006F006E0020006100740074006900760061007200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, che cosa stai facendo?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 860,
      "rawDecodedUtf16Hex": "0010000201000000002C002000630068006500200063006F007300610020007300740061006900200066006100630065006E0064006F003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Vuoi affrontare Mewtwo? Un Pokémon così\npericoloso...<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "00560075006F006900200061006600660072006F006E00740061007200650020004D0065007700740077006F003F00200055006E00200050006F006B00E9006D006F006E00200063006F007300EC000A00700065007200690063006F006C006F0073006F002E002E002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Devi catturarlo a tutti i costi!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1044,
      "rawDecodedUtf16Hex": "0044006500760069002000630061007400740075007200610072006C006F002000610020007400750074007400690020006900200063006F007300740069002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Cattura Mewtwo a tutti i costi!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "00430061007400740075007200610020004D0065007700740077006F002000610020007400750074007400690020006900200063006F007300740069002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "MEEW!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "004D00450045005700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ti avevo detto di catturare Mewtwo a tutti i costi!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "0054006900200061007600650076006F00200064006500740074006F00200064006900200063006100740074007500720061007200650020004D0065007700740077006F002000610020007400750074007400690020006900200063006F007300740069002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Ti avevo detto di catturare Mewtwo! Va bene che\nsei forte, ma non dovevi sconfiggerlo!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Vedo che l’hai catturato. Aspetta un attimo.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1524,
      "rawDecodedUtf16Hex": "005600650064006F00200063006800650020006C2019006800610069002000630061007400740075007200610074006F002E0020004100730070006500740074006100200075006E00200061007400740069006D006F002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Ogni volta che vedo in che condizioni è questo\nposto provo una certa emozione...<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Ho voluto usare un ologramma perché è molto più\nefficace di una semplice chiamata, non credi?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Ti spiego perché ti sei ritrovat<U+0010><U+0003>ᄀÿāoa a lottare contro\nMewtwo nei Laboratori Elisio.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Sì, spiegami!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2176,
      "rawDecodedUtf16Hex": "005300EC002C0020007300700069006500670061006D006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Se non hai altro da fare...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2204,
      "rawDecodedUtf16Hex": "005300650020006E006F006E002000680061006900200061006C00740072006F00200064006100200066006100720065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Bene! Mi piace il tuo entusiasmo!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2260,
      "rawDecodedUtf16Hex": "00420065006E006500210020004D006900200070006900610063006500200069006C002000740075006F00200065006E007400750073006900610073006D006F002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Diciamo che la tua risposta è un po’ anomala,\nma passiamoci sopra e ti spiego lo stesso.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Mewtwo fu creato da uno scienziato che\nconduceva ricerche sui geni dei Pokémon.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Noi del Team Flare pensammo che potesse\nracchiudere una potente energia e che avremmo<U+0010><U+0001>븀\npotuto incorporarla nell’arma suprema.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "E così, quando scoprimmo che era comparso\nnella Grotta Ignota di Kalos, lo catturammo.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Perché Mewtwo fosse apparso a Kalos rimane\nun mistero.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3140,
      "rawDecodedUtf16Hex": "0050006500720063006800E90020004D0065007700740077006F00200066006F0073007300650020006100700070006100720073006F002000610020004B0061006C006F0073002000720069006D0061006E0065000A0075006E0020006D00690073007400650072006F002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Venne avanzata l’ipotesi che stesse cercando\nil potere della megaevoluzione.<U+0010><U+0001>븁\nMa neppure in cinque riuscimmo a venirne a capo\ne a svelare il mistero della sua apparizione.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 178
    },
    {
      "displayText": "Pure la Mewtwoite X e la Mewtwoite Y in nostro\npossesso si rivelarono inutili: Mewtwo non si è<U+0010><U+0001>븀\nmai megaevoluto.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Per giunta, Mewtwo tende a rimanere inerte allo\nscopo di accumulare energia in vista della lotta.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "E così il Progetto M venne sospeso.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 4060,
      "rawDecodedUtf16Hex": "004500200063006F007300EC00200069006C002000500072006F0067006500740074006F0020004D002000760065006E006E006500200073006F0073007000650073006F002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "A proposito di misteri, non mi è chiaro neanche\nperché Mewtwo questa volta abbia reagito.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 4140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Forse è stata una reazione alla Mewtwoite X e alla\nMewtwoite Y che hai con te.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Che poi non capisco perché che tu abbia\nentrambe le Megapietre... Un altro enigma.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Mah, inutile pensarci.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4672,
      "rawDecodedUtf16Hex": "004D00610068002C00200069006E007500740069006C0065002000700065006E00730061007200630069002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Probabilmente Mewtwo seguirà docilmente\nun<U+0010><U+0003>ᄀÿଊ Allenator’Allenatrice del tuo calibro.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4728,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Adesso devo lasciarti. Ho alcune faccende di cui\noccuparmi in qualità di direttrice sostituta.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4912,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    }
  ],
