  "initialKey": 0,
  "messages": [
    {
      "displayText": "Hey, Team MZ kid!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "004800650079002C0020005400650061006D0020004D005A0020006B006900640021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "I gotta help someone out. So you’re gonna help\nME out. Get it?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "004900200067006F007400740061002000680065006C007000200073006F006D0065006F006E00650020006F00750074002E00200053006F00200079006F007520190072006500200067006F006E006E0061002000680065006C0070000A004D00450020006F00750074002E0020004700650074002000690074003F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Got it!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "0047006F007400200069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Got it...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "0047006F0074002000690074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Good.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 804,
      "rawDecodedUtf16Hex": "0047006F006F0064002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Here’s the deal—I’ve been hearing screams\ncoming from that sewer entrance.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "I’ve gotta go see what’s up, but I hear there’re\nsome menacing Ghost-type Pokémon in there...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "I know the boss thinks pretty highly of you, so I’m\nsure you wouldn’t mind giving me a little hand.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Not because anyone here is scared, obviously!\nWho’s scared? Who said I’m scared?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "You’re tough and you love doing stuff for the city,\nright? Well, here’s your chance! Get in there!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1768,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Time to scour the sewer! You go first.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1780,
      "rawDecodedUtf16Hex": "00540069006D006500200074006F002000730063006F007500720020007400680065002000730065007700650072002100200059006F007500200067006F002000660069007200730074002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Quit lookin’ at me like that! I’m not scared! It’s\njust common sense to put heavy hitters up front!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Huh. Guess things look normal, for a sewer.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2076,
      "rawDecodedUtf16Hex": "004800750068002E0020004700750065007300730020007400680069006E006700730020006C006F006F006B0020006E006F0072006D0061006C002C00200066006F007200200061002000730065007700650072002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Wait, what’s that?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "0057006100690074002C002000770068006100742019007300200074006800610074003F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "GYAAAH!!!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "004700590041004100410048002100210021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "These Pokémon seem to be sleeping...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2248,
      "rawDecodedUtf16Hex": "0054006800650073006500200050006F006B00E9006D006F006E0020007300650065006D00200074006F00200062006500200073006C0065006500700069006E0067002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Ohhh no. I’ve heard about these things in ghost\nstories... They’re Cofagrigus!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Apparently they trap people inside their bodies...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2492,
      "rawDecodedUtf16Hex": "004100700070006100720065006E0074006C00790020007400680065007900200074007200610070002000700065006F0070006C006500200069006E007300690064006500200074006800650069007200200062006F0064006900650073002E002E002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Y-you gotta attack ’em! We gotta drive ’em off\nand find whoever was screaming!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2604,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
