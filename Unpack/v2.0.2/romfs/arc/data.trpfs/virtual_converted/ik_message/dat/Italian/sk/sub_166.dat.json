  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Dai, diventa una Canaglia anche tu!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "004400610069002C00200064006900760065006E0074006100200075006E0061002000430061006E00610067006C0069006100200061006E0063006800650020007400750021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Dai! Per favore!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "004400610069002100200050006500720020006600610076006F007200650021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Volgare impostore.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "0056006F006C006700610072006500200069006D0070006F00730074006F00720065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "La vera Canary non chiederebbe mai per favore.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "004C006100200076006500720061002000430061006E0061007200790020006E006F006E0020006300680069006500640065007200650062006200650020006D0061006900200070006500720020006600610076006F00720065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Eh eh, hai occhio, ragazzina.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "00450068002000650068002C00200068006100690020006F0063006300680069006F002C00200072006100670061007A007A0069006E0061002E00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Ma non pensi che questo espediente potrebbe\nfar conoscere l’affascinante Canary a molta<U+0010><U+0001>븀\npiù gente?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Non ci servono finte Canaglie.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "004E006F006E00200063006900200073006500720076006F006E006F002000660069006E00740065002000430061006E00610067006C00690065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Solo chi ama Canary dal profondo del cuore ha\ndiritto a essere una Canaglia.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "MA CHE DICI?!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "004D0041002000430048004500200044004900430049003F002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Non sono i soldi e il tempo spesi che fanno\nun fan. Basta che la passione sia genuina.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Ugh... Quindi dovremmo accettare le finte\nCanaglie?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "005500670068002E002E002E0020005100750069006E0064006900200064006F007600720065006D006D006F00200061006300630065007400740061007200650020006C0065002000660069006E00740065000A00430061006E00610067006C00690065003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "NONNO!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "004E004F004E004E004F0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Capisco i punti di vista di entrambi, ma per favore,\nnon litigate!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "004300610070006900730063006F00200069002000700075006E0074006900200064006900200076006900730074006100200064006900200065006E007400720061006D00620069002C0020006D006100200070006500720020006600610076006F00720065002C000A006E006F006E0020006C00690074006900670061007400650021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Giusto! Se due Allenatori vogliono confrontarsi,\ndevono farlo a colpi di mosse Pokémon!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Ci sto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "00430069002000730074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Magari un’altra volta",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "004D0061006700610072006900200075006E20190061006C00740072006100200076006F006C007400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Tirarti indietro non fa che ostacolare\nla nostra lotta.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1924,
      "rawDecodedUtf16Hex": "005400690072006100720074006900200069006E00640069006500740072006F0020006E006F006E00200066006100200063006800650020006F0073007400610063006F006C006100720065000A006C00610020006E006F00730074007200610020006C006F007400740061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Dimostrerò quanto arde il mio amore di Canaglia.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "00440069006D006F0073007400720065007200F20020007100750061006E0074006F0020006100720064006500200069006C0020006D0069006F00200061006D006F00720065002000640069002000430061006E00610067006C00690061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Non mi piace quando mio nonno ne combina una\ndelle sue, ma se Imma vuole lottare, pace...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "A conti fatti, se ci pensi, pure io son Canary.\nPensa, avrai l’onore di affrontare ben due Canary!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Andiamo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2560,
      "rawDecodedUtf16Hex": "0041006E006400690061006D006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Aspettate...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2580,
      "rawDecodedUtf16Hex": "004100730070006500740074006100740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "E dai, fatti sotto! Quando ti ricapita un’occasione\ndel genere?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2608,
      "rawDecodedUtf16Hex": "00450020006400610069002C00200066006100740074006900200073006F00740074006F00210020005100750061006E0064006F00200074006900200072006900630061007000690074006100200075006E2019006F00630063006100730069006F006E0065000A00640065006C002000670065006E006500720065003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Ti affronterò, sì, ma a vincere sarò io!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2744,
      "rawDecodedUtf16Hex": "0054006900200061006600660072006F006E00740065007200F2002C0020007300EC002C0020006D006100200061002000760069006E0063006500720065002000730061007200F200200069006F0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "E allora che vuoi fare?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "004500200061006C006C006F007200610020006300680065002000760075006F006900200066006100720065003F00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Se vinco io, tu e il tuo gruppetto diventerete tutti\nCanaglie!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2892,
      "rawDecodedUtf16Hex": "00530065002000760069006E0063006F00200069006F002C0020007400750020006500200069006C002000740075006F002000670072007500700070006500740074006F00200064006900760065006E007400650072006500740065002000740075007400740069000A00430061006E00610067006C00690065002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Dimostrerò quanto arde il mio amore di Canaglia.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "00440069006D006F0073007400720065007200F20020007100750061006E0074006F0020006100720064006500200069006C0020006D0069006F00200061006D006F00720065002000640069002000430061006E00610067006C00690061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3136,
      "rawDecodedUtf16Hex": "00100002BDFF001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Stavolta faccio davvero sul serio! Eelektross,\nmegaevolviti e mostra<U+0010><U+0003>ᄀÿȃglile la tua rapida ascesa!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 5,
      "flagsUpper16": 8,
      "index": 29,
      "offsetInSection": 3148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Forza, Excadrill! Megaevolviti e aiutami a\nrealizzare la mia strategia geniale!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Chandelure... Mostra loro il nostro amore con\nla tua megaevoluzione.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3528,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002E002E002E0020004D006F00730074007200610020006C006F0072006F00200069006C0020006E006F007300740072006F00200061006D006F0072006500200063006F006E000A006C006100200074007500610020006D00650067006100650076006F006C0075007A0069006F006E0065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3676,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Solo io sono un’autentica Canaglia...!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "0053006F006C006F00200069006F00200073006F006E006F00200075006E20190061007500740065006E0074006900630061002000430061006E00610067006C00690061002E002E002E002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Imma...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 3776,
      "rawDecodedUtf16Hex": "0049006D006D0061002E002E002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Ma il fascino di Canary non può essere\nmonopolizzato.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3800,
      "rawDecodedUtf16Hex": "004D006100200069006C002000660061007300630069006E006F002000640069002000430061006E0061007200790020006E006F006E00200070007500F20020006500730073006500720065000A006D006F006E006F0070006F006C0069007A007A00610074006F002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "I miei fan sono importanti, sì, ma tu lo sei ancora\ndi più, Imma.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 3916,
      "rawDecodedUtf16Hex": "00490020006D006900650069002000660061006E00200073006F006E006F00200069006D0070006F007200740061006E00740069002C0020007300EC002C0020006D00610020007400750020006C006F002000730065006900200061006E0063006F00720061000A0064006900200070006900F9002C00200049006D006D0061002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Va bene... ♥<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4056,
      "rawDecodedUtf16Hex": "00560061002000620065006E0065002E002E002E0020266500100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Ma non è giusto ingannare la gente usando un\nologramma di Canary.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4092,
      "rawDecodedUtf16Hex": "004D00610020006E006F006E002000E8002000670069007500730074006F00200069006E00670061006E006E0061007200650020006C0061002000670065006E007400650020007500730061006E0064006F00200075006E000A006F006C006F006700720061006D006D0061002000640069002000430061006E006100720079002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Sentito, nonno?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4232,
      "rawDecodedUtf16Hex": "00530065006E007400690074006F002C0020006E006F006E006E006F003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Comunque, tenete, voi due!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "0043006F006D0075006E007100750065002C002000740065006E006500740065002C00200076006F006900200064007500650021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Hai ricevuto il Completo di Canary con colore\nalternativo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 4336,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F00200069006C00200043006F006D0070006C00650074006F002000640069002000430061006E00610072007900200063006F006E00200063006F006C006F00720065000A0061006C007400650072006E0061007400690076006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Ho saputo che c’è gente che chiede un taglio\ncome il mio al Salone Acconciature.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 4456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Che scelta difficile...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4628,
      "rawDecodedUtf16Hex": "0043006800650020007300630065006C0074006100200064006900660066006900630069006C0065002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "So di poter contare su Imma, ma già che ci siamo,\nspero che pure tu continuerai a seguirmi.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4684,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Comunque assurdo che non riesca mai a battere\n<U+0010><U+0002>Ā<U+0000>, avevo pure allenato i miei<U+0010><U+0001>븀\nPokémon...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 4876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Quale altro prodotto dedicato a Canary potrei\ncreare per far aumentare i suoi fan?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Canary...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5256,
      "rawDecodedUtf16Hex": "00430061006E006100720079002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
