      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Muchas gracias, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4212,
      "rawDecodedUtf16Hex": "004D0075006300680061007300200067007200610063006900610073002C00200010000201000000002E00100002011401C30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Fidough hace fermentar las cosas a su alrededor\ncon la levadura de su aliento. El pan que hicimos<U+0010><U+0001>븀\njuntos tuvo tanto éxito que no he podido<U+0010><U+0001>븀\nsacarlo a pasear mucho estos días.<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 4264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 184
    },
    {
      "displayText": "Pero, a partir de ahora, reduciré la producción\npara poder pasar más tiempo con él.<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 4632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "No es justo que toda la ciudad lo conozca mejor\nque yo. ¡Es tan bonito y mullidito!<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 4808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "¡Fidough!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 4984,
      "rawDecodedUtf16Hex": "00A1004600690064006F00750067006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5004,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Quiero pasar más tiempo con mi Fidough.\n¡Ay, está tan bonito!<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5016,
      "rawDecodedUtf16Hex": "00510075006900650072006F0020007000610073006100720020006D00E100730020007400690065006D0070006F00200063006F006E0020006D00690020004600690064006F007500670068002E000A00A100410079002C002000650073007400E1002000740061006E00200062006F006E00690074006F002100100002011401C30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "¡Dough!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
