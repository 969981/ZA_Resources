      "rawDecodedUtf16Hex": "67094E2A4F2095FB6B6357285FEB901254584E4B95F4000A4F205F976CB86CB8626C626C300200100002011401A70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "你知道安息墓地吧？\n听说一到晚上墓地就会动来动去！<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
