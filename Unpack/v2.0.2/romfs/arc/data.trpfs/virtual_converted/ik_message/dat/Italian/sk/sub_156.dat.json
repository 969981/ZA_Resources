      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Grazie mille, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4404,
      "rawDecodedUtf16Hex": "004700720061007A006900650020006D0069006C006C0065002C00200010000201000000002100100002011401C30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Il lievito contenuto nell’alito di Fidough fa\nfermentare ciò che lo circonda.<U+0010><U+0001>븁\nPer merito suo il mio pane va a ruba, ma di contro\nnon sono riuscita a portarlo fuori in questi giorni.<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 4452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 189
    },
    {
      "displayText": "Ma d’ora in poi eviterò di preparare troppo pane\ne passerò più tempo con Fidough.<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 4832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Puoi biasimarmi? Dopotutto mi rode che tutti\ntranne me abbiano tempo di apprezzare quanto<U+0010><U+0001>븀\nsia grazioso!<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5004,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Fidofiii!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
