      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "要和我对战的话，\n麻烦你同行队伍里只带多丽米亚！<U+0010><U+0002>Ĕŝ",
      "escapedControlUnits": 2,
