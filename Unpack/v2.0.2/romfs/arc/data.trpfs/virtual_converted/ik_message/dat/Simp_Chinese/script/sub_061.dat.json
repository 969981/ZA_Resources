      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "让我等待你让多丽米亚\n发出光辉的那一刻吧。<U+0010><U+0002>Ĕŝ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
