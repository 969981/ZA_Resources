      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "还剩……<U+0010><U+0002>Ȁ<U+0002>个人！<U+0010><U+0002>ĔŜ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 20,
