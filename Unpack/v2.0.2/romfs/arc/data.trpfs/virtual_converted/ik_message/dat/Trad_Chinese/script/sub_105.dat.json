      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "621176845446706B99DD7260000A8B8A62108D857D1A51B0584A99DD4E86FF0100100002011401800000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "我們來到野生特區後……<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 256,
