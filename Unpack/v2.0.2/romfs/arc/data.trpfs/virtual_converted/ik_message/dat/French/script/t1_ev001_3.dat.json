      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 177
    },
    {
      "displayText": "Je veux faire des combats\nPokémon ! Vite ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "004A006500200076006500750078002000660061006900720065002000640065007300200063006F006D0062006100740073000A0050006F006B00E9006D006F006E002000210020005600690074006500200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Je veux faire des combats Pokémon mémorables !\nJe ne suis pas venue à Illumis pour rien !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Il y a plein de cafés à Illumis.\nPapa ne sait jamais lequel choisir...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 924,
      "rawDecodedUtf16Hex": "0049006C002000790020006100200070006C00650069006E002000640065002000630061006600E90073002000E000200049006C006C0075006D00690073002E000A00500061007000610020006E0065002000730061006900740020006A0061006D0061006900730020006C0065007100750065006C002000630068006F0069007300690072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "On s’arrête dans un café pour se reposer ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "004F006E00200073201900610072007200EA00740065002000640061006E007300200075006E002000630061006600E900200070006F007500720020007300650020007200650070006F0073006500720020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Après treize heures de vol, je suis épuisée...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1156,
      "rawDecodedUtf16Hex": "00410070007200E8007300200074007200650069007A0065002000680065007500720065007300200064006500200076006F006C002C0020006A006500200073007500690073002000E9007000750069007300E90065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "J’ai hâte de voir quels Pokémon\non va rencontrer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "004A2019006100690020006800E20074006500200064006500200076006F006900720020007100750065006C007300200050006F006B00E9006D006F006E000A006F006E002000760061002000720065006E0063006F006E0074007200650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Ici, on peut voir des Pokémon\nsauvages même en ville !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1356,
      "rawDecodedUtf16Hex": "004900630069002C0020006F006E0020007000650075007400200076006F00690072002000640065007300200050006F006B00E9006D006F006E000A007300610075007600610067006500730020006D00EA006D006500200065006E002000760069006C006C0065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Enfin ! On est à Illumis ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1468,
      "rawDecodedUtf16Hex": "0045006E00660069006E002000210020004F006E0020006500730074002000E000200049006C006C0075006D0069007300200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Vu la taille de ton sac, je crois que t’as prévu\nde t’éclater à Illumis !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "005600750020006C00610020007400610069006C006C006500200064006500200074006F006E0020007300610063002C0020006A0065002000630072006F0069007300200071007500650020007420190061007300200070007200E900760075000A0064006500200074201900E90063006C0061007400650072002000E000200049006C006C0075006D00690073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Je compte bien voir tout ce qui a changé\nà Illumis ces derniers temps !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1700,
      "rawDecodedUtf16Hex": "004A006500200063006F006D0070007400650020006200690065006E00200076006F0069007200200074006F007500740020006300650020007100750069002000610020006300680061006E006700E9000A00E000200049006C006C0075006D0069007300200063006500730020006400650072006E0069006500720073002000740065006D00700073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Cette ville est ancienne, mais elle n’arrête\njamais d’innover.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "00430065007400740065002000760069006C006C0065002000650073007400200061006E006300690065006E006E0065002C0020006D00610069007300200065006C006C00650020006E201900610072007200EA00740065000A006A0061006D0061006900730020006420190069006E006E006F007600650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Illumis, me voici ! Vous pouvez\ndérouler le tapis rouge ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1972,
      "rawDecodedUtf16Hex": "0049006C006C0075006D00690073002C0020006D006500200076006F0069006300690020002100200056006F0075007300200070006F007500760065007A000A006400E90072006F0075006C006500720020006C006500200074006100700069007300200072006F00750067006500200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Je vais faire honneur à cette ville en profitant de\nchaque millimètre carré qu’elle a à offrir !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Je vais déposer mes valises à\nl’hôtel, j’irai faire un tour après.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "004A0065002000760061006900730020006400E90070006F0073006500720020006D00650073002000760061006C0069007300650073002000E0000A006C2019006800F400740065006C002C0020006A2019006900720061006900200066006100690072006500200075006E00200074006F00750072002000610070007200E80073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "On sent bien qu’on est à Kalos ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2452,
      "rawDecodedUtf16Hex": "004F006E002000730065006E00740020006200690065006E0020007100752019006F006E0020006500730074002000E00020004B0061006C006F007300200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Les paysages qui défilaient par la fenêtre étaient\ntout ce que j’avais imaginé de Kalos !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Je ne m’attendais pas à ce que l’aéroport soit\nsi loin d’Illumis...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2728,
      "rawDecodedUtf16Hex": "004A00650020006E00650020006D20190061007400740065006E00640061006900730020007000610073002000E000200063006500200071007500650020006C2019006100E90072006F0070006F0072007400200073006F00690074000A007300690020006C006F0069006E0020006420190049006C006C0075006D00690073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Si j’ai mon partenaire avec moi,\nje peux voyager tout seul !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2864,
      "rawDecodedUtf16Hex": "005300690020006A2019006100690020006D006F006E002000700061007200740065006E0061006900720065002000610076006500630020006D006F0069002C000A006A00650020007000650075007800200076006F0079006100670065007200200074006F007500740020007300650075006C002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
