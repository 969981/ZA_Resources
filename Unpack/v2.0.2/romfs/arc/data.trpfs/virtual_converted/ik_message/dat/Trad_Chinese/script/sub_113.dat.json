      "offsetInSection": 2824,
      "rawDecodedUtf16Hex": "547154C7559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "捉到呱呱泡蛙了！",
