      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "<U+0010><U+0002>뷿;",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 3140,
      "rawDecodedUtf16Hex": "00100002BDFF003B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
