      "rawDecodedUtf16Hex": "4F464EE5621176845B9D53EF68A6768462DB5F0F000A6CA1529E6CD57834574F5B8320262026001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "啊！灵感来了！\n破坏不了的话，烧了它不就好了？<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "554AFF017075611F67654E86FF01000A7834574F4E0D4E8676848BDDFF0C70E74E865B834E0D5C31597D4E86FF1F001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "拜托你了！<U+0010><U+0001>븁\n为了解决我的烦恼，\n请你用宝可梦的招式<U+0010><U+0001>븀\n把碍事的藤蔓痕迹烧掉吧。<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "62DC62584F604E86FF0100100001BE01000A4E3A4E8689E351B36211768470E6607CFF0C000A8BF74F6075285B9D53EF68A6768462DB5F0F00100001BE00000A628A788D4E8B768485E4851375D58FF970E7638954273002001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
