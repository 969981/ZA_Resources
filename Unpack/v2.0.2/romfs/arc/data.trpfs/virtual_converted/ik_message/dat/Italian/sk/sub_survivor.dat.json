      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Se vieni a parlare con me significa che vuoi\nmollare. Era quella l’intenzione?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
