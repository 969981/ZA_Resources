      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Sei l’Allenatrice di Frigibax, giusto? Vieni a farlo\ngiocare con Bergmite!<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
