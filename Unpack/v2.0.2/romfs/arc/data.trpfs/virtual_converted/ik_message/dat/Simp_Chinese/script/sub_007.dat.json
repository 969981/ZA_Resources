      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "铁壳蛹！<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "94C158F386F9FF01001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "我正朝着成为最强的铁壳蛹训练家\n这个目标进行修炼！请你来当我的对手吧！<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 280,
      "rawDecodedUtf16Hex": "62116B63671D774062104E3A67005F3A768494C158F386F98BAD7EC35BB6000A8FD94E2A76EE68078FDB884C4FEE70BCFF018BF74F6067655F53621176845BF9624B5427FF01001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "如果你准备好跟我打宝可梦对战了，\n就请来跟我说一声吧！<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 360,
      "rawDecodedUtf16Hex": "5982679C4F6051C65907597D8DDF621162535B9D53EF68A65BF962184E86FF0C000A5C318BF767658DDF62118BF44E0058F05427FF01001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 424,
      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "瞧瞧我的铁壳蛹们吧！\n你准备好来对战了吗？<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 436,
      "rawDecodedUtf16Hex": "77A777A76211768494C158F386F94EEC5427FF01000A4F6051C65907597D67655BF962184E865417FF1F001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "准备好了！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "51C65907597D4E86FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "等一下哦",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "7B494E004E0B54E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我都等不及要让你瞧瞧铁壳蛹了……<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "621190FD7B494E0D53CA89818BA94F6077A777A794C158F386F94E8620262026001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "谢谢！<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "8C228C22FF01001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "瞧瞧我的铁壳蛹们吧！<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 572,
