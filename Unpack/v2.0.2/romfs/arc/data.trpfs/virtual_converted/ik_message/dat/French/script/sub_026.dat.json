  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Ces adorables petits sont des Miamiasme.\nCe sont des Pokémon Sac Poubelle.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Ils ont l’air d’apprécier les restes de\nnotre clientèle, donc ils se regroupent ici.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 504,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Miasm !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "004D006900610073006D002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Je suis vraiment contente qu’ils apprécient\nnotre cuisine...<U+0010><U+0001>븁\nMais certaines personnes n’aiment pas leur\nodeur et préfèrent aller dans d’autres cafés...<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 159
    },
    {
      "displayText": "... Attends, j’ai une idée !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1020,
      "rawDecodedUtf16Hex": "002E002E002E00200041007400740065006E00640073002C0020006A20190061006900200075006E006500200069006400E9006500200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "S’ils aiment notre menu, il suffit d’en profiter !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "005320190069006C0073002000610069006D0065006E00740020006E006F0074007200650020006D0065006E0075002C00200069006C00200073007500660066006900740020006420190065006E002000700072006F0066006900740065007200200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "J’aimerais te confier ces Déchets Alléchants\npour que tu ailles les jeter en entraînant les<U+0010><U+0001>븀\nMiamiasme avec toi, par la même occasion !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Dis-moi lorsque tu es prêt<U+0010><U+0003>ᄀÿĀe !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1484,
      "rawDecodedUtf16Hex": "004400690073002D006D006F00690020006C006F0072007300710075006500200074007500200065007300200070007200EA007400100003110000FF0100006500200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Ah, aujourd’hui, c’est une zone de combat...\nEst-ce que tu peux revenir demain ?<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1736,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Dis-moi lorsque tu seras prêt<U+0010><U+0003>ᄀÿĀe à mener\nles Miamiasme aux poubelles !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Je suis prêt<U+0010><U+0003>ᄀÿĀe !",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "004A00650020007300750069007300200070007200EA007400100003110000FF01000065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Pas tout de suite.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "00500061007300200074006F00750074002000640065002000730075006900740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "J’aimerais le faire moi-même, mais je suis\nvraiment occupée...<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "004A201900610069006D006500720061006900730020006C00650020006600610069007200650020006D006F0069002D006D00EA006D0065002C0020006D0061006900730020006A006500200073007500690073000A0076007200610069006D0065006E00740020006F006300630075007000E90065002E002E002E001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Merci, ça m’aide énormément !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2124,
      "rawDecodedUtf16Hex": "004D0065007200630069002C002000E700610020006D20190061006900640065002000E9006E006F0072006D00E9006D0065006E007400200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Avec ça, je suis sûre que les Miamiasme\nte suivront jusqu’aux poubelles !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Attention à ne pas les semer. Marche lentement !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2348,
      "rawDecodedUtf16Hex": "0041007400740065006E00740069006F006E002000E00020006E006500200070006100730020006C00650073002000730065006D00650072002E0020004D006100720063006800650020006C0065006E00740065006D0065006E007400200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Les poubelles sont par là, tout droit !\nBonne chance !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2456,
      "rawDecodedUtf16Hex": "004C0065007300200070006F007500620065006C006C0065007300200073006F006E007400200070006100720020006C00E0002C00200074006F00750074002000640072006F0069007400200021000A0042006F006E006E00650020006300680061006E0063006500200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2576,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Continue tout droit, et dépose les Déchets\nAlléchants au bout de la ruelle !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2752,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Menez les Miamiasme jusqu’au bout de la ruelle !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2764,
      "rawDecodedUtf16Hex": "004D0065006E0065007A0020006C006500730020004D00690061006D006900610073006D00650020006A007500730071007520190061007500200062006F007500740020006400650020006C00610020007200750065006C006C0065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2864,
      "rawDecodedUtf16Hex": "00100002BDFF00170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Voulez-vous déposer les Déchets Alléchants ici ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2876,
      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F007500730020006400E90070006F0073006500720020006C006500730020004400E90063006800650074007300200041006C006C00E9006300680061006E0074007300200069006300690020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Oui",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2976,
      "rawDecodedUtf16Hex": "004F007500690000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Non",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2984,
      "rawDecodedUtf16Hex": "004E006F006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Miamiam !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "004D00690061006D00690061006D002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Les Miamiasme se repaissent\ndes Déchets Alléchants...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3012,
      "rawDecodedUtf16Hex": "004C006500730020004D00690061006D006900610073006D0065002000730065002000720065007000610069007300730065006E0074000A0064006500730020004400E90063006800650074007300200041006C006C00E9006300680061006E00740073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Merci d’avoir jeté nos déchets !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3120,
      "rawDecodedUtf16Hex": "004D006500720063006900200064201900610076006F006900720020006A0065007400E90020006E006F00730020006400E90063006800650074007300200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Maintenant, l’odeur de ces petits Miamiasme\nn’arrivera plus jusqu’au café !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Ils sont tellement mignons quand ils mangent !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3356,
      "rawDecodedUtf16Hex": "0049006C007300200073006F006E0074002000740065006C006C0065006D0065006E00740020006D00690067006E006F006E00730020007100750061006E006400200069006C00730020006D0061006E00670065006E007400200021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Ça fait réfléchir, tu ne trouves pas ?<U+0010><U+0001>븁\nVivre avec les Pokémon, ça ne veut pas dire\nvivre exactement au même endroit qu’eux...<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3460,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Par exemple, les Miamiasme adorent la nourriture\nde notre établissement, mais ils ne peuvent pas<U+0010><U+0001>븀\nla déguster à table avec la clientèle...<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3728,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "Il suffit de déposer leur portion un peu plus loin\npour coexister aisément avec eux !<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "<U+0010><U+0002>뷿#",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4200,
      "rawDecodedUtf16Hex": "00100002BDFF00230000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh, ces Pokémon qui te suivent\nsont adorables !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4212,
      "rawDecodedUtf16Hex": "004F0068002C002000630065007300200050006F006B00E9006D006F006E0020007100750069002000740065002000730075006900760065006E0074000A0073006F006E0074002000610064006F007200610062006C00650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Tiens ! Quel est cet étrange fumet\nque je sens ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4308,
      "rawDecodedUtf16Hex": "005400690065006E0073002000210020005100750065006C00200065007300740020006300650074002000E9007400720061006E00670065002000660075006D00650074000A0071007500650020006A0065002000730065006E00730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Oh, on dirait un Hexadron !\nBon courage !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 4408,
      "rawDecodedUtf16Hex": "004F0068002C0020006F006E002000640069007200610069007400200075006E0020004800650078006100640072006F006E00200021000A0042006F006E00200063006F00750072006100670065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "C’est pratique que les Miamiasme\nmangent les déchets !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4492,
      "rawDecodedUtf16Hex": "0043201900650073007400200070007200610074006900710075006500200071007500650020006C006500730020004D00690061006D006900610073006D0065000A006D0061006E00670065006E00740020006C006500730020006400E900630068006500740073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Tu pars en excursion avec\nces Miamiasme ? C’est sympa !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4604,
      "rawDecodedUtf16Hex": "005400750020007000610072007300200065006E00200065007800630075007200730069006F006E00200061007600650063000A0063006500730020004D00690061006D006900610073006D00650020003F002000432019006500730074002000730079006D00700061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    }
