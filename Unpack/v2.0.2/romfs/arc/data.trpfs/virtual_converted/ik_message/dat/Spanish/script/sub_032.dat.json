    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1520,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un movimiento que ataca con hojas cortantes...<U+0010><U+0001>븁\nSeguro que a Scyther le viene la inspiración si ve\na alguno de tus Pokémon usando <U+0010><U+0002>＀<U+0006>Hoja Afilada<U+0010><U+0002>＀<U+0000>.<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 10,
