  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Du, Opi, mein Gramokles ist nicht gut drauf...\nIch hab es auch schon heilen lassen, aber es geht<U+0010><U+0001>븀\nihm immer noch nicht besser...<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "Hoho, keine Sorge, Acier. Ich weiß, was los ist.\nSeine Klinge ist etwas stumpf geworden.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 544,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Oh... Und wie kann ich ihm dann helfen?<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "004F0068002E002E002E00200055006E006400200077006900650020006B0061006E006E0020006900630068002000690068006D002000640061006E006E002000680065006C00660065006E003F00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Um Gramokles, dem Klingenkraft-Pokémon, zu\neiner scharfen Schneide zu verhelfen, benötigst<U+0010><U+0001>븀\ndu etwas ganz Bestimmtes, und zwar...<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "Ein Pupitar!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1092,
      "rawDecodedUtf16Hex": "00450069006E002000500075007000690074006100720021001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Was? Warum das denn?<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "005700610073003F00200057006100720075006D0020006400610073002000640065006E006E003F00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Pupitars Körper ist äußerst hart, weißt du?\nWenn Gramokles seine stumpfe Klinge mehrmals<U+0010><U+0001>븀\ndaran abschleift, ist sie im Nu wieder scharf!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 143
    },
    {
      "displayText": "Echt? Aber wo kriege ich denn so schnell\nein Pupitar her...?<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1468,
      "rawDecodedUtf16Hex": "0045006300680074003F0020004100620065007200200077006F0020006B007200690065006700650020006900630068002000640065006E006E00200073006F0020007300630068006E0065006C006C000A00650069006E002000500075007000690074006100720020006800650072002E002E002E003F00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Oh! Hey, du da! Hast du vielleicht ein Pupitar?\nWenn ja, lass es bitte gegen mein Gramokles<U+0010><U+0001>븀\nkämpfen!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bitte kämpfe gegen mein Gramokles, okay?\nDafür darf dein Team aber nur aus einem<U+0010><U+0001>븀\nPupitar bestehen!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Wenn Gramokles seine stumpfe Klinge mehrmals\nan Pupitars hartem Körper abschleift, ist sie im<U+0010><U+0001>븀\nNu wieder scharf!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2280,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh, super! Du hast ein Pupitar dabei! Lässt du es\nbitte gegen mein Gramokles kämpfen?<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Aber sicher doch!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2472,
      "rawDecodedUtf16Hex": "0041006200650072002000730069006300680065007200200064006F0063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Vielleicht später...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2508,
      "rawDecodedUtf16Hex": "005600690065006C006C0065006900630068007400200073007000E4007400650072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Oh, okay...<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "004F0068002C0020006F006B00610079002E002E002E00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Danke! Los, kämpfen wir!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2584,
      "rawDecodedUtf16Hex": "00440061006E006B006500210020004C006F0073002C0020006B00E4006D007000660065006E0020007700690072002100100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2644,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wir haben verloren, Gramokles... Komm, ich\nheile dich.<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "00570069007200200068006100620065006E0020007600650072006C006F00720065006E002C0020004700720061006D006F006B006C00650073002E002E002E0020004B006F006D006D002C0020006900630068000A006800650069006C006500200064006900630068002E00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Gramooo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "004700720061006D006F006F006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Was? Gramokles geht es wieder gut!\nDu hattest recht, Opi!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2796,
      "rawDecodedUtf16Hex": "005700610073003F0020004700720061006D006F006B006C0065007300200067006500680074002000650073002000770069006500640065007200200067007500740021000A0044007500200068006100740074006500730074002000720065006300680074002C0020004F00700069002100100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Hoho! Na, sag ich doch.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "0048006F0068006F00210020004E0061002C0020007300610067002000690063006800200064006F00630068002E001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Ein Pupitar war alles, was es brauchte!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2976,
      "rawDecodedUtf16Hex": "00450069006E00200050007500700069007400610072002000770061007200200061006C006C00650073002C00200077006100730020006500730020006200720061007500630068007400650021001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Und ich verrate euch noch etwas: Pupitar ist\nso ein Kampf auch zuträglich.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Denn es kann sich so von der Härte seines Panzers\nüberzeugen. Das erleichtert ihm die Entwicklung!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Jaja... Jetzt übertreibst du aber, Opi.<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "004A0061006A0061002E002E002E0020004A00650074007A0074002000FC006200650072007400720065006900620073007400200064007500200061006200650072002C0020004F00700069002E00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Egal. Hauptsache, Gramokles ist wieder gut drauf!\nDafür bin ich Pupitar voll dankbar!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3520,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Vielen Dank! War echt lieb, dass ihr zwei\nGramokles geholfen habt!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3700,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B00210020005700610072002000650063006800740020006C006900650062002C0020006400610073007300200069006800720020007A007700650069000A004700720061006D006F006B006C006500730020006700650068006F006C00660065006E00200068006100620074002100100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3844,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Pokémon überraschen uns doch immer wieder...<U+0010><U+0001>븁\nSchön, wie sie einander brauchen und\nunterstützen!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    }
