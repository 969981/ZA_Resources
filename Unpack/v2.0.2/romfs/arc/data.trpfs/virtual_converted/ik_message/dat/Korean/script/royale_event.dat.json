      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 3308,
      "rawDecodedUtf16Hex": "001000020109000200100002190000010020ADC0C911D55C0020B3C4AD6CC9C0B9CC000AB098B2940020C794B7290020AC00C9C0ACE00020C788C5B4C11C0020AD1CCC2EC544002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "좋은 걸 드리죠!<U+0010><U+0002>봊\nText_icon1",
