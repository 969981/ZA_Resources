      "rawDecodedUtf16Hex": "00100002010900020010000219000001000AC288D37C0020C2A4D398C15C0020B808C5B4D55C0020AC70B77CACE000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "귀중한 도구를 받으라고!<U+0010><U+0002>봊\nText_icon1",
