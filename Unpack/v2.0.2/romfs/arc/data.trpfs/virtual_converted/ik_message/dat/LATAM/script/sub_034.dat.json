      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Algunos movimientos generan ciertos efectos en\nel campo de batalla, es decir, \"trampas\".<U+0010><U+0002>ĔŃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
