  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Oh, ma ci senti?! Il mio Arbok è il più forte di\ntutti! E spero che ’sta volta l’hai capito.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Sì, va be’... tutta scena! Il tuo c’ha solo quei\nridicoli disegnetti. Ma l’hai vista la faccia del<U+0010><U+0001>븀\nmio Glalie? È mille volte più terrificante!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 150
    },
    {
      "displayText": "Uh? E tu che c’hai da guardare?<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "00550068003F002000450020007400750020006300680065002000632019006800610069002000640061002000670075006100720064006100720065003F001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Aspe’, forse ci puoi servire.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 904,
      "rawDecodedUtf16Hex": "00410073007000652019002C00200066006F007200730065002000630069002000700075006F006900200073006500720076006900720065002E001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Devi lottare contro di noi. Facile, no?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 972,
      "rawDecodedUtf16Hex": "00440065007600690020006C006F0074007400610072006500200063006F006E00740072006F0020006400690020006E006F0069002E00200046006100630069006C0065002C0020006E006F003F001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Per cominciare, un tuo Pokémon contro il mio\nArbok: uno contro uno.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "00500065007200200063006F006D0069006E00630069006100720065002C00200075006E002000740075006F00200050006F006B00E9006D006F006E00200063006F006E00740072006F00200069006C0020006D0069006F000A004100720062006F006B003A00200075006E006F00200063006F006E00740072006F00200075006E006F002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "E dopo, la stessa cosa con lui. Un tuo Pokémon\ncontro il suo Glalie.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "004500200064006F0070006F002C0020006C0061002000730074006500730073006100200063006F0073006100200063006F006E0020006C00750069002E00200055006E002000740075006F00200050006F006B00E9006D006F006E000A0063006F006E00740072006F00200069006C002000730075006F00200047006C0061006C00690065002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Così finalmente capiremo chi è più forte\nlottando contro di te! Evvai!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Prima te la vedi col mio Arbok! Uno contro uno.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "005000720069006D00610020007400650020006C00610020007600650064006900200063006F006C0020006D0069006F0020004100720062006F006B002100200055006E006F00200063006F006E00740072006F00200075006E006F002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Vincerò",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "00560069006E00630065007200F20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Devo prepararmi",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "004400650076006F002000700072006500700061007200610072006D00690000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Ma che aspetti! Scegli un Pokémon che ti va\na genio e fatti sotto.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "004D0061002000630068006500200061007300700065007400740069002100200053006300650067006C006900200075006E00200050006F006B00E9006D006F006E0020006300680065002000740069002000760061000A0061002000670065006E0069006F0020006500200066006100740074006900200073006F00740074006F002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Ci fai o ci sei?! Io ho solo un Arbok. Anche tu devi\navere solo un Pokémon in squadra!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Dai, che ti riduco in polpette in un nanosecondo!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1996,
      "rawDecodedUtf16Hex": "004400610069002C0020006300680065002000740069002000720069006400750063006F00200069006E00200070006F006C0070006500740074006500200069006E00200075006E0020006E0061006E006F007300650063006F006E0064006F0021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2104,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vediamo come perde, così me lo tolgo di torno!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2116,
      "rawDecodedUtf16Hex": "00560065006400690061006D006F00200063006F006D0065002000700065007200640065002C00200063006F007300EC0020006D00650020006C006F00200074006F006C0067006F00200064006900200074006F0072006E006F0021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Il mio Arbok... ha perso...<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2232,
      "rawDecodedUtf16Hex": "0049006C0020006D0069006F0020004100720062006F006B002E002E002E00200068006100200070006500720073006F002E002E002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Ti sta bene! Allora vuol dire che il mio Glalie\nè il più forte!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "005400690020007300740061002000620065006E0065002100200041006C006C006F00720061002000760075006F006C00200064006900720065002000630068006500200069006C0020006D0069006F00200047006C0061006C00690065000A00E800200069006C00200070006900F900200066006F0072007400650021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Adesso il tuo Pokémon e il mio Glalie si faranno\nuna bella lotta! Stessa cosa: uno contro uno.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2432,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2632,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Devi lottare contro di me e il mio Glalie!\nSempre uno contro uno, chiaramente.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Vincerò",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2812,
      "rawDecodedUtf16Hex": "00560069006E00630065007200F20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Devo prepararmi",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2828,
      "rawDecodedUtf16Hex": "004400650076006F002000700072006500700061007200610072006D00690000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Ammetti che il mio Glalie è più forte, allora?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 2860,
      "rawDecodedUtf16Hex": "0041006D006D0065007400740069002000630068006500200069006C0020006D0069006F00200047006C0061006C00690065002000E800200070006900F900200066006F007200740065002C00200061006C006C006F00720061003F001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Uno contro uno, l’hai capito?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 2964,
      "rawDecodedUtf16Hex": "0055006E006F00200063006F006E00740072006F00200075006E006F002C0020006C2019006800610069002000630061007000690074006F003F001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Ti polverizzo!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3032,
      "rawDecodedUtf16Hex": "0054006900200070006F006C0076006500720069007A007A006F0021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3072,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ma chi diamine sei...<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "004D006100200063006800690020006400690061006D0069006E00650020007300650069002E002E002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3136,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Anche il mio Glalie s’è preso una batosta...<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 3148,
      "rawDecodedUtf16Hex": "0041006E00630068006500200069006C0020006D0069006F00200047006C0061006C0069006500200073201900E800200070007200650073006F00200075006E00610020006200610074006F007300740061002E002E002E001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Alla fine... abbiamo perso tutti e due!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 3248,
      "rawDecodedUtf16Hex": "0041006C006C0061002000660069006E0065002E002E002E002000610062006200690061006D006F00200070006500720073006F0020007400750074007400690020006500200064007500650021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Il mio Arbok non è il più forte... e non lo è\nneanche il tuo Glalie.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 3336,
      "rawDecodedUtf16Hex": "0049006C0020006D0069006F0020004100720062006F006B0020006E006F006E002000E800200069006C00200070006900F900200066006F007200740065002E002E002E002000650020006E006F006E0020006C006F002000E8000A006E00650061006E00630068006500200069006C002000740075006F00200047006C0061006C00690065002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Il più forte è <U+0010><U+0002>ā<U+0002>...\nIl compagno di quest<U+0010><U+0003>ᄀÿāoa ragazzin<U+0010><U+0003>ᄀÿāoa.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 10,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 3484,
      "rawDecodedUtf16Hex": "0049006C00200070006900F900200066006F007200740065002000E800200010000201010002002E002E002E000A0049006C00200063006F006D007000610067006E006F00200064006900200071007500650073007400100003110000FF0101006F006100200072006100670061007A007A0069006E00100003110000FF0101006F0061002E001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Hai ragione, accidenti. Abbiamo fatto una figura\nbarbina...<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 3628,
      "rawDecodedUtf16Hex": "00480061006900200072006100670069006F006E0065002C0020006100630063006900640065006E00740069002E002000410062006200690061006D006F00200066006100740074006F00200075006E00610020006600690067007500720061000A00620061007200620069006E0061002E002E002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Però ti devo ringraziare.\nHo capito cosa devo fare d’ora in poi!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 3756,
      "rawDecodedUtf16Hex": "00500065007200F20020007400690020006400650076006F002000720069006E006700720061007A0069006100720065002E000A0048006F002000630061007000690074006F00200063006F007300610020006400650076006F00200066006100720065002000642019006F0072006100200069006E00200070006F00690021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "E pure io! La strada per diventare il più forte è\nlunga, ma arriverò prima di lui e del suo Glalie.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 3896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Ma smettila di fare lo spaccone! Figurati se mi\nfaccio sorpassare! La lotta tra me e te continua!<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    }
