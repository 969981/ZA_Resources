      "index": 28,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "C7740020D718D551D31DC740000AB098B8E8B9BCACFC0020C5B4C6B8B8240020C8FCC2E00020B2F5B840C785B2C8B2E4002E001000020114012C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "자, 포커스로 돌아가자.\n손님들이 기다리고 있어.<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1488,
