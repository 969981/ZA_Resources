      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "My mom says Pokémon in wild zones aren’t safe\nto go near...<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 616,
