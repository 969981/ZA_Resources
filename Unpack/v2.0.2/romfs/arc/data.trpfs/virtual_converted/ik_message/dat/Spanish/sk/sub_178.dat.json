  "messages": [
    {
      "displayText": "¡Hablemos del pelaje de Wigglytuff!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 236,
