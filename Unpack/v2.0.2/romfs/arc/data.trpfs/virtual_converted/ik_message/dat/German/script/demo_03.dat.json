  "messages": [
    {
      "displayText": "Willkommen in Illumina City, der Stadt, in der\nMenschen und Pokémon in Einklang leben!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Mein Name ist Jette und ich bin die Präsidentin\nder Quazar Corporation.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "004D00650069006E0020004E0061006D006500200069007300740020004A006500740074006500200075006E00640020006900630068002000620069006E002000640069006500200050007200E40073006900640065006E00740069006E000A0064006500720020005100750061007A0061007200200043006F00720070006F0072006100740069006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Pokémon sind wundersame Lebewesen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "0050006F006B00E9006D006F006E002000730069006E0064002000770075006E00640065007200730061006D00650020004C0065006200650077006500730065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Man kann ihnen an den unterschiedlichsten\nOrten begegnen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 544,
      "rawDecodedUtf16Hex": "004D0061006E0020006B0061006E006E002000690068006E0065006E00200061006E002000640065006E00200075006E007400650072007300630068006900650064006C006900630068007300740065006E000A004F007200740065006E002000620065006700650067006E0065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "In letzter Zeit vermehrt auch inmitten\nunserer Stadt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "0049006E0020006C00650074007A0074006500720020005A0065006900740020007600650072006D00650068007200740020006100750063006800200069006E006D0069007400740065006E000A0075006E00730065007200650072002000530074006100640074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 780,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 792,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Um eine friedliche Koexistenz zu fördern, haben\nwir für sie sogenannte Wildsektoren geschaffen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Die Vielfalt der Pokémon und ihre einzigartigen,\nfantastischen Kräfte bieten großes Potenzial.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Für ein harmonisches Zusammenleben sollten wir\nunsere Kräfte mit denen der Pokémon vereinen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Um das Band zwischen Mensch und Pokémon\nnoch weiter zu vertiefen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "0055006D0020006400610073002000420061006E00640020007A007700690073006300680065006E0020004D0065006E00730063006800200075006E006400200050006F006B00E9006D006F006E000A006E006F0063006800200077006500690074006500720020007A0075002000760065007200740069006500660065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "...arbeitet die Quazar Corporation an der\nUmsetzung eines Stadtentwicklungsplans.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Wir haben hierfür überall in der Stadt die von uns\nentwickelte Hologramm-Technologie installiert.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Diese ermöglicht es, allerlei Informationen über\ndie Stadt zu erhalten.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1872,
      "rawDecodedUtf16Hex": "00440069006500730065002000650072006D00F60067006C0069006300680074002000650073002C00200061006C006C00650072006C0065006900200049006E0066006F0072006D006100740069006F006E0065006E002000FC006200650072000A0064006900650020005300740061006400740020007A007500200065007200680061006C00740065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Auf Illumina City wartet eine strahlende Zukunft!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "00410075006600200049006C006C0075006D0069006E0061002000430069007400790020007700610072007400650074002000650069006E0065002000730074007200610068006C0065006E006400650020005A0075006B0075006E0066007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Etwaige Unannehmlichkeiten durch Bauarbeiten\nbitten wir zu entschuldigen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2116,
      "rawDecodedUtf16Hex": "004500740077006100690067006500200055006E0061006E006E00650068006D006C006900630068006B0065006900740065006E00200064007500720063006800200042006100750061007200620065006900740065006E000A00620069007400740065006E00200077006900720020007A007500200065006E00740073006300680075006C0064006900670065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
