      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "¡Seguro que tendría mucho éxito en Alola!\n¡Creo que me iría muy bien con los perfumes allí!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
