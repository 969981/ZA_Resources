      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¡Qué fría! ¡Eso de que el vaho que exhalan\nlos Vanillite esté a −50 ºC era verdad!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
