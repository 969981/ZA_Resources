  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "실례합니다.\n이 카페는 폐점한 건가요?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "C2E4B840D569B2C8B2E4002E000AC7740020CE74D398B2940020D3D0C810D55C0020AC74AC00C694003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "그런 것 같아요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 536,
      "rawDecodedUtf16Hex": "ADF8B7F00020AC830020AC19C544C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "많은 일이 있었다나 봐요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "B9CEC7400020C77CC7740020C788C5C8B2E4B0980020BD10C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "그렇군요...<U+0010><U+0001>븁\n10년 만에 찾아온 거라\n이곳 커피를 마시고 싶었거든요.<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "ADF8B807AD70C694002E002E002E00100001BE01000A00310030B1440020B9CCC5D00020CC3EC544C6280020AC70B77C000AC774ACF30020CEE4D53CB97C0020B9C8C2DCACE00020C2F6C5C8AC70B4E0C694002E00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "저기... 혹시 이 카페의 관계자 중에서\n아는 분은 없으신가요?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 680,
      "rawDecodedUtf16Hex": "C800AE30002E002E002E0020D639C2DC0020C7740020CE74D398C7580020AD00ACC4C7900020C911C5D0C11C000AC544B2940020BD84C7400020C5C6C73CC2E0AC00C694003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "있어요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "C788C5B4C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "물어봐 드릴까요?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "BB3CC5B4BD100020B4DCB9B4AE4CC694003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "그렇다면 부탁드릴게요!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 788,
      "rawDecodedUtf16Hex": "ADF8B807B2E4BA740020BD80D0C1B4DCB9B4AC8CC694002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "누구에게 연락하겠습니까?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "B204AD6CC5D0AC8C0020C5F0B77DD558ACA0C2B5B2C8AE4C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "그리",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "ADF8B9AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "그리젤",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 860,
      "rawDecodedUtf16Hex": "ADF8B9ACC8240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "무슨 일이시죠?<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "BB34C2A80020C77CC774C2DCC8E0003F00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "그렇군요.<U+0010><U+0001>븁\n그런 일이라면 누보 카페 3호점의\n점장님과 이야기해 보시면 될 겁니다.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "ADF8B807AD70C694002E00100001BE01000AADF8B7F00020C77CC774B77CBA740020B204BCF40020CE74D39800200033D638C810C758000AC810C7A5B2D8ACFC0020C774C57CAE30D5740020BCF4C2DCBA740020B4200020AC81B2C8B2E4002E00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "플라드리 카페의 마스터 밑에서\n일하셨던 분이거든요.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1004,
      "rawDecodedUtf16Hex": "D50CB77CB4DCB9AC0020CE74D398C7580020B9C8C2A4D1300020BC11C5D0C11C000AC77CD558C168B3580020BD84C774AC70B4E0C694002E00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "주문하려고?<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "C8FCBB38D558B824ACE0003F00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "뭐야, 사람을 찾는 거였구나.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1096,
      "rawDecodedUtf16Hex": "BB50C57C002C0020C0ACB78CC7440020CC3EB2940020AC70C600AD6CB098002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "플라드리 카페의 마스터?\n그 사람이라면 3호점 점장이 알 거야.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1140,
      "rawDecodedUtf16Hex": "D50CB77CB4DCB9AC0020CE74D398C7580020B9C8C2A4D130003F000AADF80020C0ACB78CC774B77CBA7400200033D638C8100020C810C7A5C7740020C54C0020AC70C57C002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "전에 마스터 밑에서\n일했다는 것 같더라고.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1220,
      "rawDecodedUtf16Hex": "C804C5D00020B9C8C2A4D1300020BC11C5D0C11C000AC77CD588B2E4B2940020AC830020AC19B354B77CACE0002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "누보 카페 3호점에 가 보면\n마스터에 대한 단서를 찾을 수 있겠군요!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "B204BCF40020CE74D39800200033D638C810C5D00020AC000020BCF4BA74000AB9C8C2A4D130C5D00020B300D55C0020B2E8C11CB97C0020CC3EC7440020C2180020C788ACA0AD70C694002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "3호점은 분명히...\n<U+0010><U+0002>＀<U+0006>로즈 지구<U+0010><U+0002>＀<U+0000>에 있었죠?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "0033D638C810C7400020BD84BA85D788002E002E002E000A00100002FF000006B85CC9880020C9C0AD6C00100002FF000000C5D00020C788C5C8C8E0003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "그럼, 누보 카페 3호점에서\n뵙도록 하죠!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "ADF8B7FC002C0020B204BCF40020CE74D39800200033D638C810C5D0C11C000ABD59B3C4B85D0020D558C8E0002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1492,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> 씨,\n기다리고 있었어요!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "00100002010000000020C528002C000AAE30B2E4B9ACACE00020C788C5C8C5B4C694002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "그럼, 플라드리 카페의 마스터에 대해\n물어보러 가 보시죠.<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "ADF8B7FC002C0020D50CB77CB4DCB9AC0020CE74D398C7580020B9C8C2A4D130C5D00020B300D574000ABB3CC5B4BCF4B7EC0020AC000020BCF4C2DCC8E0002E00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "주문...하러 오신 건 아닌 모양이네요.\n무슨 일이시죠?<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "C8FCBB38002E002E002ED558B7EC0020C624C2E00020AC740020C544B2CC0020BAA8C591C774B124C694002E000ABB34C2A80020C77CC774C2DCC8E0003F00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "그렇군요.\n이야기는 잘 들었습니다.<U+0010><U+0001>븁\n플라드리 카페의 마스터는\n저의 커피 스승님이세요.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1700,
      "rawDecodedUtf16Hex": "ADF8B807AD70C694002E000AC774C57CAE30B2940020C7980020B4E4C5C8C2B5B2C8B2E4002E00100001BE01000AD50CB77CB4DCB9AC0020CE74D398C7580020B9C8C2A4D130B294000AC800C7580020CEE4D53C0020C2A4C2B9B2D8C774C138C694002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "손님 이야기를 전해 드리면\n마스터도 분명 기뻐하실 거예요.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "C190B2D80020C774C57CAE30B97C0020C804D5740020B4DCB9ACBA74000AB9C8C2A4D130B3C40020BD84BA850020AE30BED0D558C2E40020AC70C608C694002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "제 쪽에서 마스터에게 연락을 드릴 테니\n플라드리 카페 앞에서 기다려 주세요.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1888,
      "rawDecodedUtf16Hex": "C81C0020CABDC5D0C11C0020B9C8C2A4D130C5D0AC8C0020C5F0B77DC7440020B4DCB9B40020D14CB2C8000AD50CB77CB4DCB9AC0020CE74D3980020C55EC5D0C11C0020AE30B2E4B8240020C8FCC138C694002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "플라드리 카페 앞에 먼저 가서\n기다리고 있을게요!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "D50CB77CB4DCB9AC0020CE74D3980020C55EC5D00020BA3CC8000020AC00C11C000AAE30B2E4B9ACACE00020C788C744AC8CC694002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "마스터에게 연락을 드릴 테니\n플라드리 카페에서 기다려 주세요.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "B9C8C2A4D130C5D0AC8C0020C5F0B77DC7440020B4DCB9B40020D14CB2C8000AD50CB77CB4DCB9AC0020CE74D398C5D0C11C0020AE30B2E4B8240020C8FCC138C694002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2128,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "마스터를 다시 만날 수 있다니...\n조금 긴장되기 시작했어요.<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2140,
      "rawDecodedUtf16Hex": "B9C8C2A4D130B97C0020B2E4C2DC0020B9CCB0A00020C2180020C788B2E4B2C8002E002E002E000AC870AE080020AE34C7A5B418AE300020C2DCC791D588C5B4C694002E00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "기다려 주셔서 감사해요!<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC154C11C0020AC10C0ACD574C694002100100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "이분이 마스터이신\n매트 스승님이세요.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2256,
      "rawDecodedUtf16Hex": "C774BD84C7740020B9C8C2A4D130C774C2E0000AB9E4D2B80020C2A4C2B9B2D8C774C138C694002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "지금은 아니지만 말입니다.<U+0010><U+0001>븁\n10년이 지나서도 제가 만든 커피를\n그리워해 주시다니, 영광스러울 따름입니다.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "C9C0AE08C7400020C544B2C8C9C0B9CC0020B9D0C785B2C8B2E4002E00100001BE01000A00310030B144C7740020C9C0B098C11CB3C40020C81CAC000020B9CCB4E00020CEE4D53CB97C000AADF8B9ACC6CCD5740020C8FCC2DCB2E4B2C8002C0020C601AD11C2A4B7ECC6B80020B530B984C785B2C8B2E4002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "그런데 한 가지 문제가 있단 말이죠...<U+0010><U+0001>븁\n포켓몬의 기술로 로스팅을 해 왔는데\n아무래도 공백기가 있다 보니...<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "ADF8B7F0B3700020D55C0020AC00C9C00020BB38C81CAC000020C788B2E80020B9D0C774C8E0002E002E002E00100001BE01000AD3ECCF13BAACC7580020AE30C220B85C0020B85CC2A4D305C7440020D5740020C654B294B370000AC544BB34B798B3C40020ACF5BC31AE30AC000020C788B2E40020BCF4B2C8002E002E002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "그래서 부탁드리겠습니다.<U+0010><U+0001>븁\n감을 찾을 수 있게\n저와 포켓몬 승부를 해 주시죠.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 2580,
      "rawDecodedUtf16Hex": "ADF8B798C11C0020BD80D0C1B4DCB9ACACA0C2B5B2C8B2E4002E00100001BE01000AAC10C7440020CC3EC7440020C2180020C788AC8C000AC800C6400020D3ECCF13BAAC0020C2B9BD80B97C0020D5740020C8FCC2DCC8E0002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "마스터, 저도 함께 싸우겠어요!<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2680,
      "rawDecodedUtf16Hex": "B9C8C2A4D130002C0020C800B3C40020D568AED80020C2F8C6B0ACA0C5B4C694002100100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
