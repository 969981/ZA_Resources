      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "I got a break, so I came to collect my Slurpuff!<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2868,
      "rawDecodedUtf16Hex": "004900200067006F00740020006100200062007200650061006B002C00200073006F00200049002000630061006D006500200074006F00200063006F006C006C0065006300740020006D007900200053006C0075007200700075006600660021001000020114012C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "And is my grumpy li’l marshmallow feeling all\nbetter now?<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2976,
