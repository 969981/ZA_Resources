      "rawDecodedUtf16Hex": "0053006C0075007500750072007000210020266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "I guess it’s tasty, huh?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "004900200067007500650073007300200069007420190073002000740061007300740079002C0020006800750068003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "This is your usual?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2276,
      "rawDecodedUtf16Hex": "005400680069007300200069007300200079006F0075007200200075007300750061006C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Puff.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "0050007500660066002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "And for you, a Soleil Blend.",
      "escapedControlUnits": 0,
