      "rawDecodedUtf16Hex": "0041006E006400200066006F007200200079006F0075002C0020006100200053006F006C00650069006C00200042006C0065006E0064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "What? But why?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2388,
      "rawDecodedUtf16Hex": "0057006800610074003F00200042007500740020007700680079003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "But I didn’t order...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2420,
      "rawDecodedUtf16Hex": "004200750074002000490020006400690064006E201900740020006F0072006400650072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "A free coffee is the least I can offer to anyone\nwho’s kind enough to keep an eye on Slurpuff.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Puff puff!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "00500075006600660020007000750066006600210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Still feeling grumpy?",
