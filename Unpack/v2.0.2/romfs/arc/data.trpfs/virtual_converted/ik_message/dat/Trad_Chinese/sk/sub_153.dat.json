      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 924,
      "rawDecodedUtf16Hex": "73FE572890844E0D89810000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "啣啣～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 936,
      "rawDecodedUtf16Hex": "55635563FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
