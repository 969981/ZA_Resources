  "initialKey": 0,
  "messages": [
    {
      "displayText": "榴紅區的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "69B47D05534076845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "單品風格休閒且價格親民的\n店鋪聚集於此。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "55AE54C198A8683C4F1195924E1450F9683C89AA6C117684000A5E9792EA805A96C665BC6B6430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "許多不隨流行起舞，\n擁有獨特價值觀的店鋪\n聚集於此。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "8A31591A4E0D96A86D41884C8D77821EFF0C000A64C167097368727950F9503C89C076845E9792EA000A805A96C665BC6B6430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "來歷不凡的廊街。\n林立於此的老字號店鋪\n販售豪華且高級的商品。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "4F866B774E0D51E176845ECA88573002000A67977ACB65BC6B64768480015B57865F5E9792EA000A8CA9552E8C6A83EF4E149AD87D1A7684554654C130020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "歷史悠久的廊街。\n聚集於此的店鋪販售許多\n風格休閒且價格親民的單品。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "6B7753F260A04E4576845ECA88573002000A805A96C665BC6B6476845E9792EA8CA9552E8A31591A000A98A8683C4F1195924E1450F9683C89AA6C11768455AE54C130020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "大道上分布了許多來歷正統的店鋪，\n個性十足的單品應有盡有。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "592790534E0A52065E034E868A31591A4F866B776B637D7176845E9792EAFF0C000A500B602753418DB3768455AE54C161C9670976E1670930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "屬於最大規模的美術館。\n一部分的收藏品也會出借給\n各個地區的美術館。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "5C6C65BC67005927898F6A2176847F8E885399283002000A4E0090E852067684653685CF54C14E5F670351FA501F7D66000A5404500B5730534076847F8E8853992830020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "翡綠區的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1472,
      "rawDecodedUtf16Hex": "7FE17DA0534076845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "座落於翡綠區的旅館。\n或許是因為在巷子裡，\n幾乎沒有客人。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "5EA7843D65BC7FE17DA05340768465C599283002000A62168A31662F56E070BA57285DF75B5088E1FF0C000A5E7E4E4E6C9267095BA24EBA30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "寶可夢研究所。\n完成來自代理所長委託的調查內容，\n就能獲得豐富的報酬。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "5BF653EF592278147A7662403002000A5B8C62104F8681EA4EE374066240957759D48A1776848ABF67E551675BB9FF0C000A5C3180FD73725F978C505BCC76845831916C30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "位於卡洛斯地區中心\n密阿雷市的一座塔。\n高度約有３００公尺。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "4F4D65BC53616D1B65AF573053404E2D5FC3000A5BC6963F96F75E0276844E005EA758543002000A9AD85EA67D046709FF13FF10FF10516C5C3A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "位於卡洛斯地區中心\n密阿雷市的一座塔。\n內部曾經有兩千年前的裝置。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "4F4D65BC53616D1B65AF573053404E2D5FC3000A5BC6963F96F75E0276844E005EA758543002000A516790E866FE7D936709516953435E74524D768488DD7F6E30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "由瑪琪艾兒擔任第二任所長的\n偵探事務所。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "7531746A742A827E515264D44EFB7B2C4E8C4EFB624095777684000A507563A24E8B52D9624030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "推動密阿雷都市開發的外商公司，\n闊星公司的大樓。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "63A852D55BC6963F96F790FD5E02958B767C768459165546516C53F8FF0C000A95CA661F516C53F8768459276A1330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "社區型建築工程公司。\n此公司在城市的各地配置了彩色螺絲，\n收集起來就能用來和他們交換東西。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1908,
      "rawDecodedUtf16Hex": "793E5340578B5EFA7BC95DE57A0B516C53F83002000A6B64516C53F8572857CE5E02768454045730914D7F6E4E865F69827287BA7D72FF0C000A653696C68D774F865C3180FD75284F86548C4ED650114EA463DB6771897F30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "座落於翡綠區的廣場。\n因其為數眾多的池塘，\n水屬性的寶可夢會聚集於此。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2000,
      "rawDecodedUtf16Hex": "5EA7843D65BC7FE17DA0534076845EE358343002000A56E0517670BA6578773E591A76846C605858FF0C000A6C345C6C602776845BF653EF59226703805A96C665BC6B6430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "作為都市開發計畫的一環\n而建造的車站。連接機場與\n密阿雷市的列車會停靠於此。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2072,
      "rawDecodedUtf16Hex": "4F5C70BA90FD5E02958B767C8A08756B76844E0074B0000A800C5EFA902076848ECA7AD93002902363A56A5F58348207000A5BC6963F96F75E02768452178ECA6703505C976065BC6B6430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "以古代的圓形劇場為基礎，\n打造呈現了與水的協調的廣場。\n能感受到井然有序之美。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "4EE553E44EE3768457135F625287583470BA57FA790EFF0C000A62539020544873FE4E8682076C34768453548ABF76845EE358343002000A80FD611F53D752304E95713667095E8F4E4B7F8E30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "以獨到的見解建造而成的建築物，\n充滿了異國風情。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2232,
      "rawDecodedUtf16Hex": "4EE5736852307684898B89E35EFA9020800C621076845EFA7BC97269FF0C000A51456EFF4E867570570B98A860C530020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "浦藍區的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "6D6685CD534076845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "春日大道的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2360,
      "rawDecodedUtf16Hex": "662565E55927905376845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "廣場中央的方尖碑十分醒目，\n但特徵為充滿開放感的空間。\n作為廣場的歷史相當悠久。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2436,
      "rawDecodedUtf16Hex": "5EE358344E2D592E768465B95C16789153415206919276EEFF0C000A4F4672795FB570BA51456EFF958B653E611F76847A7A95933002000A4F5C70BA5EE3583476846B7753F276F8757660A04E4530020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "因為曾和某個組織有所關聯，\n至今仍找不到買家的咖啡店。\n因其外觀與裝潢獨特的顏色而出名。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "56E070BA66FE548C67D0500B7D447E546709624095DC806FFF0C000A81F34ECA4ECD627E4E0D52308CB75BB67684549655615E973002000A56E05176591689C0820788DD6F62736872797684984F8272800C51FA540D30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "蓉粉區的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2612,
      "rawDecodedUtf16Hex": "84C97C89534076845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "粉色廣場附近的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2688,
      "rawDecodedUtf16Hex": "7C8982725EE3583496448FD176845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "以使用柵欄劃分開來的\n各區的草地藝術為特徵的廣場。\n也能享受從小小的塔望出去的景色。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2768,
      "rawDecodedUtf16Hex": "4EE54F7F752867F56B0452835206958B4F867684000A5404534076848349573085DD885370BA72795FB576845EE358343002000A4E5F80FD4EAB53D75F9E5C0F5C0F76845854671B51FA53BB7684666F827230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "正式名稱為秀麗世大酒店。\n是位於北側大道的高級旅館。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2856,
      "rawDecodedUtf16Hex": "6B635F0F540D7A3170BA79C09E974E16592791525E973002000A662F4F4D65BC531750745927905376849AD87D1A65C5992830020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "榴紅區的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2912,
      "rawDecodedUtf16Hex": "69B47D05534076845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "稜鏡塔附近的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 2988,
      "rawDecodedUtf16Hex": "7A1C93E1585496448FD176845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "有些攤位且帶有小市集般的氣氛，\n是貼近一般民眾且無須拘謹的廣場。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3068,
      "rawDecodedUtf16Hex": "67094E9B65244F4D4E145E3667095C0F5E0296C6822C76846C236C1BFF0C000A662F8CBC8FD14E00822C6C11773E4E147121980862D88B3976845EE3583430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "不知何時開始在\n瓊黃區的一角開設的道場。\n對培育寶可夢有一套見解。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3136,
      "rawDecodedUtf16Hex": "4E0D77E54F556642958B59CB5728000A74CA9EC3534076844E0089D2958B8A2D7684905358343002000A5C0D57F980B25BF653EF592267094E005957898B89E330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "瓊黃區的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3204,
      "rawDecodedUtf16Hex": "74CA9EC3534076845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "冬日大道的寶可夢中心。\n在這裡可以回復和治療寶可夢，\n或是購買和出售道具。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3280,
      "rawDecodedUtf16Hex": "51AC65E55927905376845BF653EF59224E2D5FC33002000A5728901988E153EF4EE556DE5FA9548C6CBB76425BF653EF5922FF0C000A6216662F8CFC8CB7548C51FA552E9053517730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "可以更改髮色或髮型。\n修整眉毛為免費服務。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3356,
      "rawDecodedUtf16Hex": "53EF4EE566F465399AEE827262169AEE578B3002000A4FEE657477096BDB70BA514D8CBB670D52D930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "販售能讓特定寶可夢\n進化的石頭和超級石。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "8CA9552E80FD8B9372795B9A5BF653EF5922000A90325316768477F3982D548C8D857D1A77F330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "販售各式各樣的精靈球。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3444,
      "rawDecodedUtf16Hex": "8CA9552E54045F0F54046A2376847CBE9748740330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "販售頭飾、腰包\n和耳飾等商品的店鋪。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3468,
      "rawDecodedUtf16Hex": "8CA9552E982D98FE300181705305000A548C803398FE7B49554654C176845E9792EA30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "穿戴上身的服飾品\n幾乎應有盡有的高級店。\n需要符合條件才能入內。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 3508,
      "rawDecodedUtf16Hex": "7A7F62344E0A8EAB7684670D98FE54C1000A5E7E4E4E61C9670976E1670976849AD87D1A5E973002000A970089817B265408689D4EF6624D80FD5165516730020000",
      "trailingZeroPaddingUnits": 1,
