      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "吃剩的东西，吃剩的东西。\n非常有用的好东西♪<U+0010><U+0002>Ĕŋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
