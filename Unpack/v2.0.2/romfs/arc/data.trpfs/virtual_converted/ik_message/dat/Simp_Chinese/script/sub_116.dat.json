      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "没错！我想看冰宝站在\n大～大的冰岩怪上的样子。<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
