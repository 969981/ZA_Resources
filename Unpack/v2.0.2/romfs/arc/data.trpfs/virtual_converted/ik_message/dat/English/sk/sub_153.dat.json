      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Anyway, I’m relieved to have at least solved the\nmystery of why that drink was so salty. Thanks!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
