      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "So you really think your Pikachu is the strongest\nthere is?<U+0010><U+0001>븁\nLet’s put that to the test!<U+0010><U+0002>Ĕũ",
      "escapedControlUnits": 4,
