      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Whoa! That was something else! You beat that\nthing in <U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>.<U+0010><U+0002>ȁ<U+0005>.",
