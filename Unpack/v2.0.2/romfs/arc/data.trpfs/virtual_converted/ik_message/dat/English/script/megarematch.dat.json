      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Your record time for defeating <U+0010><U+0002>ā<U+0002> is\n<U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>.<U+0010><U+0002>ȁ<U+0005>.<U+0010><U+0001>븀\nReady<U+0010><U+0001>븀\nfor<U+0010><U+0001>븀\nanother<U+0010><U+0001>븀\nround?<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 26,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Yeah!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1496,
      "rawDecodedUtf16Hex": "005900650061006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Actually, no",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 1508,
      "rawDecodedUtf16Hex": "00410063007400750061006C006C0079002C0020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Superbly done! Your time was <U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>.<U+0010><U+0002>ȁ<U+0005>.<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "005300750070006500720062006C007900200064006F006E0065002100200059006F00750072002000740069006D0065002000770061007300200010000202010003003A0010000202010004002E0010000202010005002E001000020114000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "And you’ve managed to set a new personal record!\nTruly impressive work.<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Please accept this reward. You’ve earned it.<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1788,
      "rawDecodedUtf16Hex": "0050006C00650061007300650020006100630063006500700074002000740068006900730020007200650077006100720064002E00200059006F00752019007600650020006500610072006E00650064002000690074002E001000020114000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Simulations at least spare you the usual grievous\nbodily harm of losing.<U+0010><U+0001>븁\nYou need merely shake off the emotional blow.<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 5,
