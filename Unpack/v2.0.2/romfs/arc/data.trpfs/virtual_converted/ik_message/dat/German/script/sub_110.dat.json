    },
    {
      "displayText": "Hey, du da! Vergreif dich bloß nicht an unserem\nSchlamm!<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
