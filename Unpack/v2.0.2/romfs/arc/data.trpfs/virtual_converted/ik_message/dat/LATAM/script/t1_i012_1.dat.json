      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2168,
      "rawDecodedUtf16Hex": "004D006500200065006E00630061006E00740061007200ED006100200068006100630065007200200075006E00200074006F00750072000A00670061007300740072006F006E00F3006D00690063006F00200070006F00720020006C00610020006300690075006400610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Yo quiero aprovechar la visita\npara atrapar un nuevo Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2280,
      "rawDecodedUtf16Hex": "0059006F002000710075006900650072006F0020006100700072006F0076006500630068006100720020006C00610020007600690073006900740061000A00700061007200610020006100740072006100700061007200200075006E0020006E007500650076006F00200050006F006B00E9006D006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
