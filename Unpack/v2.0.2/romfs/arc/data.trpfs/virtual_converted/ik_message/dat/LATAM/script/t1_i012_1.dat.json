      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "004200690065006E00760065006E0069006400100003110000FF0101006F006100200061006C000A004700720061006E00200048006F00740065006C00200052006900630061006300680069006C0074006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
