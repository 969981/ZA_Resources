  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Meister Gavin ist gerade nicht da.<U+0010><U+0001>븁\nAber wenn du schon mal hier bist, möchte ich die\nGelegenheit nutzen...<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Tut mir leid, dass ich dich damit so überfalle,\naber bitte kämpfe gegen mich, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Während Meister Gavins Abwesenheit möchte\nich ein bisschen über meine Kampffähigkeiten<U+0010><U+0001>븀\nreflektieren.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "Bitte sag Bescheid, wenn du bereit für ein\nKräftemessen bist!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "004200690074007400650020007300610067002000420065007300630068006500690064002C002000770065006E006E00200064007500200062006500720065006900740020006600FC0072002000650069006E000A004B007200E4006600740065006D0065007300730065006E00200062006900730074002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bist du bereit für unser Kräftemessen?\nOder geht es um Boost-Attacken?<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Ich will kämpfen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "004900630068002000770069006C006C0020006B00E4006D007000660065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Es geht um Boost-Attacken...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "004500730020006700650068007400200075006D00200042006F006F00730074002D00410074007400610063006B0065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Ich hab’s mir anders überlegt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "0049006300680020006800610062201900730020006D0069007200200061006E0064006500720073002000FC006200650072006C006500670074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Ich schätze, du hast anderes zu tun...<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "004900630068002000730063006800E40074007A0065002C0020006400750020006800610073007400200061006E006400650072006500730020007A0075002000740075006E002E002E002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Es ist mir eine Ehre, gegen jemanden anzutreten,\nder Rang A beim Z-A Royale erreicht hat!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Bist du bereit für unser Kräftemessen?<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1712,
      "rawDecodedUtf16Hex": "004200690073007400200064007500200062006500720065006900740020006600FC007200200075006E0073006500720020004B007200E4006600740065006D0065007300730065006E003F00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1800,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du bist des Titels <U+0010><U+0004>ᄀÿ᜖<U+0000>des stärksten Trainersder stärksten Trainerin in\nIllumina zweifelsohne würdig, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Ich hingegen...<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "004900630068002000680069006E0067006500670065006E002E002E002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Ich bin kein bisschen stärker geworden...<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "004900630068002000620069006E0020006B00650069006E00200062006900730073006300680065006E00200073007400E40072006B006500720020006700650077006F007200640065006E002E002E002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Ich schade nicht nur dem Ansehen der Faust der\nGerechten, sondern auch dem von Meister Gavin.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Braucht die Faust der Gerechten jemanden wie\nmich überhaupt?<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2368,
      "rawDecodedUtf16Hex": "004200720061007500630068007400200064006900650020004600610075007300740020006400650072002000470065007200650063006800740065006E0020006A0065006D0061006E00640065006E0020007700690065000A006D006900630068002000FC00620065007200680061007500700074003F00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Grooooo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2500,
      "rawDecodedUtf16Hex": "00470072006F006F006F006F006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Pandaaa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "00500061006E006400610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Die Aggro-Pandagro! Nicht schon wieder!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2540,
      "rawDecodedUtf16Hex": "00440069006500200041006700670072006F002D00500061006E0064006100670072006F00210020004E00690063006800740020007300630068006F006E0020007700690065006400650072002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Dieses Duo ignoriert dreist die Wildsektoren\nund stiftet überall Chaos!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Die sind echt gefährlich.<U+0010><U+0001>븁\nSelbst Meister Gavin schafft es nur mit Mühe\nund Not, sie zu vertreiben.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2780,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Aber er ist nicht hier... Deswegen ist es meine\nPflicht, das Dojo zu beschützen!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Bitte kämpfe an meiner Seite, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3164,
      "rawDecodedUtf16Hex": "004200690074007400650020006B00E4006D00700066006500200061006E0020006D00650069006E00650072002000530065006900740065002C00200010000201000000002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3244,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Toll gemacht, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3256,
      "rawDecodedUtf16Hex": "0054006F006C006C002000670065006D0061006300680074002C00200010000201000000002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Agro?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3304,
      "rawDecodedUtf16Hex": "004100670072006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Der Ausgang ist da drüben, ihr beiden.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3316,
      "rawDecodedUtf16Hex": "004400650072002000410075007300670061006E0067002000690073007400200064006100200064007200FC00620065006E002C0020006900680072002000620065006900640065006E002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Meister Gavin!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3404,
      "rawDecodedUtf16Hex": "004D00650069007300740065007200200047006100760069006E002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>Ā<U+0000>, Cosette. Habt ihr die beiden\nPandagro<U+0010><U+0001>븀\neben<U+0010><U+0001>븀\nvertrieben?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ja! Mithilfe von <U+0010><U+0002>Ā<U+0000> konnte ich den\nÜberfall<U+0010><U+0001>븀\nauf<U+0010><U+0001>븀\ndas<U+0010><U+0001>븀\nDojo<U+0010><U+0001>븀\nabwehren.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "<U+0010><U+0004>ᄀÿည<U+0000>Vom RetterVon der Retterin Illuminas hätte ich auch nichts\nanderes erwartet.<U+0010><U+0001>븁\nJetzt habe ich <U+0010><U+0004>ᄀÿЅ<U+0000>seineihre wahre Stärke selbst erlebt.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "Im Vergleich zu <U+0010><U+0004>ᄀÿ̃<U+0000>ihmihr bin ich...<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4076,
      "rawDecodedUtf16Hex": "0049006D00200056006500720067006C00650069006300680020007A0075002000100004110000FF0303000000690068006D006900680072002000620069006E0020006900630068002E002E002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Cosette.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4164,
      "rawDecodedUtf16Hex": "0043006F00730065007400740065002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Ja?<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4192,
      "rawDecodedUtf16Hex": "004A0061003F00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ohne entsprechende Fertigkeiten hättest du gar\nnicht erst an der Seite von <U+0010><U+0002>Ā<U+0000><U+0010><U+0001>븀\nkämpfen<U+0010><U+0001>븀\nkönnen.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Und weißt du, was es mir überhaupt ermöglicht\nhat, außer Haus zu sein?<U+0010><U+0001>븁\nDie Gewissheit, dass du das Dojo während\nmeiner Abwesenheit beschützen würdest.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4428,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 158
    },
    {
      "displayText": "Dass du dich so mit Stärkeren vergleichst,\nzeigt nur, dass du ein gutes Bewusstsein für<U+0010><U+0001>븀\ndein eigenes Können hast.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Du wirst noch viel stärker werden, Cosette.<U+0010><U+0001>븁\nDas nächste Mal brauche ICH deine Hilfe,\num die Pandagro zu vertreiben.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Jawohl!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5236,
      "rawDecodedUtf16Hex": "004A00610077006F0068006C002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Vielen Dank für deine Hilfe heute!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5260,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B0020006600FC00720020006400650069006E0065002000480069006C00660065002000680065007500740065002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    }
