      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Si quieres debilitarlo o atraparlo, eso ya es cosa\ntuya, pero a mí que me deje comer tranquilo.<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
