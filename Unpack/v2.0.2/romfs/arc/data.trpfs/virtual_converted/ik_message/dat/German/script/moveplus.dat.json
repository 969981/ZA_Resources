      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1888,
      "rawDecodedUtf16Hex": "00570065006C006300680065007300200050006F006B00E9006D006F006E00200073006F006C006C002000650069006E0065002000410074007400610063006B006500200061006C0073000A0042006F006F00730074002D00410074007400610063006B00650020006D006500690073007400650072006E003F00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Tut mir leid, aber <U+0010><U+0002>ā<U+0002> beherrscht\nkeine<U+0010><U+0001>븀\nAttacke,<U+0010><U+0001>븀\ndie<U+0010><U+0001>븀\nes<U+0010><U+0001>븀\nals<U+0010><U+0001>븀\nBoost-Attacke<U+0010><U+0001>븀\nmeistern<U+0010><U+0001>븀\nkönnte...<U+0010><U+0002>Ĕ3",
