      "offsetInSection": 1664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Welches Pokémon soll eine Attacke als\nBoost-Attacke meistern?<U+0010><U+0002>Ĕ3",
