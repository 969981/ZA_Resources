      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "I’ve been waiting for it to go somewhere else, but\nit hasn’t budged one bit...<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
