      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 8904,
      "rawDecodedUtf16Hex": "004E006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
