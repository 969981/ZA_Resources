      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "...에 목숨을 건 사나이,\n정보통 정보!<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
