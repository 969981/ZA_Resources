      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "좋습니다.\n그럼, 풀의 시련을 시작해 보죠!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
