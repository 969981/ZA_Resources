      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "D480C7580020C2DCB8280000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
