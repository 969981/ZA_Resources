      "index": 27,
      "offsetInSection": 1700,
      "rawDecodedUtf16Hex": "6676FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "這裡？<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
