      "rawDecodedUtf16Hex": "00BF005400FA002000740061006D0062006900E9006E0020007100750065007200ED006100730020007500730061007200200065006C00200048006F006C006F007400720061006E00730070006F0072007400610064006F0072000A00700061007200610020006900720020006100720072006900620061003F00100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "¡¿No te parece que explorar los techos es genial?!\n¡Me encanta poder pasar de un edificio a otro!<U+0010><U+0002>Ĕŗ",
