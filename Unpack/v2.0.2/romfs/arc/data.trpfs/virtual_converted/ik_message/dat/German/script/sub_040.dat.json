  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 236,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Es will einfach nicht regnen...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "00450073002000770069006C006C002000650069006E00660061006300680020006E00690063006800740020007200650067006E0065006E002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Plitsch, platsch! Plitsch, platsch! Das ist das\nperfekte Wetter für mich!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Hast du bei Pokémon-Kämpfen schon mal auf\ndas Wetter geachtet?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 476,
      "rawDecodedUtf16Hex": "0048006100730074002000640075002000620065006900200050006F006B00E9006D006F006E002D004B00E4006D007000660065006E0020007300630068006F006E0020006D0061006C0020006100750066000A0064006100730020005700650074007400650072002000670065006100630068007400650074003F00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Meine Pokémon werden bei Regen stärker!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "004D00650069006E006500200050006F006B00E9006D006F006E002000770065007200640065006E002000620065006900200052006500670065006E00200073007400E40072006B00650072002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Lass uns kämpfen, wenn es regnet. Dann zeig\nich dir, wie stark mein Team sein kann!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Lass uns schnell kämpfen, bevor der Regen\naufhört! Jetzt kann ich dir zeigen, wie stark mein<U+0010><U+0001>븀\nTeam wirklich ist!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Mach dich bereit für einen Kampf! Wir sind\nschließlich nicht aus Zucker!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich würde dir gerne zeigen, wie stark mein Team\nist, also komm wieder, wenn es regnet.<U+0010><U+0001>븁\nOh, willst du etwa hier warten, bis es so weit ist?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 146
    },
    {
      "displayText": "Ich warte!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1576,
      "rawDecodedUtf16Hex": "004900630068002000770061007200740065002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Nö, ich muss los.<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "004E00F6002C00200069006300680020006D0075007300730020006C006F0073002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Es regnet! Lass uns kämpfen! Ich zeig dir,\nwas meine Pokémon draufhaben!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Lass sehen!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1808,
      "rawDecodedUtf16Hex": "004C00610073007300200073006500680065006E002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Ich will nicht nass werden...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1840,
      "rawDecodedUtf16Hex": "004900630068002000770069006C006C0020006E00690063006800740020006E006100730073002000770065007200640065006E002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Verstehe...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1908,
      "rawDecodedUtf16Hex": "00560065007200730074006500680065002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Was?! Aber der Regen könnte jederzeit aufhören!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1940,
      "rawDecodedUtf16Hex": "005700610073003F002100200041006200650072002000640065007200200052006500670065006E0020006B00F6006E006E007400650020006A0065006400650072007A0065006900740020006100750066006800F600720065006E002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Was? Du willst so dringend gegen mich kämpfen?\nNa, dann warten wir mal auf Regen...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Es regnet! Endlich!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "004500730020007200650067006E00650074002100200045006E0064006C006900630068002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Die Attacken meines Teams werden im Regen\nsuperstark! Du wirst schon sehen, was für eine<U+0010><U+0001>븀\nSpitzenkombi Wasser-Pokémon und Regen sind!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Gegen dich hatten meine Wasser-Pokémon auch\nbei Regen keine Chance...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2560,
      "rawDecodedUtf16Hex": "0047006500670065006E00200064006900630068002000680061007400740065006E0020006D00650069006E00650020005700610073007300650072002D0050006F006B00E9006D006F006E00200061007500630068000A00620065006900200052006500670065006E0020006B00650069006E00650020004300680061006E00630065002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Du hast gesehen, dass all meine Pokémon\nWasser-Attacken beherrschen, oder?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Wasser-Attacken werden bei Regen stärker, daher\nwar ich sicher, dass ich dich besiegen kann...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Na ja...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3068,
      "rawDecodedUtf16Hex": "004E00610020006A0061002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Feuer-Attacken werden bei Regen jedenfalls\nschwächer.<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3096,
      "rawDecodedUtf16Hex": "00460065007500650072002D00410074007400610063006B0065006E002000770065007200640065006E002000620065006900200052006500670065006E0020006A006500640065006E00660061006C006C0073000A007300630068007700E40063006800650072002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Schließlich wird im Regen alles klitschnass, und\nwas nass ist, brennt auch schlechter. Alles logo?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3420,
      "rawDecodedUtf16Hex": "00100002BDFF001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Regen verstärkt Attacken vom Typ Wasser!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "0052006500670065006E00200076006500720073007400E40072006B0074002000410074007400610063006B0065006E00200076006F006D00200054007900700020005700610073007300650072002100100002011401490000",
