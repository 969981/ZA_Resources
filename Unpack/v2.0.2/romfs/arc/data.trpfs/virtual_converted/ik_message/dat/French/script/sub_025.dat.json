  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Faut que je te le répète combien de fois ?\nY a pas plus fort que mon Arbok !<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "N’importe quoi ! En plus, le motif sur son corps\nest claqué au sol. Oniglali fait 100 fois plus peur !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "... Qu’est-ce que t’as, toi ? Tu veux ma photo ?<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "002E002E002E0020005100752019006500730074002D00630065002000710075006500200074201900610073002C00200074006F00690020003F002000540075002000760065007500780020006D0061002000700068006F0074006F0020003F001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Attends, t’sais quoi ?\nPuisque t’es là, tu vas nous aider !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "0041007400740065006E00640073002C0020007420190073006100690073002000710075006F00690020003F000A0050007500690073007100750065002000742019006500730020006C00E0002C00200074007500200076006100730020006E006F0075007300200061006900640065007200200021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Ah, pas bête. Bon, voilà c’qui va s’passer :\ntu vas te battre contre nous.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Pour commencer, un de tes Pokémon va affronter\nmon Arbok.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "0050006F0075007200200063006F006D006D0065006E006300650072002C00200075006E002000640065002000740065007300200050006F006B00E9006D006F006E00200076006100200061006600660072006F006E007400650072000A006D006F006E0020004100720062006F006B002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Et ensuite, tu te battras contre son Oniglali,\ntoujours avec un seul Pokémon.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Comme ça, tu pourras nous aider à déterminer\nqui a le meilleur Pokémon !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1556,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tu vas d’abord te battre contre mon Arbok.\nT’es prêt<U+0010><U+0003>ᄀÿĀe pour un combat à un contre un ?<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Oui, et je vais gagner !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1760,
      "rawDecodedUtf16Hex": "004F00750069002C0020006500740020006A0065002000760061006900730020006700610067006E00650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Non, pas encore.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "004E006F006E002C002000700061007300200065006E0063006F00720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Ben, magne-toi ! Choisis un Pokémon\nque t’aimes bien, et on en parle plus.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "T’essaies de m’arnaquer ou quoi ? Faut que\nt’aies qu’un seul Pokémon dans ton équipe.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "C’est parti !<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2188,
      "rawDecodedUtf16Hex": "0043201900650073007400200070006100720074006900200021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "J’ai trop hâte de le voir perdre !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2236,
      "rawDecodedUtf16Hex": "004A201900610069002000740072006F00700020006800E2007400650020006400650020006C006500200076006F00690072002000700065007200640072006500200021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mon Arbok a perdu...<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2328,
      "rawDecodedUtf16Hex": "004D006F006E0020004100720062006F006B00200061002000700065007200640075002E002E002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Cheh ! Si c’est pas la preuve que mon Oniglali\nest le plus fort, j’sais pas c’que c’est.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Bon, l<U+0010><U+0003>ᄀÿāea mioche. À nous deux !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2568,
      "rawDecodedUtf16Hex": "0042006F006E002C0020006C00100003110000FF0101006500610020006D0069006F006300680065002E002000C00020006E006F007500730020006400650075007800200021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Alors, prêt<U+0010><U+0003>ᄀÿĀe à affronter mon Oniglali\ndans un combat à un contre un ?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Oui, et je vais gagner, pour changer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2820,
      "rawDecodedUtf16Hex": "004F00750069002C0020006500740020006A0065002000760061006900730020006700610067006E00650072002C00200070006F007500720020006300680061006E006700650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Non, pas encore.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2900,
      "rawDecodedUtf16Hex": "004E006F006E002C002000700061007300200065006E0063006F00720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Ah ouais ? Ça veut dire que tu reconnais\nque mon Oniglali est le plus fort ?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 2936,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "On a dit que c’était un combat à un contre un.\nT’es bouché<U+0010><U+0003>ᄀÿĀe ou quoi ?<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3100,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Tu vas rien capter !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3260,
      "rawDecodedUtf16Hex": "0054007500200076006100730020007200690065006E002000630061007000740065007200200021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3312,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mais... t’es carrément balèze, en fait !<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3324,
      "rawDecodedUtf16Hex": "004D006100690073002E002E002E002000742019006500730020006300610072007200E9006D0065006E0074002000620061006C00E8007A0065002C00200065006E0020006600610069007400200021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3416,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mon Oniglali avait vraiment aucune chance,\nc’est chaud...<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3428,
      "rawDecodedUtf16Hex": "004D006F006E0020004F006E00690067006C0061006C006900200061007600610069007400200076007200610069006D0065006E007400200061007500630075006E00650020006300680061006E00630065002C000A00632019006500730074002000630068006100750064002E002E002E001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "J’y crois pas, on a perdu tous les deux ?!<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3552,
      "rawDecodedUtf16Hex": "004A20190079002000630072006F006900730020007000610073002C0020006F006E0020006100200070006500720064007500200074006F007500730020006C00650073002000640065007500780020003F0021001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "C’qui veut dire que le Pokémon le plus fort,\nc’est ni mon Arbok ni ton Oniglali.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "De ouf ! C’est son <U+0010><U+0002>ā<U+0002>, le Pokémon\nle plus balèze !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3820,
      "rawDecodedUtf16Hex": "004400650020006F007500660020002100200043201900650073007400200073006F006E00200010000201010002002C0020006C006500200050006F006B00E9006D006F006E000A006C006500200070006C00750073002000620061006C00E8007A006500200021001000020114001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "J’avoue... On s’y croyait un peu trop, en fait.<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3936,
      "rawDecodedUtf16Hex": "004A201900610076006F00750065002E002E002E0020004F006E0020007320190079002000630072006F007900610069007400200075006E0020007000650075002000740072006F0070002C00200065006E00200066006100690074002E001000020114001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Tu m’as ouvert les yeux, l<U+0010><U+0003>ᄀÿāea mioche !\nJ’ai un nouvel objectif, maintenant.<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ouais, pareil ! Et j’vais l’atteindre avant l’autre\net son Oniglali, là !<U+0010><U+0002>Ĕ<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 4208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Hein ? Tu crois que j’vais t’laisser faire mieux que\nmoi ? Avec Oniglali, on va te remettre à ta place !<U+0010><U+0002>Ĕ<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    }
