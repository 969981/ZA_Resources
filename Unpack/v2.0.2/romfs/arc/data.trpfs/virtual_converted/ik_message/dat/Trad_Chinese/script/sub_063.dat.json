      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "畢竟要是被凍住了，\n<U+0010><U+0003>ᄀÿā你妳的寶可夢就無法動彈了。<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "75627ADF8981662F88AB51CD4F4F4E86FF0C000A00100003110000FF01014F6059B376845BF653EF59225C3171216CD552D55F484E86300200100002011401620000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "剛才那是在模仿我憧憬的\n寶可夢訓練家。<U+0010><U+0001>븁\n那個人是冰屬性的好手，\n我也是向她看齊的喔。<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 280,
      "rawDecodedUtf16Hex": "525B624D90A3662F57286A214EFF621161A761AC7684000A5BF653EF59228A137DF45BB6300200100001BE01000A90A3500B4EBA662F51B05C6C60277684597D624BFF0C000A62114E5F662F54115979770B9F4A76845594300200100002011401620000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "如何？<U+0010><U+0001>븁\n要不要透過我派出的\n冰屬性寶可夢冰涼一下？<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 380,
      "rawDecodedUtf16Hex": "59824F55FF1F00100001BE01000A89814E0D8981900F904E62116D3E51FA7684000A51B05C6C60275BF653EF592251B06DBC4E004E0BFF1F00100002011401620000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "等<U+0010><U+0003>ᄀÿā你妳想要在對戰裡冰涼一下時，\n就來跟我搭話喔。<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "7B4900100003110000FF01014F6059B360F3898157285C0D623088E151B06DBC4E004E0B6642FF0C000A5C314F868DDF6211642D8A715594300200100002011401620000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "要和我派出的冰屬性寶可夢\n對戰看看嗎？<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "8981548C62116D3E51FA768451B05C6C60275BF653EF5922000A5C0D6230770B770B55CEFF1F00100002011401620000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "對戰吧！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "5C0D62305427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "不要",
