  "initialKey": 0,
  "messages": [
    {
      "displayText": "Os ! Os ! Ooooosss ! ♪",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "004F0073002000210020004F0073002000210020004F006F006F006F006F007300730073002000210020266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "L’Osselait vous donne une dose de Protéines.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "004C2019004F007300730065006C00610069007400200076006F0075007300200064006F006E006E006500200075006E006500200064006F00730065002000640065002000500072006F007400E90069006E00650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Félicitatiooooooons ! ♪<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 656,
      "rawDecodedUtf16Hex": "004600E9006C0069006300690074006100740069006F006F006F006F006F006F006F006E0073002000210020266A00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Ces Protéines font l’objet d’une campagne de\npublicité et vous sont offertes gratuitement !<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Auriez-vous le temps de répondre à un petit\nsondage en échange ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 904,
      "rawDecodedUtf16Hex": "00410075007200690065007A002D0076006F007500730020006C0065002000740065006D007000730020006400650020007200E90070006F006E006400720065002000E000200075006E002000700065007400690074000A0073006F006E006400610067006500200065006E002000E9006300680061006E006700650020003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Euh... D’accord.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1044,
      "rawDecodedUtf16Hex": "004500750068002E002E002E002000442019006100630063006F00720064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Pardon, je suis pressé<U+0010><U+0003>ᄀÿĀe.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1080,
      "rawDecodedUtf16Hex": "0050006100720064006F006E002C0020006A00650020007300750069007300200070007200650073007300E900100003110000FF01000065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Oh, ça ne prendra qu’un instant, c’est promis ! ♪<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1140,
      "rawDecodedUtf16Hex": "004F0068002C002000E700610020006E00650020007000720065006E00640072006100200071007520190075006E00200069006E007300740061006E0074002C002000632019006500730074002000700072006F006D00690073002000210020266A00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Merveilleux ! Je vous remercie !<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "004D00650072007600650069006C006C006500750078002000210020004A006500200076006F00750073002000720065006D006500720063006900650020002100100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Alors, j’aimerais que vous m’en disiez plus sur\nvotre rapport aux Protéines.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Tout d’abord, connaissiez-vous leur existence ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "0054006F0075007400200064201900610062006F00720064002C00200063006F006E006E006100690073007300690065007A002D0076006F007500730020006C0065007500720020006500780069007300740065006E006300650020003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Oui, bien sûr. Je sais ce que c’est.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1592,
      "rawDecodedUtf16Hex": "004F00750069002C0020006200690065006E0020007300FB0072002E0020004A0065002000730061006900730020006300650020007100750065002000632019006500730074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "J’en ai déjà entendu parler.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "004A20190065006E0020006100690020006400E9006A00E000200065006E00740065006E006400750020007000610072006C00650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Pas du tout.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1728,
      "rawDecodedUtf16Hex": "00500061007300200064007500200074006F00750074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Oh, je vois, je vois... Je note.\nLes Protéines sont des boissons énergisantes.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Et donc, où en avez-vous entendu parler ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1924,
      "rawDecodedUtf16Hex": "0045007400200064006F006E0063002C0020006F00F900200065006E0020006100760065007A002D0076006F0075007300200065006E00740065006E006400750020007000610072006C006500720020003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Sur les réseaux sociaux.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "0053007500720020006C006500730020007200E90073006500610075007800200073006F00630069006100750078002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Via une connaissance.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2068,
      "rawDecodedUtf16Hex": "00560069006100200075006E006500200063006F006E006E00610069007300730061006E00630065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "J’ai vu une affiche publicitaire.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2112,
      "rawDecodedUtf16Hex": "004A20190061006900200076007500200075006E0065002000610066006600690063006800650020007000750062006C00690063006900740061006900720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "On en vend au Centre Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2180,
      "rawDecodedUtf16Hex": "004F006E00200065006E002000760065006E0064002000610075002000430065006E00740072006500200050006F006B00E9006D006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Vous venez juste de m’en parler.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2240,
      "rawDecodedUtf16Hex": "0056006F00750073002000760065006E0065007A0020006A00750073007400650020006400650020006D20190065006E0020007000610072006C00650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "D’accord, je note... C’est important de se tenir\ninformé sur ce qui nous entoure, n’est-ce pas ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Les Protéines coûtent 5 000 <U+E300> l’unité.\nNe trouvez-vous pas cela un peu cher ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Oui, c’est bien trop cher.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2676,
      "rawDecodedUtf16Hex": "004F00750069002C0020006320190065007300740020006200690065006E002000740072006F007000200063006800650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Je suppose que le prix est justifié.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2732,
      "rawDecodedUtf16Hex": "004A006500200073007500700070006F0073006500200071007500650020006C00650020007000720069007800200065007300740020006A00750073007400690066006900E9002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Non, ça va. À ce prix, c’est donné.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "004E006F006E002C002000E70061002000760061002E002000C000200063006500200070007200690078002C00200063201900650073007400200064006F006E006E00E9002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "La valeur des choses varie d’une personne à\nl’autre, n’est-ce pas ? Très bien, je note...<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Et sinon, connaissez-vous d’autres boissons\nénergisantes de type Protéines ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Je connais les boissons au Fer.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3232,
      "rawDecodedUtf16Hex": "004A006500200063006F006E006E0061006900730020006C0065007300200062006F006900730073006F006E00730020006100750020004600650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "J’ai vu des boissons au Calcium.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3296,
      "rawDecodedUtf16Hex": "004A201900610069002000760075002000640065007300200062006F006900730073006F006E0073002000610075002000430061006C006300690075006D002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "J’ai entendu parler des boissons au Zinc.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3364,
      "rawDecodedUtf16Hex": "004A20190061006900200065006E00740065006E006400750020007000610072006C00650072002000640065007300200062006F006900730073006F006E00730020006100750020005A0069006E0063002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Il y a les boissons au Carbone, je crois.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3448,
      "rawDecodedUtf16Hex": "0049006C00200079002000610020006C0065007300200062006F006900730073006F006E007300200061007500200043006100720062006F006E0065002C0020006A0065002000630072006F00690073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Non, je n’en connais pas d’autres...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3532,
      "rawDecodedUtf16Hex": "004E006F006E002C0020006A00650020006E20190065006E00200063006F006E006E0061006900730020007000610073002000642019006100750074007200650073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Hmmm... À vrai dire, il existe une grande\nvariété de boissons de ce type ! Je note !<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Autre question, dans quel but donnez-vous\ndes Protéines à vos Pokémon ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 3788,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Pour augmenter leur Attaque.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3940,
      "rawDecodedUtf16Hex": "0050006F007500720020006100750067006D0065006E0074006500720020006C00650075007200200041007400740061007100750065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Pour augmenter leur Défense.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4000,
      "rawDecodedUtf16Hex": "0050006F007500720020006100750067006D0065006E0074006500720020006C0065007500720020004400E900660065006E00730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Pour augmenter leur Attaque Spéciale.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4060,
      "rawDecodedUtf16Hex": "0050006F007500720020006100750067006D0065006E0074006500720020006C0065007500720020004100740074006100710075006500200053007000E9006300690061006C0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Pour augmenter leur Défense Spéciale.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4136,
      "rawDecodedUtf16Hex": "0050006F007500720020006100750067006D0065006E0074006500720020006C0065007500720020004400E900660065006E0073006500200053007000E9006300690061006C0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Pour augmenter leur Vitesse.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4212,
      "rawDecodedUtf16Hex": "0050006F007500720020006100750067006D0065006E0074006500720020006C00650075007200200056006900740065007300730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Intéressant, je note... Surtout, pensez à suivre\nles instructions d’utilisation et de dosage.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Mais à part cela, dites-moi...\nQuel goût ont les Protéines, d’après vous ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Je suppose que c’est bon ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4628,
      "rawDecodedUtf16Hex": "004A006500200073007500700070006F00730065002000710075006500200063201900650073007400200062006F006E0020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Un goût sucré, peut-être ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 4684,
      "rawDecodedUtf16Hex": "0055006E00200067006F00FB00740020007300750063007200E9002C00200070006500750074002D00EA0074007200650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Ça doit être amer, j’imagine ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4740,
      "rawDecodedUtf16Hex": "00C7006100200064006F00690074002000EA00740072006500200061006D00650072002C0020006A20190069006D006100670069006E00650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Qu’est-ce que j’en sais ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 4804,
      "rawDecodedUtf16Hex": "005100752019006500730074002D0063006500200071007500650020006A20190065006E002000730061006900730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Nous aimerions que les Pokémon nous le disent,\nn’est-ce pas ? Très bien, je note votre réponse...<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 4856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Dernière question... Conseilleriez-vous\nles Protéines à votre entourage ?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Oh oui, carrément !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 48,
      "offsetInSection": 5216,
      "rawDecodedUtf16Hex": "004F00680020006F00750069002C0020006300610072007200E9006D0065006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Je pense que oui.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5256,
      "rawDecodedUtf16Hex": "004A0065002000700065006E0073006500200071007500650020006F00750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Bof, pas vraiment.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 5292,
      "rawDecodedUtf16Hex": "0042006F0066002C002000700061007300200076007200610069006D0065006E0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Je ne sais pas.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 5332,
      "rawDecodedUtf16Hex": "004A00650020006E0065002000730061006900730020007000610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Cela dépend à qui l’on s’adresse, n’est-ce pas ?\nVotre réponse est intéressante, je note...<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 5364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
