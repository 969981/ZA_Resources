      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "好的。\n那麼，特殊搜尋系統啟動！<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
