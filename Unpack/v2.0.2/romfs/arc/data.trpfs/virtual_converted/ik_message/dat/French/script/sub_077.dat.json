      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Et si on posait toutes nos questions\nà ce<U+0010><U+0003>ᄀÿഉ Dresseurtte Dresseuse ?<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
