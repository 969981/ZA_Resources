      "rawDecodedUtf16Hex": "0053006800610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Chandelure thinks that Gengar might be at Hotel\nRichissime.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
