      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "002E002E002E00200041006C006F007200730020003F00200056006F0075007300200076006F0075006C0065007A0020007900200067006F00FB0074006500720020003F00100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
