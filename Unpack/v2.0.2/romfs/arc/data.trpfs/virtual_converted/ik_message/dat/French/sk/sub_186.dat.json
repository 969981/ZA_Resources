      "utf16Units": 5
    },
    {
      "displayText": "Êtes-vous venu<U+0010><U+0003>ᄀÿĀe déguster une tasse de notre\nCafé Ultimate Super Premium : édition du siècle ?<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 4,
