      "index": 8,
      "offsetInSection": 1656,
      "rawDecodedUtf16Hex": "004E006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hmpf ! Vous ne méritez rien de plus\nqu’une vulgaire tasse de café à 100 000 <U+E300>.<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Formidable ! Une tasse de ce café vous coûtera...\n1 000 000 <U+E300> !<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "0046006F0072006D0069006400610062006C00650020002100200055006E0065002000740061007300730065002000640065002000630065002000630061006600E900200076006F0075007300200063006F00FB0074006500720061002E002E002E000A0031002000300030003000200030003000300020E3000020002100100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Passez commande si votre choix est définitif !<U+0010><U+0002>ĔǠ",
