  "initialKey": 0,
  "messages": [
    {
      "displayText": "Willkommen im Restaurant Solala! Wenn dir\nnach Durchschnitt ist, bist du hier richtig!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Immer nach der Spitze streben! Dieses Motto\nist fest in meiner Seele verankert!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 372,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Darf ich dir eines unserer famosen\nKampf-Menüs empfehlen?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "004400610072006600200069006300680020006400690072002000650069006E0065007300200075006E00730065007200650072002000660061006D006F00730065006E000A004B0061006D00700066002D004D0065006E00FC007300200065006D0070006600650068006C0065006E003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Lob bekomme ich irgendwie\nimmer nur von mir selbst.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "004C006F0062002000620065006B006F006D006D0065002000690063006800200069007200670065006E0064007700690065000A0069006D006D006500720020006E0075007200200076006F006E0020006D00690072002000730065006C006200730074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ach, deine Pokémon loben dich\ndoch sicher auch.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 780,
      "rawDecodedUtf16Hex": "004100630068002C0020006400650069006E006500200050006F006B00E9006D006F006E0020006C006F00620065006E00200064006900630068000A0064006F00630068002000730069006300680065007200200061007500630068002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Meine Aufmerksamkeit gilt voll\nund ganz diesem einen Dessert!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "004D00650069006E00650020004100750066006D00650072006B00730061006D006B006500690074002000670069006C007400200076006F006C006C000A0075006E0064002000670061006E007A002000640069006500730065006D002000650069006E0065006E0020004400650073007300650072007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Die Crêpes Suzette hier sind zwar\nsimpel, aber unglaublich lecker!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "00440069006500200043007200EA007000650073002000530075007A006500740074006500200068006900650072002000730069006E00640020007A007700610072000A00730069006D00700065006C002C0020006100620065007200200075006E0067006C006100750062006C0069006300680020006C00650063006B0065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Beim Essen Pokémon-Kämpfen\nzuzusehen ist schon was Feines.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "004200650069006D00200045007300730065006E00200050006F006B00E9006D006F006E002D004B00E4006D007000660065006E000A007A0075007A00750073006500680065006E00200069007300740020007300630068006F006E00200077006100730020004600650069006E00650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Ein gepfefferter Kampf würzt auch\ngleich mein Essen mit!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "00450069006E00200067006500700066006500660066006500720074006500720020004B0061006D007000660020007700FC0072007A007400200061007500630068000A0067006C00650069006300680020006D00650069006E00200045007300730065006E0020006D0069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Kaum beginnt ein Kampf, lassen\ndie Kinder das Essen stehen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "004B00610075006D00200062006500670069006E006E0074002000650069006E0020004B0061006D00700066002C0020006C0061007300730065006E000A0064006900650020004B0069006E006400650072002000640061007300200045007300730065006E002000730074006500680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Ich würde Pokémon mit niedrigen\nKP gerne eine Tsitrubeere geben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1492,
      "rawDecodedUtf16Hex": "0049006300680020007700FC00720064006500200050006F006B00E9006D006F006E0020006D006900740020006E0069006500640072006900670065006E000A004B00500020006700650072006E0065002000650069006E006500200054007300690074007200750062006500650072006500200067006500620065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Das verstehe ich.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "0044006100730020007600650072007300740065006800650020006900630068002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Wenn ich nicht hier essen kann,\nwill ich immer am liebsten weinen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1660,
      "rawDecodedUtf16Hex": "00570065006E006E00200069006300680020006E00690063006800740020006800690065007200200065007300730065006E0020006B0061006E006E002C000A00770069006C006C002000690063006800200069006D006D0065007200200061006D0020006C006900650062007300740065006E0020007700650069006E0065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ich würde mein Essen schon gerne in Ruhe\ngenießen, wenn möglich.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "0049006300680020007700FC0072006400650020006D00650069006E00200045007300730065006E0020007300630068006F006E0020006700650072006E006500200069006E00200052007500680065000A00670065006E0069006500DF0065006E002C002000770065006E006E0020006D00F60067006C006900630068002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Cuillères Kochkunst ist einfach phänomenal!\nEr verfeinert seine Speisen von Mal zu Mal mehr.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1928,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Ich bitte um Verzeihung, aber ich kenne nur den\nChefkoch Narcisse.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2116,
      "rawDecodedUtf16Hex": "00490063006800200062006900740074006500200075006D0020005600650072007A0065006900680075006E0067002C0020006100620065007200200069006300680020006B0065006E006E00650020006E00750072002000640065006E000A0043006800650066006B006F006300680020004E0061007200630069007300730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Hier haben wir unsere Hochzeit\nund Silberhochzeit gefeiert!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "004800690065007200200068006100620065006E002000770069007200200075006E007300650072006500200048006F00630068007A006500690074000A0075006E0064002000530069006C0062006500720068006F00630068007A00650069007400200067006500660065006900650072007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Der Beweis, dass wir ein schön\nentspanntes Leben geführt haben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2372,
      "rawDecodedUtf16Hex": "0044006500720020004200650077006500690073002C002000640061007300730020007700690072002000650069006E002000730063006800F6006E000A0065006E0074007300700061006E006E0074006500730020004C006500620065006E002000670065006600FC00680072007400200068006100620065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Heute stehen Meeresfrüchte und\neine Suppe auf dem Tagesmenü.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2500,
      "rawDecodedUtf16Hex": "00480065007500740065002000730074006500680065006E0020004D006500650072006500730066007200FC006300680074006500200075006E0064000A00650069006E00650020005300750070007000650020006100750066002000640065006D002000540061006700650073006D0065006E00FC002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Du warst früher hier\nStammgast, nicht wahr?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "0044007500200077006100720073007400200066007200FC00680065007200200068006900650072000A005300740061006D006D0067006100730074002C0020006E006900630068007400200077006100680072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Das Essen hier ist so gewöhnlich,\nich bin zu Tränen gerührt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "00440061007300200045007300730065006E00200068006900650072002000690073007400200073006F002000670065007700F60068006E006C006900630068002C000A006900630068002000620069006E0020007A007500200054007200E4006E0065006E002000670065007200FC006800720074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Einfach toll, wie sie hier nur ganz\npassable Gerichte auftischen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "00450069006E006600610063006800200074006F006C006C002C00200077006900650020007300690065002000680069006500720020006E00750072002000670061006E007A000A007000610073007300610062006C00650020004700650072006900630068007400650020006100750066007400690073006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Ich will endlich essen! Vielleicht\nsollte ich mal in die Küche gehen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "004900630068002000770069006C006C00200065006E0064006C00690063006800200065007300730065006E00210020005600690065006C006C00650069006300680074000A0073006F006C006C0074006500200069006300680020006D0061006C00200069006E00200064006900650020004B00FC00630068006500200067006500680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Denk an deine Manieren! Du willst\ndich doch nicht blamieren, oder?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3108,
      "rawDecodedUtf16Hex": "00440065006E006B00200061006E0020006400650069006E00650020004D0061006E0069006500720065006E0021002000440075002000770069006C006C00730074000A006400690063006800200064006F006300680020006E006900630068007400200062006C0061006D0069006500720065006E002C0020006F006400650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    }
