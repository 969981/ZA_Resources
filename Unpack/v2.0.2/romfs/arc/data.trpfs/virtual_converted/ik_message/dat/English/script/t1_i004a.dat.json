  "messages": [
    {
      "displayText": "Welcome to Restaurant Le Nah. Our flavors will\nnever overwhelm your palate.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Keep aiming for the top! That’s the ethos I’ve\nalways lived by.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "004B006500650070002000610069006D0069006E006700200066006F0072002000740068006500200074006F00700021002000540068006100742019007300200074006800650020006500740068006F007300200049201900760065000A0061006C00770061007900730020006C0069007600650064002000620079002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Feel free to take on our\nfull-course feast. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 476,
      "rawDecodedUtf16Hex": "004600650065006C0020006600720065006500200074006F002000740061006B00650020006F006E0020006F00750072000A00660075006C006C002D0063006F0075007200730065002000660065006100730074002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "I feel like I only ever get\ncompliments from myself...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 596,
      "rawDecodedUtf16Hex": "00490020006600650065006C0020006C0069006B0065002000490020006F006E006C0079002000650076006500720020006700650074000A0063006F006D0070006C0069006D0065006E00740073002000660072006F006D0020006D007900730065006C0066002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Oh, but your Pokémon must\nsing your praises all the time!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "004F0068002C002000620075007400200079006F0075007200200050006F006B00E9006D006F006E0020006D007500730074000A00730069006E006700200079006F007500720020007000720061006900730065007300200061006C006C0020007400680065002000740069006D006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "I saved my taste buds\nall for this dessert!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "00490020007300610076006500640020006D007900200074006100730074006500200062007500640073000A0061006C006C00200066006F0072002000740068006900730020006400650073007300650072007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "The Crêpes Suzette don’t look all\nthat fancy, yet they’re so delicious!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "00540068006500200043007200EA007000650073002000530075007A006500740074006500200064006F006E201900740020006C006F006F006B00200061006C006C000A0074006800610074002000660061006E00630079002C00200079006500740020007400680065007920190072006500200073006F002000640065006C006900630069006F0075007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Watching Pokémon battles while\nyou eat is quite something.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1056,
      "rawDecodedUtf16Hex": "005700610074006300680069006E006700200050006F006B00E9006D006F006E00200062006100740074006C006500730020007700680069006C0065000A0079006F0075002000650061007400200069007300200071007500690074006500200073006F006D0065007400680069006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Crummy battles make the\nfood taste crummy, too.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "004300720075006D006D007900200062006100740074006C006500730020006D0061006B00650020007400680065000A0066006F006F00640020007400610073007400650020006300720075006D006D0079002C00200074006F006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "The kids forget all about their\nfood as soon as a battle starts.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "0054006800650020006B00690064007300200066006F007200670065007400200061006C006C002000610062006F00750074002000740068006500690072000A0066006F006F006400200061007300200073006F006F006E0020006100730020006100200062006100740074006C00650020007300740061007200740073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "I just want to throw a Sitrus Berry\nat whichever Pokémon is losing!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "00490020006A007500730074002000770061006E007400200074006F0020007400680072006F0077002000610020005300690074007200750073002000420065007200720079000A00610074002000770068006900630068006500760065007200200050006F006B00E9006D006F006E0020006900730020006C006F00730069006E006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "I totally understand.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "004900200074006F00740061006C006C007900200075006E006400650072007300740061006E0064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "I don’t know how I’d make it\nthrough the day without this place.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "004900200064006F006E201900740020006B006E006F007700200068006F007700200049201900640020006D0061006B0065002000690074000A007400680072006F0075006700680020007400680065002000640061007900200077006900740068006F007500740020007400680069007300200070006C006100630065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "I’d rather be left to enjoy my meal in peace, if you\ndon’t mind.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "00492019006400200072006100740068006500720020006200650020006C00650066007400200074006F00200065006E006A006F00790020006D00790020006D00650061006C00200069006E002000700065006100630065002C00200069006600200079006F0075000A0064006F006E201900740020006D0069006E0064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Chef Roger strikes again! I swear his cooking\nreaches new heights every time I come here.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Sorry, but Siebold is the only chef I know about...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2028,
      "rawDecodedUtf16Hex": "0053006F007200720079002C002000620075007400200053006900650062006F006C006400200069007300200074006800650020006F006E006C007900200063006800650066002000490020006B006E006F0077002000610062006F00750074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "We celebrated our wedding and\nsilver anniversary here, didn’t we?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2132,
      "rawDecodedUtf16Hex": "00570065002000630065006C00650062007200610074006500640020006F00750072002000770065006400640069006E006700200061006E0064000A00730069006C00760065007200200061006E006E0069007600650072007300610072007900200068006500720065002C0020006400690064006E20190074002000770065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "That goes to show what a long\nand peaceful life we’ve had.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "005400680061007400200067006F0065007300200074006F002000730068006F007700200077006800610074002000610020006C006F006E0067000A0061006E006400200070006500610063006500660075006C0020006C0069006600650020007700652019007600650020006800610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "That set menu! Remember?\nWith fish and soup for the entrée...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "005400680061007400200073006500740020006D0065006E00750021002000520065006D0065006D006200650072003F000A00570069007400680020006600690073006800200061006E006400200073006F0075007000200066006F0072002000740068006500200065006E0074007200E90065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "You were quite the regular here\nback in the day, weren’t you?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2508,
      "rawDecodedUtf16Hex": "0059006F007500200077006500720065002000710075006900740065002000740068006500200072006500670075006C0061007200200068006500720065000A006200610063006B00200069006E00200074006800650020006400610079002C00200077006500720065006E2019007400200079006F0075003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "The food here is so ordinary\nthat it’s actually impressive.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2632,
      "rawDecodedUtf16Hex": "00540068006500200066006F006F00640020006800650072006500200069007300200073006F0020006F007200640069006E006100720079000A007400680061007400200069007420190073002000610063007400750061006C006C007900200069006D00700072006500730073006900760065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "It’s amazing how they always hit\nthat “sorta tasty” sweet spot.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2752,
      "rawDecodedUtf16Hex": "004900742019007300200061006D0061007A0069006E006700200068006F00770020007400680065007900200061006C00770061007900730020006800690074000A00740068006100740020201C0073006F007200740061002000740061007300740079201D002000730077006500650074002000730070006F0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "I wanna eat right NOW! Maybe\nI’ll go get food from the kitchen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2880,
      "rawDecodedUtf16Hex": "0049002000770061006E006E006100200065006100740020007200690067006800740020004E004F005700210020004D0061007900620065000A00492019006C006C00200067006F002000670065007400200066006F006F0064002000660072006F006D00200074006800650020006B00690074006300680065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Patience, darling.\nManners maketh man.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3012,
      "rawDecodedUtf16Hex": "00500061007400690065006E00630065002C0020006400610072006C0069006E0067002E000A004D0061006E006E0065007200730020006D0061006B0065007400680020006D0061006E002E0000",
