      "rawDecodedUtf16Hex": "AC19B358B370C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "역시 그렇죠!?<U+0010><U+0002>ĔŇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1076,
