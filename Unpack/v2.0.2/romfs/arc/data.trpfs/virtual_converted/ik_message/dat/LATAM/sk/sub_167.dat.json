  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "¿Por qué quieres volverte más fuerte?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "00BF0050006F007200200071007500E90020007100750069006500720065007300200076006F006C007600650072007400650020006D00E100730020006600750065007200740065003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Lo hago por mí misma.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "004C006F0020006800610067006F00200070006F00720020006D00ED0020006D00690073006D0061002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡Yo deseo volverme más fuerte para proteger\na Inma y a los demás!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "00A10059006F00200064006500730065006F00200076006F006C007600650072006D00650020006D00E10073002000660075006500720074006500200070006100720061002000700072006F00740065006700650072000A006100200049006E006D006100200079002000610020006C006F0073002000640065006D00E10073002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Es cierto que no he logrado vencer a Lilette...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 608,
      "rawDecodedUtf16Hex": "00450073002000630069006500720074006F00200071007500650020006E006F0020006800650020006C006F0067007200610064006F002000760065006E006300650072002000610020004C0069006C0065007400740065002E002E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Pero lo que no te mata te hace más fuerte.\nEstoy segura de eso.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "005000650072006F0020006C006F00200071007500650020006E006F0020007400650020006D006100740061002000740065002000680061006300650020006D00E100730020006600750065007200740065002E000A004500730074006F00790020007300650067007500720061002000640065002000650073006F002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Si logro superar a Lilette, me sentiré invencible.\n¡Seguiré luchando hasta alcanzar esa meta!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Así que luchas únicamente por ti misma...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1044,
      "rawDecodedUtf16Hex": "0041007300ED00200071007500650020006C00750063006800610073002000FA006E006900630061006D0065006E0074006500200070006F00720020007400690020006D00690073006D0061002E002E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡No me parece que sea un razonamiento\nadecuado para una Entrenadora!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "00A1004E006F0020006D006500200070006100720065006300650020007100750065002000730065006100200075006E002000720061007A006F006E0061006D00690065006E0074006F000A0061006400650063007500610064006F0020007000610072006100200075006E006100200045006E007400720065006E00610064006F00720061002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¡Pst! ¡Ven!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "00A10050007300740021002000A100560065006E002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Voy a aprovechar que estás aquí para terminar\neste asunto y así dejan de pelearse.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1316,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Eh, chicos, ya llegó <U+0010><U+0002>Ā<U+0000>. ¿Y si\ndecidimos<U+0010><U+0001>븀\nquién<U+0010><U+0001>븀\ntiene razón con un combate?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1492,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "¡Estoy list<U+0010><U+0003>ᄀÿāoa!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "00A1004500730074006F00790020006C00690073007400100003110000FF0101006F006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Un momento",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "0055006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¡Menos charla y más combate! Hablando no\nte vas a hacer más fuerte.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1740,
      "rawDecodedUtf16Hex": "00A1004D0065006E006F007300200063006800610072006C0061002000790020006D00E1007300200063006F006D006200610074006500210020004800610062006C0061006E0064006F0020006E006F000A007400650020007600610073002000610020006800610063006500720020006D00E100730020006600750065007200740065002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¡Junt<U+0010><U+0003>ᄀÿāoas contra el Círculo Justiciero,\nles mostraremos nuestra convicción!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1884,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Yo también estoy esperando ansiosamente\nnuestro combate.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2064,
      "rawDecodedUtf16Hex": "0059006F002000740061006D0062006900E9006E0020006500730074006F00790020006500730070006500720061006E0064006F00200061006E00730069006F00730061006D0065006E00740065000A006E00750065007300740072006F00200063006F006D0062006100740065002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Quiero combatir de una vez e irme a casa.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2188,
      "rawDecodedUtf16Hex": "00510075006900650072006F00200063006F006D0062006100740069007200200064006500200075006E0061002000760065007A00200065002000690072006D00650020006100200063006100730061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Estoy list<U+0010><U+0003>ᄀÿāoa!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2280,
      "rawDecodedUtf16Hex": "00A1004500730074006F00790020006C00690073007400100003110000FF0101006F006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Un momento",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2320,
      "rawDecodedUtf16Hex": "0055006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Existe un tipo de experiencia que solo se puede\nobtener al derrotar a adversarios fuertes.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "¡La fuerza es poder!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "00A1004C006100200066007500650072007A006100200065007300200070006F006400650072002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "¿Desde cuándo eres así de indecis<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2588,
      "rawDecodedUtf16Hex": "00BF0044006500730064006500200063007500E1006E0064006F0020006500720065007300200061007300ED00200064006500200069006E0064006500630069007300100003110000FF0101006F0061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡La fuerza es justicia!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2680,
      "rawDecodedUtf16Hex": "00A1004C006100200066007500650072007A00610020006500730020006A0075007300740069006300690061002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "¡Junt<U+0010><U+0003>ᄀÿāoas contra el Círculo Justiciero,\nles mostraremos nuestra convicción!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0019>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2904,
      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡La justicia prevalecerá! ¡Falinks, megaevoluciona!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2916,
      "rawDecodedUtf16Hex": "00A1004C00610020006A0075007300740069006300690061002000700072006500760061006C006500630065007200E10021002000A100460061006C0069006E006B0073002C0020006D00650067006100650076006F006C007500630069006F006E0061002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Chandelure... ¡Megaevoluciona\ny derrótalos!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002E002E002E002000A1004D00650067006100650076006F006C007500630069006F006E0061000A00790020006400650072007200F300740061006C006F0073002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Es hora de sacar mi as bajo la manga.\n¡Megaevoluciona y dales una paliza, Dragalge!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3300,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "No importa si se lucha por los demás o por uno\nmismo.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3312,
      "rawDecodedUtf16Hex": "004E006F00200069006D0070006F0072007400610020007300690020007300650020006C007500630068006100200070006F00720020006C006F0073002000640065006D00E100730020006F00200070006F007200200075006E006F000A006D00690073006D006F002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Ambos enfoques son igualmente válidos.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3428,
      "rawDecodedUtf16Hex": "0041006D0062006F007300200065006E0066006F007100750065007300200073006F006E00200069006700750061006C006D0065006E007400650020007600E1006C00690064006F0073002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Y yo supongo que luchar por los demás te\npermitió alcanzar tu propia meta. ¡Bien hecho!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¡Me llegó al alma lo que dijiste!\nToma este conjunto, es para ti.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3700,
      "rawDecodedUtf16Hex": "00A1004D00650020006C006C0065006700F300200061006C00200061006C006D00610020006C006F0020007100750065002000640069006A00690073007400650021000A0054006F006D00610020006500730074006500200063006F006E006A0075006E0074006F002C00200065007300200070006100720061002000740069002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Lo siento, pero prometí llevar puesto este atuendo\nhasta poder liberarme del yugo de Lilette.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3840,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Entiendo. Bueno, entonces es para ti,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4036,
      "rawDecodedUtf16Hex": "0045006E007400690065006E0064006F002E0020004200750065006E006F002C00200065006E0074006F006E00630065007300200065007300200070006100720061002000740069002C000A0010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Recibiste el Kimono de Gauri de color\nalternativo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4132,
      "rawDecodedUtf16Hex": "00520065006300690062006900730074006500200065006C0020004B0069006D006F006E006F00200064006500200047006100750072006900200064006500200063006F006C006F0072000A0061006C007400650072006E0061007400690076006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Según dicen, hay algunos raritos que ya\nempezaron a peinarse como Gauri...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "La sed de fuerza no tiene límites. Espero que el\ndestino vuelva a enfrentarnos pronto.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4396,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Tal vez Delphi se adapta mejor que yo al dojo.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4580,
      "rawDecodedUtf16Hex": "00540061006C002000760065007A002000440065006C00700068006900200073006500200061006400610070007400610020006D0065006A006F0072002000710075006500200079006F00200061006C00200064006F006A006F002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Creo recordar haber luchado contra Gauri\ncuando éramos niños...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4684,
      "rawDecodedUtf16Hex": "004300720065006F0020007200650063006F00720064006100720020006800610062006500720020006C00750063006800610064006F00200063006F006E007400720061002000470061007500720069000A006300750061006E0064006F002000E900720061006D006F00730020006E006900F1006F0073002E002E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    }
