      "index": 6,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Do you want to turn one of your Pokémon’s\nmoves into a Plus Move with a Seed of Mastery?<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
