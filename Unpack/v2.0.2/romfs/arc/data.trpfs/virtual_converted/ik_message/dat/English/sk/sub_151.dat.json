      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1520,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bring me a “real” Seviper if you want me to admit\nthat you’re right and I’m wrong!<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Did you bring me one of your so-called “real”\nSeviper? Go on, then. Let’s see it.<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "What’s this, now?<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
