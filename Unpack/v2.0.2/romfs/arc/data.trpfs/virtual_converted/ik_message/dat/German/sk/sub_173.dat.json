  "messages": [
    {
      "displayText": "Hi! Wusstest du, dass Karpador zur Kategorie\nFisch-Pokémon gehört? Barschwa auch.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Aber obwohl beide dieselbe Kategorie haben,\ntrifft man in Illumina keine Barschwa an...<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Wenn du also ein Barschwa hast, würdest du es\nmir vielleicht überlassen?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0003>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "00100002BDFF00030000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Würdest du mir ein Barschwa überlassen?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 696,
      "rawDecodedUtf16Hex": "005700FC007200640065007300740020006400750020006D00690072002000650069006E002000420061007200730063006800770061002000FC006200650072006C0061007300730065006E003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Ich hätte da ein Exemplar.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "0049006300680020006800E4007400740065002000640061002000650069006E0020004500780065006D0070006C00610072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Hab leider auch keins.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 840,
      "rawDecodedUtf16Hex": "0048006100620020006C00650069006400650072002000610075006300680020006B00650069006E0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Hurra! Welches Barschwa gibst du mir denn?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 888,
      "rawDecodedUtf16Hex": "004800750072007200610021002000570065006C00630068006500730020004200610072007300630068007700610020006700690062007300740020006400750020006D00690072002000640065006E006E003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ich wünsche mir so sehr ein Barschwa!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "0049006300680020007700FC006E00730063006800650020006D0069007200200073006F00200073006500680072002000650069006E002000420061007200730063006800770061002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Ach, sieh an! Das ist ja wahrhaftig ein Barschwa!\nDanke schön!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "004100630068002C0020007300690065006800200061006E0021002000440061007300200069007300740020006A006100200077006100680072006800610066007400690067002000650069006E0020004200610072007300630068007700610021000A00440061006E006B0065002000730063006800F6006E002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Du liebe Zeit, das ist aber ein großes Barschwa!\nDanke schön!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "004400750020006C00690065006200650020005A006500690074002C0020006400610073002000690073007400200061006200650072002000650069006E002000670072006F00DF006500730020004200610072007300630068007700610021000A00440061006E006B0065002000730063006800F6006E002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Ein Schillerndes Barschwa?! Wahnsinn, danke!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "00450069006E00200053006300680069006C006C00650072006E006400650073002000420061007200730063006800770061003F00210020005700610068006E00730069006E006E002C002000640061006E006B0065002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Ein Elite-Pokémon?!<U+0010><U+0001>븁\nUnd auch noch ein Schillerndes Exemplar?!<U+0010><U+0001>븁\nDas ist mir ja fast schon unheimlich. Ganz vielen\nherzlichen Dank!!!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "Grüß dich, Barschwa! Ich hoffe, dass wir uns gut\nverstehen werden.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1720,
      "rawDecodedUtf16Hex": "0047007200FC00DF00200064006900630068002C0020004200610072007300630068007700610021002000490063006800200068006F006600660065002C00200064006100730073002000770069007200200075006E00730020006700750074000A00760065007200730074006500680065006E002000770065007200640065006E002E00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich hoffe, dass Barschwa und ich uns gut\nverstehen werden.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "00490063006800200068006F006600660065002C0020006400610073007300200042006100720073006300680077006100200075006E0064002000690063006800200075006E00730020006700750074000A00760065007200730074006500680065006E002000770065007200640065006E002E00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Schwa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "00530063006800770061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Ich habe es im Teich freigelassen, damit es sich\nmit den Karpador anfreundet.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Fisch-Pokémon sollten doch gut miteinander\nauskommen!<U+0010><U+0001>븁\nMir wurde zwar gesagt, dass man beim\nFreilassen von Pokémon achtsam sein soll...<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Aber schau dir doch nur den Teich an!<U+0010><U+0001>븁\nBarschwa und Karpador scheinen sich bestens zu\nverstehen!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
