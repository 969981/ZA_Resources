      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "00440072006900690069006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Però, complimenti! Hai fatto un lavorone!\nÈ quasi meglio di prima...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
