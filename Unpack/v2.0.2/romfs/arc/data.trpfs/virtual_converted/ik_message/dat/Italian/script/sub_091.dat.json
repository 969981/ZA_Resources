      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Scommetto che l’autore di questa buca ne avrà\nfatte anche altre. Sbrigati ad acciuffarlo!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
