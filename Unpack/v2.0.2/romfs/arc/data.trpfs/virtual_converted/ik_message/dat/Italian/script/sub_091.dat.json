      "rawDecodedUtf16Hex": "00500065007200F2002C00200063006F006D0070006C0069006D0065006E007400690021002000480061006900200066006100740074006F00200075006E0020006C00610076006F0072006F006E00650021000A00C80020007100750061007300690020006D00650067006C0069006F0020006400690020007000720069006D0061002E002E002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Driiil!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "00440072006900690069006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Si vede che hai stile. Mi stai simpatico, tu! Sei il\nbenvenuto nel Clan Ruggine. Ti prenderò sotto<U+0010><U+0001>븀\nla mia ala, e non farai più di questi scherzacci!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 156
    },
    {
      "displayText": "Però devi conoscere almeno una mossa di tipo\nAcciaio o Veleno per stare nel nostro clan, se no<U+0010><U+0001>븀\npoi sfiguri davanti a tutti gli altri!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3116,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "Ci sono. Velenpuntura fa al caso tuo! Fammi\nandare a cercare la MT e siamo a cavallo.<U+0010><U+0001>븀\nNiente proteste! È la legge del Clan Ruggine!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "Driiil!",
