    {
      "displayText": "E questa buca?! Chi è stato? Oh, se prendo\nil responsabile...!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 3,
