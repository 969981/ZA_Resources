      "rawDecodedUtf16Hex": "530555DAFF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "所以說，拜託讓狗仔包\n去散一下步吧！<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
