      "escapedControlUnits": 15,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 9280,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 77,
      "utf16Units": 153
    },
    {
      "displayText": "<U+0010><U+0006>！<U+0001><U+0002>育そだ育った<U+0010><U+0006>！<U+0001><U+0002>街まち街は<U+0010><U+0005>！<U+0001><U+0001>変か変わっていっても\nオレの<U+0010><U+0005>！<U+0001><U+0001>生い生き<U+0010><U+0006>！<U+0001><U+0002>様ざま様が<U+0010><U+0006>！<U+0001><U+0002>刻きざ刻まれてて<U+0010><U+0005>！<U+0001><U+0001>好す好きなんや<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 31,
