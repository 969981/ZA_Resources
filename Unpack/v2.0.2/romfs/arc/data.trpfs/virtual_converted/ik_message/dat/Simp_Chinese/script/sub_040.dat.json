      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "下雨的时候，\n水属性招式的威力会增强哦！<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
