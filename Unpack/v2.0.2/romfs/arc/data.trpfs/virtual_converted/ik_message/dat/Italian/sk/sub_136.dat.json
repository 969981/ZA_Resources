  "messages": [
    {
      "displayText": "Le opzioni 2 e 3 non sono male, ma credo che\nin questo caso funzioni meglio l’opzione 1.<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Io preferirei l’opzione 2. La 1 e la 3 mancano di\nmordente.<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "0049006F002000700072006500660065007200690072006500690020006C2019006F0070007A0069006F006E006500200032002E0020004C006100200031002000650020006C0061002000330020006D0061006E00630061006E006F002000640069000A006D006F007200640065006E00740065002E00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Per me la 3 è la migliore, ma vedo che non volete\nfare concessioni...<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "0050006500720020006D00650020006C006100200033002000E80020006C00610020006D00690067006C0069006F00720065002C0020006D00610020007600650064006F00200063006800650020006E006F006E00200076006F006C006500740065000A006600610072006500200063006F006E00630065007300730069006F006E0069002E002E002E00100002011401B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Potremmo chiedere il parere di quel<U+0010><U+0003>ᄀÿȀla giovane\nlaggiù, che ne pensate?<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Hai ragione! Noi tre da soli continueremmo a\ngirarci intorno in eterno...<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Ehi, tu, laggiù! Dico a te! Potresti darci una mano?<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "004500680069002C002000740075002C0020006C006100670067006900F900210020004400690063006F00200061002000740065002100200050006F00740072006500730074006900200064006100720063006900200075006E00610020006D0061006E006F003F00100002011401B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Il nome di questa strada non è male, ma non\nè molto memorabile...<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1396,
      "rawDecodedUtf16Hex": "0049006C0020006E006F006D0065002000640069002000710075006500730074006100200073007400720061006400610020006E006F006E002000E80020006D0061006C0065002C0020006D00610020006E006F006E000A00E80020006D006F006C0074006F0020006D0065006D006F0072006100620069006C0065002E002E002E00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Perciò abbiamo pensato di cambiarle nome per\nattirare l’attenzione del pubblico.<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Ed ecco perché ci serve la tua opinione. Il futuro\ndi questa città è dei giovani, del resto!<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Ecco i nuovi nomi a cui stavamo pensando.<U+0010><U+0002>ĔƲ",
