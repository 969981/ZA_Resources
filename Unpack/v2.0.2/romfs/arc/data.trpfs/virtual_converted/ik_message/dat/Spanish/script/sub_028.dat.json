      "rawDecodedUtf16Hex": "00440065006E006E0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "No sabes lo agradecida que estoy.\nPor fin voy a poder dormir por las noches.<U+0010><U+0002>ĔĿ",
