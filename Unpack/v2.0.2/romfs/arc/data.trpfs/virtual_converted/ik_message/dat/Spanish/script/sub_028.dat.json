      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "Ains, menudo susto nos ha dado. ¿Qué vamos\na hacer con este ladronzuelo de electricidad?<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3092,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
