    },
    {
      "displayText": "Hola, perdonaaa. Eres Entrenador<U+0010><U+0003>ᄀÿĀa, ¿verdad?\n¿Tienes un momentillo?<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Verás, es que últimamente los vecinos del bloque\nse quejan de que están pasando cosas extrañas.<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Estoy hablando de fenómenos que rozan\nlo paranormal.<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 648,
