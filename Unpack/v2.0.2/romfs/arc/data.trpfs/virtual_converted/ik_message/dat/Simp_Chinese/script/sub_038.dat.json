      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "你要是准备好打宝可梦对战了，\n就来跟我说一声吧！<U+0010><U+0002>ĔŇ",
      "escapedControlUnits": 2,
