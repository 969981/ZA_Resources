      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "771F768450477684FF1F00100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "壽司配咖啡？<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2524,
      "rawDecodedUtf16Hex": "58FD53F8914D54965561FF1F00100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "不愧是密阿雷，\n對美食充滿渴求的城市！<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "4E0D6127662F5BC6963F96F7FF0C000A5C0D7F8E98DF51456EFF6E346C42768457CE5E02FF0100100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我雖然沒有吃……\n但這個不能不發佈給全世界知道呀！<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "621196D671366C926709540320262026000A4F469019500B4E0D80FD4E0D767C4F487D6651684E16754C77E590535440FF0100100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "我是芭奧紅，\n在密阿雷遇上不得了的東西了！<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "6211662F82AD59677D05FF0C000A57285BC6963F96F790474E0A4E0D5F974E8676846771897F4E86FF0100100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "壽司＆咖啡將打開新世界！\n你也往羅雀咖啡館GO吧。<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 2708,
      "rawDecodedUtf16Hex": "58FD53F8FF06549655615C076253958B65B04E16754CFF01000A4F604E5F5F807F8596C05496556199280047004F5427300200100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "討厭！我又不小心發佈東西，\n帶給全世界影響了。<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 2768,
      "rawDecodedUtf16Hex": "8A0E53ADFF01621153C84E0D5C0F5FC3767C4F486771897FFF0C000A5E367D6651684E16754C5F7197FF4E86300200100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "就是這裡。\n剛才那個壽司＆咖啡的名店！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 2824,
      "rawDecodedUtf16Hex": "5C31662F901988E13002000A525B624D90A3500B58FD53F8FF06549655617684540D5E97FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "請給我壽司＆咖啡！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 2864,
      "rawDecodedUtf16Hex": "8ACB7D66621158FD53F8FF0654965561FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "壽司＆咖啡，\n簡稱「壽咖」一份！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 2884,
      "rawDecodedUtf16Hex": "58FD53F8FF0654965561FF0C000A7C217A31300C58FD5496300D4E004EFDFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "唉唷～！\n太忙我受不了啦！！<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "55095537FF5EFF01000A592A5FD9621153D74E0D4E865566FF01FF0100100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    }
