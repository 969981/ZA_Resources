      "rawDecodedUtf16Hex": "5E73633A59FF52E276847C737ACB9F8D20262026FF01000A7E3D4E4B653E9EDE4EC09EBC4E0A53BB597D50CF5C3180FD91CD73FEFF0C00100001BE00000A975E5E38670953C3800350F9503C300200100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "那個……也請給我看\n其他姿勢的米立龍。<U+0010><U+0002>ĔǞ",
