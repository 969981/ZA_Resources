      "trailingZeroPaddingUnits": 1,
      "utf16Units": 177
    },
    {
      "displayText": "Ven a hablar conmigo cuando estés list<U+0010><U+0003>ᄀÿāoa.\n¡Que no te dé miedo!<U+0010><U+0002>Ĕŏ",
      "escapedControlUnits": 4,
