      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "554AFF0C90A3500B20262026000A60A876849322597D50CF4E0D5920546230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "啊，那個……\n您的ＬＰ好像不夠呢。",
      "escapedControlUnits": 0,
