    },
    {
      "displayText": "Oh, I recognize you.<U+0010><U+0001>븁\nYou’re Emma’s assistant, aren’t you? I’ve seen\nyou working with her.<U+0010><U+0002>Ĕŷ",
      "escapedControlUnits": 4,
