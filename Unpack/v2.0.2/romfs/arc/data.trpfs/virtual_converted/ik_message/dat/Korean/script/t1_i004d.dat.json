  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "헤이! 어서 오세요!!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "D5E4C77400210020C5B4C11C0020C624C138C6940021002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "롤링, 롤링!\n모든 요리가 롤링!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 284,
      "rawDecodedUtf16Hex": "B864B9C1002C0020B864B9C10021000ABAA8B4E00020C694B9ACAC000020B864B9C100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "일부 재료는\n금방 상한다고 들었어",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "C77CBD800020C7ACB8CCB294000AAE08BC290020C0C1D55CB2E4ACE00020B4E4C5C8C5B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "급하게 먹었더니\n사레가 들렸어...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "AE09D558AC8C0020BA39C5C8B354B2C8000AC0ACB808AC000020B4E4B838C5B4002E002E002E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "이 가게의 요리는 먼 지방에서\n잡은 재료를 사용한다고 들었어.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 408,
      "rawDecodedUtf16Hex": "C7740020AC00AC8CC7580020C694B9ACB2940020BA3C0020C9C0BC29C5D0C11C000AC7A1C7400020C7ACB8CCB97C0020C0ACC6A9D55CB2E4ACE00020B4E4C5C8C5B4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "정말!? 굉장하다! 박학다식하네!!\n(아쥐르만에서 잡은 건데...)",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "C815B9D00021003F0020AD49C7A5D558B2E400210020BC15D559B2E4C2DDD558B12400210021000A0028C544C950B974B9CCC5D0C11C0020C7A1C7400020AC74B370002E002E002E00290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "롤링 드리머는\n승부도 기합이 바짝 들었거든",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "B864B9C10020B4DCB9ACBA38B294000AC2B9BD80B3C40020AE30D569C7740020BC14C9DD0020B4E4C5C8AC70B4E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "잘 모르겠는데\n이런 걸 정취 있다고 하는 거야?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 604,
      "rawDecodedUtf16Hex": "C7980020BAA8B974ACA0B294B370000AC774B7F00020AC780020C815CDE80020C788B2E4ACE00020D558B2940020AC70C57C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "손으로 먹을 거라면\n장인의 손길을 따라 해 보라고",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "C190C73CB85C0020BA39C7440020AC70B77CBA74000AC7A5C778C7580020C190AE38C7440020B530B77C0020D5740020BCF4B77CACE00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "캐주얼하게 즐길 수 있는\n초밥이라니 최고야!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "CE90C8FCC5BCD558AC8C0020C990AE380020C2180020C788B294000ACD08BC25C774B77CB2C80020CD5CACE0C57C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "무슨 일이 있었길래\n이런 식으로 먹게 된 걸까?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "BB34C2A80020C77CC7740020C788C5C8AE38B798000AC774B7F00020C2DDC73CB85C0020BA39AC8C0020B41C0020AC78AE4C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "알로라지방의 점포와는\n묘하게 맛이 다르네...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "C54CB85CB77CC9C0BC29C7580020C810D3ECC640B294000ABB18D558AC8C0020B9DBC7740020B2E4B974B124002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "이 아이는 나를 뛰어넘을 테니\n지금부터 미각을 단련시켜야지",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "C7740020C544C774B2940020B098B97C0020B6F0C5B4B118C7440020D14CB2C8000AC9C0AE08BD80D1300020BBF8AC01C7440020B2E8B828C2DCCF1CC57CC9C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "초밥을 만들 수 있는\n트레이너가 되는 것도 좋겠다!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "CD08BC25C7440020B9CCB4E40020C2180020C788B294000AD2B8B808C774B108AC000020B418B2940020AC83B3C40020C88BACA0B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "천천히 드시기 바랍니다",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1004,
      "rawDecodedUtf16Hex": "CC9CCC9CD7880020B4DCC2DCAE300020BC14B78DB2C8B2E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "롤링 드리머... 맛과 가격의 균형은\n적당하다고 봐야 하려나?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "B864B9C10020B4DCB9ACBA38002E002E002E0020B9DBACFC0020AC00ACA9C7580020ADE0D615C740000AC801B2F9D558B2E4ACE00020BD10C57C0020D558B824B098003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "롤 초밥...\n매혹적인 마리아주야...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "B8640020CD08BC25002E002E002E000AB9E4D639C801C7780020B9C8B9ACC544C8FCC57C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "미지의 식재료를 즐기는 여유야말로\n승부에도 필요한 것 아닐까?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "BBF8C9C0C7580020C2DDC7ACB8CCB97C0020C990AE30B2940020C5ECC720C57CB9D0B85C000AC2B9BD80C5D0B3C40020D544C694D55C0020AC830020C544B2D0AE4C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "그럼, 어떤 상대가 와도 당황하지 말고\n승부 그 자체를 즐기면 되는 거야.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1220,
      "rawDecodedUtf16Hex": "ADF8B7FC002C0020C5B4B5A40020C0C1B300AC000020C640B3C40020B2F9D669D558C9C00020B9D0ACE0000AC2B9BD800020ADF80020C790CCB4B97C0020C990AE30BA740020B418B2940020AC70C57C002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "메뉴는 무엇으로 할까요?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1304,
      "rawDecodedUtf16Hex": "BA54B274B2940020BB34C5C7C73CB85C0020D560AE4CC694003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "초밥이... 초밥이 저절로\n입안으로 들어오고 있어!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "CD08BC25C774002E002E002E0020CD08BC25C7740020C800C808B85C000AC785C548C73CB85C0020B4E4C5B4C624ACE00020C788C5B400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "초밥은 나도 모르게\n잔뜩 먹게 된단 말이지",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1392,
      "rawDecodedUtf16Hex": "CD08BC25C7400020B098B3C40020BAA8B974AC8C000AC794B7290020BA39AC8C0020B41CB2E80020B9D0C774C9C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "너무 많이 먹으면\n이따가 졸릴걸",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "B108BB340020B9CEC7740020BA39C73CBA74000AC774B530AC000020C878B9B4AC780000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "코가 찡한 느낌!\n이렇게 자극적일 수가!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "CF54AC000020CC21D55C0020B290B08C0021000AC774B807AC8C0020C790ADF9C801C77C0020C218AC00002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "와사비 때문이야\n팔데아에서는 소스로 먹는대",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1524,
      "rawDecodedUtf16Hex": "C640C0ACBE440020B54CBB38C774C57C000AD314B370C544C5D0C11CB2940020C18CC2A4B85C0020BA39B294B3000000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "도시에 포켓몬이 늘어났다는 건\n비즈니스 기회라고.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "B3C4C2DCC5D00020D3ECCF13BAACC7740020B298C5B4B0ACB2E4B2940020AC74000ABE44C988B2C8C2A40020AE30D68CB77CACE0002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "계약이 잘 성사된 기념으로\n먹으러 왔어요.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "ACC4C57DC7740020C7980020C131C0ACB41C0020AE30B150C73CB85C000ABA39C73CB7EC0020C654C5B4C694002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "롤링 드리머는\n해외에도 점포가 있답니다!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "B864B9C10020B4DCB9ACBA38B294000AD574C678C5D0B3C40020C810D3ECAC000020C788B2F5B2C8B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    }
