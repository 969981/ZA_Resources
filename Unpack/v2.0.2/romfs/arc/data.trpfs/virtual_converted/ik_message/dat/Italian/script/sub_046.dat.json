  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 380,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Ehm... Per caso hai bisogno di un taxi?<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 392,
      "rawDecodedUtf16Hex": "00450068006D002E002E002E00200050006500720020006300610073006F00200068006100690020006200690073006F0067006E006F00200064006900200075006E00200074006100780069003F001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Sai, sono appena diventata tassista e non ho\nancora fatto neanche una corsa...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Non è che devo far pratica, ma mi piacerebbe\nconsolidare la mia esperienza...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Quindi, guarda, non ti chiedo neanche di pagare.\nBasta che mi aiuti!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 812,
      "rawDecodedUtf16Hex": "005100750069006E00640069002C0020006700750061007200640061002C0020006E006F006E002000740069002000630068006900650064006F0020006E00650061006E0063006800650020006400690020007000610067006100720065002E000A0042006100730074006100200063006800650020006D00690020006100690075007400690021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Dai, facciamo così: chiamami come chiameresti\nun qualsiasi altro taxi!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 960,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vuoi salire sul mio taxi? Allora dove si va?<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "00560075006F0069002000730061006C006900720065002000730075006C0020006D0069006F00200074006100780069003F00200041006C006C006F0072006100200064006F00760065002000730069002000760061003F001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Sì, grazie!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1224,
      "rawDecodedUtf16Hex": "005300EC002C0020006700720061007A0069006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "No, grazie!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "004E006F002C0020006700720061007A0069006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Ma... Mi potresti anche fare questo favore, su!\nConsiderala una buona azione!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Grazie della fiducia! Sei <U+0010><U+0003>ᄀÿ؆il miola mia cliente numero uno!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "004700720061007A00690065002000640065006C006C00610020006600690064007500630069006100210020005300650069002000100003110000FF06060069006C0020006D0069006F006C00610020006D0069006100200063006C00690065006E007400650020006E0075006D00650072006F00200075006E006F0021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Centro Pokémon del Quartiere Rosa",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "00430065006E00740072006F00200050006F006B00E9006D006F006E002000640065006C002000510075006100720074006900650072006500200052006F007300610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Si potrebbe fare un altro posto? Non credo\ndi riuscire ad arrivare là senza perdermi.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "A-Allora si parte!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1820,
      "rawDecodedUtf16Hex": "0041002D0041006C006C006F007200610020007300690020007000610072007400650021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Il mio è un servizio taxi un po’ particolare, ha solo\nuna destinazione.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "C’è solo un tragitto che riesco a fare\nsenza perdermi... Scusa.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "0043201900E800200073006F006C006F00200075006E00200074007200610067006900740074006F0020006300680065002000720069006500730063006F0020006100200066006100720065000A00730065006E007A00610020007000650072006400650072006D0069002E002E002E002000530063007500730061002E001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Hai presente la crostata alle fragole che fanno\nal Caffè io&te? A me piace tantissimo.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Ah, chiedo scusa. Sto parlando di cose personali,\ndi sicuro non ti interessano.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ultimamente è più difficile guidare i taxi,\ncon tutti questi Pokémon selvatici in città.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Strano che mi sia ritrovata a fare l’Autista\nnonostante tutto, vero?<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 8,
      "index": 21,
      "offsetInSection": 2708,
      "rawDecodedUtf16Hex": "0053007400720061006E006F00200063006800650020006D0069002000730069006100200072006900740072006F007600610074006100200061002000660061007200650020006C20190041007500740069007300740061000A006E006F006E006F007300740061006E0074006500200074007500740074006F002C0020007600650072006F003F001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "AH!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2856,
      "rawDecodedUtf16Hex": "004100480021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Ho sbagliato strada, faccio inversione. Scusa...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "0048006F00200073006200610067006C006900610074006F0020007300740072006100640061002C002000660061006300630069006F00200069006E00760065007200730069006F006E0065002E002000530063007500730061002E002E002E001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Dicevamo... Strano che abbia deciso comunque\ndi diventare un’Autista, vero?<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "AH!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 3140,
      "rawDecodedUtf16Hex": "004100480021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Siamo arrivat<U+0010><U+0003>ᄀÿāie! Eccoci al Centro Pokémon\ndel Quartiere Rosa. Come promesso, la corsa<U+0010><U+0001>븀\nè in omaggio.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Grazie mille!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3380,
      "rawDecodedUtf16Hex": "004700720061007A006900650020006D0069006C006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Vorrei pagare lo stesso...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3408,
      "rawDecodedUtf16Hex": "0056006F007200720065006900200070006100670061007200650020006C006F002000730074006500730073006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Grazie a te, è stato un piacere averti a bordo!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3464,
      "rawDecodedUtf16Hex": "004700720061007A0069006500200061002000740065002C002000E800200073007400610074006F00200075006E0020007000690061006300650072006500200061007600650072007400690020006100200062006F00720064006F0021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ma... Ehm... Se proprio insisti...\nAllora sarebbero 710 <U+E300>, grazie.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3568,
      "rawDecodedUtf16Hex": "004D0061002E002E002E002000450068006D002E002E002E002000530065002000700072006F007000720069006F00200069006E00730069007300740069002E002E002E000A0041006C006C006F00720061002000730061007200650062006200650072006F00200037003100300020E300002C0020006700720061007A00690065002E001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Ma... Ehm... Se proprio insisti...\nAllora sarebbero 710 <U+E300>, grazie.<U+0010><U+0001>븁\nPerò... Ecco... Non mi sembra tu li abbia...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3952,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "La corsa con te mi ha fatto capire che non sono\nancora pronta per questo lavoro.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Mi sono persa sia a guidare, sia a chiacchierare,\ne ti ho messo a disagio.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Però almeno nelle lotte Pokémon sono sicura\ndi me! Affrontami, per piacere!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Per favore, cliente numero uno! Lotta con me!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4456,
      "rawDecodedUtf16Hex": "0050006500720020006600610076006F00720065002C00200063006C00690065006E007400650020006E0075006D00650072006F00200075006E006F00210020004C006F00740074006100200063006F006E0020006D00650021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Va bene!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4556,
      "rawDecodedUtf16Hex": "00560061002000620065006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Meglio di no...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4576,
      "rawDecodedUtf16Hex": "004D00650067006C0069006F0020006400690020006E006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Vorrei mostrarti che almeno in qualcosa\nsono brava!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4608,
      "rawDecodedUtf16Hex": "0056006F00720072006500690020006D006F0073007400720061007200740069002000630068006500200061006C006D0065006E006F00200069006E0020007100750061006C0063006F00730061000A0073006F006E006F0020006200720061007600610021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Dai, lotta con me! Così posso farti vedere\ni miei punti di forza!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4720,
      "rawDecodedUtf16Hex": "004400610069002C0020006C006F00740074006100200063006F006E0020006D0065002100200043006F007300EC00200070006F00730073006F0020006600610072007400690020007600650064006500720065000A00690020006D006900650069002000700075006E0074006900200064006900200066006F0072007A00610021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "<U+0010><U+0002>뷿)",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4860,
      "rawDecodedUtf16Hex": "00100002BDFF00290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Non sono tagliata neanche per le lotte...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4872,
      "rawDecodedUtf16Hex": "004E006F006E00200073006F006E006F0020007400610067006C00690061007400610020006E00650061006E00630068006500200070006500720020006C00650020006C006F007400740065002E002E002E001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Però mi sono divertita a lottare con te, anche\nse ho perso!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4964,
      "rawDecodedUtf16Hex": "00500065007200F20020006D006900200073006F006E006F0020006400690076006500720074006900740061002000610020006C006F0074007400610072006500200063006F006E002000740065002C00200061006E006300680065000A0073006500200068006F00200070006500720073006F0021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Di lotte ne ho fatte così tante che una sconfitta\nnon basta a farmi perdere la fiducia in me stessa.<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5092,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Forse se continuo a fare la tassista riuscirò a\nessere un po’ più sicura di me anche in questo<U+0010><U+0001>븀\ncampo! Certo, se non mi licenziano prima...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5304,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 146
    },
    {
      "displayText": "Grazie ancora per oggi. Sei sempre <U+0010><U+0003>ᄀÿȂilla cliente\nnumero uno!<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5596,
      "rawDecodedUtf16Hex": "004700720061007A0069006500200061006E0063006F0072006100200070006500720020006F006700670069002E0020005300650069002000730065006D007000720065002000100003110000FF02020069006C006C006100200063006C00690065006E00740065000A006E0075006D00650072006F00200075006E006F0021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    }
