      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "火狐狸一定感受到\n你为它付出的努力了～<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "706B72D072F84E005B9A611F53D75230000A4F604E3A5B834ED851FA768452AA529B4E86FF5E00100002011401880000",
