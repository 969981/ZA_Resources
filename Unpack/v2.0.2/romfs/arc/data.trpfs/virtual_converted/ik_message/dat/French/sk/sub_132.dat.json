      "rawDecodedUtf16Hex": "004800E90020002100200043201900650073007400200074006F006900200010000201000000002C0020007000610073002000760072006100690020003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Narica vient de poster une photo incroyable !\nJe suis trop trop trop fan ! Regarde !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Elle est pas trop cool avec son Ohmassacre sur\nce banc ? Moi j’adore ! C’est trop beau !!!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "J’aimerais TROP prendre une photo sur le même\nbanc avec mon Élecsprint !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Bon, je crois que tu devines déjà ce que j’aimerais\nque tu fasses...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "0042006F006E002C0020006A0065002000630072006F00690073002000710075006500200074007500200064006500760069006E006500730020006400E9006A00E000200063006500200071007500650020006A201900610069006D00650072006100690073000A0071007500650020007400750020006600610073007300650073002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Trouve le banc où elle a pris cette photo,\ns’il te plaît !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "00540072006F0075007600650020006C0065002000620061006E00630020006F00F900200065006C006C00650020006100200070007200690073002000630065007400740065002000700068006F0074006F002C000A007320190069006C00200074006500200070006C006100EE00740020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Spriprint !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "0053007000720069007000720069006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tu veux revoir la photo du banc ?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "00540075002000760065007500780020007200650076006F006900720020006C0061002000700068006F0074006F002000640075002000620061006E00630020003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Oui, s’il te plaît.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "004F00750069002C0020007320190069006C00200074006500200070006C006100EE0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Pas besoin !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "0050006100730020006200650073006F0069006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "La voici !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1396,
      "rawDecodedUtf16Hex": "004C006100200076006F0069006300690020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "J’espère que tu trouveras le banc\nqu’on voit sur la photo !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "004A201900650073007000E8007200650020007100750065002000740075002000740072006F0075007600650072006100730020006C0065002000620061006E0063000A007100752019006F006E00200076006F0069007400200073007500720020006C0061002000700068006F0074006F0020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1556,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vous avez trouvé le banc que cherchait Sassize !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "0056006F007500730020006100760065007A002000740072006F0075007600E90020006C0065002000620061006E006300200071007500650020006300680065007200630068006100690074002000530061007300730069007A0065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Les deux pots de fleurs ! Les bâtiments à l’arrière !\nEt les montagnes ! Tout y est !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "C’est ici que Narica a pris sa photo, c’est sûr !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "00432019006500730074002000690063006900200071007500650020004E006100720069006300610020006100200070007200690073002000730061002000700068006F0074006F002C0020006320190065007300740020007300FB00720020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "C’est parti, pas de temps à perdre !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "00432019006500730074002000700061007200740069002C0020007000610073002000640065002000740065006D00700073002000E000200070006500720064007200650020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Je m’assieds exactement là où Narica se trouvait !\nJe deviens Narica ! Je suis la vraie Narica !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Est-ce que tu peux me prendre en photo ?\nIl faut qu’elle soit comme celle de Narica !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Il faut que l’angle de la photo soit EXACTEMENT\nle même !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "0049006C0020006600610075007400200071007500650020006C20190061006E0067006C00650020006400650020006C0061002000700068006F0074006F00200073006F006900740020004500580041004300540045004D0045004E0054000A006C00650020006D00EA006D00650020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Si tu veux revoir la photo originale, demande-moi.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "00530069002000740075002000760065007500780020007200650076006F006900720020006C0061002000700068006F0074006F0020006F0072006900670069006E0061006C0065002C002000640065006D0061006E00640065002D006D006F0069002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Tu veux jeter un œil à la photo de Narica ?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "00540075002000760065007500780020006A006500740065007200200075006E002001530069006C002000E00020006C0061002000700068006F0074006F0020006400650020004E006100720069006300610020003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Je veux bien, oui !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "004A0065002000760065007500780020006200690065006E002C0020006F007500690020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "C’est bon, je gère.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "0043201900650073007400200062006F006E002C0020006A00650020006700E800720065002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Prends la photo de la MÊME façon !\nÉloigne-toi un peu plus du banc !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2852,
      "rawDecodedUtf16Hex": "005000720065006E006400730020006C0061002000700068006F0074006F0020006400650020006C00610020004D00CA004D004500200066006100E7006F006E00200021000A00C9006C006F00690067006E0065002D0074006F006900200075006E002000700065007500200070006C00750073002000640075002000620061006E00630020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3000,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bien, bien ! Par là, ça devrait aller...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3012,
      "rawDecodedUtf16Hex": "004200690065006E002C0020006200690065006E0020002100200050006100720020006C00E0002C002000E700610020006400650076007200610069007400200061006C006C00650072002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "... ou pas.<U+0010><U+0001>븁\nJ’ai l’impression que c’est pas le bon angle...\nJe veux EXACTEMENT la même photo !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3308,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "LÀ ! C’est parfait !\nPrends la photo de là où t’es !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3320,
      "rawDecodedUtf16Hex": "004C00C0002000210020004320190065007300740020007000610072006600610069007400200021000A005000720065006E006400730020006C0061002000700068006F0074006F0020006400650020006C00E00020006F00F9002000742019006500730020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Super ! Fais voir, il faut que je vérifie...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3436,
      "rawDecodedUtf16Hex": "00530075007000650072002000210020004600610069007300200076006F00690072002C00200069006C0020006600610075007400200071007500650020006A00650020007600E900720069006600690065002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Excellent ! On dirait la même !\nC’est comme si j’étais devenue Narica !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 3536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Vite, je vais la poster sur les réseaux !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "0056006900740065002C0020006A0065002000760061006900730020006C006100200070006F007300740065007200200073007500720020006C006500730020007200E9007300650061007500780020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Je me demande si le photographe de Narica,\nc’est le producteur dont tout le monde parle...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3780,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Il pourrait pas sortir plus de produits dérivés ?<U+0010><U+0001>븁\nLes Pains Narica, c’est cool, mais moi,\nje veux des figurines ou des porte-clés !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 3972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "Un jour, peut-être... Je peux toujours rêver !<U+0010><U+0001>븁\nBon, j’ai d’autres photos de Narica à recréer.\nC’est pour ça que je suis venue à Illumis !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "Merci de ton aide, <U+0010><U+0002>Ā<U+0000> !<U+0010><U+0001>븁\nT’as dû galérer pour trouver ce banc.\nTu devrais t’asseoir et te reposer un peu !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4544,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "Bye !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4776,
      "rawDecodedUtf16Hex": "0042007900650020002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4796,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Pour la prochaine photo, ça serait génial que je\ntrouve l’endroit où Narica a organisé le Nari-Quiz !<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
