  "messages": [
    {
      "displayText": "Hé ! C’est toi <U+0010><U+0002>Ā<U+0000>, pas vrai ?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
