      "rawDecodedUtf16Hex": "004E006F00200063006F006E006F007A0063006F002000610020006500730074006500200047006F006F006D00790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Tampoco pasaría nada si fuera tuyo, ¿eh?\nSolo quiero saber qué ha pasado.<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "¡Goomy!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
