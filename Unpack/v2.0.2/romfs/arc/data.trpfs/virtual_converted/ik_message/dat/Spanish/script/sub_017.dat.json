      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "004200750065006E006F002C0020007400690065006E0065002000730065006E007400690064006F002E002E002E001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
