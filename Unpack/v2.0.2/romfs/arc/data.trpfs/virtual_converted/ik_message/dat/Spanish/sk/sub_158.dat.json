      "offsetInSection": 524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "¡Siendo tan grande, a ver quién lo mueve de ahí!<U+0010><U+0002>Ĕǅ",
