  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Hier im Restaurant de Luxe gibt’s\nfür unsere Gäste nur das Beste!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "004800690065007200200069006D002000520065007300740061007500720061006E00740020006400650020004C0075007800650020006700690062007420190073000A006600FC007200200075006E00730065007200650020004700E40073007400650020006E00750072002000640061007300200042006500730074006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Probieren Sie unser\nexquisites Kampf-Menü!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "00500072006F00620069006500720065006E002000530069006500200075006E007300650072000A00650078007100750069007300690074006500730020004B0061006D00700066002D004D0065006E00FC002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Reinster Luxus hier im\nRestaurant de Luxe.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 460,
      "rawDecodedUtf16Hex": "005200650069006E00730074006500720020004C00750078007500730020006800690065007200200069006D000A00520065007300740061007500720061006E00740020006400650020004C007500780065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Dass ich so einen Geschmack\nselbst erleben darf...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "0044006100730073002000690063006800200073006F002000650069006E0065006E002000470065007300630068006D00610063006B000A00730065006C006200730074002000650072006C006500620065006E00200064006100720066002E002E002E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Hoffentlich findest du\neine gute Lösung.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "0048006F006600660065006E0074006C006900630068002000660069006E0064006500730074002000640075000A00650069006E0065002000670075007400650020004C00F600730075006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Hunger trübt die Sinne. Nach dem\nEssen entscheidet es sich besser.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "00480075006E00670065007200200074007200FC006200740020006400690065002000530069006E006E0065002E0020004E006100630068002000640065006D000A0045007300730065006E00200065006E007400730063006800650069006400650074002000650073002000730069006300680020006200650073007300650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Tja, in der Welt der Kämpfe\nist nichts garantiert.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "0054006A0061002C00200069006E0020006400650072002000570065006C007400200064006500720020004B00E4006D007000660065000A0069007300740020006E0069006300680074007300200067006100720061006E00740069006500720074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Du und deine Pokémon\nsind echt total cool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 976,
      "rawDecodedUtf16Hex": "0044007500200075006E00640020006400650069006E006500200050006F006B00E9006D006F006E000A00730069006E00640020006500630068007400200074006F00740061006C00200063006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Kommt man als Pokémon-Trainerin\ndenn über die Runden?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "004B006F006D006D00740020006D0061006E00200061006C007300200050006F006B00E9006D006F006E002D0054007200610069006E006500720069006E000A00640065006E006E002000FC0062006500720020006400690065002000520075006E00640065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Du bist der Allerbeste!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1172,
      "rawDecodedUtf16Hex": "0044007500200062006900730074002000640065007200200041006C006C0065007200620065007300740065002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Die nervigen Leute in meiner Firma würde ich am\nliebsten in einem Pokémon-Kampf wegfegen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Ja, oder?! Geht mir auch so.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "004A0061002C0020006F006400650072003F0021002000470065006800740020006D006900720020006100750063006800200073006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Die Crème Brulée hier ist wirklich\ndie absolute Crème de la Crème!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1464,
      "rawDecodedUtf16Hex": "00440069006500200043007200E8006D00650020004200720075006C00E900650020006800690065007200200069007300740020007700690072006B006C006900630068000A0064006900650020006100620073006F006C00750074006500200043007200E8006D00650020006400650020006C006100200043007200E8006D006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Und der karamellisierte Zucker\nobendrauf... Wahre Kunst!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "0055006E006400200064006500720020006B006100720061006D0065006C006C00690073006900650072007400650020005A00750063006B00650072000A006F00620065006E00640072006100750066002E002E002E0020005700610068007200650020004B0075006E0073007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Restaurants, in denen sich Pokémon-Trainer und\nFeinschmecker versammeln, sind schon toll!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Christophé, der Besitzer, hat den Laden zur\nVerfeinerung von sowohl Pokémon-Kämpfen als<U+0010><U+0001>븀\nauch Speisen eröffnet.<U+0010><U+0001>븁\nWenn ich so drüber nachdenke, erschließt sich\nmir der Sinn nicht so ganz...",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 193
    },
    {
      "displayText": "Unsere Kreationen werden stets auf den Punkt\nserviert.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "0055006E00730065007200650020004B00720065006100740069006F006E0065006E002000770065007200640065006E0020007300740065007400730020006100750066002000640065006E002000500075006E006B0074000A00730065007200760069006500720074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Hast du nach dem Essen Lust auf\neinen Pokémon-Kampf?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2396,
      "rawDecodedUtf16Hex": "00480061007300740020006400750020006E006100630068002000640065006D00200045007300730065006E0020004C0075007300740020006100750066000A00650069006E0065006E00200050006F006B00E9006D006F006E002D004B0061006D00700066003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Gerne! Durch einen Kampf lernt\nman sich doch am besten kennen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "004700650072006E00650021002000440075007200630068002000650069006E0065006E0020004B0061006D007000660020006C00650072006E0074000A006D0061006E0020007300690063006800200064006F0063006800200061006D002000620065007300740065006E0020006B0065006E006E0065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ich habe mein Pokémon trainiert,\nfeinste Desserts wertzuschätzen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2632,
      "rawDecodedUtf16Hex": "004900630068002000680061006200650020006D00650069006E00200050006F006B00E9006D006F006E00200074007200610069006E0069006500720074002C000A006600650069006E00730074006500200044006500730073006500720074007300200077006500720074007A007500730063006800E40074007A0065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Ich hab heute zu viel geschleppt,\ndeshalb gibt’s jetzt ’ne Belohnung.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2764,
      "rawDecodedUtf16Hex": "00490063006800200068006100620020006800650075007400650020007A00750020007600690065006C002000670065007300630068006C0065007000700074002C000A00640065007300680061006C006200200067006900620074201900730020006A00650074007A007400202019006E0065002000420065006C006F0068006E0075006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Meine Gedanken kreisen nur\num meine Mittagspause.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2904,
      "rawDecodedUtf16Hex": "004D00650069006E006500200047006500640061006E006B0065006E0020006B00720065006900730065006E0020006E00750072000A0075006D0020006D00650069006E00650020004D00690074007400610067007300700061007500730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Es ist wichtig, schon in jungen Jahren zu lernen,\nwas Qualität ist. Greif ganz ungeniert zu.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3004,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Beim Essen ist wichtig, mit wem man isst. Da ist\nder Laden egal, solange es nicht eklig schmeckt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Wenn man erst mal hier gegessen hat, schmeckt\nes einem nirgendwo anders mehr.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Wer die Küche von Restaurant de Luxe erlebt hat,\nweiß eben, was gute Gerichte ausmacht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3544,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    }
  ],
