      "rawDecodedUtf16Hex": "304430447D508AD6304C3067308B306830443044308F306D0000000000000000000000000000000000000000000000000000",
      "trailingZeroPaddingUnits": 13,
      "utf16Units": 25
    },
    {
      "displayText": "空腹だと判断を誤るからね\n最高の料理で満たさないと",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 688,
