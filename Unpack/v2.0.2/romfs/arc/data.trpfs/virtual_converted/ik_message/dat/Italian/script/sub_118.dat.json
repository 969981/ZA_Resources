      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0003>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "00100002BDFF00030000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Grazie di essere venut<U+0010><U+0003>ᄀÿāoa.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "004700720061007A006900650020006400690020006500730073006500720065002000760065006E0075007400100003110000FF0101006F0061002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Sai perché ti ho chiamato?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "00530061006900200070006500720063006800E900200074006900200068006F00200063006800690061006D00610074006F003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Non ne ho idea",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "004E006F006E0020006E006500200068006F002000690064006500610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Se me lo dici si fa prima",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "005300650020006D00650020006C006F002000640069006300690020007300690020006600610020007000720069006D00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Beh, un po’ di interesse potevi mostrarlo!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "004200650068002C00200075006E00200070006F201900200064006900200069006E007400650072006500730073006500200070006F00740065007600690020006D006F00730074007200610072006C006F002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ma sorvoliamo... inutile prendersela. Dunque,\nil mio predecessore mi ha lasciato un compito.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Mi ha chiesto di affidare i suoi Pokémon a degli\nAllenatori interessanti, qualora mi fosse capitato<U+0010><U+0001>븀\ndi incontrarne.<U+0010><U+0001>븁\nE tu per me in effetti sei un<U+0010><U+0003>ᄀÿଊ Allenator’Allenatrice\ninteressante.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 197
    },
    {
      "displayText": "Però mi sembra che al momento tu non possa\nricevere dei Pokémon.<U+0010><U+0001>븁\nFai spazio nei tuoi box e poi torna da me.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "Pokémon, fatevi avanti.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "0050006F006B00E9006D006F006E002C00200066006100740065007600690020006100760061006E00740069002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Su, scegline uno!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "00530075002C00200073006300650067006C0069006E006500200075006E006F002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Questo è Charmander, un Pokémon di tipo Fuoco.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "00510075006500730074006F002000E800200043006800610072006D0061006E006400650072002C00200075006E00200050006F006B00E9006D006F006E0020006400690020007400690070006F002000460075006F0063006F002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Questo è Squirtle, un Pokémon di tipo Acqua.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1788,
      "rawDecodedUtf16Hex": "00510075006500730074006F002000E80020005300710075006900720074006C0065002C00200075006E00200050006F006B00E9006D006F006E0020006400690020007400690070006F002000410063007100750061002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Questo è Bulbasaur, un Pokémon di tipo Erba.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1888,
      "rawDecodedUtf16Hex": "00510075006500730074006F002000E8002000420075006C006200610073006100750072002C00200075006E00200050006F006B00E9006D006F006E0020006400690020007400690070006F00200045007200620061002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Ti ho detto di scegliere un Pokémon!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "0054006900200068006F00200064006500740074006F00200064006900200073006300650067006C006900650072006500200075006E00200050006F006B00E9006D006F006E002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Vuoi <U+0010><U+0002>ā<U+0002>?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 18,
