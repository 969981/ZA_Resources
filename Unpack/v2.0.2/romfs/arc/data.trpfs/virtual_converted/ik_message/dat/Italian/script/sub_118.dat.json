      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Quando hai tempo, passa al Laboratorio\nPokémon.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 328,
