      "rawDecodedUtf16Hex": "00560075006F006900200010000201010002003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Sì!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2104,
      "rawDecodedUtf16Hex": "005300EC00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Aspetta...",
