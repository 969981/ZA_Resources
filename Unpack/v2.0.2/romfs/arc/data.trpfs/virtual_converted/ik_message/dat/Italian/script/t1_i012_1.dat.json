      "flagsUpper16": 8,
      "index": 9,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "0053007400610072006500200069006E00200068006F00740065006C00200070007500F200200061006E0063006800650020006500730073006500720065000A0075006E00610020007300630065006C00740061002000640069002000760069007400610020006D0069006E0069006D0061006C0069007300740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Benvenut<U+0010><U+0003>ᄀÿāoa al Grand Hotel\nFior di Quattrini!",
