      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "0049002000670069006F0072006E006900200073006F006E006F0020007100750065006C006C0069002000630068006500200073006F006E006F002E000A004E006F006E00200070006F0073007300690061006D006F0020006600610072006500200074007500740074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "I miei amici mi hanno dato una\nlista di cose da comprare.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "00490020006D00690065006900200061006D0069006300690020006D0069002000680061006E006E006F0020006400610074006F00200075006E0061000A006C006900730074006100200064006900200063006F0073006500200064006100200063006F006D00700072006100720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Dai, imbuchiamoci\nalla festa dei MLL!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "004400610069002C00200069006D006200750063006800690061006D006F00630069000A0061006C006C006100200066006500730074006100200064006500690020004D004C004C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Meglio di no, quella tipa fa troppo\npaura. Se ci becca, sono guai.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2572,
      "rawDecodedUtf16Hex": "004D00650067006C0069006F0020006400690020006E006F002C0020007100750065006C006C006100200074006900700061002000660061002000740072006F00700070006F000A00700061007500720061002E002000530065002000630069002000620065006300630061002C00200073006F006E006F00200067007500610069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Hai deciso come allenare il Pokémon di punta\ndella tua prossima squadra?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2708,
      "rawDecodedUtf16Hex": "004800610069002000640065006300690073006F00200063006F006D006500200061006C006C0065006E00610072006500200069006C00200050006F006B00E9006D006F006E002000640069002000700075006E00740061000A00640065006C006C00610020007400750061002000700072006F007300730069006D006100200073007100750061006400720061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Non ancora...<U+0010><U+0001>븁\nNon so se puntare sulla versatilità o se renderlo\nefficace contro un tipo in particolare.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
