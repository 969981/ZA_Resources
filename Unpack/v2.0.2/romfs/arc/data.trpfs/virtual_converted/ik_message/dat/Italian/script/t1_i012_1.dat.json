      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "00420065006E00760065006E0075007400100003110000FF0101006F006100200061006C0020004700720061006E006400200048006F00740065006C000A00460069006F007200200064006900200051007500610074007400720069006E006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
