      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 3072,
      "rawDecodedUtf16Hex": "0049006C0020006300690062006F002000E800200065006300630065006C006C0065006E0074006500200063006F006D006500200061006C00200073006F006C00690074006F0021000A00490020006D00690065006900200063006F006D0070006C0069006D0065006E0074006900200061006C006C006F00200063006800650066002E0000",
      "trailingZeroPaddingUnits": 1,
