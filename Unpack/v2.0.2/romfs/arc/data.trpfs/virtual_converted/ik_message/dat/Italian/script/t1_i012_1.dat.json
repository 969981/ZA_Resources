      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "0056006F00720072006500690020006600610072006500200075006E00200070006F2019002000640069002000740075007200690073006D006F000A00630075006C0069006E006100720069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Io vorrei catturare dei Pokémon.\nSiamo o non siamo a Luminopoli?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2132,
      "rawDecodedUtf16Hex": "0049006F00200076006F00720072006500690020006300610074007400750072006100720065002000640065006900200050006F006B00E9006D006F006E002E000A005300690061006D006F0020006F0020006E006F006E0020007300690061006D006F002000610020004C0075006D0069006E006F0070006F006C0069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
