  "messages": [
    {
      "displayText": "那邊那位訓練家，\n可以請<U+0010><U+0003>ᄀÿā你妳幫我一個小忙嗎？<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 4,
