      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "我要哞哞鮮奶……\n不對不對！還是果汁牛奶好了！<U+0010><U+0002>Ĕ#",
      "escapedControlUnits": 2,
