      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "0054006800650065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Il modo migliore per impararla sarebbe osservare\nun professionista in azione.<U+0010><U+0002>Ĕł",
