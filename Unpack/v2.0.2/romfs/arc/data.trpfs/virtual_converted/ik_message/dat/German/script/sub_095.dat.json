      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1380,
      "rawDecodedUtf16Hex": "0049006E002000520075006800650020006C0061007300730065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
