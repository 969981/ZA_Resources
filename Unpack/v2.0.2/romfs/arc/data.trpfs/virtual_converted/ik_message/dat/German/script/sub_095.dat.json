    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1432,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vielen Dank, dass du die Bithora verscheucht\nhast!<U+0010><U+0002>ĔŸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1444,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B002C00200064006100730073002000640075002000640069006500200042006900740068006F00720061002000760065007200730063006800650075006300680074000A0068006100730074002100100002011401780000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "W-Was zum...?! Die tummeln sich ja schon\nwieder vor meinem Boot!<U+0010><U+0002>ĔŸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1556,
      "rawDecodedUtf16Hex": "0057002D0057006100730020007A0075006D002E002E002E003F00210020004400690065002000740075006D006D0065006C006E002000730069006300680020006A00610020007300630068006F006E000A00770069006500640065007200200076006F00720020006D00650069006E0065006D00200042006F006F0074002100100002011401780000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Das Boot ist MEIN ganzer Stolz, versteht ihr?\nDas ist nicht für euch gedacht!<U+0010><U+0002>ĔŸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Moment... Kann es sein, dass ihr auch gerne\nmal ’ne Runde damit drehen würdet...?<U+0010><U+0002>ĔŸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1860,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Bi! Bi! Thoooora!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "0042006900210020004200690021002000540068006F006F006F006F00720061002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Na, das lässt sich einrichten! Ich bereite schnell\nalles für unsere Bootstour vor.<U+0010><U+0002>ĔŸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Dann steigt mal alle ein, meine kleinen Bithora!\nHopp, hopp!<U+0010><U+0002>ĔŸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2248,
      "rawDecodedUtf16Hex": "00440061006E006E00200073007400650069006700740020006D0061006C00200061006C006C0065002000650069006E002C0020006D00650069006E00650020006B006C00650069006E0065006E00200042006900740068006F007200610021000A0048006F00700070002C00200068006F00700070002100100002011401780000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
