      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "파르토가 판 구멍은\n네가 싸우는 동안 내가 메워 뒀어.<U+0010><U+0002>ĔŖ",
      "escapedControlUnits": 2,
