      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "下次要不就去找卡娜莉小姐举办\n问答大赛的地方，然后在那里拍照吧！<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "4E0B6B2189814E0D5C3153BB627E53615A1C83895C0F59D04E3E529E000A95EE7B5459278D5B7684573065B9FF0C7136540E572890A391CC62CD71675427FF0100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
