  "initialKey": 0,
  "messages": [
    {
      "displayText": "你就是<U+0010><U+0002>Ā<U+0000>吧？<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 0,
