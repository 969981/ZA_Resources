      "rawDecodedUtf16Hex": "67094E005929FF0C751F6D3B57287F8E9E9768EE679788E176840010000201020002000A5FFD71366D6E73FE4E864E00500B5FF5982D2026202600100001BE00000A62114E5F60F389818D857D1A90325316300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "於是為了要尋找超級石，\n<U+0010><U+0002>Ă<U+0002>決定帶著<U+0010><U+0002>Ā<U+0000>，<U+0010><U+0001>븀\n一路前往精練之塔。<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "65BC662F70BA4E8689815C0B627E8D857D1A77F3FF0C000A00100002010200026C7A5B9A5E3684570010000201000000FF0C00100001BE00000A4E008DEF524D5F807CBE7DF44E4B5854300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "不料，持有超級石的<U+0010><U+0002>Ă<U+0004>出現在\n<U+0010><U+0002>Ă<U+0002>與<U+0010><U+0002>Ā<U+0000>的面前。<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2800,
      "rawDecodedUtf16Hex": "4E0D6599FF0C630167098D857D1A77F37684001000020102000451FA73FE5728000A00100002010200028207001000020100000076849762524D300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "並且挑釁說，要是能拿出真本事戰勝自己，\n就願意奉上超級石。<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "4E264E14631191C18AAAFF0C8981662F80FD62FF51FA771F672C4E8B623052DD81EA5DF1FF0C000A5C319858610F59494E0A8D857D1A77F3300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "<U+0010><U+0002>Ă<U+0002>決定與對方槓上，\n於是派出了<U+0010><U+0002>Ā<U+0000>對戰。<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2940,
      "rawDecodedUtf16Hex": "00100002010200026C7A5B9A82075C0D65B969D34E0AFF0C000A65BC662F6D3E51FA4E8600100002010000005C0D6230300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "這時出現的是想從旁搶走超級石的\n<U+0010><U+0002>Ă<U+0003>！<U+0010><U+0001>븀\n牠朝著大家使出了噴射火焰！<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 3000,
      "rawDecodedUtf16Hex": "9019664251FA73FE7684662F60F35F9E65C164368D708D857D1A77F37684000A0010000201020003FF0100100001BE00000A7260671D845759275BB64F7F51FA4E8656745C04706B7130FF0100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>一邊保護<U+0010><U+0002>Ă<U+0002>，\n一邊撐過了噴射火焰，並且……<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 3088,
      "rawDecodedUtf16Hex": "00100002010000004E00908A4FDD8B770010000201020002FF0C000A4E00908A6490904E4E8656745C04706B7130FF0C4E264E142026202600100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "一把將<U+0010><U+0002>Ă<U+0003>與<U+0010><U+0002>Ă<U+0004>\n扔進了卡洛斯的海神之穴！<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 3156,
      "rawDecodedUtf16Hex": "4E00628A5C07001000020102000382070010000201020004000A625490324E8653616D1B65AF76846D77795E4E4B7A74FF0100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "掌管超級進化的<U+0010><U+0002>Ƌ<U+0001>\n目睹了整段經過。<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 3216,
      "rawDecodedUtf16Hex": "638C7BA18D857D1A90325316768400100002018B0001000A76EE77794E8665746BB57D93904E300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā她他不僅認同了<U+0010><U+0002>Ā<U+0000>的實力，\n竟然還賜與了<U+0010><U+0003>ᄀÿā他她超級進化的樣子！<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 3268,
      "rawDecodedUtf16Hex": "00100003110000FF010159794ED64E0D50C58A8D540C4E86001000020100000076845BE6529BFF0C000A7ADF713690848CDC82074E8600100003110000FF01014ED659798D857D1A9032531676846A235B50FF0100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "這可是人類首開先例的超級進化啊！<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 3364,
      "rawDecodedUtf16Hex": "901953EF662F4EBA985E9996958B51484F8B76848D857D1A90325316554AFF0100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "見到這一幕的<U+0010><U+0002>Ă<U+0002>\n相信一切皆有可能，再次下定決心……<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 3408,
      "rawDecodedUtf16Hex": "898B523090194E005E5576840010000201020002000A76F84FE14E0052077686670953EF80FDFF0C518D6B214E0B5B9A6C7A5FC32026202600100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "一定要去找到自己專用的超級石，\n也就是<U+0010><U+0002>Ă<U+0002>進化石！<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 3476,
      "rawDecodedUtf16Hex": "4E005B9A898153BB627E523081EA5DF15C08752876848D857D1A77F3FF0C000A4E5F5C31662F00100002010200029032531677F3FF0100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "哎呀～\n這肯定會是個出色的故事。<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 3540,
      "rawDecodedUtf16Hex": "54CE5440FF5E000A901980AF5B9A6703662F500B51FA8272768465454E8B300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "就是說啊！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 3584,
      "rawDecodedUtf16Hex": "5C31662F8AAA554AFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "……就是說啊",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 3596,
      "rawDecodedUtf16Hex": "202620265C31662F8AAA554A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "好！我會完成它，\n然後拿去密阿雷出版社試試的。<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 3612,
      "rawDecodedUtf16Hex": "597DFF01621167035B8C62105B83FF0C000A71365F8C62FF53BB5BC6963F96F751FA7248793E8A668A667684300200100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "對<U+0010><U+0003>ᄀÿā你妳我除了感謝，還是感謝啊！\n要是小說暢銷的話，我會再拜託<U+0010><U+0003>ᄀÿā你妳幫忙的。<U+0010><U+0002>ĔƵ",
