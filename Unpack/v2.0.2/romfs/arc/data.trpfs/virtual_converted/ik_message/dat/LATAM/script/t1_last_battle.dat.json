      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "00540065002000660061006C0074006100200070006F0063006F002000700061007200610020006C006C0065006700610072002000680061007300740061000A005A007900670061007200640065002E002000A10050007500650064006F0020007600650072006C006F002000640065007300640065002000610071007500ED00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
