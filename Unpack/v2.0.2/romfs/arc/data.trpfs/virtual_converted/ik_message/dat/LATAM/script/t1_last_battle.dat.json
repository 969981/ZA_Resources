  "initialKey": 0,
  "messages": [
    {
      "displayText": "¡Si te caes, inténtalo de nuevo!\nLa clave está en el equilibrio.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "00A10053006900200074006500200063006100650073002C00200069006E007400E9006E00740061006C006F0020006400650020006E007500650076006F0021000A004C006100200063006C006100760065002000650073007400E100200065006E00200065006C00200065007100750069006C0069006200720069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "¡A eso le llamo equilibrio!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "00A10041002000650073006F0020006C00650020006C006C0061006D006F00200065007100750069006C0069006200720069006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Aquí se complica la cosa...\n¡No lo pienses y salta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 536,
      "rawDecodedUtf16Hex": "00410071007500ED00200073006500200063006F006D0070006C0069006300610020006C006100200063006F00730061002E002E002E000A00A1004E006F0020006C006F0020007000690065006E00730065007300200079002000730061006C0074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "¡Un aterrizaje increíble!\nMe hubiera gustado grabarlo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "00A10055006E0020006100740065007200720069007A0061006A006500200069006E00630072006500ED0062006C00650021000A004D0065002000680075006200690065007200610020006700750073007400610064006F0020006700720061006200610072006C006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "¡Qué estilo! ¡Qué agilidad!\nMe dejas con la boca abierta.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "00A10051007500E900200065007300740069006C006F0021002000A10051007500E90020006100670069006C00690064006100640021000A004D0065002000640065006A0061007300200063006F006E0020006C006100200062006F0063006100200061006200690065007200740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "¡Demuestra de qué eres capaz,\n<U+0010><U+0002>Ā<U+0000>!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "00A100440065006D00750065007300740072006100200064006500200071007500E90020006500720065007300200063006100700061007A002C000A001000020100000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "¡No bajes la guardia!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "00A1004E006F002000620061006A006500730020006C00610020006700750061007200640069006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Vaya, vaya...\n¡Un callejón sin salida!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "0056006100790061002C00200076006100790061002E002E002E000A00A10055006E002000630061006C006C0065006A00F3006E002000730069006E002000730061006C00690064006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Oh, qué mal!\n¡A dar media vuelta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "00A1004F0068002C00200071007500E90020006D0061006C0021000A00A1004100200064006100720020006D00650064006900610020007600750065006C0074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "¡Ánimo, sigue hasta el final! Eres\nla gran esperanza de la ciudad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "00A100C1006E0069006D006F002C00200073006900670075006500200068006100730074006100200065006C002000660069006E0061006C002100200045007200650073000A006C00610020006700720061006E0020006500730070006500720061006E007A00610020006400650020006C00610020006300690075006400610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Vas por buen camino. Sigue\navanzando, ya casi lo logras.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "00560061007300200070006F00720020006200750065006E002000630061006D0069006E006F002E002000530069006700750065000A006100760061006E007A0061006E0064006F002C002000790061002000630061007300690020006C006F0020006C006F0067007200610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¡A saltar se ha dicho!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "00A10041002000730061006C00740061007200200073006500200068006100200064006900630068006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Y fin del recorrido! ¡Un aplauso\npara <U+0010><U+0002>Ā<U+0000>!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "00A10059002000660069006E002000640065006C0020007200650063006F0072007200690064006F0021002000A10055006E002000610070006C006100750073006F000A00700061007200610020001000020100000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "De aquí en adelante, solo hay un\nlugar al que debes ir: arriba.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1528,
      "rawDecodedUtf16Hex": "00440065002000610071007500ED00200065006E0020006100640065006C0061006E00740065002C00200073006F006C006F002000680061007900200075006E000A006C007500670061007200200061006C0020007100750065002000640065006200650073002000690072003A0020006100720072006900620061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Por aquí, sígueme.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1656,
      "rawDecodedUtf16Hex": "0050006F0072002000610071007500ED002C0020007300ED006700750065006D0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Crucemos el puente.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "00430072007500630065006D006F007300200065006C0020007000750065006E00740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "¡La cosa se está poniendo fea!\nSerá mejor que te des prisa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1736,
      "rawDecodedUtf16Hex": "00A1004C006100200063006F00730061002000730065002000650073007400E100200070006F006E00690065006E0064006F00200066006500610021000A00530065007200E10020006D0065006A006F007200200071007500650020007400650020006400650073002000700072006900730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "¡Algo raro está pasando aquí!\nNo nos queda mucho tiempo...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "00A10041006C0067006F0020007200610072006F002000650073007400E100200070006100730061006E0064006F002000610071007500ED0021000A004E006F0020006E006F00730020007100750065006400610020006D007500630068006F0020007400690065006D0070006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "No te preocupes por mí, ¿ok?\nFloette está conmigo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1976,
      "rawDecodedUtf16Hex": "004E006F0020007400650020007000720065006F0063007500700065007300200070006F00720020006D00ED002C002000BF006F006B003F000A0046006C006F0065007400740065002000650073007400E100200063006F006E006D00690067006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
