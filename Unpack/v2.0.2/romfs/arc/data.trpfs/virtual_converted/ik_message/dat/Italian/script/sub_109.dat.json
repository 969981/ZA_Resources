      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "I Litwick sono Pokémon pericolosissimi!\nAssorbono l’energia vitale delle persone!!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
