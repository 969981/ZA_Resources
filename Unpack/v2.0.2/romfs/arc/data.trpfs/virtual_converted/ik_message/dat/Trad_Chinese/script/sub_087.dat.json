      "rawDecodedUtf16Hex": "20262026745C4F3D90325316300200100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "啊～好想看好想看！\n我好想看超級恰雷姆！！<U+0010><U+0002>Ĕų",
