  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Ich bin Will! Ich durchstreife die Regionen,\num seltene Pokémon zu sammeln!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Und das hier ist Gierspenst!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 452,
      "rawDecodedUtf16Hex": "0055006E0064002000640061007300200068006900650072002000690073007400200047006900650072007300700065006E00730074002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Giiier!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 520,
      "rawDecodedUtf16Hex": "00470069006900690065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Ich hab es gefangen, während ich durch die\nPaldea-Region gereist bin.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 536,
      "rawDecodedUtf16Hex": "004900630068002000680061006200200065007300200067006500660061006E00670065006E002C0020007700E4006800720065006E006400200069006300680020006400750072006300680020006400690065000A00500061006C006400650061002D0052006500670069006F006E00200067006500720065006900730074002000620069006E002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Mein Problem ist nur... Für die Entwicklung von\nGierspenst braucht man Gierspenst-Münzen.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Und zwar nicht nur ein paar, sondern...<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "0055006E00640020007A0077006100720020006E00690063006800740020006E00750072002000650069006E00200070006100610072002C00200073006F006E006400650072006E002E002E002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "...satte 999 Münzen!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 960,
      "rawDecodedUtf16Hex": "002E002E002E0073006100740074006500200039003900390020004D00FC006E007A0065006E002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Blöderweise konnte ich hier in Illumina City noch\nkeine einzige Gierspenst-Münze finden.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Könntest du mir einen Gefallen tun?<U+0010><U+0001>븁\nWenn ich dir mein Gierspenst anvertraue,\nhilf ihm bitte, sich zu entwickeln!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Gerne!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "004700650072006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Gerade lieber nicht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1456,
      "rawDecodedUtf16Hex": "0047006500720061006400650020006C006900650062006500720020006E0069006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Die Leute in Illumina sind nicht gerade herzlich...<U+0010><U+0001>븁\nKomm schon, ein kleines bisschen Freundlichkeit\nwürde doch nicht schaden!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Oh, deine Boxen sind voll. Schaff bitte etwas Platz\nund komm dann wieder, ja?<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Juhu! Das freut mich!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1932,
      "rawDecodedUtf16Hex": "004A007500680075002100200044006100730020006600720065007500740020006D006900630068002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Du erhältst ein Gierspenst!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "00440075002000650072006800E4006C007400730074002000650069006E00200047006900650072007300700065006E0073007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Du erhältst 413 Gierspenst-Münzen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "00440075002000650072006800E4006C007400730074002000340031003300200047006900650072007300700065006E00730074002D004D00FC006E007A0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Bitte hilf Gierspenst dabei, sich zu entwickeln!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2112,
      "rawDecodedUtf16Hex": "00420069007400740065002000680069006C006600200047006900650072007300700065006E00730074002000640061006200650069002C002000730069006300680020007A007500200065006E0074007700690063006B0065006C006E002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Ich geb dir auch gleich die Gierspenst-Münzen,\ndie ich in Paldea schon gesammelt hab. Hier!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Zeig mir Gierspenst, sobald es sich entwickelt hat,\nokay?<U+0010><U+0001>븁\nDafür musst du aber erst 999 Gierspenst-Münzen\nsammeln!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wenn Gierspenst sich entwickelt hat, zeig es mir\nbitte!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2668,
      "rawDecodedUtf16Hex": "00570065006E006E00200047006900650072007300700065006E007300740020007300690063006800200065006E0074007700690063006B0065006C00740020006800610074002C0020007A0065006900670020006500730020006D00690072000A00620069007400740065002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Was? Gierspenst hat sich entwickelt?\nBitte zeig es mir, das muss ich sehen!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Oha... Dieser blendende Glanz...<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2948,
      "rawDecodedUtf16Hex": "004F00680061002E002E002E002000440069006500730065007200200062006C0065006E00640065006E0064006500200047006C0061006E007A002E002E002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Verzeih, dass ich so dreist bin, aber ich hätte noch\neine Bitte.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3024,
      "rawDecodedUtf16Hex": "005600650072007A006500690068002C00200064006100730073002000690063006800200073006F0020006400720065006900730074002000620069006E002C0020006100620065007200200069006300680020006800E40074007400650020006E006F00630068000A00650069006E0065002000420069007400740065002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Bitte gib mir Monetigo! Gib es mir!\nIch brauche es!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3164,
      "rawDecodedUtf16Hex": "0042006900740074006500200067006900620020006D006900720020004D006F006E0065007400690067006F002100200047006900620020006500730020006D006900720021000A00490063006800200062007200610075006300680065002000650073002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Okay, du kannst es haben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3276,
      "rawDecodedUtf16Hex": "004F006B00610079002C0020006400750020006B0061006E006E0073007400200065007300200068006100620065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Äh... Wie bitte?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3328,
      "rawDecodedUtf16Hex": "00C40068002E002E002E0020005700690065002000620069007400740065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Schon gut... Das war etwas daneben von mir...\nVergiss die Sache einfach, okay?<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Aber weißt du was? Ich werd einfach selbst genug\nMünzen sammeln und ein Gierspenst entwickeln!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Juhuuu!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3732,
      "rawDecodedUtf16Hex": "004A00750068007500750075002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Monetigo strahlt so hell... Ich hab das Gefühl,\ndas überträgt sich auch auf mich!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Für deine Mühen bin ich dir wirklich von Herzen\ndankbar.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3928,
      "rawDecodedUtf16Hex": "004600FC00720020006400650069006E00650020004D00FC00680065006E002000620069006E002000690063006800200064006900720020007700690072006B006C00690063006800200076006F006E0020004800650072007A0065006E000A00640061006E006B006200610072002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4052,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Nur durch deinen Einsatz habe ich Monetigo\njetzt an meiner Seite! Dafür werde ich dir ewig<U+0010><U+0001>븀\ndankbar sein!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Tigo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4288,
      "rawDecodedUtf16Hex": "005400690067006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Eines Tages werde ich ein Gierspenst entwickeln.\nDu wirst schon sehen!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4300,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    }
