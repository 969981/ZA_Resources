      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4076,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
