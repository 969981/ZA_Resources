      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "可以的話，\n請<U+0010><U+0003>ᄀÿā你妳帶一隻好啦魷來吧！<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 4,
