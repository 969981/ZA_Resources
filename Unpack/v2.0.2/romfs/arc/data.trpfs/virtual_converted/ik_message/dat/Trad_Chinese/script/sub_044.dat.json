      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "所以要是能又再次\n拜託<U+0010><U+0003>ᄀÿā你妳幫忙就好了！<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
