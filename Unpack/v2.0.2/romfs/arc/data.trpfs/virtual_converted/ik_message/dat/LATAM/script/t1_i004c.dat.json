  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Exclusividad, exotismo y exquisitez\nen el Restaurante Ulalá.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "004500780063006C00750073006900760069006400610064002C002000650078006F007400690073006D006F002000790020006500780071007500690073006900740065007A000A0065006E00200065006C002000520065007300740061007500720061006E0074006500200055006C0061006C00E1002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "¿Le interesaría probar un menú de\ndegustación de lujo? Adelante.<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Vaya, vaya... Se nota que Ulalá es\nun restaurante muy interesante.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "0056006100790061002C00200076006100790061002E002E002E0020005300650020006E006F00740061002000710075006500200055006C0061006C00E1002000650073000A0075006E002000720065007300740061007500720061006E007400650020006D0075007900200069006E007400650072006500730061006E00740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡Qué suerte haber podido\nprobar algo tan exquisito!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "00A10051007500E9002000730075006500720074006500200068006100620065007200200070006F006400690064006F000A00700072006F00620061007200200061006C0067006F002000740061006E002000650078007100750069007300690074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Espero que podamos encontrar\nuna solución...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "00450073007000650072006F002000710075006500200070006F00640061006D006F007300200065006E0063006F006E0074007200610072000A0075006E006100200073006F006C00750063006900F3006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "¡Comamos antes! Que con el\nestómago vacío no se piensa bien.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 828,
      "rawDecodedUtf16Hex": "00A10043006F006D0061006D006F007300200061006E0074006500730021002000510075006500200063006F006E00200065006C000A00650073007400F3006D00610067006F002000760061006300ED006F0020006E006F0020007300650020007000690065006E007300610020006200690065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "En el mundo de los combates\nnada está garantizado.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "0045006E00200065006C0020006D0075006E0064006F0020006400650020006C006F007300200063006F006D00620061007400650073000A006E006100640061002000650073007400E100200067006100720061006E00740069007A00610064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "¡Me encanta verte combatir\njunto a tus Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1056,
      "rawDecodedUtf16Hex": "00A1004D006500200065006E00630061006E0074006100200076006500720074006500200063006F006D00620061007400690072000A006A0075006E0074006F00200061002000740075007300200050006F006B00E9006D006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Eh... ¿Eso de dedicarse a entrenar\nPokémon tiene algún futuro?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "00450068002E002E002E002000BF00450073006F00200064006500200064006500640069006300610072007300650020006100200065006E007400720065006E00610072000A0050006F006B00E9006D006F006E0020007400690065006E006500200061006C006700FA006E002000660075007400750072006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "¡Eres la mejor, hermana!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "00A100450072006500730020006C00610020006D0065006A006F0072002C0020006800650072006D0061006E006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "En serio, mi compañero de trabajo me tiene harta.<U+0010><U+0001>븁\nOjalá pudiera darle su merecido en un combate.",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Tienes toda la razón...<U+0010><U+0001>븁\nSí, sí, claro...",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "005400690065006E0065007300200074006F006400610020006C0061002000720061007A00F3006E002E002E002E00100001BE01000A005300ED002C0020007300ED002C00200063006C00610072006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Esta crème brûlée es\nla crème de la crème...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "004500730074006100200063007200E8006D006500200062007200FB006C00E90065002000650073000A006C006100200063007200E8006D00650020006400650020006C006100200063007200E8006D0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "¡Esta cobertura caramelizada\nes la mismísima perfección!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1712,
      "rawDecodedUtf16Hex": "00A1004500730074006100200063006F006200650072007400750072006100200063006100720061006D0065006C0069007A006100640061000A006500730020006C00610020006D00690073006D00ED00730069006D006100200070006500720066006500630063006900F3006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Qué interesante que haya un lugar donde se\npuedan reunir los Entrenadores y los amantes<U+0010><U+0001>븀\nde la buena cocina.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "No sé si logro comprender la visión de Alan,\nel dueño de este restaurante...<U+0010><U+0001>븁\n¿Qué es eso de querer perfeccionar los sabores\na través de los combates?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 153
    },
    {
      "displayText": "Es que todos nuestros platillos tienen un punto\nóptimo de maduración para su consumo...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "¿Tengamos un combate rapidito\ndespués de comer?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "00BF00540065006E00670061006D006F007300200075006E00200063006F006D006200610074006500200072006100700069006400690074006F000A0064006500730070007500E9007300200064006500200063006F006D00650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "¡Por supuesto! Nada mejor para\nconocerse que un buen combate.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2632,
      "rawDecodedUtf16Hex": "00A10050006F007200200073007500700075006500730074006F00210020004E0061006400610020006D0065006A006F007200200070006100720061000A0063006F006E006F00630065007200730065002000710075006500200075006E0020006200750065006E00200063006F006D0062006100740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Mi Pokémon está entrenado para\ncomer los postres más selectos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "004D006900200050006F006B00E9006D006F006E002000650073007400E100200065006E007400720065006E00610064006F00200070006100720061000A0063006F006D006500720020006C006F007300200070006F007300740072006500730020006D00E10073002000730065006C006500630074006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Fue un día muuuy largo...\nMe merezco un festín.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2884,
      "rawDecodedUtf16Hex": "00460075006500200075006E0020006400ED00610020006D00750075007500790020006C006100720067006F002E002E002E000A004D00650020006D006500720065007A0063006F00200075006E0020006600650073007400ED006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Lo único que quiero es que\nllegue la hora de comer.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2980,
      "rawDecodedUtf16Hex": "004C006F002000FA006E00690063006F0020007100750065002000710075006900650072006F0020006500730020007100750065000A006C006C00650067007500650020006C006100200068006F0072006100200064006500200063006F006D00650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Come, pequeña. Hay que aprovechar\nla juventud para probar toda clase de lujos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "¡Lo importante a la hora de comer es la compañía!\nY que la comida esté rica, obvio.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "La comida de Ulalá está tan rica que no nos\nvan a dar ganas de comer en ningún otro lugar.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Después de probar los platillos de Ulalá,\ncreo que entiendo mejor lo que es la calidad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    }
