      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Le seul moyen de le savoir, ce serait d’en voir un\nde plus près !<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
