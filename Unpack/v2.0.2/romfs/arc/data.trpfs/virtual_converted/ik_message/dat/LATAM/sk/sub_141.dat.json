  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Ay...<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 396,
      "rawDecodedUtf16Hex": "00410079002E002E002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Ah. Hola, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "00410068002E00200048006F006C0061002C00200010000201000000002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "¿Te pasa algo?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 456,
      "rawDecodedUtf16Hex": "00BF005400650020007000610073006100200061006C0067006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "¿Por qué suspiras?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "00BF0050006F007200200071007500E9002000730075007300700069007200610073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Anya es una niña extraordinaria, ¿no crees?\nLogró solucionar lo de Rayquaza...<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "En serio, ¿qué te anda pasando?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 696,
      "rawDecodedUtf16Hex": "0045006E00200073006500720069006F002C002000BF0071007500E900200074006500200061006E0064006100200070006100730061006E0064006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Puedes contarme lo que sea",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "00500075006500640065007300200063006F006E007400610072006D00650020006C006F002000710075006500200073006500610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Gracias... Es que...<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "0047007200610063006900610073002E002E002E0020004500730020007100750065002E002E002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "¿Recuerdas que te conté que mi excompañera\nde habitación pasó la audición de una agencia<U+0010><U+0001>븀\ny que la habían contratado?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "¿Y que también tengo un hermano? Bueno,\ntécnicamente, hermanastro...<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "00BF00590020007100750065002000740061006D0062006900E9006E002000740065006E0067006F00200075006E0020006800650072006D0061006E006F003F0020004200750065006E006F002C000A007400E90063006E006900630061006D0065006E00740065002C0020006800650072006D0061006E0061007300740072006F002E002E002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¿Cómo se llamaba?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "00BF004300F3006D006F0020007300650020006C006C0061006D006100620061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "¿A qué se dedica?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1300,
      "rawDecodedUtf16Hex": "00BF004100200071007500E90020007300650020006400650064006900630061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Se llama Tierno. La verdad es que ni siquiera\nlo conozco, pero sé que es un gran bailarín.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Entre una cosa y otra, siempre me comparo\ny siento que no sirvo. No sé, a lo mejor<U+0010><U+0001>븀\ntendría que olvidarme de la danza.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Claro que sirves",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1780,
      "rawDecodedUtf16Hex": "0043006C00610072006F002000710075006500200073006900720076006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "No te compares con los demás",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "004E006F00200074006500200063006F006D0070006100720065007300200063006F006E0020006C006F0073002000640065006D00E100730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Gracias, pero para ti es fácil decirlo. Con lo fuerte\nque eres, es normal que tengas esa confianza.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Lo sé.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2084,
      "rawDecodedUtf16Hex": "004C006F0020007300E9002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Disculpa por pedírtelo así de la nada, pero...\n¿combatirías contra mí, <U+0010><U+0002>Ā<U+0000>? <U+0010><U+0001>븁\nA lo mejor eso me anima y me da confianza.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2108,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Te espero en el solar, donde siempre.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2364,
      "rawDecodedUtf16Hex": "00540065002000650073007000650072006F00200065006E00200065006C00200073006F006C00610072002C00200064006F006E006400650020007300690065006D007000720065002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2448,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Combatimos, <U+0010><U+0002>Ā<U+0000>?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2460,
      "rawDecodedUtf16Hex": "00BF0043006F006D0062006100740069006D006F0073002C00200010000201000000003F001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Vamos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2508,
      "rawDecodedUtf16Hex": "00A100560061006D006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Un segundo...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2524,
      "rawDecodedUtf16Hex": "0055006E00200073006500670075006E0064006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "¡Ah, qué emoción!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "00A100410068002C00200071007500E900200065006D006F0063006900F3006E0021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "¡Genial! ¡Empecemos!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "00A100470065006E00690061006C0021002000A10045006D0070006500630065006D006F00730021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Starmie, eres la estrella de la pista de baile!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "00A10053007400610072006D00690065002C002000650072006500730020006C0061002000650073007400720065006C006C00610020006400650020006C00610020007000690073007400610020006400650020006200610069006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 2760,
      "rawDecodedUtf16Hex": "00100002BDFF001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Estuviste genial, Adira!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 2772,
      "rawDecodedUtf16Hex": "00A1004500730074007500760069007300740065002000670065006E00690061006C002C002000410064006900720061002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "¿Korrina? ¿Desde cuándo estabas aquí?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2832,
      "rawDecodedUtf16Hex": "00BF004B006F007200720069006E0061003F002000BF0044006500730064006500200063007500E1006E0064006F00200065007300740061006200610073002000610071007500ED003F001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "¡Desde que empezaron el combate!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2916,
      "rawDecodedUtf16Hex": "00A100440065007300640065002000710075006500200065006D00700065007A00610072006F006E00200065006C00200063006F006D0062006100740065002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Por cierto, ¿fue por deporte o por...?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "0050006F0072002000630069006500720074006F002C002000BF00660075006500200070006F00720020006400650070006F0072007400650020006F00200070006F0072002E002E002E003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Es que últimamente ando un poco agobiada...<U+0010><U+0001>븁\nPensé que, si tenía un buen combate, eso me\ndaría un empujoncito de confianza.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 3080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "¡Eres fantástica, Adira!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3340,
      "rawDecodedUtf16Hex": "00A10045007200650073002000660061006E007400E100730074006900630061002C002000410064006900720061002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "¿Eh? ¿Por qué lo...?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "00BF00450068003F002000BF0050006F007200200071007500E90020006C006F002E002E002E003F001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "¡Claro que sí! Me ayudaste a salvar la ciudad\njunto al resto del Equipo MZ, ¿recuerdas?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Y sí, todos sabemos que <U+0010><U+0002>Ā<U+0000>\nes imparable y todo eso, pero tú...<U+0010><U+0001>븁\n¡Tú tienes algo especial y brillas con luz propia!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 3636,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Y ese baile sincronizado con Starmie es algo\núnico y muy tuyo.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 3884,
      "rawDecodedUtf16Hex": "005900200065007300650020006200610069006C0065002000730069006E00630072006F006E0069007A00610064006F00200063006F006E00200053007400610072006D0069006500200065007300200061006C0067006F000A00FA006E00690063006F002000790020006D007500790020007400750079006F002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Korrina...<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4020,
      "rawDecodedUtf16Hex": "004B006F007200720069006E0061002E002E002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Cuando me nombraron Heredera oficial,\nyo también me sentí agobiada, Adira.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "La megaevolución es algo que, al día de hoy,\nsigue siendo un misterio...<U+0010><U+0001>븁\n¡Imagínate la poca idea que tenía yo!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Pensaba: \"¿A quién se le ocurre nombrarme a mí?\n¿Qué puedo aportar yo?\".<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Pero ¿sabes qué? Al final decidí que lo mejor era\nenfocarme en lo que pudiera hacer, nada más.<U+0010><U+0001>븁\nLo tomé con optimismo y así fui avanzando\npaso a paso.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4604,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 157
    },
    {
      "displayText": "Entiendo. Gracias, Korrina.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 44,
      "offsetInSection": 4920,
      "rawDecodedUtf16Hex": "0045006E007400690065006E0064006F002E00200047007200610063006900610073002C0020004B006F007200720069006E0061002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Y gracias a ti también por todo, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 4984,
      "rawDecodedUtf16Hex": "00590020006700720061006300690061007300200061002000740069002000740061006D0062006900E9006E00200070006F007200200074006F0064006F002C00200010000201000000002E001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Y aquí estoy yo dando consejos, como si no\ntuviera mis propias preocupaciones.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "¿Como por ejemplo?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5240,
      "rawDecodedUtf16Hex": "00BF0043006F006D006F00200070006F007200200065006A0065006D0070006C006F003F001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Que sigo sin conocer el secreto de la\nmegaevolución! ¡Que alguien me lo explique!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    }
  ],
