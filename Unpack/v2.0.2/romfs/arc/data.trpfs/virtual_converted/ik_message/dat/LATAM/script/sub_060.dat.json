      "rawDecodedUtf16Hex": "005300650020006D00650020006F0063007500720072006900F300200075006E006100200066006F0072006D006100200064006500200065006E00720069007100750065006300650072006D0065000A0063006F006E00200075006E0020006E00650067006F00630069006F00200061006800ED0020006100620061006A006F002E002E002E001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Mi idea innovadora consiste en crear un flamante\nnegocio con Camerupt.<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
