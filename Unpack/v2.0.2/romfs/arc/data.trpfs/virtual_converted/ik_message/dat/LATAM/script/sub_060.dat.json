      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Se me ocurrió una forma de enriquecerme\ncon un negocio ahí abajo...<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
