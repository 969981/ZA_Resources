      "rawDecodedUtf16Hex": "005300500049004E0020005300500049004E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Ho capito, ho capito! Starò più attento, ok?<U+0010><U+0002>Ĕŭ",
