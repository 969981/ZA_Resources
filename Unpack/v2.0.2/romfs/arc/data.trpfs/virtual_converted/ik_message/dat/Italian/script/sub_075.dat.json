      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Fatemi uscire da qui!!<U+0010><U+0001>븁\nChiedete a un Pokémon di usare una mossa\nmolto potente per distruggere questo bozzolo!<U+0010><U+0002>Ĕ<U+0004>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Qualcuno è rimasto intrappolato dentro un\nbozzolo creato dal filo di qualche Pokémon...<U+0010><U+0001>븁\nDistruggi il bozzolo usando una mossa di potenza\nelevata e libera il malcapitato.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
