      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2428,
      "rawDecodedUtf16Hex": "0048006F002000630061007000690074006F002C00200068006F002000630061007000690074006F00210020005300740061007200F200200070006900F900200061007400740065006E0074006F002C0020006F006B003F001000020114016D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Con tutto quel filo che producete, però, potremmo\nfarci una rete o una corda... e venderle!<U+0010><U+0002>Ĕŭ",
      "escapedControlUnits": 2,
