    },
    {
      "displayText": "Maledizione! Me l’hanno fatta ancora!<U+0010><U+0002>Ĕ<U+0004>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 264,
