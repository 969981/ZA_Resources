      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "포켓몬스터!\n줄여서 포켓몬이라 불리는 신비한 생명체는",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 256,
      "rawDecodedUtf16Hex": "D3ECCF13BAACC2A4D1300021000AC904C5ECC11C0020D3ECCF13BAACC774B77C0020BD88B9ACB2940020C2E0BE44D55C0020C0DDBA85CCB4B2940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "우리 주변에도 많이 살고 있습니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "C6B0B9AC0020C8FCBCC0C5D0B3C40020B9CEC7740020C0B4ACE00020C788C2B5B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "단, 최근에는 거리에서도\n많은 포켓몬들이 모습을 보이고 있어서...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 356,
      "rawDecodedUtf16Hex": "B2E8002C0020CD5CADFCC5D0B2940020AC70B9ACC5D0C11CB3C4000AB9CEC7400020D3ECCF13BAACB4E4C7740020BAA8C2B5C7440020BCF4C774ACE00020C788C5B4C11C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
