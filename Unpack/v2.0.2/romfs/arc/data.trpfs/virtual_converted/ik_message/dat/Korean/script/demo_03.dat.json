      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "퀘이사 주식회사의 사장\n제트입니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 216,
