      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "내 메더가 강한 트레이너를\n찾고 있는 것 같더라고.<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
