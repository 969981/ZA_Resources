      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "내가 데리고 있던\n메더를 잃어버렸어!<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
