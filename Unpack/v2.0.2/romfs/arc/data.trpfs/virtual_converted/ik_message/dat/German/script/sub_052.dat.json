      "offsetInSection": 844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 187
    },
    {
      "displayText": "Wow! Der Holo-Lift geht wieder!<U+0010><U+0002>ĔŔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1220,
