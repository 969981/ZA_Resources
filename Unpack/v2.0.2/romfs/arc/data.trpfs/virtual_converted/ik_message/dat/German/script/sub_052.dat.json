      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Die elektrisch geladene Attacke scheint echt\ngewirkt zu haben!<U+0010><U+0002>ĔŔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
