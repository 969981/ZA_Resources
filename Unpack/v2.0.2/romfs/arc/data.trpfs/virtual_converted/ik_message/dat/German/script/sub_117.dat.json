  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Danke für die Sache mit dem Corrosio-Clan.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "00440061006E006B00650020006600FC007200200064006900650020005300610063006800650020006D00690074002000640065006D00200043006F00720072006F00730069006F002D0043006C0061006E002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ich hab das Gengar von damals in letzter Zeit\nnicht mehr gesehen...<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "00490063006800200068006100620020006400610073002000470065006E00670061007200200076006F006E002000640061006D0061006C007300200069006E0020006C00650074007A0074006500720020005A006500690074000A006E00690063006800740020006D0065006800720020006700650073006500680065006E002E002E002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Ich weiß, es ist eben ein wildes Pokémon.\nEs geht, wohin es will.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "004900630068002000770065006900DF002C00200065007300200069007300740020006500620065006E002000650069006E002000770069006C00640065007300200050006F006B00E9006D006F006E002E000A0045007300200067006500680074002C00200077006F00680069006E002000650073002000770069006C006C002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Aber ich hab es hier jeden Tag gesehen, und\nplötzlich ist es weg. Da mach ich mir schon<U+0010><U+0001>븀\nSorgen... Und irgendwie vermisse ich es auch.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "Es ist mir etwas unangenehm, dich darum zu\nbitten, aber könntest du vielleicht mit mir<U+0010><U+0001>븀\nnach ihm suchen?<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Ich hätte da eine Idee, wer uns bei der Suche\nweiterhelfen könnte.<U+0010><U+0001>븁\nGwynn von der Faust der Gerechten kennt sich\nnämlich gut mit Geister-Pokémon aus. Lass uns<U+0010><U+0001>븀\ndoch zuerst bei ihrem Dojo vorbeischauen!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 210
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1996,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hallo! Was gibt’s?<U+0010><U+0001>븁\n...<U+0010><U+0001>븁\nEin verschwundenes Gengar? Verstehe...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "00480061006C006C006F002100200057006100730020006700690062007420190073003F00100001BE01000A002E002E002E00100001BE01000A00450069006E002000760065007200730063006800770075006E00640065006E00650073002000470065006E006700610072003F002000560065007200730074006500680065002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Aber wenn ich bei der Sache helfen soll, habe ich\neine Bedingung.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "0041006200650072002000770065006E006E002000690063006800200062006500690020006400650072002000530061006300680065002000680065006C00660065006E00200073006F006C006C002C002000680061006200650020006900630068000A00650069006E006500200042006500640069006E00670075006E0067002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Kämpfe gegen mich.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2292,
      "rawDecodedUtf16Hex": "004B00E4006D00700066006500200067006500670065006E0020006D006900630068002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Ich hab den Sieg schon in der Tasche!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2340,
      "rawDecodedUtf16Hex": "0049006300680020006800610062002000640065006E002000530069006500670020007300630068006F006E00200069006E0020006400650072002000540061007300630068006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Nee, keine Lust.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2416,
      "rawDecodedUtf16Hex": "004E00650065002C0020006B00650069006E00650020004C007500730074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Dann seht zu, wie ihr ohne mich zurechtkommt.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2452,
      "rawDecodedUtf16Hex": "00440061006E006E002000730065006800740020007A0075002C002000770069006500200069006800720020006F0068006E00650020006D0069006300680020007A007500720065006300680074006B006F006D006D0074002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Das wird meine Revanche.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "004400610073002000770069007200640020006D00650069006E006500200052006500760061006E006300680065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2612,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du bist echt stark...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2636,
      "rawDecodedUtf16Hex": "00440075002000620069007300740020006500630068007400200073007400610072006B002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Du da. Erklär mir kurz die Situation.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2688,
      "rawDecodedUtf16Hex": "00440075002000640061002E002000450072006B006C00E400720020006D006900720020006B00750072007A002000640069006500200053006900740075006100740069006F006E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Verstehe... Da macht man sich natürlich Sorgen.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2772,
      "rawDecodedUtf16Hex": "00560065007200730074006500680065002E002E002E0020004400610020006D00610063006800740020006D0061006E002000730069006300680020006E0061007400FC0072006C00690063006800200053006F007200670065006E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Dank deiner Erklärung konnte ich mir ein Bild\nvom Charakter des gesuchten Gengar machen.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Mein Partner Skelabra wird versuchen,\nes aufzuspüren.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3064,
      "rawDecodedUtf16Hex": "004D00650069006E00200050006100720074006E0065007200200053006B0065006C006100620072006100200077006900720064002000760065007200730075006300680065006E002C000A006500730020006100750066007A00750073007000FC00720065006E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Aber es ist so... Bei Geister-Pokémon gibt es\nsolche, die immer an einem Ort bleiben und<U+0010><U+0001>븀\nsolche, die lieber umherwandern.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "Deswegen sag ich’s gleich, wie es ist.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3440,
      "rawDecodedUtf16Hex": "0044006500730077006500670065006E002000730061006700200069006300682019007300200067006C0065006900630068002C00200077006900650020006500730020006900730074002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Mach dir nicht zu viele Hoffnungen.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3528,
      "rawDecodedUtf16Hex": "004D00610063006800200064006900720020006E00690063006800740020007A00750020007600690065006C006500200048006F00660066006E0075006E00670065006E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Ist klar... Mir würde es schon reichen zu wissen,\ndass es ihm gut geht.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Weißt du, wo es sein könnte, Skelabra?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3760,
      "rawDecodedUtf16Hex": "00570065006900DF0074002000640075002C00200077006F0020006500730020007300650069006E0020006B00F6006E006E00740065002C00200053006B0065006C0061006200720061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3848,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Hier?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3860,
      "rawDecodedUtf16Hex": "0048006900650072003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3880,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Laut Skelabra könnte sich das gesuchte Gengar\nbeim Pique Faîne befinden.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Kein Wunder. So ein geschichtsträchtiges Hotel\nbirgt sicher viele Spukgeschichten...<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Ich gehe schon mal vor.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4228,
      "rawDecodedUtf16Hex": "004900630068002000670065006800650020007300630068006F006E0020006D0061006C00200076006F0072002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4284,
      "rawDecodedUtf16Hex": "00100002BDFF00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Und, Skelabra? Konntest du Gengar aufspüren?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4296,
      "rawDecodedUtf16Hex": "0055006E0064002C00200053006B0065006C0061006200720061003F0020004B006F006E006E0074006500730074002000640075002000470065006E00670061007200200061007500660073007000FC00720065006E003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4396,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Pump?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4408,
      "rawDecodedUtf16Hex": "00500075006D0070003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Knapp daneben.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4424,
      "rawDecodedUtf16Hex": "004B006E006100700070002000640061006E006500620065006E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Wo könnte es noch sein, Skelabra?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4464,
      "rawDecodedUtf16Hex": "0057006F0020006B00F6006E006E007400650020006500730020006E006F006300680020007300650069006E002C00200053006B0065006C0061006200720061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4540,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Hier?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4552,
      "rawDecodedUtf16Hex": "0048006900650072003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4572,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Laut Skelabra gibt es da eine verdächtige\nSeitengasse.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4584,
      "rawDecodedUtf16Hex": "004C00610075007400200053006B0065006C006100620072006100200067006900620074002000650073002000640061002000650069006E00650020007600650072006400E4006300680074006900670065000A00530065006900740065006E00670061007300730065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Natürlich! In dieser Seitengasse befindet sich\nein Kanal... Und jeder weiß, dass sich bei Kanälen<U+0010><U+0001>븀\noft spirituelle Energie ansammelt.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4704,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "Ich gehe schon mal vor.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4984,
      "rawDecodedUtf16Hex": "004900630068002000670065006800650020007300630068006F006E0020006D0061006C00200076006F0072002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Ich glaube nicht, dass Gengar am Grand Hôtel\nPique Faîne interessiert ist.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "<U+0010><U+0002>뷿.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5200,
      "rawDecodedUtf16Hex": "00100002BDFF002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hast du Gengar entdeckt, Skelabra?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5212,
      "rawDecodedUtf16Hex": "0048006100730074002000640075002000470065006E00670061007200200065006E0074006400650063006B0074002C00200053006B0065006C0061006200720061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5292,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Shuuu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5304,
      "rawDecodedUtf16Hex": "0053006800750075007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Da hat sich nur ein Shuppet im Schatten\nversteckt...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 5320,
      "rawDecodedUtf16Hex": "004400610020006800610074002000730069006300680020006E00750072002000650069006E0020005300680075007000700065007400200069006D00200053006300680061007400740065006E000A0076006500720073007400650063006B0074002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Hast du eine Idee, wo Gengar noch sein könnte,\nSkelabra?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 5436,
      "rawDecodedUtf16Hex": "0048006100730074002000640075002000650069006E006500200049006400650065002C00200077006F002000470065006E0067006100720020006E006F006300680020007300650069006E0020006B00F6006E006E00740065002C000A0053006B0065006C0061006200720061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 5560,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Hier?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 5572,
      "rawDecodedUtf16Hex": "0048006900650072003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5592,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "In der Galerie Clair de Lune...? Merkwürdig...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 5604,
      "rawDecodedUtf16Hex": "0049006E0020006400650072002000470061006C006500720069006500200043006C0061006900720020006400650020004C0075006E0065002E002E002E003F0020004D00650072006B007700FC0072006400690067002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Vielleicht interessiert sich Gengar für Mode?<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5708,
      "rawDecodedUtf16Hex": "005600690065006C006C0065006900630068007400200069006E007400650072006500730073006900650072007400200073006900630068002000470065006E0067006100720020006600FC00720020004D006F00640065003F001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Dann hätte es zur Passage Ombre gehen sollen.<U+0010><U+0001>븁\nDa befindet sich nämlich mein Lieblingsladen\nLichteloh.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "Auf zur Galerie Clair de Lune!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 6028,
      "rawDecodedUtf16Hex": "0041007500660020007A00750072002000470061006C006500720069006500200043006C0061006900720020006400650020004C0075006E00650021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Das wirkt wie ein Ort, an dem sich Gengar\naufhalten würde.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 6100,
      "rawDecodedUtf16Hex": "0044006100730020007700690072006B00740020007700690065002000650069006E0020004F00720074002C00200061006E002000640065006D00200073006900630068002000470065006E006700610072000A00610075006600680061006C00740065006E0020007700FC007200640065002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 6228,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hast du Gengar gefunden, Skelabra?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6240,
      "rawDecodedUtf16Hex": "0048006100730074002000640075002000470065006E00670061007200200067006500660075006E00640065006E002C00200053006B0065006C0061006200720061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Skel!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 6320,
      "rawDecodedUtf16Hex": "0053006B0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Gar?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6332,
      "rawDecodedUtf16Hex": "004700610072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Und?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 6344,
      "rawDecodedUtf16Hex": "0055006E0064003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Das ist es nicht. Sein Ruf klingt ganz anders.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 6364,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020006500730020006E0069006300680074002E0020005300650069006E00200052007500660020006B006C0069006E00670074002000670061006E007A00200061006E0064006500720073002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Gengar! Du sollst doch in meiner Nähe bleiben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6468,
      "rawDecodedUtf16Hex": "00470065006E006700610072002100200044007500200073006F006C006C0073007400200064006F0063006800200069006E0020006D00650069006E006500720020004E00E40068006500200062006C0065006900620065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Komm, wir gehen nach Hause. Ich mache dir\nauch den Eintopf, den du so magst.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 6564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Garrr.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 6720,
      "rawDecodedUtf16Hex": "00470061007200720072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Los, Skelabra, suchen wir weiter.\nAufgeben gibt’s nicht.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 6736,
      "rawDecodedUtf16Hex": "004C006F0073002C00200053006B0065006C0061006200720061002C002000730075006300680065006E00200077006900720020007700650069007400650072002E000A0041007500660067006500620065006E00200067006900620074201900730020006E0069006300680074002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Nein... Ist schon in Ordnung.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 6860,
      "rawDecodedUtf16Hex": "004E00650069006E002E002E002E00200049007300740020007300630068006F006E00200069006E0020004F00720064006E0075006E0067002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Wenn du und Skelabra es nicht finden könnt,\nmuss ich das akzeptieren.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 6928,
      "rawDecodedUtf16Hex": "00570065006E006E00200064007500200075006E006400200053006B0065006C00610062007200610020006500730020006E0069006300680074002000660069006E00640065006E0020006B00F6006E006E0074002C000A006D0075007300730020006900630068002000640061007300200061006B007A0065007000740069006500720065006E002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Aber...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 7076,
      "rawDecodedUtf16Hex": "0041006200650072002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Wenn ich es so sehr vermisse, dass ich überall\nnach ihm suche... Dann hätte ich gleich sein<U+0010><U+0001>븀\nTrainer werden sollen, nicht wahr?<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 7100,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Aber mir hat gereicht, dass es einfach nur da war.\nNäher wollte ich ihm gar nicht kommen.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 7368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Es ist, wie es ist. Vielen Dank, dass ihr so nett\nwart, es für mich zu suchen.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 7556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Tut mir leid, dass wir nicht mehr tun konnten...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 7724,
      "rawDecodedUtf16Hex": "0054007500740020006D006900720020006C006500690064002C0020006400610073007300200077006900720020006E00690063006800740020006D006500680072002000740075006E0020006B006F006E006E00740065006E002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Interessiert sich Gengar etwa für Mode?\nDas wär ja witzig.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 7832,
      "rawDecodedUtf16Hex": "0049006E007400650072006500730073006900650072007400200073006900630068002000470065006E006700610072002000650074007700610020006600FC00720020004D006F00640065003F000A0044006100730020007700E400720020006A00610020007700690074007A00690067002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿N",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 7960,
      "rawDecodedUtf16Hex": "00100002BDFF004E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du wirst es nicht glauben, <U+0010><U+0002>Ā<U+0000>!\nGengar ist einfach so wiedergekommen!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 7972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Gen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 8124,
      "rawDecodedUtf16Hex": "00470065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Vielleicht verschwindet es irgendwann wieder\noder kommt eines Tages gar nicht mehr zurück.<U+0010><U+0001>븁\nAber solange es hier ist, werde ich die\ngemeinsame Zeit genießen.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 8140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 164
    },
    {
      "displayText": "Gwynn hab ich auch gleich Bescheid gesagt.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 82,
      "offsetInSection": 8468,
      "rawDecodedUtf16Hex": "004700770079006E006E002000680061006200200069006300680020006100750063006800200067006C00650069006300680020004200650073006300680065006900640020006700650073006100670074002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Gen, gen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 8564,
      "rawDecodedUtf16Hex": "00470065006E002C002000670065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    }
  ],
