      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Du hast mir nicht nur einen tollen Kampf\ngeliefert, sondern auch eine Erinnerung an einen<U+0010><U+0001>븀\nsehr wichtigen Kampf in mir geweckt, den ich<U+0010><U+0001>븀\neinst bestritten habe.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 168
    },
    {
      "displayText": "Ich bin richtig froh, nach Illumina gekommen zu\nsein und dich getroffen zu haben!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3056,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
