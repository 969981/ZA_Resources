  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "提供您至高無上的服務。\n歡迎來到秀麗世。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 188,
      "rawDecodedUtf16Hex": "63D04F9B60A881F39AD871214E0A7684670D52D93002000A6B618FCE4F86523079C09E974E1630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "說到由紫小姐的想法，\n就是為了和寶可夢度過最棒的時光，<U+0010><U+0001>븀\n能者就應該盡到應盡的責任，沒錯吧。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 232,
      "rawDecodedUtf16Hex": "8AAA523075317D2B5C0F59D0768460F36CD5FF0C000A5C31662F70BA4E86548C5BF653EF59225EA6904E670068D2768466425149FF0C00100001BE00000A80FD80055C3161C98A7276E1523061C976E176848CAC4EFBFF0C6C92932F542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "畢竟她的夢想就是\n讓密阿雷市成為<U+0010><U+0001>븁\n不論對人或對寶可夢來說\n都是最棒的城市啊。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "75627ADF59797684592260F35C31662F000A8B935BC6963F96F75E02621070BA00100001BE01000A4E0D8AD65C0D4EBA62165C0D5BF653EF59224F868AAA000A90FD662F670068D2768457CE5E02554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "由紫小姐和MSBC\n會照亮密阿雷的未來。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "75317D2B5C0F59D0548C004D005300420043000A670371674EAE5BC6963F96F77684672A4F8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "多虧有禮賓部的榴紅小姐，\n我覺得非常舒適。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 460,
      "rawDecodedUtf16Hex": "591A8667670979AE8CD390E8768469B47D055C0F59D0FF0C000A621189BA5F97975E5E388212906930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "我用禮賓部提供的行程\n正盡情享受在密阿雷觀光。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 504,
      "rawDecodedUtf16Hex": "6211752879AE8CD390E863D04F9B7684884C7A0B000A6B6376E160C54EAB53D757285BC6963F96F789C0514930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "雖然觀光行程也不錯，\n但我想要打寶可夢對戰啦！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "96D6713689C05149884C7A0B4E5F4E0D932FFF0C000A4F46621160F3898162535BF653EF59225C0D62305566FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "酒店裡不只有寶可夢的\n美容沙龍……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 600,
      "rawDecodedUtf16Hex": "91525E9788E14E0D53EA67095BF653EF59227684000A7F8E5BB96C999F8D202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "連用來鍛鍊寶可夢的\n訓練室也超棒的。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 636,
      "rawDecodedUtf16Hex": "902375284F86935B934A5BF653EF59227684000A8A137DF45BA44E5F8D8568D2768430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "如果要過極簡生活，\n長期住在旅館是行得通的呢。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "5982679C8981904E69757C21751F6D3BFF0C000A9577671F4F4F572865C59928662F884C5F97901A7684546230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "歡迎來到\n秀麗世大酒店。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 724,
      "rawDecodedUtf16Hex": "6B618FCE4F865230000A79C09E974E16592791525E9730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "歡迎來到\n秀麗世大酒店。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 764,
      "rawDecodedUtf16Hex": "6B618FCE4F865230000A79C09E974E16592791525E9730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "我想吃遍\n這裡的餐廳啦。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 792,
      "rawDecodedUtf16Hex": "621160F35403904D000A901988E1768499105EF3556630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "機會難得，真想在\n密阿雷捉到寶可夢啊。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "6A5F670396E35F97FF0C771F60F35728000A5BC6963F96F7634952305BF653EF5922554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "如果要實現大家的願望，\n入住時間不夠長啊……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 860,
      "rawDecodedUtf16Hex": "5982679C89815BE673FE59275BB676849858671BFF0C000A51654F4F664295934E0D59209577554A202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "我朋友要求我幫忙\n買東買西的。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "6211670B53CB89816C4262115E6B5FD9000A8CB767718CB7897F768430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "我們偷偷混進\nMSBC的派對裡吧。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "62115011507750776DF79032000A004D00530042004376846D3E5C0D88E1542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "被抓到的話\n會被可怕的姐姐罵的啦。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 976,
      "rawDecodedUtf16Hex": "88AB6293523076848A71000A670388AB53EF6015768459D059D07F757684556630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "關於想選為下次主力的寶可夢，\n妳已經決定好培育計畫了嗎？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "95DC65BC60F3907870BA4E0B6B214E3B529B76845BF653EF5922FF0C000A59B35DF27D936C7A5B9A597D57F980B28A08756B4E8655CEFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "我還在煩惱。<U+0010><U+0001>븁\n到底該讓牠均衡地學會招式，\n還是要讓牠徹底地對某個屬性特別強才好。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "621190845728716960F1300200100001BE01000A52305E958A728B9372605747886157305B78670362DB5F0FFF0C000A9084662F89818B9372605FB95E9557305C0D67D0500B5C6C6027727952255F37624D597D30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "料理總是如此美妙出色！\n記得幫我向主廚轉告我的謝意。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1160,
      "rawDecodedUtf16Hex": "659974067E3D662F59826B647F8E599951FA8272FF01000A8A185F975E6B621154114E3B5EDA8F49544A621176848B1D610F30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "這是因為本酒店的主廚\n是志米的高徒。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "9019662F56E070BA672C91525E9776844E3B5EDA000A662F5FD77C7376849AD85F9230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    }
  ],
