  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Hey, du... Bist du an ultimativen Geheimtechniken\ninteressiert?<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 372,
      "rawDecodedUtf16Hex": "004800650079002C002000640075002E002E002E0020004200690073007400200064007500200061006E00200075006C00740069006D00610074006900760065006E002000470065006800650069006D0074006500630068006E0069006B0065006E000A0069006E0074006500720065007300730069006500720074003F00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Wer sind Sie?<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "005700650072002000730069006E00640020005300690065003F00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Lassen Sie mal hören.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 544,
      "rawDecodedUtf16Hex": "004C0061007300730065006E00200053006900650020006D0061006C0020006800F600720065006E002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Du machst was her... Also schön.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 596,
      "rawDecodedUtf16Hex": "004400750020006D0061006300680073007400200077006100730020006800650072002E002E002E00200041006C0073006F002000730063006800F6006E002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Glurak. Lohgock. Flambirex. Fennexis.<U+0010><U+0001>븁\nTurtok. Sumpex. Impergator. Quajutsu.<U+0010><U+0001>븁\nBisaflor. Gewaldro. Meganie. Brigaron.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 672,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Das sind die Pokémon, die ultimative Attacken\neinsetzen können. Und ich kann sie ihnen<U+0010><U+0001>븀\nbeibringen!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 924,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Allerdings unter einer Bedingung.<U+0010><U+0001>븁\nDas entsprechende Pokémon muss allein\ngegen drei Pokémon gewinnen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "Wenn es das meistert, reden wir weiter.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "00570065006E006E00200065007300200064006100730020006D0065006900730074006500720074002C00200072006500640065006E00200077006900720020007700650069007400650072002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Komm wieder, wenn du bereit bist, dich mir zu\nstellen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "004B006F006D006D0020007700690065006400650072002C002000770065006E006E002000640075002000620065007200650069007400200062006900730074002C002000640069006300680020006D006900720020007A0075000A007300740065006C006C0065006E002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du bist also an den ultimativen Geheimtechniken\ninteressiert.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "004400750020006200690073007400200061006C0073006F00200061006E002000640065006E00200075006C00740069006D00610074006900760065006E002000470065006800650069006D0074006500630068006E0069006B0065006E000A0069006E0074006500720065007300730069006500720074002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Dann erkläre ich dir mal, wie es abläuft.\nEs gibt drei Prüfungen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "00440061006E006E002000650072006B006C00E400720065002000690063006800200064006900720020006D0061006C002C0020007700690065002000650073002000610062006C00E4007500660074002E000A00450073002000670069006200740020006400720065006900200050007200FC00660075006E00670065006E002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Bei jeder von ihnen musst du mit nur einem\nPokémon gegen mich antreten und den Sieg<U+0010><U+0001>븀\ndavontragen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Bei der Prüfung der Pflanze musst du allein\nmit einem Meganie gegen drei Feuer-Pokémon<U+0010><U+0001>븀\nantreten.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Bei der Prüfung des Feuers musst du allein mit\neinem Flambirex gegen drei Wasser-Pokémon<U+0010><U+0001>븀\nankommen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Bei der Prüfung des Wassers musst du allein mit\neinem Impergator gegen drei Pflanzen-Pokémon<U+0010><U+0001>븀\nbestehen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2472,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Für jede erfolgreich absolvierte Prüfung weihe ich\ndich in eine der ultimativen Geheimtechniken ein.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Wenn du deine Vorbereitungen abgeschlossen\nhast, können wir mit den Prüfungen beginnen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Welcher Prüfung möchtest du dich unterziehen?<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3088,
      "rawDecodedUtf16Hex": "00570065006C006300680065007200200050007200FC00660075006E00670020006D00F60063006800740065007300740020006400750020006400690063006800200075006E007400650072007A0069006500680065006E003F00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Der Prüfung der Pflanze!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3188,
      "rawDecodedUtf16Hex": "00440065007200200050007200FC00660075006E00670020006400650072002000500066006C0061006E007A006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Der Prüfung des Feuers!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3240,
      "rawDecodedUtf16Hex": "00440065007200200050007200FC00660075006E00670020006400650073002000460065007500650072007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Der Prüfung des Wassers!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3288,
      "rawDecodedUtf16Hex": "00440065007200200050007200FC00660075006E006700200064006500730020005700610073007300650072007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Wie funktioniert das Ganze noch mal?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3340,
      "rawDecodedUtf16Hex": "005700690065002000660075006E006B00740069006F006E00690065007200740020006400610073002000470061006E007A00650020006E006F006300680020006D0061006C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Keiner davon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3416,
      "rawDecodedUtf16Hex": "004B00650069006E006500720020006400610076006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Es gibt drei Prüfungen! Bei jeder musst du mit\neinem bestimmten Pokémon gegen drei Pokémon<U+0010><U+0001>븀\ngewinnen.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "Ich werde weiter hier ausharren und warten,\ndass jemand alle Prüfungen besteht.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Um dich an der Prüfung der Pflanze zu versuchen,\ndarfst du nur ein Meganie im Team haben.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Um dich an der Prüfung des Feuers zu versuchen,\ndarfst du nur ein Flambirex im Team haben.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Um dich an der Prüfung des Wassers zu\nversuchen, darfst du nur ein Impergator im Team<U+0010><U+0001>븀\nhaben.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "So sei es. Beginnen wir mit der Prüfung der\nPflanze!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4408,
      "rawDecodedUtf16Hex": "0053006F0020007300650069002000650073002E00200042006500670069006E006E0065006E00200077006900720020006D00690074002000640065007200200050007200FC00660075006E00670020006400650072000A00500066006C0061006E007A0065002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "So sei es. Beginnen wir mit der Prüfung des\nFeuers!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4524,
      "rawDecodedUtf16Hex": "0053006F0020007300650069002000650073002E00200042006500670069006E006E0065006E00200077006900720020006D00690074002000640065007200200050007200FC00660075006E00670020006400650073000A004600650075006500720073002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "So sei es. Beginnen wir mit der Prüfung des\nWassers!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4636,
      "rawDecodedUtf16Hex": "0053006F0020007300650069002000650073002E00200042006500670069006E006E0065006E00200077006900720020006D00690074002000640065007200200050007200FC00660075006E00670020006400650073000A0057006100730073006500720073002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4752,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ausgezeichnet!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4764,
      "rawDecodedUtf16Hex": "00410075007300670065007A0065006900630068006E00650074002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Dir gebührt Ehre für das Meistern der Prüfung\nder Pflanze.<U+0010><U+0001>븁\nIch vertraue dir die ultimative Geheimtechnik\nin Form dieser TM an!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Dir gebührt Ehre für das Meistern der Prüfung\ndes Feuers.<U+0010><U+0001>븁\nIch vertraue dir die ultimative Geheimtechnik\nin Form dieser TM an!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Dir gebührt Ehre für das Meistern der Prüfung\ndes Wassers.<U+0010><U+0001>븁\nIch vertraue dir die ultimative Geheimtechnik\nin Form dieser TM an!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Wunderbar! Doch noch hast du nicht alle drei\nPrüfungen bestanden. Weiter so!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "<U+0010><U+0002>뷿&",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5772,
      "rawDecodedUtf16Hex": "00100002BDFF00260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh... Es ist endlich so weit...<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5784,
      "rawDecodedUtf16Hex": "004F0068002E002E002E002000450073002000690073007400200065006E0064006C00690063006800200073006F00200077006500690074002E002E002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Herzlichen Glückwunsch. Du hast alle Prüfungen\nabsolviert.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5856,
      "rawDecodedUtf16Hex": "004800650072007A006C0069006300680065006E00200047006C00FC0063006B00770075006E007300630068002E0020004400750020006800610073007400200061006C006C006500200050007200FC00660075006E00670065006E000A006100620073006F006C00760069006500720074002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Jede der ultimativen Geheimtechniken verfügt\nüber enorme Stärke...<U+0010><U+0001>븁\nDoch diese hat ihren Preis. Sie gehen mit einem\ngroßen Rückstoß einher.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 146
    },
    {
      "displayText": "Um sie gewinnbringend einzusetzen, ist ein\nüberragendes Urteilsvermögen seitens des<U+0010><U+0001>븀\nTrainers unerlässlich.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6276,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Widme dich voll und ganz dem Meistern dieser\nTechniken.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6504,
      "rawDecodedUtf16Hex": "005700690064006D00650020006400690063006800200076006F006C006C00200075006E0064002000670061006E007A002000640065006D0020004D006500690073007400650072006E0020006400690065007300650072000A0054006500630068006E0069006B0065006E002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "<U+0010><U+0002>뷿,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6624,
      "rawDecodedUtf16Hex": "00100002BDFF002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Die ultimativen Geheimtechniken verfügen über\nenorme Stärke, gehen aber mit einem großen<U+0010><U+0001>븀\nRückstoß einher.<U+0010><U+0001>븁\nUm sie gewinnbringend einzusetzen, ist ein gutes\nUrteilsvermögen seitens des Trainers wichtig.<U+0010><U+0001>븁\nWidme dich dem Meistern dieser Techniken.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 6636,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 256
    }
  ],
