      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "要阻止失控超级蟹斗，\n就要打倒失控超级好胜毛蟹它们！<U+0010><U+0002>ĔǙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 348,
