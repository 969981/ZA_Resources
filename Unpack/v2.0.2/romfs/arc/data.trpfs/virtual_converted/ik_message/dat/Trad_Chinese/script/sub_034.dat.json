      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "我家寶可夢的招式，\n全部都是能設下陷阱的招式！<U+0010><U+0002>ĔŃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
