      "rawDecodedUtf16Hex": "004B006F006D006D0020007700690065006400650072002C002000770065006E006E002000640075002000620065007200650069007400200062006900730074002C0020006500730020006D006900740020006D00690072000A006100750066007A0075006E00650068006D0065006E0021001000020114014F0000",
