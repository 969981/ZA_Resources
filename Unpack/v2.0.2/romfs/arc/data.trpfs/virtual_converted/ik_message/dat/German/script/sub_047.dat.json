      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 153
    },
    {
      "displayText": "Komm wieder, wenn du bereit bist, es mit mir\naufzunehmen!<U+0010><U+0002>Ĕŏ",
