      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "지금 내 머릿속에 남아 있는 건...<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
