  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Oh, c’est toi. Merci pour ton aide, la dernière fois !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "004F0068002C00200063201900650073007400200074006F0069002E0020004D006500720063006900200070006F0075007200200074006F006E00200061006900640065002C0020006C00610020006400650072006E006900E80072006500200066006F006900730020002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Grâce à toi, j’ai pu voir l’effet qu’a\nune Pierre Foudre sur un Pikachu !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Alola !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "0041006C006F006C006100200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Merci d’avoir fait un échange de Pokémon\navec moi !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "004D006500720063006900200064201900610076006F006900720020006600610069007400200075006E002000E9006300680061006E0067006500200064006500200050006F006B00E9006D006F006E000A00610076006500630020006D006F006900200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Allez, je rentre dans le vif du sujet : on aimerait\nte montrer quelque chose, aujourd’hui !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Ce qu’on veut te montrer, c’est...<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "004300650020007100752019006F006E002000760065007500740020007400650020006D006F006E0074007200650072002C002000632019006500730074002E002E002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "... les Méga-Évolutions de nos Raichu !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1096,
      "rawDecodedUtf16Hex": "002E002E002E0020006C006500730020004D00E900670061002D00C90076006F006C007500740069006F006E00730020006400650020006E006F0073002000520061006900630068007500200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Et quoi de mieux qu’un combat pour montrer\nles pouvoirs que leur donne la Méga-Évolution ?<U+0010><U+0001>븁\nBref, reviens me voir quand tu seras prêt<U+0010><U+0003>ᄀÿĀe !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 148
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1480,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "T’es prêt<U+0010><U+0003>ᄀÿĀe à affronter notre duo de\nRaichu méga-évolués ?<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1492,
      "rawDecodedUtf16Hex": "005420190065007300200070007200EA007400100003110000FF01000065002000E000200061006600660072006F006E0074006500720020006E006F007400720065002000640075006F002000640065000A0052006100690063006800750020006D00E900670061002D00E90076006F006C007500E900730020003F00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Tu es prêt<U+0010><U+0003>ᄀÿĀe à affronter notre duo de\nRaichu méga-évolués ?<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "0054007500200065007300200070007200EA007400100003110000FF01000065002000E000200061006600660072006F006E0074006500720020006E006F007400720065002000640075006F002000640065000A0052006100690063006800750020006D00E900670061002D00E90076006F006C007500E900730020003F001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "En garde !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "0045006E002000670061007200640065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Un instant !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1788,
      "rawDecodedUtf16Hex": "0055006E00200069006E007300740061006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Dépêche-toi ! On a hâte de te montrer\nnos Méga-Raichu !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "004400E9007000EA006300680065002D0074006F0069002000210020004F006E002000610020006800E2007400650020006400650020007400650020006D006F006E0074007200650072000A006E006F00730020004D00E900670061002D0052006100690063006800750020002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Y a rien de mieux qu’un combat pour montrer\nles pouvoirs que leur donne la Méga-Évolution !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Nous voulons te montrer à quoi ressemblent\nnos Raichu quand ils méga-évoluent !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Il n’y a rien de mieux qu’un combat pour montrer\nles pouvoirs que leur donne la Méga-Évolution !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "RAICHU ?!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2500,
      "rawDecodedUtf16Hex": "0052004100490043004800550020003F002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "C’est quoi cette taille ?!\nSeuls les Barons sont aussi gros !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "00432019006500730074002000710075006F00690020006300650074007400650020007400610069006C006C00650020003F0021000A005300650075006C00730020006C006500730020004200610072006F006E007300200073006F006E0074002000610075007300730069002000670072006F007300200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Allez, Méga-Raichu X ! Déploie un champ\nmagnétique avec ta double pika-queue !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2672,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Méga-Raichu Y, bats-toi au nom de l’Union\nde Lutte pour le Triomphe de tous les Raichu !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2840,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "J’en attendais pas moins d<U+0010><U+0003>ᄀÿชu Dresseure la Dresseuse\nqui a remporté le Royale Z-A !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Et qui a sauvé Illumis d’un terrible danger !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3224,
      "rawDecodedUtf16Hex": "004500740020007100750069002000610020007300610075007600E900200049006C006C0075006D006900730020006420190075006E0020007400650072007200690062006C0065002000640061006E00670065007200200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Laisse-moi te dire merci une fois encore !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3324,
      "rawDecodedUtf16Hex": "004C00610069007300730065002D006D006F0069002000740065002000640069007200650020006D006500720063006900200075006E006500200066006F0069007300200065006E0063006F007200650020002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "C’est grâce à toi que nous avons pu monter\nnotre duo de Raichu !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3420,
      "rawDecodedUtf16Hex": "0043201900650073007400200067007200E200630065002000E000200074006F006900200071007500650020006E006F00750073002000610076006F006E00730020007000750020006D006F006E007400650072000A006E006F007400720065002000640075006F002000640065002000520061006900630068007500200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Pour joindre l’acte à la parole, permets-moi\nde te donner cette Raichuïte X.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3560,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Et de ma part, accepte cette Raichuïte Y !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3724,
      "rawDecodedUtf16Hex": "004500740020006400650020006D006100200070006100720074002C00200061006300630065007000740065002000630065007400740065002000520061006900630068007500EF007400650020005900200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "J’espère qu’on aura l’occasion de se revoir\nun jour !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3820,
      "rawDecodedUtf16Hex": "004A201900650073007000E8007200650020007100752019006F006E002000610075007200610020006C2019006F00630063006100730069006F006E0020006400650020007300650020007200650076006F00690072000A0075006E0020006A006F007500720020002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Alola !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 3936,
      "rawDecodedUtf16Hex": "0041006C006F006C006100200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3960,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh ! <U+0010><U+0002>Ā<U+0000> !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 3972,
      "rawDecodedUtf16Hex": "004F006800200021002000100002010000000020002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Quel hasard ! Justement, nous parlions de toi !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4004,
      "rawDecodedUtf16Hex": "005100750065006C0020006800610073006100720064002000210020004A0075007300740065006D0065006E0074002C0020006E006F007500730020007000610072006C0069006F006E007300200064006500200074006F006900200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "À propos de quoi ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4108,
      "rawDecodedUtf16Hex": "00C0002000700072006F0070006F0073002000640065002000710075006F00690020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "En bien, j’espère !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4148,
      "rawDecodedUtf16Hex": "0045006E0020006200690065006E002C0020006A201900650073007000E800720065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Nous nous disions à quel point nous te sommes\nreconnaissantes pour ces Raichu.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4188,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Le Raichu que j’ai obtenu grâce à la Pierre\nFoudre va très bien !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4356,
      "rawDecodedUtf16Hex": "004C0065002000520061006900630068007500200071007500650020006A2019006100690020006F006200740065006E007500200067007200E200630065002000E00020006C00610020005000690065007200720065000A0046006F007500640072006500200076006100200074007200E800730020006200690065006E0020002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Et le Raichu que tu m’as échangé déborde\nd’énergie !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 4496,
      "rawDecodedUtf16Hex": "004500740020006C0065002000520061006900630068007500200071007500650020007400750020006D201900610073002000E9006300680061006E006700E90020006400E90062006F007200640065000A0064201900E9006E0065007200670069006500200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Nous nous sommes croisées par hasard et\nnous avons commencé à admirer nos Raichu.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4612,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Et en parlant, nous avons découvert que\nnous te les devions toutes les deux !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 4784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Bref, de fil en aiguille, nous avons décidé de créer\nle duo de Raichu le plus balèze du monde !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Nous nous sommes rencontrées grâce à toi et\nà cette ville magique !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5148,
      "rawDecodedUtf16Hex": "004E006F007500730020006E006F0075007300200073006F006D006D00650073002000720065006E0063006F006E0074007200E90065007300200067007200E200630065002000E000200074006F0069002000650074000A00E0002000630065007400740065002000760069006C006C00650020006D00610067006900710075006500200021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Raiii... Chuuu !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5292,
      "rawDecodedUtf16Hex": "00520061006900690069002E002E002E002000430068007500750075002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Je vais utiliser des Pierres Foudre sur tous\nles Pikachu du monde entier !<U+0010><U+0001>븀\n... Je plaisante ! Qui ferait une chose pareille ?<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Avoir un Raichu à ses côtés, c’est s’offrir une vie\nremplie de bonheur !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 45,
      "offsetInSection": 5596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "<U+0010><U+0002>뷿.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5752,
      "rawDecodedUtf16Hex": "00100002BDFF002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Les Méga-Raichu X et Y sont aussi\nextraordinaires l’un que l’autre !<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5764,
      "rawDecodedUtf16Hex": "004C006500730020004D00E900670061002D005200610069006300680075002000580020006500740020005900200073006F006E0074002000610075007300730069000A00650078007400720061006F007200640069006E006100690072006500730020006C20190075006E00200071007500650020006C2019006100750074007200650020002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Eh oui, Odile ! Comme le dit la règle : les Raichu\nsont TOUS extraordinaires. Sans exception !<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 48,
