  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "¡Oye, tú! ¿Podrías ponerle fin a mi tormento?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 352,
      "rawDecodedUtf16Hex": "00A1004F00790065002C0020007400FA0021002000BF0050006F0064007200ED0061007300200070006F006E00650072006C0065002000660069006E002000610020006D006900200074006F0072006D0065006E0074006F003F001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0002>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 452,
      "rawDecodedUtf16Hex": "00100002BDFF00020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Como puedes observar, soy una artista de pies\na cabeza.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 464,
      "rawDecodedUtf16Hex": "0043006F006D006F00200070007500650064006500730020006F0062007300650072007600610072002C00200073006F007900200075006E00610020006100720074006900730074006100200064006500200070006900650073000A006100200063006100620065007A0061002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Quería pintar el cuadro de un paisaje urbanístico\npara un concurso...<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "005100750065007200ED0061002000700069006E00740061007200200065006C002000630075006100640072006F00200064006500200075006E002000700061006900730061006A006500200075007200620061006E00ED0073007400690063006F000A007000610072006100200075006E00200063006F006E0063007500720073006F002E002E002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "¡Contempla el resultado!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "00A10043006F006E00740065006D0070006C006100200065006C00200072006500730075006C007400610064006F0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "¡Esa zarza que está ahí, justo delante de\nla fuente! ¡Está arruinando la escena!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Pero no consigo cortarla con los ataques\nde mi Pokémon.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "005000650072006F0020006E006F00200063006F006E007300690067006F00200063006F0072007400610072006C006100200063006F006E0020006C006F007300200061007400610071007500650073000A006400650020006D006900200050006F006B00E9006D006F006E002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "¡Uy, me viene un susurro de mi musa!\nSi no se puede cortar, ¿se podrá incinerar?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "¡Hazme ese favor para poder darle rienda suelta\na mi inspiración!<U+0010><U+0001>븁\nUsa un movimiento Pokémon para que esa zarza\nse convierta en meras cenizas.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1556,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Utiliza un movimiento Pokémon para que el fuego\nconsuma esa zarza delante de la fuente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1752,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Gracias, gracias de todo corazón!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "00A10047007200610063006900610073002C0020006700720061006300690061007300200064006500200074006F0064006F00200063006F00720061007A00F3006E0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Por fin voy a poder reanudar mi boceto.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "0050006F0072002000660069006E00200076006F00790020006100200070006F0064006500720020007200650061006E00750064006100720020006D006900200062006F006300650074006F002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡¿Eh?! ¡No puede ser!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1932,
      "rawDecodedUtf16Hex": "00A100BF00450068003F0021002000A1004E006F00200070007500650064006500200073006500720021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡Aparecieron incluso más zarzas alrededor\nde la fuente! ¡Ay, mi pobre corazón!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Cuanto más numerosas sean las zarzas, más\ngrande será el favor que tendré que pedirte.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Utiliza un movimiento Pokémon para calcinar\nesas zarzas de la discordia alrededor de la fuente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Gracias desde lo más profundo de mi corazón!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "00A100470072006100630069006100730020006400650073006400650020006C006F0020006D00E10073002000700072006F00660075006E0064006F0020006400650020006D006900200063006F00720061007A00F3006E0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Ahora voy a poder ponerme manos a la obra\nde nuevo, literalmente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "00410068006F0072006100200076006F00790020006100200070006F00640065007200200070006F006E00650072006D00650020006D0061006E006F0073002000610020006C00610020006F006200720061000A006400650020006E007500650076006F002C0020006C00690074006500720061006C006D0065006E00740065002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡¿Eh?! ¡Esto es inaudito!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "00A100BF00450068003F0021002000A1004500730074006F00200065007300200069006E00610075006400690074006F0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "¡¿Pero cómo es posible?! ¡Volvieron a crecer,\ny hay muchas más!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2848,
      "rawDecodedUtf16Hex": "00A100BF005000650072006F0020006300F3006D006F00200065007300200070006F007300690062006C0065003F0021002000A10056006F006C0076006900650072006F006E002000610020006300720065006300650072002C000A007900200068006100790020006D007500630068006100730020006D00E100730021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Cuanto mayor sea el número de zarzas, mayor\naún será el favor con el que te debo comprometer.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Utiliza un movimiento Pokémon para quemar toda\nesa zarza del demonio adelante de la fuente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 3180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3372,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Mi corazón rebosa de gratitud hacia tu\nmaravillosa persona!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3384,
      "rawDecodedUtf16Hex": "00A1004D006900200063006F00720061007A00F3006E0020007200650062006F00730061002000640065002000670072006100740069007400750064002000680061006300690061002000740075000A006D00610072006100760069006C006C006F0073006100200070006500720073006F006E00610021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Ahora sí que podré retomar mi boceto\nde una vez por todas.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3516,
      "rawDecodedUtf16Hex": "00410068006F007200610020007300ED002000710075006500200070006F0064007200E90020007200650074006F006D006100720020006D006900200062006F006300650074006F000A0064006500200075006E0061002000760065007A00200070006F007200200074006F006400610073002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Pero, francamente, ¿qué estará pasando?\n¿Cómo pueden aparecer zarzas así, de la nada?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "¡Ah, es Phantump, el Pokémon! ¿Acaso era él\nquien me estaba saboteando?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Phannn.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3976,
      "rawDecodedUtf16Hex": "005000680061006E006E006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "¿Por qué me torturas así? Con lo apurada que voy\npara el concurso...<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3992,
      "rawDecodedUtf16Hex": "00BF0050006F007200200071007500E90020006D006500200074006F00720074007500720061007300200061007300ED003F00200043006F006E0020006C006F00200061007000750072006100640061002000710075006500200076006F0079000A007000610072006100200065006C00200063006F006E0063007500720073006F002E002E002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¡Oh, siento cómo las musas me visitan de nuevo!\n¡Lo veo, lo veo: Phantump y la fuente!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Un Phantump realzando la fuente representa toda\nuna metáfora de la Ciudad Luminalia actual.<U+0010><U+0001>븁\n¡Phantump, quiero que seas mi modelo!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "¡¿Phannn?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4600,
      "rawDecodedUtf16Hex": "00A100BF005000680061006E006E006E003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¡Juntos crearemos para la posteridad la obra de\narte del siglo, destinada a decorar las galerías<U+0010><U+0001>븀\ndel Museo de Luminalia!<U+0010><U+0001>븁\n¡No muevas ni una ramita hasta que dé\nla pincelada final, Phantump!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 199
    },
    {
      "displayText": "Phannn...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5024,
      "rawDecodedUtf16Hex": "005000680061006E006E006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "¡Gracias! ¡Tu intervención me servirá en bandeja\nde plata la victoria en el concurso pictórico!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5044,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5244,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Las travesuras de Phantump reavivaron aún\nmás la llama de mi pasión artística!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5256,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Phannn.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5424,
      "rawDecodedUtf16Hex": "005000680061006E006E006E002E0000",
