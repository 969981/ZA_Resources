      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "I don’t know where I am or why, but I’ll still make\nPokémon feel better with our Fire Blast Roast.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 5184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
