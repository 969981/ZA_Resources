      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "¡Esto no es una obra de caridad!\nNo nos hagas perder el tiempo...<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
