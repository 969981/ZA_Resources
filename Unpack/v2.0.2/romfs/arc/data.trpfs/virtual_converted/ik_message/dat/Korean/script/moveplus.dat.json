      "rawDecodedUtf16Hex": "C219B2ECC758C528B85C000AD3ECCF13BAACC7740020BC30C6B0ACE00020C788B2940020AE30C220C74400100001BE00000AAE30C220D50CB7ECC2A4B85C0020C4F80020C2180020C788AC8C0020B3C4C640B4DCB9B4AE4CC694003F00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
