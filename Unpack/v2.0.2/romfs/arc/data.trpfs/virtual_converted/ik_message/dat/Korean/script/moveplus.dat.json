      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "기술플러스가 필요하면\n언제든지 말씀해 주세요.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
