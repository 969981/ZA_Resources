      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "Aspettate! Se vuoi due fate coppia, allora io\naiuterò <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "0041007300700065007400740061007400650021002000530065002000760075006F006900200064007500650020006600610074006500200063006F0070007000690061002C00200061006C006C006F0072006100200069006F000A00610069007500740065007200F2002000100002010000000021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>Ā<U+0000>, quando sei pront<U+0010><U+0003>ᄀÿāoa diamo\nil via alla lotta!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "00100002BD0600000010000201000000002C0020007100750061006E0064006F0020007300650069002000700072006F006E007400100003110000FF0101006F00610020006400690061006D006F000A0069006C002000760069006100200061006C006C00610020006C006F0074007400610021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Andiamo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "0041006E006400690061006D006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Aspetta...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "0041007300700065007400740061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Non sappiamo bene cosa sta succedendo,\ndel resto.<U+0010><U+0001>븁\nQuando ti sarai chiarit<U+0010><U+0003>ᄀÿāoa le idee, parla pure\ncon quelle due dei MLL.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "Mostriamo a quelle due dei MLL quanto è forte\nil Team MZ!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "004D006F00730074007200690061006D006F002000610020007100750065006C006C0065002000640075006500200064006500690020004D004C004C0020007100750061006E0074006F002000E800200066006F007200740065000A0069006C0020005400650061006D0020004D005A0021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>M<U+0010><U+0003>ᄀÿଇonsieurademoiselle <U+0010><U+0002>Ā<U+0000>.\nSi misuri con me.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1612,
      "rawDecodedUtf16Hex": "00100002BD060000004D00100003110000FF0B07006F006E00730069006500750072006100640065006D006F006900730065006C006C006500200010000201000000002E000A005300690020006D0069007300750072006900200063006F006E0020006D0065002E00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Non vorrai mica tirarti indietro, vero?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1728,
      "rawDecodedUtf16Hex": "004E006F006E00200076006F00720072006100690020006D0069006300610020007400690072006100720074006900200069006E00640069006500740072006F002C0020007600650072006F003F00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Lottiamo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "004C006F0074007400690061006D006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Aspetta...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "0041007300700065007400740061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Le piace tenermi sulle spine... Mi aspetto\nuna risposta soddisfacente, che sia chiaro!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1860,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Al mio fianco ho Delfia. Ciò non può che\nsignificare che vinceremo!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "0041006C0020006D0069006F0020006600690061006E0063006F00200068006F002000440065006C006600690061002E00200043006900F20020006E006F006E00200070007500F20020006300680065000A007300690067006E00690066006900630061007200650020006300680065002000760069006E0063006500720065006D006F002100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Affrontarci è nel nostro destino!\nNon accetterò un rifiuto.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2188,
      "rawDecodedUtf16Hex": "0041006600660072006F006E00740061007200630069002000E80020006E0065006C0020006E006F007300740072006F002000640065007300740069006E006F0021000A004E006F006E00200061006300630065007400740065007200F200200075006E0020007200690066006900750074006F002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Andiamo! Ruberò i riflettori alla signorina Viola!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "0041006E006400690061006D006F002100200052007500620065007200F2002000690020007200690066006C006500740074006F0072006900200061006C006C00610020007300690067006E006F00720069006E0061002000560069006F006C0061002100100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Quando sei pront<U+0010><U+0003>ᄀÿāoa a lottare, fallo presente\na quelle due dei MLL.<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2428,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2580,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Clefable, noi celebrità abbiamo il dovere di\nguidare la popolazione!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2592,
      "rawDecodedUtf16Hex": "0043006C0065006600610062006C0065002C0020006E006F0069002000630065006C0065006200720069007400E0002000610062006200690061006D006F00200069006C00200064006F0076006500720065002000640069000A00670075006900640061007200650020006C006100200070006F0070006F006C0061007A0069006F006E0065002100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Ecco il mio asso nella manica! Spacca tutto\ncon la tua megaevoluzione, Dragalge!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Forza, Starmie. Mostriamo loro i nostri migliori\npassi di danza!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2912,
      "rawDecodedUtf16Hex": "0046006F0072007A0061002C00200053007400610072006D00690065002E0020004D006F00730074007200690061006D006F0020006C006F0072006F002000690020006E006F00730074007200690020006D00690067006C0069006F00720069000A00700061007300730069002000640069002000640061006E007A00610021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3052,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Wooow! Abbiamo vinto! Abbiamo vinto,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3064,
      "rawDecodedUtf16Hex": "00100002BD0600000057006F006F006F00770021002000410062006200690061006D006F002000760069006E0074006F0021002000410062006200690061006D006F002000760069006E0074006F002C000A00100002010000000021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "È naturale che m<U+0010><U+0003>ᄀÿଇonsieurademoiselle <U+0010><U+0002>Ā<U+0000>\nsi distingua, ma anche le movenze del suo Starmie<U+0010><U+0001>븀\nmi hanno alquanto stupita, mademoiselle Cerril!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 10,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 150
    },
    {
      "displayText": "Signorina Viola.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3468,
      "rawDecodedUtf16Hex": "005300690067006E006F00720069006E0061002000560069006F006C0061002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Chi pratica il ballo ha più stabilità e sa controllare\nmeglio il proprio corpo.<U+0010><U+0001>븁\nPer questa ragione è altrettanto portato per le arti\nmarziali.<U+0010><U+0001>븁\nDi conseguenza la prestanza fisica dell’Allenatore\ninfluenza anche i movimenti del suo Pokémon.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 249
    },
    {
      "displayText": "Perché non coglie l’occasione per prendere\nqualche lezione di danza, signorina Viola?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Delfia, ti stai prendendo gioco di me...? Sai bene\nquanto è disastroso il mio senso del ritmo.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Glielo insegnerò io, allora!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4392,
      "rawDecodedUtf16Hex": "0047006C00690065006C006F00200069006E007300650067006E0065007200F200200069006F002C00200061006C006C006F007200610021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "... La ringrazio.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4460,
      "rawDecodedUtf16Hex": "002E002E002E0020004C0061002000720069006E006700720061007A0069006F002E00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "A lei, m<U+0010><U+0003>ᄀÿଇonsieurademoiselle <U+0010><U+0002>Ā<U+0000>, come\nprova della sua vittoria.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 8,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 4504,
      "rawDecodedUtf16Hex": "00410020006C00650069002C0020006D00100003110000FF0B07006F006E00730069006500750072006100640065006D006F006900730065006C006C006500200010000201000000002C00200063006F006D0065000A00700072006F00760061002000640065006C006C0061002000730075006100200076006900740074006F007200690061002E00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Hai ricevuto l’Abito di Viola!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 4652,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F0020006C20190041006200690074006F002000640069002000560069006F006C006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> e Viola con gli stessi vestiti?\nNella Luminopoli dimensionale può succedere<U+0010><U+0001>븀\ndavvero di tutto!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Se la Viola di questa dimensione è dispiaciuta\ndi non avere alcun senso del ritmo, dev’essere<U+0010><U+0001>븀\ncosì anche per quella della Luminopoli reale, no?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4928,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 151
    },
    {
      "displayText": "E dire che ho sempre cercato di evitare i balli\ndi gala, quando potevo...<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 5232,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Io mi diletto anche nel ballo di tanto in tanto.\nSe la signorina Viola lo gradisce, posso darle<U+0010><U+0001>븀\nqualche lezione.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 5388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    }
