      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "果然厉害……<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "679C713653895BB32026202600100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "那边那位，\n简单说明来意吧。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "90A38FB990A34F4DFF0C000A7B8053558BF4660E6765610F5427300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "……原来如此。\n确实令人担心。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1348,
      "rawDecodedUtf16Hex": "20262026539F676559826B643002000A786E5B9E4EE44EBA62C55FC3300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "听过之后，我已掌握\n要找的耿鬼性格如何。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1388,
