      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "让我的搭档水晶灯火灵\n来追踪它的气息。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "8BA962117684642D68636C346676706F706B7075000A67658FFD8E2A5B8376846C14606F300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "不过说到幽灵属性的宝可梦，\n它们有的会在一处扎根，<U+0010><U+0001>븀\n有的则四处游荡。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "4E0D8FC78BF452305E7D70755C5E602776845B9D53EF68A6FF0C000A5B834EEC670976844F1A57284E005904624E6839FF0C00100001BE00000A67097684521956DB59046E388361300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "所以我话说在前面。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "62404EE562118BDD8BF45728524D9762300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "别太期待。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "522B592A671F5F85300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "是啊，我只想知道它过得好就行。<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "662F554AFF0C621153EA60F377E590535B838FC75F97597D5C31884C3002001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
