      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Bueno, si algún día quieres probar un nuevo look\npara tu Furfrou, ¡que no te dé corte pedírnoslo!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
