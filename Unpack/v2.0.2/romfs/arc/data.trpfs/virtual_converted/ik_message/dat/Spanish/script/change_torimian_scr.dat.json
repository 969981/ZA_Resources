      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Lo siento, chaval<U+0010><U+0003>ᄀÿĀa, pero yo es que solo tengo\nojos para los Furfrou. ¡Como lo oyes!",
      "escapedControlUnits": 2,
