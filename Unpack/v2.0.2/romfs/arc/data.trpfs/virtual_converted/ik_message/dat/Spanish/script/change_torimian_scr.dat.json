      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "¿Quieres volvérselo a dejar al natural? ¿Segur<U+0010><U+0003>ᄀÿāoa?\nEn fin, ¡tú mandas!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 4,
