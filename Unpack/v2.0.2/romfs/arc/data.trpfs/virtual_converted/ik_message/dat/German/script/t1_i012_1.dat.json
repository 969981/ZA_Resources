      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1432,
      "rawDecodedUtf16Hex": "00440061007300200048006F00740065006C0020007600650072006600FC0067007400200073006F006700610072002000FC006200650072002000650069006E0065006E000A00530063006800F6006E0068006500690074007300730061006C006F006E0020006600FC007200200050006F006B00E9006D006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Auch der Trainingsraum für\nPokémon ist allererste Sahne!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "0041007500630068002000640065007200200054007200610069006E0069006E00670073007200610075006D0020006600FC0072000A0050006F006B00E9006D006F006E002000690073007400200061006C006C00650072006500720073007400650020005300610068006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
