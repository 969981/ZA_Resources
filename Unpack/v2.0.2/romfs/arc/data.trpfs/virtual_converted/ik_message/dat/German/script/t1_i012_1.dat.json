      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "005700650072002000640065006D0020004D0069006E0069006D0061006C00690073006D0075007300200066007200F6006E0074002C0020006400650072000A0073006F006C006C007400650020007300690063006800200069006D00200048006F00740065006C002000650069006E007100750061007200740069006500720065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
