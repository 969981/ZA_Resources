      "index": 13,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "0049006300680020006D00F60063006800740065002000650069006E00650020005300630068006C0065006D006D006500720074006F00750072000A0064007500720063006800200061006C006C0065002000520065007300740061007500720061006E007400730020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Wo ich schon mal in Illumina City\nbin, will ich auch Pokémon fangen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2108,
      "rawDecodedUtf16Hex": "0057006F00200069006300680020007300630068006F006E0020006D0061006C00200069006E00200049006C006C0075006D0069006E006100200043006900740079000A00620069006E002C002000770069006C006C00200069006300680020006100750063006800200050006F006B00E9006D006F006E002000660061006E00670065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Man kann es in der kurzen Zeit\neinfach nicht allen recht machen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2248,
      "rawDecodedUtf16Hex": "004D0061006E0020006B0061006E006E00200065007300200069006E00200064006500720020006B00750072007A0065006E0020005A006500690074000A00650069006E00660061006300680020006E006900630068007400200061006C006C0065006E0020007200650063006800740020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Meine Freunde wollen von mir alle\neine Kleinigkeit aus dem Urlaub...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "004D00650069006E006500200046007200650075006E0064006500200077006F006C006C0065006E00200076006F006E0020006D0069007200200061006C006C0065000A00650069006E00650020004B006C00650069006E00690067006B0065006900740020006100750073002000640065006D002000550072006C006100750062002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Hey, wollen wir uns heimlich\nauf ’ne IGKC-Party schleichen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "004800650079002C00200077006F006C006C0065006E002000770069007200200075006E00730020006800650069006D006C006900630068000A00610075006600202019006E0065002000490047004B0043002D005000610072007400790020007300630068006C00650069006300680065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Bloß nicht! Stell dir vor,\nwir werden erwischt...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2640,
      "rawDecodedUtf16Hex": "0042006C006F00DF0020006E006900630068007400210020005300740065006C006C002000640069007200200076006F0072002C000A007700690072002000770065007200640065006E002000650072007700690073006300680074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Hast du schon einen Trainingsplan für dein\nnächstes Pokémon-Team ausgetüftelt?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Ich bin noch unentschlossen!<U+0010><U+0001>븁\nSoll ich bei den Attacken auf Ausgewogenheit\nachten oder lieber alles auf einen Typ setzen...?",
      "escapedControlUnits": 2,
