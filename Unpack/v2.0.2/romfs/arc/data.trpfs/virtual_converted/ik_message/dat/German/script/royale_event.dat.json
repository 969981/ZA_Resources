  "initialKey": 0,
  "messages": [
    {
      "displayText": "Eine Belohnung\nfür den Sieg!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 420,
      "rawDecodedUtf16Hex": "00450069006E0065002000420065006C006F0068006E0075006E0067000A006600FC0072002000640065006E00200053006900650067002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Ich hab hier eine Lieferung für <U+0010><U+0004>ᄀÿฌ<U+0000>den Gewinnerdie Gewinnerin.\nUnd zwar <U+0010><U+0003>ᘂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002>!",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Ein Geschenk für\ndeinen Sieg!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 680,
      "rawDecodedUtf16Hex": "00450069006E0020004700650073006300680065006E006B0020006600FC0072000A006400650069006E0065006E00200053006900650067002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Ich habe eine Lieferung für <U+0010><U+0004>ᄀÿఊ<U+0000>den Siegerdie Siegerin.\nHier, <U+0010><U+0003>ᘂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002>!",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Soll ich dein<U+0010><U+0003>ᄁýĀe\nPokémon heilen?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "0053006F006C006C00200069006300680020006400650069006E00100003110100FD01000065000A0050006F006B00E9006D006F006E0020006800650069006C0065006E003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Dann machen wir dein<U+0010><U+0003>ᄁýĀe Pokémon mal wieder fit!\nDas liegt mir sowieso besser...",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Lust auf einen Kaffee?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "004C0075007300740020006100750066002000650069006E0065006E0020004B00610066006600650065003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Hier, ein edles Schlückchen, das dein<U+0010><U+0003>ᄁýĀe Pokémon\nwieder fit und munter macht.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Wie wär’s mit\neinem Kaffee?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "0057006900650020007700E40072201900730020006D00690074000A00650069006E0065006D0020004B00610066006600650065003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Hier, ein Durstlöscher für dein<U+0010><U+0003>ᄁýĀe Pokémon.\nWenn <U+0010><U+0003>ᄁý̂essie den trink<U+0010><U+0003>ᄁýȁten, w<U+0010><U+0003>ᄁýआird eserden sie wieder fit.",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Hast du schon unseren\nfeinsten Kaffee probiert?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "00480061007300740020006400750020007300630068006F006E00200075006E0073006500720065006E000A006600650069006E007300740065006E0020004B00610066006600650065002000700072006F00620069006500720074003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Eine Tasse von unserem berühmten Röstkaffee\n„Feuersturm“ und schon geht es deine<U+0010><U+0003>ᄁýāmn<U+0010><U+0001>븀\nPokémon wieder super!",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Probiere unsere\nKaffeespezialität!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2096,
      "rawDecodedUtf16Hex": "00500072006F0062006900650072006500200075006E0073006500720065000A004B00610066006600650065007300700065007A00690061006C0069007400E40074002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Mit dem besonderen Röstkaffee „Hitzekoller“ aus\ndem Imbiss Nouveau geht es deine<U+0010><U+0003>ᄁýāmn Pokémon<U+0010><U+0001>븀\ngleich wieder gut.",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Ich hab eine Bonuskarte\nfür dich!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2432,
      "rawDecodedUtf16Hex": "0049006300680020006800610062002000650069006E006500200042006F006E00750073006B0061007200740065000A006600FC007200200064006900630068002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Ich geb dir die beste Karte, die ich heute Abend\nin die Finger bekommen hab!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Preismedaillen\nfür dich!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2684,
      "rawDecodedUtf16Hex": "00500072006500690073006D0065006400610069006C006C0065006E000A006600FC007200200064006900630068002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Meine komplette Medaillensammlung soll dir\ngehören. Hier, bitte sehr.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2764,
      "rawDecodedUtf16Hex": "004D00650069006E00650020006B006F006D0070006C00650074007400650020004D0065006400610069006C006C0065006E00730061006D006D006C0075006E006700200073006F006C006C0020006400690072000A00670065006800F600720065006E002E00200048006900650072002C00200062006900740074006500200073006500680072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Preismedaillen\ngefällig?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2904,
      "rawDecodedUtf16Hex": "00500072006500690073006D0065006400610069006C006C0065006E000A00670065006600E4006C006C00690067003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Medaillen kann man ja einfach wieder sammeln,\nalso kannst du meine haben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2984,
      "rawDecodedUtf16Hex": "004D0065006400610069006C006C0065006E0020006B0061006E006E0020006D0061006E0020006A0061002000650069006E00660061006300680020007700690065006400650072002000730061006D006D0065006C006E002C000A0061006C0073006F0020006B0061006E006E007300740020006400750020006D00650069006E006500200068006100620065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Möchtest du meine\nPreismedaillen?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3132,
      "rawDecodedUtf16Hex": "004D00F60063006800740065007300740020006400750020006D00650069006E0065000A00500072006500690073006D0065006400610069006C006C0065006E003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Als Preis für deinen Sieg überreiche ich dir meine\nMedaillen. Mit viel Liebe von Madame Violette!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Willst du etwa\nmeine Preismedaillen?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3424,
      "rawDecodedUtf16Hex": "00570069006C006C0073007400200064007500200065007400770061000A006D00650069006E0065002000500072006500690073006D0065006400610069006C006C0065006E003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Unter uns Kampf-Connaisseurs gibt es einen\nWettstreit darum, wer die meisten Medaillen<U+0010><U+0001>븀\nin einer einzigen Nacht erkämpfen kann.<U+0010><U+0001>븁\nAusnahmsweise teile ich meine mit dir.",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 172
    },
    {
      "displayText": "Du erhältst Preismedaillen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3872,
      "rawDecodedUtf16Hex": "00440075002000650072006800E4006C007400730074002000500072006500690073006D0065006400610069006C006C0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Du erhältst <U+0010><U+0003>ᘆ<U+0002><U+0000><U+0010><U+0002>＀<U+0008><U+0010><U+0002>Ċ<U+0002><U+0010><U+0002>＀<U+0000>!",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3928,
      "rawDecodedUtf16Hex": "00440075002000650072006800E4006C00740073007400200010000316060002000000100002FF00000800100002010A000200100002FF00000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Ich hätte da ein paar\nDimensionsbeeren für dich!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3992,
      "rawDecodedUtf16Hex": "0049006300680020006800E4007400740065002000640061002000650069006E00200070006100610072000A00440069006D0065006E00730069006F006E007300620065006500720065006E0020006600FC007200200064006900630068002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ich habe hier ein paar\n<U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002><U+0010><U+0001>븀\naufgesammelt.<U+0010><U+0001>븁\nKomm, ich geb dir welche ab.",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Möchtest du ein paar meiner\nDimensionsbeeren haben?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4288,
      "rawDecodedUtf16Hex": "004D00F6006300680074006500730074002000640075002000650069006E002000700061006100720020006D00650069006E00650072000A00440069006D0065006E00730069006F006E007300620065006500720065006E00200068006100620065006E003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Weil du so stark bist, schenke ich dir ein paar\n<U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002>!",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4420,
      "rawDecodedUtf16Hex": "005700650069006C00200064007500200073006F00200073007400610072006B00200062006900730074002C00200073006300680065006E006B006500200069006300680020006400690072002000650069006E00200070006100610072000A001000011001001000020110000200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Soll ich dein<U+0010><U+0003>ᄁýĀe Pokémon\nfür dich heilen?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4536,
      "rawDecodedUtf16Hex": "0053006F006C006C00200069006300680020006400650069006E00100003110100FD0100006500200050006F006B00E9006D006F006E000A006600FC0072002000640069006300680020006800650069006C0065006E003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Auch hier im rätselhaften Dimensions-Illumina\nmache ich Pokémon wieder fit!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4656,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Lust auf einen außerdimensional\nguten Kaffee?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4808,
      "rawDecodedUtf16Hex": "004C0075007300740020006100750066002000650069006E0065006E00200061007500DF0065007200640069006D0065006E00730069006F006E0061006C000A0067007500740065006E0020004B00610066006600650065003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Egal, in welcher Dimension man sich befindet:\nKaffee macht müde Pokémon munter!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4928,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Wie wär’s mit\neinem Kaffee?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 5088,
      "rawDecodedUtf16Hex": "0057006900650020007700E40072201900730020006D00690074000A00650069006E0065006D0020004B00610066006600650065003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Das ist unser spezieller Dimensions-Kaffee.\nEin Schluck genügt und du fühlst dich wie neu.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Probiere unsere\nKaffeespezialität!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5356,
      "rawDecodedUtf16Hex": "00500072006F0062006900650072006500200075006E0073006500720065000A004B00610066006600650065007300700065007A00690061006C0069007400E40074002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Warum ich hier bin, ist mir ein Rätsel...\nIst aber auch egal.<U+0010><U+0001>븁\nJedenfalls macht unser Röstkaffee „Feuersturm“\ndein<U+0010><U+0003>ᄁýĀe Pokémon wieder fit!",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 143
    },
    {
      "displayText": "Probiere unsere\nKaffeespezialität!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5744,
      "rawDecodedUtf16Hex": "00500072006F0062006900650072006500200075006E0073006500720065000A004B00610066006600650065007300700065007A00690061006C0069007400E40074002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Selbst in einer anderen Dimension servieren wir\nbeim Imbiss Nouveau etwas ganz Besonderes:<U+0010><U+0001>븁\nMit unserem Röstkaffee „Hitzekoller“ geht es\ndeine<U+0010><U+0003>ᄁýāmn Pokémon gleich wieder gut.",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 179
    },
    {
      "displayText": "Karten hab ich leider keine, aber\nich hab was anderes für dich!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 6204,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002> sind\nübrigens<U+0010><U+0001>븀\nsuperduperselten!",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 6360,
      "rawDecodedUtf16Hex": "00100002BD0600000010000110010010000201100002002000730069006E0064000A00FC00620072006900670065006E007300100001BE00000A007300750070006500720064007500700065007200730065006C00740065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ich habe sehr\nkostbare Items!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6456,
      "rawDecodedUtf16Hex": "0049006300680020006800610062006500200073006500680072000A006B006F0073007400620061007200650020004900740065006D0073002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002> sind\nausgesprochen<U+0010><U+0001>븀\nwertvoll!<U+0010><U+0001>븀\nIch besitze davon aber natürlich reichlich.",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6544,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Ich habe etwas\nSchönes für dich!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6728,
      "rawDecodedUtf16Hex": "00490063006800200068006100620065002000650074007700610073000A00530063006800F6006E006500730020006600FC007200200064006900630068002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Diese <U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002> sind\nvon<U+0010><U+0001>븀\nenormem<U+0010><U+0001>븀\nWert.<U+0010><U+0001>븀\nWarum? Weil sie aus meinem Besitz<U+0010><U+0001>븀\nstammen, natürlich!",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 6824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "Ich habe ein Geschenk\nfür dich!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 7040,
      "rawDecodedUtf16Hex": "00490063006800200068006100620065002000650069006E0020004700650073006300680065006E006B000A006600FC007200200064006900630068002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Auch in fremden Dimensionen zeigt sich die IGKC\nspendabel. Bitte sehr,<U+0010><U+0001>븀\n<U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002>!",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 7132,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Hättest du Interesse an\neinem tollen Geschenk?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 7308,
      "rawDecodedUtf16Hex": "004800E40074007400650073007400200064007500200049006E007400650072006500730073006500200061006E000A00650069006E0065006D00200074006F006C006C0065006E0020004700650073006300680065006E006B003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Violettes Großzügigkeit reicht über dimensionale\nGrenzen hinaus!<U+0010><U+0001>븁\nHier, nimm diese <U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002>.",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 7432,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Ich mag nur ein Hologramm sein,\naber ich habe etwas für dich!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 7620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>An so einem seltsamen Ort\n<U+0010><U+0001>ခ<U+0010><U+0002>Đ<U+0002><U+0010><U+0001>븀\nvon<U+0010><U+0001>븀\neinem<U+0010><U+0001>븀\nHologramm<U+0010><U+0001>븀\nzu kriegen...<U+0010><U+0001>븀\nKomisch, oder?",
      "escapedControlUnits": 18,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 7772,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
