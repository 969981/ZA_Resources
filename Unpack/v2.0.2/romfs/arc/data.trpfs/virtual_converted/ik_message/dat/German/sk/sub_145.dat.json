  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Sorry, das kommt jetzt etwas plötzlich, aber\nkönntest du mir helfen, jemanden zu finden?<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 300,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Ich bin auf der Suche nach einem bestimmten\nDrachenprofi. Ihr Partner-Pokémon ist Tandrak.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Sie ist recht groß und hat grüne Haare.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 680,
      "rawDecodedUtf16Hex": "0053006900650020006900730074002000720065006300680074002000670072006F00DF00200075006E0064002000680061007400200067007200FC006E0065002000480061006100720065002E00100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Und sie rockt wahrscheinlich ein richtig wildes\nStreetwear-Outfit!<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "0055006E0064002000730069006500200072006F0063006B00740020007700610068007200730063006800650069006E006C006900630068002000650069006E00200072006900630068007400690067002000770069006C006400650073000A0053007400720065006500740077006500610072002D004F00750074006600690074002100100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Wenn dir so jemand über den Weg läuft, sag mir\nbitte direkt Bescheid!<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "00570065006E006E002000640069007200200073006F0020006A0065006D0061006E0064002000FC006200650072002000640065006E00200057006500670020006C00E4007500660074002C00200073006100670020006D00690072000A0062006900740074006500200064006900720065006B0074002000420065007300630068006500690064002100100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Ich suche einen bestimmten Drachenprofi mit\neinem Tandrak.<U+0010><U+0001>븁\nSie ist recht groß, hat grüne Haare und trägt\nvermutlich wilde Streetwear-Klamotten.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 151
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hey, was gibt’s?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "004800650079002C00200077006100730020006700690062007420190073003F00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Was ist DAS bitte für ein Outfit?!<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1420,
      "rawDecodedUtf16Hex": "005700610073002000690073007400200044004100530020006200690074007400650020006600FC0072002000650069006E0020004F00750074006600690074003F002100100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Ich trag, was ich will, klar? Schon mal was von\nTaktgefühl gehört?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "00490063006800200074007200610067002C00200077006100730020006900630068002000770069006C006C002C0020006B006C00610072003F0020005300630068006F006E0020006D0061006C002000770061007300200076006F006E000A00540061006B007400670065006600FC0068006C002000670065006800F600720074003F00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Moment, Martia? Ich glaub’s nicht!\nLange nicht gesehen!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1644,
      "rawDecodedUtf16Hex": "004D006F006D0065006E0074002C0020004D00610072007400690061003F002000490063006800200067006C006100750062201900730020006E00690063006800740021000A004C0061006E006700650020006E00690063006800740020006700650073006500680065006E002100100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Meine Pokémon und ich haben trainiert wie\nverrückt... Damit ich dich endlich besiegen kann.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Ich will doch mal hoffen, dass du trainiert hast,\nsonst dürftest du dich nicht Kämpferin nennen.<U+0010><U+0001>븁\nIch hab seit damals übrigens auch ordentlich an\nStärke zugelegt.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 169
    },
    {
      "displayText": "Schön für dich! Ich werde dich trotzdem besiegen\nund dann erfüllst du gefälligst dein Versprechen<U+0010><U+0001>븀\nvon damals!<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Astera! Vergnügt ihr euch hier etwa ohne mich?<U+0010><U+0001>븁\nBei solch amüsanten Angelegenheiten versteht\nes sich von selbst, dass ich mitwirke.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Hä...?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "004800E4002E002E002E003F00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Misch dich nicht in unseren Kampf ein!<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2832,
      "rawDecodedUtf16Hex": "004D0069007300630068002000640069006300680020006E006900630068007400200069006E00200075006E0073006500720065006E0020004B0061006D00700066002000650069006E002100100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Wer sich Astera stellen will, braucht zunächst\nmeine ausdrückliche Erlaubnis.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Deine einzige Option ist also, dich mit\n<U+0010><U+0002>Ā<U+0000><U+0010><U+0001>븀\nzu<U+0010><U+0001>븀\nverbünden<U+0010><U+0001>븀\nund<U+0010><U+0001>븀\ngegen<U+0010><U+0001>븀\nuns<U+0010><U+0001>븀\nbeide<U+0010><U+0001>븀\nanzutreten!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 23,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3324,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Es ist unsere Pflicht als VIPs, den Menschen den\nWeg zu weisen. Los, Pixi!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Dann lass ich mal meine Geheimwaffe aus dem\nSack: Tandrak, Mega-Entwicklung!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3660,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich sehe schon... Du hast wirklich Ernst gemacht\nmit dem Training.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3672,
      "rawDecodedUtf16Hex": "004900630068002000730065006800650020007300630068006F006E002E002E002E002000440075002000680061007300740020007700690072006B006C006900630068002000450072006E00730074002000670065006D0061006300680074000A006D00690074002000640065006D00200054007200610069006E0069006E0067002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Natürlich hab ich das! Aber diesen Sieg verdanke\nich <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3816,
      "rawDecodedUtf16Hex": "004E0061007400FC0072006C006900630068002000680061006200200069006300680020006400610073002100200041006200650072002000640069006500730065006E00200053006900650067002000760065007200640061006E006B0065000A00690063006800200010000201000000002E00100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "So oder so, gewonnen ist gewonnen. Jetzt ist es\nan dir, dein Versprechen von damals einzulösen.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Astera! Werde meine Trainingspartnerin!<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4144,
      "rawDecodedUtf16Hex": "00410073007400650072006100210020005700650072006400650020006D00650069006E006500200054007200610069006E0069006E006700730070006100720074006E006500720069006E002100100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Also, was das angeht...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4232,
      "rawDecodedUtf16Hex": "0041006C0073006F002C0020007700610073002000640061007300200061006E0067006500680074002E002E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Ich kann mein Versprechen leider nicht halten...<U+0010><U+0001>븁\nEs tut mir leid, aber ich habe meine\nTrainingspartnerin schon gefunden.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Aber mit Gwynn hast du dich doch auch\nzusammengeschlossen...?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4544,
      "rawDecodedUtf16Hex": "00410062006500720020006D006900740020004700770079006E006E002000680061007300740020006400750020006400690063006800200064006F0063006800200061007500630068000A007A007500730061006D006D0065006E00670065007300630068006C006F007300730065006E002E002E002E003F00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Also, das musste ich ja auch, das war für\nMademoiselle Antja...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4676,
      "rawDecodedUtf16Hex": "0041006C0073006F002C00200064006100730020006D0075007300730074006500200069006300680020006A006100200061007500630068002C002000640061007300200077006100720020006600FC0072000A004D006100640065006D006F006900730065006C006C006500200041006E0074006A0061002E002E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Oh... Da hab ich wohl zu hart und zu lang trainiert,\nund dabei zu viel Zeit verstreichen lassen.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Ich akzeptiere deine Entscheidung, Astera.\nDas Outfit steht dir übrigens doch ziemlich gut.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 5016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Danke für alles, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 5208,
      "rawDecodedUtf16Hex": "00440061006E006B00650020006600FC007200200061006C006C00650073002C00200010000201000000002E00100002011401B60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "*seufz* Ob es irgendwo da draußen einen\nperfekten Trainingspartner für mich gibt?<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 5264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "<U+0010><U+0002>뷿#",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5436,
      "rawDecodedUtf16Hex": "00100002BDFF00230000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Am liebsten hätte ich einen Trainingspartner,\nder jederzeit kampfbereit ist und auf den immer<U+0010><U+0001>븀\nVerlass ist.<U+0010><U+0002>Ĕƶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    }
