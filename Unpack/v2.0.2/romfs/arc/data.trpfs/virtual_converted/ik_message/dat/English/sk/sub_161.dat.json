  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Oh, look—now <U+0010><U+0002>Ā<U+0000>’s here\ntoo!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "00100002BD060000004F0068002C0020006C006F006F006B2014006E006F0077002000100002010000002019007300200068006500720065000A0074006F006F0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Whaddya doin’ bargin’ in on our precious family\ntime in hyperspace, kid?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Pops, this ain’t exactly quality time...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "0050006F00700073002C00200074006800690073002000610069006E20190074002000650078006100630074006C00790020007100750061006C006900740079002000740069006D0065002E002E002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Wait a moment! I’ve got something I want to tell\nyou, Canari!<U+0010><U+0001>븁\n<U+0010><U+0002>Ā<U+0000> gets to talk to you\nplenty,<U+0010><U+0001>븀\nbut<U+0010><U+0001>븀\nI<U+0010><U+0001>븀\nnever<U+0010><U+0001>븀\nget<U+0010><U+0001>븀\na chance...<U+0010><U+0001>븁\nIs it just a matter of proving my worth?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 23,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 193
    },
    {
      "displayText": "If so, I challenge you to a two-on-two battle,\nleaders of DYN4MO!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "0049006600200073006F002C002000490020006300680061006C006C0065006E0067006500200079006F007500200074006F00200061002000740077006F002D006F006E002D00740077006F00200062006100740074006C0065002C000A006C0065006100640065007200730020006F0066002000440059004E0034004D004F0021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Sure, I’m down if <U+0010><U+0002>Ā<U+0000> is.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "0053007500720065002C002000492019006D00200064006F0077006E00200069006600200010000201000000002000690073002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Let’s do it!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "004C006500742019007300200064006F00200069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Rain check?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "005200610069006E00200063006800650063006B003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "We wouldn’t need a rain check if you wouldn’t\nrain on my parade...<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "0057006500200077006F0075006C0064006E201900740020006E006500650064002000610020007200610069006E00200063006800650063006B00200069006600200079006F007500200077006F0075006C0064006E20190074000A007200610069006E0020006F006E0020006D00790020007000610072006100640065002E002E002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "With Scrafty and the rest of my team, I know I\ncan—no, WILL—win!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "00570069007400680020005300630072006100660074007900200061006E00640020007400680065002000720065007300740020006F00660020006D00790020007400650061006D002C002000490020006B006E006F007700200049000A00630061006E2014006E006F002C002000570049004C004C201400770069006E0021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Guess when I’m here, I’ll just battle whatever\nCanatic challenges me.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "004700750065007300730020007700680065006E002000492019006D00200068006500720065002C002000492019006C006C0020006A00750073007400200062006100740074006C0065002000770068006100740065007600650072000A00430061006E00610074006900630020006300680061006C006C0065006E0067006500730020006D0065002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "I stand in for Canari enough to be practically the\nreal deal! So you sorta get to fight TWO Canaris!<U+0010><U+0001>븀\nCount yer lucky stars, kid!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1728,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "Let’s battle!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2000,
      "rawDecodedUtf16Hex": "004C006500742019007300200062006100740074006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Give me a minute",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2028,
      "rawDecodedUtf16Hex": "00470069007600650020006D0065002000610020006D0069006E0075007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Come on—battle me! You really wanna throw this\nchance away? Psh...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2064,
      "rawDecodedUtf16Hex": "0043006F006D00650020006F006E20140062006100740074006C00650020006D0065002100200059006F00750020007200650061006C006C0079002000770061006E006E00610020007400680072006F007700200074006800690073000A006300680061006E0063006500200061007700610079003F0020005000730068002E002E002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "I’ll battle you, but I’m not gonna let you win!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "00492019006C006C00200062006100740074006C006500200079006F0075002C0020006200750074002000492019006D0020006E006F007400200067006F006E006E00610020006C0065007400200079006F0075002000770069006E0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Why’d you even come here, kid?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2312,
      "rawDecodedUtf16Hex": "0057006800792019006400200079006F00750020006500760065006E00200063006F006D006500200068006500720065002C0020006B00690064003F00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "If we win, I’m puttin’ ya to work kneadin’ dough\nfor Canari Bread!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "00490066002000770065002000770069006E002C002000492019006D002000700075007400740069006E201900200079006100200074006F00200077006F0072006B0020006B006E0065006100640069006E201900200064006F007500670068000A0066006F0072002000430061006E006100720069002000420072006500610064002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Hurry and get ready to battle.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "0048007500720072007900200061006E0064002000670065007400200072006500610064007900200074006F00200062006100740074006C0065002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Enough playin’ around! Eelektross, let’s crank up\nthe voltage with Mega Evolution!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2612,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Excadrill, I need ya to Mega Evolve! Let’s show\nthis kid what we’re made of!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "All right, Scrafty! Let’s wield your Mega-Evolved\npower to the maximum!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2952,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3104,
      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "We did it!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3116,
      "rawDecodedUtf16Hex": "0057006500200064006900640020006900740021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "All right, MZ Canatic. What’d you wanna tell me?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 3148,
      "rawDecodedUtf16Hex": "0041006C006C002000720069006700680074002C0020004D005A002000430061006E0061007400690063002E002000570068006100742019006400200079006F0075002000770061006E006E0061002000740065006C006C0020006D0065003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "I...I want to make an outfit that you’d wear\nsomeday, Canari!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3256,
      "rawDecodedUtf16Hex": "0049002E002E002E0049002000770061006E007400200074006F0020006D0061006B006500200061006E0020006F007500740066006900740020007400680061007400200079006F00752019006400200077006500610072000A0073006F006D0065006400610079002C002000430061006E0061007200690021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Fine by me. Long as I don’t hate the design.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3388,
      "rawDecodedUtf16Hex": "00460069006E00650020006200790020006D0065002E0020004C006F006E00670020006100730020004900200064006F006E20190074002000680061007400650020007400680065002000640065007300690067006E002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "You better make me one too, kid!<U+0010><U+0001>븁\nIf I’m gonna play Canari, I gotta understand her—\nand her outfits—better than anyone!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3488,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
    {
      "displayText": "NO, YOU DON’T.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3740,
      "rawDecodedUtf16Hex": "004E004F002C00200059004F005500200044004F004E20190054002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Well, if I’m gettin’ new gear soon...here, take this,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3780,
      "rawDecodedUtf16Hex": "00570065006C006C002C002000690066002000492019006D002000670065007400740069006E20190020006E006500770020006700650061007200200073006F006F006E002E002E002E0068006500720065002C002000740061006B006500200074006800690073002C000A0010000201000000002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "You received Canari’s Tracksuit Set!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3908,
      "rawDecodedUtf16Hex": "0059006F0075002000720065006300650069007600650064002000430061006E0061007200692019007300200054007200610063006B0073007500690074002000530065007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "And for you...here, have some Canari Bread. Made\nwith love by Pops.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 3984,
      "rawDecodedUtf16Hex": "0041006E006400200066006F007200200079006F0075002E002E002E0068006500720065002C0020006800610076006500200073006F006D0065002000430061006E006100720069002000420072006500610064002E0020004D006100640065000A00770069007400680020006C006F0076006500200062007900200050006F00700073002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "C-Canari Bread?! Thank you. I’ll treasure this!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4128,
      "rawDecodedUtf16Hex": "0043002D00430061006E006100720069002000420072006500610064003F00210020005400680061006E006B00200079006F0075002E002000492019006C006C002000740072006500610073007500720065002000740068006900730021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Or you could just eat it.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4232,
      "rawDecodedUtf16Hex": "004F007200200079006F007500200063006F0075006C00640020006A0075007300740020006500610074002000690074002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "I can’t believe me and the crew still couldn’t beat\nyou after all our training...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Canari Bread’s been such a hit, I’m thinkin’ of\nopenin’ pop-up shops all over!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Now I just need to tell Canari the same thing in\nreality. I’ll...work up the nerve eventually.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    }
  ],
