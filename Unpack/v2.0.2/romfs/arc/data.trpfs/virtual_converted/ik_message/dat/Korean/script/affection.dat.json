      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "으음...\n이제 시작인 것 같은 느낌이네.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "C73CC74C002E002E002E000AC774C81C0020C2DCC791C7780020AC830020AC19C7400020B290B08CC774B124002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "포켓몬 승부를 할 때마다\n기절할 때까지 방치하는 건 아니지?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 700,
      "rawDecodedUtf16Hex": "D3ECCF13BAAC0020C2B9BD80B97C0020D5600020B54CB9C8B2E4000AAE30C808D5600020B54CAE4CC9C00020BC29CE58D558B2940020AC740020C544B2C8C9C0003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "이런, 너무 엄하게 대하는 거 아니니?\n조금도 친하지 않은걸?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "C774B7F0002C0020B108BB340020C5C4D558AC8C0020B300D558B2940020AC700020C544B2C8B2C8003F000AC870AE08B3C40020CE5CD558C9C00020C54AC740AC78003F0000",
