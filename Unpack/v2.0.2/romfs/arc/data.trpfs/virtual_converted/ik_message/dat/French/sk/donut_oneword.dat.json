{
  "declaredLength": 11576,
  "decoding": "confirmed-per-slot-XOR-rotate3-index-seed",
  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Je peux préparer les Donuts de ton choix\nsi tu m’apportes les Baies nécessaires !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Bienvenue à la Donuterie d’Anya ! Mon secret\nde fabrication repose sur la combinaison de Baies.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Le trou au milieu permet au Donut de cuire\nde façon homogène.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "004C0065002000740072006F00750020006100750020006D0069006C0069006500750020007000650072006D0065007400200061007500200044006F006E00750074002000640065002000630075006900720065000A0064006500200066006100E7006F006E00200068006F006D006F006700E8006E0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Penses-tu que le monde est différent quand\non l’observe à travers un Donut ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "J’aime bien pétrir la pâte à Donuts !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "004A201900610069006D00650020006200690065006E0020007000E900740072006900720020006C00610020007000E200740065002000E000200044006F006E007500740073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "La texture des Donuts change si on laisse lever\nla pâte.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "004C006100200074006500780074007500720065002000640065007300200044006F006E0075007400730020006300680061006E006700650020007300690020006F006E0020006C006100690073007300650020006C0065007600650072000A006C00610020007000E200740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Bienvenue à la Donuterie d’Anya, la petite\nboutique de l’Hôtel Z !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "004200690065006E00760065006E00750065002000E00020006C006100200044006F006E0075007400650072006900650020006420190041006E00790061002C0020006C00610020007000650074006900740065000A0062006F0075007400690071007500650020006400650020006C2019004800F400740065006C0020005A002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Bienvenue à la Donuterie d’Anya, la boutique\nindispensable à l’exploration d’Extra Illumis !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Bienvenue à la Donuterie d’Anya, la boutique\nde Donuts préférée de Hoopa !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Je me suis levée du bon pied ce matin. Je me\nsens capable de réussir n’importe quelle recette !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "« Bienvenue chez Donuts Sans Chichis ! »\nHihi, je m’imagine en patronne de restaurant !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Quand on y réfléchit... la Malasada d’Alola,\nc’est aussi un type de Donut, non ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Un Donut, c’est comme un grand cercle d’amitié\nqu’on essaie d’étirer autour du monde entier !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "J’ai déjà préparé beaucoup de Donuts jusque-là...\nmais je suis prête à en faire encore plus !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Je vais faire le meilleur des Donuts !\nUn Donut capable de résister à la Méga-Force !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Je peux maintenant incorporer quatre Baies\ndans le même Donut ! J’ai hâte d’essayer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Je peux maintenant incorporer cinq Baies\ndans le même Donut ! J’ai hâte d’essayer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 3128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Je peux maintenant incorporer six Baies\ndans le même Donut ! J’ai hâte d’essayer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Je peux maintenant incorporer sept Baies\ndans le même Donut ! J’ai hâte d’essayer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Je peux maintenant incorporer huit Baies\ndans le même Donut ! J’ai hâte d’essayer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Comment le désires-tu ? Épicé ? Frais ? Sucré ?\nPeut-être acide, ou alors amer ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Je vais préparer davantage de Donuts\npour que tu poursuives tes explorations !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Je fais chauffer le beurre pour qu’il soit fondu\nlorsque nous en aurons besoin !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 4124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Commande-moi plusieurs Donuts, comme ça,\ntu n’auras pas à revenir à l’Hôtel Z trop souvent.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 4288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Il faut écraser chaque Baie soigneusement pour\nobtenir un mélange lisse. C’est ça le secret !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 4472,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "À Illumis, on utilise des ingrédients de qualité\npour faire nos Donuts !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 4660,
      "rawDecodedUtf16Hex": "00C000200049006C006C0075006D00690073002C0020006F006E0020007500740069006C006900730065002000640065007300200069006E0067007200E9006400690065006E007400730020006400650020007100750061006C0069007400E9000A0070006F007500720020006600610069007200650020006E006F007300200044006F006E007500740073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Mes Donuts et les pouvoirs de Hoopa sont\nà ta disposition pour t’aider à explorer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Cherche les bonnes combinaisons de Baies\npour obtenir les effets dont tu as besoin !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4976,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Le trou d’un Donut, c’est du vide, et pourtant,\nil existe. Que c’est étrange !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 5148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Ces Baies extradimensionnelles sont vraiment\nmystérieuses, ne trouves-tu pas ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 5308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Il est important de faire attention au niveau bonus\nd’un Donut !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 5468,
      "rawDecodedUtf16Hex": "0049006C002000650073007400200069006D0070006F007200740061006E007400200064006500200066006100690072006500200061007400740065006E00740069006F006E0020006100750020006E0069007600650061007500200062006F006E00750073000A006420190075006E00200044006F006E00750074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Moins un Donut apporte de Satiéténergie,\nplus ton temps d’exploration sera court.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 5600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "J’aimerais essayer de préparer un Donut qui\naugmente les chances de rencontrer un Baron...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 5764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Ce serait merveilleux qu’un Donut permette de\nrencontrer davantage de Pokémon chromatiques !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 5948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Quand un Donut a un niveau gustatif élevé,\nses effets sont renforcés !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 6136,
      "rawDecodedUtf16Hex": "005100750061006E006400200075006E00200044006F006E007500740020006100200075006E0020006E00690076006500610075002000670075007300740061007400690066002000E9006C0065007600E9002C000A007300650073002000650066006600650074007300200073006F006E0074002000720065006E0066006F0072006300E90073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Hoopa adore les Donuts sucrés !\nTu l’as remarqué, toi aussi ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 6280,
      "rawDecodedUtf16Hex": "0048006F006F00700061002000610064006F007200650020006C0065007300200044006F006E0075007400730020007300750063007200E9007300200021000A005400750020006C201900610073002000720065006D006100720071007500E9002C00200074006F00690020006100750073007300690020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Quelque chose me dit que les Pokémon\nchromatiques aiment les Donuts sucrés...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 6404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "J’ai l’impression qu’un Donut sucré devrait\nattirer la chance... Qu’en penses-tu ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 6560,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Savez-vous quel Donut correspond le mieux\nà l’Hôtel Z ? Un donut épicé au curry !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 6728,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Peut-être que le goût épicé augmente la force\nd’attaque des Pokémon...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 6892,
      "rawDecodedUtf16Hex": "0050006500750074002D00EA00740072006500200071007500650020006C006500200067006F00FB0074002000E900700069006300E90020006100750067006D0065006E007400650020006C006100200066006F007200630065000A006420190061007400740061007100750065002000640065007300200050006F006B00E9006D006F006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "J’ai l’impression qu’un Donut épicé pourrait\nfavoriser l’offensive... Qu’en penses-tu ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 7036,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Hoopa aime les Donuts avec un petit goût acide !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 7212,
      "rawDecodedUtf16Hex": "0048006F006F00700061002000610069006D00650020006C0065007300200044006F006E0075007400730020006100760065006300200075006E00200070006500740069007400200067006F00FB0074002000610063006900640065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Un Donut qui attire les Baies permettrait de\npréparer encore plus de Donuts !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 7312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "J’ai l’impression que les Donuts acides attirent\nles objets... Qu’en penses-tu ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 7468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "On ne dirait pas, mais Hoopa apprécie aussi\ncertaines saveurs amères !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 44,
      "offsetInSection": 7632,
      "rawDecodedUtf16Hex": "004F006E0020006E006500200064006900720061006900740020007000610073002C0020006D00610069007300200048006F006F007000610020006100700070007200E9006300690065002000610075007300730069000A006300650072007400610069006E006500730020007300610076006500750072007300200061006D00E8007200650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "J’espère que ce Donut te permettra de mieux te\nprotéger contre les capacités d’un certain type.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 7776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "J’ai l’impression qu’un Donut amer devrait\nfavoriser la défense... Qu’en penses-tu ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 7968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Un Donut au goût frais réveille toujours\nles papilles de Hoopa !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 47,
      "offsetInSection": 8140,
      "rawDecodedUtf16Hex": "0055006E00200044006F006E0075007400200061007500200067006F00FB00740020006600720061006900730020007200E9007600650069006C006C006500200074006F0075006A006F007500720073000A006C0065007300200070006100700069006C006C0065007300200064006500200048006F006F00700061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Je te recommande des Donuts au goût frais\nsi tu veux capturer davantage de Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 8272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Je crois qu’un Donut au goût frais te permettrait\nde capturer plus facilement les Pokémon...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 8440,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Je n’ai aucune idée de l’effet de cette recette.\nJ’ai hâte de découvrir ce que cela va donner !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 8628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Ce Donut est spécial ! Il te permettra de mener\nl’Opération Méga-Donut à bien !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 8820,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "J’espère qu’un Donut plein de Baies permettra\nde trouver Groudon !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 8980,
      "rawDecodedUtf16Hex": "004A201900650073007000E80072006500200071007520190075006E00200044006F006E0075007400200070006C00650069006E0020006400650020004200610069006500730020007000650072006D00650074007400720061000A00640065002000740072006F0075007600650072002000470072006F00750064006F006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "J’espère qu’un Donut plein de Baies permettra\nde trouver Kyogre !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 9116,
      "rawDecodedUtf16Hex": "004A201900650073007000E80072006500200071007520190075006E00200044006F006E0075007400200070006C00650069006E0020006400650020004200610069006500730020007000650072006D00650074007400720061000A00640065002000740072006F00750076006500720020004B0079006F006700720065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "J’espère qu’un Donut plein de Baies permettra\nde trouver Rayquaza !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 9248,
      "rawDecodedUtf16Hex": "004A201900650073007000E80072006500200071007520190075006E00200044006F006E0075007400200070006C00650069006E0020006400650020004200610069006500730020007000650072006D00650074007400720061000A00640065002000740072006F00750076006500720020005200610079007100750061007A0061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "J’ai l’impression que ce Plasma-Beigne va être\nune grande réussite culinaire !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 9384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "À quoi penses-tu ? Cherches-tu à réaliser\nun tout nouveau type de Donut ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 9544,
      "rawDecodedUtf16Hex": "00C0002000710075006F0069002000700065006E007300650073002D007400750020003F002000430068006500720063006800650073002D00740075002000E00020007200E90061006C0069007300650072000A0075006E00200074006F007500740020006E006F007500760065006100750020007400790070006500200064006500200044006F006E007500740020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Je peux préparer des Donuts avec n’importe\nquelle combinaison de Baies ! Essaie donc !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 9692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "As-tu du mal à choisir parmi toutes ces options ?\nJe comprends...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 9868,
      "rawDecodedUtf16Hex": "00410073002D007400750020006400750020006D0061006C002000E0002000630068006F00690073006900720020007000610072006D006900200074006F007500740065007300200063006500730020006F007000740069006F006E00730020003F000A004A006500200063006F006D007000720065006E00640073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Si tu as du mal à choisir, le mieux est d’essayer\nplein de combinaisons au hasard !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 10000,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Tu ne bouges plus... Tout va bien ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 10168,
      "rawDecodedUtf16Hex": "005400750020006E006500200062006F007500670065007300200070006C00750073002E002E002E00200054006F007500740020007600610020006200690065006E0020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Ça t’arrive aussi de te perdre dans tes pensées ?\nC’est amusant !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 10240,
      "rawDecodedUtf16Hex": "00C700610020007420190061007200720069007600650020006100750073007300690020006400650020007400650020007000650072006400720065002000640061006E00730020007400650073002000700065006E007300E9006500730020003F000A0043201900650073007400200061006D007500730061006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Pour moi, préparer des Donuts, c’est un peu\ncomme préparer de petites boules de bonheur !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 10372,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Pour faire un bon Donut, il faut suivre la recette\nde près, mais aussi mettre du cœur à l’ouvrage !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 10552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Il n’y a rien qui me rende plus heureuse que\nde voir un Pokémon se délecter de mon travail !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 64,
      "offsetInSection": 10752,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Les goûts d’une personne dévoilent beaucoup\nde sa personnalité !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 10940,
      "rawDecodedUtf16Hex": "004C0065007300200067006F00FB007400730020006420190075006E006500200070006500720073006F006E006E00650020006400E90076006F0069006C0065006E0074002000620065006100750063006F00750070000A0064006500200073006100200070006500720073006F006E006E0061006C0069007400E9002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Manger est l’une des expériences fondamentales\nde la vie, ne trouves-tu pas ?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 11072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "La cuisine requiert des bases solides.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 11232,
      "rawDecodedUtf16Hex": "004C0061002000630075006900730069006E0065002000720065007100750069006500720074002000640065007300200062006100730065007300200073006F006C0069006400650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Prends ton temps !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 11312,
      "rawDecodedUtf16Hex": "005000720065006E0064007300200074006F006E002000740065006D00700073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Tout doux, tout doux...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 11352,
      "rawDecodedUtf16Hex": "0054006F0075007400200064006F00750078002C00200074006F0075007400200064006F00750078002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Je crois que le chef cuisinier que j’admire le plus\nau monde, c’est Monsieur Narcisse.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 11400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    }
  ],
