      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "J’espère qu’il va bientôt pleuvoir...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "004A201900650073007000E80072006500200071007520190069006C0020007600610020006200690065006E007400F4007400200070006C006500750076006F00690072002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Ploc... Ploc... Ploc... Je ne suis jamais\nplus heureuse que quand il pleut !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Fais-tu attention à la météo quand tu te bats ?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "0046006100690073002D0074007500200061007400740065006E00740069006F006E002000E00020006C00610020006D00E9007400E9006F0020007100750061006E0064002000740075002000740065002000620061007400730020003F00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Mes Pokémon à moi sont plus puissants\nquand il pleut !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 600,
      "rawDecodedUtf16Hex": "004D0065007300200050006F006B00E9006D006F006E002000E00020006D006F006900200073006F006E007400200070006C007500730020007000750069007300730061006E00740073000A007100750061006E006400200069006C00200070006C0065007500740020002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Affronte-moi quand il pleut, et tu constateras\nque je suis imperméable à la défaite !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Battons-nous avant qu’il ne cesse de pleuvoir !\nTu verras ainsi la puissance de mon équipe<U+0010><U+0001>븀\npar toi-même !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "La pluie me donne vie !\nSi tu es prêt<U+0010><U+0003>ᄀÿĀe à te battre, viens me voir !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "J’aimerais me battre sous la pluie pour te montrer\nmes Pokémon sous leur meilleur jour !<U+0010><U+0001>븁\nEst-ce que tu comptes rester ici\njusqu’à ce qu’il pleuve ?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 155
    },
    {
      "displayText": "J’ai beaucoup de patience.<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "004A201900610069002000620065006100750063006F00750070002000640065002000700061007400690065006E00630065002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Non, je suis pressé<U+0010><U+0003>ᄀÿĀe !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "004E006F006E002C0020006A00650020007300750069007300200070007200650073007300E900100003110000FF010000650020002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Battons-nous tant qu’il pleut ! Je veux te montrer\nmes Pokémon sous leur meilleur jour !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Voyons ce dont ils sont capables !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1924,
      "rawDecodedUtf16Hex": "0056006F0079006F006E007300200063006500200064006F006E007400200069006C007300200073006F006E0074002000630061007000610062006C006500730020002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Désolé<U+0010><U+0003>ᄀÿĀe, j’ai oublié mon parapluie...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "004400E90073006F006C00E900100003110000FF01000065002C0020006A2019006100690020006F00750062006C006900E90020006D006F006E002000700061007200610070006C007500690065002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ah... Aucune chance que tu attendes, alors...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2100,
      "rawDecodedUtf16Hex": "00410068002E002E002E00200041007500630075006E00650020006300680061006E00630065002000710075006500200074007500200061007400740065006E006400650073002C00200061006C006F00720073002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Hein ? Mais la pluie risque de s’arrêter bientôt !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2200,
      "rawDecodedUtf16Hex": "004800650069006E0020003F0020004D0061006900730020006C006100200070006C007500690065002000720069007300710075006500200064006500200073201900610072007200EA0074006500720020006200690065006E007400F400740020002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Ouah, tu as tant envie de m’affronter ?\nNous n’avons plus qu’à attendre...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Il pleut ! Enfin !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2472,
      "rawDecodedUtf16Hex": "0049006C00200070006C0065007500740020002100200045006E00660069006E0020002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Les capacités de type Eau de mes Pokémon\ndeviennent surpuissantes sous la pluie !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Même en combinant mes capacités de type Eau\navec la pluie, je n’ai pas pu te battre...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2704,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Tu as vu comme tous mes Pokémon utilisaient\ndes capacités de ce type ?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2888,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Elles deviennent plus puissantes sous la\npluie ! Je pensais que ça m’aiderait à gagner...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Ah, et ce n’est pas tout...<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3228,
      "rawDecodedUtf16Hex": "00410068002C0020006500740020006300650020006E2019006500730074002000700061007300200074006F00750074002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Lorsqu’il pleut, les capacités de type Feu\nsont affaiblies.<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3292,
      "rawDecodedUtf16Hex": "004C006F007200730071007520190069006C00200070006C006500750074002C0020006C006500730020006300610070006100630069007400E90073002000640065002000740079007000650020004600650075000A0073006F006E00740020006100660066006100690062006C006900650073002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "C’est normal. Après tout, la pluie, ça mouille !<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3420,
      "rawDecodedUtf16Hex": "004320190065007300740020006E006F0072006D0061006C002E002000410070007200E8007300200074006F00750074002C0020006C006100200070006C007500690065002C002000E700610020006D006F00750069006C006C00650020002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
