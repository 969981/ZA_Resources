      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "시작해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "C2DCC791D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "기다려 주세요",
