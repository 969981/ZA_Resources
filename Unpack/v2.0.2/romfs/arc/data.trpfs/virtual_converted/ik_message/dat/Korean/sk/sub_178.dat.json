      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "내 푸크린은\n뻣뻣하고 퀴퀴하단 말이야!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 936,
