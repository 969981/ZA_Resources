      "offsetInSection": 216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 190
    },
    {
      "displayText": "Si te encuentras algún fósil o ámbar a lo largo\nde tu camino, ven a hablar conmigo de nuevo.<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
