      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "I could use a little more mega inspiration, like\nwhen you showed me Mega Camerupt.<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Now, what are color contacts for? Your eyes! So\nI’m really interested in seeing a Pokémon with<U+0010><U+0001>븀\ngreat big eyes...<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 4,
