      "offsetInSection": 1420,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "I want you to battle me and show me Mega\nSableye!<U+0010><U+0001>븁\nYou’ll need to have a Sableye holding its Mega\nStone on your team for that.<U+0010><U+0002>Ĕų",
