  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "0010000201000000003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Che cafon<U+0010><U+0003>ᄀÿāea, venire a scocciare mentre nonno\ne nipote si fanno i fatti propri!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Ma quali fatti propri!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "004D00610020007100750061006C0069002000660061007400740069002000700072006F0070007200690021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Aspetta!<U+0010><U+0001>븁\n<U+0010><U+0002>Ā<U+0000> di qua, <U+0010><U+0002>Ā<U+0000> di là...\nAnch’io avrei una cosa da dirti!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 11,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "È anche per questo che vorrei chiedere a voi due\ndi D1N4M0 di affrontarmi!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Ok, se pure per <U+0010><U+0002>Ā<U+0000> va bene, io ci sto.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "004F006B002C00200073006500200070007500720065002000700065007200200010000201000000002000760061002000620065006E0065002C00200069006F002000630069002000730074006F002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Certo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 972,
      "rawDecodedUtf16Hex": "0043006500720074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Magari un’altra volta...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "004D0061006700610072006900200075006E20190061006C00740072006100200076006F006C00740061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Tu tendi a rifiutare di pancia, eh?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "00540075002000740065006E00640069002000610020007200690066006900750074006100720065002000640069002000700061006E006300690061002C002000650068003F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Con Scrafty e gli altri miei Pokémon posso\nvincere! Anzi... vincerò di sicuro!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1288,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "La me attuale può affrontare qualunque\nCanaglia.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1300,
      "rawDecodedUtf16Hex": "004C00610020006D0065002000610074007400750061006C006500200070007500F200200061006600660072006F006E00740061007200650020007100750061006C0075006E007100750065000A00430061006E00610067006C00690061002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "A conti fatti, se ci pensi, pure io son Canary.\nPensa, avrai l’onore di affrontare ben due Canary!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Lottiamo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1616,
      "rawDecodedUtf16Hex": "004C006F0074007400690061006D006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Aspettate...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "004100730070006500740074006100740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "E dai, fatti sotto! Quando ti ricapita un’occasione\ndel genere?!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1664,
      "rawDecodedUtf16Hex": "00450020006400610069002C00200066006100740074006900200073006F00740074006F00210020005100750061006E0064006F00200074006900200072006900630061007000690074006100200075006E2019006F00630063006100730069006F006E0065000A00640065006C002000670065006E006500720065003F0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Ti affronterò, sì, ma a vincere sarò io!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1804,
      "rawDecodedUtf16Hex": "0054006900200061006600660072006F006E00740065007200F2002C0020007300EC002C0020006D006100200061002000760069006E0063006500720065002000730061007200F200200069006F0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "E allora che vuoi fare?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1896,
      "rawDecodedUtf16Hex": "004500200061006C006C006F007200610020006300680065002000760075006F006900200066006100720065003F00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Se vinciamo noi, ci dovrete aiutare a preparare il\nPan di Canary!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1952,
      "rawDecodedUtf16Hex": "00530065002000760069006E006300690061006D006F0020006E006F0069002C00200063006900200064006F007600720065007400650020006100690075007400610072006500200061002000700072006500700061007200610072006500200069006C000A00500061006E002000640069002000430061006E006100720079002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Fai in fretta, non posso aspettare oltre.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2092,
      "rawDecodedUtf16Hex": "00460061006900200069006E0020006600720065007400740061002C0020006E006F006E00200070006F00730073006F00200061007300700065007400740061007200650020006F006C007400720065002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Stavolta faccio davvero sul serio! Eelektross,\nmegaevolviti e mostra<U+0010><U+0003>ᄀÿȃglile la tua rapida ascesa!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 5,
      "flagsUpper16": 8,
      "index": 21,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Forza, Excadrill! Megaevolviti e aiutami a\nrealizzare la mia strategia geniale!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Scrafty! Facciamo<U+0010><U+0003>ᄀÿȃglile vedere di cosa siamo capaci\ngrazie al potere della megaevoluzione!!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 8,
      "index": 23,
      "offsetInSection": 2576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Abbiamo vinto!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "00410062006200690061006D006F002000760069006E0074006F0021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Quindi cos’è che volevi dirmi, Canaglia?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2828,
      "rawDecodedUtf16Hex": "005100750069006E0064006900200063006F0073201900E8002000630068006500200076006F006C0065007600690020006400690072006D0069002C002000430061006E00610067006C00690061003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Un giorno indosserai uno dei miei abiti, Canary!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "0055006E002000670069006F0072006E006F00200069006E0064006F00730073006500720061006900200075006E006F00200064006500690020006D006900650069002000610062006900740069002C002000430061006E0061007200790021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Perché no? Sempre che il design mi convinca.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "0050006500720063006800E90020006E006F003F002000530065006D007000720065002000630068006500200069006C002000640065007300690067006E0020006D006900200063006F006E00760069006E00630061002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Fanne uno pure per me!<U+0010><U+0001>븁\nHo bisogno di indossare gli stessi vestiti di Canary\nper poterla capire meglio!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "NON CREDO PROPRIO!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3348,
      "rawDecodedUtf16Hex": "004E004F004E00200043005200450044004F002000500052004F005000520049004F0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Ehi, <U+0010><U+0002>Ā<U+0000>. Tieni questo.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3396,
      "rawDecodedUtf16Hex": "004500680069002C00200010000201000000002E0020005400690065006E0069002000710075006500730074006F002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>Ā<U+0000> ha ricevuto il Completo\ndi Canary!",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3456,
      "rawDecodedUtf16Hex": "00100002BD060000001000020100000000200068006100200072006900630065007600750074006F00200069006C00200043006F006D0070006C00650074006F000A00640069002000430061006E00610072007900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Per te questo, invece. È il Pan di Canary che ha\nfatto mio nonno.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3544,
      "rawDecodedUtf16Hex": "005000650072002000740065002000710075006500730074006F002C00200069006E0076006500630065002E002000C800200069006C002000500061006E002000640069002000430061006E0061007200790020006300680065002000680061000A0066006100740074006F0020006D0069006F0020006E006F006E006E006F002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Un Pan di Canary... Lo conserverò a vita!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 3684,
      "rawDecodedUtf16Hex": "0055006E002000500061006E002000640069002000430061006E006100720079002E002E002E0020004C006F00200063006F006E00730065007200760065007200F200200061002000760069007400610021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Macché, mangiatelo!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3776,
      "rawDecodedUtf16Hex": "004D006100630063006800E9002C0020006D0061006E00670069006100740065006C006F0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Comunque assurdo che non riesca mai a battere\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0001>븀\nAvevo pure allenato Eelektross e gli altri.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "Il Pan di Canary va alla grande! Voglio provare\na metterlo in vendita in tutte le regioni!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Ora non mi resta che dirglielo anche nel mondo\nreale. Un giorno... ce la metterò tutta.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 4232,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    }
  ],
