      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Qui aurait cru que mon idée fonctionnerait\naussi bien ?<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "0051007500690020006100750072006100690074002000630072007500200071007500650020006D006F006E00200069006400E9006500200066006F006E006300740069006F006E006E00650072006100690074000A006100750073007300690020006200690065006E0020003F001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Merci de m’avoir aidée, tu es l<U+0010><U+0003>ᄀÿଊe meilleura meilleure !<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2544,
      "rawDecodedUtf16Hex": "004D00650072006300690020006400650020006D201900610076006F00690072002000610069006400E90065002C0020007400750020006500730020006C00100003110000FF0B0A00650020006D00650069006C006C00650075007200610020006D00650069006C006C006500750072006500200021001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Ça m’inspire un nouveau sujet de recherche :\nquelle est la capacité Poison la plus délicieuse<U+0010><U+0001>븀\npour les Galekid ?<U+0010><U+0002>Ĕō",
