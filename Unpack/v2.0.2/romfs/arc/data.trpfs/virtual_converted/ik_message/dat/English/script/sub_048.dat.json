      "index": 4,
      "offsetInSection": 392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 164
    },
    {
      "displayText": "You’ll understand best if you see it for yourself!\nSo let’s have ourselves a battle!<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Just let me know if you’d like to battle me!<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "004A0075007300740020006C006500740020006D00650020006B006E006F007700200069006600200079006F0075201900640020006C0069006B006500200074006F00200062006100740074006C00650020006D0065002100100002011401500000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Feel like trying your luck against the random\nmoves brought out by Metronome?<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Yep—I’m feeling lucky!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "005900650070201400492019006D0020006600650065006C0069006E00670020006C00750063006B007900210000",
      "trailingZeroPaddingUnits": 1,
