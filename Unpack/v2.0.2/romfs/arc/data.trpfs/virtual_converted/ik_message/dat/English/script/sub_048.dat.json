      "rawDecodedUtf16Hex": "004900200077006F006E201900740020006300680061006E00630065002000690074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Yeah, I guess it’s scary to think you might end up\non the wrong end of a superpowerful move!<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Even I have no idea which moves Metronome will\nunleash. Let’s see whose luck wins out!<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 12,
