      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Qué amable eres! Me encanta la flor azul\nde este Flabébé.<U+0010><U+0002>ĔŴ",
