      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡El naranja es un color muy otoñal!<U+0010><U+0001>븁\n¡Me encargaré de que a partir de ahora se ofrezca\neste color de tinte en las peluquerías!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "¡Ahora puedes teñirte el pelo de color naranja\nen las peluquerías!",
