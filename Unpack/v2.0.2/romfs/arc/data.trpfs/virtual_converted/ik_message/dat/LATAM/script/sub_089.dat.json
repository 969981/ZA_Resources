      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Ay, muchas gracias! Este Flabébé tiene\nuna flor amarilla.<U+0010><U+0002>ĔŴ",
