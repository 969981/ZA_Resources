      "offsetInSection": 3936,
      "rawDecodedUtf16Hex": "00A100410068006F00720061002000700075006500640065007300200074006500F1006900720074006500200065006C002000700065006C006F00200064006500200063006F006C006F007200200061006D006100720069006C006C006F000A006C0069006D00F3006E00200065006E0020006C00610073002000700065006C0075007100750065007200ED0061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
