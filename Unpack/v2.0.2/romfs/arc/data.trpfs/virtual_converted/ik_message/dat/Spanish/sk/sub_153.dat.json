  "messages": [
    {
      "displayText": "¡Disfruta del toque sofisticado\nde una taza de mezcla Rubor!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 308,
