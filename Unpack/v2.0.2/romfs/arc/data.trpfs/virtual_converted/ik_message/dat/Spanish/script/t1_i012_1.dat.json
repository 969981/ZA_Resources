      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "004C0061002000730061006C006100200064006500200065006E007400720065006E0061006D00690065006E0074006F00200070006100720061000A0050006F006B00E9006D006F006E002000650073007400E1002000670065006E00690061006C002000740061006D0062006900E9006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
