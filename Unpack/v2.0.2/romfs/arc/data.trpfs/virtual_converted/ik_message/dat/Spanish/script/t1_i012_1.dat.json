      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2708,
      "rawDecodedUtf16Hex": "00510075006900740061002C002000620061007300740061006E007400650020006D006900650064006F0020006400610020007900610020006500730061000A006D0075006A00650072002000730069006E00200065007300740061007200200065006E006600610064006100640061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "¿Has elegido ya un plan de entrenamiento para\nel Pokémon más importante de tu equipo?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
