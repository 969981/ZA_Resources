      "offsetInSection": 1300,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vieni da me dopo aver messo in squadra\nun Pokémon che conosce Bollaraggio per<U+0010><U+0001>븀\naiutarmi a lavare il mio Wigglytuff!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "Vedo che hai con te un Pokémon che conosce\nBollaraggio! Possiamo fare una finta lotta<U+0010><U+0001>븀\nPokémon?<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
