      "rawDecodedUtf16Hex": "0049006C002000700065006C006F002000640065006C0020006D0069006F00200057006900670067006C00790074007500660066002C00200069006E0076006500630065002C002000E8002000720075007600690064006F00200065000A0074007500740074006F002000610072007200750066006600610074006F002100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Il motivo è molto semplice: detesta farsi la doccia!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "0049006C0020006D006F007400690076006F002000E80020006D006F006C0074006F002000730065006D0070006C006900630065003A002000640065007400650073007400610020006600610072007300690020006C006100200064006F0063006300690061002100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Perciò ho pensato...<U+0010><U+0001>븁\nFingerò di sfidare qualcuno a una lotta Pokémon,\ne farò sì che lo lavino con Bollaraggio!<U+0010><U+0002>ĔǗ",
