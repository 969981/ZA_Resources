    },
    {
      "displayText": "È così soffice e piacevole al tatto! Quando lo\ntocchi, non vorresti più smettere!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Il pelo del mio Wigglytuff, invece, è ruvido e\ntutto arruffato!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
