      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1760,
      "rawDecodedUtf16Hex": "004600610063006300690061006D006F0067006C006900200075006E002000620065006C0020006200610067006E006500740074006F00210000",
      "trailingZeroPaddingUnits": 1,
