      "rawDecodedUtf16Hex": "0047006F006F00640020006F006E00200079006F007500200066006F0072002000610064006D0069007400740069006E0067002000690074002E00200054006800610074002000740061006B0065007300200069006E0074006500670072006900740079002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Hm. Well, I believe you...but I’ve been itching to\ntell someone about it, so humor me.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 512,
