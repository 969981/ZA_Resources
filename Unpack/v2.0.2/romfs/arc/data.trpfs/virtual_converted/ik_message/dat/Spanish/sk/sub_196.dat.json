    },
    {
      "displayText": "Me gusta que admitas que no lo conoces.\nNo hay que avergonzarse de algo así.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Bueno, haré como si no lo conocieras, que me\napetece explicárselo a alguien.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
