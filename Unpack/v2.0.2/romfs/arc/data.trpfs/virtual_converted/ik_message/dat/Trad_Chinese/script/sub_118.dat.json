      "rawDecodedUtf16Hex": "624B6A5F6D1B625859C667094F8696FB202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "我有事要找<U+0010><U+0003>ᄀÿā你妳。<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 220,
      "rawDecodedUtf16Hex": "621167094E8B8981627E00100003110000FF01014F6059B3300200100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "有空時就來\n寶可夢研究所一趟吧。<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 256,
