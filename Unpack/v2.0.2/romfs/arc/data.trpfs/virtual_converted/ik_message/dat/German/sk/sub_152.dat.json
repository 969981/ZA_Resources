      "offsetInSection": 3504,
      "rawDecodedUtf16Hex": "0046006F006C00670065002000500061006E00740069006D0069006D006900200075006E00640020007600650072006C00690065007200650020006500730020006E00690063006800740020006100750073002000640065006E000A0041007500670065006E00210000",
