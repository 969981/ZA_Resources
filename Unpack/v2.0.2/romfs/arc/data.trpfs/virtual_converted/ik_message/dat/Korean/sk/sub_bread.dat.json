  "messages": [
    {
      "displayText": "자네로군!\n카나리빵을 사러 온 겐가?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 100,
