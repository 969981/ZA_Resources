      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B353EF4EE55E6B6211523000310031865F91CE751F72795340000A627E51FA6CE55DF49B5A4F8655CEFF1F00100001BE00000A72604E005B9A662F64EC614B62107CBE9748740376846A235B504E863002001000020114014C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "要是<U+0010><U+0003>ᄀÿā你妳找到了我的泥巴魚，\n拜託<U+0010><U+0003>ᄀÿā你妳告訴我一聲喔！<U+0010><U+0002>ĔŌ",
