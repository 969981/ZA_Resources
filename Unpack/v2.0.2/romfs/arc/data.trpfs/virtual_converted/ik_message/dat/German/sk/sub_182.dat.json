  "initialKey": 0,
  "messages": [
    {
      "displayText": "Da lässt man es nur kurz aus den Augen und\ndann so was!<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "004400610020006C00E40073007300740020006D0061006E0020006500730020006E007500720020006B00750072007A0020006100750073002000640065006E00200041007500670065006E00200075006E0064000A00640061006E006E00200073006F0020007700610073002100100002011401DA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Mein liebes, kleines Blümchen ist in den\nWildsektor gelaufen.<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "004D00650069006E0020006C00690065006200650073002C0020006B006C00650069006E0065007300200042006C00FC006D006300680065006E002000690073007400200069006E002000640065006E000A00570069006C006400730065006B0074006F0072002000670065006C0061007500660065006E002E00100002011401DA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Aber ich kann niemals alleine in den Wildsektor.\nDavor habe ich viel zu viel Angst.<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Es tut mir wirklich leid, aber würdest du an\nmeiner Stelle nach Blümchen suchen?<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 840,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Ruf es einfach mit „Blümchen“ – da wird es sich\nfreuen!<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "005200750066002000650073002000650069006E00660061006300680020006D006900740020201E0042006C00FC006D006300680065006E201C002020130020006400610020007700690072006400200065007300200073006900630068000A00660072006500750065006E002100100002011401DA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Was ist denn dieses „Blümchen“?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "0057006100730020006900730074002000640065006E006E00200064006900650073006500730020201E0042006C00FC006D006300680065006E201C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Um welches Pokémon geht es denn?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "0055006D002000770065006C006300680065007300200050006F006B00E9006D006F006E00200067006500680074002000650073002000640065006E006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Blümchen ist einfach... Blümchen! Du wirst es\ndirekt erkennen, wenn du es siehst.<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Ach, mein Blümchen... Ich hoffe, dass ihm nichts\nSchlimmes widerfährt.<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Bitte sieh dich in Wildsektor 6 um.\nWenn du es mit „Blümchen“ zu dir rufst, sollte es<U+0010><U+0001>븀\nsich freuen.<U+0010><U+0002>Ĕǚ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
