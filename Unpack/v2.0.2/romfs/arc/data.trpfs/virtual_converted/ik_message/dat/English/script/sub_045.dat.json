      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hey, hold on! I need you to use <U+0010><U+0002>＀<U+0006>Sludge Bomb<U+0010><U+0002>＀<U+0000> to\nseason the scrap metal properly!<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 8,
