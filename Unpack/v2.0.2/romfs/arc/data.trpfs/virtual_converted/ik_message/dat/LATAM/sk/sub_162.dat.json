  "initialKey": 0,
  "messages": [
    {
      "displayText": "No estoy seguro, pero este lugar\nse me hace familiar.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "004E006F0020006500730074006F0079002000730065006700750072006F002C0020007000650072006F002000650073007400650020006C0075006700610072000A007300650020006D006500200068006100630065002000660061006D0069006C006900610072002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Hasta aquí me topo con mi hermano.\nQué suerte la mía...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "00480061007300740061002000610071007500ED0020006D006500200074006F0070006F00200063006F006E0020006D00690020006800650072006D0061006E006F002E000A0051007500E900200073007500650072007400650020006C00610020006D00ED0061002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Ustedes son del Círculo Justiciero, ¿no?\nMuéstrenme sus megaevoluciones, ¡porfis!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "¡¿Quieres combatir contra ellos,\n<U+0010><U+0002>Ā<U+0000>?!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 724,
      "rawDecodedUtf16Hex": "00A100BF005100750069006500720065007300200063006F006D0062006100740069007200200063006F006E00740072006100200065006C006C006F0073002C000A0010000201000000003F002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡Claro que sí!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 812,
      "rawDecodedUtf16Hex": "00A10043006C00610072006F00200071007500650020007300ED00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Ahora no",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 844,
      "rawDecodedUtf16Hex": "00410068006F007200610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Vamos, no seas así, ¡estoy llena de energía!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "00560061006D006F0073002C0020006E006F0020007300650061007300200061007300ED002C002000A1006500730074006F00790020006C006C0065006E006100200064006500200065006E00650072006700ED0061002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Como Heredera que soy, ¡es mi deber conocer\ntodas y cada una de las megaevoluciones!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Yo también estoy deseando batirnos en combate!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1156,
      "rawDecodedUtf16Hex": "00A10059006F002000740061006D0062006900E9006E0020006500730074006F0079002000640065007300650061006E0064006F002000620061007400690072006E006F007300200065006E00200063006F006D0062006100740065002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ya veo que no voy a poder librarme.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "00590061002000760065006F00200071007500650020006E006F00200076006F00790020006100200070006F0064006500720020006C00690062007200610072006D0065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¡Combatamos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "00A10043006F006D0062006100740061006D006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Ahora no",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "00410068006F007200610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Existe un tipo de experiencia que solo se puede\nobtener al derrotar a adversarios fuertes.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "¡La fuerza es poder!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "00A1004C006100200066007500650072007A006100200065007300200070006F006400650072002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "¿Desde cuándo eres así de indecis<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "00BF0044006500730064006500200063007500E1006E0064006F0020006500720065007300200061007300ED00200064006500200069006E0064006500630069007300100003110000FF0101006F0061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡La fuerza es justicia!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "00A1004C006100200066007500650072007A00610020006500730020006A0075007300740069006300690061002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Es impresionante la variedad de megaevoluciones\nque existen tanto en Ciudad Luminalia como en<U+0010><U+0001>븀\nsu variante dimensional.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1780,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡La justicia prevalecerá! ¡Falinks, megaevoluciona!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "00A1004C00610020006A0075007300740069006300690061002000700072006500760061006C006500630065007200E10021002000A100460061006C0069006E006B0073002C0020006D00650067006100650076006F006C007500630069006F006E0061002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Chandelure... ¡Megaevoluciona y derrótalos!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002E002E002E002000A1004D00650067006100650076006F006C007500630069006F006E0061002000790020006400650072007200F300740061006C006F0073002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "¡Explosión vital!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "00A1004500780070006C006F0073006900F3006E00200076006900740061006C002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Mega-Falinks y Mega-Chandelure\nson extraordinarios!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "00A1004D006500670061002D00460061006C0069006E006B0073002000790020004D006500670061002D004300680061006E00640065006C007500720065000A0073006F006E002000650078007400720061006F007200640069006E006100720069006F0073002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Y yo que pensaba que lograríamos hacerlos polvo\ncon el poder de la megaevolución...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Te entiendo, Gauri. Al megaevolucionar,\nlos Pokémon adquieren un poder incomparable.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Pero, para poder exprimir al máximo el potencial\nde sus Pokémon, un Entrenador debe aprender<U+0010><U+0001>븀\nlos secretos de la megaevolución.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2780,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Tienes razón. ¡Me esforzaré!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3048,
      "rawDecodedUtf16Hex": "005400690065006E00650073002000720061007A00F3006E002E002000A1004D00650020006500730066006F0072007A0061007200E9002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "No puedo creer que te haya hecho caso.\nEres impresionante, Korrina.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3116,
      "rawDecodedUtf16Hex": "004E006F00200070007500650064006F00200063007200650065007200200071007500650020007400650020006800610079006100200068006500630068006F0020006300610073006F002E000A004500720065007300200069006D00700072006500730069006F006E0061006E00740065002C0020004B006F007200720069006E0061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¡Me llegó al alma lo que dijiste!\nToma este conjunto, es para ti.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3260,
      "rawDecodedUtf16Hex": "00A1004D00650020006C006C0065006700F300200061006C00200061006C006D00610020006C006F0020007100750065002000640069006A00690073007400650021000A0054006F006D00610020006500730074006500200063006F006E006A0075006E0074006F002C00200065007300200070006100720061002000740069002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡Muchas gracias! Pero como que ya tengo\ndemasiadas responsabilidades de por sí.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Al fin y al cabo, soy la Líder de Gimnasio de\nCiudad Yantra, la Heredera del secreto de la<U+0010><U+0001>븀\nmegaevolución y, ahora, miembro del Equipo MZ.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "Y como ya dejé atrás mis días de patinadora,\ncreo que sería raro si uso el uniforme del<U+0010><U+0001>븀\nCírculo Justiciero.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3860,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "Entiendo. Bueno, entonces es para ti,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 4092,
      "rawDecodedUtf16Hex": "0045006E007400690065006E0064006F002E0020004200750065006E006F002C00200065006E0074006F006E00630065007300200065007300200070006100720061002000740069002C000A0010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Recibiste el Kimono de Gauri.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4188,
      "rawDecodedUtf16Hex": "00520065006300690062006900730074006500200065006C0020004B0069006D006F006E006F002000640065002000470061007500720069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Qué falta de educación, Gauri.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4248,
      "rawDecodedUtf16Hex": "0051007500E9002000660061006C007400610020006400650020006500640075006300610063006900F3006E002C002000470061007500720069002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Pienso megaevolucionar como Entrenador.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4320,
      "rawDecodedUtf16Hex": "005000690065006E0073006F0020006D00650067006100650076006F006C007500630069006F006E0061007200200063006F006D006F00200045006E007400720065006E00610064006F0072002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Este lugar... en realidad no existe, ¿no?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4408,
      "rawDecodedUtf16Hex": "00450073007400650020006C0075006700610072002E002E002E00200065006E0020007200650061006C00690064006100640020006E006F0020006500780069007300740065002C002000BF006E006F003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Una fuerza desmesurada puede conllevar cierto\nsufrimiento, pero se puede superar mediante<U+0010><U+0001>븀\nel vínculo que une a Entrenador y Pokémon.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 4500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
