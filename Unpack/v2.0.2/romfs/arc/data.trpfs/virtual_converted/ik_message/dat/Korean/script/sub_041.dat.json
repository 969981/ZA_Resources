      "rawDecodedUtf16Hex": "B098B7910020C2F8C6CC0020BCF4BA740020C54C0020C2180020C788C7440020AC70C57C00210021001000020114014A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
