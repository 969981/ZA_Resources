  "initialKey": 0,
  "messages": [
    {
      "displayText": "He! Du bist doch <U+0010><U+0002>Ā<U+0000>, oder?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "0048006500210020004400750020006200690073007400200064006F0063006800200010000201000000002C0020006F006400650072003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Meine liebste Streamerin hat gerade ein neues\nBild gepostet und ich MUSS es einfach jemandem<U+0010><U+0001>븀\nzeigen! Guck mal!!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 408,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Canary und ihr Zapplarang, wie sie auf ’ner Bank\nchillen. So eine Mood, ey. Oder?!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Ich will auch so ein Foto! Von mir und Voltenso,\nauf derselben Bank!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "004900630068002000770069006C006C0020006100750063006800200073006F002000650069006E00200046006F0074006F002100200056006F006E0020006D0069007200200075006E006400200056006F006C00740065006E0073006F002C000A006100750066002000640065007200730065006C00620065006E002000420061006E006B002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Dafür brauch ich aber deine Hilfe.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 972,
      "rawDecodedUtf16Hex": "00440061006600FC007200200062007200610075006300680020006900630068002000610062006500720020006400650069006E0065002000480069006C00660065002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Kannst du rausfinden, wo die Bank von dem\nFoto genau steht? Ich bitte dich!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Voool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "0056006F006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Soll ich dir das Foto mit der Bank noch mal\nzeigen?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "0053006F006C006C00200069006300680020006400690072002000640061007300200046006F0074006F0020006D006900740020006400650072002000420061006E006B0020006E006F006300680020006D0061006C000A007A0065006900670065006E003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Ja bitte.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "004A0061002000620069007400740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Danke, nicht nötig!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "00440061006E006B0065002C0020006E00690063006800740020006E00F600740069006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Hier! Weißt du vielleicht, wo genau diese Bank\nsteht?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1412,
      "rawDecodedUtf16Hex": "00480069006500720021002000570065006900DF00740020006400750020007600690065006C006C00650069006300680074002C00200077006F002000670065006E00610075002000640069006500730065002000420061006E006B000A00730074006500680074003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Bitte sag mir, wenn du die Bank gefunden hast!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1528,
      "rawDecodedUtf16Hex": "0042006900740074006500200073006100670020006D00690072002C002000770065006E006E0020006400750020006400690065002000420061006E006B00200067006500660075006E00640065006E00200068006100730074002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Das ist die Bank von dem Foto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1644,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020006400690065002000420061006E006B00200076006F006E002000640065006D00200046006F0074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Da sind die zwei Blumentöpfe! Und die Gebäude\nim Hintergrund! Und die Berge!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Oh ja, das ist definitiv der Spot von Canarys Foto,\nhundertpro!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1872,
      "rawDecodedUtf16Hex": "004F00680020006A0061002C0020006400610073002000690073007400200064006500660069006E00690074006900760020006400650072002000530070006F007400200076006F006E002000430061006E006100720079007300200046006F0074006F002C000A00680075006E006400650072007400700072006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Hehe, jetzt sicher ich mir hier mein eigenes\nepisches Pic!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "0048006500680065002C0020006A00650074007A0074002000730069006300680065007200200069006300680020006D00690072002000680069006500720020006D00650069006E00200065006900670065006E00650073000A006500700069007300630068006500730020005000690063002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ey, Canary hat HIER gesessen. Und jetzt sitz\nICH hier. Ich bin einfach offiziell Canary 2.0!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Kannst du bitte ein Foto schießen? Aber GENAU\nwie das von Canary, okay?!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2332,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Also, gleicher Winkel und so!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "0041006C0073006F002C00200067006C006500690063006800650072002000570069006E006B0065006C00200075006E006400200073006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Sag Bescheid, wenn du das Original noch mal\nzum Vergleich sehen möchtest.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Soll ich dir Canarys Foto noch mal zeigen?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "0053006F006C006C00200069006300680020006400690072002000430061006E006100720079007300200046006F0074006F0020006E006F006300680020006D0061006C0020007A0065006900670065006E003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ja bitte!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "004A0061002000620069007400740065002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Nein danke!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "004E00650069006E002000640061006E006B0065002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Du musst das Foto von ein bisschen weiter weg\nschießen, damit es aussieht wie das von Canary.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3064,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ja, ungefähr da, wo du jetzt stehst...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3076,
      "rawDecodedUtf16Hex": "004A0061002C00200075006E00670065006600E400680072002000640061002C00200077006F0020006400750020006A00650074007A00740020007300740065006800730074002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Moment, vielleicht doch nicht?<U+0010><U+0001>븁\nSorry, der Winkel stimmt irgendwie nicht ganz.\nIch will Canarys Foto EINS ZU EINS nachstellen!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ja genau! Mach ein Foto von da, wo du jetzt\ngerade stehst!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3444,
      "rawDecodedUtf16Hex": "004A0061002000670065006E0061007500210020004D006100630068002000650069006E00200046006F0074006F00200076006F006E002000640061002C00200077006F0020006400750020006A00650074007A0074000A0067006500720061006400650020007300740065006800730074002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Dankeee! Ich schau mir das Foto eben an, ja?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3572,
      "rawDecodedUtf16Hex": "00440061006E006B006500650065002100200049006300680020007300630068006100750020006D00690072002000640061007300200046006F0074006F0020006500620065006E00200061006E002C0020006A0061003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Oha, das ist ja genau wie das Original geworden!\nIch raste aus, wirklich 100 Prozent Canary-Core!!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3672,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Das wird direkt gepostet... BÄM!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3880,
      "rawDecodedUtf16Hex": "0044006100730020007700690072006400200064006900720065006B00740020006700650070006F0073007400650074002E002E002E0020004200C4004D002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Ich frage mich aber, wer das Foto von Canary\ngemacht hat... Vielleicht ihr Manager?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Der kümmert sich bestimmt auch um ihr ganzes\nMerch, oder?<U+0010><U+0001>븁\nAlso Canary-Brot ist schon ganz cool und so,\naber ich hätte viel lieber kleine Aufsteller.<U+0010><U+0001>븀\nOder Schlüsselanhänger!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4132,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 183
    },
    {
      "displayText": "Aber was soll’s. Ich habe ’ne ganze Liste mit\nCanary-Fotos, die ich nachstellen will! Eigentlich<U+0010><U+0001>븀\nbin ich nur dafür nach Illumina gekommen!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 146
    },
    {
      "displayText": "Danke für deine Hilfe! Gönn dir doch auch ’ne\nPause auf der Bank, wo du schon mal hier bist.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Bis dann!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4988,
      "rawDecodedUtf16Hex": "004200690073002000640061006E006E002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5016,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich glaub, als Nächstes will ich ein Foto da\nmachen, wo Canary das PvP-Quiz veranstaltet...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5028,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Tensooo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5220,
      "rawDecodedUtf16Hex": "00540065006E0073006F006F006F00210000",
      "trailingZeroPaddingUnits": 1,
