      "rawDecodedUtf16Hex": "54A6FF01554AFF1F62B16B49FF0C000A786E5B9E662F8FD968376CA19519300200100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "我来说明一下委托的内容，\n其实就是我想让凉脊龙交到朋友……<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
