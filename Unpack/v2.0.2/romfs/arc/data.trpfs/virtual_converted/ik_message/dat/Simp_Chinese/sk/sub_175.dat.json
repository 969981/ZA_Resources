      "rawDecodedUtf16Hex": "55EF20262026867D71365BF94F60611F89C9975E5E3862B16B49FF0C000A4F46621151B35B9A653E5F035E2E51C9810A9F994EA4670B53CB300200100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "非常感谢你\n替内向的我四处奔走。<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 2632,
      "rawDecodedUtf16Hex": "975E5E38611F8C224F60000A66FF518554117684621156DB590459548D70300200100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "哔啊哔耶！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2676,
      "rawDecodedUtf16Hex": "54D4554A54D48036FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "凉脊龙……\n你怎么发出这么大声音呀？<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "51C9810A9F9920262026000A4F60600E4E4853D151FA8FD94E48592758F097F35440FF1F00100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "那凉脊龙的感受呢？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 2740,
      "rawDecodedUtf16Hex": "90A351C9810A9F997684611F53D75462FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "你喜欢凉脊龙吗？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 2760,
      "rawDecodedUtf16Hex": "4F60559C6B2251C9810A9F995417FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "呃……可是……我太内向了，\n和人聊天也聊不起来……<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 2780,
      "rawDecodedUtf16Hex": "54432026202653EF662F202620266211592A518554114E86FF0C000A548C4EBA804A59294E5F804A4E0D8D7767652026202600100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "你是凉脊龙的训练家吧！\n请来和冰宝一起玩吧。<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 2840,
      "rawDecodedUtf16Hex": "4F60662F51C9810A9F9976848BAD7EC35BB65427FF01000A8BF76765548C51B05B9D4E008D7773A95427300200100002011401D00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "我很想和凉脊龙一起去露营，\n所以就自己找上门来了！<U+0010><U+0002>ĔǑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 2896,
      "rawDecodedUtf16Hex": "62115F8860F3548C51C9810A9F994E008D7753BB97328425FF0C000A62404EE55C3181EA5DF1627E4E0A95E867654E86FF0100100002011401D10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "哦哦！我的猫鼬斩\n好像也很高兴啊！<U+0010><U+0002>Ĕǒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 2956,
      "rawDecodedUtf16Hex": "54E654E6FF0162117684732B9F2C65A9000A597D50CF4E5F5F889AD85174554AFF0100100002011401D20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "唦啊！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 3000,
      "rawDecodedUtf16Hex": "5526554AFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "哔耶！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 3012,
      "rawDecodedUtf16Hex": "54D48036FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>……\n怎、怎么办啊……<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 3024,
      "rawDecodedUtf16Hex": "001000020100000020262026000A600E3001600E4E48529E554A2026202600100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "凉脊龙好像很高兴",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 3064,
      "rawDecodedUtf16Hex": "51C9810A9F99597D50CF5F889AD851740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "凉脊龙很积极哦",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "51C9810A9F995F8879EF678154E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "就……就算你这么说，这个距离感……\n来自他人的压迫感……也太可怕了。<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 3100,
      "rawDecodedUtf16Hex": "5C31202620265C317B974F608FD94E488BF4FF0C8FD94E2A8DDD79BB611F20262026000A676581EA4ED64EBA7684538B8FEB611F202620264E5F592A53EF60154E86300200100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "好吧！既然这样，那我们就稍微拉开\n一点距离，来聊聊宝可梦的话题吧。<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
