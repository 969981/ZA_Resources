      "rawDecodedUtf16Hex": "662F4F6053EB6211676576845BF95427FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "咦！啊？抱歉，\n确实是这样没错。<U+0010><U+0002>ĔǏ",
