      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "90A39EBCFF0C621190195C314F86505A8D858D8A5BC6963F96F7683C96F76D3E99057684000A53B25BB35BC6963F96F7683C96F76D3E99055427FF0100100002011401AB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "那就是！極巨密阿雷格雷派餅！\n沒錯！我要超越超級。<U+0010><U+0001>븀\n果然要夠英俊才會有這股創意和行動力！<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1160,
