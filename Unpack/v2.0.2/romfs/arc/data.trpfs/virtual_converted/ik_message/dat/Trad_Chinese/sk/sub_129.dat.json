      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "愛管侍！請幫客人端上這個剛出爐的\n極巨密阿雷格雷派餅。<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "611B7BA14F8DFF018ACB5E6B5BA24EBA7AEF4E0A9019500B525B51FA72107684000A69755DE85BC6963F96F7683C96F76D3E9905300200100002011401AB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "唉呀呀……太大份了，\n沒地方放咖啡之類的了。<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1328,
