  "messages": [
    {
      "displayText": "我打算做超越密阿雷格雷派餅的\n厲害密阿雷格雷派餅！<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
