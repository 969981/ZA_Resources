      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "請讓給我一隻英俊的愛管侍！\n拜託<U+0010><U+0003>ᄀÿā你妳了！<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 4,
