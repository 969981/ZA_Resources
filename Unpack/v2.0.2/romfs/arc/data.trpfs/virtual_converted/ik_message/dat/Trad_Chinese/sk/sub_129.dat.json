      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳願意把英俊的愛管侍\n讓給我嗎？<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 4,
