      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3556,
      "rawDecodedUtf16Hex": "00A10047006F002C00200067006F002C00200067006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Algún día lograré que mi Gimmighoul evolucione.\n¡Ya lo verás!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 3584,
