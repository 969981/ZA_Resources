      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Mais d’après mes collègues, ça arrive que\ndans certaines conditions.<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
