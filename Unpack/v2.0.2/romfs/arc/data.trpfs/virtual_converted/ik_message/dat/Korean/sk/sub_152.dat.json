      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 932,
      "rawDecodedUtf16Hex": "C544C9C1C774C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "어려운 의뢰지만...\n흉내내를 위해 부탁드릴게요.<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 944,
