      "rawDecodedUtf16Hex": "004D006F006E00200056006F006C00740061006C006900200061002000620065006100750063006F00750070002000740072006F007000200064201900E9006E00650072006700690065002E000A0049006C002000650073007400200050007200650073007300E900200070006100720020006E00610074007500720065002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Dès qu’il pense qu’il va y avoir un combat,\nil se précipite sur le terrain...<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Du coup, vous voulez bien faire un combat contre\nnous ?<U+0010><U+0001>븁\nÇa m’aiderait énormément. Je vous attends sur\nle terrain de combat.<U+0010><U+0002>ĔǤ",
