      "index": 18,
      "offsetInSection": 2604,
      "rawDecodedUtf16Hex": "004F0068002C0020006A2019006F00750062006C0069006100690073002E002E002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
