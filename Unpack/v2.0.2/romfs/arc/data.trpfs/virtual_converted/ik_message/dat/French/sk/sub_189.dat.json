      "rawDecodedUtf16Hex": "0045007400200063201900650073007400200072006500700061007200740069002E002E002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Mon Voltali a beaucoup trop d’énergie.\nIl est Pressé par nature.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
