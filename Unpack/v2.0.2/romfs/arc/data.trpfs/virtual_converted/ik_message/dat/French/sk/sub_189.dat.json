      "rawDecodedUtf16Hex": "0056006F006C0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Hé ! Ne va pas au Centre Pokémon tout seul,\nattends-moi !<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "004800E9002000210020004E00650020007600610020007000610073002000610075002000430065006E00740072006500200050006F006B00E9006D006F006E00200074006F007500740020007300650075006C002C000A0061007400740065006E00640073002D006D006F00690020002100100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
