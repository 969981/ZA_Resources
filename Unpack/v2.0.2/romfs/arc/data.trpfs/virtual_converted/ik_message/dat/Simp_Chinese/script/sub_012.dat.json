      "utf16Units": 5
    },
    {
      "displayText": "我是名调香师，\n工作是调制香水。<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 168,
      "rawDecodedUtf16Hex": "6211662F540D8C0399995E08FF0C000A5DE54F5C662F8C03523699996C34300200100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "最近我想用坐骑小羊的叶子\n调制一款香水，但是……<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "67008FD1621160F3752857509A915C0F7F8A768453F65B50000A8C0352364E006B3E99996C34FF0C4F46662F2026202600100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "如果你愿意，\n就带着坐骑小羊来找我吧！<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "5982679C4F60613F610FFF0C000A5C315E26774057509A915C0F7F8A6765627E62115427FF0100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0004>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "请把坐骑小羊\n加入同行宝可梦！<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "8BF7628A57509A915C0F7F8A000A52A05165540C884C5B9D53EF68A6FF0100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 372,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "莫非你愿意给我\n坐骑小羊的叶子吗！？<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 384,
      "rawDecodedUtf16Hex": "83AB975E4F60613F610F7ED96211000A57509A915C0F7F8A768453F65B505417FF01FF1F00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "那我就从坐骑小羊的背上\n取一小撮叶子……！<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "90A362115C314ECE57509A915C0F7F8A768480CC4E0A000A53D64E005C0F64AE53F65B5020262026FF0100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "我这就用叶子来调制香水哦。<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "62118FD95C31752853F65B5067658C03523699996C3454E6300200100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "坐骑小羊的香水调好了！<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 520,
      "rawDecodedUtf16Hex": "57509A915C0F7F8A768499996C348C03597D4E86FF0100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "如坐骑小羊般的年轻活力……<U+0010><U+0001>븁\n加上释放出能量的叶子，\n这香味闻起来充满力量。<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "598257509A915C0F7F8A822C76845E748F7B6D3B529B2026202600100001BE01000A52A04E0A91CA653E51FA80FD91CF768453F65B50FF0C000A8FD99999547395FB8D77676551456EE1529B91CF300200100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "这个香味让我回忆起了……<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "8FD94E2A999954738BA9621156DE5FC68D774E862026202600100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "小时候骑着坐骑小羊\n绕密阿雷市跑了一圈的往事。<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 680,
      "rawDecodedUtf16Hex": "5C0F65F650199A91774057509A915C0F7F8A000A7ED55BC6963F96F75E028DD14E864E00570876845F804E8B300200100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "没错！这个香水某种意义上\n就是令人怀念的密阿雷的香味。<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "6CA19519FF018FD94E2A99996C3467D079CD610F4E494E0A000A5C31662F4EE44EBA60005FF576845BC6963F96F7768499995473300200100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "让各种宝可梦帮忙的话，\n一定也能做出其他美妙的香水！<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "8BA9540479CD5B9D53EF68A65E2E5FD976848BDDFF0C000A4E005B9A4E5F80FD505A51FA51764ED67F8E5999768499996C34FF0100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "到时候就拜托你了。<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "523065F650195C3162DC62584F604E86300200100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
