      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "……看来是没事。<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 780,
      "rawDecodedUtf16Hex": "20262026770B6765662F6CA14E8B3002001000020114014C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "原来如此……！\n你终于找到那个人了啊，泥巴鱼。<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 808,
      "rawDecodedUtf16Hex": "539F676559826B6420262026FF01000A4F607EC84E8E627E523090A34E2A4EBA4E86554AFF0C6CE55DF49C7C3002001000020114014C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "我的泥巴鱼它呀，\n好像在寻找厉害的训练家。<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 864,
