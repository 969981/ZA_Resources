      "rawDecodedUtf16Hex": "5F88597DFF01000A4F60613F610F65364E0B8FD953EA6CE55DF49C7C5BF95427FF1F001000020114014C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
