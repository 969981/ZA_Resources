      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 54,
      "offsetInSection": 6996,
      "rawDecodedUtf16Hex": "004100630063006900640065006E00740069002C002000730065006E0074006F00200063006800650020006E00650020007600650072007200E0002000660075006F0072006900200075006E00200072006F006D0061006E007A006F000A006420190065006300630065007A0069006F006E0065002100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Sì! Di sicuro!",
