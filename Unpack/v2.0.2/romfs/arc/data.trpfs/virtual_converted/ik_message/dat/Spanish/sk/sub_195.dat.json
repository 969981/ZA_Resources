      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿List<U+0010><U+0003>ᄀÿāoa para combatir contra los Morpeko de\nseguridad?<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "00BF004C00690073007400100003110000FF0101006F00610020007000610072006100200063006F006D0062006100740069007200200063006F006E0074007200610020006C006F00730020004D006F007200700065006B006F002000640065000A007300650067007500720069006400610064003F00100002011401EA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "¡Sí!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "00A1005300ED00210000",
      "trailingZeroPaddingUnits": 1,
