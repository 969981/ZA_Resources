  "initialKey": 0,
  "messages": [
    {
      "displayText": "我忘在家裡了嗎……<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 380,
      "rawDecodedUtf16Hex": "62115FD857285BB688E14E8655CE20262026001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>，\n我有點事想拜託<U+0010><U+0003>ᄀÿā你妳。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 408,
      "rawDecodedUtf16Hex": "0010000201000000FF0C000A621167099EDE4E8B60F362DC8A1700100003110000FF01014F6059B33002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "不……沒事。\n我去和安馨兒商量看看好了。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 460,
      "rawDecodedUtf16Hex": "4E0D202620266C924E8B3002000A621153BB548C5B8999A85152554691CF770B770B597D4E863002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "安馨兒，我有事想拜託胡帕。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "5B8999A85152FF0C621167094E8B60F362DC8A1780E15E153002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "不行喔。<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "4E0D884C5594300200100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "咦？<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 568,
      "rawDecodedUtf16Hex": "54A6FF1F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "想讓胡帕幫忙去拿忘記的東西，\n這太狡猾了，不行。<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "60F38B9380E15E155E6B5FD953BB62FF5FD88A1876846771897FFF0C000A9019592A72E1733E4E86FF0C4E0D884C300200100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "怎麼會……\n安馨兒妳不也是……<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "600E9EBC670320262026000A5B8999A8515259B34E0D4E5F662F20262026001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "我會拜託胡帕幫忙我\n從酒店移動，<U+0010><U+0001>븀\n都是為了不想讓大家多操心。<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "6211670362DC8A1780E15E155E6B5FD96211000A5F9E91525E9779FB52D5FF0C00100001BE00000A90FD662F70BA4E864E0D60F38B9359275BB6591A64CD5FC3300200100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "而且我母親也說偷懶是不對的。<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "800C4E1462116BCD89AA4E5F8AAA507761F6662F4E0D5C0D7684300200100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "我可能真的有點\n太依賴<U+0010><U+0002>Ā<U+0000>他們……<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "621153EF80FD771F768467099EDE000A592A4F9D8CF400100002010000004ED6501120262026001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我知道了！\n自己的事自己做！<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 848,
      "rawDecodedUtf16Hex": "621177E590534E86FF01000A81EA5DF176844E8B81EA5DF1505AFF01001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "為了提起幹勁，<U+0010><U+0002>Ā<U+0000>！\n和我打場認真的對戰吧。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 888,
      "rawDecodedUtf16Hex": "70BA4E8663D08D775E7952C1FF0C0010000201000000FF01000A548C6211625358348A8D771F76845C0D623054273002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "那我就在庭院等<U+0010><U+0003>ᄀÿā你妳。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "90A362115C3157285EAD96627B4900100003110000FF01014F6059B33002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "我們也去參觀一下\n琵魯認真起來的樣子吧！<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "621150114E5F53BB53C389C04E004E0B000A74359B6F8A8D771F8D774F8676846A235B505427FF0100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "嗶啪啪！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "55F6556A556AFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>，\n請跟我打場認真的對戰！<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "0010000201000000FF0C000A8ACB8DDF6211625358348A8D771F76845C0D6230FF01001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "好啊！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1108,
      "rawDecodedUtf16Hex": "597D554AFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "等一下",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "7B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "輸贏當然很重要，\n但我更要看看自己能多認真應戰。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "8F388D0F757671365F8891CD8981FF0C000A4F46621166F48981770B770B81EA5DF180FD591A8A8D771F61C962303002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "面對密阿雷最強的訓練家，\n我能打到什麼程度……<U+0010><U+0001>븀\n我要測試自己的本事！<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1184,
      "rawDecodedUtf16Hex": "97625C0D5BC6963F96F767005F3776848A137DF45BB6FF0C000A621180FD625352304EC09EBC7A0B5EA62026202600100001BE00000A621189816E2C8A6681EA5DF17684672C4E8BFF01001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "我一直很想看看\n頭巾混混有多強！<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "62114E0076F45F8860F3770B770B000A982D5DFE6DF76DF76709591A5F37FF0100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "嗶啪啪！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "55F6556A556AFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "頭巾混混！你總是幫我的忙！\n這次換我讓你發光發熱了！<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "982D5DFE6DF76DF7FF014F607E3D662F5E6B621176845FD9FF01000A90196B2163DB62118B934F60767C5149767C71B14E86FF01001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "果然厲害！<U+0010><U+0001>븁\n但我能和<U+0010><U+0002>Ā<U+0000>打場認真的對戰，\n我也很厲害吧？<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1412,
      "rawDecodedUtf16Hex": "679C713653B25BB3FF0100100001BE01000A4F46621180FD548C0010000201000000625358348A8D771F76845C0D6230FF0C000A62114E5F5F8853B25BB35427FF1F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "沒錯！<U+0010><U+0002>Ā<U+0000>和琵魯，\n你們都很厲害！<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "6C92932FFF010010000201000000548C74359B6FFF0C000A4F60501190FD5F8853B25BB3FF0100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "你明明那麼厲害，\n為什麼會猶豫要不要回家呢？<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "4F60660E660E90A39EBC53B25BB3FF0C000A70BA4EC09EBC670373368C6B89814E0D898156DE5BB65462FF1F00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "我是想見我妹妹，\n但我不想和我奶奶碰到面……<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1592,
      "rawDecodedUtf16Hex": "6211662F60F3898B621159B959B9FF0C000A4F4662114E0D60F3548C62115976597678B05230976220262026001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "對不起！安馨兒妳和妳媽媽分隔兩地，\n我這樣太任性了，對吧。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1648,
      "rawDecodedUtf16Hex": "5C0D4E0D8D77FF015B8999A8515259B3548C59B35ABD5ABD5206969451695730FF0C000A621190196A23592A4EFB60274E86FF0C5C0D54273002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "我覺得即使是自己的祖母，\n如果不想見面的話就不需要見面。<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "621189BA5F9753734F7F662F81EA5DF1768479566BCDFF0C000A5982679C4E0D60F3898B976276848A715C314E0D97008981898B9762300200100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "欸？<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1784,
      "rawDecodedUtf16Hex": "6B38FF1F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "啊，妳的意見讓我有點意外而已。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 1800,
      "rawDecodedUtf16Hex": "554AFF0C59B37684610F898B8B93621167099EDE610F5916800C5DF23002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "與其做自己不喜歡的事，\n不如把時間用在提升自己。<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 1840,
      "rawDecodedUtf16Hex": "82075176505A81EA5DF14E0D559C6B6176844E8BFF0C000A4E0D5982628A664295937528572863D0534781EA5DF1300200100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "如果因此獲得對方的認同，那很幸運。\n但就算不能，也沒有損失！<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 1900,
      "rawDecodedUtf16Hex": "5982679C56E06B6473725F975C0D65B976848A8D540CFF0C90A35F885E78904B3002000A4F465C317B974E0D80FDFF0C4E5F6C926709640D5931FF0100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "嘩嘩～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 1972,
      "rawDecodedUtf16Hex": "56295629FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "看來頭巾混混牠\n也贊成安馨兒的意見呢。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "770B4F86982D5DFE6DF76DF77260000A4E5F8D0A62105B8999A851527684610F898B54623002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "首先我會讓妹妹更開心的。\n畢竟我奶奶一直很溺愛我妹妹。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 2028,
      "rawDecodedUtf16Hex": "99965148621167038B9359B959B966F4958B5FC376843002000A75627ADF6211597659764E0076F45F886EBA611B621159B959B93002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "那麼安馨兒我也做些特別的甜甜圈，\n讓你妹妹開心一下！<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2092,
      "rawDecodedUtf16Hex": "90A39EBC5B8999A8515262114E5F505A4E9B727952257684751C751C5708FF0C000A8B934F6059B959B9958B5FC34E004E0BFF0100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "像這樣一點一滴地\n改變你祖母的感受吧！<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "50CF90196A234E009EDE4E006EF45730000A65398B8A4F6079566BCD7684611F53D75427FF0100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "嘩嘩～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2204,
      "rawDecodedUtf16Hex": "56295629FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "以我的才能，\n我甚至能改變我奶奶的想法！<U+0010><U+0001>븁\n只要她認可我了，\n我就不用討厭她了。<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "4EE562117684624D80FDFF0C000A6211751A81F380FD65398B8A621159765976768460F36CD5FF0100100001BE01000A53EA898159798A8D53EF62114E86FF0C000A62115C314E0D75288A0E53AD59794E863002001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "和<U+0010><U+0002>Ā<U+0000>對戰之後，\n讓我重拾了自信！<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "548C00100002010000005C0D62304E4B5F8CFF0C000A8B93621191CD62FE4E8681EA4FE1FF01001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
