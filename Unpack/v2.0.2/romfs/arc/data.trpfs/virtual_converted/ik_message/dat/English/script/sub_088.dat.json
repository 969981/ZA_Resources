      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "I will be your opponent in the next battle as well.\nAre you ready to begin?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "I’m ready to do this!",
      "escapedControlUnits": 0,
