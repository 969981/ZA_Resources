    },
    {
      "displayText": "Congratulations! You are the champion of Le\nSuper-Tournoi de Jacinthe O!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 5316,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Now, to the victor goes the grandest prize of all...<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 5472,
