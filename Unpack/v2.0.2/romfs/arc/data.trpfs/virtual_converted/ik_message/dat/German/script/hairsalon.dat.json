      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 1996,
      "rawDecodedUtf16Hex": "004D006900740020004C0050002000620065007A00610068006C0065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
