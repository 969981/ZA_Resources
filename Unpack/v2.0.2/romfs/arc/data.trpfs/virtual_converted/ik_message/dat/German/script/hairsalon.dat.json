    },
    {
      "displayText": "Frisur: <U+0010><U+0003>ȃ<U+0000>. <U+E300>",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "004600720069007300750072003A00200010000302030000002E0020E3000000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "N/A",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "004E002F00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Ich hab’s mir anders überlegt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "0049006300680020006800610062201900730020006D0069007200200061006E0064006500720073002000FC006200650072006C006500670074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Ja",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 1940,
      "rawDecodedUtf16Hex": "004A00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Nein",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "004E00650069006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mit Geld bezahlen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 1960,
      "rawDecodedUtf16Hex": "004D00690074002000470065006C0064002000620065007A00610068006C0065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
