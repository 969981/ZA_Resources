      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 106,
      "offsetInSection": 4492,
      "rawDecodedUtf16Hex": "0048006100730074002000640075002000640069006300680020006600FC0072002000640069006500730065002000460072006900730075007200200065006E00740073006300680069006500640065006E003F0000",
      "trailingZeroPaddingUnits": 1,
