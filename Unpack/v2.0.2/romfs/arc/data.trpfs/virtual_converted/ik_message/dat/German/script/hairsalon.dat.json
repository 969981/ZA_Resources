      "rawDecodedUtf16Hex": "004E002F00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Hereinspaziert!\nWas können wir heute für dich tun?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 2060,
      "rawDecodedUtf16Hex": "00480065007200650069006E007300700061007A00690065007200740021000A0057006100730020006B00F6006E006E0065006E00200077006900720020006800650075007400650020006600FC007200200064006900630068002000740075006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "In Ordnung, dann bereite ich alles vor.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 87,
      "offsetInSection": 2164,
      "rawDecodedUtf16Hex": "0049006E0020004F00720064006E0075006E0067002C002000640061006E006E00200062006500720065006900740065002000690063006800200061006C006C0065007300200076006F0072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Du... Äh, ich sag’s ja nur ungern, aber...\nDu hast wohl nicht genug Geld bei dir...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 88,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Du... Äh, ich sag’s ja nur ungern, aber...\nDu hast wohl nicht genug LP bei dir...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 89,
      "offsetInSection": 2412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "So, fertig!<U+0010><U+0001>븁\nSieht klasse aus, oder?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 90,
      "offsetInSection": 2576,
      "rawDecodedUtf16Hex": "0053006F002C0020006600650072007400690067002100100001BE01000A005300690065006800740020006B006C00610073007300650020006100750073002C0020006F006400650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Wir freuen uns auf deinen nächsten Besuch!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 91,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "005700690072002000660072006500750065006E00200075006E007300200061007500660020006400650069006E0065006E0020006E00E400630068007300740065006E002000420065007300750063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Möchtest du deine Kopfbedeckung wieder\naufsetzen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 92,
      "offsetInSection": 2744,
      "rawDecodedUtf16Hex": "004D00F60063006800740065007300740020006400750020006400650069006E00650020004B006F0070006600620065006400650063006B0075006E00670020007700690065006400650072000A006100750066007300650074007A0065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Alles klar! Das sieht natürlich auch schick aus!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 93,
      "offsetInSection": 2844,
      "rawDecodedUtf16Hex": "0041006C006C006500730020006B006C00610072002100200044006100730020007300690065006800740020006E0061007400FC0072006C00690063006800200061007500630068002000730063006800690063006B002000610075007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Gut, dann geht die Kopfbedeckung in deinen\nBeutel zurück.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 94,
      "offsetInSection": 2944,
      "rawDecodedUtf16Hex": "004700750074002C002000640061006E006E0020006700650068007400200064006900650020004B006F0070006600620065006400650063006B0075006E006700200069006E0020006400650069006E0065006E000A00420065007500740065006C0020007A0075007200FC0063006B002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Mit dieser Frisur kannst du keine Kopfbedeckung\ntragen.<U+0010><U+0001>븁\nIch hab sie für dich in deinen Beutel gelegt.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 95,
      "offsetInSection": 3060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Gut, das wären dann insgesamt <U+0010><U+0003>Ȇ<U+0000>. <U+E300>.\nWie möchtest du bezahlen?",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 96,
      "offsetInSection": 3272,
      "rawDecodedUtf16Hex": "004700750074002C00200064006100730020007700E400720065006E002000640061006E006E00200069006E00730067006500730061006D007400200010000302060000002E0020E300002E000A0057006900650020006D00F6006300680074006500730074002000640075002000620065007A00610068006C0065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "So hättest du es also gern?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 97,
      "offsetInSection": 3404,
      "rawDecodedUtf16Hex": "0053006F0020006800E40074007400650073007400200064007500200065007300200061006C0073006F0020006700650072006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Das wäre dann so ziemlich derselbe Look,\nden du bisher auch hattest. Ist das okay?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 98,
      "offsetInSection": 3460,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Das nenn ich mal einen frischen Style!\nEcht klasse! Soll ich anfangen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 99,
      "offsetInSection": 3628,
      "rawDecodedUtf16Hex": "0044006100730020006E0065006E006E00200069006300680020006D0061006C002000650069006E0065006E00200066007200690073006300680065006E0020005300740079006C00650021000A00450063006800740020006B006C0061007300730065002100200053006F006C006C002000690063006800200061006E00660061006E00670065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Alles klar! Dann kümmere ich mich mal um\ndeine Frisur.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 100,
      "offsetInSection": 3772,
      "rawDecodedUtf16Hex": "0041006C006C006500730020006B006C006100720021002000440061006E006E0020006B00FC006D006D00650072006500200069006300680020006D0069006300680020006D0061006C00200075006D000A006400650069006E00650020004600720069007300750072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Alles klar! Lass dir ruhig Zeit, wenn du noch\netwas nachdenken willst.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 101,
      "offsetInSection": 3884,
      "rawDecodedUtf16Hex": "0041006C006C006500730020006B006C0061007200210020004C00610073007300200064006900720020007200750068006900670020005A006500690074002C002000770065006E006E0020006400750020006E006F00630068000A006500740077006100730020006E00610063006800640065006E006B0065006E002000770069006C006C00730074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Huch? Willst du dir doch lieber keine neue Frisur\nzulegen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 102,
      "offsetInSection": 4028,
      "rawDecodedUtf16Hex": "0048007500630068003F002000570069006C006C00730074002000640075002000640069007200200064006F006300680020006C006900650062006500720020006B00650069006E00650020006E0065007500650020004600720069007300750072000A007A0075006C006500670065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Alles klar! Dann lassen wir es für heute.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 103,
      "offsetInSection": 4148,
      "rawDecodedUtf16Hex": "0041006C006C006500730020006B006C006100720021002000440061006E006E0020006C0061007300730065006E00200077006900720020006500730020006600FC0072002000680065007500740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Alles klar! Denk gerne noch ein Weilchen nach.\nDu hast alle Zeit der Welt!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 104,
      "offsetInSection": 4232,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Also dann! Was für eine Frisur hättest du denn\ngerne?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 105,
      "offsetInSection": 4384,
      "rawDecodedUtf16Hex": "0041006C0073006F002000640061006E006E002100200057006100730020006600FC0072002000650069006E006500200046007200690073007500720020006800E400740074006500730074002000640075002000640065006E006E000A006700650072006E0065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
