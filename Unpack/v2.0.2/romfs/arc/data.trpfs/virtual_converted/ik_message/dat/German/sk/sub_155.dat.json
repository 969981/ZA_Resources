      "offsetInSection": 5356,
      "rawDecodedUtf16Hex": "00470072006F0069006E006B002000730063006800650069006E0074002000730069006300680020007A0075002000660072006500750065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
