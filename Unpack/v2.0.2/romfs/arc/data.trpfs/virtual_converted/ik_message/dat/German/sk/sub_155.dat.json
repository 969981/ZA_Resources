      "index": 38,
      "offsetInSection": 4848,
      "rawDecodedUtf16Hex": "004F0069006E006B00210020004F0069006E006B00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Groink hat zweimal gequiekt.<U+0010><U+0001>븁\nVielleicht möchte es zwei Getränke kaufen,\ndie zusammen 1000 <U+E300> ergeben?",
      "escapedControlUnits": 3,
