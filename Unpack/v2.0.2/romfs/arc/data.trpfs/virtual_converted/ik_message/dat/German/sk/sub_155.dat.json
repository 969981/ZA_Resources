      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 239
    },
    {
      "displayText": "45.700 <U+E300>, bitte!",
