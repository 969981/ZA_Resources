      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "和您收取的費用會是<U+E300><U+0010><U+0003>ȃ<U+0000><U+0000>，\n確定這個樣子可以嗎？",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
