      "rawDecodedUtf16Hex": "89817ACB523B63DB4E0A55CEFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "這件物品之前\n已經購買了。",
