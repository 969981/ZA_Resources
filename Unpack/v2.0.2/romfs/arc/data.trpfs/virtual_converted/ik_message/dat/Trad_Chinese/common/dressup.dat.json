      "rawDecodedUtf16Hex": "8B1D8B1D514981E83002000A8981518D4F865594FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "這樣是<U+E300><U+0010><U+0003>Ȇ<U+0000><U+0000>，\n確定要購買嗎？",
