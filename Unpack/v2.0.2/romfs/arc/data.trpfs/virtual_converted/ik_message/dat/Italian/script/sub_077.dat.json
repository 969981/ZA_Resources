      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Mosse +",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4560,
      "rawDecodedUtf16Hex": "004D006F0073007300650020002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Non è che ti confondi con il Dynamax?<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4576,
      "rawDecodedUtf16Hex": "004E006F006E002000E8002000630068006500200074006900200063006F006E0066006F006E0064006900200063006F006E00200069006C002000440079006E0061006D00610078003F001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Signor<U+0010><U+0003>ᄀÿ̀ina espert<U+0010><U+0003>ᄀÿāoa della megaevoluzione, qui\nquello che bisogna migliorare sono le tue lezioni!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Capito! Queste mosse hanno qualcosa in più!\nPer questo si chiamano così!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Dicono che ci sono dei Pokémon che quando si\nmegaevolvono cambiano tipo. Sai dircene uno?<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5036,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
