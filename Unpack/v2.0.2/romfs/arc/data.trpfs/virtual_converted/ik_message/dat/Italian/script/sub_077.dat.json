      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "004D0065006700610070006900650074007200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Megarocce",
