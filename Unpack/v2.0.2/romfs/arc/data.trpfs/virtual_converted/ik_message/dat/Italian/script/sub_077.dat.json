      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Ma MegaManectric resta di tipo Elettro!<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5504,
      "rawDecodedUtf16Hex": "004D00610020004D006500670061004D0061006E0065006300740072006900630020007200650073007400610020006400690020007400690070006F00200045006C0065007400740072006F002100100002011401990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Che noiosi che siete con queste domande\nda secchioni! Ora ne faccio una io! State a sentire!<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 5592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Signor<U+0010><U+0003>ᄀÿ̀ina espert<U+0010><U+0003>ᄀÿāoa della megaevoluzione, qual è\nil più forte tra questi Pokémon megaevoluti?<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 6,
