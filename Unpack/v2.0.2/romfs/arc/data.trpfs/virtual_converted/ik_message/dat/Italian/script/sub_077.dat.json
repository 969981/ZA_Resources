      "rawDecodedUtf16Hex": "00450065006C0065006B00740072006F006C0069007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Si attacca \"-ite\" alla fine, quindi! Che buffo!<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "005300690020006100740074006100630063006100200022002D006900740065002200200061006C006C0061002000660069006E0065002C0020007100750069006E006400690021002000430068006500200062007500660066006F0021001000020114019B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "La risposta giusta è Eelektrossite...<U+0010><U+0001>븁\nIn questo caso si usa il nome del Pokémon così\ncom’è, ma dipende da Pokémon a Pokémon.<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "C’è una elle di troppo e due esse di meno!\nÈ Eelektrossite, non Eelektrolite!<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4056,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Ora tocca a me!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4220,
      "rawDecodedUtf16Hex": "004F0072006100200074006F006300630061002000610020006D00650021001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Ho sentito che quando un Pokémon si\nmegaevolve, le sue mosse diventano più potenti.<U+0010><U+0001>븀\nCome si chiamano queste mosse?<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "Mosse max",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4504,
      "rawDecodedUtf16Hex": "004D006F0073007300650020006D006100780000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Mosse migliorate",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4524,
