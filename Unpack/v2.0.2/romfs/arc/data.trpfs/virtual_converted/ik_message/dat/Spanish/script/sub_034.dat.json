      "offsetInSection": 168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Algunos movimientos generan ciertos efectos en\nel campo de batalla, conocidos como \"trampas\".<U+0010><U+0002>ĔŃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
