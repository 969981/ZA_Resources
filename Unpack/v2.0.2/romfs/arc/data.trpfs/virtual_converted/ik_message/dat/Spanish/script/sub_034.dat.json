      "index": 10,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Estupendo, pero ten en cuenta que mis Pokémon\nsolo usan movimientos que colocan trampas...<U+0010><U+0002>ĔŃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
