      "offsetInSection": 1492,
      "rawDecodedUtf16Hex": "004E006F0020006500730074006F00790020006C00690073007400100003110000FF0101006F00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Prepárate cuanto quieras, pequeñ<U+0010><U+0003>ᄀÿāoa...\nMis trampas son ineludibles.<U+0010><U+0002>ĔŃ",
      "escapedControlUnits": 4,
