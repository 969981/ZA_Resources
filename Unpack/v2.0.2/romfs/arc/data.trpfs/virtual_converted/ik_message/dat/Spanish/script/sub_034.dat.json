      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "¡Acepto el desafío!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1452,
      "rawDecodedUtf16Hex": "00A100410063006500700074006F00200065006C00200064006500730061006600ED006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "No estoy list<U+0010><U+0003>ᄀÿāoa",
