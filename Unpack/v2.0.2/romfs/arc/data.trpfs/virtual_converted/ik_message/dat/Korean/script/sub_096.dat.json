      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "요가랑과 함께 명상을 하다 보면\n저 혼자 졸고 있단 말이죠...<U+0010><U+0002>ĔŹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
