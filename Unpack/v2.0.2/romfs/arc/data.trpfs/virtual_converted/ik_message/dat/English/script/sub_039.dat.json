    },
    {
      "displayText": "Hey, what do you say to having an interesting\nPokémon battle with me?<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 576,
