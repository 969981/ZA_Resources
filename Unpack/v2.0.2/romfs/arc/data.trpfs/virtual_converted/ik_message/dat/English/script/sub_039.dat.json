      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ah, I see you have only Flying-type Pokémon on\nyour team. Let’s get our battle going, then!<U+0010><U+0002>Ĕň",
