      "flagsUpper16": 0,
      "index": 110,
      "offsetInSection": 4712,
      "rawDecodedUtf16Hex": "4F01528390196771897F76844EBA000A52305E95572860F34EC09EBC30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "呀哈～！",
