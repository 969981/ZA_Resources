      "offsetInSection": 4744,
      "rawDecodedUtf16Hex": "544054C8FF5EFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "辣椒精華，\n真是不得了的招式啊！",
