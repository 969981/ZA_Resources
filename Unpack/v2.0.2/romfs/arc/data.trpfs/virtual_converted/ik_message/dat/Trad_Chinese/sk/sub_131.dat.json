      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "香得又強又烈！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 105,
      "offsetInSection": 4576,
      "rawDecodedUtf16Hex": "99995F9753C85F3753C870C8FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "這下我要愛上\n狠辣椒了！",
