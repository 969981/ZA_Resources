      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 600,
      "rawDecodedUtf16Hex": "004D0065006F007700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "I’m so nervous, I don’t think I’ll be able to carry\non a conversation...so I’m asking for your help!<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Could you please help me talk to her? Please?\nPLEASE?!<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "0043006F0075006C006400200079006F007500200070006C0065006100730065002000680065006C00700020006D0065002000740061006C006B00200074006F0020006800650072003F00200050006C0065006100730065003F000A0050004C0045004100530045003F002100100002011401E20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Let me know when you’re ready to help... Please!\nI really need this!<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
