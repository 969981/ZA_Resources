    {
      "displayText": "Der Holo-Lift wird derzeit gewartet und ist daher\naußer Betrieb. Bitte Abstand halten.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Vorsicht! Geh nicht zu nah ran, das sieht\nübelst gefährlich aus!<U+0010><U+0002>ĔŘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
