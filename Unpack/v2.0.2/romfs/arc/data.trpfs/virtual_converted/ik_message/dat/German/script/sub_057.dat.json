      "utf16Units": 5
    },
    {
      "displayText": "Oh! Voltenso und Ampharos sind abgehauen?!<U+0010><U+0002>ĔŘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "004F0068002100200056006F006C00740065006E0073006F00200075006E006400200041006D0070006800610072006F0073002000730069006E0064002000610062006700650068006100750065006E003F002100100002011401580000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Die beiden haben sich doch vorhin noch um den\nHolo-Lift gefetzt. Ich hab mich nicht rangetraut,<U+0010><U+0001>븀\ndie waren viel zu krass drauf für mich...!<U+0010><U+0002>ĔŘ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1424,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 146
    },
    {
      "displayText": "H-Hast du sie etwa davongejagt?<U+0010><U+0002>ĔŘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1716,
