      "rawDecodedUtf16Hex": "0054006A0061002C00200049006C006C0075006D0069006E006100200068006100740020006500620065006E0020007600690065006C0020007A0075002000620069006500740065006E002C0020006E00690063006800740020006E007500720020006600FC0072000A0075006E00730020004D0065006E0073006300680065006E002E00100002011401580000",
      "trailingZeroPaddingUnits": 1,
