      "rawDecodedUtf16Hex": "554AFF0C90A34E2A20262026000A60A8768494B1597D50CF4E0D591F30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "啊，那个……\n您的LP好像不够。",
