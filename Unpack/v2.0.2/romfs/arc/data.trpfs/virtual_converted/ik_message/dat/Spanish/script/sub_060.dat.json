      "rawDecodedUtf16Hex": "00A1005200750070007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Si me ayudas a conseguirlo, vamos a pachas.\n¿Qué me dices?<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
