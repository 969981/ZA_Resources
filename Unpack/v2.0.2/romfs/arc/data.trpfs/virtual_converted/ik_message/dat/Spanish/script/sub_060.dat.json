      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "¿Qué te parece esta sala? Tiene la humedad\nperfecta, ¿no crees?<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
