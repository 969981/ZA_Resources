    },
    {
      "displayText": "Lovely to see you! I’d like your help with another\nperfume, if you don’t mind.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "This time, I’m interested in Inkay’s ink!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 352,
      "rawDecodedUtf16Hex": "0054006800690073002000740069006D0065002C002000492019006D00200069006E0074006500720065007300740065006400200069006E00200049006E006B006100792019007300200069006E006B002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "By now I’m sure you can guess what I’m going\nto ask...<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "004200790020006E006F0077002000492019006D0020007300750072006500200079006F0075002000630061006E00200067007500650073007300200077006800610074002000492019006D00200067006F0069006E0067000A0074006F002000610073006B002E002E002E00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Please bring me an Inkay, if you would!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "0050006C00650061007300650020006200720069006E00670020006D006500200061006E00200049006E006B00610079002C00200069006600200079006F007500200077006F0075006C0064002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Once you’ve caught an Inkay, please put it in your\nparty and come see me!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
