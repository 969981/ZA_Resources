      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wenn du dir etwas nimmst, das dir nicht gehört,\nist das Diebstahl. Verstanden, Dedenne?<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
