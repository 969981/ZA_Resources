      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 163
    },
    {
      "displayText": "Lo que necesito es un Gogoat enorme que pueda\ncargar con los bultos más grandes, ¿me explico?<U+0010><U+0002>Ĕĳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
