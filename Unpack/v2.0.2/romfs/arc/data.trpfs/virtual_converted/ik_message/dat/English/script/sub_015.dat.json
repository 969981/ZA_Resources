      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "GAH?! It’s gargantuan! Way bigger than I’d ever\nimagined!<U+0010><U+0002>Ĕĳ",
