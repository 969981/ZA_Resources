      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "0047006F0067006F006F006F0021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Geeeh...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2204,
      "rawDecodedUtf16Hex": "00470065006500650068002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Aw, don’t you worry, my little helpers! I haven’t\nforgotten about you!<U+0010><U+0002>Ĕĳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
