      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Oop. This one’s not big enough, I’m afraid. I need\na Gogoat with a size classification of XL!<U+0010><U+0002>Ĕĳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Now that’s a huge Gogoat if I ever saw one! It’s\nan extra helping of extra-large greatness!<U+0010><U+0002>Ĕĳ",
