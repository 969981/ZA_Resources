      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1772,
      "rawDecodedUtf16Hex": "004700410048003F002100200049007420190073002000670061007200670061006E007400750061006E0021002000570061007900200062006900670067006500720020007400680061006E002000492019006400200065007600650072000A0069006D006100670069006E00650064002100100002011401330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "With a beaut like this helping us out, we’ll be able\nto carry bigger packages, no problem!<U+0010><U+0001>븁\nLooking forward to working with you, Gogoat!<U+0010><U+0002>Ĕĳ",
