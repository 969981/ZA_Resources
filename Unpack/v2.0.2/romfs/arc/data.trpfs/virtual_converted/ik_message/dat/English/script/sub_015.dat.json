      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Give me a shout if you manage to catch an extra-\nlarge Gogoat, you hear?<U+0010><U+0002>Ĕĳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
