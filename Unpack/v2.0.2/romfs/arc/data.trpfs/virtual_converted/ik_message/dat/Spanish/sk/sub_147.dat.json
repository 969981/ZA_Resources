      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Pues las reglas no podrían ser más fáciles.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
