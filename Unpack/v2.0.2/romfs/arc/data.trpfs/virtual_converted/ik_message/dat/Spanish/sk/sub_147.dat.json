      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1412,
      "rawDecodedUtf16Hex": "00410068006F007200610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Ahora no apetece, ¿eh? Da igual, yo siempre\nestoy aquí.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1432,
      "rawDecodedUtf16Hex": "00410068006F007200610020006E006F00200061007000650074006500630065002C002000BF00650068003F00200044006100200069006700750061006C002C00200079006F0020007300690065006D007000720065000A006500730074006F0079002000610071007500ED002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "¿Crees que podrás aguantar <U+0010><U+0002>＀<U+0006>30 segundos<U+0010><U+0002>＀<U+0000>\ndesarmad<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0001>븁\n¡Vas a flipar con la experiencia! ¡Toda una\ndescarga de electroadrenalina!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 146
    },
    {
      "displayText": "Preparados, listos...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
