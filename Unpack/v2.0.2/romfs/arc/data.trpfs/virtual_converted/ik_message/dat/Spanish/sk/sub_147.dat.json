    },
    {
      "displayText": "Supongo que vienes a probar mi entrenamiento\nde alto voltaje.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
