      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1896,
      "rawDecodedUtf16Hex": "00A1005900610021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
