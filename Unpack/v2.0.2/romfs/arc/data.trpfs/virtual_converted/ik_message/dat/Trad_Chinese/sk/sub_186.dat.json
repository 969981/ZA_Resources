  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "僅與光臨本店的\n顧客分享……<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "50C58207514981E8672C5E977684000A98675BA252064EAB2026202600100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "我……意外獲得了\n非比尋常的東西。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 428,
      "rawDecodedUtf16Hex": "621120262026610F591673725F974E86000A975E6BD45C0B5E3876846771897F300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "就是通稱<U+E300>10萬咖啡的\n極訓咖啡所使用的豆子……<U+0010><U+0001>븀\n這是那種豆子中的至高極品。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 472,
      "rawDecodedUtf16Hex": "5C31662F901A7A31E30000310030842C549655617684000A69758A135496556162404F7F752876848C465B502026202600100001BE00000A9019662F90A37A2E8C465B504E2D768481F39AD8697554C1300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "能夠採收的地方少之又少，\n能夠採收的量也少之又少。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "80FD592063A165367684573065B95C114E4B53C85C11FF0C000A80FD592063A16536768491CF4E5F5C114E4B53C85C11300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "這是拜託寶可夢才好不容易採收到的豆子！\n而且是最高等級當中屬於至高無上的豆子。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "9019662F62DC8A175BF653EF5922624D597D4E0D5BB9661363A16536523076848C465B50FF01000A800C4E14662F67009AD87B497D1A75764E2D5C6C65BC81F39AD871214E0A76848C465B50300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "堪稱是百年一遇的結晶！<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "582A7A31662F767E5E744E00904776847D506676FF0100100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "……您有興趣嗎？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 744,
      "rawDecodedUtf16Hex": "2026202660A8670982088DA355CEFF1F00100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "有興趣",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 772,
      "rawDecodedUtf16Hex": "670982088DA30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "沒興趣",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 780,
      "rawDecodedUtf16Hex": "6C9282088DA30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "區區<U+E300>10萬的咖啡\n與您較為相配。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 788,
      "rawDecodedUtf16Hex": "53405340E30000310030842C768454965561000A820760A88F0370BA76F8914D300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "……一杯<U+E300>100萬。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "202620264E00676FE300003100300030842C300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "若您真的感興趣且不會後悔的話，\n就請點一杯吧。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "82E560A8771F7684611F82088DA34E144E0D67035F8C609476848A71FF0C000A5C318ACB9EDE4E00676F5427300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "您光臨本店是來品嚐\n百年一遇的<U+0010><U+0001>븁\n超絕最高級嚴選究極咖啡，\n通稱「極訓特選」的嗎？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 932,
      "rawDecodedUtf16Hex": "60A8514981E8672C5E97662F4F8654C15690000A767E5E744E009047768400100001BE01000A8D857D5567009AD87D1A56B490787A76697554965561FF0C000A901A7A31300C69758A1372799078300D768455CEFF1F00100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "是",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "662F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 2
    },
    {
      "displayText": "不是",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "4E0D662F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "區區<U+E300>10萬的咖啡\n與您較為相配。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "53405340E30000310030842C768454965561000A820760A88F0370BA76F8914D300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "竟然拿不出<U+E300>100萬……<U+0010><U+0001>븁\n還是區區<U+E300>10萬的咖啡\n與您較為相配。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1084,
      "rawDecodedUtf16Hex": "7ADF713662FF4E0D51FAE300003100300030842C2026202600100001BE01000A9084662F53405340E30000310030842C768454965561000A820760A88F0370BA76F8914D300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "請問是百分百確定嗎？<U+0010><U+0001>븁\n您的身分配得上飲用\n<U+E300>100萬的咖啡嗎？<U+0010><U+0001>븁\n對這一筆支出不會後悔嗎？\n即便喝了，您懂得品嚐它的滋味嗎？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "8ACB554F662F767E5206767E78BA5B9A55CEFF1F00100001BE01000A60A876848EAB5206914D5F974E0A98F27528000AE300003100300030842C76845496556155CEFF1F00100001BE01000A5C0D90194E007B46652F51FA4E0D67035F8C609455CEFF1F000A53734FBF559D4E86FF0C60A861C25F9754C156905B8376846ECB547355CEFF1F00100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "我確定",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "621178BA5B9A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "算了",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1316,
      "rawDecodedUtf16Hex": "7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "所謂懂得品嚐滋味，\n不單指嚐得出味道，<U+0010><U+0001>븁\n還要懂得嚐出這杯<U+E300>100萬咖啡的\n相關食材與沖煮方式等背景資訊。<U+0010><U+0001>븁\n請問您能說您懂得品嚐\n<U+E300>100萬咖啡的滋味嗎？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "我懂",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "621161C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "我不懂",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1508,
      "rawDecodedUtf16Hex": "62114E0D61C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "您能用自己的話語描述\n<U+E300>100萬咖啡的滋味嗎？<U+0010><U+0001>븁\n有<U+E300>100萬的味道……\n用這種話可表達不出個所以然喔？<U+0010><U+0001>븁\n您難道不是想炫耀自己喝過\n<U+E300>100萬咖啡而已嗎？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "我要喝！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1692,
      "rawDecodedUtf16Hex": "62118981559DFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "還是算了",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "9084662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "付了<U+E300>100萬，<U+0010><U+0001>븁\n要是說了粗淺的感想，\n將會成為一輩子的恥辱喔。<U+0010><U+0001>븁\n即便如此，您還是要喝\n超絕最高級嚴選究極咖啡，<U+0010><U+0001>븀\n通稱「極訓特選」嗎？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "我要喝！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "62118981559DFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "還是算了",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1892,
      "rawDecodedUtf16Hex": "9084662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我再確認最後一次。<U+0010><U+0001>븁\n您確定要喝百年一遇的\n超絕最高級嚴選究極咖啡，<U+0010><U+0001>븁\n通稱「極訓特選」嗎？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "6211518D78BA8A8D67005F8C4E006B21300200100001BE01000A60A878BA5B9A8981559D767E5E744E0090477684000A8D857D5567009AD87D1A56B490787A76697554965561FF0C00100001BE01000A901A7A31300C69758A1372799078300D55CEFF1F00100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "我要喝！！！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "62118981559DFF01FF01FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "還是算了",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "9084662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "那份堅定不移的覺悟……<U+0010><U+0001>븁\n您或許真的配得上飲用\n百年一遇的<U+0010><U+0001>븁\n超絕最高級嚴選究極咖啡，\n通稱「極訓特選」吧。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "90A34EFD58055B9A4E0D79FB768489BA609F2026202600100001BE01000A60A862168A31771F7684914D5F974E0A98F27528000A767E5E744E009047768400100001BE01000A8D857D5567009AD87D1A56B490787A76697554965561FF0C000A901A7A31300C69758A1372799078300D5427300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "我表現得像是在試探您，\n真是萬分抱歉。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "6211886873FE5F9750CF662F57288A6663A260A8FF0C000A771F662F842C520662B16B49300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我這就為您端上，\n敬請細細品味。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "621190195C3170BA60A87AEF4E0AFF0C000A656C8ACB7D307D3054C15473300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "請享用超絕最高級嚴選究極咖啡，\n通稱「極訓特選」吧。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "8ACB4EAB75288D857D5567009AD87D1A56B490787A76697554965561FF0C000A901A7A31300C69758A1372799078300D5427300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "喝下去",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2328,
      "rawDecodedUtf16Hex": "559D4E0B53BB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "做心理準備",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "505A5FC374066E9650990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "百年一遇的\n超絕最高級嚴選究極咖啡，<U+0010><U+0001>븁\n通稱「極訓特選」，\n您覺得味道如何呢？<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 2348,
      "rawDecodedUtf16Hex": "767E5E744E0090477684000A8D857D5567009AD87D1A56B490787A76697554965561FF0C00100001BE01000A901A7A31300C69758A1372799078300DFF0C000A60A889BA5F975473905359824F555462FF1F00100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "這是勝過一切的幸福體驗",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "9019662F52DD904E4E00520776845E78798F9AD49A570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "有著至高的香氣和餘味",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2464,
      "rawDecodedUtf16Hex": "6709845781F39AD8768499996C23548C991854730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "這是千年一遇的滋味",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "9019662F53435E744E00904776846ECB54730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "普普通通耶",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2508,
      "rawDecodedUtf16Hex": "666E666E901A901A80360000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "您能懂得這一點，\n也可以說是花<U+E300>100萬換來的經驗。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "60A880FD61C25F9790194E009EDEFF0C000A4E5F53EF4EE58AAA662F82B1E300003100300030842C63DB4F8676847D939A57300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "感謝您這番配得上\n<U+E300>100萬咖啡的美言。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2584,
      "rawDecodedUtf16Hex": "611F8B1D60A89019756A914D5F974E0A000AE300003100300030842C5496556176847F8E8A00300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
