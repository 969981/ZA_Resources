      "rawDecodedUtf16Hex": "004E006F006E002C0020006A00650020006E00650020006C006500200063006F006E006E0061006900730020007000610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
