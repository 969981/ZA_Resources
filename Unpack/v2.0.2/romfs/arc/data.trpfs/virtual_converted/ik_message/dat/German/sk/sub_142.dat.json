{
  "declaredLength": 6644,
  "decoding": "confirmed-per-slot-XOR-rotate3-index-seed",
  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Sieht aus, als hätte ich es zu Hause vergessen...<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 380,
      "rawDecodedUtf16Hex": "005300690065006800740020006100750073002C00200061006C00730020006800E400740074006500200069006300680020006500730020007A0075002000480061007500730065002000760065007200670065007300730065006E002E002E002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Hey, kann ich dich um was bitten?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "004800650079002C0020006B0061006E006E00200069006300680020006400690063006800200075006D0020007700610073002000620069007400740065006E003F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Wobei... Nee, vergiss es. Ich frag Antja.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "0057006F006200650069002E002E002E0020004E00650065002C00200076006500720067006900730073002000650073002E00200049006300680020006600720061006700200041006E0074006A0061002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Hey, Antja. Kann ich Hoopa um einen Gefallen\nbitten?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 656,
      "rawDecodedUtf16Hex": "004800650079002C00200041006E0074006A0061002E0020004B0061006E006E002000690063006800200048006F006F0070006100200075006D002000650069006E0065006E00200047006500660061006C006C0065006E000A00620069007400740065006E003F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Die Antwort ist Nein.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 772,
      "rawDecodedUtf16Hex": "00440069006500200041006E00740077006F0072007400200069007300740020004E00650069006E002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Hä?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "004800E4003F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Es ist nicht die feine Art, Hoopa loszuschicken,\num dir etwas von zu Hause zu holen.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 840,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Aber... Du lässt Hoopa doch auch Dinge für dich\nerledigen.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1020,
      "rawDecodedUtf16Hex": "0041006200650072002E002E002E0020004400750020006C00E400730073007400200048006F006F0070006100200064006F0063006800200061007500630068002000440069006E006700650020006600FC007200200064006900630068000A00650072006C00650064006900670065006E002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ich habe Hoopa nur darum gebeten, mich von\neinem Hotel ins andere zu bringen, damit ich<U+0010><U+0001>븀\nniemandem unnötige Sorgen bereite.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "Außerdem sagt meine Mutter, dass man nicht\nfaul sein darf.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "0041007500DF0065007200640065006D002000730061006700740020006D00650069006E00650020004D00750074007400650072002C002000640061007300730020006D0061006E0020006E0069006300680074000A006600610075006C0020007300650069006E00200064006100720066002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Hm... Vielleicht verlasse ich mich tatsächlich\netwas zu viel auf <U+0010><U+0002>Ā<U+0000> und die<U+0010><U+0001>븀\nanderen.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Ja, ist gut, ich hab’s kapiert. Ich kümmer mich\nselbst um meine Sachen.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Aber um mich aufzuraffen, brauche ich erst mal\ndeine Hilfe, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0001>븁\nBitte kämpf gegen mich, und zwar ernsthaft!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1884,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Ich warte vor dem Hotel auf dich.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "00490063006800200077006100720074006500200076006F0072002000640065006D00200048006F00740065006C002000610075006600200064006900630068002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Ich glaube, wir sollten uns auch ansehen,\nwie Kaylen sich anstrengt.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "00490063006800200067006C0061007500620065002C002000770069007200200073006F006C006C00740065006E00200075006E00730020006100750063006800200061006E0073006500680065006E002C000A0077006900650020004B00610079006C0065006E0020007300690063006800200061006E0073007400720065006E00670074002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Pehehe!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "00500065006800650068006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2360,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Kämpf gegen mich und gib dabei alles,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2372,
      "rawDecodedUtf16Hex": "00100002BD060000004B00E4006D0070006600200067006500670065006E0020006D00690063006800200075006E0064002000670069006200200064006100620065006900200061006C006C00650073002C000A00100002010000000021001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Aber sicher!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2476,
      "rawDecodedUtf16Hex": "0041006200650072002000730069006300680065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Ich bin noch nicht so weit.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "004900630068002000620069006E0020006E006F006300680020006E006900630068007400200073006F00200077006500690074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Natürlich kämpfe ich, um zu gewinnen.<U+0010><U+0001>븁\nAber ich möchte auch testen, wie sehr ich mich\nins Zeug legen kann.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2560,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Wie viel kann ich aus mir rausholen, wenn ich\ngegen <U+0010><U+0004>ᄀÿᘕ<U+0000>den stärksten Trainerdie stärkste Trainerin Illuminas kämpfe?<U+0010><U+0001>븀\nEs wird Zeit, mich selbst zu testen.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 164
    },
    {
      "displayText": "Ich wollte schon länger mal sehen, wie stark\nIrokex ist!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3116,
      "rawDecodedUtf16Hex": "00490063006800200077006F006C006C007400650020007300630068006F006E0020006C00E4006E0067006500720020006D0061006C00200073006500680065006E002C002000770069006500200073007400610072006B000A00490072006F006B006500780020006900730074002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Pehe!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3240,
      "rawDecodedUtf16Hex": "005000650068006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3252,
      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du bist immer für mich da, Irokex. Jetzt bin ich\nan der Reihe, dich gut dastehen zu lassen!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3456,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "War ja nicht anders zu erwarten.<U+0010><U+0001>븁\nAber schon toll, dass ich dir einen Kampf bieten\nkonnte, bei dem du dich nicht zurückhalten<U+0010><U+0001>븀\nmusstest, oder?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 151
    },
    {
      "displayText": "Ja! Ihr wart beide hervorragend!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3772,
      "rawDecodedUtf16Hex": "004A0061002100200049006800720020007700610072007400200062006500690064006500200068006500720076006F00720072006100670065006E0064002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Aber wie kann sich denn jemand wie du so davor\nscheuen, nach Hause zu gehen, Kaylen?<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Meine Schwester würde ich schon gerne sehen,\naber meiner Oma will ich nicht unter die Augen<U+0010><U+0001>븀\ntreten...<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4028,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "Ach, sorry... Ganz schön egoistisch von mir,\nwo du doch so weit weg von deiner Mutter bist.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4248,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Also ich finde, wenn du deine Großmutter nicht\nsehen willst, dann musst du das auch nicht.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4440,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Was?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4632,
      "rawDecodedUtf16Hex": "005700610073003F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Das hätte ich von dir jetzt nicht erwartet.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4652,
      "rawDecodedUtf16Hex": "0044006100730020006800E4007400740065002000690063006800200076006F006E00200064006900720020006A00650074007A00740020006E0069006300680074002000650072007700610072007400650074002E001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Man sollte die Zeit lieber nutzen, um an sich zu\narbeiten, anstatt Dinge zu tun, die man nicht tun<U+0010><U+0001>븀\nwill.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Wenn die andere Person das akzeptiert, hat man\nGlück. Wenn nicht, hat man dennoch nichts<U+0010><U+0001>븀\nverloren.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Iro!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5184,
      "rawDecodedUtf16Hex": "00490072006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du bist also auch Antjas Meinung, Irokex?<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5196,
      "rawDecodedUtf16Hex": "004400750020006200690073007400200061006C0073006F0020006100750063006800200041006E0074006A006100730020004D00650069006E0075006E0067002C002000490072006F006B00650078003F001000020114000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Ich werd wohl erst mal meine Schwester so\nrichtig, richtig glücklich machen.<U+0010><U+0001>븁\nMeine Oma ist nämlich total vernarrt in sie.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "Dann werde ich mich auch beteiligen und einen\nDonut kreieren, über den sich deine Schwester<U+0010><U+0001>븀\nbestimmt freut!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "So können wir deine Großmutter vielleicht Stück\nfür Stück umstimmen!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5780,
      "rawDecodedUtf16Hex": "0053006F0020006B00F6006E006E0065006E00200077006900720020006400650069006E0065002000470072006F00DF006D007500740074006500720020007600690065006C006C0065006900630068007400200053007400FC0063006B000A006600FC007200200053007400FC0063006B00200075006D007300740069006D006D0065006E002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Iro!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5928,
      "rawDecodedUtf16Hex": "00490072006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Umstimmen kann ich sie bestimmt auch mit\nmeinem Talent.<U+0010><U+0001>븁\nUnd wenn sie mich dann so akzeptiert, muss ich\nihr auch nichts mehr nachtragen.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5940,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 143
    },
    {
      "displayText": "Durch unseren Kampf habe ich wieder mehr\nVertrauen in mich selbst gewonnen.<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Dafür bin ich dir sehr dankbar.<U+0010><U+0001>븁\nAb jetzt werde ich für meine Schwester und euch\nalle meinen Traum weiterverfolgen!<U+0010><U+0002>Ĕ<U+000B>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 6388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "Iro!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 6632,
      "rawDecodedUtf16Hex": "00490072006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    }
  ],
