    },
    {
      "displayText": "This is terrible!<U+0010><U+0002>Ĕź",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "00540068006900730020006900730020007400650072007200690062006C00650021001000020114017A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "My Whirlipede is out of control—it’s whirling all\nover the place!<U+0010><U+0002>Ĕź",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 292,
      "rawDecodedUtf16Hex": "004D007900200057006800690072006C006900700065006400650020006900730020006F007500740020006F006600200063006F006E00740072006F006C2014006900742019007300200077006800690072006C0069006E006700200061006C006C000A006F007600650072002000740068006500200070006C0061006300650021001000020114017A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "It might run into someone or their Pokémon! They\ncould get hurt!<U+0010><U+0002>Ĕź",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "004900740020006D0069006700680074002000720075006E00200069006E0074006F00200073006F006D0065006F006E00650020006F007200200074006800650069007200200050006F006B00E9006D006F006E002100200054006800650079000A0063006F0075006C00640020006700650074002000680075007200740021001000020114017A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Please, I need you to battle my Whirlipede and\nend its rolling rampage!<U+0010><U+0002>Ĕź",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
