      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Sigue a Mime Jr. a una distancia prudencial.\n¡Que no te descubra!<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
