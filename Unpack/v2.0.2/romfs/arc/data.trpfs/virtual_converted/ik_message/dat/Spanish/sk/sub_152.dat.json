      "offsetInSection": 2524,
      "rawDecodedUtf16Hex": "00A1004D00690069006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Por favor, no pierdas de vista a Mime Jr., pero\nque tampoco se dé cuenta de que lo sigues.<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2540,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
