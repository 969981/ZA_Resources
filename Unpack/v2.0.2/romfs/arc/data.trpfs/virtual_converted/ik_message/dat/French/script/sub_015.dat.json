      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Si j’avais un gros Chevroum, je pourrais\ntransporter de plus gros colis !<U+0010><U+0002>Ĕĳ",
