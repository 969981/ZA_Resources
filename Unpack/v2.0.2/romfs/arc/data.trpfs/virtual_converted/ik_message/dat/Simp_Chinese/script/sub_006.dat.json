      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "86C7FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "我会轻～轻地摸的……<U+0010><U+0002>ĔĪ",
