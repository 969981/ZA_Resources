      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "阿柏蛇的尾巴和肚子之类的部位不一样，\n摸上去软软弹弹的！！<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
