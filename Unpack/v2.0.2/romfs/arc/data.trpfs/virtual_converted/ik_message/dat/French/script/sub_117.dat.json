      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5044,
      "rawDecodedUtf16Hex": "004C007500670075002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "La Galerie Clair de Lune... ?\nBizarre...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 5060,
      "rawDecodedUtf16Hex": "004C0061002000470061006C006500720069006500200043006C0061006900720020006400650020004C0075006E0065002E002E002E0020003F000A00420069007A0061007200720065002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Ectoplasma s’est-il éveillé au sens de la mode ?<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 5152,
      "rawDecodedUtf16Hex": "004500630074006F0070006C00610073006D0061002000732019006500730074002D0069006C002000E9007600650069006C006C00E9002000610075002000730065006E00730020006400650020006C00610020006D006F006400650020003F001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "J’aurais préféré qu’il soit au Passage de l’Ombre,\nj’en aurais profité pour passer chez De Mèche.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Direction la Galerie Clair de Lune, alors !<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5464,
      "rawDecodedUtf16Hex": "0044006900720065006300740069006F006E0020006C0061002000470061006C006500720069006500200043006C0061006900720020006400650020004C0075006E0065002C00200061006C006F0072007300200021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Je sens qu’Ectoplasma pourrait être ici...<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5560,
      "rawDecodedUtf16Hex": "004A0065002000730065006E00730020007100752019004500630074006F0070006C00610073006D006100200070006F007500720072006100690074002000EA0074007200650020006900630069002E002E002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5656,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Lugulabre, tu perçois quelque chose ?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5668,
      "rawDecodedUtf16Hex": "004C007500670075006C0061006200720065002C002000740075002000700065007200E7006F006900730020007100750065006C007100750065002000630068006F007300650020003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Lugugu !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 5752,
      "rawDecodedUtf16Hex": "004C00750067007500670075002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Ma ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5772,
      "rawDecodedUtf16Hex": "004D00610020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "C’est lui ?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 5784,
      "rawDecodedUtf16Hex": "004320190065007300740020006C007500690020003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Non... Son cri n’est pas le même.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 5816,
      "rawDecodedUtf16Hex": "004E006F006E002E002E002E00200053006F006E00200063007200690020006E201900650073007400200070006100730020006C00650020006D00EA006D0065002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Ectoplasma !\nReviens !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 66,
      "offsetInSection": 5892,
      "rawDecodedUtf16Hex": "004500630074006F0070006C00610073006D006100200021000A00520065007600690065006E0073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Allez, on rentre. Je vais te préparer du ragoût,\nton plat préféré !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 67,
      "offsetInSection": 5940,
      "rawDecodedUtf16Hex": "0041006C006C0065007A002C0020006F006E002000720065006E007400720065002E0020004A00650020007600610069007300200074006500200070007200E9007000610072006500720020006400750020007200610067006F00FB0074002C000A0074006F006E00200070006C0061007400200070007200E9006600E9007200E9002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Mahaha !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 6076,
      "rawDecodedUtf16Hex": "004D00610068006100680061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Allez, Lugulabre, essaie encore...\nCet homme compte sur toi.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 69,
      "offsetInSection": 6096,
      "rawDecodedUtf16Hex": "0041006C006C0065007A002C0020004C007500670075006C0061006200720065002C002000650073007300610069006500200065006E0063006F00720065002E002E002E000A00430065007400200068006F006D006D006500200063006F006D007000740065002000730075007200200074006F0069002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "C’est bon... Arrêtons-nous là.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 6228,
      "rawDecodedUtf16Hex": "0043201900650073007400200062006F006E002E002E002E002000410072007200EA0074006F006E0073002D006E006F007500730020006C00E0002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Si même toi et Lugulabre n’arrivez pas à le\nretrouver, autant lâcher l’affaire...<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 6300,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Mais...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 6472,
      "rawDecodedUtf16Hex": "004D006100690073002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Je sais très bien que j’aurais dû en faire mon\npartenaire avant qu’il ne décide de s’en aller...<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Je m’en rends compte que maintenant, mais...\nsentir sa présence près de moi était rassurant.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 6700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Tant pis, c’est la vie !<U+0010><U+0001>븁\nMerci beaucoup pour votre aide, en tout cas !\nJe vous laisse.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 6896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "C’était un échec...\nDésolée...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 7084,
      "rawDecodedUtf16Hex": "0043201900E9007400610069007400200075006E002000E90063006800650063002E002E002E000A004400E90073006F006C00E90065002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Cet Ectoplasma était une fashion victime ?\nJe ne m’attendais pas à ça !<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 7156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "<U+0010><U+0002>뷿N",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 7308,
      "rawDecodedUtf16Hex": "00100002BDFF004E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> !\nRegarde ! Il est revenu, comme si de rien n’était !<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 7320,
      "rawDecodedUtf16Hex": "001000020100000000200021000A00520065006700610072006400650020002100200049006C002000650073007400200072006500760065006E0075002C00200063006F006D006D00650020007300690020006400650020007200690065006E0020006E201900E9007400610069007400200021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ecto...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 80,
      "offsetInSection": 7448,
      "rawDecodedUtf16Hex": "004500630074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Peut-être qu’il finira par repartir. Si ça se trouve,\nla prochaine fois, ça sera pour de bon.<U+0010><U+0001>븁\nMais cette fois, je compte bien profiter autant que\npossible de sa présence ! Merci pour tout !<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 7464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 197
    },
    {
      "displayText": "J’ai aussi prévenu Albia qu’Ectoplasma\nétait revenu.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 82,
      "offsetInSection": 7860,
