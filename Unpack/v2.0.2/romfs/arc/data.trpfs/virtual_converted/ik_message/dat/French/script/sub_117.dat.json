      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tu es toujours aussi fort<U+0010><U+0003>ᄀÿĀe...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 17,
