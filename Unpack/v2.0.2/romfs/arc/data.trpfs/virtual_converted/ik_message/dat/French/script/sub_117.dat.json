      "index": 22,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "Donc n’en attends pas trop de ma part.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3076,
      "rawDecodedUtf16Hex": "0044006F006E00630020006E20190065006E00200061007400740065006E006400730020007000610073002000740072006F00700020006400650020006D006100200070006100720074002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Te voilà prévenu.<U+0010><U+0002>Ĕ<U+0012>",
