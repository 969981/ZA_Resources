  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Pehe?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "0050006500680065003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Was hast du, Hoopa? Hat <U+0010><U+0002>Ā<U+0000>\netwas,<U+0010><U+0001>븀\nwas dich<U+0010><U+0001>븀\ninteressiert?<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "00100002BD06000000570061007300200068006100730074002000640075002C00200048006F006F00700061003F002000480061007400200010000201000000000A00650074007700610073002C00100001BE00000A0077006100730020006400690063006800100001BE00000A0069006E0074006500720065007300730069006500720074003F00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Hm...? Was ist das für eine Süßigkeit?<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 792,
      "rawDecodedUtf16Hex": "0048006D002E002E002E003F0020005700610073002000690073007400200064006100730020006600FC0072002000650069006E00650020005300FC00DF00690067006B006500690074003F00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Das ist Knisterbrause.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020004B006E00690073007400650072006200720061007500730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Willst du mal probieren?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "00570069006C006C007300740020006400750020006D0061006C002000700072006F00620069006500720065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Der Gedanke, dass etwas auf meiner Zunge\nprickelt, macht mir ein wenig Angst.<U+0010><U+0001>븁\nAber es könnte eine lehrreiche Erfahrung sein.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "Ja, ich glaube, ich möchte etwas davon\nprobieren.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "004A0061002C002000690063006800200067006C0061007500620065002C00200069006300680020006D00F600630068007400650020006500740077006100730020006400610076006F006E000A00700072006F00620069006500720065006E002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Na, so was!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "004E0061002C00200073006F0020007700610073002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Ich habe eine Idee für einen wunderbaren neuen\nDonut!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1384,
      "rawDecodedUtf16Hex": "00490063006800200068006100620065002000650069006E0065002000490064006500650020006600FC0072002000650069006E0065006E002000770075006E0064006500720062006100720065006E0020006E006500750065006E000A0044006F006E00750074002100100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Bitte gedulde dich ein wenig, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "0042006900740074006500200067006500640075006C0064006500200064006900630068002000650069006E002000770065006E00690067002C00200010000201000000002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Fertig! Ich habe mir ein neues Donutrezept\nausgedacht.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "00460065007200740069006700210020004900630068002000680061006200650020006D00690072002000650069006E0020006E006500750065007300200044006F006E0075007400720065007A006500700074000A0061007500730067006500640061006300680074002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Süß: 40 oder höher.\nScharf: 200 oder höher.<U+0010><U+0001>븁\nSauer: 400 oder höher.\nBitter: 280 oder höher.<U+0010><U+0001>븀\nFrisch: 40 oder höher.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "Sag Bescheid, wenn du diesen neuen Donut\nkreieren möchtest.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "005300610067002000420065007300630068006500690064002C002000770065006E006E002000640075002000640069006500730065006E0020006E006500750065006E00200044006F006E00750074000A006B007200650069006500720065006E0020006D00F6006300680074006500730074002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2076,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich war so inspiriert von der Knisterbrause,\ndass ich mir einen ebenso prickelnden Donut<U+0010><U+0001>븀\nausgedacht habe! Tada! Der <U+0010><U+0002>＀<U+0006>Plasma-Donut<U+0010><U+0002>＀<U+0000>!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "Ich frage mich, in welchen Bereich des\nDimensions-Illumina du gelangen kannst,<U+0010><U+0001>븀\nwenn Hoopa ihn isst.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "0010000201000000002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Komm schnell zum <U+0010><U+0002>＀<U+0006>Bahnhofsplatz Illumina Süd<U+0010><U+0002>＀<U+0000>!\nEs ist dringend!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2616,
      "rawDecodedUtf16Hex": "004B006F006D006D0020007300630068006E0065006C006C0020007A0075006D002000100002FF000006004200610068006E0068006F006600730070006C00610074007A00200049006C006C0075006D0069006E00610020005300FC006400100002FF0000000021000A0045007300200069007300740020006400720069006E00670065006E0064002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Oh. Wie es aussieht, ist schon wieder etwas\npassiert. Aber du wirst bestimmt damit fertig!<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2956,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sieh nur.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "00530069006500680020006E00750072002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "So eine Dimensionsverzerrung hast du auch noch\nnie gesehen, oder?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2996,
      "rawDecodedUtf16Hex": "0053006F002000650069006E0065002000440069006D0065006E00730069006F006E0073007600650072007A0065007200720075006E006700200068006100730074002000640075002000610075006300680020006E006F00630068000A006E006900650020006700650073006500680065006E002C0020006F006400650072003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Nein, noch nie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3136,
      "rawDecodedUtf16Hex": "004E00650069006E002C0020006E006F006300680020006E00690065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Die ist ja gelb.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3168,
      "rawDecodedUtf16Hex": "00440069006500200069007300740020006A0061002000670065006C0062002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Da ich nicht weiß, welche Pokémon sich dahinter\nbefinden, habe ich dich hergerufen.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3204,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Hi. Du tust mir doch bestimmt ’nen Gefallen,\noder?<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3380,
      "rawDecodedUtf16Hex": "00480069002E002000440075002000740075007300740020006D0069007200200064006F00630068002000620065007300740069006D006D007400202019006E0065006E00200047006500660061006C006C0065006E002C000A006F006400650072003F00100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Wir haben eine erstaunliche Verzerrung geortet.<U+0010><U+0001>븁\nDarin befindet sich garantiert ein Biest von\neinem Pokémon.<U+0010><U+0001>븁\nWenn das dann auch noch eine\nMegamanie-Entwicklung vollzieht, haben wir<U+0010><U+0001>븀\necht ’n Problem.<U+0010><U+0001>븁\nAlso geht der Sache zu dritt nach, so wie immer.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3492,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 262
    },
    {
      "displayText": "Ich sag Madame Mega-Entwicklung und <U+0010><U+0004>ᄀÿ؆<U+0000>deinerdeinem\n<U+0010><U+0004>ᄀÿࠊ<U+0000>AnführerinAnführer Bescheid.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Die Verzerrung ist übrigens beim <U+0010><U+0002>＀<U+0006>Bahnhofsplatz<U+0010><U+0002>＀<U+0000>\n<U+0010><U+0002>＀<U+0006>Illumina Süd<U+0010><U+0002>＀<U+0000>.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 15,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4204,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Ich bin schon da.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4368,
      "rawDecodedUtf16Hex": "004900630068002000620069006E0020007300630068006F006E002000640061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Das weiß ich schon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4404,
      "rawDecodedUtf16Hex": "004400610073002000770065006900DF00200069006300680020007300630068006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Ha, du bist echt der Knaller. Dann leg mal los.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4444,
      "rawDecodedUtf16Hex": "00480061002C002000640075002000620069007300740020006500630068007400200064006500720020004B006E0061006C006C00650072002E002000440061006E006E0020006C006500670020006D0061006C0020006C006F0073002E00100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ich glaube, Ravan würde sich als Bürgermeister\nnicht schlecht machen, meinst du nicht?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Hier komme ich, Connie!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4732,
      "rawDecodedUtf16Hex": "00480069006500720020006B006F006D006D00650020006900630068002C00200043006F006E006E00690065002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Hey, <U+0010><U+0002>Ā<U+0000>. <U+0010><U+0002>Ƌ<U+0001> hat\ngesagt,<U+0010><U+0001>븀\n<U+0010><U+0004>ᄀÿȃ<U+0000>sieer braucht<U+0010><U+0001>븀\nnoch<U+0010><U+0001>븀\nein<U+0010><U+0001>븀\nWeilchen.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 22,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4788,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Sollen wir es nur zu zweit versuchen?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4964,
      "rawDecodedUtf16Hex": "0053006F006C006C0065006E00200077006900720020006500730020006E007500720020007A00750020007A0077006500690074002000760065007200730075006300680065006E003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Ich kann einspringen.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5048,
      "rawDecodedUtf16Hex": "0049006300680020006B0061006E006E002000650069006E0073007000720069006E00670065006E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Das wäre super. Du warst... Matière, oder?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5100,
      "rawDecodedUtf16Hex": "0044006100730020007700E400720065002000730075007000650072002E002000440075002000770061007200730074002E002E002E0020004D00610074006900E800720065002C0020006F006400650072003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Wir haben uns vor der Mega-Donut-Großoffensive\nim Dimensions-Illumina getroffen, stimmt’s?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Ja. Wenn ich mich richtig erinnere, warst du\nauch sehr begabt im Umgang mit der<U+0010><U+0001>븀\nMega-Entwicklung.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Also gut, dann übernehmen wir drei die Sache!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5600,
      "rawDecodedUtf16Hex": "0041006C0073006F0020006700750074002C002000640061006E006E002000FC006200650072006E00650068006D0065006E0020007700690072002000640072006500690020006400690065002000530061006300680065002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Sag Bescheid, wenn du so weit bist,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5700,
      "rawDecodedUtf16Hex": "00100002BD060000005300610067002000420065007300630068006500690064002C002000770065006E006E00200064007500200073006F0020007700650069007400200062006900730074002C000A0010000201000000002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿*",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5800,
      "rawDecodedUtf16Hex": "00100002BDFF002A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sollen wir reingehen?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5812,
      "rawDecodedUtf16Hex": "0053006F006C006C0065006E00200077006900720020007200650069006E0067006500680065006E003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Dimensions-Illumina betreten",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5864,
      "rawDecodedUtf16Hex": "00440069006D0065006E00730069006F006E0073002D0049006C006C0075006D0069006E006100200062006500740072006500740065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Abbrechen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5924,
      "rawDecodedUtf16Hex": "00410062006200720065006300680065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Da wir uns zum ersten Mal als Trio zusammentun,\nsollten wir uns wirklich gründlich vorbereiten!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Ich bin jederzeit startklar. Immerhin geht es\ndarum, den Frieden in Illumina zu wahren!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 6144,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Warte, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0001>븁\nDu willst das Pokémon doch fangen, oder?\nAber deine Boxen sind voll!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 6328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Als Detektivin weiß ich natürlich, dass wir einen\nspeziellen Donut brauchen, um in diese spezielle<U+0010><U+0001>븀\nEcke des Dimensions-Illuminas zu reisen!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 147
    },
    {
      "displayText": "<U+0010><U+0002>뷿2",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6804,
      "rawDecodedUtf16Hex": "00100002BDFF00320000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Zeraora?!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6816,
      "rawDecodedUtf16Hex": "005A006500720061006F00720061003F002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Das ist eines der stärksten Elektro-Pokémon\nüberhaupt...<U+0010><U+0001>븁\nIch kann mir gar nicht ausmalen, was passiert,\nwenn es eine Megamanie-Entwicklung vollzieht.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 157
    },
    {
      "displayText": "Du bist so eine fähige Trainerin und hast trotzdem\nAngst vor ihm?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 7160,
      "rawDecodedUtf16Hex": "004400750020006200690073007400200073006F002000650069006E00650020006600E4006800690067006500200054007200610069006E006500720069006E00200075006E006400200068006100730074002000740072006F0074007A00640065006D000A0041006E00670073007400200076006F0072002000690068006D003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Von wegen!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 7300,
      "rawDecodedUtf16Hex": "0056006F006E00200077006500670065006E002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Ich krieg mich kaum ein vor Freude darüber,\ngegen so einen starken Gegner antreten zu<U+0010><U+0001>븀\ndürfen!!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 7332,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Also, natürlich will ich es auch besänftigen und\nvom Leid der Megamanie befreien!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 7536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Die Konzentration der Mega-Essenz in deiner\nUmgebung steigt rapide an.<U+0010><U+0001>븁\nWarnung: Eine Megamanie-Entwicklung steht\nunmittelbar bevor!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 7708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "<U+0010><U+0002>뷿:",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7980,
      "rawDecodedUtf16Hex": "00100002BDFF003A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oooora!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7992,
      "rawDecodedUtf16Hex": "004F006F006F006F0072006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Los, <U+0010><U+0002>Ā<U+0000>! Fang Zeraora!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 8008,
      "rawDecodedUtf16Hex": "004C006F0073002C002000100002010000000021002000460061006E00670020005A006500720061006F00720061002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Wow... Zeraora war einfach unglaublich stark.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 8068,
      "rawDecodedUtf16Hex": "0057006F0077002E002E002E0020005A006500720061006F007200610020007700610072002000650069006E006600610063006800200075006E0067006C006100750062006C00690063006800200073007400610072006B002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Zeraora taucht manchmal in Städten auf und\nscheint dort nach Gegnern zu suchen.<U+0010><U+0001>븁\nIch hab gehört, manchmal arbeitet es sogar\nals Bodyguard oder Ähnliches.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 8168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 160
    },
    {
      "displayText": "Vielleicht hat ja sein Wunsch nach einem starken\nGegner diesen Teil des Dimensions-Illuminas<U+0010><U+0001>븀\nhervorgebracht.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 8488,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Dann lasst uns mal ins normale Illumina\nzurückgehen.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 8720,
      "rawDecodedUtf16Hex": "00440061006E006E0020006C006100730073007400200075006E00730020006D0061006C00200069006E00730020006E006F0072006D0061006C006500200049006C006C0075006D0069006E0061000A007A0075007200FC0063006B0067006500680065006E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "<U+0010><U+0002>뷿A",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 8836,
      "rawDecodedUtf16Hex": "00100002BDFF00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Jetzt, wo ich selbst dabei war, kann ich mir ein\nbesseres Bild davon machen, wie ihr diese Stadt<U+0010><U+0001>븀\nrund um die Uhr beschützt habt.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 8848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "Vielen Dank dafür!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 9120,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B002000640061006600FC0072002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Wir haben zu danken!<U+0010><U+0001>븁\nOhne dich hätten wir Zeraora nicht besänftigen\nkönnen.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 9168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Sorry, dass ich so lange gebraucht hab!<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 9336,
      "rawDecodedUtf16Hex": "0053006F007200720079002C00200064006100730073002000690063006800200073006F0020006C0061006E0067006500200067006500620072006100750063006800740020006800610062002100100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Sorry, dass ich so lange gebraucht hab!<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 9424,
      "rawDecodedUtf16Hex": "0053006F007200720079002C00200064006100730073002000690063006800200073006F0020006C0061006E0067006500200067006500620072006100750063006800740020006800610062002100100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Wir sind schon fertig.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 9512,
      "rawDecodedUtf16Hex": "005700690072002000730069006E00640020007300630068006F006E0020006600650072007400690067002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Was? Oh, Matière? Was machst du denn hier?<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 9568,
      "rawDecodedUtf16Hex": "005700610073003F0020004F0068002C0020004D00610074006900E800720065003F00200057006100730020006D00610063006800730074002000640075002000640065006E006E00200068006900650072003F00100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Was? Oh, Matière? Was machst du denn hier?<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 9664,
      "rawDecodedUtf16Hex": "005700610073003F0020004F0068002C0020004D00610074006900E800720065003F00200057006100730020006D00610063006800730074002000640075002000640065006E006E00200068006900650072003F00100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ich hab mein Bestes gegeben, um dich im\nDimensions-Illumina zu vertreten!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 9760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Ab heute sind wohl wir drei das stärkste Trio!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 9916,
      "rawDecodedUtf16Hex": "00410062002000680065007500740065002000730069006E006400200077006F0068006C002000770069007200200064007200650069002000640061007300200073007400E40072006B0073007400650020005400720069006F002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "D-Das ist doch unfair!<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 10020,
      "rawDecodedUtf16Hex": "0044002D004400610073002000690073007400200064006F0063006800200075006E0066006100690072002100100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "D-Das ist doch unfair!<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 10076,
