      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "D560B79800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "안 할래...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
