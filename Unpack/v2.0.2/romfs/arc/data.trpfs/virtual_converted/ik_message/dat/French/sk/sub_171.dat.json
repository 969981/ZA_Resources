      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "FIN DU COMBAT !!!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5360,
      "rawDecodedUtf16Hex": "00460049004E00200044005500200043004F004D004200410054002000210021002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Victoire de Karaclée le Funeste !\nLes deux camps sont à ÉGALITÉ !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5404,
      "rawDecodedUtf16Hex": "0056006900630074006F0069007200650020006400650020004B0061007200610063006C00E900650020006C0065002000460075006E006500730074006500200021000A004C0065007300200064006500750078002000630061006D0070007300200073006F006E0074002000E0002000C900470041004C0049005400C90020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Le match opposant les capitaines va bientôt\ncommencer.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5544,
      "rawDecodedUtf16Hex": "004C00650020006D00610074006300680020006F00700070006F00730061006E00740020006C0065007300200063006100700069007400610069006E006500730020007600610020006200690065006E007400F40074000A0063006F006D006D0065006E006300650072002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Dernière manche : les capitaines !<U+0010><U+0001>븁\nKaraclée le Joker contre...\nJudokrak le Démon Rouge !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Dernière manche : les capitaines !<U+0010><U+0001>븁\nKaraclée le Démon Bleu contre...\nJudokrak le Joker !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
