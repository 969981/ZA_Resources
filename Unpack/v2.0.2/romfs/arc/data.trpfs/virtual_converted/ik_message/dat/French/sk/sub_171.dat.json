      "offsetInSection": 6096,
      "rawDecodedUtf16Hex": "00460049004E00200044005500200043004F004D0042004100540020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Victoire de l’équipe des Karaclée et de\nleur capitaine <U+0010><U+0002>Ā<U+0000> !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6136,
      "rawDecodedUtf16Hex": "0056006900630074006F0069007200650020006400650020006C201900E90071007500690070006500200064006500730020004B0061007200610063006C00E90065002000650074002000640065000A006C00650075007200200063006100700069007400610069006E0065002000100002010000000020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Bravo ! La supériorité des Karaclée est\nincontestable !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6268,
      "rawDecodedUtf16Hex": "0042007200610076006F002000210020004C0061002000730075007000E900720069006F00720069007400E900200064006500730020004B0061007200610063006C00E900650020006500730074000A0069006E0063006F006E007400650073007400610062006C00650020002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "C’était un bon combat.<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6388,
      "rawDecodedUtf16Hex": "0043201900E9007400610069007400200075006E00200062006F006E00200063006F006D006200610074002E00100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Merci ! Mais la victoire appartient avant tout à\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0001>븁\nJ’espère que la prochaine fois ce sera à mon\ntour de goûter à la puissance des Judokrak !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 152
    },
    {
      "displayText": "Victoire de l’équipe des Judokrak et de\nleur capitaine <U+0010><U+0002>Ā<U+0000> !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 6748,
      "rawDecodedUtf16Hex": "0056006900630074006F0069007200650020006400650020006C201900E90071007500690070006500200064006500730020004A00750064006F006B00720061006B002000650074002000640065000A006C00650075007200200063006100700069007400610069006E0065002000100002010000000020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Nous avons réussi à prouver la supériorité\ndes Judokrak !<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 6880,
      "rawDecodedUtf16Hex": "004E006F00750073002000610076006F006E00730020007200E90075007300730069002000E0002000700072006F00750076006500720020006C0061002000730075007000E900720069006F00720069007400E9000A0064006500730020004A00750064006F006B00720061006B0020002100100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Les prises des Judokrak ont eu raison de nous...\nBelle victoire !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 7004,
      "rawDecodedUtf16Hex": "004C00650073002000700072006900730065007300200064006500730020004A00750064006F006B00720061006B0020006F006E007400200065007500200072006100690073006F006E0020006400650020006E006F00750073002E002E002E000A00420065006C006C006500200076006900630074006F0069007200650020002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Merci ! Mais sans <U+0010><U+0002>Ā<U+0000>, nous\nn’aurions jamais gagné.<U+0010><U+0001>븁\nJ’espère que la prochaine fois ce sera à mon\ntour de goûter à la puissance des Karaclée !<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 7144,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 150
    },
    {
      "displayText": "Respecter son adversaire, ÇA, c’est l’esprit de\ncompétition que J’AIME !<U+0010><U+0001>븁\nVous faites honneur aux arts martiaux !\nQuant à toi, <U+0010><U+0002>Ā<U+0000>... FÉLICITATIONS !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 7444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 157
    },
    {
      "displayText": "Le prochain objectif de l’équipe des Karaclée sera\nde recruter <U+0010><U+0002>Ā<U+0000> officiellement !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Il y aura toujours un poste de capitaine pour vous\ndans l’équipe des Judokrak, <U+0010><U+0002>Ā<U+0000> !<U+0010><U+0002>Ĕǉ",
