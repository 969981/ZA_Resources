  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "00100002010000000020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Oh ! C’est <U+0010><U+0003>ᄀÿЃluielle, votre fameu<U+0010><U+0003>ᄀÿȁxse rival<U+0010><U+0003>ᄀÿĀe ?<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 8,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "004F006800200021002000432019006500730074002000100003110000FF0403006C007500690065006C006C0065002C00200076006F007400720065002000660061006D0065007500100003110000FF020100780073006500200072006900760061006C00100003110000FF010000650020003F00100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "J’ai beaucoup entendu parler de vous !<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "004A201900610069002000620065006100750063006F0075007000200065006E00740065006E006400750020007000610072006C0065007200200064006500200076006F007500730020002100100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Je m’appelle Judith, et mon Pokémon favori,\nc’est Judokrak.<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 748,
      "rawDecodedUtf16Hex": "004A00650020006D20190061007000700065006C006C00650020004A00750064006900740068002C0020006500740020006D006F006E00200050006F006B00E9006D006F006E0020006600610076006F00720069002C000A006320190065007300740020004A00750064006F006B00720061006B002E00100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Hé ! Ça se fait pas de griller la politesse !\nEnfin, ça m’étonne pas d’une fan de Judokrak !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "J’me présente : moi, c’est Pafcal.\nEt j’ai d’yeux que pour les Karaclée !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Ces deux-là ont un problème à régler,\nlaisse-moi t’expliquer.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "00430065007300200064006500750078002D006C00E00020006F006E007400200075006E002000700072006F0062006C00E8006D0065002000E00020007200E90067006C00650072002C000A006C00610069007300730065002D006D006F0069002000742019006500780070006C00690071007500650072002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Comme tu l’as remarqué, l’un préfère\nles Karaclée, et l’autre, les Judokrak.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Et ils comptent organiser un mini-tournoi pour\nsavoir laquelle des deux espèces est la plus forte.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Je cherche un cinquième membre pour mon\néquipe, vous voulez bien m’aider ?<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Hé ! Décidément, les fans de Judokrak sont\nvraiment des opportunistes !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Moi aussi, j’ai besoin d’un cinquième membre\ndans mon équipe !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "004D006F0069002000610075007300730069002C0020006A2019006100690020006200650073006F0069006E0020006420190075006E002000630069006E00710075006900E8006D00650020006D0065006D006200720065000A00640061006E00730020006D006F006E002000E9007100750069007000650020002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Voyons, calmez-vous.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2180,
      "rawDecodedUtf16Hex": "0056006F0079006F006E0073002C002000630061006C006D0065007A002D0076006F00750073002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>...<U+0010><U+0001>븁\nÀ qui veux-tu prêter main-forte ?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2232,
      "rawDecodedUtf16Hex": "0010000201000000002E002E002E00100001BE01000A00C0002000710075006900200076006500750078002D0074007500200070007200EA0074006500720020006D00610069006E002D0066006F0072007400650020003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> !\nRejoignez l’équipe des Karaclée !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2332,
      "rawDecodedUtf16Hex": "001000020100000000200021000A00520065006A006F00690067006E0065007A0020006C201900E90071007500690070006500200064006500730020004B0061007200610063006C00E900650020002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> !\nL’équipe des Judokrak a besoin de vous !<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "001000020100000000200021000A004C201900E90071007500690070006500200064006500730020004A00750064006F006B00720061006B002000610020006200650073006F0069006E00200064006500200076006F007500730020002100100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Viens me voir quand tu auras uniquement\nun Karaclée ou un Judokrak dans ton équipe.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2540,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Bien. Je vois que tu as un Karaclée.\nTu as donc choisi ton camp ?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2716,
      "rawDecodedUtf16Hex": "004200690065006E002E0020004A006500200076006F00690073002000710075006500200074007500200061007300200075006E0020004B0061007200610063006C00E90065002E000A0054007500200061007300200064006F006E0063002000630068006F00690073006900200074006F006E002000630061006D00700020003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Bien. Je vois que tu as un Judokrak.\nTu as donc choisi ton camp ?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2856,
      "rawDecodedUtf16Hex": "004200690065006E002E0020004A006500200076006F00690073002000710075006500200074007500200061007300200075006E0020004A00750064006F006B00720061006B002E000A0054007500200061007300200064006F006E0063002000630068006F00690073006900200074006F006E002000630061006D00700020003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Oui !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2996,
      "rawDecodedUtf16Hex": "004F00750069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Un instant.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 3008,
      "rawDecodedUtf16Hex": "0055006E00200069006E007300740061006E0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Prendre son temps pour bien choisir,\nc’est important !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3032,
      "rawDecodedUtf16Hex": "005000720065006E00640072006500200073006F006E002000740065006D0070007300200070006F007500720020006200690065006E002000630068006F0069007300690072002C000A0063201900650073007400200069006D0070006F007200740061006E00740020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Pafcal ! Ton équipe s’agrandit !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3152,
      "rawDecodedUtf16Hex": "00500061006600630061006C0020002100200054006F006E002000E9007100750069007000650020007320190061006700720061006E0064006900740020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "La victoire est assurée !<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3228,
      "rawDecodedUtf16Hex": "004C006100200076006900630074006F006900720065002000650073007400200061007300730075007200E900650020002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Judith ! Ton équipe s’agrandit !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3288,
      "rawDecodedUtf16Hex": "004A007500640069007400680020002100200054006F006E002000E9007100750069007000650020007320190061006700720061006E0064006900740020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Merci d’avoir choisi le camp des Judokrak !\nC’est un honneur !<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3364,
      "rawDecodedUtf16Hex": "004D006500720063006900200064201900610076006F00690072002000630068006F0069007300690020006C0065002000630061006D007000200064006500730020004A00750064006F006B00720061006B00200021000A0043201900650073007400200075006E00200068006F006E006E0065007500720020002100100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Que le tournoi... COMMENCE !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3500,
      "rawDecodedUtf16Hex": "0051007500650020006C006500200074006F00750072006E006F0069002E002E002E00200043004F004D004D0045004E004300450020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Puisqu’il vous faut un arbitre, je me permets\nd’endosser ce rôle.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3568,
      "rawDecodedUtf16Hex": "00500075006900730071007520190069006C00200076006F007500730020006600610075007400200075006E00200061007200620069007400720065002C0020006A00650020006D00650020007000650072006D006500740073000A006420190065006E0064006F00730073006500720020006300650020007200F4006C0065002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Rappelons les règles !<U+0010><U+0001>븁\nLes combats se dérouleront dans l’ordre suivant :\nattaquants, seconds attaquants, centres,<U+0010><U+0001>븀\nvice-capitaines, et enfin, capitaines.<U+0010><U+0001>븁\nL’équipe avec le plus de victoires remporte\nle tournoi !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 223
    },
    {
      "displayText": "C’EST PARTI !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4156,
      "rawDecodedUtf16Hex": "004320190045005300540020005000410052005400490020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Première manche : les attaquants !\nKaraclée le Cyclone contre Judokrak la Torpille !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "FIN DU COMBAT !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4372,
      "rawDecodedUtf16Hex": "00460049004E00200044005500200043004F004D0042004100540020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Karaclée le Cyclone remporte la victoire !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4412,
      "rawDecodedUtf16Hex": "004B0061007200610063006C00E900650020006C00650020004300790063006C006F006E0065002000720065006D0070006F0072007400650020006C006100200076006900630074006F0069007200650020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Deuxième manche : les seconds attaquants !\nKaraclée l’Énervé contre Judokrak le Joyeux !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "FIN DU COMBAT !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4696,
      "rawDecodedUtf16Hex": "00460049004E00200044005500200043004F004D0042004100540020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Victoire de Judokrak le Joyeux !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4736,
      "rawDecodedUtf16Hex": "0056006900630074006F0069007200650020006400650020004A00750064006F006B00720061006B0020006C00650020004A006F00790065007500780020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Troisième manche : les centres !\nKaraclée l’Inflexible contre Judokrak le Véloce !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "FIN DU COMBAT !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4988,
      "rawDecodedUtf16Hex": "00460049004E00200044005500200043004F004D0042004100540020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Victoire de Judokrak le Véloce !\nLe camp des Judokrak mène 2 à 1 !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5028,
      "rawDecodedUtf16Hex": "0056006900630074006F0069007200650020006400650020004A00750064006F006B00720061006B0020006C00650020005600E9006C006F0063006500200021000A004C0065002000630061006D007000200064006500730020004A00750064006F006B00720061006B0020006D00E8006E006500200032002000E0002000310020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Quatrième manche : les vice-capitaines !\nKaraclée le Funeste contre Judokrak le Suprême !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
