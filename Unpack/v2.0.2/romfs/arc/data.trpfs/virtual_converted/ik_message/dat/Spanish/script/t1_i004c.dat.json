  "messages": [
    {
      "displayText": "Exclusividad, exotismo y exquisitez\nen el Restaurante Le Postín.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "004500780063006C00750073006900760069006400610064002C002000650078006F007400690073006D006F002000790020006500780071007500690073006900740065007A000A0065006E00200065006C002000520065007300740061007500720061006E007400650020004C006500200050006F0073007400ED006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "¿Puedo interesarl<U+0010><U+0003>ᄀÿāoa en un menú\ndegustación de lujo? Pues pase.<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "¡Se nota que Le Postín es\nun restaurante de postín!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "00A1005300650020006E006F0074006100200071007500650020004C006500200050006F0073007400ED006E002000650073000A0075006E002000720065007300740061007500720061006E0074006500200064006500200070006F0073007400ED006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "¡Qué suerte haber podido\nprobar algo tan exquisito!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "00A10051007500E9002000730075006500720074006500200068006100620065007200200070006F006400690064006F000A00700072006F00620061007200200061006C0067006F002000740061006E002000650078007100750069007300690074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Espero que podamos encontrar\nuna solución...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "00450073007000650072006F002000710075006500200070006F00640061006D006F007300200065006E0063006F006E0074007200610072000A0075006E006100200073006F006C00750063006900F3006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "¡Comamos antes! Que con el\nestómago vacío no se piensa bien.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 808,
      "rawDecodedUtf16Hex": "00A10043006F006D0061006D006F007300200061006E0074006500730021002000510075006500200063006F006E00200065006C000A00650073007400F3006D00610067006F002000760061006300ED006F0020006E006F0020007300650020007000690065006E007300610020006200690065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "En el mundo de los combates nada\nestá garantizado.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 932,
      "rawDecodedUtf16Hex": "0045006E00200065006C0020006D0075006E0064006F0020006400650020006C006F007300200063006F006D006200610074006500730020006E006100640061000A00650073007400E100200067006100720061006E00740069007A00610064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Tata, ¡me encanta verte combatir\njunto a tus Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "0054006100740061002C002000A1006D006500200065006E00630061006E0074006100200076006500720074006500200063006F006D00620061007400690072000A006A0075006E0074006F00200061002000740075007300200050006F006B00E9006D006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "¿Pero eso de dedicarse a entrenar\nPokémon tiene algún futuro?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "00BF005000650072006F002000650073006F00200064006500200064006500640069006300610072007300650020006100200065006E007400720065006E00610072000A0050006F006B00E9006D006F006E0020007400690065006E006500200061006C006700FA006E002000660075007400750072006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "¡Eres la mejor, tata!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "00A100450072006500730020006C00610020006D0065006A006F0072002C0020007400610074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "En serio, no sabes lo frita que me tiene en la ofi...<U+0010><U+0001>븁\nOjalá pudiese enseñarle lo que es bueno\nen un combate...",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Si es que no hay derecho...<U+0010><U+0001>븁\nClaro, claro, desde luego...",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "0053006900200065007300200071007500650020006E006F00200068006100790020006400650072006500630068006F002E002E002E00100001BE01000A0043006C00610072006F002C00200063006C00610072006F002C0020006400650073006400650020006C007500650067006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Esta crème brûlée es\nla crème de la crème...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1660,
      "rawDecodedUtf16Hex": "004500730074006100200063007200E8006D006500200062007200FB006C00E90065002000650073000A006C006100200063007200E8006D00650020006400650020006C006100200063007200E8006D0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "¡La cobertura caramelizada\nes perfección absoluta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1752,
      "rawDecodedUtf16Hex": "00A1004C006100200063006F006200650072007400750072006100200063006100720061006D0065006C0069007A006100640061000A0065007300200070006500720066006500630063006900F3006E0020006100620073006F006C00750074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Qué interesante que haya un sitio donde se\npuedan reunir los Entrenadores y los amantes<U+0010><U+0001>븀\nde la buena cocina.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "No sé si llego a comprender la visión de\nChristoph, el propietario de este restaurante...<U+0010><U+0001>븁\n¿Cómo es eso de alcanzar nuevas cotas de\nexquisitez sublime mediante los combates?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 176
    },
    {
      "displayText": "Verá, todos nuestros platos tienen un punto\nóptimo de maduración hasta su consumo...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2432,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "¿Quieres echar un combate\nrapidito después de comer?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2604,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200065006300680061007200200075006E00200063006F006D0062006100740065000A0072006100700069006400690074006F00200064006500730070007500E9007300200064006500200063006F006D00650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "¡Por supuesto! Nada mejor para\nconocerse que un buen combate.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "00A10050006F007200200073007500700075006500730074006F00210020004E0061006400610020006D0065006A006F007200200070006100720061000A0063006F006E006F00630065007200730065002000710075006500200075006E0020006200750065006E00200063006F006D0062006100740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Mi Pokémon está entrenado para\ncomer los postres más selectos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "004D006900200050006F006B00E9006D006F006E002000650073007400E100200065006E007400720065006E00610064006F00200070006100720061000A0063006F006D006500720020006C006F007300200070006F007300740072006500730020006D00E10073002000730065006C006500630074006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ha sido un día muy largo... Me he\nganado una buena comilona.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2964,
      "rawDecodedUtf16Hex": "004800610020007300690064006F00200075006E0020006400ED00610020006D007500790020006C006100720067006F002E002E002E0020004D0065002000680065000A00670061006E00610064006F00200075006E00610020006200750065006E006100200063006F006D0069006C006F006E0061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Lo único que quiero es que\nllegue mi hora de comer.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3088,
      "rawDecodedUtf16Hex": "004C006F002000FA006E00690063006F0020007100750065002000710075006900650072006F0020006500730020007100750065000A006C006C00650067007500650020006D006900200068006F0072006100200064006500200063006F006D00650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Come, criatura. Hay que aprovechar cuando se\nes joven para probar toda clase de lujos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "¡Lo importante a la hora de comer es la compañía!\nY que la comida esté rica, claro.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "La comida de Le Postín está tan rica que luego\ncomer en cualquier en otro sitio es un chasco.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Tras probar los platos de Le Postín, creo que\nentiendo mejor lo que es la calidad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    }
