      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1808,
      "rawDecodedUtf16Hex": "00BF005300610074006900730066006100630074006F00720069006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "¿Solo?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1840,
      "rawDecodedUtf16Hex": "00BF0053006F006C006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "¿Sabroso?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "00BF0053006100620072006F0073006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "¡Incorrecto! Aunque es cierto que estar en mi\npresencia es una experiencia sublime.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "De cierta manera tienes razón. ¡Este torneo\nserá muy satisfactorio para quien lo gane!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "¡Magnífico! ¡Así es!<U+0010><U+0002>Ĕ<U+0015>",
