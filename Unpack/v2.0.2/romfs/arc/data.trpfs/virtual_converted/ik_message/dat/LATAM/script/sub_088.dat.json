      "rawDecodedUtf16Hex": "00BF0044006500200071007500E90020006D0065002000650073007400E10020006800610062006C0061006E0064006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡Otra respuesta con S! ¡Nunca decepcionas,\n<U+0010><U+0002>Ā<U+0000>, querid<U+0010><U+0003>ᄀÿāoa!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3064,
      "rawDecodedUtf16Hex": "00A1004F007400720061002000720065007300700075006500730074006100200063006F006E002000530021002000A1004E0075006E0063006100200064006500630065007000630069006F006E00610073002C000A0010000201000000002C002000710075006500720069006400100003110000FF0101006F0061002100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Oye, en serio... Si quieres seguir escuchando\nmi bella voz, hay mejores formas de hacerlo.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
