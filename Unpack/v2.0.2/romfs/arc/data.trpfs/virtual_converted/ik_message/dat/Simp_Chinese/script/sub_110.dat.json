      "rawDecodedUtf16Hex": "53FD5477554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "它居然用水枪\n把岩石打碎了！？<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
