      "rawDecodedUtf16Hex": "5B835C45713675286C3467AA000A628A5CA977F36253788E4E86FF01FF1F00100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "铁臂枪虾，\n你这不是很能干嘛！<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
