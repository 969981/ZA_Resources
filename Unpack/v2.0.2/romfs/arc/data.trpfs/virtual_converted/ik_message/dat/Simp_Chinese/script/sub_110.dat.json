      "rawDecodedUtf16Hex": "56625662FF01000A4F6051B26D175F975F885E7251C0554AFF0100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "看呀，铁臂枪虾！<U+0010><U+0001>븁\n要猛地喷射水枪\n来把污泥冲洗干净哦。<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 924,
      "rawDecodedUtf16Hex": "770B5440FF0C94C181C267AA867EFF0100100001BE01000A8981731B573055B75C046C3467AA000A6765628A6C616CE551B26D175E7251C054E6300200100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "叽呷啊。",
