      "rawDecodedUtf16Hex": "94C181C267AA867EFF0C000A4F608FD94E0D662F5F8880FD5E72561BFF0100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
