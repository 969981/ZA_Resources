      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "给我的铁臂枪虾\n展示一下吧。<U+0010><U+0001>븁\n让它看看你的宝可梦\n用水枪冲洗污泥的帅气样子！<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "7ED96211768494C181C267AA867E000A5C55793A4E004E0B5427300200100001BE01000A8BA95B83770B770B4F6076845B9D53EF68A6000A75286C3467AA51B26D176C616CE576845E056C1468375B50FF0100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "喂喂！\n你得用<U+0010><U+0002>＀<U+0006>水枪<U+0010><U+0002>＀<U+0000>来冲洗啊！<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 820,
