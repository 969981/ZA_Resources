      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "A proposito, se ti serve una Megapietra per\nMedicham, puoi comprarla in Gioielleria.<U+0010><U+0002>Ĕų",
