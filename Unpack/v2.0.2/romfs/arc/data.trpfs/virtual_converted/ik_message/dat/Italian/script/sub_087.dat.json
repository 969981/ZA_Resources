      "rawDecodedUtf16Hex": "002E002E002E00200073006900200079006F0067006100650076006F006C00760065002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Aaaah! Come vorrei assistere a uno spettacolo\nsimile! Voglio vedere un MegaMedicham!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Lotta contro di me un’ultima volta e mostrami\nla megaevoluzione di Medicham!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
