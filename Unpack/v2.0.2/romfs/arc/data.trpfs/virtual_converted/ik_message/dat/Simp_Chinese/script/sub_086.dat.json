    {
      "displayText": "我想为大家制作\n新的彩色隐形眼镜！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 980,
