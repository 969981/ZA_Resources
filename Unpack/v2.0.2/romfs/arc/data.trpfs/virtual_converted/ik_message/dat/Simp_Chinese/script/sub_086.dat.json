      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "充满了黑暗宝可梦的深暗漆黑感！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "51456EE14E869ED166975B9D53EF68A676846DF166976F069ED1611FFF0100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "密阿雷的彩色隐形眼镜粉丝！\n我要给你们带来全新的世界！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "5BC6963F96F776845F69827296905F62773C955C7C894E1DFF01000A621189817ED94F604EEC5E266765516865B076844E16754CFF0100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "彩色隐形眼镜的颜色\n新增了闪闪发光和深暗漆黑。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
