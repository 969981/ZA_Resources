      "rawDecodedUtf16Hex": "B4DCB2C8002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> 씨...\n제가 어... 어떻게 해야...<U+0010><U+0002>ĔǏ",
