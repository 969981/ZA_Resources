      "offsetInSection": 4220,
      "rawDecodedUtf16Hex": "C81C0020C7DDACE0AC000020C5BCB9C8B0980020B300B2E8D55CC9C00020BA3CC8000020B9D0D5600020D14CB2C8002C000AB4DCB2C8CC28C7580020C88BC7400020C810B3C40020AC00B974CCD00020C8FCC2DCC8E0002100100002011401D20000",
      "trailingZeroPaddingUnits": 1,
