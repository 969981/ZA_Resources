      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "磁鐵構成的鐵啞鈴\n很喜歡全像傳送梯發出的電磁波。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
