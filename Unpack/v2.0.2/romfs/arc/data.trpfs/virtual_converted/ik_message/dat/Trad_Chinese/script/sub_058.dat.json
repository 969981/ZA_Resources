      "rawDecodedUtf16Hex": "90194E0B7D4265BC2026202600100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "唉呀！又回來了！？<U+0010><U+0002>Ĕř",
