      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "傷腦筋……\n為什麼偏偏愛到我這裡來……<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
