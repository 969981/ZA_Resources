      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "不是",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "4E0D662F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "不认识",
