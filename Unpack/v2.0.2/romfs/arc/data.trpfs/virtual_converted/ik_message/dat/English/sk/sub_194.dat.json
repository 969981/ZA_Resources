      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3168,
      "rawDecodedUtf16Hex": "0048006F0077201900730020007400680069007300200077006F0072006B00200061006700610069006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
