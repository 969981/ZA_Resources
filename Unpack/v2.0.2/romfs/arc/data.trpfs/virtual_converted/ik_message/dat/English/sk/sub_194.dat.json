      "offsetInSection": 4372,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Marvelous!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4384,
      "rawDecodedUtf16Hex": "004D0061007200760065006C006F00750073002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "In honor of your success in the Trial of Grass, and\nfor this step toward mastering all of my ultimate<U+0010><U+0001>븀\ntechniques, I give you this TM!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4416,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "In honor of your success in the Trial of Fire, and\nfor this step toward mastering all of my ultimate<U+0010><U+0001>븀\ntechniques, I give you this TM!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "In honor of your success in the Trial of Water, and\nfor this step toward mastering all of my ultimate<U+0010><U+0001>븀\ntechniques, I give you this TM!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "I’m impressed. Keep up the effort until all three\ntrials are cleared!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 37,
