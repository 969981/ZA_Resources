      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Excellent. Let the Trial of Grass begin!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 4100,
      "rawDecodedUtf16Hex": "0045007800630065006C006C0065006E0074002E0020004C00650074002000740068006500200054007200690061006C0020006F006600200047007200610073007300200062006500670069006E002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Excellent. Let the Trial of Fire begin!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
