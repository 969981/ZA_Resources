      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "At last! You’ve done it!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 5424,
      "rawDecodedUtf16Hex": "004100740020006C006100730074002100200059006F007520190076006500200064006F006E0065002000690074002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "My truest congratulations. You’ve cleared all three\nof my trials.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5484,
      "rawDecodedUtf16Hex": "004D0079002000740072007500650073007400200063006F006E00670072006100740075006C006100740069006F006E0073002E00200059006F007520190076006500200063006C0065006100720065006400200061006C006C002000740068007200650065000A006F00660020006D007900200074007200690061006C0073002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "These ultimate techniques boast tremendous\npower, but their recoil leaves the user wide-open.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "It takes a Trainer with a discerning tactical mind\nto use them properly.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 5820,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "I trust you’ll work hard to be such a Trainer.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 5976,
      "rawDecodedUtf16Hex": "004900200074007200750073007400200079006F00752019006C006C00200077006F0072006B0020006800610072006400200074006F002000620065002000730075006300680020006100200054007200610069006E00650072002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
