      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3216,
      "rawDecodedUtf16Hex": "00492019006D00200067006F006F006400200066006F00720020006E006F00770000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "For each of the three trials, you must take down\nmy three Pokémon using only a single Pokémon<U+0010><U+0001>븀\nthat I specify.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
