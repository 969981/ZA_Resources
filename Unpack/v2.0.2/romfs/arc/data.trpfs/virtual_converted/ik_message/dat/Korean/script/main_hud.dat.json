      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "일이 다 끝나면\n저와 또 승부하도록 해요.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
