      "rawDecodedUtf16Hex": "00100002BDFF00330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "빨리...\n나... 지쳤어...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 2500,
      "rawDecodedUtf16Hex": "BE68B9AC002E002E002E000AB098002E002E002E0020C9C0CCE4C5B4002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "저는 아직 싸울 수 있습니다!\n저스티스를 나눠 드리죠.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "C800B2940020C544C9C10020C2F8C6B80020C2180020C788C2B5B2C8B2E40021000AC800C2A4D2F0C2A4B97C0020B098B2200020B4DCB9ACC8E0002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>뷿6",
