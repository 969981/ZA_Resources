      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "00100002BDFF00360000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "너와 싸우는 건 적으로든\n아군으로든 좋단 말이지!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 2612,
