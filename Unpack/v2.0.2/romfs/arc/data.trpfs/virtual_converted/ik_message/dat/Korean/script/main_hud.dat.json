      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "싸움에 집중하거라!\n과한 생각은 금물이다!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
