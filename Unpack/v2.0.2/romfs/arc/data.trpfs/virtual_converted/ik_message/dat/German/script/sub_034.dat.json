    },
    {
      "displayText": "Hey, du da! Benutzt du in Kämpfen auch\nmanchmal Attacken als Falle?<U+0010><U+0002>ĔŃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 168,
      "rawDecodedUtf16Hex": "004800650079002C0020006400750020006400610021002000420065006E00750074007A007400200064007500200069006E0020004B00E4006D007000660065006E00200061007500630068000A006D0061006E00630068006D0061006C002000410074007400610063006B0065006E00200061006C0073002000460061006C006C0065003F00100002011401430000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Damit meine ich Attacken, nach deren Einsatz\netwas auf dem Kampffeld zurückbleibt...<U+0010><U+0001>븀\nFeuer oder Felsen oder so.<U+0010><U+0002>ĔŃ",
      "escapedControlUnits": 4,
