      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "00560075006F00690020007200650073007400690074007500690072006500200069002000760065007300740069007400690020006300680065002000680061006900200070007200650073006F00200069006E00200070007200650073007400690074006F003F00100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
