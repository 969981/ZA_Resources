      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "C194C194007E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "커피에서 짠맛이 난 것과\n관련이 있는지 확인할 수 있게<U+0010><U+0001>븀\n베베솔트를 잡아 와 주세요!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1080,
      "rawDecodedUtf16Hex": "CEE4D53CC5D0C11C0020C9E0B9DBC7740020B09C0020AC83ACFC000AAD00B828C7740020C788B294C9C00020D655C778D5600020C2180020C788AC8C00100001BE00000ABCA0BCA0C194D2B8B97C0020C7A1C5440020C6400020C8FCC138C694002100100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "으악! 짜!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "C73CC54500210020C9DC002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
