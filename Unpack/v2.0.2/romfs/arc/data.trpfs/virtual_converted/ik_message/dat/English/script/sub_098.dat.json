      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "My heart is practically overflowing with thanks!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3096,
