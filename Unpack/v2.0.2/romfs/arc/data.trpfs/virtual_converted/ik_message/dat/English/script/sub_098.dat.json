      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Wha—?!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2636,
      "rawDecodedUtf16Hex": "0057006800612014003F0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "There are even MORE brambles in the way now!\nH-how can this be?!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "0054006800650072006500200061007200650020006500760065006E0020004D004F005200450020006200720061006D0062006C0065007300200069006E002000740068006500200077006100790020006E006F00770021000A0048002D0068006F0077002000630061006E00200074006800690073002000620065003F0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "I’ve no choice but to ask for your help yet again!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2800,
      "rawDecodedUtf16Hex": "00492019007600650020006E006F002000630068006F006900630065002000620075007400200074006F002000610073006B00200066006F007200200079006F00750072002000680065006C0070002000790065007400200061006700610069006E0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Those brambles are ruining my view. Please, have\nyour Pokémon burn them ALL away!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
