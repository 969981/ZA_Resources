      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Now I can finally resume working on my sketch.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1868,
