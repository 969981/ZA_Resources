      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Hola. Soy yo, la diseñadora de lentes de contacto\nde colores otra vez.<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 256,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "El otro día me comentó un cliente que\nlos Medicham dominan el yoga a la perfección.<U+0010><U+0001>븁\n¿No te parece genial?<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 408,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Si un Medicham megaevolucionara...<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 636,
      "rawDecodedUtf16Hex": "0053006900200075006E0020004D006500640069006300680061006D0020006D00650067006100650076006F006C007500630069006F006E006100720061002E002E002E00100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¿Haría megayoga?<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "00BF00480061007200ED00610020006D0065006700610079006F00670061003F00100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "¡Ay, quiero verlo! ¡Quiero ver un Mega-Medicham!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "00A100410079002C002000710075006900650072006F0020007600650072006C006F0021002000A100510075006900650072006F002000760065007200200075006E0020004D006500670061002D004D006500640069006300680061006D002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "¡Muéstrame un Mega-Medicham en combate!\n¡Es el último favor que te pido!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Por cierto, creo que en la Boutique de la Piedra\nvenden la Megapiedra para Medicham.<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Muéstrame un Mega-Medicham en combate!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "00A1004D007500E90073007400720061006D006500200075006E0020004D006500670061002D004D006500640069006300680061006D00200065006E00200063006F006D0062006100740065002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡Quiero ver un Mega-Medicham en combate!\nPero el tuyo no tiene equipada su Megapiedra.<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1304,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Muéstrame un Mega-Medicham en combate!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1500,
