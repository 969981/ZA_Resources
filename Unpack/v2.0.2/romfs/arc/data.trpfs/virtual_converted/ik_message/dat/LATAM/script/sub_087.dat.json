      "index": 13,
      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "00410071007500ED0020006C006F0020007400690065006E006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Espera un momento",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "00450073007000650072006100200075006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "¡Necesito inspiración! ¡Quiero crear nuevos\ndiseños para la gente!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1656,
      "rawDecodedUtf16Hex": "00A1004E006500630065007300690074006F00200069006E007300700069007200610063006900F3006E0021002000A100510075006900650072006F0020006300720065006100720020006E007500650076006F0073000A006400690073006500F1006F0073002000700061007200610020006C0061002000670065006E00740065002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "¡Seguro que, cuando vea a tu Mega-Medicham,\nse me va a ocurrir un nuevo diseño!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
