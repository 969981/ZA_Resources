      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "哇哦！污泥炸弹\n让普通的铁屑散发出刺激的气味了！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
