      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "哆啊啊啊！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "54C6554A554A554AFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "可可多拉们吃得津津有味！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "53EF53EF591A62C94EEC54035F976D256D2567095473FF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "没想到我的突发奇想这么有效，\n真是太开心了！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "6CA160F35230621176847A8153D1594760F38FD94E4867096548FF0C000A771F662F592A5F005FC34E86FF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "你愿意帮我调味，也真是绝了！\n我要给你送上最大的感谢！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "4F60613F610F5E2E62118C035473FF0C4E5F771F662F7EDD4E86FF01000A621189817ED94F6090014E0A670059277684611F8C22FF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "接下来调查一下可可多拉们\n最喜欢哪种毒属性的招式好啦。<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "63A54E0B67658C0367E54E004E0B53EF53EF591A62C94EEC000A6700559C6B2254EA79CD6BD25C5E6027768462DB5F0F597D55663002001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "可可多拉们！\n今后我也会多多喂你们吃铁屑的哦！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "53EF53EF591A62C94EECFF01000A4ECA540E62114E5F4F1A591A591A55824F604EEC540394C15C51768454E6FF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
