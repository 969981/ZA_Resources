      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "据说这是一间店内聚集了追求\n最新潮流的时尚爱好者的咖啡馆。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 3644,
