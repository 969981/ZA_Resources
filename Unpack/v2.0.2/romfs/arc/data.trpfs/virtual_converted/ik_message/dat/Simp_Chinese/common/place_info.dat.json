      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "传闻中宛如随时会刮起的\n龙卷风一样，无时无刻不在\n发生着什么骚动的咖啡馆。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 3568,
