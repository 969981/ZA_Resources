      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "在喜欢在线交流而非面对面互动，\n并拥有深度的人士当中\n很有人气的咖啡店。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 3704,
