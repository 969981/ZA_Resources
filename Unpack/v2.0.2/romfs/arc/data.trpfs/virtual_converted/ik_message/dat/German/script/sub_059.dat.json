      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 184,
      "rawDecodedUtf16Hex": "004400610073002000670069006200742019007300200064006F006300680020006E0069006300680074002100200049007300740020006400610073002000440069006E0067002000650063006800740020007300630068006F006E000A0077006900650064006500720020006B00610070007500740074003F00210000",
      "trailingZeroPaddingUnits": 1,
