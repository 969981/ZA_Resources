      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Ma per farlo devo ampliare le mie conoscenze!<U+0010><U+0001>븁\nCi sono ancora un sacco di cose a questo mondo\ndi cui non ho la benché minima nozione!<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "Dunque chiedo a te, che mi sembri possedere un\ndiscreto sapere, di illuminarmi in merito!<U+0010><U+0001>븁\nVoglio installare dei nuovi cartelli di consigli\nutili.<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 153
    },
    {
