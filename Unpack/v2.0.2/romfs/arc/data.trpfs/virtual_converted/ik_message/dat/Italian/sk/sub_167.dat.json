  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Perché brami la forza?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "0050006500720063006800E90020006200720061006D00690020006C006100200066006F0072007A0061003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Per me stessa.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "0050006500720020006D00650020007300740065007300730061002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Io desidero diventare più forte per proteggere\nImma e tutti coloro che mi circondano!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 428,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Io invece non sono ancora riuscita a battere\nViola.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 608,
      "rawDecodedUtf16Hex": "0049006F00200069006E00760065006300650020006E006F006E00200073006F006E006F00200061006E0063006F007200610020007200690075007300630069007400610020006100200062006100740074006500720065000A00560069006F006C0061002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Ma quest’impasse mi renderà più forte, perché\nsono convinta di una cosa.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Sono certa che una volta superata Viola non mi\npiegherò più davanti a nessuno!<U+0010><U+0001>븁\nEd è proprio per questo che continuo e continuo\na lottare!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "Dunque ti batti puramente per te stessa...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "00440075006E00710075006500200074006900200062006100740074006900200070007500720061006D0065006E0074006500200070006500720020007400650020007300740065007300730061002E002E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Mi domando se sia giusto ragionare così, per\nun’Allenatrice di Pokémon!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Da questa parte.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "004400610020007100750065007300740061002000700061007200740065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Intromettiti e falli smettere di bisticciare.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "0049006E00740072006F006D00650074007400690074006900200065002000660061006C006C006900200073006D006500740074006500720065002000640069002000620069007300740069006300630069006100720065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "È arrivat<U+0010><U+0003>ᄀÿāoa <U+0010><U+0002>Ā<U+0000>.\nDecidete chi ha ragione con una lotta.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 8,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "00C80020006100720072006900760061007400100003110000FF0101006F006100200010000201000000002E000A00440065006300690064006500740065002000630068006900200068006100200072006100670069006F006E006500200063006F006E00200075006E00610020006C006F007400740061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Ci sto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1692,
      "rawDecodedUtf16Hex": "00430069002000730074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Un attimo...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "0055006E00200061007400740069006D006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Per chi persegue la forza contano le lotte, non\nle parole!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1736,
      "rawDecodedUtf16Hex": "00500065007200200063006800690020007000650072007300650067007500650020006C006100200066006F0072007A006100200063006F006E00740061006E006F0020006C00650020006C006F007400740065002C0020006E006F006E000A006C00650020007000610072006F006C0065002100100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>!\nLotta insieme a me contro il Gruppo Justice<U+0010><U+0001>븀\ne aiutami a dar prova delle mie convinzioni!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2068,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Anche io desidero questo incontro!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "0041006E00630068006500200069006F00200064006500730069006400650072006F002000710075006500730074006F00200069006E0063006F006E00740072006F002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Lottiamo, così posso tornare a casa.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2160,
      "rawDecodedUtf16Hex": "004C006F0074007400690061006D006F002C00200063006F007300EC00200070006F00730073006F00200074006F0072006E0061007200650020006100200063006100730061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Ci sto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "00430069002000730074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Un attimo...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2260,
      "rawDecodedUtf16Hex": "0055006E00200061007400740069006D006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Ci sono traguardi che non si possono raggiungere\nsenza sconfiggere degli avversari possenti.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "La forza è potere!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2484,
      "rawDecodedUtf16Hex": "004C006100200066006F0072007A0061002000E800200070006F0074006500720065002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Non ti facevo così indecis<U+0010><U+0003>ᄀÿāoa.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "004E006F006E002000740069002000660061006300650076006F00200063006F007300EC00200069006E0064006500630069007300100003110000FF0101006F0061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "La forza è giustizia!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2612,
      "rawDecodedUtf16Hex": "004C006100200066006F0072007A0061002000E80020006700690075007300740069007A00690061002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>!\nLotta insieme a me contro il Gruppo Justice<U+0010><U+0001>븀\ne aiutami a dar prova delle mie convinzioni!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0019>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2868,
      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Falinks! La tua megaevoluzione segnerà\nuna vittoria trionfale per la giustizia!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Chandelure... Sconfiggiamoli con\nla megaevoluzione.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3048,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002E002E002E002000530063006F006E006600690067006700690061006D006F006C006900200063006F006E000A006C00610020006D00650067006100650076006F006C0075007A0069006F006E0065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Ecco il mio asso nella manica! Spacca tutto\ncon la tua megaevoluzione, Dragalge!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3160,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3332,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Combattere per sé stessi, combattere per gli altri...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3344,
      "rawDecodedUtf16Hex": "0043006F006D006200610074007400650072006500200070006500720020007300E90020007300740065007300730069002C00200063006F006D0062006100740074006500720065002000700065007200200067006C006900200061006C007400720069002E002E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Sembrerebbe che nessuno dei due obiettivi possa\nessere considerato superiore all’altro.<U+0010><U+0001>븁\nO meglio, non sarebbe giusto fare questa\ndistinzione.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3460,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "Già! Scommetto che anche tu, continuando a\nproteggere le persone, raggiungerai una<U+0010><U+0001>븀\nmentalità di cui si può andare fieri!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Sono commosso. Ti prego di accettare questa\ndivisa.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4016,
      "rawDecodedUtf16Hex": "0053006F006E006F00200063006F006D006D006F00730073006F002E00200054006900200070007200650067006F00200064006900200061006300630065007400740061007200650020007100750065007300740061000A006400690076006900730061002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Mi dispiace, ma ho promesso di indossare\nquesta uniforme finché non sarò libera da Viola.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "D’accordo... Allora lo dono a te, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4316,
      "rawDecodedUtf16Hex": "00442019006100630063006F00720064006F002E002E002E00200041006C006C006F007200610020006C006F00200064006F006E006F00200061002000740065002C00200010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Hai ricevuto la Divisa di Albis con colore\nalternativo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4404,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F0020006C0061002000440069007600690073006100200064006900200041006C00620069007300200063006F006E00200063006F006C006F00720065000A0061006C007400650072006E0061007400690076006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Pare ci sia anche qualche pazzo che si fa\nacconciare i capelli come Albis...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Non si finisce mai di bramare la forza. Avrò\npiacere di affrontarti ancora, se fosse necessario.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4680,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Secondo me Delfia sarebbe più adatta di me a\nlavorare nel Dojo.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4884,
      "rawDecodedUtf16Hex": "005300650063006F006E0064006F0020006D0065002000440065006C0066006900610020007300610072006500620062006500200070006900F900200061006400610074007400610020006400690020006D006500200061000A006C00610076006F00720061007200650020006E0065006C00200044006F006A006F002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Ho l’impressione di aver già affrontato Albis in\nun incontro di arti marziali da bambini...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 5020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    }
  ],
