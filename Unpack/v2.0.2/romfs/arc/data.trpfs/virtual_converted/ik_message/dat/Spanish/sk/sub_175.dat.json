      "offsetInSection": 6964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Ah, ¡no te preocupes! Podemos mantener una\ndistancia de seguridad mientras charlamos.<U+0010><U+0002>Ĕǐ",
