      "rawDecodedUtf16Hex": "00100002BDFF00430000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Soy bastante tímida, pero... es un placer\nconoceros.<U+0010><U+0002>ĔǏ",
