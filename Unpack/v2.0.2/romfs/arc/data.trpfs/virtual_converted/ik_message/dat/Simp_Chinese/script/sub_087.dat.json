      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "8BF4523076D25B50FF0C000A5F5371365C314F1A60F352308D5B535AFF0100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "密阿雷的彩色隐形眼镜粉丝！\n我要给你们带来全新的世界！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1288,
