      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "说到宝可梦，\n当然就会想到精灵球！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "8BF452305B9D53EF68A6FF0C000A5F5371365C314F1A60F352307CBE70757403FF0100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "说到盒子，\n当然就会想到赛博！<U+0010><U+0002>Ĕų",
