      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "彩色隐形眼镜的颜色\n新增了精灵球和赛博。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "5F69827296905F62773C955C7684989C8272000A65B0589E4E867CBE70757403548C8D5B535A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "谢谢你一直以来的帮忙！<U+0010><U+0001>븁\n之后我会靠自己去看\n超级进化后的宝可梦的。<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1396,
