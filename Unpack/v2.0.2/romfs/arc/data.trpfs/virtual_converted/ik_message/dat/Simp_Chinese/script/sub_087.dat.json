      "rawDecodedUtf16Hex": "00100002BDFF00110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "在看到超级恰雷姆之前\n就分出胜负可就没有意义了哦！<U+0010><U+0001>븀\n再来跟我打一场吧！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
