  "initialKey": 0,
  "messages": [
    {
      "displayText": "Caffè La Tazza Vuota...<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "004300610066006600E80020004C0061002000540061007A007A0061002000560075006F00740061002E002E002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Come suggerisce il suo nome, c’è ben poco\ncaffè da servire, qui.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "0043006F006D00650020007300750067006700650072006900730063006500200069006C002000730075006F0020006E006F006D0065002C00200063201900E8002000620065006E00200070006F0063006F000A006300610066006600E800200064006100200073006500720076006900720065002C0020007100750069002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "In passato, avevamo così tanti clienti che non\nriuscivamo ad accontentare tutti...<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Non che mi andasse bene... Il troppo lavoro ti fa\nperdere la testa...<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "004E006F006E00200063006800650020006D006900200061006E00640061007300730065002000620065006E0065002E002E002E00200049006C002000740072006F00700070006F0020006C00610076006F0072006F002000740069002000660061000A00700065007200640065007200650020006C0061002000740065007300740061002E002E002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Purtroppo però un locale senza clienti è destinato\na chiudere... La virtù sta nel mezzo.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Hai capito dove voglio arrivare, vero?<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "004800610069002000630061007000690074006F00200064006F0076006500200076006F0067006C0069006F002000610072007200690076006100720065002C0020007600650072006F003F00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Proprio per niente",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "00500072006F007000720069006F00200070006500720020006E00690065006E007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Non so leggere la mente...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "004E006F006E00200073006F0020006C0065006700670065007200650020006C00610020006D0065006E00740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "In sostanza, ci servirebbe qualcosa per attirare\nabbastanza clienti da non farci chiudere, ma<U+0010><U+0001>븀\nsenza che finiamo per sovraccaricarci di lavoro.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 150
    },
    {
      "displayText": "Che genere di prodotto pensi potrebbe\nfunzionare?<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "004300680065002000670065006E006500720065002000640069002000700072006F0064006F00740074006F002000700065006E0073006900200070006F007400720065006200620065000A00660075006E007A0069006F006E006100720065003F00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Il Pan di Lumi?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "0049006C002000500061006E0020006400690020004C0075006D0069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Dei croissant?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "004400650069002000630072006F0069007300730061006E0074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Del riso al curry?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1808,
      "rawDecodedUtf16Hex": "00440065006C0020007200690073006F00200061006C002000630075007200720079003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Il Pan di Lumi non mi va, quello lo fanno ovunque.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "0049006C002000500061006E0020006400690020004C0075006D00690020006E006F006E0020006D0069002000760061002C0020007100750065006C006C006F0020006C006F002000660061006E006E006F0020006F00760075006E007100750065002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "I croissant non mi vanno, non sarebbero mai\nall’altezza di quelli del Caffè Nouveau.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1960,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Il curry dell’Hotel Z è stranamente apprezzato.\nNon mi andrebbe di essere messi a paragone...<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Che ne pensi... del sushi?<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "0043006800650020006E0065002000700065006E00730069002E002E002E002000640065006C002000730075007300680069003F00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "È una pietanza leggera, ma non c’entra nulla con\nil caffè... In pratica, attirerebbe solo un numero<U+0010><U+0001>븀\nlimitato di clienti.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Modestamente, è un’idea geniale!<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "004D006F00640065007300740061006D0065006E00740065002C002000E800200075006E20190069006400650061002000670065006E00690061006C0065002100100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Ma non ho mai preparato del sushi...<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2732,
      "rawDecodedUtf16Hex": "004D00610020006E006F006E00200068006F0020006D00610069002000700072006500700061007200610074006F002000640065006C002000730075007300680069002E002E002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "... e di andare al Ristorante Girasogno non mi va,\ncosta troppo! Capisci dove voglio arrivare?<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2816,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Immagino di no, quindi te lo dico chiaro e tondo:\nmostrami un Tatsugiri.<U+0010><U+0001>븀\nE in tutte e tre le forme, grazie!<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 3016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3248,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Quale delle tre forme di Tatsugiri mi vuoi\nmostrare?<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3260,
      "rawDecodedUtf16Hex": "005100750061006C0065002000640065006C006C0065002000740072006500200066006F0072006D006500200064006900200054006100740073007500670069007200690020006D0069002000760075006F0069000A006D006F007300740072006100720065003F00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "La Forma Arcuata",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3376,
      "rawDecodedUtf16Hex": "004C006100200046006F0072006D0061002000410072006300750061007400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "La Forma Adagiata",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3412,
      "rawDecodedUtf16Hex": "004C006100200046006F0072006D00610020004100640061006700690061007400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "La Forma Tesa",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3448,
      "rawDecodedUtf16Hex": "004C006100200046006F0072006D0061002000540065007300610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Lasciamo stare",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3476,
      "rawDecodedUtf16Hex": "004C00610073006300690061006D006F0020007300740061007200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Non mi sta bene che tu non voglia mostrarmi\nla forma che mi avevi promesso.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Non mi sta bene che tu non voglia mostrarmi\nTatsugiri.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3668,
      "rawDecodedUtf16Hex": "004E006F006E0020006D00690020007300740061002000620065006E006500200063006800650020007400750020006E006F006E00200076006F0067006C006900610020006D006F00730074007200610072006D0069000A005400610074007300750067006900720069002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3788,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un Tatsugiri Forma Arcuata...! Sarà difficile\ndisporre gli ingredienti a quel modo, ma è<U+0010><U+0001>븀\nun ottimo riferimento.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Mostrami anche le altre forme di Tatsugiri, grazie.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4040,
      "rawDecodedUtf16Hex": "004D006F0073007400720061006D006900200061006E0063006800650020006C006500200061006C00740072006500200066006F0072006D00650020006400690020005400610074007300750067006900720069002C0020006700720061007A00690065002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4152,
      "rawDecodedUtf16Hex": "00100002BDFF00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un Tatsugiri Forma Adagiata...! Direi che questo\nposso riprodurlo anche a occhi chiusi.<U+0010><U+0001>븀\nSarebbe un riferimento niente male.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 131
    },
    {
      "displayText": "Mostrami anche le altre forme di Tatsugiri, grazie.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4428,
      "rawDecodedUtf16Hex": "004D006F0073007400720061006D006900200061006E0063006800650020006C006500200061006C00740072006500200066006F0072006D00650020006400690020005400610074007300750067006900720069002C0020006700720061007A00690065002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿$",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4540,
      "rawDecodedUtf16Hex": "00100002BDFF00240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un Tatsugiri Forma Tesa...! Non dev’essere troppo\ndifficile riprodurlo disponendo degli ingredienti<U+0010><U+0001>븀\nqua e là. È un buon rifermento.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "Mostrami anche le altre forme di Tatsugiri, grazie.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4832,
      "rawDecodedUtf16Hex": "004D006F0073007400720061006D006900200061006E0063006800650020006C006500200061006C00740072006500200066006F0072006D00650020006400690020005400610074007300750067006900720069002C0020006700720061007A00690065002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4944,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ti sono grata per avermi mostrato tutte e tre le\nforme di Tatsugiri.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4956,
      "rawDecodedUtf16Hex": "0054006900200073006F006E006F002000670072006100740061002000700065007200200061007600650072006D00690020006D006F00730074007200610074006F0020007400750074007400650020006500200074007200650020006C0065000A0066006F0072006D00650020006400690020005400610074007300750067006900720069002E00100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Credo di essere più o meno in grado di preparare\ndel sushi. Dammi solo un secondo.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Cosa te ne pare?<U+0010><U+0001>븁\nSi capisce che è opera di un principiante, ma\nsono abbastanza intriganti da volerli ordinare.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5280,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Abbiamo trovato il piatto perfetto per fare soldi,\nma non troppi!<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 5516,
      "rawDecodedUtf16Hex": "00410062006200690061006D006F002000740072006F007600610074006F00200069006C002000700069006100740074006F00200070006500720066006500740074006F00200070006500720020006600610072006500200073006F006C00640069002C000A006D00610020006E006F006E002000740072006F007000700069002100100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Sul serio?!<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5656,
      "rawDecodedUtf16Hex": "00530075006C00200073006500720069006F003F002100100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Del sushi... con il caffè?!<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5688,
      "rawDecodedUtf16Hex": "00440065006C002000730075007300680069002E002E002E00200063006F006E00200069006C0020006300610066006600E8003F002100100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Luminopoli è sempre una garanzia! Una città\nper veri gourmet!<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5752,
      "rawDecodedUtf16Hex": "004C0075006D0069006E006F0070006F006C0069002000E8002000730065006D00700072006500200075006E006100200067006100720061006E007A00690061002100200055006E00610020006300690074007400E0000A0070006500720020007600650072006900200067006F00750072006D00650074002100100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Mi guarderò bene dal mangiarlo... Ma devo\ndiffondere la notizia in tutto il mondo!<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5884,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Ciao a tutti!!! Sono Vira! A Luminopoli ho\nscoperto una cosa pazzesca!!<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 6060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Sushi e caffè! Cioè, la svolta! Mi ha aperto un\nmondo! Venite a provarlo anche voi qui al Caffè<U+0010><U+0001>븀\nLa Tazza Vuota!<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
