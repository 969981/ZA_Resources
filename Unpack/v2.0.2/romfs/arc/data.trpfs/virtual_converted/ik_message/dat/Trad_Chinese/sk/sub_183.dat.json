      "rawDecodedUtf16Hex": "90A39EBCFF0C67005F8C4E00500B554F984C3002000A00100003110000FF01014F6059B376848A71FF0C670360F3898154EA500B51675BB97684544A793A677F5462FF1F00100002011401DC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "第1個：閃耀力",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2828,
      "rawDecodedUtf16Hex": "7B2C0031500BFF1A95838000529B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "第2個：異次元等級",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 2844,
      "rawDecodedUtf16Hex": "7B2C0032500BFF1A75706B2151437B497D1A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "第3個：金色的球",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 2864,
      "rawDecodedUtf16Hex": "7B2C0033500BFF1A91D18272768474030000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "原來如此！\n果然選得好。<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2884,
      "rawDecodedUtf16Hex": "539F4F8659826B64FF01000A679C713690785F97597D300200100002011401DC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "不過告示板\n不是想加就能加。<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "4E0D904E544A793A677F000A4E0D662F60F352A05C3180FD52A0300200100002011401DC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "要在市政廳取得許可，\n還要安排施工等等，很費事的啊。<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 2960,
      "rawDecodedUtf16Hex": "898157285E02653F5EF353D65F978A3153EFFF0C000A908489815B89639265BD5DE57B497B49FF0C5F888CBB4E8B7684554A300200100002011401DC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "你打算怎麼做？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 3024,
      "rawDecodedUtf16Hex": "4F6062537B97600E9EBC505AFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "你要放棄嗎？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 3040,
      "rawDecodedUtf16Hex": "4F608981653E68C455CEFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "我有辦法解決！<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 3056,
      "rawDecodedUtf16Hex": "621167098FA66CD589E36C7AFF0100100002011401DC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "告示板就是我！<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 3080,
      "rawDecodedUtf16Hex": "544A793A677F5C31662F6211FF0100100002011401DC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "不如說，\n我來當告示板！<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 3104,
      "rawDecodedUtf16Hex": "4E0D59828AAAFF0C000A62114F867576544A793A677FFF0100100002011401DC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "當然是當到告示板的\n增設施工開始為止啦。<U+0010><U+0001>븁\n總之多虧<U+0010><U+0003>ᄀÿā你妳幫了大忙！\n我打從心底感謝<U+0010><U+0003>ᄀÿā你妳！<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
