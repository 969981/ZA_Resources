      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Espero que actualicen el mapa cuanto antes\ncon Avenida <U+0010><U+0002>Ā<U+0002>.<U+0010><U+0002>ĔƳ",
