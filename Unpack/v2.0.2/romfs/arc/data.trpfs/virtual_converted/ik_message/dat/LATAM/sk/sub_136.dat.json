      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5504,
      "rawDecodedUtf16Hex": "00A10041007300ED002000730065007200E100210020004C00610020006E006F006D00620072006100720065006D006F0073002E002E002E000A00430061006C006C00650020004D00650068002E00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
