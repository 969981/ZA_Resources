      "rawDecodedUtf16Hex": "004F006A0061006C00E1002000650073007400650020006E006F006D0062007200650020006C00650073002000670075007300740065002000610020006C006F00730020006800610062006900740061006E007400650073000A0064006500200043006900750064006100640020004C0075006D0069006E0061006C00690061002E002E002E00100002011401B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
