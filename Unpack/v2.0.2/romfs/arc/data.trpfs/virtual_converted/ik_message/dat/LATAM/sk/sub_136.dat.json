      "rawDecodedUtf16Hex": "004F00700063006900F3006E00200043003A002000430061006C006C00650020004D006500680000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Prefiero darles otra opción",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3924,
      "rawDecodedUtf16Hex": "0050007200650066006900650072006F0020006400610072006C006500730020006F0074007200610020006F00700063006900F3006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "¡Gran Avenida Luminalia, claro que sí!<U+0010><U+0001>븁\nPuede que todavía no le haga honor a su nombre,\npero algún día representará a Ciudad Luminalia.<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "¡Calle Megaevolución, sin duda!<U+0010><U+0001>븁\nYa verás como circulará el rumor de que aquí\nfue donde se descubrió el fenómeno.<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 4264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Calle Meh, por supuesto. A las cosas hay\nque llamarlas por su nombre.<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4504,
      "rawDecodedUtf16Hex": "00430061006C006C00650020004D00650068002C00200070006F007200200073007500700075006500730074006F002E002000410020006C0061007300200063006F0073006100730020006800610079000A0071007500650020006C006C0061006D00610072006C0061007300200070006F00720020007300750020006E006F006D006200720065002E00100002011401B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "¡¿Cómo?! ¡¿No te convence ninguna de nuestras\npropuestas y quieres aportar otra?!<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Así que Avenida <U+0010><U+0002>Ā<U+0002>...<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 4824,
      "rawDecodedUtf16Hex": "0041007300ED00200071007500650020004100760065006E00690064006100200010000201000002002E002E002E00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Bueno, pues me parece muy buena idea.<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4880,
      "rawDecodedUtf16Hex": "004200750065006E006F002C002000700075006500730020006D006500200070006100720065006300650020006D007500790020006200750065006E006100200069006400650061002E00100002011401B20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Estoy de acuerdo.<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 4964,
      "rawDecodedUtf16Hex": "004500730074006F00790020006400650020006100630075006500720064006F002E00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Yo también opino lo mismo. Ese sí que es\nun nombre memorable y no uno \"mehmorable\".<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 5008,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "¡Así será! La nombraremos...\nAvenida <U+0010><U+0002>Ā<U+0002>.<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 32,
