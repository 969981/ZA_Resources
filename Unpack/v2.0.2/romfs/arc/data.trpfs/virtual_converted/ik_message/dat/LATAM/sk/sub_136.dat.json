      "rawDecodedUtf16Hex": "00A10041007300ED002000730065007200E100210020004C00610020006E006F006D00620072006100720065006D006F0073002E002E002E000A004100760065006E00690064006100200010000201000002002E00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
