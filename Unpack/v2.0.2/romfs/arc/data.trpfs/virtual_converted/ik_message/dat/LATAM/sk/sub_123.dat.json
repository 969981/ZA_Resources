      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1756,
      "rawDecodedUtf16Hex": "00A100420075006E006E0065006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Admira...<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "00410064006D006900720061002E002E002E00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
