  "messages": [
    {
      "displayText": "¡Bun!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "00A100420075006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "¡Hola! Gracias por ayudarme con ese Bunnelby\nenorme la otra vez.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "00A10048006F006C006100210020004700720061006300690061007300200070006F00720020006100790075006400610072006D006500200063006F006E0020006500730065002000420075006E006E0065006C00620079000A0065006E006F0072006D00650020006C00610020006F007400720061002000760065007A002E00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Cuando combatiste contra él, no pude ayudarte\ny me quedé mirando como un inútil...<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Pero aquel día sentí cómo una pequeña llama\nse encendió en mi interior.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "¡Quiero ser fuerte como tú!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "00A100510075006900650072006F0020007300650072002000660075006500720074006500200063006F006D006F0020007400FA002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Por eso he estado entrenando duro desde\nese día.<U+0010><U+0001>븁\nComo Entrenador y como viajero, tuve que hacer\nborrón y cuenta nueva.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
    {
      "displayText": "¡Esta vez no me voy a quedar mirando!\n¡Combate contra mí, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1056,
      "rawDecodedUtf16Hex": "00A10045007300740061002000760065007A0020006E006F0020006D006500200076006F00790020006100200071007500650064006100720020006D006900720061006E0064006F0021000A00A10043006F006D006200610074006500200063006F006E0074007200610020006D00ED002C00200010000201000000002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "¡Te voy a mostrar lo enorme que es el vínculo\nque me une a mis queridos Pokémon!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Cuando estés list<U+0010><U+0003>ᄀÿāoa para el combate, avísame.\n¡Yo ya estoy temblando de la emoción!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Y? ¿Ya estás list<U+0010><U+0003>ᄀÿāoa para el combate?<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "00BF0059003F002000BF00590061002000650073007400E100730020006C00690073007400100003110000FF0101006F00610020007000610072006100200065006C00200063006F006D0062006100740065003F00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "List<U+0010><U+0003>ᄀÿāoa",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1660,
      "rawDecodedUtf16Hex": "004C00690073007400100003110000FF0101006F00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Todavía no",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "0054006F00640061007600ED00610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¡Perfecto! ¡Vamos!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "00A10050006500720066006500630074006F0021002000A100560061006D006F0073002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
