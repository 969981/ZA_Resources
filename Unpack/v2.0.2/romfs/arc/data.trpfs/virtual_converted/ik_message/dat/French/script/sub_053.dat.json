    },
    {
      "displayText": "Désolé, cet Holoporteur est hors service pour\ncause de maintenance. Et moi... je suis en pause.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 216,
