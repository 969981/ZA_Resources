  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Are you kidding? No way!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "00410072006500200079006F00750020006B0069006400640069006E0067003F0020004E006F002000770061007900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Hey, who’s the customer here?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "004800650079002C002000770068006F20190073002000740068006500200063007500730074006F006D0065007200200068006500720065003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Oh, hey, <U+0010><U+0002>Ā<U+0000>! Sorry to\nspring<U+0010><U+0001>븀\nthis<U+0010><U+0001>븀\non<U+0010><U+0001>븀\nyou,<U+0010><U+0001>븀\nbut<U+0010><U+0001>븀\ngimme<U+0010><U+0001>븀\na<U+0010><U+0001>븀\nhand,<U+0010><U+0001>븀\nwill ya?<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 24,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "This guy needed help carrying stuff, but when we\noffered our services, he made a crazy request!<U+0010><U+0001>븁\nSo I told him it’s not possible, and now he’s all up\nin our faces demanding a battle!<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 189
    },
    {
      "displayText": "All I asked was for you to carry my precious\nAggron, but now you say that’s impossible?!<U+0010><U+0002>ĔƎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 976,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Aggron weighs nearly 800 pounds! How do you\nexpect anyone to carry that?!<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "I don’t wanna hear it! You’ve got nerve, making\nan offer and immediately going back on it.<U+0010><U+0001>븁\nI’ll whip you into shape—both of you!<U+0010><U+0002>ĔƎ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1320,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "I came to Lumiose to join the Z-A Royale!<U+0010><U+0001>븁\nIf I can’t take out two upstarts like you, I’ve got no\nbusiness even being here!<U+0010><U+0002>ĔƎ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "Doesn’t seem like anything will get through to\nhim. So come on, battle him with me!<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1852,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2028,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "You ready to battle him with me?<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "0059006F007500200072006500610064007900200074006F00200062006100740074006C0065002000680069006D002000770069007400680020006D0065003F001000020114002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Let’s do this",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2116,
      "rawDecodedUtf16Hex": "004C006500742019007300200064006F002000740068006900730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Gimme a sec",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2144,
      "rawDecodedUtf16Hex": "00470069006D006D00650020006100200073006500630000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "How much longer are you gonna drag your feet?<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2168,
      "rawDecodedUtf16Hex": "0048006F00770020006D0075006300680020006C006F006E006700650072002000610072006500200079006F007500200067006F006E006E00610020006400720061006700200079006F0075007200200066006500650074003F001000020114002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Remember how we met? Funny how Pancham\ncarried your stuff to me, and now here we are.<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Sorry for the trouble back then, and thanks for\nagreeing to help me out now!<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Aggron and my other Pokémon are going to send\nyou all flying!<U+0010><U+0002>ĔƎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2612,
      "rawDecodedUtf16Hex": "0041006700670072006F006E00200061006E00640020006D00790020006F007400680065007200200050006F006B00E9006D006F006E002000610072006500200067006F0069006E006700200074006F002000730065006E0064000A0079006F007500200061006C006C00200066006C00790069006E00670021001000020114018E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2744,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "I had no idea that Lumiose City’s Trainers were\nso formidable!<U+0010><U+0002>ĔƎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "004900200068006100640020006E006F00200069006400650061002000740068006100740020004C0075006D0069006F00730065002000430069007400792019007300200054007200610069006E00650072007300200077006500720065000A0073006F00200066006F0072006D0069006400610062006C00650021001000020114018E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "OK, never mind about the Z-A Royale! Once we’ve\ndone some sightseeing, we’re heading home!<U+0010><U+0002>ĔƎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "“Carry my Aggron,” he says... Sheesh, if he’d just\nbeen reasonable, we’d have been happy to show<U+0010><U+0001>븀\nhim around.<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Panch!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3316,
      "rawDecodedUtf16Hex": "00500061006E0063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Thanks, <U+0010><U+0002>Ā<U+0000>. You really\nhelped!<U+0010><U+0001>븁\nI appreciate you lending us a hand, even after we\nkinda took your bag.<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3332,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "And I do kind of owe you. Seeing Pancham carry\nyour travel bag back then gave me an idea...<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "So I started a business showing tourists around\nLumiose while carrying their bags for ’em.<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "After all, Pokémon like Pancham can climb fences\nand get into places where people can’t.<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 3948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Hey! You’re late—is everything OK?<U+0010><U+0002>Ĕ-",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4136,
      "rawDecodedUtf16Hex": "004800650079002100200059006F00752019007200650020006C006100740065201400690073002000650076006500720079007400680069006E00670020004F004B003F001000020114002D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Andre? Yeah, everything’s fine.<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 4216,
      "rawDecodedUtf16Hex": "0041006E006400720065003F00200059006500610068002C002000650076006500720079007400680069006E006720190073002000660069006E0065002E001000020114002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "We ran into some trouble, but we took care of it.\nI’ll come meet you now!<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "I hear you’re doing pretty well in the Z-A Royale.<U+0010><U+0001>븁\nMakes me proud to think your first Pokémon\nbattle in Lumiose was against me.<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 4444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "OK, see you later. I hope we meet again!<U+0010><U+0002>Ĕ,",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 4716,
      "rawDecodedUtf16Hex": "004F004B002C002000730065006500200079006F00750020006C0061007400650072002E0020004900200068006F007000650020007700650020006D00650065007400200061006700610069006E0021001000020114002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    }
