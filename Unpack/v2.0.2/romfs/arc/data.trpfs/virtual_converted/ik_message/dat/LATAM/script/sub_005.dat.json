      "index": 15,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "004F0068002E002E002E00200071007500E90020006D0061006C006100200070006100740061002E00100002011401290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Aun así, los Pokémon de tipo Hada me fascinan.<U+0010><U+0001>븁\nSon los únicos totalmente inmunes a los\nataques de tipo Dragón.<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Pero, claro, también tienen sus puntos débiles.<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "005000650072006F002C00200063006C00610072006F002C002000740061006D0062006900E9006E0020007400690065006E0065006E0020007300750073002000700075006E0074006F00730020006400E900620069006C00650073002E00100002011401290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
