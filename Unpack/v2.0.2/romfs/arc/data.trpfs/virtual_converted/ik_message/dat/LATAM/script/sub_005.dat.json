      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Prepara un equipo con tu tipo favorito.\n¡O con varios tipos si lo prefieres!<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
