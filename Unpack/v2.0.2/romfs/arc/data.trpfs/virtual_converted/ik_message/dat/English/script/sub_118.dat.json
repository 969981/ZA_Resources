      "offsetInSection": 476,
      "rawDecodedUtf16Hex": "00100002BDFF00030000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Thanks for coming.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "005400680061006E006B007300200066006F007200200063006F006D0069006E0067002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Have you figured out what it is I need you for?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 536,
      "rawDecodedUtf16Hex": "004800610076006500200079006F0075002000660069006700750072006500640020006F0075007400200077006800610074002000690074002000690073002000490020006E00650065006400200079006F007500200066006F0072003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "I have absolutely no idea",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "0049002000680061007600650020006100620073006F006C007500740065006C00790020006E006F002000690064006500610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Would you just explain?",
