  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "¿Por qué quieres volverte más fuerte?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "00BF0050006F007200200071007500E90020007100750069006500720065007300200076006F006C007600650072007400650020006D00E100730020006600750065007200740065003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Lo hago por mí misma.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "004C006F0020006800610067006F00200070006F00720020006D00ED0020006D00690073006D0061002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡Yo deseo volverme más fuerte para proteger\na Inma y a los demás!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "00A10059006F00200064006500730065006F00200076006F006C007600650072006D00650020006D00E10073002000660075006500720074006500200070006100720061002000700072006F00740065006700650072000A006100200049006E006D006100200079002000610020006C006F0073002000640065006D00E10073002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Es cierto que no he conseguido vencer a Lilette...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 608,
      "rawDecodedUtf16Hex": "00450073002000630069006500720074006F00200071007500650020006E006F00200068006500200063006F006E007300650067007500690064006F002000760065006E006300650072002000610020004C0069006C0065007400740065002E002E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Pero lo que no te mata te hace más fuerte.\nEstoy convencida de ello.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "005000650072006F0020006C006F00200071007500650020006E006F0020007400650020006D006100740061002000740065002000680061006300650020006D00E100730020006600750065007200740065002E000A004500730074006F007900200063006F006E00760065006E006300690064006100200064006500200065006C006C006F002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Si consigo superar a Lilette, me sentiré invencible.\n¡Seguiré luchando hasta alcanzar esa meta!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Así que luchas únicamente por ti misma...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "0041007300ED00200071007500650020006C00750063006800610073002000FA006E006900630061006D0065006E0074006500200070006F00720020007400690020006D00690073006D0061002E002E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Pues no me parece que sea un razonamiento\nadecuado para una Entrenadora!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1160,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "¡Psst! ¡Ven!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1316,
      "rawDecodedUtf16Hex": "00A100500073007300740021002000A100560065006E002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Voy a aprovechar que estás aquí para zanjar este\ntema y que dejen de pelearse.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Eh, chicos, ha venido <U+0010><U+0002>Ā<U+0000>. ¿Y si\ndecidimos<U+0010><U+0001>븀\nquién<U+0010><U+0001>븀\ntiene razón con un combate?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1520,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¡Estoy list<U+0010><U+0003>ᄀÿāoa!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "00A1004500730074006F00790020006C00690073007400100003110000FF0101006F006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Un momento",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "0055006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¡Menos cháchara y más combatir!\nHablando no te vas a hacer más fuerte.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "¡Junt<U+0010><U+0003>ᄀÿāoas contra el Círculo Justiciero,\nles mostraremos nuestra convicción!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2088,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Yo también ardo en deseos de batirnos\nen combate.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2100,
      "rawDecodedUtf16Hex": "0059006F002000740061006D0062006900E9006E0020006100720064006F00200065006E00200064006500730065006F0073002000640065002000620061007400690072006E006F0073000A0065006E00200063006F006D0062006100740065002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Quiero combatir de una vez e irme a casa.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "00510075006900650072006F00200063006F006D0062006100740069007200200064006500200075006E0061002000760065007A00200065002000690072006D00650020006100200063006100730061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Estoy list<U+0010><U+0003>ᄀÿāoa!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2300,
      "rawDecodedUtf16Hex": "00A1004500730074006F00790020006C00690073007400100003110000FF0101006F006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Un momento",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2340,
      "rawDecodedUtf16Hex": "0055006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Existe un tipo de experiencia que solo puede\nobtenerse al derrotar a adversarios fuertes.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "¡La fuerza es poder!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "00A1004C006100200066007500650072007A006100200065007300200070006F006400650072002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "¿Desde cuándo eres así de indecis<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2604,
      "rawDecodedUtf16Hex": "00BF0044006500730064006500200063007500E1006E0064006F0020006500720065007300200061007300ED00200064006500200069006E0064006500630069007300100003110000FF0101006F0061003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡La fuerza es justicia!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2696,
      "rawDecodedUtf16Hex": "00A1004C006100200066007500650072007A00610020006500730020006A0075007300740069006300690061002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "¡Junt<U+0010><U+0003>ᄀÿāoas contra el Círculo Justiciero,\nles mostraremos nuestra convicción!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2752,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0019>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡La justicia prevalecerá! ¡Falinks, megaevoluciona!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2932,
      "rawDecodedUtf16Hex": "00A1004C00610020006A0075007300740069006300690061002000700072006500760061006C006500630065007200E10021002000A100460061006C0069006E006B0073002C0020006D00650067006100650076006F006C007500630069006F006E0061002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Chandelure... ¡Megaevoluciona y deshazte\nde ellos!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3044,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002E002E002E002000A1004D00650067006100650076006F006C007500630069006F006E006100200079002000640065007300680061007A00740065000A0064006500200065006C006C006F0073002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Es hora de sacar a mi as en la manga.\n¡Megaevoluciona y dales pa'l pelo, Dragalge!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3332,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "No importa luchar por los demás o por uno\nmismo.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3344,
      "rawDecodedUtf16Hex": "004E006F00200069006D0070006F0072007400610020006C0075006300680061007200200070006F00720020006C006F0073002000640065006D00E100730020006F00200070006F007200200075006E006F000A006D00690073006D006F002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Ambos enfoques son igualmente válidos.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3452,
      "rawDecodedUtf16Hex": "0041006D0062006F007300200065006E0066006F007100750065007300200073006F006E00200069006700750061006C006D0065006E007400650020007600E1006C00690064006F0073002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Y yo supongo que luchar por los demás te ha\npermitido alcanzar tu propia meta. ¡Bien hecho!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3540,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "¡Me ha llegado al alma lo que has dicho!\nToma este conjunto, es para ti.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Lo siento, pero prometí llevar este atuendo hasta\npoder liberarme del yugo de Lilette.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3888,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Entiendo. Bueno, pues entonces es para ti,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4072,
      "rawDecodedUtf16Hex": "00100002BD0600000045006E007400690065006E0064006F002E0020004200750065006E006F002C0020007000750065007300200065006E0074006F006E00630065007300200065007300200070006100720061002000740069002C000A0010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Has recibido el Kimono de Albar de color\nalternativo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4188,
      "rawDecodedUtf16Hex": "00480061007300200072006500630069006200690064006F00200065006C0020004B0069006D006F006E006F00200064006500200041006C00620061007200200064006500200063006F006C006F0072000A0061006C007400650072006E0061007400690076006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Dicen por ahí que algunos raritos han empezado\na peinarse como Albar...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "La sed de fuerza no tiene límites. Espero que\nel destino vuelva a enfrentarnos pronto.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Igual lo del dojo le pega a Delphia más que a mí.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 4632,
      "rawDecodedUtf16Hex": "0049006700750061006C0020006C006F002000640065006C00200064006F006A006F0020006C00650020007000650067006100200061002000440065006C00700068006900610020006D00E100730020007100750065002000610020006D00ED002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Creo recordar haber luchado contra Albar de\npequeños...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4740,
      "rawDecodedUtf16Hex": "004300720065006F0020007200650063006F00720064006100720020006800610062006500720020006C00750063006800610064006F00200063006F006E00740072006100200041006C006200610072002000640065000A0070006500710075006500F1006F0073002E002E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    }
