      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Bonjour ! Vous avez besoin d’une course ?\nDites oui, s’il vous plaît !<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Je viens de me lancer en tant que chauffeuse\nde taxi, mais je n’ai encore eu aucun client...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 544,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Non pas que je manque d’entraînement, mais\nenfin... j’aimerais bien que mon activité démarre...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "J’aimerais donc faire une course pour vous.\nJe ne vous ferai même pas payer !<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Faites-moi signe quand vous aurez besoin\nde mes services !<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "004600610069007400650073002D006D006F00690020007300690067006E00650020007100750061006E006400200076006F0075007300200061007500720065007A0020006200650073006F0069006E000A006400650020006D0065007300200073006500720076006900630065007300200021001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Voulez-vous monter dans mon taxi ?\nAlors, où allons-nous ?<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F007500730020006D006F006E007400650072002000640061006E00730020006D006F006E002000740061007800690020003F000A0041006C006F00720073002C0020006F00F900200061006C006C006F006E0073002D006E006F007500730020003F001000020114014E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Oui.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "004F00750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Non.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1384,
      "rawDecodedUtf16Hex": "004E006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "S’il vous plaît...\nVous me rendriez un grand service...<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1396,
