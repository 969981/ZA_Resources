      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Merci, client<U+0010><U+0003>ᄀÿĀe numéro un !<U+0010><U+0002>ĔŎ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
