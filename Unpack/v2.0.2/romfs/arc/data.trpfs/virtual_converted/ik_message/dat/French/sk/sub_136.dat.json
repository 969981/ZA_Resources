      "rawDecodedUtf16Hex": "0051007520190069006C00200065006E00200073006F00690074002000610069006E007300690020002100200043006500740074006500200072007500650020007320190061007000700065006C006C006500720061000A006C20190041006C006C00E9006500200043006F006D0075006E00670061006E0020002100100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
