      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Oui, j’ai choisi !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 3596,
      "rawDecodedUtf16Hex": "004F00750069002C0020006A201900610069002000630068006F006900730069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Non, pas encore.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3636,
      "rawDecodedUtf16Hex": "004E006F006E002C002000700061007300200065006E0063006F00720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Vraiment ? Alors, lequel préfères-tu ?\nDis-nous tout !<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3672,
