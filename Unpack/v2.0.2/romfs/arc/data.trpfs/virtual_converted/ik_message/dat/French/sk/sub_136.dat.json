      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ce serait bien que la ville officialise le nom\nde la Rue <U+0010><U+0002>Ā<U+0002> !<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 5,
