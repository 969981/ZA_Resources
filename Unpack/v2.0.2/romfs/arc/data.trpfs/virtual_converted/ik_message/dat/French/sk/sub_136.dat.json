      "offsetInSection": 5372,
      "rawDecodedUtf16Hex": "00530070006C0065006E00640069006400650020002100100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Je suis d’accord ! Ce nom lui va...\ncomme un gant !<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 5404,
      "rawDecodedUtf16Hex": "004A006500200073007500690073002000642019006100630063006F00720064002000210020004300650020006E006F006D0020006C00750069002000760061002E002E002E000A0063006F006D006D006500200075006E002000670061006E00740020002100100002011401B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Qu’il en soit ainsi ! Cette rue s’appellera\nla Rue <U+0010><U+0002>Ā<U+0002> !<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 5,
