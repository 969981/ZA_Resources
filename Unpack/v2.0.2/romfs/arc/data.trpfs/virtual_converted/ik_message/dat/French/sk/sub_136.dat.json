      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 5248,
      "rawDecodedUtf16Hex": "004C00610020005200750065002000100002010000020020003F00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Je trouve que ce nom est merveilleux !<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 5284,
