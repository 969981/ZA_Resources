      "offsetInSection": 5800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Qu’il en soit ainsi ! Cette rue s’appellera\nl’Allée Comungan !<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
