  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Bienvenue ! Aux Algolides, service\net goût valent une paire d’étoiles !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 220,
      "rawDecodedUtf16Hex": "004200690065006E00760065006E0075006500200021002000410075007800200041006C0067006F006C0069006400650073002C00200073006500720076006900630065000A0065007400200067006F00FB0074002000760061006C0065006E007400200075006E006500200070006100690072006500200064201900E90074006F0069006C00650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Voulez-vous essayer\nnotre menu dégustation ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F0075007300200065007300730061007900650072000A006E006F0074007200650020006D0065006E00750020006400E90067007500730074006100740069006F006E0020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Aujourd’hui, c’est moi qui régale,\nalors fais-toi plaisir.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "00410075006A006F0075007200642019006800750069002C0020006320190065007300740020006D006F006900200071007500690020007200E900670061006C0065002C000A0061006C006F0072007300200066006100690073002D0074006F006900200070006C00610069007300690072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Ce qui me ferait plaisir, c’est de\ngoûter au combat du jour !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 604,
      "rawDecodedUtf16Hex": "0043006500200071007500690020006D0065002000660065007200610069007400200070006C00610069007300690072002C002000632019006500730074002000640065000A0067006F00FB00740065007200200061007500200063006F006D0062006100740020006400750020006A006F00750072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Je comprends, ma puce,\nmais ça ne se fait pas.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "004A006500200063006F006D007000720065006E00640073002C0020006D006100200070007500630065002C000A006D006100690073002000E700610020006E0065002000730065002000660061006900740020007000610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "J’aimerais bien manger avec\nmes Pokémon, moi !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "004A201900610069006D006500720061006900730020006200690065006E0020006D0061006E00670065007200200061007600650063000A006D0065007300200050006F006B00E9006D006F006E002C0020006D006F0069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Le fromage du jour est un bleu au lait cru\nultra-affiné, persillé au Toxik d’Arbok femelle,<U+0010><U+0001>븀\nmis en cave pendant 180 ans.<U+0010><U+0001>븁\nUne microscopique bouchée a de quoi faire\nchavirer palais et narines avec plus de force<U+0010><U+0001>븀\nqu’une horde déchaînée de Cocotine !",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 255
    },
    {
      "displayText": "En dessert, ils ont le fameux sorbet Kiwan-Fraive\net son Mont Couronné de mousse aux herbes,<U+0010><U+0001>븀\nrelevé au piment Naga Séviper !",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1432,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Les plats sont délicieux, et ils ne plaisantent pas\navec les quantités !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1688,
      "rawDecodedUtf16Hex": "004C0065007300200070006C00610074007300200073006F006E00740020006400E9006C006900630069006500750078002C00200065007400200069006C00730020006E006500200070006C0061006900730061006E00740065006E00740020007000610073000A00610076006500630020006C006500730020007100750061006E00740069007400E90073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Si on ne finit pas, on pourra emporter\nce qu’il reste pour nos Pokémon !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "005300690020006F006E0020006E0065002000660069006E006900740020007000610073002C0020006F006E00200070006F007500720072006100200065006D0070006F0072007400650072000A0063006500200071007520190069006C00200072006500730074006500200070006F007500720020006E006F007300200050006F006B00E9006D006F006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Euh, papa...\nOn est si riches que ça ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "004500750068002C00200070006100700061002E002E002E000A004F006E002000650073007400200073006900200072006900630068006500730020007100750065002000E700610020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Si l’on peut commander ce que l’on veut, je vais\nopter pour les roulades de la Baie Azur AOC,<U+0010><U+0001>븀\naccompagnées de leur farandole de Baies Yapap<U+0010><U+0001>븀\net d’un filet d’huile de Baies Oran vierge extra.<U+0010><U+0001>븁\nIl paraît que le glaçage laisse aussi extatique\nqu’une Mystimaniac devant un Fantominus !",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 289
    },
    {
      "displayText": "Pourquoi tant de générosité ?\nT’as gagné gros au Royale Z-A ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2644,
      "rawDecodedUtf16Hex": "0050006F0075007200710075006F0069002000740061006E00740020006400650020006700E9006E00E90072006F00730069007400E90020003F000A00542019006100730020006700610067006E00E9002000670072006F007300200061007500200052006F00790061006C00650020005A002D00410020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Ne vous privez pas !\nCommandez ce que vous voulez !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2768,
      "rawDecodedUtf16Hex": "004E006500200076006F00750073002000700072006900760065007A002000700061007300200021000A0043006F006D006D0061006E00640065007A002000630065002000710075006500200076006F0075007300200076006F0075006C0065007A002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Les plats ont meilleur goût quand\non regarde un beau combat.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "004C0065007300200070006C0061007400730020006F006E00740020006D00650069006C006C00650075007200200067006F00FB00740020007100750061006E0064000A006F006E0020007200650067006100720064006500200075006E0020006200650061007500200063006F006D006200610074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Les combats Pokémon sont\nle piment de la vie !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2996,
      "rawDecodedUtf16Hex": "004C0065007300200063006F006D006200610074007300200050006F006B00E9006D006F006E00200073006F006E0074000A006C0065002000700069006D0065006E00740020006400650020006C00610020007600690065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Aujourd’hui, je suis fier de pouvoir offrir ce repas\nà ma chère grand-mère !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 3092,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Si c’est pour t’écouter te vanter, je préfère\nencore manger toute seule...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3248,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Si je ne me fais pas remarquer, personne ne\ndevrait m’adresser la parole...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Je constate que les repas sont des\nmoments qui te tiennent à cœur.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3552,
      "rawDecodedUtf16Hex": "004A006500200063006F006E0073007400610074006500200071007500650020006C0065007300200072006500700061007300200073006F006E00740020006400650073000A006D006F006D0065006E0074007300200071007500690020007400650020007400690065006E006E0065006E0074002000E000200063015300750072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Rien de tel que de manger\nlentement pour atteindre la satiété.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "005200690065006E002000640065002000740065006C00200071007500650020006400650020006D0061006E006700650072000A006C0065006E00740065006D0065006E007400200070006F00750072002000610074007400650069006E0064007200650020006C00610020007300610074006900E9007400E9002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Je suis catégorique : c’est mon\nSucroquin qui est le plus mignon !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3816,
      "rawDecodedUtf16Hex": "004A006500200073007500690073002000630061007400E90067006F007200690071007500650020003A0020006320190065007300740020006D006F006E000A0053007500630072006F007100750069006E002000710075006900200065007300740020006C006500200070006C007500730020006D00690067006E006F006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "J’insiste, mon Cocotine a bien\nplus de charme !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3952,
      "rawDecodedUtf16Hex": "004A20190069006E00730069007300740065002C0020006D006F006E00200043006F0063006F00740069006E0065002000610020006200690065006E000A0070006C0075007300200064006500200063006800610072006D0065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "La viande est absolument\nincroyable, ici !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 4048,
      "rawDecodedUtf16Hex": "004C00610020007600690061006E0064006500200065007300740020006100620073006F006C0075006D0065006E0074000A0069006E00630072006F007900610062006C0065002C0020006900630069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Sancho s’est encore surpassé !\nC’est décidément un chef hors pair.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 4136,
      "rawDecodedUtf16Hex": "00530061006E00630068006F00200073201900650073007400200065006E0063006F007200650020007300750072007000610073007300E900200021000A004320190065007300740020006400E900630069006400E9006D0065006E007400200075006E0020006300680065006600200068006F0072007300200070006100690072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Je fais une petite folie en venant\nici, mais je l’ai bien mérité !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "004A00650020006600610069007300200075006E0065002000700065007400690074006500200066006F006C0069006500200065006E002000760065006E0061006E0074000A006900630069002C0020006D0061006900730020006A00650020006C2019006100690020006200690065006E0020006D00E900720069007400E9002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "J’aspire à faire de mon mieux pour\ndonner envie aux gens de revenir.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4408,
      "rawDecodedUtf16Hex": "004A2019006100730070006900720065002000E00020006600610069007200650020006400650020006D006F006E0020006D006900650075007800200070006F00750072000A0064006F006E006E0065007200200065006E0076006900650020006100750078002000670065006E007300200064006500200072006500760065006E00690072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    }
