  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "哦哦！你是上次那位训练家！\n我们正在拍电影的另一个桥段。<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "54E654E6FF014F60662F4E0A6B2190A34F4D8BAD7EC35BB6FF01000A62114EEC6B63572862CD75355F71768453E64E004E2A68656BB5300200100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "这次的主题是恐怖！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 404,
      "rawDecodedUtf16Hex": "8FD96B2176844E3B9898662F60506016FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "要拍的是被当成森林里的怪物\n而遭人畏惧的宝可梦朽木妖！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "898162CD7684662F88AB5F53621068EE679791CC7684602A7269000A800C906D4EBA754F60E776845B9D53EF68A6673D67285996FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "但野生宝可梦很可怕！\n幽灵属性就更不用说了！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "4F4691CE751F5B9D53EF68A65F8853EF6015FF01000A5E7D70755C5E60275C3166F44E0D75288BF44E86FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "所以这次又要你出场了。<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "62404EE58FD96B2153C889814F6051FA573A4E86300200100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "野生的朽木妖\n似乎非常稀有。<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "91CE751F7684673D67285996000A4F3C4E4E975E5E387A006709300200100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "有传闻说它们会出现在\n13号还是15号野生特区……<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "67094F2095FB8BF45B834EEC4F1A51FA73B05728000A0031003353F78FD8662F0031003553F791CE751F7279533A2026202600100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "不过就算是从小木灵进化来的\n朽木妖也没问题！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "4E0D8FC75C317B97662F4ECE5C0F672870758FDB531667657684000A673D672859964E5F6CA195EE9898FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "总之，你可以在晚上\n带朽木妖过来吗？<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "603B4E4BFF0C4F6053EF4EE55728665A4E0A000A5E26673D672859968FC767655417FF1F00100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 788,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "你愿意帮忙拍摄吗？<U+0010><U+0001>븁\n那么麻烦你在晚上把朽木妖\n放到同行队伍中带过来！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "4F60613F610F5E2E5FD962CD64445417FF1F00100001BE01000A90A34E489EBB70E64F605728665A4E0A628A673D67285996000A653E5230540C884C961F4F0D4E2D5E268FC76765FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "你带着朽木妖啊！\n就是说你会来帮忙拍摄，对吧？<U+0010><U+0001>븀\n拍摄会在晚上开始！等晚上再来吧！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 884,
      "rawDecodedUtf16Hex": "4F605E267740673D67285996554AFF01000A5C31662F8BF44F604F1A67655E2E5FD962CD6444FF0C5BF95427FF1F00100001BE00000A62CD64444F1A5728665A4E0A5F0059CBFF017B49665A4E0A518D67655427FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "拍摄又中断了？<U+0010><U+0002>Ĕƕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "62CD644453C84E2D65AD4E86FF1F00100002011401950000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "恐怖情节……\n好紧张啊……<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1004,
      "rawDecodedUtf16Hex": "6050601660C5828220262026000A597D7D275F20554A2026202600100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "莫非你要让你的朽木妖\n来帮忙拍摄吗？<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "83AB975E4F6089818BA94F607684673D67285996000A67655E2E5FD962CD64445417FF1F00100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "让我们来帮忙吧！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "8BA962114EEC67655E2E5FD95427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "还是算了",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "8FD8662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我想要宝可梦\n才有的震撼力……！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "621160F389815B9D53EF68A6000A624D67097684970764BC529B20262026FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "不愧是你！\n好，开始拍摄！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "4E0D6127662F4F60FF01000A597DFF0C5F0059CB62CD6444FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "准备好了吗！？\n预备……Action！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "51C65907597D4E865417FF01FF1F000A98845907202620260041006300740069006F006EFF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "这里……不会出现幽灵什么的吧？<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "8FD991CC202620264E0D4F1A51FA73B05E7D70754EC04E4876845427FF1F00100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "不会啦！<U+0010><U+0002>Ĕƕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1300,
      "rawDecodedUtf16Hex": "4E0D4F1A5566FF0100100002011401950000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "等一下……\n刚才你听到什么声音了吗？<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1320,
      "rawDecodedUtf16Hex": "7B494E004E0B20262026000A521A624D4F60542C52304EC04E4858F097F34E865417FF1F00100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "有声音吗？<U+0010><U+0002>Ĕƕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "670958F097F35417FF1F00100002011401950000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "呵呵嘿……！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "54755475563F20262026FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "哇啊啊啊！！<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "54C7554A554A554AFF01FF0100100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "……咦？\n一点都不可怕呀。<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "2026202654A6FF1F000A4E0070B990FD4E0D53EF60155440300200100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "CUT！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1464,
      "rawDecodedUtf16Hex": "004300550054FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "哪会有这么友善的\n森林怪物啊！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1484,
      "rawDecodedUtf16Hex": "54EA4F1A67098FD94E4853CB55847684000A68EE6797602A7269554AFF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "说起来，朽木妖好像对\n住在森林里的生物会非常亲切。<U+0010><U+0002>Ĕƕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1524,
      "rawDecodedUtf16Hex": "8BF48D776765FF0C673D67285996597D50CF5BF9000A4F4F572868EE679791CC7684751F72694F1A975E5E384EB25207300200100002011401950000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "莫非……我们被它当成\n森林里的伙伴了吗？<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "83AB975E2026202662114EEC88AB5B835F536210000A68EE679791CC76844F194F344E865417FF1F00100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "什么！？这种幽灵属性宝可梦的温柔\n居然只会展现给同伴看……<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "4EC04E48FF01FF1F8FD979CD5E7D70755C5E60275B9D53EF68A676846E2967D4000A5C45713653EA4F1A5C5573B07ED9540C4F34770B2026202600100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "这也是宝可梦真实的一面！\n是应该拍进电影里的画面！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "8FD94E5F662F5B9D53EF68A6771F5B9E76844E009762FF01000A662F5E948BE562CD8FDB75355F7191CC7684753B9762FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "重要的是画面！\n画面无需说明就能打动任何人！<U+0010><U+0001>븀\n就算为了画面改变剧情也没问题！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "91CD89817684662F753B9762FF01000A753B976265E097008BF4660E5C3180FD625352A84EFB4F554EBAFF0100100001BE00000A5C317B974E3A4E86753B9762653953D8526760C54E5F6CA195EE9898FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "<U+0010><U+0002>뷿$",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "00100002BDFF00240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "世界上只有我……\n知道朽木妖的真相与深渊！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "4E16754C4E0A53EA6709621120262026000A77E59053673D672859967684771F76F84E0E6DF16E0AFF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "剧本是电影的设计图，\n为了画面而改变剧情真的好吗？<U+0010><U+0002>Ĕƕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 1920,
      "rawDecodedUtf16Hex": "5267672C662F75355F7176848BBE8BA156FEFF0C000A4E3A4E86753B9762800C653953D8526760C5771F7684597D5417FF1F00100002011401950000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "仔细一看，就会发现\n朽木妖的眼神很温柔啊。<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "4ED47EC64E00770BFF0C5C314F1A53D173B0000A673D672859967684773C795E5F886E2967D4554A300200100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    }
