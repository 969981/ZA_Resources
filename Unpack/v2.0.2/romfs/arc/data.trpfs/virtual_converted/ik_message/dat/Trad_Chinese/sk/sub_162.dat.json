  "initialKey": 0,
  "messages": [
    {
      "displayText": "總覺得我有看過這個地方。<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "7E3D89BA5F9762116709770B904E9019500B573065B9300200100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "連在這裡也和哥哥在一起……\n我極度不滿。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 352,
      "rawDecodedUtf16Hex": "90235728901988E14E5F548C54E554E557284E008D7720262026000A621169755EA64E0D6EFF300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "是正義社的人呢。\n真想看看大家的超級進化！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 404,
      "rawDecodedUtf16Hex": "662F6B637FA9793E76844EBA54623002000A771F60F3770B770B59275BB676848D857D1A90325316FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "所以呢，<U+0010><U+0002>Ā<U+0000>，\n我們大家來場2vs2的對戰吧！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 456,
      "rawDecodedUtf16Hex": "62404EE55462FF0C0010000201000000FF0C000A6211501159275BB64F865834003200760073003276845C0D62305427FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "來對戰吧！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "4F865C0D62305427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "請等一下",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "8ACB7B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>，\n現在需要的是配合度和衝勁啊。<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 540,
      "rawDecodedUtf16Hex": "0010000201000000FF0C000A73FE5728970089817684662F914D54085EA6548C885D52C1554A300200100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "作為繼承者，\n我要了解所有的超級進化！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 592,
      "rawDecodedUtf16Hex": "4F5C70BA7E7C627F8005FF0C000A621189814E8689E36240670976848D857D1A90325316FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我也希望來場比試！<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "62114E5F5E0C671B4F8658346BD48A66FF0100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "……事情這樣發展，\n看來我無權拒絕。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 680,
      "rawDecodedUtf16Hex": "202620264E8B60C590196A23767C5C55FF0C000A770B4F86621171216B0A62D27D55300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "我想對戰！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "621160F35C0D6230FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "請等一下",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "8ACB7B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "有些經驗就只能藉由\n戰勝強大的對手來獲得。<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "67094E9B7D939A575C3153EA80FD85C97531000A623052DD5F37592776845C0D624B4F8673725F97300200100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "力，即是力量！！<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 804,
      "rawDecodedUtf16Hex": "529BFF0C5373662F529B91CFFF01FF0100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳意外地優柔寡斷？<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B3610F59165730512A67D45BE165B7FF1F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "力，即是正義！！<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "529BFF0C5373662F6B637FA9FF01FF0100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "密阿雷這個地方，連異次元密阿雷\n都有各種超級進化，真是太棒了。<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "5BC6963F96F79019500B573065B9FF0C902375706B2151435BC6963F96F7000A90FD670954047A2E8D857D1A90325316FF0C771F662F592A68D24E86300200100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 972,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "列陣兵！用超級進化伸張正義，\n獲得勝利吧！<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "521796635175FF0175288D857D1A903253164F385F356B637FA9FF0C000A73725F9752DD52295427FF0100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "水晶燈火靈……\n用超級進化打敗他們。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "6C34667671C8706B974820262026000A75288D857D1A90325316625365574ED65011300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "燃燒吧，我的生命！！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1084,
      "rawDecodedUtf16Hex": "71C371D25427FF0C62117684751F547DFF01FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "超級列陣兵和\n超級水晶燈火靈都好厲害！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "8D857D1A521796635175548C000A8D857D1A6C34667671C8706B974890FD597D53B25BB3FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我本來以為用超級進化的力量，\n就能夠粉碎對手。<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "6211672C4F864EE570BA75288D857D1A903253167684529B91CFFF0C000A5C3180FD59207C89788E5C0D624B300200100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "皙白，超級進化後的寶可夢\n的確變得更強而有力了。<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "7699767DFF0C8D857D1A903253165F8C76845BF653EF5922000A768478BA8B8A5F9766F45F37800C6709529B4E86300200100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "但為了將每一隻寶可夢的個性\n發揮得更加淋漓盡致，<U+0010><U+0001>븀\n訓練家本身也必須了解超級進化。<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1292,
      "rawDecodedUtf16Hex": "4F4670BA4E865C076BCF4E0096BB5BF653EF59227684500B6027000A767C63EE5F9766F452A06DCB6F1376E181F4FF0C00100001BE00000A8A137DF45BB6672C8EAB4E5F5FC598084E8689E38D857D1A90325316300200100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "是！\n我會更加精進的。<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "662FFF01000A6211670366F452A07CBE90327684300200100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "皙白這麼聽話，\n可爾妮一定是個厲害的人。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1420,
      "rawDecodedUtf16Hex": "7699767D90199EBC807D8A71FF0C000A53EF723E59AE4E005B9A662F500B53B25BB376844EBA300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "我非常感動。\n請妳一定要收下這個服裝。<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1472,
      "rawDecodedUtf16Hex": "6211975E5E38611F52D53002000A8ACB59B34E005B9A898165364E0B9019500B670D88DD300200100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "謝謝！\n但是我好像已經分飾多角了？<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1520,
      "rawDecodedUtf16Hex": "8B1D8B1DFF01000A4F46662F6211597D50CF5DF27D93520698FE591A89D24E86FF1F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "我是娑羅市道館的館主，\n也是超級進化的繼承者，<U+0010><U+0001>븀\n現在還是超Z隊的成員之一。<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "6211662F5A117F855E0290539928768499284E3BFF0C000A4E5F662F8D857D1A9032531676847E7C627F8005FF0C00100001BE00000A73FE57289084662F8D85005A968A7684621054E14E4B4E00300200100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "我都已經脫下滑輪鞋了，\n要是穿上正義社的衣服，<U+0010><U+0001>븀\n好像有點讓人混亂。<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1656,
      "rawDecodedUtf16Hex": "621190FD5DF27D93812B4E0B6ED18F2A978B4E86FF0C000A8981662F7A7F4E0A6B637FA9793E76848863670DFF0C00100001BE00000A597D50CF67099EDE8B934EBA6DF74E82300200100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "我知道了。\n那麼，這個服裝給<U+0010><U+0002>Ā<U+0000>。<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1740,
      "rawDecodedUtf16Hex": "621177E590534E863002000A90A39EBCFF0C9019500B670D88DD7D660010000201000000300200100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>獲得了\n皙白裝扮道服組合！",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 1788,
      "rawDecodedUtf16Hex": "001000020100000073725F974E86000A7699767D88DD626E9053670D7D445408FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "皙白，你真失禮。<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 1824,
      "rawDecodedUtf16Hex": "7699767DFF0C4F60771F593179AE300200100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "我會讓身為訓練家的自己\n超級進化的。<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 1852,
      "rawDecodedUtf16Hex": "621167038B938EAB70BA8A137DF45BB6768481EA5DF1000A8D857D1A903253167684300200100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "這裡是……\n不存在於世上的地方？<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 1900,
      "rawDecodedUtf16Hex": "901988E1662F20262026000A4E0D5B58572865BC4E164E0A7684573065B9FF1F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "過度強大的力量或許會伴隨著痛楚……<U+0010><U+0001>븁\n要克服這個困難，需要的正是\n寶可夢和訓練家之間的牽絆！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "904E5EA65F3759277684529B91CF62168A3167034F3496A8845775DB695A2026202600100001BE01000A8981514B670D9019500B56F096E3FF0C9700898176846B63662F000A5BF653EF5922548C8A137DF45BB64E4B95937684727D7D46FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
