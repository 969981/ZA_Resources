      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Lascia che rimetta in sesto la tua squadra.\nD’altronde è la mia specialità!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Che ne dici di una bella\ntazza di caffè? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1292,
      "rawDecodedUtf16Hex": "0043006800650020006E00650020006400690063006900200064006900200075006E0061002000620065006C006C0061000A00740061007A007A00610020006400690020006300610066006600E8003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Prego, una tazza del mio caffè più pregiato per\nrimettere in sesto la tua squadra.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Qualcuno vuole del caffè? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "005100750061006C00630075006E006F002000760075006F006C0065002000640065006C0020006300610066006600E8003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Abbiamo messo a punto una miscela perfetta per\ni Pokémon. Li farà sentire come nuovi, vedrai.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1656,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Vuoi assaggiare la famosa miscela\ndel Caffè Nouveau? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "00560075006F0069002000610073007300610067006700690061007200650020006C0061002000660061006D006F007300610020006D0069007300630065006C0061000A00640065006C0020004300610066006600E80020004E006F00750076006500610075003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Basta un sorso della nostra famosa tostatura\nFuocobomba per far riprendere la tua squadra.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Vuoi provare la famosa miscela\ndel Caffè Nouveau? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2164,
      "rawDecodedUtf16Hex": "00560075006F0069002000700072006F00760061007200650020006C0061002000660061006D006F007300610020006D0069007300630065006C0061000A00640065006C0020004300610066006600E80020004E006F00750076006500610075003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "La nostra specialissima tostatura Ultima Fiamma\npuò persino rimettere in sesto la tua squadra.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Sono disposto a darti\nuna carta bonus! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "0053006F006E006F00200064006900730070006F00730074006F00200061002000640061007200740069000A0075006E006100200063006100720074006100200062006F006E007500730021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Mi sento magnanimo. Ti offrirò una delle carte\nche ho ottenuto stasera!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "004D0069002000730065006E0074006F0020006D00610067006E0061006E0069006D006F002E0020005400690020006F0066006600720069007200F200200075006E0061002000640065006C006C0065002000630061007200740065000A00630068006500200068006F0020006F007400740065006E00750074006F0020007300740061007300650072006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Le monete premio... <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2740,
      "rawDecodedUtf16Hex": "004C00650020006D006F006E0065007400650020007000720065006D0069006F002E002E002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Tieni, ti regalo tutte le monete che ho raccolto.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2812,
      "rawDecodedUtf16Hex": "005400690065006E0069002C00200074006900200072006500670061006C006F0020007400750074007400650020006C00650020006D006F006E006500740065002000630068006500200068006F00200072006100630063006F006C0074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Le mie monete premio...? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2912,
      "rawDecodedUtf16Hex": "004C00650020006D006900650020006D006F006E0065007400650020007000720065006D0069006F002E002E002E003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Hai vinto... Prendi pure le mie monete!\nA raccoglierne altre si fa sempre in tempo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ti sei meritat<U+0010><U+0003>ᄀÿāoa le mie\nmonete premio! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3160,
      "rawDecodedUtf16Hex": "0054006900200073006500690020006D00650072006900740061007400100003110000FF0101006F00610020006C00650020006D00690065000A006D006F006E0065007400650020007000720065006D0069006F0021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Che queste monete siano la controprova della\ntua vittoria! Tienile da conto... Contengono tutto<U+0010><U+0001>븀\nl’amore della signorina Viola!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3280,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "Che c’è, vuoi per caso delle\nmonete premio? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3540,
      "rawDecodedUtf16Hex": "00430068006500200063201900E8002C002000760075006F006900200070006500720020006300610073006F002000640065006C006C0065000A006D006F006E0065007400650020007000720065006D0069006F003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Noi Magnati delle lotte di Luminopoli facciamo a\ngara per vedere chi riesce a ottenere più monete<U+0010><U+0001>븀\nin una notte. Ma per stavolta potrai avere le mie.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 152
    },
    {
      "displayText": "Hai ricevuto delle monete premio!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3964,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F002000640065006C006C00650020006D006F006E0065007400650020007000720065006D0069006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Hai ricevuto <U+0010><U+0003>ᔂ<U+0002><U+0000><U+0010><U+0002>＀<U+0008><U+0010><U+0002>ĉ<U+0002><U+0010><U+0002>＀<U+0000>!",
      "escapedControlUnits": 13,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 4032,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F00200010000315020002000000100002FF000008001000020109000200100002FF00000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Ti regalo delle bacche\ndimensionali! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4096,
      "rawDecodedUtf16Hex": "0054006900200072006500670061006C006F002000640065006C006C00650020006200610063006300680065000A00640069006D0065006E00730069006F006E0061006C00690021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ti regalo <U+0010><U+0003>ᔂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002> che ho\nraccolto in questa Luminopoli dimensionale!",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4200,
      "rawDecodedUtf16Hex": "0054006900200072006500670061006C006F0020001000031502000200000010000201090002002000630068006500200068006F000A0072006100630063006F006C0074006F00200069006E00200071007500650073007400610020004C0075006D0069006E006F0070006F006C0069002000640069006D0065006E00730069006F006E0061006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Vuoi delle bacche\ndimensionali? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4344,
      "rawDecodedUtf16Hex": "00560075006F0069002000640065006C006C00650020006200610063006300680065000A00640069006D0065006E00730069006F006E0061006C0069003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ti regalo <U+0010><U+0003>ᔂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002>, in onore\ndella tua forza!",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4440,
      "rawDecodedUtf16Hex": "00100002BD0600000054006900200072006500670061006C006F0020001000031502000200000010000201090002002C00200069006E0020006F006E006F00720065000A00640065006C006C0061002000740075006100200066006F0072007A006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Rimetto in sesto\ni<U+0010><U+0003>ᄁýԅl tuo tuoi Pokémon? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
