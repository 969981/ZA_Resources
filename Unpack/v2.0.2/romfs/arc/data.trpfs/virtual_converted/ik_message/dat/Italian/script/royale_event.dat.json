      "rawDecodedUtf16Hex": "00520069006D006500740074006F00200069006E00200073006500730074006F000A006900100003110100FD0505006C002000740075006F002000740075006F006900200050006F006B00E9006D006F006E003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Rimettiamo in sesto i tuoi Pokémon anche nelle\nmisteriose Luminopoli dimensionali!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Gradisci un caffè\ndimensionale? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4828,
      "rawDecodedUtf16Hex": "0047007200610064006900730063006900200075006E0020006300610066006600E8000A00640069006D0065006E00730069006F006E0061006C0065003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Anche in questo misterioso posto bere caffè\nrimette in sesto i tuoi Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 4924,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Un caffè? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 5080,
      "rawDecodedUtf16Hex": "0055006E0020006300610066006600E8003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "È una miscela dimensionale. Berla rimette\nin sesto i Pokémon, per qualche motivo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 5132,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Prova la famosa miscela\ndel Caffè Nouveau! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5296,
      "rawDecodedUtf16Hex": "00500072006F007600610020006C0061002000660061006D006F007300610020006D0069007300630065006C0061000A00640065006C0020004300610066006600E80020004E006F007500760065006100750021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Non so perché mi trovo qui, ma so che la tostatura\nFuocobomba rimetterà in sesto la tua squadra.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Prova la famosa miscela\ndel Caffè Nouveau! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5608,
      "rawDecodedUtf16Hex": "00500072006F007600610020006C0061002000660061006D006F007300610020006D0069007300630065006C0061000A00640065006C0020004300610066006600E80020004E006F007500760065006100750021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Il nostro esclusivo caffè con tostatura Ultima\nFiamma è quel che ci vuole per rimettere in sesto<U+0010><U+0001>븀\ni Pokémon, anche nelle Luminopoli dimensionali.",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 5724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 148
    },
    {
      "displayText": "Al posto di una carta, ti darò\nuna vera chicca! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 6020,
      "rawDecodedUtf16Hex": "0041006C00200070006F00730074006F00200064006900200075006E0061002000630061007200740061002C002000740069002000640061007200F2000A0075006E00610020007600650072006100200063006800690063006300610021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Se permetti, <U+0010><U+0003>ᔀ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002> <U+0010><U+0003>ᄁ<U+0002>Ёèsono\ndi una rarità superspeciale!",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 6148,
      "rawDecodedUtf16Hex": "005300650020007000650072006D0065007400740069002C002000100003150000020000001000020109000200200010000311010002040100E80073006F006E006F000A0064006900200075006E006100200072006100720069007400E0002000730075007000650072007300700065006300690061006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Eccoti uno strumento\ndi estremo valore. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 6276,
      "rawDecodedUtf16Hex": "004500630063006F0074006900200075006E006F00200073007400720075006D0065006E0074006F000A00640069002000650073007400720065006D006F002000760061006C006F00720065002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "<U+0010><U+0003>ᔁ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002> <U+0010><U+0003>ᄁ<U+0002>Ёèsono preziosissim<U+0010><U+0004>ᄂ<U+0002>āāoaie,\nsì... ma tanto io ne ho parecchi<U+0010><U+0004>ᄂ<U+0002>āāieie.",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Ti regalo un vero tesoro. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6568,
      "rawDecodedUtf16Hex": "0054006900200072006500670061006C006F00200075006E0020007600650072006F0020007400650073006F0072006F002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "<U+0010><U+0003>ᔁ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002> acquisisc<U+0010><U+0003>ᄁ<U+0002>́eono ancora\npiù valore se sono io a possederl<U+0010><U+0004>ᄂ<U+0002>āāoaie!",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 6652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Ti faccio un regalo. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 6816,
      "rawDecodedUtf16Hex": "00540069002000660061006300630069006F00200075006E00200072006500670061006C006F002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Noi dei MLL delle Luminopoli dimensionali siamo\ngenerosi. Eccoti <U+0010><U+0003>ᔂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002>.",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 6888,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Lo vuoi un premio\nmeraviglioso? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 7040,
      "rawDecodedUtf16Hex": "004C006F002000760075006F006900200075006E0020007000720065006D0069006F000A006D006500720061007600690067006C0069006F0073006F003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ecco a te <U+0010><U+0003>ᔂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002>, insieme\na tutto l’amore della signorina Viola, capace<U+0010><U+0001>븀\npersino di oltrepassare le dimensioni.",
      "escapedControlUnits": 9,
      "flagsUpper16": 4,
      "index": 49,
      "offsetInSection": 7136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Sono un ologramma, ma ho\nlo stesso qualcosa per te. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 7372,
      "rawDecodedUtf16Hex": "0053006F006E006F00200075006E0020006F006C006F006700720061006D006D0061002C0020006D006100200068006F000A006C006F002000730074006500730073006F0020007100750061006C0063006F007300610020007000650072002000740065002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ricevere <U+0010><U+0003>ᔂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002> in un posto\ncosì misterioso e da un ologramma dev’essere<U+0010><U+0001>븀\nun’esperienza bizzarra.",
