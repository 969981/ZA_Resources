      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "果然厉害啊，\n对于投摔鬼的投技，我们束手无策。<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
