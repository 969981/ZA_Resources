      "offsetInSection": 2592,
      "rawDecodedUtf16Hex": "4E00672CFF0100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "获胜的是\n打击鬼部队的主将<U+0010><U+0002>Ā<U+0000>！<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 2608,
      "rawDecodedUtf16Hex": "83B780DC7684662F000A625351FB9B3C90E8961F76844E3B5C060010000201000000FF0100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "干得好！\n打击鬼有多棒得到证明了！<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
