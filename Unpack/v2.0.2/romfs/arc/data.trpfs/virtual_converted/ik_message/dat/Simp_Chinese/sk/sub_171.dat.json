      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "获胜的是\n投摔鬼部队的主将<U+0010><U+0002>Ā<U+0000>！<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
