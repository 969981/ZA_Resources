      "rawDecodedUtf16Hex": "00100002BDFF002F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "一本！<U+0010><U+0002>Ĕ<U+0011>",
