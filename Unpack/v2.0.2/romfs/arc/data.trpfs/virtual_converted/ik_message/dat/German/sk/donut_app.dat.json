      "offsetInSection": 3500,
      "rawDecodedUtf16Hex": "0031003000300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Ausgewählte Donuts",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 3508,
