      "offsetInSection": 3704,
      "rawDecodedUtf16Hex": "004E002F00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Donut-Energie",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 3712,
      "rawDecodedUtf16Hex": "0044006F006E00750074002D0045006E006500720067006900650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>ȁ<U+0000>:<U+0010><U+0002>ȁ<U+0001>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 3740,
      "rawDecodedUtf16Hex": "0010000202010000003A00100002020100010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Du möchtest doch keinen Donut machen...?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 3760,
      "rawDecodedUtf16Hex": "004400750020006D00F600630068007400650073007400200064006F006300680020006B00650069006E0065006E00200044006F006E007500740020006D0061006300680065006E002E002E002E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Doch, weiter geht’s!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 82,
      "offsetInSection": 3844,
      "rawDecodedUtf16Hex": "0044006F00630068002C0020007700650069007400650072002000670065006800742019007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Sorry, hab meine Meinung geändert...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 3888,
      "rawDecodedUtf16Hex": "0053006F007200720079002C00200068006100620020006D00650069006E00650020004D00650069006E0075006E006700200067006500E4006E0064006500720074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Sehr wohl, kommt sofort! Ich lege direkt los!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 84,
      "offsetInSection": 3964,
      "rawDecodedUtf16Hex": "005300650068007200200077006F0068006C002C0020006B006F006D006D007400200073006F0066006F00720074002100200049006300680020006C00650067006500200064006900720065006B00740020006C006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Mit diesen Zutaten kann ich den gewünschten\nDonut leider nicht machen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 85,
      "offsetInSection": 4056,
      "rawDecodedUtf16Hex": "004D00690074002000640069006500730065006E0020005A00750074006100740065006E0020006B0061006E006E0020006900630068002000640065006E002000670065007700FC006E00730063006800740065006E000A0044006F006E007500740020006C006500690064006500720020006E00690063006800740020006D0061006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Ich mache dir ja liebend gerne Donuts, aber du\nhast doch gar keinen Platz mehr für welche!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 4200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Der ist ja wunderbar gelungen! Soll ich noch\neinen Donut machen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 87,
      "offsetInSection": 4384,
      "rawDecodedUtf16Hex": "00440065007200200069007300740020006A0061002000770075006E006400650072006200610072002000670065006C0075006E00670065006E002100200053006F006C006C00200069006300680020006E006F00630068000A00650069006E0065006E00200044006F006E007500740020006D0061006300680065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Mit reichlich Donuts kommt ihr mit der\nDimensionsforschung bestimmt gut voran!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 88,
      "offsetInSection": 4516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Ja, aber einen anderen Donut!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 89,
      "offsetInSection": 4676,
      "rawDecodedUtf16Hex": "004A0061002C00200061006200650072002000650069006E0065006E00200061006E0064006500720065006E00200044006F006E0075007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Ja, den gleichen Donut noch einmal!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 90,
      "offsetInSection": 4736,
      "rawDecodedUtf16Hex": "004A0061002C002000640065006E00200067006C00650069006300680065006E00200044006F006E007500740020006E006F00630068002000650069006E006D0061006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Nein danke.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 91,
      "offsetInSection": 4808,
      "rawDecodedUtf16Hex": "004E00650069006E002000640061006E006B0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Bitte such dir drei Beeren aus. Ganz egal, welche!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 92,
      "offsetInSection": 4832,
      "rawDecodedUtf16Hex": "0042006900740074006500200073007500630068002000640069007200200064007200650069002000420065006500720065006E0020006100750073002E002000470061006E007A0020006500670061006C002C002000770065006C00630068006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Willkommen bei Antjas Donutladen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 93,
      "offsetInSection": 4936,
      "rawDecodedUtf16Hex": "00570069006C006C006B006F006D006D0065006E002000620065006900200041006E0074006A0061007300200044006F006E00750074006C006100640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Lass uns Donuts machen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 94,
      "offsetInSection": 5004,
      "rawDecodedUtf16Hex": "004C00610073007300200075006E007300200044006F006E0075007400730020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Ich möchte den Alptraum-Donut machen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 95,
      "offsetInSection": 5052,
      "rawDecodedUtf16Hex": "0049006300680020006D00F60063006800740065002000640065006E00200041006C00700074007200610075006D002D0044006F006E007500740020006D0061006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Ich möchte den Alpha-Donut machen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 96,
      "offsetInSection": 5128,
      "rawDecodedUtf16Hex": "0049006300680020006D00F60063006800740065002000640065006E00200041006C007000680061002D0044006F006E007500740020006D0061006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Ich möchte den Omega-Donut machen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 97,
      "offsetInSection": 5200,
      "rawDecodedUtf16Hex": "0049006300680020006D00F60063006800740065002000640065006E0020004F006D006500670061002D0044006F006E007500740020006D0061006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Ich möchte den Delta-Donut machen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 98,
      "offsetInSection": 5272,
      "rawDecodedUtf16Hex": "0049006300680020006D00F60063006800740065002000640065006E002000440065006C00740061002D0044006F006E007500740020006D0061006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Ich möchte den Plasma-Donut machen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 99,
      "offsetInSection": 5344,
      "rawDecodedUtf16Hex": "0049006300680020006D00F60063006800740065002000640065006E00200050006C00610073006D0061002D0044006F006E007500740020006D0061006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Eigentlich will ich gar nichts.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 100,
      "offsetInSection": 5416,
      "rawDecodedUtf16Hex": "0045006900670065006E0074006C006900630068002000770069006C006C002000690063006800200067006100720020006E00690063006800740073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Um einen Donut zu machen, brauchst du\nmindestens drei Beeren!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 101,
      "offsetInSection": 5480,
      "rawDecodedUtf16Hex": "0055006D002000650069006E0065006E00200044006F006E007500740020007A00750020006D0061006300680065006E002C002000620072006100750063006800730074002000640075000A006D0069006E00640065007300740065006E007300200064007200650069002000420065006500720065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Dann will ich mal die Superbutter verwenden,\ndie du mir mitgebracht hast!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 102,
      "offsetInSection": 5604,
      "rawDecodedUtf16Hex": "00440061006E006E002000770069006C006C00200069006300680020006D0061006C0020006400690065002000530075007000650072006200750074007400650072002000760065007200770065006E00640065006E002C000A0064006900650020006400750020006D006900720020006D00690074006700650062007200610063006800740020006800610073007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Ab jetzt kannst du bis zu vier Beeren nutzen,\num Donuts zu machen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 103,
      "offsetInSection": 5752,
      "rawDecodedUtf16Hex": "004100620020006A00650074007A00740020006B0061006E006E0073007400200064007500200062006900730020007A007500200076006900650072002000420065006500720065006E0020006E00750074007A0065006E002C000A0075006D00200044006F006E0075007400730020007A00750020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Dann will ich mal die Hyperbutter verwenden,\ndie du mir mitgebracht hast!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 104,
      "offsetInSection": 5888,
      "rawDecodedUtf16Hex": "00440061006E006E002000770069006C006C00200069006300680020006D0061006C0020006400690065002000480079007000650072006200750074007400650072002000760065007200770065006E00640065006E002C000A0064006900650020006400750020006D006900720020006D00690074006700650062007200610063006800740020006800610073007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Ab jetzt kannst du bis zu fünf Beeren nutzen,\num Donuts zu machen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 105,
      "offsetInSection": 6036,
      "rawDecodedUtf16Hex": "004100620020006A00650074007A00740020006B0061006E006E0073007400200064007500200062006900730020007A00750020006600FC006E0066002000420065006500720065006E0020006E00750074007A0065006E002C000A0075006D00200044006F006E0075007400730020007A00750020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Dann will ich mal die Ultrabutter verwenden,\ndie du mir mitgebracht hast!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 106,
      "offsetInSection": 6172,
      "rawDecodedUtf16Hex": "00440061006E006E002000770069006C006C00200069006300680020006D0061006C002000640069006500200055006C007400720061006200750074007400650072002000760065007200770065006E00640065006E002C000A0064006900650020006400750020006D006900720020006D00690074006700650062007200610063006800740020006800610073007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Ab jetzt kannst du bis zu sechs Beeren nutzen,\num Donuts zu machen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 107,
      "offsetInSection": 6320,
      "rawDecodedUtf16Hex": "004100620020006A00650074007A00740020006B0061006E006E0073007400200064007500200062006900730020007A0075002000730065006300680073002000420065006500720065006E0020006E00750074007A0065006E002C000A0075006D00200044006F006E0075007400730020007A00750020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Dann will ich mal die Meisterbutter verwenden,\ndie du mir mitgebracht hast!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 108,
      "offsetInSection": 6456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Ab jetzt kannst du bis zu sieben Beeren nutzen,\num Donuts zu machen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 109,
      "offsetInSection": 6608,
      "rawDecodedUtf16Hex": "004100620020006A00650074007A00740020006B0061006E006E0073007400200064007500200062006900730020007A0075002000730069006500620065006E002000420065006500720065006E0020006E00750074007A0065006E002C000A0075006D00200044006F006E0075007400730020007A00750020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Dann will ich mal die Dimensionsbutter\nverwenden, die du mir mitgebracht hast!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 110,
      "offsetInSection": 6748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Ab jetzt kannst du bis zu acht Beeren nutzen,\num Donuts zu machen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 111,
      "offsetInSection": 6908,
      "rawDecodedUtf16Hex": "004100620020006A00650074007A00740020006B0061006E006E0073007400200064007500200062006900730020007A007500200061006300680074002000420065006500720065006E0020006E00750074007A0065006E002C000A0075006D00200044006F006E0075007400730020007A00750020006D0061006300680065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Sieh auf der Karte nach, wo sich Verzerrungen\nbefinden, und erforsche das Dimensions-Illumina.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 112,
      "offsetInSection": 7044,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Du hast keine Donuts, die du Hoopa geben\nkannst!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 113,
      "offsetInSection": 7236,
      "rawDecodedUtf16Hex": "00440075002000680061007300740020006B00650069006E006500200044006F006E007500740073002C002000640069006500200064007500200048006F006F0070006100200067006500620065006E000A006B0061006E006E0073007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    }
