      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 3548,
      "rawDecodedUtf16Hex": "0047006500730061006D0074003A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>Ȃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 3564,
      "rawDecodedUtf16Hex": "00100002020200000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Donutfach",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 3576,
      "rawDecodedUtf16Hex": "0044006F006E0075007400660061006300680000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Dieser Donut hat keine Geschmackskräfte.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 3596,
      "rawDecodedUtf16Hex": "00440069006500730065007200200044006F006E0075007400200068006100740020006B00650069006E0065002000470065007300630068006D00610063006B0073006B007200E4006600740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "N/A",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 3680,
      "rawDecodedUtf16Hex": "004E002F00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "N/A",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "004E002F00410000",
