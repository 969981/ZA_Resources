  "messages": [
    {
      "displayText": "Wenn du fällst, versuch’s erneut!\nAufs Gleichgewicht kommt’s an!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "00570065006E006E0020006400750020006600E4006C006C00730074002C0020007600650072007300750063006820190073002000650072006E0065007500740021000A004100750066007300200047006C006500690063006800670065007700690063006800740020006B006F006D006D00742019007300200061006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Was für eine\nBalance!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "0057006100730020006600FC0072002000650069006E0065000A00420061006C0061006E0063006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Hier wird’s knifflig!\nTrau dich und spring!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 524,
      "rawDecodedUtf16Hex": "004800690065007200200077006900720064201900730020006B006E006900660066006C006900670021000A00540072006100750020006400690063006800200075006E006400200073007000720069006E006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Tolle Landung! Ich hätte\nsie live übertragen sollen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "0054006F006C006C00650020004C0061006E00640075006E0067002100200049006300680020006800E4007400740065000A0073006900650020006C006900760065002000FC00620065007200740072006100670065006E00200073006F006C006C0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Diese Geschicklichkeit...\nIch bin sprachlos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "0044006900650073006500200047006500730063006800690063006B006C006900630068006B006500690074002E002E002E000A004900630068002000620069006E0020007300700072006100630068006C006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Los, <U+0010><U+0002>Ā<U+0000>!\nGib alles!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 812,
      "rawDecodedUtf16Hex": "004C006F0073002C002000100002010000000021000A00470069006200200061006C006C0065007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Jetzt bloß nicht\nunachtsam werden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "004A00650074007A007400200062006C006F00DF0020006E0069006300680074000A0075006E006100630068007400730061006D002000770065007200640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Oh, schade! Das ist\neine Sackgasse!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "004F0068002C0020007300630068006100640065002100200044006100730020006900730074000A00650069006E00650020005300610063006B0067006100730073006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Oh, schade! Du musst\nwieder zurück.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "004F0068002C002000730063006800610064006500210020004400750020006D0075007300730074000A0077006900650064006500720020007A0075007200FC0063006B002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Bleib konzentriert! Du bist\nIllumina Citys einzige Hoffnung!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "0042006C0065006900620020006B006F006E007A0065006E007400720069006500720074002100200044007500200062006900730074000A0049006C006C0075006D0069006E0061002000430069007400790073002000650069006E007A00690067006500200048006F00660066006E0075006E006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Du bist schon weit gekommen.\nMach weiter so!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "00440075002000620069007300740020007300630068006F006E00200077006500690074002000670065006B006F006D006D0065006E002E000A004D006100630068002000770065006900740065007200200073006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Spring!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1288,
      "rawDecodedUtf16Hex": "0053007000720069006E006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Geschafft! Applaus\nfür <U+0010><U+0002>Ā<U+0000>!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1304,
      "rawDecodedUtf16Hex": "00470065007300630068006100660066007400210020004100700070006C006100750073000A006600FC00720020001000020100000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Ab hier gibt’s nur noch eine\nRichtung: nach oben!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "004100620020006800690065007200200067006900620074201900730020006E007500720020006E006F00630068002000650069006E0065000A005200690063006800740075006E0067003A0020006E0061006300680020006F00620065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Hier entlang!\nFolge mir!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1464,
      "rawDecodedUtf16Hex": "004800690065007200200065006E0074006C0061006E00670021000A0046006F006C006700650020006D0069007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Wir müssen über\ndie Brücke da vorn.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "0057006900720020006D00FC007300730065006E002000FC006200650072000A00640069006500200042007200FC0063006B006500200064006100200076006F0072006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Mit Ange ist irgendwas faul!\nUns bleibt nicht viel Zeit!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "004D0069007400200041006E00670065002000690073007400200069007200670065006E00640077006100730020006600610075006C0021000A0055006E007300200062006C00650069006200740020006E00690063006800740020007600690065006C0020005A00650069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Irgendwas stimmt nicht mit Ange!\nUns bleibt nicht viel Zeit!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "0049007200670065006E00640077006100730020007300740069006D006D00740020006E00690063006800740020006D0069007400200041006E006700650021000A0055006E007300200062006C00650069006200740020006E00690063006800740020007600690065006C0020005A00650069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Mach dir keine Sorgen um mich.\nFloette ist ja bei mir.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1828,
