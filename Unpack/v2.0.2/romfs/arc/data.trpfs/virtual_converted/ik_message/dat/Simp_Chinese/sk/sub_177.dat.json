  "initialKey": 0,
  "messages": [
    {
      "displayText": "喂！超Z队的。<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "5582FF018D85005A961F76843002001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "快来协助我一起帮别人的忙呀。\n你当然会说“好”的对吧？<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "5FEB6765534F52A962114E008D775E2E522B4EBA76845FD954403002000A4F605F5371364F1A8BF4201C597D201D76845BF95427FF1F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "好！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "597DFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "好……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "597D202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "很好。<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "5F88597D3002001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "其实是我听见那边的\n下水道里传出了惨叫声。<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "51765B9E662F6211542C89C190A38FB97684000A4E0B6C34905391CC4F2051FA4E8660E853EB58F03002001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "我必须得进去调查一下，\n但又听说下水道里<U+0010><U+0001>븀\n有可怕的幽灵属性宝可梦……<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "62115FC5987B5F978FDB53BB8C0367E54E004E0BFF0C000A4F4653C8542C8BF44E0B6C34905391CC00100001BE00000A670953EF601576845E7D70755C5E60275B9D53EF68A620262026001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "所以就想请你这个乌羽先生\n认可的人来稍微帮个忙。<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 844,
      "rawDecodedUtf16Hex": "62404EE55C3160F38BF74F608FD94E2A4E4C7FBD5148751F000A8BA453EF76844EBA67657A0D5FAE5E2E4E2A5FD93002001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "事先说清楚，我可不是在害怕！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 904,
      "rawDecodedUtf16Hex": "4E8B51488BF46E05695AFF0C621153EF4E0D662F57285BB36015FF01001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "你这家伙不是强得很吗？那就别\n唧唧歪歪的，快来帮我为城市做贡献！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "4F608FD95BB64F194E0D662F5F3A5F975F885417FF1F90A35C31522B000A552755276B6A6B6A7684FF0C5FEB67655E2E62114E3A57CE5E02505A8D21732EFF01001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1020,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "要来调查下水道里面喽！\n你走前面吧。<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "898167658C0367E54E0B6C34905391CC976255BDFF01000A4F608D70524D976254273002001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "我可不是在害怕！\n让比较强的家伙打头阵比较好吧！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1080,
      "rawDecodedUtf16Hex": "621153EF4E0D662F57285BB36015FF01000A8BA96BD48F835F3A76845BB64F196253593496356BD48F83597D5427FF01001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "嗯，\n感觉没什么问题……<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1140,
      "rawDecodedUtf16Hex": "55EFFF0C000A611F89C96CA14EC04E4895EE989820262026001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "嗯？那是……<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "55EFFF1F90A3662F20262026001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "呜噫咿咿咿咿！！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "545C566B54BF54BF54BF54BFFF01FF01001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "看来这群宝可梦应该是在睡觉……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "770B67658FD97FA45B9D53EF68A65E948BE5662F5728776189C9202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "我在恐怖故事里听说过……\n那是叫做迭失棺的宝可梦。<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "621157286050601665454E8B91CC542C8BF48FC720262026000A90A3662F53EB505A8FED593168FA76845B9D53EF68A63002001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "好像据说它会把人类\n关进它的身体里……<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1320,
      "rawDecodedUtf16Hex": "597D50CF636E8BF45B834F1A628A4EBA7C7B000A51738FDB5B8376848EAB4F5391CC20262026001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "总、总之赶快发起攻击，\n把它们赶走吧！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "603B3001603B4E4B8D765FEB53D18D77653B51FBFF0C000A628A5B834EEC8D768D705427FF01001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "总之快给我去调查下水道！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "603B4E4B5FEB7ED9621153BB8C0367E54E0B6C349053FF01001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
