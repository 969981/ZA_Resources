      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "但<U+0010><U+0003>ᄀÿā你妳必須只靠特定的1隻寶可夢，\n來戰勝3隻寶可夢。<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 744,
