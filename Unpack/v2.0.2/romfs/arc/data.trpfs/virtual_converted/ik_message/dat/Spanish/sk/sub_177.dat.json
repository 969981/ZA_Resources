      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "¡Aaah!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2200,
      "rawDecodedUtf16Hex": "00A100410061006100680021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Parece que estos Pokémon están dormidos...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "00500061007200650063006500200071007500650020006500730074006F007300200050006F006B00E9006D006F006E002000650073007400E1006E00200064006F0072006D00690064006F0073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Había oído unas historias que daban un miedo\nque para qué... Esos son Cofagrigus, ¿no?<U+0010><U+0002>Ĕ<U+001D>",
