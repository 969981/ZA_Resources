      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Venga, ¡dales lo suyo! Haz que expulsen a\nla persona que tienen encerrada.<U+0010><U+0002>Ĕ<U+001D>",
