      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Yo diría que en su interior tienen encerrado\na alguien...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2496,
