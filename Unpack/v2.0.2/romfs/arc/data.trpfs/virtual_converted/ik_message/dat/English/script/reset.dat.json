      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 143
    },
    {
      "displayText": "If you want me to clear away any pesky history,\nbring me <U+0010><U+0003>Ȅ<U+0002>, Mega Shard<U+0010><U+0003>ᄁ<U+0002>Ās and say the word.",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
