      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "You want me to clear away one of your\nPokémon’s base points for <U+0010><U+0003>Ȅ<U+0002>, Mega Shard<U+0010><U+0003>ᄁ<U+0002>Ās?",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1004,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
