      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "準備好和我來場寶可夢對戰後，\n就請<U+0010><U+0003>ᄀÿā你妳和我搭話吧！<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 368,
      "rawDecodedUtf16Hex": "6E965099597D548C62114F8658345BF653EF59225C0D62305F8CFF0C000A5C318ACB00100003110000FF01014F6059B3548C6211642D8A715427FF01001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 440,
      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "看看我的鐵殼蛹們吧！\n<U+0010><U+0003>ᄀÿā你妳準備好要對戰了嗎？<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 452,
      "rawDecodedUtf16Hex": "770B770B6211768494356BBC86F950115427FF01000A00100003110000FF01014F6059B36E965099597D89815C0D62304E8655CEFF1F001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "準備好了！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "6E965099597D4E86FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "等一下喔",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "7B494E004E0B55940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我很想趕快給<U+0010><U+0003>ᄀÿā你妳看鐵殼蛹的說。<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 540,
      "rawDecodedUtf16Hex": "62115F8860F38D955FEB7D6600100003110000FF01014F6059B3770B94356BBC86F976848AAA3002001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "謝謝！<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 592,
      "rawDecodedUtf16Hex": "8B1D8B1DFF01001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
