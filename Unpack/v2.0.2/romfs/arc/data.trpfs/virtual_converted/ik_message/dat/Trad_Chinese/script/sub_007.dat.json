      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "鐵殼蛹……\n進化成大針蜂了。<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 780,
      "rawDecodedUtf16Hex": "94356BBC86F920262026000A903253166210592791DD87024E863002001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "這樣的話我就不是\n鐵殼蛹行家……<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 820,
