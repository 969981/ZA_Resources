  "messages": [
    {
      "displayText": "퀘이사의 경비 포켓몬 문제에 대해\n들어 보신 적 있으신가요?<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
