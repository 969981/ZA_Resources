      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "성격이 이래서야\n퀘이사의 현관을 맡기기는 힘들겠네요!<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
