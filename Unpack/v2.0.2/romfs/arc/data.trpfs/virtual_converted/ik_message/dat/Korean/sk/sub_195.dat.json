      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "감사합니다.\n그럼, 근처에 있는 배틀코트로 이동하시죠.<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
