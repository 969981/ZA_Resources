      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 9020,
      "rawDecodedUtf16Hex": "0048006D002E002000560065006F0020007100750065002000640065006300690064006900730074006500200068006100630065007200200071007500650020007400750020004300680061007200630061006400650074000A00650076006F006C007500630069006F006E0061007200610020006100200043006500720075006C0065006400670065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "¿Recuerdas nuestro primer duelo, el que libramos\ncuando aún eran Charcadet?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 9164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Recuerdo que te gané",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 9316,
      "rawDecodedUtf16Hex": "0052006500630075006500720064006F0020007100750065002000740065002000670061006E00E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Recuerdo que ganaste",
