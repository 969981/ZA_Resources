      "offsetInSection": 9480,
      "rawDecodedUtf16Hex": "00540061006C002000760065007A002E002E002E0020007000650072006F0020006500730074006F0079002000730065006700750072006F002000640065002000710075006500200068006100730020006D0065006A006F007200610064006F000A0064006500730064006500200065006E0074006F006E006300650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
