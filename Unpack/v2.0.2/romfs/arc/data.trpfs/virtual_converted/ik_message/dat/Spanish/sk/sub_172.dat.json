      "index": 57,
      "offsetInSection": 8000,
      "rawDecodedUtf16Hex": "00100002BDFF00390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres librar el duelo final entre Armarouge\ny Ceruledge?<U+0010><U+0002>ĔǊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
