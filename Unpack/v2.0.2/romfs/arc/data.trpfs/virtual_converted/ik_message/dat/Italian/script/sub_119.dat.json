    },
    {
      "displayText": "È qui che hai avvertito qualcosa, Moko?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 53,
      "offsetInSection": 5132,
      "rawDecodedUtf16Hex": "00C8002000710075006900200063006800650020006800610069002000610076007600650072007400690074006F0020007100750061006C0063006F00730061002C0020004D006F006B006F003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "SPUUURR!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 54,
      "offsetInSection": 5220,
      "rawDecodedUtf16Hex": "005300500055005500550052005200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Ci sono tantissimi megacristalli... Anche troppi.\nNon è normale.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 5240,
      "rawDecodedUtf16Hex": "0043006900200073006F006E006F002000740061006E00740069007300730069006D00690020006D006500670061006300720069007300740061006C006C0069002E002E002E00200041006E006300680065002000740072006F007000700069002E000A004E006F006E002000E80020006E006F0072006D0061006C0065002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Puurrr!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5380,
      "rawDecodedUtf16Hex": "00500075007500720072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Dei Carbink...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5396,
      "rawDecodedUtf16Hex": "004400650069002000430061007200620069006E006B002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "E quell’altro che Pokémon è?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 5436,
      "rawDecodedUtf16Hex": "00450020007100750065006C006C20190061006C00740072006F002000630068006500200050006F006B00E9006D006F006E002000E8003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Forse è collegato alla tua Megapietra...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5504,
      "rawDecodedUtf16Hex": "0046006F007200730065002000E800200063006F006C006C0065006700610074006F00200061006C006C006100200074007500610020004D006500670061007000690065007400720061002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "SPUUURR!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 60,
      "offsetInSection": 5596,
      "rawDecodedUtf16Hex": "005300500055005500550052005200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Beh, non potremo sapere se c’è un collegamento\ncon la Megapietra finché non lo catturi!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Espurrr!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 62,
      "offsetInSection": 5800,
      "rawDecodedUtf16Hex": "004500730070007500720072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>뷿?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5820,
      "rawDecodedUtf16Hex": "00100002BDFF003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "DIAAAN!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 5832,
      "rawDecodedUtf16Hex": "00440049004100410041004E002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>뷿A",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 5852,
      "rawDecodedUtf16Hex": "00100002BDFF00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Devi catturarlo!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 5864,
      "rawDecodedUtf16Hex": "0044006500760069002000630061007400740075007200610072006C006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Devi catturarlo, non mandarlo KO!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 5908,
      "rawDecodedUtf16Hex": "0044006500760069002000630061007400740075007200610072006C006F002C0020006E006F006E0020006D0061006E006400610072006C006F0020004B004F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Ottimo lavoro, <U+0010><U+0002>Ā<U+0000>! Complimenti!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 68,
      "offsetInSection": 5984,
      "rawDecodedUtf16Hex": "004F007400740069006D006F0020006C00610076006F0072006F002C00200010000201000000002100200043006F006D0070006C0069006D0065006E00740069002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Senti, <U+0010><U+0002>Ā<U+0000>... Mi mostreresti\nquel Pokémon?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 6060,
      "rawDecodedUtf16Hex": "00530065006E00740069002C00200010000201000000002E002E002E0020004D00690020006D006F007300740072006500720065007300740069000A007100750065006C00200050006F006B00E9006D006F006E003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Com’è bello...!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 6156,
      "rawDecodedUtf16Hex": "0043006F006D201900E8002000620065006C006C006F002E002E002E002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Per come brilla mi ricorda un pochino\nla Meridiana di Fluxopoli!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 6196,
      "rawDecodedUtf16Hex": "00500065007200200063006F006D00650020006200720069006C006C00610020006D00690020007200690063006F00720064006100200075006E00200070006F006300680069006E006F000A006C00610020004D006500720069006400690061006E006100200064006900200046006C00750078006F0070006F006C0069002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "La meridiana?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 6336,
      "rawDecodedUtf16Hex": "004C00610020006D006500720069006400690061006E0061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Fluxopoli?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6364,
      "rawDecodedUtf16Hex": "0046006C00750078006F0070006F006C0069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Sì. Nella città di Fluxopoli c’è una misteriosa\nmeridiana. Si dice che abbia a che fare<U+0010><U+0001>븀\ncon le Megapietre.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 6388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Mi stanno tornando alla mente tante di quelle\ncose...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 6616,
      "rawDecodedUtf16Hex": "004D00690020007300740061006E006E006F00200074006F0072006E0061006E0064006F00200061006C006C00610020006D0065006E00740065002000740061006E007400650020006400690020007100750065006C006C0065000A0063006F00730065002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Sai, da quando Bellocchio è partito ho avuto\nmodo di conoscere un po’ di gente.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 6732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ad esempio il signor AZ e il Professor Platan.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 77,
      "offsetInSection": 6900,
      "rawDecodedUtf16Hex": "004100640020006500730065006D00700069006F00200069006C0020007300690067006E006F007200200041005A0020006500200069006C002000500072006F0066006500730073006F007200200050006C006100740061006E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Il Professore è specializzato nella megaevoluzione\ne ne discusse anche con il signor AZ.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 78,
      "offsetInSection": 7004,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "La sua idea era che le pietre che 3.000 anni fa\nfurono investite dalla luce dell’arma suprema...<U+0010><U+0001>븁\n... ovvero dal potere del Pokémon leggendario...\ndiventarono Megapietre.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 7192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 177
    },
    {
      "displayText": "Il signor AZ condivise questa teoria, aggiungendo\nche forse era per quello che di recente erano state<U+0010><U+0001>븀\nritrovate delle nuove tipologie di Megapietre.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 80,
      "offsetInSection": 7548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 156
    },
    {
      "displayText": "Perché l’arma suprema è stata usata di nuovo\ncinque anni fa...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 7860,
      "rawDecodedUtf16Hex": "0050006500720063006800E90020006C201900610072006D0061002000730075007000720065006D0061002000E80020007300740061007400610020007500730061007400610020006400690020006E0075006F0076006F000A00630069006E00710075006500200061006E006E0069002000660061002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Spuuurr...",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 82,
      "offsetInSection": 7996,
      "rawDecodedUtf16Hex": "0053007000750075007500720072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Non preoccuparti, Moko. Adesso ci siamo\n<U+0010><U+0002>Ā<U+0000> e io a Luminopoli!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 8020,
      "rawDecodedUtf16Hex": "004E006F006E0020007000720065006F00630063007500700061007200740069002C0020004D006F006B006F002E002000410064006500730073006F0020006300690020007300690061006D006F000A00100002010000000020006500200069006F002000610020004C0075006D0069006E006F0070006F006C0069002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Mi raccomando, <U+0010><U+0002>Ā<U+0000>.\nPrenditi cura anche di questo Pokémon.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 84,
      "offsetInSection": 8156,
      "rawDecodedUtf16Hex": "004D006900200072006100630063006F006D0061006E0064006F002C00200010000201000000002E000A005000720065006E00640069007400690020006300750072006100200061006E006300680065002000640069002000710075006500730074006F00200050006F006B00E9006D006F006E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Luminopoli ha bisogno di gente come te, in grado\ndi creare un legame con tanti Pokémon.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 85,
      "offsetInSection": 8284,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Bene, allora noi torniamo all’Agenzia Bellocchio.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 8468,
      "rawDecodedUtf16Hex": "00420065006E0065002C00200061006C006C006F007200610020006E006F006900200074006F0072006E00690061006D006F00200061006C006C2019004100670065006E007A00690061002000420065006C006C006F0063006300680069006F002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Ah, già! Il signor AZ ha accennato anche\na un’altra cosa.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 87,
      "offsetInSection": 8576,
      "rawDecodedUtf16Hex": "00410068002C00200067006900E0002100200049006C0020007300690067006E006F007200200041005A00200068006100200061006300630065006E006E00610074006F00200061006E006300680065000A006100200075006E20190061006C00740072006100200063006F00730061002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Ha detto che durante il suo lungo viaggio in cerca\ndi Floette, ha visto un fenomeno che potrebbe<U+0010><U+0001>븀\nessere considerato l’inizio della megaevoluzione!<U+0010><U+0001>븁\nSi trovava nella lontana regione di Hoenn.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 7,
      "flagsUpper16": 4,
      "index": 88,
      "offsetInSection": 8700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 200
    },
    {
      "displayText": "Dev’essere per questo che il signor AZ non ha mai\nsmesso di riflettere sui legami tra i Pokémon e<U+0010><U+0001>븀\nle persone.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 89,
      "offsetInSection": 9100,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Bene, ora ti saluto, <U+0010><U+0002>Ā<U+0000>.\nAl prossimo caso! Ciao!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 90,
      "offsetInSection": 9336,
      "rawDecodedUtf16Hex": "00420065006E0065002C0020006F00720061002000740069002000730061006C00750074006F002C00200010000201000000002E000A0041006C002000700072006F007300730069006D006F0020006300610073006F00210020004300690061006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    }
  ],
