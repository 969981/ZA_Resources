      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Già. Come sai, ora mi occupo io dell’agenzia, ma è\nstata fondata da Bellocchio, il mio predecessore.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
