      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "005300700075007500720072002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Forse Moko ha captato qualche messaggio\ncon la telepatia.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "0046006F0072007300650020004D006F006B006F0020006800610020006300610070007400610074006F0020007100750061006C0063006800650020006D0065007300730061006700670069006F000A0063006F006E0020006C0061002000740065006C006500700061007400690061002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Sai, Moko ha il potere di comunicare i pensieri\ndi una persona a qualcun altro.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Gli ho chiesto di non usarlo perché gli richiede\nmoltissime energie, ma a volte capta qualcosa<U+0010><U+0001>븀\ne si comporta così.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "Però la cosa mi incuriosisce...<U+0010><U+0001>븁\nChe Moko abbia captato un qualche pensiero\nintrappolato nella Diancite?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Forza, <U+0010><U+0002>Ā<U+0000>.\nAccompagniamo Moko e vediamo dove ci porta.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "0046006F0072007A0061002C00200010000201000000002E000A004100630063006F006D007000610067006E00690061006D006F0020004D006F006B006F00200065002000760065006400690061006D006F00200064006F0076006500200063006900200070006F007200740061002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1756,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sembra che abbia avvertito qualcosa.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1768,
      "rawDecodedUtf16Hex": "00530065006D0062007200610020006300680065002000610062006200690061002000610076007600650072007400690074006F0020007100750061006C0063006F00730061002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Aspetta un attimo...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1852,
      "rawDecodedUtf16Hex": "004100730070006500740074006100200075006E00200061007400740069006D006F002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Pronto, Fosca?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "00500072006F006E0074006F002C00200046006F007300630061003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Stiamo facendo delle indagini con Moko\ne potremmo aver bisogno del vostro aiuto.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 8,
      "index": 13,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "... Sì, dillo anche a Pilar ed Elvezio, per favore.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2116,
      "rawDecodedUtf16Hex": "002E002E002E0020005300EC002C002000640069006C006C006F00200061006E00630068006500200061002000500069006C0061007200200065006400200045006C00760065007A0069006F002C00200070006500720020006600610076006F00720065002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Scusami tanto, ho contattato anche alcuni amici\ndi vecchia data.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 8,
      "index": 15,
