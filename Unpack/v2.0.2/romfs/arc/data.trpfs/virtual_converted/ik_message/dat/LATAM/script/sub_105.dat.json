      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1172,
      "rawDecodedUtf16Hex": "00BF0050006F0064007200ED006100730020006100790075006400610072006D0065003F002000A10044006500730063006F006E00670065006C0061002000610020006D00690020004E0075006D0065006C002C000A0070006F00720020006600610076006F0072002100100002011401800000",
      "trailingZeroPaddingUnits": 1,
