      "rawDecodedUtf16Hex": "005300610075007600650067006100720064006500200065006E00200063006F007500720073002E002E002E000A0056006500750069006C006C0065007A002000700061007400690065006E007400650072002E0000",
      "trailingZeroPaddingUnits": 1,
