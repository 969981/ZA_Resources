    },
    {
      "displayText": "Sauvegarde en cours...\nNe pas éteindre la console.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "005300610075007600650067006100720064006500200065006E00200063006F007500720073002E002E002E000A004E00650020007000610073002000E9007400650069006E0064007200650020006C006100200063006F006E0073006F006C0065002E0000",
