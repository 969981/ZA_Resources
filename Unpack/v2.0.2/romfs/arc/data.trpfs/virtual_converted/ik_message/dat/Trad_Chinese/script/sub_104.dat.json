      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "這位訓練家，拜託<U+0010><U+0003>ᄀÿā你妳了。<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
