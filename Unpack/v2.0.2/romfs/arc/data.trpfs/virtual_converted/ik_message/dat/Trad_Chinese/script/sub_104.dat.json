      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "請<U+0010><U+0003>ᄀÿā你妳聽聽我們的請求。<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 668,
