      "rawDecodedUtf16Hex": "54CE5440FF1F770B4F8600100003110000FF01014F6059B3768476D25B506EFF4E86FF0C000A6C928FA66CD565364E0B72605462300200100001BE01000A90A35C3190199EBC8FA654273002000A6211670351485728901988E1770B8457901996BB7C89877686F97684300200100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
