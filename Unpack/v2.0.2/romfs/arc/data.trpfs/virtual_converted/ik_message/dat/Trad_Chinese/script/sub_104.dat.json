      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "62115011662F71B1611B7C89877686F976847C897D726A94300200100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "但我們的粉蝶蛹們\n在美術館裡面走散了……<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
