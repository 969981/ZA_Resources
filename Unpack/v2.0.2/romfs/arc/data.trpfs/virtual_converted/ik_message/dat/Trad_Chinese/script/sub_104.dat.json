      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "這位一看就是很優秀的訓練家，<U+0010><U+0003>ᄀÿā你妳好。<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 4,
