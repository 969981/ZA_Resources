      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "彩色隱形眼鏡的顏色選項\n追加了閃閃發光和深暗漆黑。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
