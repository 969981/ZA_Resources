      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "51456EFF4E869ED166975BF653EF592276846DF166976F069ED1611FFF0100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "密阿雷的彩色隱形眼鏡粉絲！\n我這就帶給你們全新的世界！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1312,
