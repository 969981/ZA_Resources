      "rawDecodedUtf16Hex": "621167035728770B904E00100003110000FF01014F6059B376848D857D1A52FE9B42773C4E4B5F8CFF0C000A52754F5C51FA65B06B3E768496B15F62773C93E17D6600100003110000FF01014F6059B3770B7684FF0100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0011>",
