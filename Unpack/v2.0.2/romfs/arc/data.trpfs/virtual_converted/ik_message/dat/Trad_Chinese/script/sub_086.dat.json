      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "52FE9B42773C7684773C775B95839583767C5149FF0100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "充滿了黑暗寶可夢的深暗漆黑感！<U+0010><U+0002>Ĕų",
