{
  "declaredLength": 10336,
  "decoding": "confirmed-per-slot-XOR-rotate3-index-seed",
  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Siempre y cuando tengas las bayas necesarias,\n¡puedo preparar los dónuts que quieras!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "La combinación de bayas es la clave de\nlos sabores tan especiales de mis dónuts.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "El agujero del dónut ayuda a que se fría de\nforma uniforme.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "0045006C0020006100670075006A00650072006F002000640065006C0020006400F3006E0075007400200061007900750064006100200061002000710075006500200073006500200066007200ED0061002000640065000A0066006F0072006D006100200075006E00690066006F0072006D0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Me pregunto cómo se verá el mundo a través del\nagujero de un dónut...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "004D0065002000700072006500670075006E0074006F0020006300F3006D006F002000730065002000760065007200E100200065006C0020006D0075006E0064006F002000610020007400720061007600E90073002000640065006C000A006100670075006A00650072006F00200064006500200075006E0020006400F3006E00750074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Me encanta amasar la masa de los dónuts.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "004D006500200065006E00630061006E0074006100200061006D00610073006100720020006C00610020006D0061007300610020006400650020006C006F00730020006400F3006E007500740073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "La textura de los dónuts cambia según dejes\nfermentar o no la masa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "004C0061002000740065007800740075007200610020006400650020006C006F00730020006400F3006E007500740073002000630061006D006200690061002000730065006700FA006E002000640065006A00650073000A006600650072006D0065006E0074006100720020006F0020006E006F0020006C00610020006D006100730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "¡Bienvenid<U+0010><U+0003>ᄀÿāoa a la tienda de dónuts de Anya\ndel Hotel Z!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "00A1004200690065006E00760065006E0069006400100003110000FF0101006F0061002000610020006C00610020007400690065006E006400610020006400650020006400F3006E00750074007300200064006500200041006E00790061000A00640065006C00200048006F00740065006C0020005A00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "¡Bienvenid<U+0010><U+0003>ᄀÿāoa a la tienda de dónuts de Anya,\nesencial para viajar a Luminalia Dimensional!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "¡Bienvenid<U+0010><U+0003>ᄀÿāoa a la tienda de dónuts de Anya, donde\npreparamos los dónuts favoritos de Hoopa!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Hoy me encuentro en plena forma. Puedo\npreparar cualquier dónut que quieras.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1900,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "¡Pase y siéntese! Je, je. Estoy probando a hacer\ncomo si esto fuera un restaurante de verdad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2056,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "¿Sabías que las malasadas de la región de Alola\nson una especie de dónut?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "00BF00530061006200ED0061007300200071007500650020006C006100730020006D0061006C0061007300610064006100730020006400650020006C00610020007200650067006900F3006E00200064006500200041006C006F006C0061000A0073006F006E00200075006E0061002000650073007000650063006900650020006400650020006400F3006E00750074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "¡Que el círculo de los dónuts se expanda\npor todo el mundo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2392,
      "rawDecodedUtf16Hex": "00A100510075006500200065006C0020006300ED007200630075006C006F0020006400650020006C006F00730020006400F3006E00750074007300200073006500200065007800700061006E00640061000A0070006F007200200074006F0064006F00200065006C0020006D0075006E0064006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "He preparado muchísimos dónuts, ¡pero no me\ncanso en absoluto! Seguiré preparando más.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Prepararé un dónut especial capaz de almacenar\nuna gran cantidad de megapoder.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "¡Ahora puedo emplear hasta cuatro bayas!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2848,
      "rawDecodedUtf16Hex": "00A100410068006F0072006100200070007500650064006F00200065006D0070006C006500610072002000680061007300740061002000630075006100740072006F00200062006100790061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "¡Ahora puedo emplear hasta cinco bayas!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2932,
      "rawDecodedUtf16Hex": "00A100410068006F0072006100200070007500650064006F00200065006D0070006C006500610072002000680061007300740061002000630069006E0063006F00200062006100790061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¡Ahora puedo emplear hasta seis bayas!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3012,
      "rawDecodedUtf16Hex": "00A100410068006F0072006100200070007500650064006F00200065006D0070006C0065006100720020006800610073007400610020007300650069007300200062006100790061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Ahora puedo emplear hasta siete bayas!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3092,
      "rawDecodedUtf16Hex": "00A100410068006F0072006100200070007500650064006F00200065006D0070006C00650061007200200068006100730074006100200073006900650074006500200062006100790061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¡Ahora puedo emplear hasta ocho bayas!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3172,
      "rawDecodedUtf16Hex": "00A100410068006F0072006100200070007500650064006F00200065006D0070006C0065006100720020006800610073007400610020006F00630068006F00200062006100790061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¿Qué sabor te apetece probar? ¿Picante? ¿Fresco?\n¿Dulce? ¿Amargo? ¿Agrio?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3252,
      "rawDecodedUtf16Hex": "00BF0051007500E90020007300610062006F007200200074006500200061007000650074006500630065002000700072006F006200610072003F002000BF0050006900630061006E00740065003F002000BF00460072006500730063006F003F000A00BF00440075006C00630065003F002000BF0041006D006100720067006F003F002000BF0041006700720069006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Voy a seguir preparando muchos dónuts para\nque puedas continuar con la investigación.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Voy a empezar a calentar la mantequilla para\nderretirla.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3572,
      "rawDecodedUtf16Hex": "0056006F00790020006100200065006D00700065007A0061007200200061002000630061006C0065006E0074006100720020006C00610020006D0061006E00740065007100750069006C006C006100200070006100720061000A00640065007200720065007400690072006C0061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Si me encargas muchos dónuts, no tendrás que\nregresar cada dos por tres al Hotel Z.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Tienes que prensar las bayas con cuidado para\nque la pasta quede uniforme y sin grumos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "¡Los dónuts de Ciudad Luminalia son excelentes!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 4032,
      "rawDecodedUtf16Hex": "00A1004C006F00730020006400F3006E00750074007300200064006500200043006900750064006100640020004C0075006D0069006E0061006C0069006100200073006F006E00200065007800630065006C0065006E00740065007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Con mis dónuts y el poder de Hoopa, ponemos\nnuestro granito de arena en la investigación.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Da con la combinación ideal de bayas para que\nsurtan el efecto deseado.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4308,
      "rawDecodedUtf16Hex": "0044006100200063006F006E0020006C006100200063006F006D00620069006E00610063006900F3006E00200069006400650061006C002000640065002000620061007900610073002000700061007200610020007100750065000A00730075007200740061006E00200065006C002000650066006500630074006F0020006400650073006500610064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Los dónuts están vacíos por el medio, pero te\ndejan bien lleno por dentro. ¡Qué paradoja!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "La verdad es que estas bayas dimensionales\nson de lo más curiosas y extrañas...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "No te olvides de la importancia del nivel extra.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4792,
      "rawDecodedUtf16Hex": "004E006F0020007400650020006F006C007600690064006500730020006400650020006C006100200069006D0070006F007200740061006E006300690061002000640065006C0020006E006900760065006C002000650078007400720061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Cuanto más aporte energético tenga un dónut,\nmás tiempo tendrás para investigar.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "¡Quiero preparar algún dónut que te permita\nencontrar Pokémon alfa con más facilidad!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 5056,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "¿A que estaría bien preparar dónuts que hagan\nmás fácil toparse con Pokémon variocolor?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 5228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Cuanto mayor sea el rango de sabor de un dónut,\nmás fuertes serán sus efectos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 5404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "¡A Hoopa le encantan los dónuts dulces!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5564,
      "rawDecodedUtf16Hex": "00A1004100200048006F006F007000610020006C006500200065006E00630061006E00740061006E0020006C006F00730020006400F3006E007500740073002000640075006C00630065007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Creo que los dónuts dulces les gustarían mucho\na los Pokémon variocolor.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5644,
      "rawDecodedUtf16Hex": "004300720065006F00200071007500650020006C006F00730020006400F3006E007500740073002000640075006C0063006500730020006C00650073002000670075007300740061007200ED0061006E0020006D007500630068006F000A00610020006C006F007300200050006F006B00E9006D006F006E00200076006100720069006F0063006F006C006F0072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Me parece que los dónuts dulces te pueden\nproporcionar suerte de cualquier clase.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Los dónuts de curri picante son algo que le\npegaría al Hotel Z, ¿no?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5956,
      "rawDecodedUtf16Hex": "004C006F00730020006400F3006E00750074007300200064006500200063007500720072006900200070006900630061006E0074006500200073006F006E00200061006C0067006F00200071007500650020006C0065000A0070006500670061007200ED006100200061006C00200048006F00740065006C0020005A002C002000BF006E006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Yo creo que el picante debe de subir la fuerza\nde los Pokémon al atacar.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 6096,
      "rawDecodedUtf16Hex": "0059006F0020006300720065006F002000710075006500200065006C00200070006900630061006E00740065002000640065006200650020006400650020007300750062006900720020006C006100200066007500650072007A0061000A006400650020006C006F007300200050006F006B00E9006D006F006E00200061006C0020006100740061006300610072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Un dónut picante seguramente dé ventajas\na la hora de atacar.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 6244,
      "rawDecodedUtf16Hex": "0055006E0020006400F3006E0075007400200070006900630061006E007400650020007300650067007500720061006D0065006E007400650020006400E9002000760065006E00740061006A00610073000A00610020006C006100200068006F007200610020006400650020006100740061006300610072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "A Hoopa también le gustan los dónuts que\ntienen un toque agrio.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 6368,
      "rawDecodedUtf16Hex": "004100200048006F006F00700061002000740061006D0062006900E9006E0020006C0065002000670075007300740061006E0020006C006F00730020006400F3006E0075007400730020007100750065000A007400690065006E0065006E00200075006E00200074006F00710075006500200061006700720069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Con un dónut que te facilitara conseguir bayas,\n¡podría preparar todavía más!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Diría que los dónuts agrios tienen efectos\nrelacionados con los objetos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6652,
      "rawDecodedUtf16Hex": "00440069007200ED006100200071007500650020006C006F00730020006400F3006E00750074007300200061006700720069006F00730020007400690065006E0065006E002000650066006500630074006F0073000A00720065006C006100630069006F006E00610064006F007300200063006F006E0020006C006F00730020006F0062006A00650074006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Aunque no lo parezca, a Hoopa también le gustan\nlos dónuts de sabor algo más amargo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 44,
      "offsetInSection": 6800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Estaría bien un dónut que redujera el daño que\nte hacen los movimientos de un tipo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 45,
      "offsetInSection": 6972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Creo que los dónuts amargos ayudan a los\nPokémon a defenderse.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 7140,
      "rawDecodedUtf16Hex": "004300720065006F00200071007500650020006C006F00730020006400F3006E00750074007300200061006D006100720067006F0073002000610079007500640061006E002000610020006C006F0073000A0050006F006B00E9006D006F006E0020006100200064006500660065006E00640065007200730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Los dónuts frescos estimulan las papilas\ngustativas de Hoopa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 7268,
      "rawDecodedUtf16Hex": "004C006F00730020006400F3006E007500740073002000660072006500730063006F007300200065007300740069006D0075006C0061006E0020006C0061007300200070006100700069006C00610073000A006700750073007400610074006900760061007300200064006500200048006F006F00700061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Si quieres capturar Pokémon con más facilidad,\nte recomendaría dónuts frescos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 7392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Parece que los dónuts frescos facilitan de alguna\nmanera la captura de Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 7552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Habrá que esperar hasta que haya preparado el\ndónut para saber qué efectos tendrá, ¡qué intriga!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 7712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Aquí está mi dónut más especial.\n¡Adelante con la operación megadónut!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 51,
      "offsetInSection": 7908,
      "rawDecodedUtf16Hex": "00410071007500ED002000650073007400E10020006D00690020006400F3006E007500740020006D00E1007300200065007300700065006300690061006C002E000A00A1004100640065006C0061006E0074006500200063006F006E0020006C00610020006F00700065007200610063006900F3006E0020006D006500670061006400F3006E0075007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Con todas estas bayas, prepararé un dónut que\nte permita enfrentarte a Groudon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 8052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Con la de bayas que le he echado a este dónut,\ntendrías que poder dar con Kyogre.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 8212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Estoy preparando este dónut con muchísimas\nbayas. Seguro que das con Rayquaza.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 54,
      "offsetInSection": 8376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "¡Creo que me va a salir un Glaseado de Plasma\nfantástico!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 8536,
      "rawDecodedUtf16Hex": "00A1004300720065006F00200071007500650020006D006500200076006100200061002000730061006C0069007200200075006E00200047006C00610073006500610064006F00200064006500200050006C00610073006D0061000A00660061006E007400E10073007400690063006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "¿Quieres preparar un dónut diferente y no sabes\nmuy bien qué ingredientes elegir?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 8652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Puedo preparar dónuts con cualquier\ncombinación de bayas que tengas.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 8816,
      "rawDecodedUtf16Hex": "0050007500650064006F0020007000720065007000610072006100720020006400F3006E00750074007300200063006F006E0020006300750061006C00710075006900650072000A0063006F006D00620069006E00610063006900F3006E0020006400650020006200610079006100730020007100750065002000740065006E006700610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "¿No sabes qué clase de dónut quieres?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 8956,
      "rawDecodedUtf16Hex": "00BF004E006F00200073006100620065007300200071007500E900200063006C0061007300650020006400650020006400F3006E0075007400200071007500690065007200650073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Si no consigues decidirte, ¡puedo freír muchos\ny asunto resuelto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 9032,
      "rawDecodedUtf16Hex": "005300690020006E006F00200063006F006E0073006900670075006500730020006400650063006900640069007200740065002C002000A10070007500650064006F002000660072006500ED00720020006D007500630068006F0073000A00790020006100730075006E0074006F002000720065007300750065006C0074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, ¡que te has quedado de piedra!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 9164,
      "rawDecodedUtf16Hex": "0010000201000000002C002000A100710075006500200074006500200068006100730020007100750065006400610064006F002000640065002000700069006500640072006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>Ā<U+0000>, ¿te has quedado mirando las\nmusarañas?",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 9240,
      "rawDecodedUtf16Hex": "00100002BD0600000010000201000000002C002000BF0074006500200068006100730020007100750065006400610064006F0020006D006900720061006E0064006F0020006C00610073000A006D0075007300610072006100F100610073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Para mí, preparar dónuts es repartir felicidad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 9340,
      "rawDecodedUtf16Hex": "00500061007200610020006D00ED002C0020007000720065007000610072006100720020006400F3006E007500740073002000650073002000720065007000610072007400690072002000660065006C006900630069006400610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Es muy importante preparar los dónuts con\nfundamento y con amor.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 63,
      "offsetInSection": 9436,
      "rawDecodedUtf16Hex": "004500730020006D0075007900200069006D0070006F007200740061006E007400650020007000720065007000610072006100720020006C006F00730020006400F3006E00750074007300200063006F006E000A00660075006E00640061006D0065006E0074006F0020007900200063006F006E00200061006D006F0072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "¡Me pienso esforzar para que los Pokémon se\nrelaman con los dónuts que preparo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 9568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Los gustos culinarios dicen mucho de cada uno.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 9728,
      "rawDecodedUtf16Hex": "004C006F007300200067007500730074006F0073002000630075006C0069006E006100720069006F007300200064006900630065006E0020006D007500630068006F0020006400650020006300610064006100200075006E006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "La alimentación es algo básico y fundamental\npara cualquier ser vivo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 9824,
      "rawDecodedUtf16Hex": "004C006100200061006C0069006D0065006E007400610063006900F3006E00200065007300200061006C0067006F0020006200E1007300690063006F00200079002000660075006E00640061006D0065006E00740061006C000A00700061007200610020006300750061006C0071007500690065007200200073006500720020007600690076006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Hay que tener conocimientos básicos para\ncocinar bien y que no te salga un churro.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 9964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Tómate el tiempo que quieras.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 10132,
      "rawDecodedUtf16Hex": "005400F3006D00610074006500200065006C0020007400690065006D0070006F002000710075006500200071007500690065007200610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Aprovecharé para descansar...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 69,
      "offsetInSection": 10192,
      "rawDecodedUtf16Hex": "004100700072006F00760065006300680061007200E900200070006100720061002000640065007300630061006E007300610072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "El cocinero al que más admiro es Narciso.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 70,
      "offsetInSection": 10252,
      "rawDecodedUtf16Hex": "0045006C00200063006F00630069006E00650072006F00200061006C00200071007500650020006D00E10073002000610064006D00690072006F0020006500730020004E00610072006300690073006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    }
  ],
