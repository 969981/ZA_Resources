      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5392,
      "rawDecodedUtf16Hex": "004E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Desideri affrontare il prossimo Pokémon?",
