      "offsetInSection": 5272,
      "rawDecodedUtf16Hex": "00C800200075006E0061002000730066006900640061002000700069007500740074006F00730074006F00200064007500720061002E00200049006E00740065006E006400690020006400610076007600650072006F000A00700072006F006300650064006500720065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
