      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 5384,
      "rawDecodedUtf16Hex": "005300EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
