      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "狗仔包在散步的时候\n有一条喜欢的路线。<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
