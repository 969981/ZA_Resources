      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "等你做好散步的准备\n就来和我说一声吧。<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
