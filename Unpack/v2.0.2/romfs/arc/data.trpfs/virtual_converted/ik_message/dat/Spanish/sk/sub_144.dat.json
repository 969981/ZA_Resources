      "index": 22,
      "offsetInSection": 2420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 151
    },
    {
      "displayText": "¡No sabes cuánto me alegro de haber venido\na Ciudad Luminalia y haberos conocido a todos!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
