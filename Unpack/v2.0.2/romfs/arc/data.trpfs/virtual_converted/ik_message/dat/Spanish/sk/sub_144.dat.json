      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Que nos echemos un combate épico!\nLucario contra Lucario, ¡a todo gas!<U+0010><U+0002>Ĕƒ",
