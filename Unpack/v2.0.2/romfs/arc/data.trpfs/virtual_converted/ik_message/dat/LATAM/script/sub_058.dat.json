      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "¡Oye, tú! ¡No te acerques al Holotransportador,\nque es peligroso!<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
