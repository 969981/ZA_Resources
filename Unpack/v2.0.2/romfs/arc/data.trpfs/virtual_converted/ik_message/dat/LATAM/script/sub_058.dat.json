      "index": 13,
      "offsetInSection": 1456,
      "rawDecodedUtf16Hex": "00A10044007500750075006D00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
