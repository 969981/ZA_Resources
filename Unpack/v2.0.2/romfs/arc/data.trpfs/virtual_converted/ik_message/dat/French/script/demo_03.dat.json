  "messages": [
    {
      "displayText": "Bienvenue à Illumis, la ville où les êtres humains\net les Pokémon vivent en harmonie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Je me nomme Bridjet, et je suis la présidente\nde la société Quazar.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "004A00650020006D00650020006E006F006D006D006500200042007200690064006A00650074002C0020006500740020006A0065002000730075006900730020006C006100200070007200E90073006900640065006E00740065000A006400650020006C006100200073006F0063006900E9007400E90020005100750061007A00610072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Les Pokémon sont des créatures aussi\nmerveilleuses que mystérieuses.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 456,
      "rawDecodedUtf16Hex": "004C0065007300200050006F006B00E9006D006F006E00200073006F006E0074002000640065007300200063007200E9006100740075007200650073002000610075007300730069000A006D00650072007600650069006C006C0065007500730065007300200071007500650020006D00790073007400E90072006900650075007300650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Ces êtres hors du commun peuplent\nabondamment le monde qui nous entoure.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 596,
      "rawDecodedUtf16Hex": "004300650073002000EA007400720065007300200068006F0072007300200064007500200063006F006D006D0075006E00200070006500750070006C0065006E0074000A00610062006F006E00640061006D006D0065006E00740020006C00650020006D006F006E0064006500200071007500690020006E006F0075007300200065006E0074006F007500720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Ils sont d’ailleurs de plus en plus nombreux\nà vivre près de nous, au sein même d’Illumis.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Afin de mieux cohabiter avec eux, nous leur avons\nalloué des espaces : les zones sauvages.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Vous le savez, les Pokémon possèdent\ndes pouvoirs uniques et fabuleux.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "0056006F007500730020006C006500200073006100760065007A002C0020006C0065007300200050006F006B00E9006D006F006E00200070006F0073007300E800640065006E0074000A00640065007300200070006F00750076006F00690072007300200075006E0069007100750065007300200065007400200066006100620075006C006500750078002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Il ne tient qu’à nous de travailler main dans la\nmain avec eux, pour vivre ensemble en harmonie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "C’est donc dans l’espoir de consolider\nnos liens avec les Pokémon...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "0043201900650073007400200064006F006E0063002000640061006E00730020006C2019006500730070006F0069007200200064006500200063006F006E0073006F006C0069006400650072000A006E006F00730020006C00690065006E0073002000610076006500630020006C0065007300200050006F006B00E9006D006F006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "... que la société Quazar a pris en charge\nle réaménagement d’Illumis.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "002E002E002E00200071007500650020006C006100200073006F0063006900E9007400E90020005100750061007A00610072002000610020007000720069007300200065006E0020006300680061007200670065000A006C00650020007200E90061006D00E9006E006100670065006D0065006E00740020006420190049006C006C0075006D00690073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Notre holotechnologie s’étend aux quatre\ncoins de la ville.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1772,
      "rawDecodedUtf16Hex": "004E006F00740072006500200068006F006C006F0074006500630068006E006F006C006F00670069006500200073201900E900740065006E006400200061007500780020007100750061007400720065000A0063006F0069006E00730020006400650020006C0061002000760069006C006C0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Elle vous fournit désormais diverses informations\nsous un style visuel unique.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Illumis était déjà superbe.\nNous allons la sublimer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "0049006C006C0075006D00690073002000E900740061006900740020006400E9006A00E000200073007500700065007200620065002E000A004E006F0075007300200061006C006C006F006E00730020006C00610020007300750062006C0069006D00650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Et pour cela, nous comptons sur votre patience\net votre soutien.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2160,
      "rawDecodedUtf16Hex": "0045007400200070006F00750072002000630065006C0061002C0020006E006F0075007300200063006F006D00700074006F006E0073002000730075007200200076006F007400720065002000700061007400690065006E00630065000A0065007400200076006F00740072006500200073006F0075007400690065006E002E0000",
      "trailingZeroPaddingUnits": 1,
