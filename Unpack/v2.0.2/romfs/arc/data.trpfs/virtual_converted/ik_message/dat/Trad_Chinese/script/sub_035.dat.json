      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "但是我就是喜歡\n波波、比比鳥、大比鳥！<U+0010><U+0002>Ĕń",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
