      "rawDecodedUtf16Hex": "004E0075006D0065006C0020006500730020006400650020007400690070006F00200046007500650067006F002C002000A1007000650072006F002000610075006E00200061007300ED0020006E006F002000730065000A0064006500730063006F006E00670065006C0061002100100002011401800000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "He probado con Antihielos y tampoco surten\nefecto...<U+0010><U+0001>븁\nLo único que se me ocurre es usar un movimiento\nde tipo Fuego muy abrasador para derretirlo.<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 4,
