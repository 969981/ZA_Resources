      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "B300B2E8D55C0020ADE0D6150020AC10AC01C774AD7000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "거기가 어려운 부분이네!\n큰맘 먹고 뛰어들게나!",
