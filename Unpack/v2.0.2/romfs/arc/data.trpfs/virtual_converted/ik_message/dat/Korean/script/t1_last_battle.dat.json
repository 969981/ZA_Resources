      "rawDecodedUtf16Hex": "C790002C002000100002010000000021000AC5F4C2ECD7880020D5740020BCF4AC8CB09800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "어이쿠, 방심은 금물이라네!",
