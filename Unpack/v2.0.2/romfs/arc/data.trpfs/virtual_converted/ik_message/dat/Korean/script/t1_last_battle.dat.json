      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "잘 착지했네!\n방송에 썼으면 딱이었겠군!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
