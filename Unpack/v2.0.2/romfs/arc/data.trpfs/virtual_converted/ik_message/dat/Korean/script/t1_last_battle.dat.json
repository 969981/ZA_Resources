      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "자, <U+0010><U+0002>Ā<U+0000>!\n열심히 해 보게나!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
