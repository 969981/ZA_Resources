  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "La polizia di Luminopoli si avvale dell’aiuto\ndei Pokémon per svolgere le indagini.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Io al momento trovo molto interessanti\nle caratteristiche degli Shuppet.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Pare che siano attratti dai sentimenti negativi\ndelle persone, come ad esempio l’odio o l’invidia.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Questa loro peculiarità potrebbe aiutarmi a\nindividuare gente che cova sentimenti cupi.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Così sarebbe molto più facile incastrare\ndelinquenti o prevenire crimini.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Ed è qui che mi serve il tuo aiuto!<U+0010><U+0001>븁\nSe hai con te uno Shuppet, me lo cederesti?<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1392,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Avresti uno Shuppet da cedermi?<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "004100760072006500730074006900200075006E006F00200053006800750070007000650074002000640061002000630065006400650072006D0069003F001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Certo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "0043006500720074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "No, mi dispiace...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1492,
      "rawDecodedUtf16Hex": "004E006F002C0020006D0069002000640069007300700069006100630065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Fantastico! Quale Shuppet mi cederesti?<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "00460061006E007400610073007400690063006F00210020005100750061006C0065002000530068007500700070006500740020006D00690020006300650064006500720065007300740069003F001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Se potessi avvalermi dei poteri di uno Shuppet,\nsarebbe tutto più semplice...<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Piacere di conoscerti, Shuppet!<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1784,
      "rawDecodedUtf16Hex": "005000690061006300650072006500200064006900200063006F006E006F007300630065007200740069002C002000530068007500700070006500740021001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "La pace di Luminopoli dipende da te! Mostrami\ncosa sei capace di fare!<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Certo che è davvero... enorme! Con un Pokémon\ncosì la pace di Luminopoli è assicurata!<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Comunque, ogni cosa a suo tempo! Non mi\naspetto che tu faccia tutto subito!<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Shu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 17,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "00530068007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Eh? Sembra che abbia già rilevato dei sentimenti\nnegativi. Ottimo! Seguiamolo!<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ma... non capisco... Questa... è casa mia!<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2544,
      "rawDecodedUtf16Hex": "004D0061002E002E002E0020006E006F006E0020006300610070006900730063006F002E002E002E0020005100750065007300740061002E002E002E002000E8002000630061007300610020006D006900610021001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Shuuu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 21,
      "offsetInSection": 2640,
      "rawDecodedUtf16Hex": "0053006800750075007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Oh! Hai già finito di lavorare per oggi?\nSpero sia andato tutto bene.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "004F00680021002000480061006900200067006900E0002000660069006E00690074006F0020006400690020006C00610076006F007200610072006500200070006500720020006F006700670069003F000A0053007000650072006F002000730069006100200061006E006400610074006F00200074007500740074006F002000620065006E0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "In realtà... sono ancora in servizio. Non è che hai\nvisto qualcuno di sospetto da queste parti?<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Ah... Quindi stai lavorando...\nBuona fortuna, allora.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2996,
      "rawDecodedUtf16Hex": "00410068002E002E002E0020005100750069006E00640069002000730074006100690020006C00610076006F00720061006E0064006F002E002E002E000A00420075006F006E006100200066006F007200740075006E0061002C00200061006C006C006F00720061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Shu-shuu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 25,
      "offsetInSection": 3104,
      "rawDecodedUtf16Hex": "005300680075002D007300680075007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Cos... Ma perché reagisci alla sua presenza?<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3124,
      "rawDecodedUtf16Hex": "0043006F0073002E002E002E0020004D006100200070006500720063006800E900200072006500610067006900730063006900200061006C006C00610020007300750061002000700072006500730065006E007A0061003F001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Che Shuppet invadente!<U+0010><U+0001>븁\nDoveva proprio reagire a questi sentimenti orribili\nche cerco continuamente di reprimere!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Cosa vuoi dire...? No... Non è possibile...<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3456,
      "rawDecodedUtf16Hex": "0043006F00730061002000760075006F006900200064006900720065002E002E002E003F0020004E006F002E002E002E0020004E006F006E002000E800200070006F00730073006900620069006C0065002E002E002E001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "La mia ossessione per il lavoro la crucciava,\nma non ha mai smesso di supportarmi...<U+0010><U+0001>븁\nHa continuato a reprimere questa insoddisfazione\nfinché non si è trasformata in rancore...<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 183
    },
    {
      "displayText": "Ecco a cosa ha reagito Shuppet...\nAi suoi sentimenti negativi.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 3920,
      "rawDecodedUtf16Hex": "004500630063006F0020006100200063006F007300610020006800610020007200650061006700690074006F00200053006800750070007000650074002E002E002E000A00410069002000730075006F0069002000730065006E00740069006D0065006E007400690020006E0065006700610074006900760069002E001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Shuuu...",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 31,
      "offsetInSection": 4056,
      "rawDecodedUtf16Hex": "00530068007500750075002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "La vita ci ha portati a stare insieme così tanti anni\ned ero sicuro non ci fossero segreti tra di noi...<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4076,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "Ma ero troppo preso dal lavoro e non mi sono reso\nconto della sua sofferenza. Ho ancora tanto da<U+0010><U+0001>븀\nimparare... Sono un disastro.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Shuppet, spero che continuerai a darmi una mano\ncome hai fatto oggi.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 8,
      "index": 34,
      "offsetInSection": 4564,
      "rawDecodedUtf16Hex": "0053006800750070007000650074002C00200073007000650072006F002000630068006500200063006F006E00740069006E00750065007200610069002000610020006400610072006D006900200075006E00610020006D0061006E006F000A0063006F006D0065002000680061006900200066006100740074006F0020006F006700670069002E001000020114016E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Aiutami a essere un marito migliore così che lei\nnon debba reprimere i propri sentimenti.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "<U+0010><U+0002>뷿$",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4900,
      "rawDecodedUtf16Hex": "00100002BDFF00240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Odio quando la negatività s’impadronisce\ndei miei pensieri...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4912,
      "rawDecodedUtf16Hex": "004F00640069006F0020007100750061006E0064006F0020006C00610020006E0065006700610074006900760069007400E00020007320190069006D0070006100640072006F006E0069007300630065000A0064006500690020006D006900650069002000700065006E00730069006500720069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Shu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 38,
      "offsetInSection": 5036,
      "rawDecodedUtf16Hex": "00530068007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mi spiace per Shuppet ma da ora in avanti farò in\nmodo che mia moglie non mi serbi mai rancore.<U+0010><U+0002>ĔŮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    }
