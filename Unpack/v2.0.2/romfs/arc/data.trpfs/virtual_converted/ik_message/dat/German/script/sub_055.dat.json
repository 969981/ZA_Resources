      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1536,
      "rawDecodedUtf16Hex": "0049006E002000520075006800650020006C0061007300730065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Ein wildes Pokémon ist erschienen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "00450069006E002000770069006C00640065007300200050006F006B00E9006D006F006E002000690073007400200065007200730063006800690065006E0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Grebb! Grebb!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
