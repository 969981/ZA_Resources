      "index": 1,
      "offsetInSection": 208,
      "rawDecodedUtf16Hex": "00440065007200200048006F006C006F002D004C00690066007400200069007300740020007A00750072007A00650069007400200061007500DF0065007200200042006500740072006900650062002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Du da, hättest du grad mal ’ne Minute?<U+0010><U+0002>ĔŖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 292,
