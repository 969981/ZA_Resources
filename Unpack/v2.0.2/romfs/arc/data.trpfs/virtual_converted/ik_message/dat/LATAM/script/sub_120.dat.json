  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 300,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Tu presencia activó la corriente de una\nsección del laboratorio.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 312,
      "rawDecodedUtf16Hex": "00540075002000700072006500730065006E00630069006100200061006300740069007600F30020006C006100200063006F0072007200690065006E0074006500200064006500200075006E0061000A0073006500630063006900F3006E002000640065006C0020006C00610062006F007200610074006F00720069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Control de seguridad.<U+0010><U+0001>븁\nVerificación de Megapiedras en curso...\nProcediendo al reinicio parcial del sistema.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Proyecto M activado.<U+0010><U+0001>븁\nEste proyecto está clasificado como de alto riesgo.\n¿Desea proceder de todos modos?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "Sí",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "005300ED0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "No",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 888,
      "rawDecodedUtf16Hex": "004E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>¿Se puede saber qué estás haciendo,\n<U+0010><U+0002>Ā<U+0000>?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "00100002BD06000000BF0053006500200070007500650064006500200073006100620065007200200071007500E9002000650073007400E10073002000680061006300690065006E0064006F002C000A0010000201000000003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Mewtwo es un Pokémon peligrosísimo.\n¿De verdad quieres enfrentarte a él?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "¡En ese caso, tienes que capturarlo como sea!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "00A10045006E00200065007300650020006300610073006F002C0020007400690065006E006500730020007100750065002000630061007000740075007200610072006C006F00200063006F006D006F0020007300650061002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Debes capturar a ese Mewtwo a toda costa!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "00A1004400650062006500730020006300610070007400750072006100720020006100200065007300650020004D0065007700740077006F0020006100200074006F0064006100200063006F007300740061002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "¡Meeew!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1360,
      "rawDecodedUtf16Hex": "00A1004D006500650065007700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡¿No te advertí que era extremadamente\npeligroso?! ¡Captúralo como sea!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "¡Te dije que lo capturaras, no que lo debilitaras!<U+0010><U+0001>븁\n¡Todos sabemos que eres fuerte, no es necesario\nque te luzcas!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Veo que lograste atraparlo. ¡Bien!\nDame un segundito...<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1784,
      "rawDecodedUtf16Hex": "00560065006F00200071007500650020006C006F00670072006100730074006500200061007400720061007000610072006C006F002E002000A1004200690065006E0021000A00440061006D006500200075006E00200073006500670075006E006400690074006F002E002E002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Uf... Todavía se me hace un nudo en la garganta\ncada vez que veo el laboratorio en este estado.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Usaré el Holomisor porque prefiero tener video\ny no solo la voz. Así es más personal.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Y ahora te explicaré cómo es que terminaste\ncombatiendo contra Mewtwo justo aquí en<U+0010><U+0001>븀\nlos Laboratorios Lysandre.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Quiero saber más",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "00510075006900650072006F0020007300610062006500720020006D00E100730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Me da igual",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2556,
      "rawDecodedUtf16Hex": "004D006500200064006100200069006700750061006C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Muy bien. Me gusta la gente que sabe escuchar.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2580,
      "rawDecodedUtf16Hex": "004D007500790020006200690065006E002E0020004D00650020006700750073007400610020006C0061002000670065006E00740065002000710075006500200073006100620065002000650073006300750063006800610072002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Hmm, haré como que no escuché eso.\nAhora presta atención.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2684,
      "rawDecodedUtf16Hex": "0048006D006D002C002000680061007200E900200063006F006D006F00200071007500650020006E006F002000650073006300750063006800E9002000650073006F002E000A00410068006F0072006100200070007200650073007400610020006100740065006E0063006900F3006E002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Mewtwo fue creado por un científico\nespecializado en la genética Pokémon.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Su gran poder llamó la atención del Equipo Flare,\nque consideró utilizarlo para alimentar el<U+0010><U+0001>븀\narma definitiva.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Apenas supimos que Mewtwo fue visto\nen la Cueva Rara de la región de Kalos,<U+0010><U+0001>븀\nenviamos gente a capturarlo.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 3200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "La razón por la que Mewtwo apareció en Kalos\ntodavía sigue siendo un misterio.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3424,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Algunos teorizan que vino en busca del poder\nde la megaevolución.<U+0010><U+0001>븁\nNi siquiera los cinco miembros del grupo\npudimos encontrar la respuesta.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 146
    },
    {
      "displayText": "Intentamos usar una Mewtwoita X y una\nMewtwoita Y, pero no megaevolucionó.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3884,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Normalmente, Mewtwo permanece en una\nespecie de letargo para conservar energía<U+0010><U+0001>븀\ny así usarla solamente en combate...<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4044,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Por lo que el Proyecto M quedó paralizado de\nforma indefinida.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4292,
      "rawDecodedUtf16Hex": "0050006F00720020006C006F002000710075006500200065006C002000500072006F0079006500630074006F0020004D0020007100750065006400F300200070006100720061006C0069007A00610064006F002000640065000A0066006F0072006D006100200069006E0064006500660069006E006900640061002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Hablando de misterios, no sé por qué\nMewtwo despertó ahora.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4428,
      "rawDecodedUtf16Hex": "004800610062006C0061006E0064006F0020006400650020006D006900730074006500720069006F0073002C0020006E006F0020007300E900200070006F007200200071007500E9000A004D0065007700740077006F0020006400650073007000650072007400F3002000610068006F00720061002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Quizás reaccionó a la Mewtwoita X\ny la Mewtwoita Y que tienes.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4556,
      "rawDecodedUtf16Hex": "005100750069007A00E100730020007200650061006300630069006F006E00F3002000610020006C00610020004D0065007700740077006F00690074006100200058000A00790020006C00610020004D0065007700740077006F0069007400610020005900200071007500650020007400690065006E00650073002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Lo que me hace preguntarme por qué tienes\nesas dos Megapiedras... Demasiados misterios.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Pero bueno, no importa.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4876,
      "rawDecodedUtf16Hex": "005000650072006F0020006200750065006E006F002C0020006E006F00200069006D0070006F007200740061002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Estoy segura de que Mewtwo va a obedecer\na alguien tan capaz como tú.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4932,
      "rawDecodedUtf16Hex": "004500730074006F0079002000730065006700750072006100200064006500200071007500650020004D0065007700740077006F002000760061002000610020006F0062006500640065006300650072000A006100200061006C0067007500690065006E002000740061006E00200063006100700061007A00200063006F006D006F0020007400FA002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Y ahora tengo que irme, la vida de una\nsubdirectora es muy ocupada. ¡Cambio y fuera!<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    }
  ],
