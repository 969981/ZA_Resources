    },
    {
      "displayText": "¡Joool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "00A1004A006F006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "¡Espera, Jolteon! ¿No ves que estamos en medio\nde una conversación?<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 288,
      "rawDecodedUtf16Hex": "00A1004500730070006500720061002C0020004A006F006C00740065006F006E0021002000BF004E006F0020007600650073002000710075006500200065007300740061006D006F007300200065006E0020006D006500640069006F000A0064006500200075006E006100200063006F006E007600650072007300610063006900F3006E003F00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Ah, bueno, ¿qué Insecto le picó?<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "00410068002C0020006200750065006E006F002C002000BF0071007500E900200049006E0073006500630074006F0020006C0065002000700069006300F3003F00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Mi Jolteon es de naturaleza activa. ¡No se queda\nquieto ni un segundo!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Se dio cuenta de que tenía ganas de combatir y\nestaba ya de camino a una arena de combate.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "¡Así que, por favor, combate contra nosotros!\nTe estaré esperando en la arena de combate.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres combatir contra nosotros?<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200063006F006D0062006100740069007200200063006F006E0074007200610020006E006F0073006F00740072006F0073003F00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Joool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "00A1004A006F006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Cuánta impaciencia, ¡si todavía no respondió!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "0043007500E1006E0074006100200069006D00700061006300690065006E006300690061002C002000A10073006900200074006F00640061007600ED00610020006E006F00200072006500730070006F006E0064006900F3002100100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Cómo se nota que perteneces al Equipo MZ!\nNo me esperaba menos de alguien como tú.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Mi Jolteon es de naturaleza activa, por eso es tan\nrápido.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "004D00690020004A006F006C00740065006F006E0020006500730020006400650020006E00610074007500720061006C0065007A00610020006100630074006900760061002C00200070006F0072002000650073006F002000650073002000740061006E000A007200E1007000690064006F002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "La naturaleza del Pokémon puede aumentar o\ndisminuir características como la Velocidad.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¡Y no hablo solo de la naturaleza activa!\nLa miedosa, la alegre o la ingenua también.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Cuanto más veloz sea un Pokémon, menos\ntardará en ejecutar sus movimientos.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1928,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Sin embargo, por muy veloz que sea, deberá\nesperar al menos 3 segundos antes de poder<U+0010><U+0001>븀\nvolver a usar un mismo movimiento.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Y, por si eso fuera poco...<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "0059002C00200070006F0072002000730069002000650073006F00200066007500650072006100200070006F0063006F002E002E002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "¡Joool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "00A1004A006F006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Oye, ¡te dije que no vayas al Centro\nPokémon sin mí!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "004F00790065002C002000A100740065002000640069006A006500200071007500650020006E006F00200076006100790061007300200061006C002000430065006E00740072006F000A0050006F006B00E9006D006F006E002000730069006E0020006D00ED002100100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Bueno, me tengo que ir. ¡Hasta luego!\nY muchas gracias.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2540,
      "rawDecodedUtf16Hex": "004200750065006E006F002C0020006D0065002000740065006E0067006F0020007100750065002000690072002E002000A1004800610073007400610020006C007500650067006F0021000A00590020006D0075006300680061007300200067007200610063006900610073002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
