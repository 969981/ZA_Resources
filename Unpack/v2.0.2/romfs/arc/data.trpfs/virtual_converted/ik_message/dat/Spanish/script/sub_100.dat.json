    {
      "displayText": "¡Mirad, en el cielo! ¡Una estrella fugaz!<U+0010><U+0002>Ĕ#",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 3976,
