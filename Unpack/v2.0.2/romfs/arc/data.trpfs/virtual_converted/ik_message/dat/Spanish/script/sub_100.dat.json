      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Empecemos con la junta.<U+0010><U+0002>Ĕż",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2400,
      "rawDecodedUtf16Hex": "0045006D0070006500630065006D006F007300200063006F006E0020006C00610020006A0075006E00740061002E001000020114017C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Queridos amigos hoy aquí reunidos.<U+0010><U+0001>븁\nEstamos aquí para poner en común nuestro poder\ncósmico y comunicarnos con los Starmie que aún<U+0010><U+0001>븀\nresiden en el espacio exterior.<U+0010><U+0002>Ĕż",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 171
    },
    {
      "displayText": "Si es vuestra primera vez, no os preocupéis:\ntan solo tenéis que unir vuestro corazón<U+0010><U+0001>븀\nal de Starmie y sentir ese vínculo que os conecta.<U+0010><U+0002>Ĕż",
      "escapedControlUnits": 4,
