      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3088,
      "rawDecodedUtf16Hex": "00A100530074006100610061007200210000",
      "trailingZeroPaddingUnits": 1,
