    },
    {
      "displayText": "¡Mi Pikachu es el más fuerte del mundo!<U+0010><U+0002>Ĕũ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 184,
