      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "아쿠스타!\n별처럼 반짝이는 모습을 보여 주는 거야!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
