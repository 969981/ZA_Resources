      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "C7A0AE50B9CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "아~ 긴장돼...<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
