      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "응! 잘 부탁해!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1596,
      "rawDecodedUtf16Hex": "C75100210020C7980020BD80D0C1D5740021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
