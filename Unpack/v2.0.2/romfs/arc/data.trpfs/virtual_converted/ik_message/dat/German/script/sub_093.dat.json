      "index": 4,
      "offsetInSection": 596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "Und... es benimmt sich seitdem etwas seltsam.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "0055006E0064002E002E002E002000650073002000620065006E0069006D006D0074002000730069006300680020007300650069007400640065006D002000650074007700610073002000730065006C007400730061006D002E00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Es starrt immer in die Ferne, so, als würde es an\nirgendetwas zurückdenken...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
