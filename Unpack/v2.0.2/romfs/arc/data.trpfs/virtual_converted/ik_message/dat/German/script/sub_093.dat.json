      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Resla!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2908,
      "rawDecodedUtf16Hex": "005200650073006C0061002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Auf gute Zusammenarbeit!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2924,
      "rawDecodedUtf16Hex": "004100750066002000670075007400650020005A007500730061006D006D0065006E006100720062006500690074002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Vielen Dank, dass du gegen Resladero gekämpft\nhast!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2984,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B002C0020006400610073007300200064007500200067006500670065006E0020005200650073006C0061006400650072006F002000670065006B00E4006D007000660074000A0068006100730074002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
