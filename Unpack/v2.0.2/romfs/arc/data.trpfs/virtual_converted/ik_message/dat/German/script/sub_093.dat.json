      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Das Ziel ist also nicht, den Gegner zu schlagen,\nsondern mit ganzer Kraft anzutreten...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Resladero!<U+0010><U+0001>븁\nWärst du damit einverstanden, mein Partner\nzu werden?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 4,
