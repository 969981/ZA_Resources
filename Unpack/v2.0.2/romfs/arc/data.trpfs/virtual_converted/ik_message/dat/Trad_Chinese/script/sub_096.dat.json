      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "807D8AAA50B38AAA4E2D7684745C4F3D59275E2B67035728000A0035500B571357084E2D00309EDE76844F4D7F6E88E1976200100001BE00000A670097608FD184BC59294E4B86555594300200100002011401790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
