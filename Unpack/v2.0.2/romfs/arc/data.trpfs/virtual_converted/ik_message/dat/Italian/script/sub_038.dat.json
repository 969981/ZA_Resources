      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Quando sei pront<U+0010><U+0003>ᄀÿāoa per la lotta, fammi sapere!<U+0010><U+0002>ĔŇ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
