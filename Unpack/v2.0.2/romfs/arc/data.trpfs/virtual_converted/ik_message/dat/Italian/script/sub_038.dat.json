      "index": 4,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "Lotta con me e ti darò una dimostrazione\ndi quanto è forte Individua!<U+0010><U+0002>ĔŇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
