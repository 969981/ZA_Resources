      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "哎呀～太可惜了！\n<U+0010><U+0003>ᄀÿā你妳要是改變心意了，再拜託囉！",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
