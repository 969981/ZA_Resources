      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Mes Pokémon ont des capacités qui réduisent les\ndégâts subis ! Certaines personnes appellent ça<U+0010><U+0001>븀\ndes barrières.<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 4,
