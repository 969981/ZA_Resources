    },
    {
      "displayText": "Es-tu prêt<U+0010><U+0003>ᄀÿĀe à en apprendre plus sur les barrières ?<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
