      "offsetInSection": 828,
      "rawDecodedUtf16Hex": "005600690065006E00730020006D006500200076006F006900720020006C006F0072007300710075006500200074007500200076006F007500640072006100730020007400650020006200610074007400720065002E001000020114013A0000",
