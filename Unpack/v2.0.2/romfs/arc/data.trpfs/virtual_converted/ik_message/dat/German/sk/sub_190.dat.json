      "rawDecodedUtf16Hex": "004E00650069006E002C0020007700610072007400650020006E006F00630068002000650069006E00200062006900730073006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Ich werde hier sein und meine Kraft noch weiter\naufladen.<U+0010><U+0002>Ĕǥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "004900630068002000770065007200640065002000680069006500720020007300650069006E00200075006E00640020006D00650069006E00650020004B00720061006600740020006E006F006300680020007700650069007400650072000A006100750066006C006100640065006E002E00100002011401E50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "JETZT! GEHT’S!<U+0010><U+0002>Ĕǥ",
