      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "004400690065007300650020004B0072006100660074002100100002011401E50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Hier, nimm diese TM und nutze sie, um Kraft\naufzuladen!<U+0010><U+0002>Ĕǥ",
