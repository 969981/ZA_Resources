      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Sie enthält die Attacke <U+0010><U+0002>＀<U+0006>Schädelwumme<U+0010><U+0002>＀<U+0000>!<U+0010><U+0002>Ĕǥ",
      "escapedControlUnits": 8,
