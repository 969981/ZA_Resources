      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "00530069006500200065006E0074006800E4006C00740020006400690065002000410074007400610063006B0065002000100002FF00000600530063006800E400640065006C00770075006D006D006500100002FF000000002100100002011401E50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Der Anwender steigert seine Verteidigung,\nwährend die Attacke lädt, und entfesselt dann<U+0010><U+0001>븀\neinen heftigen Angriff!<U+0010><U+0002>Ĕǥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Bitte nutze sie!<U+0010><U+0002>Ĕǥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
