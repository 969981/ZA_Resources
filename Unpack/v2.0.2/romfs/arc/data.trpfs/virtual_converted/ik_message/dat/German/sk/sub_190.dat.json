      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Volle Kraft voraus!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "0056006F006C006C00650020004B007200610066007400200076006F007200610075007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Nein, warte noch ein bisschen.",
