      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Du bist unfassbar!<U+0010><U+0002>Ĕǥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "004400750020006200690073007400200075006E0066006100730073006200610072002100100002011401E50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Diese Kraft!<U+0010><U+0002>Ĕǥ",
