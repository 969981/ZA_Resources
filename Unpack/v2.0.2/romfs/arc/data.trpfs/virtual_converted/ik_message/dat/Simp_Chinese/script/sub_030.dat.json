      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "所以我想拜托你一件事。\n你能去帮我买下你看上的化石回来吗？<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 420,
      "rawDecodedUtf16Hex": "62404EE5621160F362DC62584F604E004EF64E8B3002000A4F6080FD53BB5E2E62114E704E0B4F60770B4E0A7684531677F356DE67655417FF1F00100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "从委托人余恒那里\n收下了<U+E300>20000！",
      "escapedControlUnits": 1,
      "flagsUpper16": 0,
      "index": 5,
