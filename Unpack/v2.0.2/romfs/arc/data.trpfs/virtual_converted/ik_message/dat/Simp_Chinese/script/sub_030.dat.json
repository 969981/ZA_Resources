      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "54CE5440FF01590D539F531677F3768465F650198981628A000A76D25B50817E51FA7A7A95F4FF0C8FD95F885173952E54E6300200100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "谢谢！你帮我买了\n<U+0010><U+0002>ĉ<U+0002>回来啊！<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "8C228C22FF014F605E2E62114E704E86000A001000020109000256DE6765554AFF0100100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "那我这就来复原化石，\n你稍等一下哦。<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "90A362118FD95C316765590D539F531677F3FF0C000A4F607A0D7B494E004E0B54E6300200100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "这是从颚之化石复原的宝可梦……\n宝宝暴龙！<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1108,
