      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "讓我好好瞧一瞧扒手電飛鼠\n是長得什麼德行吧。<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "8B936211597D597D77A74E0077A76252624B96FB98DB9F20000A662F95775F974EC09EBC5FB7884C54273002001000020114018A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
