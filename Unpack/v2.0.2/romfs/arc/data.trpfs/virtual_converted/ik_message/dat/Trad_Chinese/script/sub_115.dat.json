      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "看來牠把我的樹果也\n全都留下來了。<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
