      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Pure qui mi ritrovo con mio fratello... Che\ndisdetta!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 400,
      "rawDecodedUtf16Hex": "005000750072006500200071007500690020006D006900200072006900740072006F0076006F00200063006F006E0020006D0069006F002000660072006100740065006C006C006F002E002E002E0020004300680065000A00640069007300640065007400740061002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Siete del Gruppo Justice, no? Mostratemi\nle vostre megaevoluzioni, dai!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
