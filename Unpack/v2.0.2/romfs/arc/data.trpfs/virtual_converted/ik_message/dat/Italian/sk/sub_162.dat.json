  "messages": [
    {
      "displayText": "Mi sembra di conoscere questo posto.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
