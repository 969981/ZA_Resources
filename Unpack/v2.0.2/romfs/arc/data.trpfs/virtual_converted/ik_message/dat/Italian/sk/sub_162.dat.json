      "rawDecodedUtf16Hex": "0041007300700065007400740061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, qui servono entusiasmo\ned energia!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "0010000201000000002C002000710075006900200073006500720076006F006E006F00200065006E007400750073006900610073006D006F000A0065006400200065006E00650072006700690061002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Sono l’Erede, devo conoscere ogni genere di\nmegaevoluzione!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 924,
      "rawDecodedUtf16Hex": "0053006F006E006F0020006C201900450072006500640065002C0020006400650076006F00200063006F006E006F007300630065007200650020006F0067006E0069002000670065006E006500720065002000640069000A006D00650067006100650076006F006C0075007A0069006F006E0065002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Anche io desidero questo incontro!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "0041006E00630068006500200069006F00200064006500730069006400650072006F002000710075006500730074006F00200069006E0063006F006E00740072006F002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Vista la situazione... immagino di non avere il\ndiritto di rifiutare...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Lottiamo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1296,
      "rawDecodedUtf16Hex": "004C006F0074007400690061006D006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Aspettate...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1316,
      "rawDecodedUtf16Hex": "004100730070006500740074006100740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Ci sono traguardi che non si possono raggiungere\nsenza sconfiggere degli avversari possenti.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "La forza è potere!!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "004C006100200066006F0072007A0061002000E800200070006F00740065007200650021002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Non ti facevo così indecis<U+0010><U+0003>ᄀÿāoa.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "004E006F006E002000740069002000660061006300650076006F00200063006F007300EC00200069006E0064006500630069007300100003110000FF0101006F0061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "La forza è giustizia!!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "004C006100200066006F0072007A0061002000E80020006700690075007300740069007A006900610021002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "È strepitoso che ci siano così tante\nmegaevoluzioni a Luminopoli, anche se si tratta<U+0010><U+0001>븀\ndella Luminopoli dimensionale!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1972,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Falinks! La tua megaevoluzione segnerà\nuna vittoria trionfale per la giustizia!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Chandelure... sconfiggiamoli con\nla megaevoluzione.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002E002E002E002000730063006F006E006600690067006700690061006D006F006C006900200063006F006E000A006C00610020006D00650067006100650076006F006C0075007A0069006F006E0065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "METTIAMOCELA TUTTA!!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "004D00450054005400490041004D004F00430045004C00410020005400550054005400410021002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "MegaFalinks e MegaChandelure sono entrambi\nstraordinari!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2328,
      "rawDecodedUtf16Hex": "004D00650067006100460061006C0069006E006B0073002000650020004D006500670061004300680061006E00640065006C00750072006500200073006F006E006F00200065006E007400720061006D00620069000A0073007400720061006F007200640069006E006100720069002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Credevo che sarei riuscito a polverizzare\nl’avversario con il potere della megaevoluzione...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "È vero, Albis. I Pokémon megaevoluti sono\ncertamente più potenti.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "00C80020007600650072006F002C00200041006C006200690073002E0020004900200050006F006B00E9006D006F006E0020006D00650067006100650076006F006C00750074006900200073006F006E006F000A00630065007200740061006D0065006E0074006500200070006900F900200070006F00740065006E00740069002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Ma sta all’Allenatore capire come meglio mettere\na frutto le caratteristiche di ciascun Pokémon.<U+0010><U+0001>븁\nProprio per questo è necessario comprendere la\nmegaevoluzione a fondo.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 175
    },
    {
      "displayText": "Sissignora! Mi impegnerò per riuscirci.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3140,
      "rawDecodedUtf16Hex": "005300690073007300690067006E006F0072006100210020004D006900200069006D007000650067006E0065007200F200200070006500720020007200690075007300630069007200630069002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Albis ti ascolta? Devi essere una persona\nstraordinaria, Ornella.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3228,
      "rawDecodedUtf16Hex": "0041006C0062006900730020007400690020006100730063006F006C00740061003F00200044006500760069002000650073007300650072006500200075006E006100200070006500720073006F006E0061000A0073007400720061006F007200640069006E0061007200690061002C0020004F0072006E0065006C006C0061002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Sono davvero commosso. Ti prego di accettare\nquesta divisa.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3368,
      "rawDecodedUtf16Hex": "0053006F006E006F0020006400610076007600650072006F00200063006F006D006D006F00730073006F002E00200054006900200070007200650067006F0020006400690020006100630063006500740074006100720065000A0071007500650073007400610020006400690076006900730061002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Ti ringrazio! Ma comincia a essere un po’ troppo...<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3496,
      "rawDecodedUtf16Hex": "00540069002000720069006E006700720061007A0069006F00210020004D006100200063006F006D0069006E00630069006100200061002000650073007300650072006500200075006E00200070006F2019002000740072006F00700070006F002E002E002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Sono la Capopalestra di Yantaropoli, l’Erede della\nmegaevoluzione e ora pure membro del Team MZ.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Ora che ho anche appeso i pattini al chiodo,\ncomplicherei le cose se indossassi l’uniforme<U+0010><U+0001>븀\ndel Gruppo Justice, no?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 3812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Capisco. Allora puoi averla tu,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4056,
      "rawDecodedUtf16Hex": "00100002BD060000004300610070006900730063006F002E00200041006C006C006F00720061002000700075006F006900200061007600650072006C0061002000740075002C000A0010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Hai ricevuto la Divisa di Albis!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4148,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F0020006C0061002000440069007600690073006100200064006900200041006C00620069007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Che incredibile mancanza di rispetto, Albis!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4216,
      "rawDecodedUtf16Hex": "00430068006500200069006E0063007200650064006900620069006C00650020006D0061006E00630061006E007A006100200064006900200072006900730070006500740074006F002C00200041006C006200690073002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Mi megaevolverò come Allenatore.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4316,
      "rawDecodedUtf16Hex": "004D00690020006D00650067006100650076006F006C00760065007200F200200063006F006D006500200041006C006C0065006E00610074006F00720065002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Questo posto... non esiste da nessuna parte,\nvero?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4392,
      "rawDecodedUtf16Hex": "00510075006500730074006F00200070006F00730074006F002E002E002E0020006E006F006E00200065007300690073007400650020006400610020006E0065007300730075006E0061002000700061007200740065002C000A007600650072006F003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Una forza eccessiva può implicare sofferenza...<U+0010><U+0001>븁\nMa il legame tra Allenatore e Pokémon serve\nproprio a superare questo ostacolo!<U+0010><U+0002>Ĕƒ",
