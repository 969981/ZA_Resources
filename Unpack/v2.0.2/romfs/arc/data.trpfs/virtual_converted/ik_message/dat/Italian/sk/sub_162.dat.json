      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "0045002000740075002C00200010000201000000002C00200075006E006900730063006900740069002000610020006D006500200069006E00200075006E0061000A006C006F007400740061002000640075006500200063006F006E00740072006F0020006400750065002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Lottiamo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 788,
      "rawDecodedUtf16Hex": "004C006F0074007400690061006D006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Aspetta...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
