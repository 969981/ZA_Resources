      "rawDecodedUtf16Hex": "00100002BDFF00340000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Alors, Pâtachiot ! T’as fait une jolie promenade ?<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 53,
      "offsetInSection": 4900,
      "rawDecodedUtf16Hex": "0041006C006F00720073002C0020005000E200740061006300680069006F007400200021002000542019006100730020006600610069007400200075006E00650020006A006F006C00690065002000700072006F006D0065006E0061006400650020003F00100002011401C30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Pâtatata !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5012,
      "rawDecodedUtf16Hex": "005000E2007400610074006100740061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Merci beaucoup, <U+0010><U+0002>Ā<U+0000> !<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 5036,
      "rawDecodedUtf16Hex": "004D0065007200630069002000620065006100750063006F00750070002C002000100002010000000020002100100002011401C30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Je sais pas si tu savais, mais les Pâtachiot\nexpirent de la levure qui favorise la fermentation.<U+0010><U+0001>븁\nEt depuis que j’ai adopté celui-ci, les ventes de\nmes baguettes ont explosé, ce qui me laisse<U+0010><U+0001>븀\nplus assez de temps pour le promener...<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5092,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 241
    },
    {
      "displayText": "Mais à partir d’aujourd’hui, je produirai moins\nde pain, et je passerai plus de temps avec lui !<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "J’ai l’impression que tout le monde sait mieux\nque moi à quel point Pâtachiot est adorable...<U+0010><U+0001>븀\nIl faut que ça change !<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5780,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Pâtachiot !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 6032,
      "rawDecodedUtf16Hex": "005000E200740061006300680069006F0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 6056,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Je veux savoir à quel point mon Pâtachiot est\nadorable !<U+0010><U+0002>Ĕǃ",
