      "rawDecodedUtf16Hex": "0050006100720064006F006E003F00200049002D004900200064006F006E2019007400200071007500690074006500200066006F006C006C006F0077002E002E002E00100002011401760000",
      "trailingZeroPaddingUnits": 1,
