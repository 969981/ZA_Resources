      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "I thought it would be really hard for wild Pokémon\nto live in the city, but I guess Pokémon are more<U+0010><U+0001>븀\npowerful than I ever imagined.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 4,
