      "rawDecodedUtf16Hex": "004C007500630068006100610061006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Oh, thank you—I won’t let you down!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 2952,
      "rawDecodedUtf16Hex": "004F0068002C0020007400680061006E006B00200079006F00752014004900200077006F006E201900740020006C0065007400200079006F007500200064006F0077006E002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Thank you so much for battling Hawlucha.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3032,
