      "rawDecodedUtf16Hex": "0054006800610074002000770061007300200061002000660075006E002000720065006D006100740063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "That was amazing! I had no idea Pokémon battles\ncould be so exciting...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "It’s not about beating down an opponent... It’s\nabout facing each other without holding back.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Hey, Hawlucha...<U+0010><U+0001>븁\nDo you think you could let me be your partner?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 2540,
      "rawDecodedUtf16Hex": "004800650079002C0020004800610077006C0075006300680061002E002E002E00100001BE01000A0044006F00200079006F00750020007400680069006E006B00200079006F007500200063006F0075006C00640020006C006500740020006D006500200062006500200079006F0075007200200070006100720074006E00650072003F00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "I’ll do more than just feed you... I promise I’ll\nlearn everything I can about being a Trainer.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 2684,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "I want to help you!<U+0010><U+0002>ĔŶ",
