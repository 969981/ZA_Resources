      "rawDecodedUtf16Hex": "004C007500630068006100610061006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Oh my! What’s going on, Hawlucha?!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1132,
