      "offsetInSection": 2884,
      "rawDecodedUtf16Hex": "0049002000770061006E007400200074006F002000680065006C007000200079006F0075002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
