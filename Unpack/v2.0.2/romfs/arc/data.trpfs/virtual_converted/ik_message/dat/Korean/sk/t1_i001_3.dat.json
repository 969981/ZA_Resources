      "rawDecodedUtf16Hex": "B304C2A4B97C0020CCB4D06CD558AE300020C704D55C000AC804C2E00020AC70C6B8C7740020B193C5EC0020C788B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
