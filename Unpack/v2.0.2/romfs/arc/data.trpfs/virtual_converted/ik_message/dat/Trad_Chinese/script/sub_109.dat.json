      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "拜託<U+0010><U+0003>ᄀÿā你妳！\n幫我找我妹吧！<U+0010><U+0002>Ĕƅ",
