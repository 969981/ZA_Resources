      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "We should have a battle when it’s raining! You’ll\nsee just how strong my team can be then!<U+0010><U+0001>븁\n...Are you gonna wait here with me until it starts\nraining?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 158
    },
    {
      "displayText": "Yeah, I’ll wait here<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "0059006500610068002C002000492019006C006C002000770061006900740020006800650072006500100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "No, I’ve got to go<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "004E006F002C0020004920190076006500200067006F007400200074006F00200067006F00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Let’s battle while it’s still raining! I’ll show you\nwhat my Pokémon can do!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Show me what you’ve got!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "00530068006F00770020006D00650020007700680061007400200079006F007520190076006500200067006F0074002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "I don’t want to get soaked...<U+0010><U+0002>Ĕŉ",
