      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "005300740069006C006C0020006E006F0020007200610069006E002C0020006800750068002E002E002E00100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Drip-drop, drip-drop... This is the perfect rainy day!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 300,
      "rawDecodedUtf16Hex": "0044007200690070002D00640072006F0070002C00200064007200690070002D00640072006F0070002E002E002E002000540068006900730020006900730020007400680065002000700065007200660065006300740020007200610069006E00790020006400610079002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Tell me, have you ever given much thought to the\nweather during Pokémon battles?<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "My Pokémon grow stronger in the rain, you know!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 592,
      "rawDecodedUtf16Hex": "004D007900200050006F006B00E9006D006F006E002000670072006F00770020007300740072006F006E00670065007200200069006E00200074006800650020007200610069006E002C00200079006F00750020006B006E006F0077002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "We should have a battle when it’s raining! You’ll\nsee just how strong my team can be!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 696,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Come on—let’s battle before the rain stops. You’ll\nsee just how strong my team can be!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "The more rain, the better! Let me know if you’re\nready to face me!<U+0010><U+0002>Ĕŉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "0054006800650020006D006F007200650020007200610069006E002C0020007400680065002000620065007400740065007200210020004C006500740020006D00650020006B006E006F007700200069006600200079006F0075201900720065000A0072006500610064007900200074006F002000660061006300650020006D0065002100100002011401490000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
