  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Benvenut<U+0010><U+0003>ᄀÿāoa al Ristorante Gourmet!\nIl nostro servizio non la deluderà.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "È pront<U+0010><U+0003>ᄀÿāoa per il miglior menu di\ndegustazione che ci sia? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Il Ristorante Gourmet non si\nsmentisce mai. Che squisitezza!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 520,
      "rawDecodedUtf16Hex": "0049006C00200052006900730074006F00720061006E0074006500200047006F00750072006D006500740020006E006F006E002000730069000A0073006D0065006E007400690073006300650020006D00610069002E0020004300680065002000730071007500690073006900740065007A007A006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Ora che ho mangiato qui, la mia\nvita ha finalmente senso...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "004F00720061002000630068006500200068006F0020006D0061006E0067006900610074006F0020007100750069002C0020006C00610020006D00690061000A0076006900740061002000680061002000660069006E0061006C006D0065006E00740065002000730065006E0073006F002E002E002E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Speriamo di prendere la decisione\ngiusta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 4,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "005300700065007200690061006D006F0020006400690020007000720065006E00640065007200650020006C00610020006400650063006900730069006F006E0065000A00670069007500730074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "A pancia vuota non si decide nulla.\nRiempiamocela con queste delizie!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "0041002000700061006E006300690061002000760075006F007400610020006E006F006E00200073006900200064006500630069006400650020006E0075006C006C0061002E000A005200690065006D007000690061006D006F00630065006C006100200063006F006E0020007100750065007300740065002000640065006C0069007A0069006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "E chi può dirlo? Nulla è mai certo\nnel mondo delle lotte Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "0045002000630068006900200070007500F20020006400690072006C006F003F0020004E0075006C006C0061002000E80020006D0061006900200063006500720074006F000A006E0065006C0020006D006F006E0064006F002000640065006C006C00650020006C006F00740074006500200050006F006B00E9006D006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "I tuoi Pokémon sono troppo forti!\nSei un fenomeno!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "0049002000740075006F006900200050006F006B00E9006D006F006E00200073006F006E006F002000740072006F00700070006F00200066006F0072007400690021000A00530065006900200075006E002000660065006E006F006D0065006E006F002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ma riuscirai a mantenerti facendo\nsolo l’Allenatrice?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "004D00610020007200690075007300630069007200610069002000610020006D0061006E00740065006E006500720074006900200066006100630065006E0064006F000A0073006F006C006F0020006C20190041006C006C0065006E006100740072006900630065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Sei mia sorella, e io farò sempre\nil tifo per te!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "0053006500690020006D0069006100200073006F00720065006C006C0061002C0020006500200069006F002000660061007200F2002000730065006D007000720065000A0069006C0020007400690066006F002000700065007200200074006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "C’è uno in azienda che mi sta proprio qui! Come\nvorrei dargli una bella lezione sul campo di lotta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Sì, come ti capisco. Guarda, lo farei anch’io.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "005300EC002C00200063006F006D00650020007400690020006300610070006900730063006F002E0020004700750061007200640061002C0020006C006F00200066006100720065006900200061006E0063006820190069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "La crème brûlée è il non plus ultra...\nAnzi, più che ultra!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1732,
      "rawDecodedUtf16Hex": "004C006100200063007200E8006D006500200062007200FB006C00E90065002000E800200069006C0020006E006F006E00200070006C0075007300200075006C007400720061002E002E002E000A0041006E007A0069002C00200070006900F9002000630068006500200075006C00740072006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "La superficie è caramellata alla\nperfezione!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1852,
      "rawDecodedUtf16Hex": "004C006100200073007500700065007200660069006300690065002000E800200063006100720061006D0065006C006C00610074006100200061006C006C0061000A00700065007200660065007A0069006F006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Un ristorante per amanti delle lotte e del buon\ncibo, quindi. Però, interessante!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Lo chef Teotimo ha aperto questo posto per\ndedicarsi alle sue due grandi passioni: la cucina<U+0010><U+0001>븀\ne le lotte Pokémon.<U+0010><U+0001>븁\nA pensarci bene... non so quanto senso abbia...",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2108,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 167
    },
    {
      "displayText": "Ogni pietanza di questo ristorante va mangiata\na tempo debito.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2444,
      "rawDecodedUtf16Hex": "004F0067006E0069002000700069006500740061006E007A0061002000640069002000710075006500730074006F00200072006900730074006F00720061006E007400650020007600610020006D0061006E00670069006100740061000A0061002000740065006D0070006F002000640065006200690074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ti va bene se facciamo una lotta\ndopo mangiato?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2572,
      "rawDecodedUtf16Hex": "00540069002000760061002000620065006E00650020007300650020006600610063006300690061006D006F00200075006E00610020006C006F007400740061000A0064006F0070006F0020006D0061006E0067006900610074006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Volentieri! Non c’è modo migliore\nper capire se c’è sintonia!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2668,
      "rawDecodedUtf16Hex": "0056006F006C0065006E0074006900650072006900210020004E006F006E00200063201900E80020006D006F0064006F0020006D00690067006C0069006F00720065000A007000650072002000630061007000690072006500200073006500200063201900E8002000730069006E0074006F006E0069006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Ho allenato il mio Pokémon, e ora\napprezza anche i dolci più ricercati!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2792,
      "rawDecodedUtf16Hex": "0048006F00200061006C006C0065006E00610074006F00200069006C0020006D0069006F00200050006F006B00E9006D006F006E002C002000650020006F00720061000A00610070007000720065007A007A006100200061006E0063006800650020006900200064006F006C0063006900200070006900F9002000720069006300650072006300610074006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Per oggi ho lavorato anche troppo.\nMi merito una bella pausa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2936,
      "rawDecodedUtf16Hex": "0050006500720020006F00670067006900200068006F0020006C00610076006F007200610074006F00200061006E006300680065002000740072006F00700070006F002E000A004D00690020006D0065007200690074006F00200075006E0061002000620065006C006C006100200070006100750073006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Non riesco a pensare ad altro che\na cibi e bevande...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3060,
      "rawDecodedUtf16Hex": "004E006F006E002000720069006500730063006F00200061002000700065006E007300610072006500200061006400200061006C00740072006F0020006300680065000A0061002000630069006200690020006500200062006500760061006E00640065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "È importante capire già da giovani che cos’è\nil buon cibo! Su, non fare complimenti!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 3168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Il cibo più buono è quello mangiato in compagnia!\nIl posto non importa, basta che sia mangiabile.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Una volta provato il cibo del Ristorante Gourmet,\ntutto il resto sembra non avere più sapore!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Secondo me solo mangiando i piatti del Ristorante\nGourmet si può capire davvero la qualità di tutti<U+0010><U+0001>븀\ngli altri cibi!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    }
