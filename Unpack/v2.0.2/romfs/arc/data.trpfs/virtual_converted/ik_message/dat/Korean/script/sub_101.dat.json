      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "00100002BDFF002A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
