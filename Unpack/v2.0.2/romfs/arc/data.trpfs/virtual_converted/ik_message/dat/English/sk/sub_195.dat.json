      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2180,
      "rawDecodedUtf16Hex": "0049006600200079006F00752019006400200062006500200073006F0020006B0069006E0064002C0020007400680065006E002E00100002011401EA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Peh!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
