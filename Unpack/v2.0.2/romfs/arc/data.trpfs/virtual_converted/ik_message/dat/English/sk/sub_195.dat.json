      "offsetInSection": 2268,
      "rawDecodedUtf16Hex": "004D006F00720072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Oh no!<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "004F00680020006E006F002100100002011401EA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "The Morpeko have worked up an appetite battling,\nand now they’ve given in to their darker natures!<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "This won’t work at all! We can’t have Quasartico’s\nguards acting like that!<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "I think I’ll just recommend that we keep our cute,\nstrong, reliable Dedenne...as we always have.<U+0010><U+0002>ĔǪ",
