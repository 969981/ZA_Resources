  "messages": [
    {
      "displayText": "Have you heard? There’s been some trouble\nwithin Quasartico over our guard Pokémon.<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
