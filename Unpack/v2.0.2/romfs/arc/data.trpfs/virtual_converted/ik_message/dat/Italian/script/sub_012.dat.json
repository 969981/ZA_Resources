      "rawDecodedUtf16Hex": "004400650076006F002000640069007200650020006300680065002000710075006500730074006F002000700072006F00660075006D006F0020006D00690020007200690063006800690061006D006100200061006C006C0061000A006D0065006E00740065002000740061006E007400690020007200690063006F007200640069002E00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Come quando, da piccola, salivo in groppa agli\nSkiddo e percorrevo tutta Luminopoli.<U+0010><U+0002>Ĕı",
