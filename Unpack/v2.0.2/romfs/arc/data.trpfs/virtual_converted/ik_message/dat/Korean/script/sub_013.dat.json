      "rawDecodedUtf16Hex": "D3ECCF13BAAC0020D5A5C218C7580020AC00B2A5C131C7400020BB34AD81BB34C9C4D558B124C6940021000AB2E4C74CC5D0B3C40020C7980020BD80D0C1B4DCB9B4AC8CC694002E00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
