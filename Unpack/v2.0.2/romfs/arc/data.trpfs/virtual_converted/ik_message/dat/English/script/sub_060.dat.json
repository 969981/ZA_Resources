      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "I’ll leave the gate unlocked for you.<U+0010><U+0001>븁\nCome join me inside...but make sure you’re ready\nfor anything!<U+0010><U+0002>Ĕś",
