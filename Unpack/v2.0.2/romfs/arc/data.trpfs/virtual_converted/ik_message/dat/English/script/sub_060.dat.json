      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "I’ve actually been thinking of a sweet new\nbusiness venture I could start down there.<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
