      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "00BF00440065002000630061007300750061006C00690064006100640020006E006F0020007300610062007200E10073002000640065002000710075006900E9006E00200065007300200065006C00200047006F006F006D0079003F001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
