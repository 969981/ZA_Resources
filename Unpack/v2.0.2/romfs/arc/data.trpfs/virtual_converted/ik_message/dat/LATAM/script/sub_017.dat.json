      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "005100750065007200ED0061002000610063006100720069006300690061007200200061006C00200047006F006F006D00790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
