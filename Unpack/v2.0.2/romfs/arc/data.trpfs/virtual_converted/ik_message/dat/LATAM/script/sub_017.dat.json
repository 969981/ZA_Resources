      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Hmm...<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "0048006D006D002E002E002E001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¿Y estás segur<U+0010><U+0003>ᄀÿāoa de que el Goomy no es tuyo?<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
