      "index": 14,
      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "0045006E007400690065006E0064006F002E002E002E001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Hmm...<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "0048006D006D002E002E002E001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¿Y entonces qué estabas haciendo en esta banca,\nsi el Goomy no es tuyo?<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
