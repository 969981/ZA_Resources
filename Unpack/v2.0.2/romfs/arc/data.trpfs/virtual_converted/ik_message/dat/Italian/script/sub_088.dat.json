      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Lasci che rimetta in sesto la sua squadra.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3948,
