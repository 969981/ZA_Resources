      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sí, me rindo",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2464,
      "rawDecodedUtf16Hex": "005300ED002C0020006D0065002000720069006E0064006F0000",
