  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "0010000201000000002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Lei dev’essere <U+0010><U+0003>ᄀÿȂilla nobile <U+0010><U+0002>Ā<U+0000>,\nrivale del nobile Albis!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "004C0065006900200064006500762019006500730073006500720065002000100003110000FF02020069006C006C00610020006E006F00620069006C006500200010000201000000002C000A0072006900760061006C0065002000640065006C0020006E006F00620069006C006500200041006C006200690073002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Si sente spesso parlare di lei.<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "00530069002000730065006E00740065002000730070006500730073006F0020007000610072006C0061007200650020006400690020006C00650069002E00100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Io mi chiamo Jeté, e amo il Pokémon Throh.<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "0049006F0020006D006900200063006800690061006D006F0020004A0065007400E9002C0020006500200061006D006F00200069006C00200050006F006B00E9006D006F006E0020005400680072006F0068002E00100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "No! Volevo dirlo prima io! Prepotente come tutti\ngli amanti di Throh!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "004E006F002100200056006F006C00650076006F0020006400690072006C006F0020007000720069006D006100200069006F002100200050007200650070006F00740065006E0074006500200063006F006D0065002000740075007400740069000A0067006C006900200061006D0061006E007400690020006400690020005400680072006F0068002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Io mi chiamo Frappé e amo il Pokémon Sawk alla\nfollia.<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "0049006F0020006D006900200063006800690061006D006F00200046007200610070007000E90020006500200061006D006F00200069006C00200050006F006B00E9006D006F006E0020005300610077006B00200061006C006C0061000A0066006F006C006C00690061002E00100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Permettimi di spiegarti la situazione,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "00100002BD060000005000650072006D0065007400740069006D006900200064006900200073007000690065006700610072007400690020006C0061002000730069007400750061007A0069006F006E0065002C000A0010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Questi gentili signori amano rispettivamente\nSawk e Throh.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "005100750065007300740069002000670065006E00740069006C00690020007300690067006E006F0072006900200061006D0061006E006F00200072006900730070006500740074006900760061006D0065006E00740065000A005300610077006B002000650020005400680072006F0068002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "E hanno quindi deciso di stabilire quale dei due\nPokémon sia il più forte tramite una lotta.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Sto cercando il quinto membro della mia squadra.\nVorrei il suo aiuto, signor<U+0010><U+0003>ᄀÿ̀ina <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 7,
      "flagsUpper16": 8,
      "index": 9,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Argh, mi hai anticipato di nuovo! Non si può mai\nabbassare la guardia con voi amanti di Throh!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Anche la mia squadra sta cercando un quinto\nmembro!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1924,
      "rawDecodedUtf16Hex": "0041006E0063006800650020006C00610020006D00690061002000730071007500610064007200610020007300740061002000630065007200630061006E0064006F00200075006E0020007100750069006E0074006F000A006D0065006D00620072006F002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Vi prego di calmarvi.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2036,
      "rawDecodedUtf16Hex": "0056006900200070007200650067006F002000640069002000630061006C006D0061007200760069002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0001>븁\nA chi preferiresti dare manforte?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2088,
      "rawDecodedUtf16Hex": "0010000201000000002E00100001BE01000A004100200063006800690020007000720065006600650072006900720065007300740069002000640061007200650020006D0061006E0066006F007200740065003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Nobile <U+0010><U+0002>Ā<U+0000>! La prego, dia una mano\nalla squadra del mio Sawk!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "004E006F00620069006C00650020001000020100000000210020004C006100200070007200650067006F002C002000640069006100200075006E00610020006D0061006E006F000A0061006C006C006100200073007100750061006400720061002000640065006C0020006D0069006F0020005300610077006B002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Signor<U+0010><U+0003>ᄀÿ̀ina <U+0010><U+0002>Ā<U+0000>! La prego di unirsi\nalla squadra del mio Throh.<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2320,
      "rawDecodedUtf16Hex": "005300690067006E006F007200100003110000FF03000069006E00610020001000020100000000210020004C006100200070007200650067006F00200064006900200075006E0069007200730069000A0061006C006C006100200073007100750061006400720061002000640065006C0020006D0069006F0020005400680072006F0068002E00100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2464,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Torna da me quando avrai con te solo un Sawk o\nun Throh.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2476,
      "rawDecodedUtf16Hex": "0054006F0072006E00610020006400610020006D00650020007100750061006E0064006F00200061007600720061006900200063006F006E00200074006500200073006F006C006F00200075006E0020005300610077006B0020006F000A0075006E0020005400680072006F0068002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Hai con te un Sawk. Vuoi dunque unirti\nalla squadra di Sawk?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "00480061006900200063006F006E00200074006500200075006E0020005300610077006B002E002000560075006F0069002000640075006E00710075006500200075006E0069007200740069000A0061006C006C0061002000730071007500610064007200610020006400690020005300610077006B003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Hai con te un Throh. Vuoi dunque unirti\nalla squadra di Throh?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2732,
      "rawDecodedUtf16Hex": "00480061006900200063006F006E00200074006500200075006E0020005400680072006F0068002E002000560075006F0069002000640075006E00710075006500200075006E0069007200740069000A0061006C006C0061002000730071007500610064007200610020006400690020005400680072006F0068003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Sì!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2868,
      "rawDecodedUtf16Hex": "005300EC00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Aspetta...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2876,
      "rawDecodedUtf16Hex": "0041007300700065007400740061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "D’accordo! Rifletti con attenzione prima di\ndecidere con chi fare squadra.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2900,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Signor Frappé, abbiamo un aiutante per\nla squadra di Sawk.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3060,
      "rawDecodedUtf16Hex": "005300690067006E006F007200200046007200610070007000E9002C002000610062006200690061006D006F00200075006E002000610069007500740061006E007400650020007000650072000A006C0061002000730071007500610064007200610020006400690020005300610077006B002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "La mia vittoria è assicurata!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3188,
      "rawDecodedUtf16Hex": "004C00610020006D0069006100200076006900740074006F007200690061002000E800200061007300730069006300750072006100740061002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Signora Jeté, abbiamo un aiutante per\nla squadra di Throh.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3256,
      "rawDecodedUtf16Hex": "005300690067006E006F007200610020004A0065007400E9002C002000610062006200690061006D006F00200075006E002000610069007500740061006E007400650020007000650072000A006C0061002000730071007500610064007200610020006400690020005400680072006F0068002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ha scelto la squadra di Throh! Quale onore!<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 3384,
      "rawDecodedUtf16Hex": "004800610020007300630065006C0074006F0020006C0061002000730071007500610064007200610020006400690020005400680072006F006800210020005100750061006C00650020006F006E006F00720065002100100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Diamo dunque inizio all’incontro tra la squadra di\nSawk e quella di Throh!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3480,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Se permettete, farò da arbitro al vostro incontro.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3640,
      "rawDecodedUtf16Hex": "005300650020007000650072006D006500740074006500740065002C002000660061007200F20020006400610020006100720062006900740072006F00200061006C00200076006F007300740072006F00200069006E0063006F006E00740072006F002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Ripassiamo il regolamento.<U+0010><U+0001>븁\nSi affronteranno, in ordine: prima linea, seconda\nlinea, centrali, vicecomandanti, comandanti.<U+0010><U+0001>븀\nVince chi conquista il maggior numero di vittorie.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3752,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 183
    },
    {
      "displayText": "INIZIATE!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 4120,
      "rawDecodedUtf16Hex": "0049004E0049005A0049004100540045002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Si sfidino i membri della prima linea!\nSawk il tornado contro Throh il fulmine!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "PRIMA VITTORIA!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4316,
      "rawDecodedUtf16Hex": "005000520049004D004100200056004900540054004F005200490041002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Ha vinto Sawk il tornado!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 4356,
      "rawDecodedUtf16Hex": "00480061002000760069006E0074006F0020005300610077006B00200069006C00200074006F0072006E00610064006F002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Si sfidino i membri della seconda linea!\nSawk la burrasca contro Throh il vigoroso!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4416,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "SECONDA VITTORIA!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4592,
      "rawDecodedUtf16Hex": "005300450043004F004E0044004100200056004900540054004F005200490041002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Ha vinto Throh il vigoroso!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4636,
      "rawDecodedUtf16Hex": "00480061002000760069006E0074006F0020005400680072006F006800200069006C0020007600690067006F0072006F0073006F002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Si sfidino i membri centrali! Sawk l’inamovibile\ncontro Throh piede alato!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "TERZA VITTORIA!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4860,
      "rawDecodedUtf16Hex": "005400450052005A004100200056004900540054004F005200490041002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Ha vinto Throh piede alato! Siamo a due vittorie\ne una sconfitta per la squadra di Throh!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 4900,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Si sfidino i vicecomandanti! Sawk colpo letale\ncontro Throh il maestro!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "QUARTA VITTORIA!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5240,
      "rawDecodedUtf16Hex": "00510055004100520054004100200056004900540054004F005200490041002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Ha vinto Sawk colpo letale! Abbiamo raggiunto\nun pareggio!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 5284,
      "rawDecodedUtf16Hex": "00480061002000760069006E0074006F0020005300610077006B00200063006F006C0070006F0020006C006500740061006C00650021002000410062006200690061006D006F0020007200610067006700690075006E0074006F000A0075006E00200070006100720065006700670069006F002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Ed eccoci finalmente alla sfida dei comandanti.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 5412,
      "rawDecodedUtf16Hex": "004500640020006500630063006F00630069002000660069006E0061006C006D0065006E0074006500200061006C006C0061002000730066006900640061002000640065006900200063006F006D0061006E00640061006E00740069002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Si sfidino i comandanti! Sawk la carta vincente\ncontro Throh il demone rosso!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Si sfidino i comandanti! Sawk il demone blu\ncontro Throh la carta vincente!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5680,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "CHE INIZI LA LOTTA!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5840,
      "rawDecodedUtf16Hex": "00430048004500200049004E0049005A00490020004C00410020004C004F005400540041002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>뷿/",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5888,
      "rawDecodedUtf16Hex": "00100002BDFF002F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "VITTORIA FINALE!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5900,
      "rawDecodedUtf16Hex": "0056004900540054004F005200490041002000460049004E0041004C0045002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ha vinto <U+0010><U+0002>Ā<U+0000>, comandante della\nsquadra di Sawk!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5944,
      "rawDecodedUtf16Hex": "00100002BD06000000480061002000760069006E0074006F00200010000201000000002C00200063006F006D0061006E00640061006E00740065002000640065006C006C0061000A00730071007500610064007200610020006400690020005300610077006B002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Evvai! Gli abbiamo dimostrato quant’è strabiliante\nSawk!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 50,
      "offsetInSection": 6060,
      "rawDecodedUtf16Hex": "00450076007600610069002100200047006C0069002000610062006200690061006D006F002000640069006D006F00730074007200610074006F0020007100750061006E0074201900E80020007300740072006100620069006C00690061006E00740065000A005300610077006B002100100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Siete stati magnifici!<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6184,
      "rawDecodedUtf16Hex": "005300690065007400650020007300740061007400690020006D00610067006E00690066006900630069002100100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Grazie! Ma questa vittoria si deve al<U+0010><U+0003>ᄀÿȀla nobile\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0001>븁\nLa prossima volta sarai tu a dimostrarmi quanto\nè speciale Throh.<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6240,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 131
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ha vinto <U+0010><U+0002>Ā<U+0000>, comandante della\nsquadra di Throh!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 6504,
      "rawDecodedUtf16Hex": "00100002BD06000000480061002000760069006E0074006F00200010000201000000002C00200063006F006D0061006E00640061006E00740065002000640065006C006C0061000A00730071007500610064007200610020006400690020005400680072006F0068002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Evviva! Una vittoria che sancisce la magnificenza\ndi Throh!<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 54,
      "offsetInSection": 6620,
      "rawDecodedUtf16Hex": "004500760076006900760061002100200055006E006100200076006900740074006F0072006900610020006300680065002000730061006E006300690073006300650020006C00610020006D00610067006E00690066006900630065006E007A0061000A006400690020005400680072006F0068002100100002011401C90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Ci avrei giurato... Nessuno può nulla contro i lanci\ndi Throh.<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 6748,
      "rawDecodedUtf16Hex": "004300690020006100760072006500690020006700690075007200610074006F002E002E002E0020004E0065007300730075006E006F00200070007500F20020006E0075006C006C006100200063006F006E00740072006F002000690020006C0061006E00630069000A006400690020005400680072006F0068002E00100002011401C80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Grazie mille!<U+0010><U+0001>븁\nMa non avremmo mai vinto senza <U+0010><U+0003>ᄀÿȂilla signor<U+0010><U+0003>ᄀÿ̀ina\n<U+0010><U+0002>Ā<U+0000>. La prossima volta mi<U+0010><U+0001>븀\ndimostrerai quanto è straordinario Sawk.<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 13,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 6884,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 148
    },
    {
      "displayText": "A prescindere dall’esito, avete dimostrato una\nsportività lodevole, complimentandovi a vicenda.<U+0010><U+0001>븁\nÈ proprio questo lo spirito delle arti marziali!\nComplimenti, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 8,
      "flagsUpper16": 4,
      "index": 57,
      "offsetInSection": 7180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 171
    },
    {
      "displayText": "Il prossimo obiettivo della squadra di Sawk\nè convincerla a unirsi a noi per sempre!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 7524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Le riserverò il posto di comandante a vita nella\nsquadra dei miei Throh, signor<U+0010><U+0003>ᄀÿ̀ina<U+0010><U+0001>븀\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕǉ",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7704,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 7916,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Il prossimo obiettivo della squadra di Sawk\nè convincerla a unirsi perennemente a noi!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 61,
      "offsetInSection": 7928,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
