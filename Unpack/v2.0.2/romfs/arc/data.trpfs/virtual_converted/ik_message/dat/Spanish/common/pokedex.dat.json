      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Habita en zonas elevadas. Es común\navistarlo en las copas de los árboles.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 104,
      "offsetInSection": 2864,
      "rawDecodedUtf16Hex": "00480061006200690074006100200065006E0020007A006F006E0061007300200065006C006500760061006400610073002E00200045007300200063006F006D00FA006E000A0061007600690073007400610072006C006F00200065006E0020006C0061007300200063006F0070006100730020006400650020006C006F0073002000E100720062006F006C00650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
