      "flagsUpper16": 0,
      "index": 110,
      "offsetInSection": 3652,
      "rawDecodedUtf16Hex": "00480061006200690074006100200065006E002000630061006C006C0065006A006F006E00650073002E000A0045007300200063006F006D00FA006E00200061007600690073007400610072006C006F0020006A0075006E0074006F002000610020006300750062006F00730020006400650020006200610073007500720061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
