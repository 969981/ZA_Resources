      "flagsUpper16": 0,
      "index": 108,
      "offsetInSection": 3388,
      "rawDecodedUtf16Hex": "00480061006200690074006100200065006E0020007A006F006E0061007300200065006C006500760061006400610073002E000A004500730020007200610072006F0020006100760069007300740061007200200075006E00200065006A0065006D0070006C00610072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
