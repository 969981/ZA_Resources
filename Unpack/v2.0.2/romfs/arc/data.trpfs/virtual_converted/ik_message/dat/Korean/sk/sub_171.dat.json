      "rawDecodedUtf16Hex": "D55CD3100021002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "승자!\n타격귀 팀 대장, <U+0010><U+0002>Ā<U+0000> 씨!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
