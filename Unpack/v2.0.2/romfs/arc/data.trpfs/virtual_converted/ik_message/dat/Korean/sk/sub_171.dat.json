      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "만세!\n타격귀의 훌륭함을 증명해 보였네요!<U+0010><U+0002>Ĕǈ",
      "escapedControlUnits": 2,
