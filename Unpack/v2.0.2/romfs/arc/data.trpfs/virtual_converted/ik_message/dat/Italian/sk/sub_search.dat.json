      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "004F007400740069006D006F0020006C00610076006F0072006F002E00100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
