      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "要对战！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "89815BF96218FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
