      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "54BB54CE554AFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
