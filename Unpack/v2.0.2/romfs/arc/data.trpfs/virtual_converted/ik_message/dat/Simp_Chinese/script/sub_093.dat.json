      "rawDecodedUtf16Hex": "2026202654BB54CE554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "很高兴能和你对战！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
