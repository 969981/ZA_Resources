      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "欢迎光临！\n这里是为喜欢联机的人<U+0010><U+0001>븀\n开设的咖啡店“帕生”。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 2588,
      "rawDecodedUtf16Hex": "6B228FCE51494E34FF01000A8FD991CC662F4E3A559C6B228054673A76844EBA00100001BE00000A5F008BBE7684549655615E97201C5E15751F201D30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "欢迎光临！\n这里是有趣客人的聚集地，<U+0010><U+0001>븀\n咖啡馆“龙卷风”。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 2652,
      "rawDecodedUtf16Hex": "6B228FCE51494E34FF01000A8FD991CC662F67098DA35BA24EBA7684805A96C65730FF0C00100001BE00000A549655619986201C9F99537798CE201D30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "欢迎光临！\n这里是时尚爱好者的聚集地，<U+0010><U+0001>븀\n咖啡馆“时髦”。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 2716,
      "rawDecodedUtf16Hex": "6B228FCE51494E34FF01000A8FD991CC662F65F65C1A7231597D80057684805A96C65730FF0C00100001BE00000A549655619986201C65F69AE6201D30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "欢迎光临！\n这里是为热爱多丽米亚的人<U+0010><U+0001>븀\n而开的咖啡馆“汪汪”。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
