  "messages": [
    {
      "displayText": "Más allá de\nesta estación...<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 180,
      "rawDecodedUtf16Hex": "004D00E1007300200061006C006C00E1002000640065000A0065007300740061002000650073007400610063006900F3006E002E002E002E00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Más allá de esta estación nos espera un futuro\nprometedor junto a los Pokémon.<U+0010><U+0001>븁\n¡La gente de regiones lejanas siempre se queda\nasombrada al ver las calles de Ciudad Luminalia!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 178
    },
    {
      "displayText": "Tengo ganas de un\ncombate Pokémon.<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "00540065006E0067006F002000670061006E0061007300200064006500200075006E000A0063006F006D006200610074006500200050006F006B00E9006D006F006E002E00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Vine a Ciudad Luminalia para experimentar\nla emoción de un buen combate.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 724,
      "rawDecodedUtf16Hex": "00560069006E00650020006100200043006900750064006100640020004C0075006D0069006E0061006C00690061002000700061007200610020006500780070006500720069006D0065006E007400610072000A006C006100200065006D006F0063006900F3006E00200064006500200075006E0020006200750065006E00200063006F006D0062006100740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¡Hay tantas cafeterías en Ciudad Luminalia!\nSeguro que mi papá se pasará cuatro horas<U+0010><U+0001>븀\ndecidiendo a cuál ir.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "¿Nos tomamos un descanso en alguna\ncafetería cercana?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1096,
      "rawDecodedUtf16Hex": "00BF004E006F007300200074006F006D0061006D006F007300200075006E002000640065007300630061006E0073006F00200065006E00200061006C00670075006E0061000A006300610066006500740065007200ED0061002000630065007200630061006E0061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "La verdad es que, después de trece horas de viaje,\nestoy agotadísima.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "004C006100200076006500720064006100640020006500730020007100750065002C00200064006500730070007500E9007300200064006500200074007200650063006500200068006F0072006100730020006400650020007600690061006A0065002C000A006500730074006F0079002000610067006F00740061006400ED00730069006D0061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡Qué emoción! ¡A ver con qué\nPokémon nos encontramos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1344,
      "rawDecodedUtf16Hex": "00A10051007500E900200065006D006F0063006900F3006E0021002000A10041002000760065007200200063006F006E00200071007500E9000A0050006F006B00E9006D006F006E0020006E006F007300200065006E0063006F006E007400720061006D006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "En Ciudad Luminalia hay\nPokémon salvajes por las calles.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1452,
      "rawDecodedUtf16Hex": "0045006E00200043006900750064006100640020004C0075006D0069006E0061006C006900610020006800610079000A0050006F006B00E9006D006F006E002000730061006C00760061006A0065007300200070006F00720020006C00610073002000630061006C006C00650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¡Ya llegamos,\nCiudad Luminalia!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "00A1005900610020006C006C006500670061006D006F0073002C000A0043006900750064006100640020004C0075006D0069006E0061006C00690061002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Qué bolso de viaje tan grande!\nEspero que disfrutes tu visita a Ciudad Luminalia.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Me gustaría saber más cosas sobre cómo ha ido\ncambiando la ciudad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "004D0065002000670075007300740061007200ED00610020007300610062006500720020006D00E1007300200063006F00730061007300200073006F0062007200650020006300F3006D006F002000680061002000690064006F000A00630061006D006200690061006E0064006F0020006C00610020006300690075006400610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Esta es una ciudad con mucha historia,\npero también es una ciudad muy innovadora.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
