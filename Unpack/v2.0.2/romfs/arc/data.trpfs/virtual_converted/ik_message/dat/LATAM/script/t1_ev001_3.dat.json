      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Voy a aprovechar cada segundo en esta ciudad\ny me ganaré esa bienvenida.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2240,
      "rawDecodedUtf16Hex": "0056006F0079002000610020006100700072006F0076006500630068006100720020006300610064006100200073006500670075006E0064006F00200065006E002000650073007400610020006300690075006400610064000A00790020006D0065002000670061006E0061007200E900200065007300610020006200690065006E00760065006E006900640061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Voy a dejar las maletas en el hotel\ny luego voy a dar un paseo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2388,
      "rawDecodedUtf16Hex": "0056006F007900200061002000640065006A006100720020006C006100730020006D0061006C006500740061007300200065006E00200065006C00200068006F00740065006C000A00790020006C007500650067006F00200076006F007900200061002000640061007200200075006E00200070006100730065006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
