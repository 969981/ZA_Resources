      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡La vista desde el tren es espectacular!\n¡No me esperaba menos de Kalos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2608,
      "rawDecodedUtf16Hex": "00A1004C006100200076006900730074006100200064006500730064006500200065006C0020007400720065006E0020006500730020006500730070006500630074006100630075006C006100720021000A00A1004E006F0020006D00650020006500730070006500720061006200610020006D0065006E006F00730020006400650020004B0061006C006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
