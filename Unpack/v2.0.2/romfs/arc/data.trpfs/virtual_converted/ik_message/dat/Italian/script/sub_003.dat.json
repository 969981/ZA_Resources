  "messages": [
    {
      "displayText": "Ooohi ooohi...<U+0010><U+0001>븁\nAh, ragazz<U+0010><U+0003>ᄀÿāoa, potresti aiutarmi a cercare una\ncosa?<U+0010><U+0002>Ĕħ",
