      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "0042004C00450045005900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Il Sableye ha lasciato l’Anello prezioso\ned è scappato via.<U+0010><U+0002>Ĕħ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "0049006C0020005300610062006C0065007900650020006800610020006C006100730063006900610074006F0020006C20190041006E0065006C006C006F0020007000720065007A0069006F0073006F000A00650064002000E800200073006300610070007000610074006F0020007600690061002E00100002011401270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Il Sableye aveva con sé l’Anello prezioso!<U+0010><U+0002>Ĕħ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "0049006C0020005300610062006C00650079006500200061007600650076006100200063006F006E0020007300E90020006C20190041006E0065006C006C006F0020007000720065007A0069006F0073006F002100100002011401270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Portalo alla signora!<U+0010><U+0002>Ĕħ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "0050006F007200740061006C006F00200061006C006C00610020007300690067006E006F00720061002100100002011401270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
