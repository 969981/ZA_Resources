  "messages": [
    {
      "displayText": "检票口的另一头……<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 180,
      "rawDecodedUtf16Hex": "68C0796853E3768453E64E0059342026202600100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "检票口的另一头充满着\n人们和宝可梦闪耀的日子。<U+0010><U+0001>븁\n从远方来的人会被\n密阿雷的市容吓一跳哦！",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "68C0796853E3768453E64E00593451456EE17740000A4EBA4EEC548C5B9D53EF68A695EA8000768465E55B50300200100001BE01000A4ECE8FDC65B9676576844EBA4F1A88AB000A5BC6963F96F776845E025BB954134E008DF354E6FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "好想打宝可梦对战！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "597D60F362535B9D53EF68A65BF96218FF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我好想在密阿雷市\n打刺激的宝可梦对战啊。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 372,
      "rawDecodedUtf16Hex": "6211597D60F357285BC6963F96F75E02000A6253523A6FC076845B9D53EF68A65BF96218554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "在密阿雷有很多咖啡馆哦。\n选择太多，爸爸他一定会犹豫的。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "57285BC6963F96F767095F88591A54965561998654E63002000A900962E9592A591AFF0C723872384ED64E005B9A4F1A72B98C6B768430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "到咖啡馆休息一下好了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 476,
      "rawDecodedUtf16Hex": "52305496556199864F11606F4E004E0B597D4E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "坐13个小时飞机，\n想说不累也难啊……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "5750003100334E2A5C0F65F698DE673AFF0C000A60F38BF44E0D7D2F4E5F96BE554A202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "好期待能遇到\n怎样的宝可梦啊！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 540,
      "rawDecodedUtf16Hex": "597D671F5F8580FD90475230000A600E683776845B9D53EF68A6554AFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "在密阿雷市内\n也是有野生宝可梦的哦。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "57285BC6963F96F75E025185000A4E5F662F670991CE751F5B9D53EF68A6768454E630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "是密阿雷市啊！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "662F5BC6963F96F75E02554AFF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "好大的旅行包！\n享受你的密阿雷之旅吧。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 656,
      "rawDecodedUtf16Hex": "597D5927768465C5884C5305FF01000A4EAB53D74F6076845BC6963F96F74E4B65C5542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "我打算调查最近\n在密阿雷市发生的变化。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 696,
      "rawDecodedUtf16Hex": "621162537B978C0367E567008FD1000A57285BC6963F96F75E0253D1751F768453D8531630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "密阿雷是一座兼具\n历史底蕴和挑战精神的城市。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "5BC6963F96F7662F4E005EA7517C5177000A538653F25E958574548C631162187CBE795E768457CE5E0230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "密阿雷市啊，我来了！\n来热烈欢迎我吧！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "5BC6963F96F75E02554AFF0C621167654E86FF01000A676570ED70C86B228FCE62115427FF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "当然我也会在密阿雷尽情享受，\n让自己成为值得欢迎的人！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "5F53713662114E5F4F1A57285BC6963F96F75C3D60C54EAB53D7FF0C000A8BA981EA5DF162104E3A503C5F976B228FCE76844EBAFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "先把行李放到旅馆，\n再到市里逛逛吧。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "5148628A884C674E653E523065C59986FF0C000A518D52305E0291CC901B901B542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "是卡洛斯地区的感觉！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "662F53616D1B65AF5730533A7684611F89C9FF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "从车窗看出去的风景\n完全就是卡洛斯地区的感觉呀！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "4ECE8F667A97770B51FA53BB768498CE666F000A5B8C51685C31662F53616D1B65AF5730533A7684611F89C95440FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "从机场到密阿雷市的距离\n意外地远呢。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "4ECE673A573A52305BC6963F96F75E0276848DDD79BB000A610F591657308FDC546230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "只要有搭档宝可梦在，\n一个人旅行这点事我也能做到。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1092,
      "rawDecodedUtf16Hex": "53EA89816709642D68635B9D53EF68A65728FF0C000A4E004E2A4EBA65C5884C8FD970B94E8B62114E5F80FD505A523030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "列车摇得太舒服，\n让我都睡着了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "52178F6664475F97592A8212670DFF0C000A8BA9621190FD776177404E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
