      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "004200750065006E006F002C002000A100790061002000650073007400E10020006C006900730074006F00200065006C002000700065007200660075006D0065002000640065002000560061006E0069006C006C006900740065002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "¡Quién iba a decir que la nieve de Vanillite\ndesprendería este sutil aroma dulzón!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Es muy curioso, pero solo con olerlo me dan\nescalofríos por todo el cuerpo.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1960,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "¡Lo cual me acaba de dar una idea estupenda!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "00A1004C006F0020006300750061006C0020006D0065002000610063006100620061002000640065002000640061007200200075006E0061002000690064006500610020006500730074007500700065006E00640061002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "¡Seguro tendría mucho éxito en Alola!\nCreo que me iría muy bien con los perfumes ahí.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
