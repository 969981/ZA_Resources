    },
    {
      "displayText": "¿Me trajiste un Vanillite? ¡Muchas gracias!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "00BF004D00650020007400720061006A006900730074006500200075006E002000560061006E0069006C006C006900740065003F002000A1004D0075006300680061007300200067007200610063006900610073002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Bueno, entonces le saco un poco de nieve.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1260,
