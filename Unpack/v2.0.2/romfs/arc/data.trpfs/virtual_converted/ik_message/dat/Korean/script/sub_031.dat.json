      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "그러려면 커트하는 테크닉을\n스라크도 터득해야 하지만요...<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 384,
      "rawDecodedUtf16Hex": "ADF8B7ECB824BA740020CEE4D2B8D558B2940020D14CD06CB2C9C744000AC2A4B77CD06CB3C40020D130B4DDD574C57C0020D558C9C0B9CCC694002E002E002E00100002011401420000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "테크닉을 터득하려면 스라크가\n베어가르기를 마스터해야 해요.<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 460,
      "rawDecodedUtf16Hex": "D14CD06CB2C9C7440020D130B4DDD558B824BA740020C2A4B77CD06CAC00000ABCA0C5B4AC00B974AE30B97C0020B9C8C2A4D130D574C57C0020D574C694002E00100002011401420000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "샤샤아!",
