      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "트리미앙이라는 포켓몬은\n털을 커트해서<U+0010><U+0001>븀\n다양한 헤어스타일을 연출할 수 있거든요!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 280,
