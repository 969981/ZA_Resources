      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "超级进化大道！<U+0010><U+0001>븁\n迟早有一天会传开\n一些煞有介事的说法，<U+0010><U+0001>븀\n比如超级进化是从这里发展起来的！<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
