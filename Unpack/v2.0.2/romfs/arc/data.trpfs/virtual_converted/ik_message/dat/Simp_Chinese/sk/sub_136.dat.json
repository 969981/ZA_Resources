      "index": 29,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "621189C95F97975E5E3868D2300200100002011401B20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
