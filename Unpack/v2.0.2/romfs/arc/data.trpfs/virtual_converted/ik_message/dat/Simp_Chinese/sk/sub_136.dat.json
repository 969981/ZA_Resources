      "rawDecodedUtf16Hex": "90A34E48FF0C8FD96761885790534ECA540E5C31547D540D4E3A000A6D256D254E5090534E86300200100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
