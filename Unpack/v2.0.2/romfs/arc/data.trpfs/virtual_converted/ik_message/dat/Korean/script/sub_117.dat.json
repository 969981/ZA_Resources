      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "네, 그저 잘 지내는지라도\n알 수 있으면 만족해요.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1868,
