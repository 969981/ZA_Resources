      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "거기 당신,\n용건만 짧게 말해 봐.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "AC70AE300020B2F9C2E0002C000AC6A9AC74B9CC0020C9E7AC8C0020B9D0D5740020BD10002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "...그렇구나.\n걱정될 만하네.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1508,
