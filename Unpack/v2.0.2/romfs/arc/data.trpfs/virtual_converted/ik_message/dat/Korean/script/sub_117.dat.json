      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "고스트타입 포켓몬에는\n터를 잡고 사는 아이도 있고<U+0010><U+0001>븀\n여기저기 돌아다니는 아이도 있어.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "ACE0C2A4D2B8D0C0C7850020D3ECCF13BAACC5D0B294000AD130B97C0020C7A1ACE00020C0ACB2940020C544C774B3C40020C788ACE000100001BE00000AC5ECAE30C800AE300020B3CCC544B2E4B2C8B2940020C544C774B3C40020C788C5B4002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "그러니까 미리 말해 두는 건데...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1788,
      "rawDecodedUtf16Hex": "ADF8B7ECB2C8AE4C0020BBF8B9AC0020B9D0D5740020B450B2940020AC74B370002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "너무 기대하진 마.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1836,
