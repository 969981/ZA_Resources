      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "C5480020D560B798C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "그럼 계속 곤란해하든지.<U+0010><U+0002>Ĕ<U+0012>",
