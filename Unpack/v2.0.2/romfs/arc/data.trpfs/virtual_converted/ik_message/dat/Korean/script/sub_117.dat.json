      "rawDecodedUtf16Hex": "ADF8B7FC0020ACC4C18D0020ACE4B780D574D558B4E0C9C0002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
