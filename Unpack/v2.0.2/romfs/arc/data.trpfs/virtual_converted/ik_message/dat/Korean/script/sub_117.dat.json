      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "조금 전 설명으로\n찾아야 하는 팬텀의 성격은 파악했어.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "C870AE080020C8040020C124BA85C73CB85C000ACC3EC544C57C0020D558B2940020D32CD140C7580020C131ACA9C7400020D30CC545D588C5B4002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "파트너 샹델라에게\n기척을 찾아 보게 할게.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
