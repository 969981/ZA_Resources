      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "00100002BDFF00030000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres entregarme un Feebas?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200065006E007400720065006700610072006D006500200075006E0020004600650065006200610073003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Toma este",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "0054006F006D0061002000650073007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
