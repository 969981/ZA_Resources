  "messages": [
    {
      "displayText": "A ver, si tanto Magikarp como Feebas comparten\nla categoría de Pokémon Pez...<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 0,
