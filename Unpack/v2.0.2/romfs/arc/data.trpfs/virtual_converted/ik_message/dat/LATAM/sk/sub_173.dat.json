      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "¿Por qué no veo Feebas en Ciudad Luminalia\ncuando sí que hay Magikarp?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "¿Crees que podrías traerme un Feebas para que\nme lo pueda quedar?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "00BF00430072006500650073002000710075006500200070006F0064007200ED00610073002000740072006100650072006D006500200075006E0020004600650065006200610073002000700061007200610020007100750065000A006D00650020006C006F0020007000750065006400610020007100750065006400610072003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0003>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
