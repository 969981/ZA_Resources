      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¿Qué Feebas me quieres entregar?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "00BF0051007500E900200046006500650062006100730020006D00650020007100750069006500720065007300200065006E007400720065006700610072003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Por favor, ¡regálame un Feebas!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 828,
      "rawDecodedUtf16Hex": "0050006F00720020006600610076006F0072002C002000A100720065006700E1006C0061006D006500200075006E0020004600650065006200610073002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "¡Qué alegría, un Feebas! Muchísimas gracias.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "00A10051007500E900200061006C00650067007200ED0061002C00200075006E002000460065006500620061007300210020004D00750063006800ED00730069006D0061007300200067007200610063006900610073002E00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Vaya, ¡es un Feebas bien grandote!\nMuchas gracias.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "0056006100790061002C002000A10065007300200075006E00200046006500650062006100730020006200690065006E0020006700720061006E0064006F007400650021000A004D0075006300680061007300200067007200610063006900610073002E00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Oh, ¿un Feebas brillante? ¡Te lo agradezco!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "004F0068002C002000BF0075006E00200046006500650062006100730020006200720069006C006C0061006E00740065003F002000A1005400650020006C006F0020006100670072006100640065007A0063006F002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "¡¿Un espécimen alfa?! ¡Y encima es brillante!<U+0010><U+0001>븁\nEs un tanto imponente, la verdad, pero te lo\nagradezco mucho, en serio.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "¡Espero que seamos buenos amigos, Feebas!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "00A100450073007000650072006F00200071007500650020007300650061006D006F00730020006200750065006E006F007300200061006D00690067006F0073002C0020004600650065006200610073002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Seguro que Feebas se sentirá como pez en\nel agua dentro de poco y nos haremos amigos!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Fee...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "004600650065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Al final decidí dejar en libertad a Feebas en el\nestanque para que se hiciera amigo de Magikarp.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Ambos son Pokémon Pez, así que seguro que se\nharán buena compañía.<U+0010><U+0001>븁\nEso sí, creo que hay que tener cuidado al liberar\nPokémon salvajes en un hábitat nuevo.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 1968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
