  "initialKey": 0,
  "messages": [
    {
      "displayText": "Ni ha... Haaai,\nirasshaimaseee!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "004E0069002000680061002E002E002E002000480061006100610069002C000A00690072006100730073006800610069006D00610073006500650065002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡En Sushi Tres Delicias, todo está delicioso,\ny hay más de tres platos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "00A10045006E00200053007500730068006900200054007200650073002000440065006C00690063006900610073002C00200074006F0064006F002000650073007400E1002000640065006C006900630069006F0073006F002C000A007900200068006100790020006D00E100730020006400650020007400720065007300200070006C00610074006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Hijo, de verdad, comes como\nsi la comida se fuese a pudrir.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 464,
      "rawDecodedUtf16Hex": "00480069006A006F002C0020006400650020007600650072006400610064002C00200063006F006D0065007300200063006F006D006F000A007300690020006C006100200063006F006D006900640061002000730065002000660075006500730065002000610020007000750064007200690072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "¡Casi me atraganto! Eso me\npasa por comer deprisa...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "00A100430061007300690020006D00650020006100740072006100670061006E0074006F0021002000450073006F0020006D0065000A007000610073006100200070006F007200200063006F006D0065007200200064006500700072006900730061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Dicen que los ingredientes que usan en este\nrestaurante vienen de una región lejana.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "¡Guau, veo que estás muy puesto en el tema!\n(Aunque vienen de la Bahía Azul...).",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "En Sushi Tres Delicias siempre hay\nalguien dispuesto a combatir.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "0045006E00200053007500730068006900200054007200650073002000440065006C006900630069006100730020007300690065006D0070007200650020006800610079000A0061006C0067007500690065006E002000640069007300700075006500730074006F0020006100200063006F006D00620061007400690072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "No sé mucho del tema, pero ¿se\nsupone que este sitio es chic?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1160,
      "rawDecodedUtf16Hex": "004E006F0020007300E90020006D007500630068006F002000640065006C002000740065006D0061002C0020007000650072006F002000BF00730065000A007300750070006F006E006500200071007500650020006500730074006500200073006900740069006F00200065007300200063006800690063003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Si comes con las manos, deberías\nimitar la técnica del chef.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "0053006900200063006F006D0065007300200063006F006E0020006C006100730020006D0061006E006F0073002C00200064006500620065007200ED00610073000A0069006D00690074006100720020006C00610020007400E90063006E006900630061002000640065006C00200063006800650066002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "¡No hay nada como disfrutar de un\nbuen sushi sin dejarse una pasta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "00A1004E006F00200068006100790020006E00610064006100200063006F006D006F002000640069007300660072007500740061007200200064006500200075006E000A006200750065006E002000730075007300680069002000730069006E002000640065006A006100720073006500200075006E006100200070006100730074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "¿Cómo se le ocurriría esta\nforma de comer a alguien?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1544,
      "rawDecodedUtf16Hex": "00BF004300F3006D006F0020007300650020006C00650020006F00630075007200720069007200ED006100200065007300740061000A0066006F0072006D006100200064006500200063006F006D006500720020006100200061006C0067007500690065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "No sabe igual que\nel restaurante de Alola...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "004E006F0020007300610062006500200069006700750061006C0020007100750065000A0065006C002000720065007300740061007500720061006E0074006500200064006500200041006C006F006C0061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Sé que algún día me superarás...\nPara ello debes entrenar el paladar.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "005300E9002000710075006500200061006C006700FA006E0020006400ED00610020006D00650020007300750070006500720061007200E10073002E002E002E000A005000610072006100200065006C006C006F00200064006500620065007300200065006E007400720065006E0061007200200065006C002000700061006C0061006400610072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡Quiero ser Entrenador,\nademás de chef de sushi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1884,
      "rawDecodedUtf16Hex": "00A100510075006900650072006F002000730065007200200045006E007400720065006E00610064006F0072002C000A006100640065006D00E100730020006400650020006300680065006600200064006500200073007500730068006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Esperamos que la comida\nsea de su agrado.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1984,
      "rawDecodedUtf16Hex": "004500730070006500720061006D006F007300200071007500650020006C006100200063006F006D006900640061000A007300650061002000640065002000730075002000610067007200610064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "No estoy segura de que la relación calidad-precio\nde este sitio sea demasiado buena...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Sushi de jamón con mayonesa y pesto...\nEste maridaje es cosa de magia...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "005300750073006800690020006400650020006A0061006D00F3006E00200063006F006E0020006D00610079006F006E0065007300610020007900200070006500730074006F002E002E002E000A00450073007400650020006D00610072006900640061006A006500200065007300200063006F007300610020006400650020006D0061006700690061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Hay que tener la actitud de probar cosas nuevas.\nEso también se aplica a los combates, ¿no crees?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Sí, ¡lo importante es no ofuscarse y disfrutar del\ncombate, sin importar quién sea el rival!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "¿Qué desea <U+0010><U+0003>ᄀÿଋel señoritola señorita?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "00BF0051007500E9002000640065007300650061002000100003110000FF0B0B0065006C00200073006500F1006F007200690074006F006C006100200073006500F1006F0072006900740061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Me encanta el sushi. Si empiezo,\nno hay quien me pare.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2856,
      "rawDecodedUtf16Hex": "004D006500200065006E00630061006E0074006100200065006C002000730075007300680069002E00200053006900200065006D007000690065007A006F002C000A006E006F002000680061007900200071007500690065006E0020006D006500200070006100720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Con el sushi siempre acabo\ncomiendo más de lo previsto.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "0043006F006E00200065006C0020007300750073006800690020007300690065006D00700072006500200061006300610062006F000A0063006F006D00690065006E0064006F0020006D00E100730020006400650020006C006F00200070007200650076006900730074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "¡No comas mucho\no te entrará sueño!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3080,
      "rawDecodedUtf16Hex": "00A1004E006F00200063006F006D006100730020006D007500630068006F000A006F00200074006500200065006E007400720061007200E1002000730075006500F1006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "¡Cómo pica esto!\n¡Que alguien me traiga agua!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3152,
      "rawDecodedUtf16Hex": "00A1004300F3006D006F002000700069006300610020006500730074006F0021000A00A100510075006500200061006C0067007500690065006E0020006D006500200074007200610069006700610020006100670075006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Es el wasabi. Dicen que en Paldea\nlo untan en los bocadillos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3244,
      "rawDecodedUtf16Hex": "0045007300200065006C0020007700610073006100620069002E00200044006900630065006E002000710075006500200065006E002000500061006C006400650061000A006C006F00200075006E00740061006E00200065006E0020006C006F007300200062006F0063006100640069006C006C006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "¡Con tantos Pokémon en la ciudad, es una\noportunidad de oro para hacer negocios!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Hemos cerrado un contrato, así que ahora toca\ncelebrarlo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3532,
      "rawDecodedUtf16Hex": "00480065006D006F00730020006300650072007200610064006F00200075006E00200063006F006E0074007200610074006F002C00200061007300ED0020007100750065002000610068006F0072006100200074006F00630061000A00630065006C00650062007200610072006C006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Sushi Tres Delicias ya tiene\nrestaurantes en otras regiones.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3648,
      "rawDecodedUtf16Hex": "0053007500730068006900200054007200650073002000440065006C006900630069006100730020007900610020007400690065006E0065000A00720065007300740061007500720061006E00740065007300200065006E0020006F007400720061007300200072006500670069006F006E00650073002E0000",
      "trailingZeroPaddingUnits": 1,
