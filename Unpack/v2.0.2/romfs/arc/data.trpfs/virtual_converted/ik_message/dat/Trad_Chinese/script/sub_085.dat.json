      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "密阿雷的彩色隱形眼鏡粉絲！\n我這就帶給你們全新的世界！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
