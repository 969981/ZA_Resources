      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ready to look after the kiosk for me?<U+0010><U+0002>Ĕǂ",
