  "messages": [
    {
      "displayText": "Hey, Trainer! Could I ask you for a small favor?<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "004800650079002C00200054007200610069006E00650072002100200043006F0075006C006400200049002000610073006B00200079006F007500200066006F00720020006100200073006D0061006C006C0020006600610076006F0072003F00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "My Arctibax is home alone, so I want to step away\nfor a moment to check on it...<U+0010><U+0001>븁\nUnfortunately, I can’t leave the kiosk unattended.<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "Could you take my place here while I’m gone?<U+0010><U+0001>븁\nIf you do a good job, there’ll be a nice bonus in it\nfor you!<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Let me know when you’re ready to look after the\nkiosk!<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "004C006500740020006D00650020006B006E006F00770020007700680065006E00200079006F007520190072006500200072006500610064007900200074006F0020006C006F006F006B0020006100660074006500720020007400680065000A006B0069006F0073006B002100100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0004>",
