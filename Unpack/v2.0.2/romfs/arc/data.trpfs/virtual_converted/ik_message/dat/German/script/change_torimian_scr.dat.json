      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Dann mach dich mal an die Arbeit, Sichlor.\nVerpass diesem Coiffwaff den perfekten Schnitt!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
