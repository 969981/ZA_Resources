      "offsetInSection": 1576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "*schnipp* *schnapp*...<U+0010><U+0002>븂<U+0005> *schnipp* *schnapp*...<U+0010><U+0002>븂<U+0005><U+0010><U+0001>븁\nCoiffwaff gibt ein entzückendes Model ab und\nSichlor einen ebenso entzückenden Friseur! ♪<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
