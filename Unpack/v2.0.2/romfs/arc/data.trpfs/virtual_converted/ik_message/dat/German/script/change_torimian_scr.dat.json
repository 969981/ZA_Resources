      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Soll das ein Scherz sein?\nDu hast doch gar kein Coiffwaff dabei.<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
