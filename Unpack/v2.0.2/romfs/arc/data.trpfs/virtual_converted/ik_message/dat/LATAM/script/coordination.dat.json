  "messages": [
    {
      "displayText": "¡El mejor conjunto,\npara ti!<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 180,
      "rawDecodedUtf16Hex": "00A10045006C0020006D0065006A006F007200200063006F006E006A0075006E0074006F002C000A0070006100720061002000740069002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Soy la mejor asesora de imagen del mundo.\n¡Nadie combina la ropa como yo!<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Y mi nuevo proyecto es nada más y nada\nmenos que...<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 424,
      "rawDecodedUtf16Hex": "00590020006D00690020006E007500650076006F002000700072006F0079006500630074006F0020006500730020006E0061006400610020006D00E10073002000790020006E006100640061000A006D0065006E006F00730020007100750065002E002E002E00100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "¡Tú!<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 536,
      "rawDecodedUtf16Hex": "00A1005400FA002100100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Y para celebrar que nos conocimos,\nte voy a preparar un conjunto sensacional.<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Pero no te preocupes.\n¡El conjunto te lo presto yo sin costo alguno!<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "005000650072006F0020006E006F0020007400650020007000720065006F00630075007000650073002E000A00A10045006C00200063006F006E006A0075006E0074006F0020007400650020006C006F002000700072006500730074006F00200079006F002000730069006E00200063006F00730074006F00200061006C00670075006E006F002100100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¿Qué me dices, cielo?<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "00BF0051007500E90020006D0065002000640069006300650073002C0020006300690065006C006F003F00100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡Quiero transformarte en una estrella de la moda\nde los pies a la cabeza!<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Me encantaría",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "004D006500200065006E00630061006E00740061007200ED00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "No, gracias",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "004E006F002C002000670072006100630069006100730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "¿Cómo? ¡Con la cantidad de posibilidades que se\nabren cuando otra persona elige tus conjuntos!<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Eso sí, hay una condición.<U+0010><U+0001>븁\n¡Puedes cambiarte de ropa cuando quieras, pero\nme tendrás que devolver mi conjunto! ¿Ok?<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Entendido",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1576,
      "rawDecodedUtf16Hex": "0045006E00740065006E006400690064006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
