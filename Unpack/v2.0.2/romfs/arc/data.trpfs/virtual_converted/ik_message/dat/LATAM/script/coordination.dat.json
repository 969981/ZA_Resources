      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2280,
      "rawDecodedUtf16Hex": "005300690020006E006F002000640065007600750065006C00760065007300200065006C00200063006F006E006A0075006E0074006F002C0020006E006F00200070006F0064007200E1007300200063006F006D0070007200610072000A006D00E1007300200072006F007000610020006F002000610063006300650073006F00720069006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
