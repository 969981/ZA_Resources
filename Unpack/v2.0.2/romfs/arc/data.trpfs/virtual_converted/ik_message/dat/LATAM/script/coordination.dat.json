      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2136,
      "rawDecodedUtf16Hex": "00BF00510075006900650072006500730020006400650076006F006C00760065007200200065006C00200063006F006E006A0075006E0074006F002000710075006500200074006500200070007200650073007400610072006F006E003F00100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Devolver",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
