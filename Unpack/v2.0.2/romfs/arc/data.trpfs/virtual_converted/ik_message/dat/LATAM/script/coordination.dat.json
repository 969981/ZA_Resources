      "rawDecodedUtf16Hex": "004D0065006A006F00720020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡Muy bien, allá vamos!\nEl mejor conjunto para ti.<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1616,
      "rawDecodedUtf16Hex": "00A1004D007500790020006200690065006E002C00200061006C006C00E1002000760061006D006F00730021000A0045006C0020006D0065006A006F007200200063006F006E006A0075006E0074006F00200070006100720061002000740069002E00100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "¡Nadie me puede superar en lo que hago! Ahora\neres únic<U+0010><U+0003>ᄀÿāoa en toda Ciudad Luminalia, chéri<U+0010><U+0003>ᄀÿĀe.<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Muy bien, el conjunto es todo tuyo hasta mañana\nen la mañana, ¡que lo disfrutes! ¡Hasta pronto!<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
