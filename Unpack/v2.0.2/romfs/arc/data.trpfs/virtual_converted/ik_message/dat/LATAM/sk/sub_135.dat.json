      "rawDecodedUtf16Hex": "00A1005400720065006D0065006E006400610020007400610070006100200064006500200061006C00630061006E0074006100720069006C006C006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "¡¡Alto ahí!!<U+0010><U+0002>ĔƱ",
