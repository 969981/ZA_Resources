      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bats-toi contre moi en faisant appel\nà un Méga-Ténéfix !<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "0042006100740073002D0074006F006900200063006F006E0074007200650020006D006F006900200065006E002000660061006900730061006E007400200061007000700065006C000A00E000200075006E0020004D00E900670061002D005400E9006E00E90066006900780020002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Ça marche ! Attention les yeux !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
