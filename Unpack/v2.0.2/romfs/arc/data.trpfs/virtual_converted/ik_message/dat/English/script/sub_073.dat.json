    },
    {
      "displayText": "Will you battle me even though I’ve warned you\nabout my Pokémon’s overwhelming power?<U+0010><U+0002>Ĕū",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
