    },
    {
      "displayText": "People tend to make subconscious judgments\nbased on appearance, even if they don’t mean to.<U+0010><U+0002>Ĕū",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Are you able to see others for who they truly are\nbeneath the surface? If so, please battle me.<U+0010><U+0001>븁\nMy Pokémon are so incredibly powerful, I just\ndon’t know what to do with them!<U+0010><U+0002>Ĕū",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 182
    },
    {
      "displayText": "Please come speak to me once you’re prepared\nfor our Pokémon battle.<U+0010><U+0002>Ĕū",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "0050006C006500610073006500200063006F006D006500200073007000650061006B00200074006F0020006D00650020006F006E0063006500200079006F0075201900720065002000700072006500700061007200650064000A0066006F00720020006F0075007200200050006F006B00E9006D006F006E00200062006100740074006C0065002E001000020114016B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0004>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
