      "index": 2,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 143
    },
    {
      "displayText": "Qu’est-ce que t’en dis, <U+0010><U+0002>Ā<U+0000> ?!\nOn se fait un combat à deux contre deux ?!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
