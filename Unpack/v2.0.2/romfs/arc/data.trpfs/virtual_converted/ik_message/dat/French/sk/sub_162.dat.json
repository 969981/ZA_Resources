      "rawDecodedUtf16Hex": "0041007400740065006E0064007300200075006E0020007000650075002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>...\nTu manques d’enthousiasme !<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "0010000201000000002E002E002E000A005400750020006D0061006E00710075006500730020006420190065006E00740068006F00750073006900610073006D00650020002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "C’est mon rôle d’Héritière de connaître toutes\nles Méga-Évolutions !<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
