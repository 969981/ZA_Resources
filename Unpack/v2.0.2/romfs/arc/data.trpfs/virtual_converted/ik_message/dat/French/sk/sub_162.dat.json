  "messages": [
    {
      "displayText": "Comme c’est étrange...\nCet endroit me dit quelque chose !<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
