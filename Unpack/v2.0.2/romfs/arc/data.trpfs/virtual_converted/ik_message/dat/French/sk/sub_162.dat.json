      "rawDecodedUtf16Hex": "0043006F006D006D0065002000632019006500730074002000E9007400720061006E00670065002E002E002E000A00430065007400200065006E00640072006F006900740020006D006500200064006900740020007100750065006C007100750065002000630068006F007300650020002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Pourquoi je me retrouve toujours avec mon frère ?\nMême dans un endroit pareil...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
