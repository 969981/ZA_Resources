      "rawDecodedUtf16Hex": "004C007500670075006C0061006200720065002E002E002E000A004D00E900670061002D00E90076006F006C00750065002C002000650074002000660069006E006900730073006F006E0073002D0065006E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "ON MET LA GOMME !!!<U+0010><U+0002>Ĕƒ",
