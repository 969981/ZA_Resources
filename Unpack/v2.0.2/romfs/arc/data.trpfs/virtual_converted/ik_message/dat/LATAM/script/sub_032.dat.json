    },
    {
      "displayText": "Scyther tiene que mejorar sus habilidades de\npeluquero, así que ¿puedes hacernos otro favor?<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
