      "index": 14,
      "offsetInSection": 2260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Ahora podremos sacarnos de la manga algunos\npeinados un poco más complejos.<U+0010><U+0002>Ĕł",
