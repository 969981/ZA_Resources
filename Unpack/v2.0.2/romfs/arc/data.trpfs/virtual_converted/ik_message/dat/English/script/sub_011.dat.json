      "index": 66,
      "offsetInSection": 8372,
      "rawDecodedUtf16Hex": "0059006F0075002000680061007600650020006D0061007200760065006C006F0075007300200070006F00740065006E007400690061006C0020006100730020006100200050006F006B00E9006D006F006E000A0054007200610069006E00650072002C00200079006F00750020006B006E006F0077002E00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
