      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Well, color me impressed. Again!<U+0010><U+0001>븁\nI should have expected such splendid answers\nfrom one who raised such a splendid Budew.<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 4,
