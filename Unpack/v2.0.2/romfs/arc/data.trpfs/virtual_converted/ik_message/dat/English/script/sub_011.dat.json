      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Is there anything you pay careful attention to in\nBudew’s daily routine?<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 57,
      "offsetInSection": 7212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "I make sure it gets plenty of rest",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
