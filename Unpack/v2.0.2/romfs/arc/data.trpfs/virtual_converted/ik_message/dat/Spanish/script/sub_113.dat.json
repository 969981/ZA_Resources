    },
    {
      "displayText": "¡Atención a lo que tienes aquí! Una de nuestras\nobras maestras: ¡un recorrido de obstáculos solo<U+0010><U+0001>븀\npara los más expertos!<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Ahora mismo, el poseedor del mejor tiempo es...<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 808,
      "rawDecodedUtf16Hex": "00410068006F007200610020006D00690073006D006F002C00200065006C00200070006F0073006500650064006F0072002000640065006C0020006D0065006A006F00720020007400690065006D0070006F002000650073002E002E002E00100002011401890000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "¡Ese Froakie salvaje de ahí!<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "00A1004500730065002000460072006F0061006B00690065002000730061006C00760061006A006500200064006500200061006800ED002100100002011401890000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Froak.",
