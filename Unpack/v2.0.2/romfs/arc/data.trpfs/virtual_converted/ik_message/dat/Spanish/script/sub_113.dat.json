      "index": 8,
      "offsetInSection": 1800,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres hacer frente a la carrera de obstáculos?\nDebes llegar a la meta en <U+0010><U+0002>＀<U+0006>30 segundos <U+0010><U+0002>＀<U+0000>o menos.<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "¡Quiero participar!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "00A100510075006900650072006F0020007000610072007400690063006900700061007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
