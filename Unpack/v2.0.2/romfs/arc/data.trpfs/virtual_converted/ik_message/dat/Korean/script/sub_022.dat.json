      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "C800D76C0020B808C624AF2CAC000020B728AC81AC8C0020D0C0C624B97C0020C2180020C788B3C4B85D000ABD88AF430020D280B2940020D3ECCF13BAAC0020C2B9BD80B97C0020D5740020C8FCC138C6940021001000020114013B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "타오르게 만들어 드릴게요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 788,
