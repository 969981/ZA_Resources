      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Ah, tú eres un<U+0010><U+0003>ᄀÿāoa de l<U+0010><U+0003>ᄀÿāoas que me ayudaron con\nel Hawlucha del techo el otro día.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "¡Oh, te acuerdas de mí!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "00A1004F0068002C0020007400650020006100630075006500720064006100730020006400650020006D00ED00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Y tú eres la mujer que le daba de comer",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "00590020007400FA002000650072006500730020006C00610020006D0075006A0065007200200071007500650020006C00650020006400610062006100200064006500200063006F006D006500720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¡Sí! Pues adivina: después de todo lo que pasó,\npude volver a encontrarme con Hawlucha.<U+0010><U+0001>븁\nAunque el pobre se veía un poco depre...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "Y desde entonces he notado que se comporta\nde forma muy extraña.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "005900200064006500730064006500200065006E0074006F006E0063006500730020006800650020006E006F007400610064006F002000710075006500200073006500200063006F006D0070006F007200740061000A0064006500200066006F0072006D00610020006D0075007900200065007800740072006100F10061002E00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Siempre está con la mirada perdida en\nla distancia, como si estuviera recordando algo...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "¡¡Luchaaa!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "00A100A1004C007500630068006100610061002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "¡Ahí está otra vez! ¿Qué te pasa, Hawlucha?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "00A10041006800ED002000650073007400E10020006F007400720061002000760065007A0021002000BF0051007500E900200074006500200070006100730061002C0020004800610077006C0075006300680061003F00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Ese brillo en su mirada... Creo que tiene\nganas de luchar.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1348,
      "rawDecodedUtf16Hex": "0045007300650020006200720069006C006C006F00200065006E0020007300750020006D00690072006100640061002E002E002E0020004300720065006F00200071007500650020007400690065006E0065000A00670061006E006100730020006400650020006C00750063006800610072002E00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "¡¡Lucha!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "00A100A1004C0075006300680061002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Qué curioso... ¿Crees que te está desafiando\na un combate?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1496,
      "rawDecodedUtf16Hex": "0051007500E900200063007500720069006F0073006F002E002E002E002000BF004300720065006500730020007100750065002000740065002000650073007400E100200064006500730061006600690061006E0064006F000A006100200075006E00200063006F006D0062006100740065003F00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Seguro que quiere la revancha",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "00530065006700750072006F002000710075006500200071007500690065007200650020006C006100200072006500760061006E0063006800610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Es que la otra vez estaba descontrolado",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "0045007300200071007500650020006C00610020006F007400720061002000760065007A002000650073007400610062006100200064006500730063006F006E00740072006F006C00610064006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¿Cómo? No sé si entiendo muy bien a qué te\nrefieres.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "00BF004300F3006D006F003F0020004E006F0020007300E900200073006900200065006E007400690065006E0064006F0020006D007500790020006200690065006E0020006100200071007500E9002000740065000A00720065006600690065007200650073002E00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Sea como sea, parece que lo que quiere es\nenfrentarse a ti. ¿Le harás el favor?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Le harás a Hawlucha el favor de enfrentarte a él?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2060,
      "rawDecodedUtf16Hex": "00BF004C0065002000680061007200E10073002000610020004800610077006C007500630068006100200065006C0020006600610076006F007200200064006500200065006E006600720065006E0074006100720074006500200061002000E9006C003F00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres enfrentarte a Hawlucha?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200065006E006600720065006E00740061007200740065002000610020004800610077006C0075006300680061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "¡A luchar!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "00A100410020006C0075006300680061007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Tal vez luego",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2276,
      "rawDecodedUtf16Hex": "00540061006C002000760065007A0020006C007500650067006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "¡¡Lucha!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2304,
      "rawDecodedUtf16Hex": "00A100A1004C0075006300680061002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2324,
      "rawDecodedUtf16Hex": "00100002BDFF00170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Haw...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "004800610077002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Me alegra que hayamos luchado otra vez",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "004D006500200061006C0065006700720061002000710075006500200068006100790061006D006F00730020006C00750063006800610064006F0020006F007400720061002000760065007A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Fue un buen combate de revancha",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2432,
      "rawDecodedUtf16Hex": "00460075006500200075006E0020006200750065006E00200063006F006D006200610074006500200064006500200072006500760061006E0063006800610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "¡Nunca me había dado cuenta de lo increíbles que\nson los combates Pokémon!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "El objetivo no es aplastar al rival, sino hacerle\nuna demostración de tu fuerza...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Hawlucha, tengo una propuesta...<U+0010><U+0001>븁\n¿Te gustaría ser mi compañero Pokémon?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 2832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Me gustaría hacer algo más que darte comida.<U+0010><U+0001>븁\nQuiero convertirme en una Entrenadora digna\nde ti. ¡Me esforzaré al máximo por conseguirlo!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 144
    },
    {
      "displayText": "¡Quiero ayudarte!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3280,
      "rawDecodedUtf16Hex": "00A100510075006900650072006F002000610079007500640061007200740065002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "¡¡Chaaa!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3324,
      "rawDecodedUtf16Hex": "00A100A100430068006100610061002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Espero que nos llevemos muy bien a partir\nde ahora. Como compañeros.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 3344,
      "rawDecodedUtf16Hex": "00450073007000650072006F00200071007500650020006E006F00730020006C006C006500760065006D006F00730020006D007500790020006200690065006E002000610020007000610072007400690072000A00640065002000610068006F00720061002E00200043006F006D006F00200063006F006D0070006100F100650072006F0073002E00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Oye, ¡muchas gracias por luchar contra él!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 3492,
      "rawDecodedUtf16Hex": "004F00790065002C002000A1006D007500630068006100730020006700720061006300690061007300200070006F00720020006C0075006300680061007200200063006F006E007400720061002000E9006C002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Al principio me daba un poco de miedo eso\nde tener que vivir con Pokémon salvajes en la<U+0010><U+0001>븀\nciudad, pero su fortaleza me inspiró mucho.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 3588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "¡Yo también pienso volverme más fuerte!\n¡Con Hawlucha a mi lado!<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3868,
      "rawDecodedUtf16Hex": "00A10059006F002000740061006D0062006900E9006E0020007000690065006E0073006F00200076006F006C007600650072006D00650020006D00E1007300200066007500650072007400650021000A00A10043006F006E0020004800610077006C0075006300680061002000610020006D00690020006C00610064006F002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
