  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "How kind of you to come all this way to join us,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0001>븁\nAllow me to express my gratitude by challenging\nyou to a Pokémon battle!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 300,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "You came to talk to me instead of Lady Jacinthe,\nhuh? Guess you’ve got taste.<U+0010><U+0001>븁\nAll right, it’s battle time!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Hold up! Those numbers don’t look fair! I’m\ncoming to help, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "0048006F006C00640020007500700021002000540068006F007300650020006E0075006D006200650072007300200064006F006E201900740020006C006F006F006B002000660061006900720021002000492019006D000A0063006F006D0069006E006700200074006F002000680065006C0070002C002000100002010000000021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "You ready? Let’s dive right into battle!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "0059006F0075002000720065006100640079003F0020004C00650074201900730020006400690076006500200072006900670068007400200069006E0074006F00200062006100740074006C00650021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Let’s!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "004C006500742019007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Wait!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1048,
      "rawDecodedUtf16Hex": "005700610069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Yeah, fair enough, this is all kind of a whirlwind!<U+0010><U+0001>븁\nTalk to one of our SBC pals here once you’re\nfeeling ready!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Let’s show these two SBC elites how great\nTeam MZ is!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1300,
      "rawDecodedUtf16Hex": "004C0065007420190073002000730068006F0077002000740068006500730065002000740077006F002000530042004300200065006C006900740065007300200068006F0077002000670072006500610074000A005400650061006D0020004D005A0020006900730021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Please do me the honor of a battle,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "00100002BD0600000050006C006500610073006500200064006F0020006D0065002000740068006500200068006F006E006F00720020006F00660020006100200062006100740074006C0065002C000A0010000201000000002E00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "You wanna battle me, yeah?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1528,
      "rawDecodedUtf16Hex": "0059006F0075002000770061006E006E006100200062006100740074006C00650020006D0065002C00200079006500610068003F00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Let’s battle!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1592,
      "rawDecodedUtf16Hex": "004C006500742019007300200062006100740074006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Wait a moment",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "0057006100690074002000610020006D006F006D0065006E00740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "How vexing of you to keep me waiting... I expect\nan affirmative answer soon!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "With Lebanne by my side, victory is assured!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "00570069007400680020004C006500620061006E006E00650020006200790020006D007900200073006900640065002C00200076006900630074006F0072007900200069007300200061007300730075007200650064002100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "I was born to battle you, so quit stalling!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1912,
      "rawDecodedUtf16Hex": "0049002000770061007300200062006F0072006E00200074006F00200062006100740074006C006500200079006F0075002C00200073006F002000710075006900740020007300740061006C006C0069006E0067002100100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Aw yeah! Just you watch—I’ll do way better than\nLady Jacinthe.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "004100770020007900650061006800210020004A00750073007400200079006F0075002000770061007400630068201400492019006C006C00200064006F002000770061007900200062006500740074006500720020007400680061006E000A004C0061006400790020004A006100630069006E007400680065002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Talk to Jacinthe or Lebanne when you’re ready to\nshow the SBC who’s boss, OK?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2144,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "It is our responsibility as elites to guide the\nmasses, Clefable!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2320,
      "rawDecodedUtf16Hex": "004900740020006900730020006F0075007200200072006500730070006F006E0073006900620069006C00690074007900200061007300200065006C006900740065007300200074006F0020006700750069006400650020007400680065000A006D00610073007300650073002C00200043006C0065006600610062006C0065002100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Time for our secret weapon! Mega Evolve so we\ncan drag these kids, Dragalge!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2460,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "C’mon, Starmie! Let’s show ’em some of our best\nmoves!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "00432019006D006F006E002C00200053007400610072006D0069006500210020004C0065007420190073002000730068006F0077002020190065006D00200073006F006D00650020006F00660020006F0075007200200062006500730074000A006D006F0076006500730021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2744,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Woooo! We won! We won,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "00100002BD0600000057006F006F006F006F002100200057006500200077006F006E002100200057006500200077006F006E002C000A00100002010000000021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>I knew you were a talented battler,\n<U+0010><U+0002>Ā<U+0000>...<U+0010><U+0001>븀\nBut<U+0010><U+0001>븀\nLida,<U+0010><U+0001>븀\nbrava!<U+0010><U+0001>븁\nYou and your Starmie moved magnificently!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 17,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "If I may, Lady Jacinthe...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 3080,
      "rawDecodedUtf16Hex": "00490066002000490020006D00610079002C0020004C0061006400790020004A006100630069006E007400680065002E002E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Dancers have great core strength and control over\ntheir bodies. It makes them suited to martial arts.<U+0010><U+0001>븁\nWhen Trainers have that kind of strength and\ncontrol, it can help their Pokémon as well.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3144,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 198
    },
    {
      "displayText": "Does all this spark any interest in learning to\ndance, Lady Jacinthe?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3540,
      "rawDecodedUtf16Hex": "0044006F0065007300200061006C006C0020007400680069007300200073007000610072006B00200061006E007900200069006E00740065007200650073007400200069006E0020006C006500610072006E0069006E006700200074006F000A00640061006E00630065002C0020004C0061006400790020004A006100630069006E007400680065003F00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "You know very well that I have an abysmal sense\nof rhythm, Lebanne.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "0059006F00750020006B006E006F007700200076006500720079002000770065006C006C00200074006800610074002000490020006800610076006500200061006E00200061006200790073006D0061006C002000730065006E00730065000A006F0066002000720068007900740068006D002C0020004C006500620061006E006E0065002E00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "I could teach you!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 3832,
      "rawDecodedUtf16Hex": "004900200063006F0075006C006400200074006500610063006800200079006F00750021001000020114000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "I... Thank you. Very much.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 3880,
      "rawDecodedUtf16Hex": "0049002E002E002E0020005400680061006E006B00200079006F0075002E002000560065007200790020006D007500630068002E00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>And <U+0010><U+0002>Ā<U+0000>, please accept\nthis<U+0010><U+0001>븀\nas<U+0010><U+0001>븀\nproof<U+0010><U+0001>븀\nof<U+0010><U+0001>븀\nyour victory.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 17,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "You received Jacinthe’s Dress!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4096,
      "rawDecodedUtf16Hex": "0059006F00750020007200650063006500690076006500640020004A006100630069006E0074006800652019007300200044007200650073007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Whoa, you get to do matching outfits with\nJacinthe?! Anything really is possible in<U+0010><U+0001>븀\nHyperspace Lumiose!<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4160,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "If the Jacinthe here in hyperspace is sensitive\nabout having no rhythm...does that mean the real<U+0010><U+0001>븀\nJacinthe is, too?<U+0010><U+0002>Ĕ<U+000C>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "I have worked diligently to avoid all means of\ndancing, even ballroom dancing...<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "I have something of a fondness for dance myself.<U+0010><U+0001>븁\nIf Lady Jacinthe were amenable, I wouldn’t mind\nshowing her a thing or two...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    }
