      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "我是闊星公司的員工，\n負責管理野生特區。<U+0010><U+0002>ĔǄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
