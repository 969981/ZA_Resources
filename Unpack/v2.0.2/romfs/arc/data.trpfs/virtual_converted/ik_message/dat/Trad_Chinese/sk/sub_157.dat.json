      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "順帶一提，沙丘娃的圖鑑說明……<U+0010><U+0002>ĔǄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
