      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "不好意思給您添麻煩，\n但我想請您協助調查。<U+0010><U+0002>ĔǄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 292,
