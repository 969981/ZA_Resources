      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "請您準備好之後，\n就去調查8號野生特區吧。<U+0010><U+0002>ĔǄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "8ACB60A86E965099597D4E4B5F8CFF0C000A5C3153BB8ABF67E50038865F91CE751F727953405427300200100002011401C40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
