      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "……是這麼說的。\n死者的怨念是嗎……<U+0010><U+0002>ĔǄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
