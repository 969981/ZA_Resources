      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Sei portat<U+0010><U+0003>ᄀÿāoa per fare l’Allenat<U+0010><U+0003>ᄀÿ̂orrice, si vede!<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6752,
      "rawDecodedUtf16Hex": "00530065006900200070006F007200740061007400100003110000FF0101006F00610020007000650072002000660061007200650020006C20190041006C006C0065006E0061007400100003110000FF0302006F00720072006900630065002C00200073006900200076006500640065002100100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
