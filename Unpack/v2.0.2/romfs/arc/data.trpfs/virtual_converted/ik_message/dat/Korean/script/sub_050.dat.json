      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "HP를 흡수하는 기술이라면 가능해!\n공격할 때마다 HP가 회복된다구!<U+0010><U+0002>ĔŒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 280,
