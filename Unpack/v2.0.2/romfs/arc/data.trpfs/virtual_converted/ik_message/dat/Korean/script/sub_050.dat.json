      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "모두에게 큰뿌리를\n지니게 했는데도 졌네...<U+0010><U+0002>ĔŒ",
      "escapedControlUnits": 2,
