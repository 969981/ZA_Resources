      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳要不要和我來一場\n有點特別的寶可夢對戰？<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 304,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B389814E0D8981548C62114F864E005834000A67099EDE7279522576845BF653EF59225C0D6230FF1F00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "我們彼此都只用\n飛行屬性的寶可夢來對戰。<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 368,
      "rawDecodedUtf16Hex": "621150115F7C6B6490FD53EA7528000A98DB884C5C6C602776845BF653EF59224F865C0D6230300200100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳想用幾隻寶可夢都行，\n也可以只用1隻。要試試看嗎？<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 420,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B360F375285E7E96BB5BF653EF592290FD884CFF0C000A4E5F53EF4EE553EA7528003196BB300289818A668A66770B55CEFF1F00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "等<U+0010><U+0003>ᄀÿā你妳準備好只用飛行屬性的\n寶可夢對戰時，就告訴我一聲吧。<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "7B4900100003110000FF01014F6059B36E965099597D53EA752898DB884C5C6C60277684000A5BF653EF59225C0D62306642FF0C5C31544A8A3462114E0080725427300200100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
