      "rawDecodedUtf16Hex": "9084662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳想重新考慮\n要派哪隻寶可夢上場嗎？<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 4,
