      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "只帶著擁有飛行屬性的寶可夢\n來和我對戰，<U+0010><U+0003>ᄀÿā你妳覺得如何？<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "53EA5E36845764C1670998DB884C5C6C602776845BF653EF5922000A4F86548C62115C0D6230FF0C00100003110000FF01014F6059B389BA5F9759824F55FF1F00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
