      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "且看究竟是誰的寶可夢\n會稱霸天空吧！<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
