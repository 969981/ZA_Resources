      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "光是用飛行屬性就這麼強！\n<U+0010><U+0003>ᄀÿā你妳就像是個天空訓練家呢！<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
