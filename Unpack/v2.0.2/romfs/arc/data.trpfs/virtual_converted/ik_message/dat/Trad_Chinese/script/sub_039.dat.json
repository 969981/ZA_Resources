      "rawDecodedUtf16Hex": "5149662F752898DB884C5C6C60275C3190199EBC5F37FF01000A00100003110000FF01014F6059B35C3150CF662F500B59297A7A8A137DF45BB65462FF0100100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "天空對戰曾經在\n卡洛斯地區流行過。<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
