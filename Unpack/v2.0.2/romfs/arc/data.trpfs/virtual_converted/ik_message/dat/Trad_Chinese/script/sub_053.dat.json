      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "只要<U+0010><U+0003>ᄀÿā你妳肯和我打一場，我就不休息啦！\n我會三兩下就幫<U+0010><U+0003>ᄀÿā你妳把工程給結束掉。<U+0010><U+0002>Ĕŕ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "53EA898100100003110000FF01014F6059B380AF548C621162534E005834FF0C62115C314E0D4F11606F5566FF01000A621167034E0951694E0B5C315E6B00100003110000FF01014F6059B3628A5DE57A0B7D667D50675F6389300200100002011401550000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "要跟我寶可夢對戰的話，\n就說一聲喔。<U+0010><U+0002>Ĕŕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
