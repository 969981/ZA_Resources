    },
    {
      "displayText": "Als Erstes ist <U+0010><U+0002>＀<U+0006>Hypnose<U+0010><U+0002>＀<U+0000> an der Reihe!<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 8,
