      "index": 25,
      "offsetInSection": 3268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Ach, du warst ein tolles Vorbild! Ich bin mir\nsicher, dass Somnivora das jetzt auch schafft.<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
