      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Flaminkno ist richtig erholt von seinem\nNickerchen! Diesen Service werde ich bestimmt<U+0010><U+0001>븀\nbald wieder nutzen!<U+0010><U+0002>ĔƼ",
      "escapedControlUnits": 4,
