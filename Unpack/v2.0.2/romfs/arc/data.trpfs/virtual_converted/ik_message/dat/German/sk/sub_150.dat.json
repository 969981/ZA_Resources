      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Als Nächstes ist die Attacke <U+0010><U+0002>＀<U+0006>Traumfresser<U+0010><U+0002>＀<U+0000> an der\nReihe.<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 8,
