      "displayText": "<U+0010><U+0002>Ă<U+0002><U+0010><U+0002>ᤀ<U+0001>\n<U+0010><U+0002>Ă<U+0003><U+0010><U+0002>ᤀ<U+0002> 좋아했다.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 14,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2732,
      "rawDecodedUtf16Hex": "00100002010200020010000219000001000A001000020102000300100002190000020020C88BC544D588B2E4002E00100002011401B50000",
