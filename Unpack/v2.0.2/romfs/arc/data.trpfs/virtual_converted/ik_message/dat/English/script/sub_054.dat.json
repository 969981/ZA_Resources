      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "What’re you lookin’ at?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 424,
      "rawDecodedUtf16Hex": "005700680061007420190072006500200079006F00750020006C006F006F006B0069006E2019002000610074003F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Let me guess. You wanna use this Holovator?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "004C006500740020006D0065002000670075006500730073002E00200059006F0075002000770061006E006E006100200075007300650020007400680069007300200048006F006C006F007600610074006F0072003F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Well, too bad—this is my favorite Holovator!\nIf you’re gonna insist on usin’ it...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "I’ve got no choice but to battle you!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "004920190076006500200067006F00740020006E006F002000630068006F006900630065002000620075007400200074006F00200062006100740074006C006500200079006F00750021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Come talk to me when you’re ready. If you’ve got\nthe nerve to face me in battle, that is!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 836,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "If you’re dead set on usin’ my Holovator, then we\ngotta have a Pokémon battle!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "I’ll battle you!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "00492019006C006C00200062006100740074006C006500200079006F007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "I’ll pass",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "00492019006C006C002000700061007300730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Smart choice. It’s MY favorite Holovator, after all.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "0053006D006100720074002000630068006F006900630065002E002000490074201900730020004D00590020006600610076006F007200690074006500200048006F006C006F007600610074006F0072002C00200061006600740065007200200061006C006C002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "You’d better be ready to lose!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "0059006F007520190064002000620065007400740065007200200062006500200072006500610064007900200074006F0020006C006F007300650021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1448,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "I am so, SO sorry for my behavior!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "004900200061006D00200073006F002C00200053004F00200073006F00720072007900200066006F00720020006D00790020006200650068006100760069006F00720021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "I had no idea you were so strong. I sincerely\napologize for my rudeness!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Now, as I mentioned, I’m rather fond of this\nparticular Holovator, but I insist that you use it!<U+0010><U+0001>븀\nA million times, if need be!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Don’t worry—I’ll keep an eye on things so that\nyou can go up and down as you please.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
