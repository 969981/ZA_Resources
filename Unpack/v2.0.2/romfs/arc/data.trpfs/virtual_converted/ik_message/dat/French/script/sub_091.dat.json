      "rawDecodedUtf16Hex": "0052006F0074006F002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Ha ha ! T’en as dans l’ventre ! C’est même plus\njoli qu’avant que tu débarques !<U+0010><U+0002>Ĕ<U+001D>",
