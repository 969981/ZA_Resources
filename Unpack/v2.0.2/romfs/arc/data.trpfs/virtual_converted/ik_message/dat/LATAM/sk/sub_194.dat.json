      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4640,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Impresionante!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4652,
      "rawDecodedUtf16Hex": "00A10049006D00700072006500730069006F006E0061006E00740065002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Superaste de sobra la prueba de planta.<U+0010><U+0001>븁\nTe presento esta MT como parte de la enseñanza\ndel movimiento definitivo.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Superaste con creces la prueba de fuego.<U+0010><U+0001>븁\nTe presento esta MT como parte de la enseñanza\ndel movimiento definitivo.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4936,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "Superaste sin duda la prueba de agua.<U+0010><U+0001>븁\nTe presento esta MT como parte de la enseñanza\ndel movimiento definitivo.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "¡Tu habilidad es impresionante! Espero que\nsuperes las otras pruebas con esa determinación.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿&",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5612,
      "rawDecodedUtf16Hex": "00100002BDFF00260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oooh, por fin...<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 5624,
      "rawDecodedUtf16Hex": "004F006F006F0068002C00200070006F0072002000660069006E002E002E002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "¡Felicidades! Ya superaste las tres pruebas.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5668,
      "rawDecodedUtf16Hex": "00A100460065006C00690063006900640061006400650073002100200059006100200073007500700065007200610073007400650020006C006100730020007400720065007300200070007200750065006200610073002E00100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Los movimientos definitivos poseen una potencia\ndevastadora, pero también dejan al usuario en<U+0010><U+0001>븀\nuna posición vulnerable.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
    {
      "displayText": "Por esta razón, un Entrenador tiene que saber\nelegir el momento idóneo para usarlos.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "¡Enfócate en afilar tu intuición!<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6200,
      "rawDecodedUtf16Hex": "00A10045006E006600F3006300610074006500200065006E0020006100660069006C0061007200200074007500200069006E0074007500690063006900F3006E002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "<U+0010><U+0002>뷿,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6276,
      "rawDecodedUtf16Hex": "00100002BDFF002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Los movimientos definitivos poseen una potencia\ndevastadora, pero también dejan al usuario en<U+0010><U+0001>븀\nuna posición vulnerable.<U+0010><U+0001>븁\nPor esta razón, un Entrenador tiene que saber\nelegir el momento idóneo para usarlos.<U+0010><U+0001>븁\n¡Enfócate en afilar tu intuición!<U+0010><U+0002>Ĕǩ",
