      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3360,
      "rawDecodedUtf16Hex": "004C0061002000700072007500650062006100200064006500200066007500650067006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "La prueba de agua",
      "escapedControlUnits": 0,
