      "rawDecodedUtf16Hex": "00490063006800200073007000FC00720065002000640069006500200045006E00650072006700690065002000640065007300200055006E006900760065007200730075006D0073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
