      "rawDecodedUtf16Hex": "0048006100620065006E0020006100750063006800200064006900630068002000640069006500200053007400650072006E00650020006800690065007200680065007200670065006C00650069007400650074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
