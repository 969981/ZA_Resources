  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "口味安心，环境舒心，价格放心。\n欢迎光临谱通餐馆。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 196,
      "rawDecodedUtf16Hex": "53E354735B895FC3FF0C73AF588382125FC3FF0C4EF7683C653E5FC33002000A6B228FCE51494E348C31901A9910998630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "不断追求更高的境界！\n这就是刻在我灵魂中的做人原则。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "4E0D65AD8FFD6C4266F49AD876845883754CFF01000A8FD95C31662F523B5728621170759B424E2D7684505A4EBA539F521930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "请务必挑战全餐。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 304,
      "rawDecodedUtf16Hex": "8BF752A15FC56311621851689910300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "会夸奖自己的，\n就只有自己啊～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 352,
      "rawDecodedUtf16Hex": "4F1A5938595681EA5DF17684FF0C000A5C3153EA670981EA5DF1554AFF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "我猜你的宝可梦也在夸你。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 384,
      "rawDecodedUtf16Hex": "6211731C4F6076845B9D53EF68A64E5F572859384F6030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "我要把味觉全部集中到\n唯一一个甜品上！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "62118981628A547389C9516890E896C64E2D5230000A552F4E004E004E2A751C54C14E0AFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "这里的橙香可丽饼\n平平无奇却无比美味。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 452,
      "rawDecodedUtf16Hex": "8FD991CC76846A59999953EF4E3D997C000A5E735E7365E05947537465E06BD47F8E547330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "一边观赏宝可梦对战一边吃的饭\n真是格外地香。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 492,
      "rawDecodedUtf16Hex": "4E008FB989C28D4F5B9D53EF68A65BF962184E008FB954037684996D000A771F662F683C59165730999930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "乏味的对战会让菜肴\n也变得淡然无味哦。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 540,
      "rawDecodedUtf16Hex": "4E4F547376845BF962184F1A8BA983DC80B4000A4E5F53D85F976DE1713665E0547354E630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "一旦有宝可梦对战开打，\n孩子就会无心吃饭了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "4E0065E667095B9D53EF68A65BF962185F006253FF0C000A5B695B505C314F1A65E05FC35403996D4E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "我会忍不住想送文柚果\n给打输的宝可梦。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "62114F1A5FCD4E0D4F4F60F39001658767DA679C000A7ED962538F9376845B9D53EF68A630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "我懂。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "621161C230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "要是没了这个店的菜，\n我可会伤心到哭哦。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "8981662F6CA14E868FD94E2A5E97768483DCFF0C000A621153EF4F1A4F245FC3523054ED54E630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "我可是想静静地\n享用美食的呀。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "621153EF662F60F3975997595730000A4EAB75287F8E98DF7684544030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "不愧是罗杰的菜肴！\n手艺真是越来越好了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "4E0D6127662F7F576770768483DC80B4FF01000A624B827A771F662F8D8A67658D8A597D4E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "抱歉，我认识的厨师只有志米。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 796,
      "rawDecodedUtf16Hex": "62B16B49FF0C62118BA48BC6768453A85E0853EA67095FD77C7330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "我们的结婚和银婚典礼\n都是在这里庆祝的。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 828,
      "rawDecodedUtf16Hex": "62114EEC76847ED35A5A548C94F65A5A5178793C000A90FD662F57288FD991CC5E86795D768430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "这证明我们的日子\n一路都过得很安稳啊。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "8FD98BC1660E62114EEC768465E55B50000A4E008DEF90FD8FC75F975F885B897A33554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "套餐包含了前菜、汤品、\n鱼类菜品。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "595799105305542B4E86524D83DC30016C6454C13001000A9C7C7C7B83DC54C130020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "这个人以前可是\n这里的贵客哦。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "8FD94E2A4EBA4EE5524D53EF662F000A8FD991CC76848D355BA254E630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "太过平凡反而让人感动……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "592A8FC75E7351E153CD800C8BA94EBA611F52A8202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "居然能日复一日地提供\n味道不错的菜，真是太棒了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1008,
      "rawDecodedUtf16Hex": "5C45713680FD65E5590D4E0065E5573063D04F9B000A547390534E0D9519768483DCFF0C771F662F592A68D24E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "好想快点吃到啊！\n我要不直接跑到厨房好了！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "597D60F35FEB70B954035230554AFF01000A621189814E0D76F463A58DD1523053A8623F597D4E86FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "所谓礼仪就是为了\n不给别人留破绽的武器。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "62408C13793C4EEA5C31662F4E3A4E86000A4E0D7ED9522B4EBA755978347EFD76846B66566830020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    }
  ],
