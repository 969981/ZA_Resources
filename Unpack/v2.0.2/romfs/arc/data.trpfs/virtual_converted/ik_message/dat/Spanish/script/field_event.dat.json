      "rawDecodedUtf16Hex": "0043006F006E00730065006A006F00730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Recoge los fragmentos de megapoder que\nse desprenden al golpear al rival con los ataques<U+0010><U+0001>븀\nde Lucario.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
