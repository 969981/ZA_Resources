      "index": 4,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "0056006F006C0076006500720020006100200069006E00740065006E007400610072006C006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Mantener PS del oponente",
