      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Acercarse demasiado a Absol puede ser peligroso.\n¡Pero puedes esquivar sus ataques con <U+0010><U+0002>봊<U+0004>Sp_2!",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
