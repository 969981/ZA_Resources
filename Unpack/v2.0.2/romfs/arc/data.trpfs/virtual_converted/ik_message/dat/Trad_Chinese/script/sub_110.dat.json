      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "不是岩石啦！\n是污泥！<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1124,
