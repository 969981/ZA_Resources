      "rawDecodedUtf16Hex": "55C68766554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "竟然用水槍\n把岩石給沖碎了！？<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
