      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "哦哦！\n沖得乾乾淨淨、清潔溜溜！<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
