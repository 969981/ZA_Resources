      "offsetInSection": 3712,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vaya, esto no estaba en el guion. ¡Corten!\nRepetimos desde el principio, a ver si ahora sí.<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 2,
