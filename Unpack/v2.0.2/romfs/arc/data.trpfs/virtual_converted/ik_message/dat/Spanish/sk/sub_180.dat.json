      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>¡<U+0010><U+0003>ᄀÿȂElLa famos<U+0010><U+0003>ᄀÿāoa ladr<U+0010><U+0003>ᄀÿ̂ónona <U+0010><U+0002>Ā<U+0000> acaba de\nrobar<U+0010><U+0001>븀\nel<U+0010><U+0001>븀\natuendo<U+0010><U+0001>븀\nde<U+0010><U+0001>븀\nlos<U+0010><U+0001>븀\nantiguos<U+0010><U+0001>븀\nsinnohítas!<U+0010><U+0001>븁\n¡Acordonad el perímetro! ¡No debe salir de\nCiudad Luminalia!<U+0010><U+0002>ĔǍ",
