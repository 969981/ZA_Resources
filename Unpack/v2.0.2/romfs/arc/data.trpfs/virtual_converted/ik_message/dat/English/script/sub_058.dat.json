      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "004E006F007700200066006F006C006B0073002000630061006E002000660069006E0061006C006C0079002E002E002E00100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Wait, they’re back?!<U+0010><U+0002>Ĕř",
