      "offsetInSection": 1688,
      "rawDecodedUtf16Hex": "0057006100690074002C002000740068006500792019007200650020006200610063006B003F002100100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Yeesh... Why does this keep happening to me?<U+0010><U+0002>Ĕř",
