      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "진짜 세비퍼를 데려와 보거라!<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
