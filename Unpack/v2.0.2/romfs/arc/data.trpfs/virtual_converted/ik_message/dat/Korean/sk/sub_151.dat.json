      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "진짜 세비퍼를 데려온 게냐?\n어디, 보여 줘 보거라.<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
