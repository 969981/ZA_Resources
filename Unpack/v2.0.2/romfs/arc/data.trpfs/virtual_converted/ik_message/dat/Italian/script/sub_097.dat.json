      "index": 1,
      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "0051005500490020005300490020004D00450054005400450020004D0041004C00450021001000020114017A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Il mio Whirlipede è fuori controllo!\nCorre per la città come un matto!<U+0010><U+0002>Ĕź",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Di questo passo finirà per scontrarsi con la gente\no con qualche Pokémon!<U+0010><U+0002>Ĕź",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Ti prego! Lotta contro di lui per cercare\ndi fermarlo!<U+0010><U+0002>Ĕź",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 604,
      "rawDecodedUtf16Hex": "0054006900200070007200650067006F00210020004C006F00740074006100200063006F006E00740072006F0020006400690020006C00750069002000700065007200200063006500720063006100720065000A006400690020006600650072006D00610072006C006F0021001000020114017A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
