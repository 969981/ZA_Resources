      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "WHIIIIRL!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "0057004800490049004900490052004C00210000",
