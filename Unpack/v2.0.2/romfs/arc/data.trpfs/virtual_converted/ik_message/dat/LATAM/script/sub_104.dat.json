      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Por cierto, hay <U+0010><U+0002>＀<U+0006>12<U+0010><U+0002>＀<U+0000> Spewpa perdidos en total.<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 8,
