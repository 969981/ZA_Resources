      "index": 9,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "0050006F0072002000630069006500720074006F002C0020006800610079002000100002FF0000060031003200100002FF00000000200053007000650077007000610020007000650072006400690064006F007300200065006E00200074006F00740061006C002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Nuestro amor por los Spewpa es lo que nos llevó\na enamorarnos...<U+0010><U+0002>ĔƘ",
