      "index": 7,
      "offsetInSection": 1184,
      "rawDecodedUtf16Hex": "005300690020007000750064006900650072006100730020006100790075006400610072006E006F007300200079002E002E002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Y encontrar a nuestros pequeños Spewpa\nperdidos, ¡nos harías un gran favor!<U+0010><U+0002>ĔƘ",
