      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Yo creo que, cuando interactúes con ellos,\nvolverán en sí y regresarán a nuestro lado.<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
