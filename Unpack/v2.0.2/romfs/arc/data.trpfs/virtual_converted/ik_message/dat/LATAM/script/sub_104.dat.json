      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Pero todos nuestros Spewpa se perdieron\nen el museo y no podemos encontrarlos.<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Si pudieras ayudarnos y...<U+0010><U+0002>ĔƗ",
