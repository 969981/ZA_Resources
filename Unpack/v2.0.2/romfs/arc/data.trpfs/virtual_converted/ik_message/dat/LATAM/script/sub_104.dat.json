      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Sería una lástima que ensuciaran las obras\ndel museo, así que nada de luchar, ¿estamos?<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
