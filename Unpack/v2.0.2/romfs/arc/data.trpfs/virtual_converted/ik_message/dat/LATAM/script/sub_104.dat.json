      "index": 2,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "005300ED002C002000A1007400FA0020006C006F002000680061007300200064006900630068006F002C0020006D006900200061006D006F0072002100100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Oye, disculpa, pero tienes cara de saber mucho\nde Pokémon.<U+0010><U+0002>ĔƗ",
