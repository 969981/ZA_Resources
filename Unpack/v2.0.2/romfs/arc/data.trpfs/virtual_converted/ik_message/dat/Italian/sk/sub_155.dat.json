    },
    {
      "displayText": "48.700 <U+E300>",
      "escapedControlUnits": 1,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 5328,
      "rawDecodedUtf16Hex": "00340038002E0037003000300020E3000000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "49.700 <U+E300>",
      "escapedControlUnits": 1,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5348,
      "rawDecodedUtf16Hex": "00340039002E0037003000300020E3000000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Ma sei un genietto del calcolo! Tornerò a trovarvi,\ngrazie tremila!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 5368,
      "rawDecodedUtf16Hex": "004D0061002000730065006900200075006E002000670065006E0069006500740074006F002000640065006C002000630061006C0063006F006C006F002100200054006F0072006E0065007200F200200061002000740072006F00760061007200760069002C000A006700720061007A006900650020007400720065006D0069006C006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Sei un po’ deludente. Ma tornerò lo stesso\na trovarvi, grazie tremila!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5504,
      "rawDecodedUtf16Hex": "00530065006900200075006E00200070006F2019002000640065006C007500640065006E00740065002E0020004D006100200074006F0072006E0065007200F20020006C006F002000730074006500730073006F000A0061002000740072006F00760061007200760069002C0020006700720061007A006900650020007400720065006D0069006C006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Ottimo lavoro! Grazie per aver badato al chiosco.<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 57,
      "offsetInSection": 5648,
      "rawDecodedUtf16Hex": "004F007400740069006D006F0020006C00610076006F0072006F00210020004700720061007A00690065002000700065007200200061007600650072002000620061006400610074006F00200061006C0020006300680069006F00730063006F002E00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Ora fammi controllare articoli e vendite, ok?<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 5756,
      "rawDecodedUtf16Hex": "004F00720061002000660061006D006D006900200063006F006E00740072006F006C006C006100720065002000610072007400690063006F006C006900200065002000760065006E0064006900740065002C0020006F006B003F00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Eh?! Mi sa che non sei portat<U+0010><U+0003>ᄀÿāoa per le vendite...<U+0010><U+0001>븁\nSe esistesse un rango per i commessi,\nti beccheresti il rango Z!<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 59,
      "offsetInSection": 5856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Mmh... Beh, dev’essere stato difficile sostituirmi\ncosì su due piedi.<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 6112,
      "rawDecodedUtf16Hex": "004D006D0068002E002E002E0020004200650068002C0020006400650076201900650073007300650072006500200073007400610074006F00200064006900660066006900630069006C006500200073006F0073007400690074007500690072006D0069000A0063006F007300EC0020007300750020006400750065002000700069006500640069002E00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Come commess<U+0010><U+0003>ᄀÿāoa non te la caveresti granché...<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6260,
      "rawDecodedUtf16Hex": "0043006F006D006500200063006F006D006D00650073007300100003110000FF0101006F00610020006E006F006E0020007400650020006C006100200063006100760065007200650073007400690020006700720061006E0063006800E9002E002E002E00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Insomma, sei un<U+0010><U+0003>ᄀÿĀa commess<U+0010><U+0003>ᄀÿāoa nella media...\nIl che non è un male, eh.<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 62,
      "offsetInSection": 6372,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Sei stat<U+0010><U+0003>ᄀÿāoa un<U+0010><U+0003>ᄀÿĀa commess<U+0010><U+0003>ᄀÿāoa piuttosto efficiente!<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6536,
      "rawDecodedUtf16Hex": "0053006500690020007300740061007400100003110000FF0101006F006100200075006E00100003110000FF0100006100200063006F006D006D00650073007300100003110000FF0101006F0061002000700069007500740074006F00730074006F00200065006600660069006300690065006E00740065002100100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Accidenti... Sei incredibile! Mi sa che ho trovato\nun<U+0010><U+0003>ᄀÿĀa degn<U+0010><U+0003>ᄀÿāoa rivale!<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 64,
      "offsetInSection": 6668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Hai ricevuto <U+0010><U+0003>Ȅ<U+0002>. <U+E300> come ringraziamento!",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 65,
      "offsetInSection": 6836,
      "rawDecodedUtf16Hex": "00480061006900200072006900630065007600750074006F00200010000302040002002E0020E30000200063006F006D0065002000720069006E006700720061007A00690061006D0065006E0074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "L’Arctibax che avevo lasciato di guardia a casa me\nl’ha congelata, e ora si sta belli freschi.<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Comunque sia, mi hai fatto un favore enorme!\nLa prossima volta vieni a trovarmi come cliente.<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 7120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Vuoi approfittarne per ricontrollare i prezzi?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 7316,
      "rawDecodedUtf16Hex": "00560075006F006900200061007000700072006F006600690074007400610072006E006500200070006500720020007200690063006F006E00740072006F006C006C006100720065002000690020007000720065007A007A0069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Sì",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 7412,
      "rawDecodedUtf16Hex": "005300EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "No",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 7420,
      "rawDecodedUtf16Hex": "004E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Acqua fresca\t200 <U+E300>\nGassosa\t\t300 <U+E300><U+0010><U+0001>븁\nLemonsucco\t400 <U+E300>\nLatte Mumu\t600 <U+E300>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 71,
