      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "陪同的客人，也祝您愉快。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 796,
      "rawDecodedUtf16Hex": "966A540C76845BA24EBAFF0C4E5F795D60A861095FEB30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "咘嗯♪",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "549855EF266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
