      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "597D54035417FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
