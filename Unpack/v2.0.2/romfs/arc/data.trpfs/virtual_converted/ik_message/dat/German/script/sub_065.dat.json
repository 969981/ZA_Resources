  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Ich bin zu einer tollen Erkenntnis bezüglich\nPokémon-Typen gekommen.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 240,
      "rawDecodedUtf16Hex": "004900630068002000620069006E0020007A0075002000650069006E0065007200200074006F006C006C0065006E002000450072006B0065006E006E0074006E00690073002000620065007A00FC0067006C006900630068000A0050006F006B00E9006D006F006E002D0054007900700065006E002000670065006B006F006D006D0065006E002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Pokémon vom Typ Normal sind die stärksten!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "0050006F006B00E9006D006F006E00200076006F006D00200054007900700020004E006F0072006D0061006C002000730069006E0064002000640069006500200073007400E40072006B007300740065006E002100100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Sie haben nämlich so gut wie keine Schwächen\ngegenüber anderen Typen.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "00530069006500200068006100620065006E0020006E00E4006D006C00690063006800200073006F002000670075007400200077006900650020006B00650069006E00650020005300630068007700E4006300680065006E000A0067006500670065006E00FC00620065007200200061006E0064006500720065006E00200054007900700065006E002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Das heißt, sie sind absolute Alleskönner, egal,\nwer sich ihnen entgegenstellt.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Ich habe die verschiedensten Regionen bereist\nund gegen alle möglichen Pokémon gekämpft.<U+0010><U+0001>븀\nEs besteht also kein Zweifel an meiner Theorie!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 144
    },
    {
      "displayText": "Wie wär’s, wenn ich dich in einem Kampf von\nmeiner Theorie überzeuge?<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "0057006900650020007700E4007220190073002C002000770065006E006E00200069006300680020006400690063006800200069006E002000650069006E0065006D0020004B0061006D0070006600200076006F006E000A006D00650069006E006500720020005400680065006F007200690065002000FC006200650072007A0065007500670065003F00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Sag Bescheid, wenn du dich gesammelt hast.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1236,
      "rawDecodedUtf16Hex": "005300610067002000420065007300630068006500690064002C002000770065006E006E0020006400750020006400690063006800200067006500730061006D006D0065006C007400200068006100730074002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich werde dir beweisen, dass Normal-Pokémon\ndie stärksten sind! Bist du bereit?<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ich bin bereit!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "004900630068002000620069006E002000620065007200650069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Nein, noch nicht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1544,
      "rawDecodedUtf16Hex": "004E00650069006E002C0020006E006F006300680020006E0069006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Dann komm wieder, wenn du so weit bist.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "00440061006E006E0020006B006F006D006D0020007700690065006400650072002C002000770065006E006E00200064007500200073006F0020007700650069007400200062006900730074002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "All meine Pokémon sind vom Typ Normal. Damit\nsollten sie Gegnern jeden Typs überlegen sein.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1860,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hmmm... Vielleicht muss ich doch mehr auf die\nWechselwirkung zwischen den Typen achten.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1872,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Aber ehrlich gesagt...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2056,
      "rawDecodedUtf16Hex": "00410062006500720020006500680072006C0069006300680020006700650073006100670074002E002E002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Ich kann mir die Wechselwirkungen einfach nicht\nmerken! Dafür gibt’s viel zu viele Kombinationen!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2112,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Sag bloß, du hast das alles perfekt im Kopf?!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "00530061006700200062006C006F00DF002C00200064007500200068006100730074002000640061007300200061006C006C00650073002000700065007200660065006B007400200069006D0020004B006F00700066003F002100100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Aber klar doch.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2416,
      "rawDecodedUtf16Hex": "00410062006500720020006B006C0061007200200064006F00630068002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Manchmal bin ich mir unsicher.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2448,
      "rawDecodedUtf16Hex": "004D0061006E00630068006D0061006C002000620069006E00200069006300680020006D0069007200200075006E007300690063006800650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Was für <U+0010><U+0004>ᄀÿᬙ<U+0000>ein vorbildlicher Trainereine vorbildliche Trainerin!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2512,
      "rawDecodedUtf16Hex": "0057006100730020006600FC0072002000100004110000FF1B19000000650069006E00200076006F007200620069006C0064006C0069006300680065007200200054007200610069006E0065007200650069006E006500200076006F007200620069006C0064006C006900630068006500200054007200610069006E006500720069006E002100100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Das geht sicher allen so, oder nicht?<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "00440061007300200067006500680074002000730069006300680065007200200061006C006C0065006E00200073006F002C0020006F0064006500720020006E0069006300680074003F00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Meine Einstellung zu Normal-Pokémon ändert\ndas aber nicht! Auch wenn sie nicht die stärksten<U+0010><U+0001>븀\nsind, sind sie doch sehr anpassungsfähig!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Aber es gibt auch Pokémon, auf die Attacken\nvom Typ Normal gar keine Wirkung haben...<U+0010><U+0001>븀\nUnd zwar Pokémon vom Typ Geist!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3024,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Wenn Normal-Attacken doch nur auch etwas\ngegen Geister-Pokémon ausrichten könnten...<U+0010><U+0001>븀\nDann könnte ich gegen jeden Gegner kämpfen!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3276,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3548,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wenn Normal-Attacken doch nur auch etwas\ngegen Geister-Pokémon ausrichten könnten...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
