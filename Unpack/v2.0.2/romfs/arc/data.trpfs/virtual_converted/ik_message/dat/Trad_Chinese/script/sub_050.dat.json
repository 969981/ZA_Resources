      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "被對手一邊攻擊一邊回復，\n對戰起來會相當棘手對吧！<U+0010><U+0002>ĔŒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
