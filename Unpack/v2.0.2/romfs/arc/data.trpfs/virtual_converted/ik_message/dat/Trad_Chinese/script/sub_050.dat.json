      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "但是被吸了HP還能打贏，\n<U+0010><U+0003>ᄀÿā你妳真是太強了……<U+0010><U+0002>ĔŒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 876,
