      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "明明我都給大家帶著\n大根莖了說……<U+0010><U+0002>ĔŒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
