      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "오오! 꿈먹기!<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "C624C62400210020AFC8BA39AE30002100100002011401BB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "꼬이밍고는\n기분 좋은 듯이 잠들어 있다...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
