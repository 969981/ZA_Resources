      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "다음은 <U+0010><U+0002>＀<U+0006>꿈먹기<U+0010><U+0002>＀<U+0000>를\n부탁드리겠습니다!<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 8,
