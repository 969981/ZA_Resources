      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Empecemos con la reunión.<U+0010><U+0002>Ĕż",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2368,
      "rawDecodedUtf16Hex": "0045006D0070006500630065006D006F007300200063006F006E0020006C00610020007200650075006E006900F3006E002E001000020114017C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Queridos amigos hoy aquí reunidos.<U+0010><U+0001>븁\nEstamos aquí para poner en común nuestro poder\ncósmico y comunicarnos con los Starmie que<U+0010><U+0001>븀\ntodavía residen en el espacio exterior.<U+0010><U+0002>Ĕż",
