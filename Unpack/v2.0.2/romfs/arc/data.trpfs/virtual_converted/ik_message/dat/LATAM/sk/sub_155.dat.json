      "rawDecodedUtf16Hex": "0049006E00630072006500ED0062006C0065002C002000A10071007500E9002000670061006E0067006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¿Qué? ¿Acaso subieron el precio y no me enteré?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "00BF0051007500E9003F002000BF0041006300610073006F0020007300750062006900650072006F006E00200065006C002000700072006500630069006F002000790020006E006F0020006D006500200065006E00740065007200E9003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Ay, no sé qué pedir... Quizás algo de Agua Fresca.<U+0010><U+0002>Ĕ ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "00410079002C0020006E006F0020007300E900200071007500E9002000700065006400690072002E002E002E0020005100750069007A00E1007300200061006C0067006F002000640065002000410067007500610020004600720065007300630061002E00100002011400200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Yo quiero Leche Mu-mu. Ay, ¡no, no! Mejor\ndame una Limonada.<U+0010><U+0002>Ĕ#",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "0059006F002000710075006900650072006F0020004C00650063006800650020004D0075002D006D0075002E002000410079002C002000A1006E006F002C0020006E006F00210020004D0065006A006F0072000A00640061006D006500200075006E00610020004C0069006D006F006E006100640061002E00100002011400230000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Creo que mejor voy a pedir un Refresco.\n¿Cuánto es en total?<U+0010><U+0002>Ĕ ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2684,
      "rawDecodedUtf16Hex": "004300720065006F00200071007500650020006D0065006A006F007200200076006F00790020006100200070006500640069007200200075006E00200052006500660072006500730063006F002E000A00BF0043007500E1006E0074006F00200065007300200065006E00200074006F00740061006C003F00100002011400200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Son <U+E300>700",
