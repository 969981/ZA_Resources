    },
    {
      "displayText": "Muchas gracias.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "004D0075006300680061007300200067007200610063006900610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Increíble, ¡qué ganga!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
