      "rawDecodedUtf16Hex": "0053006F006E0020E3000031002C0039003000300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Sí, ¡exacto! También había calculado <U+E300>1,900.\n¡Qué bueno que sumé todo bien! ¡Nos vemos!",
      "escapedControlUnits": 1,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3916,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Ah, ¿en serio? No es lo que tenía en mente, pero\naquí tienes. Hasta luego.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 4092,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "¡Grum!",
