      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3224,
      "rawDecodedUtf16Hex": "004C006100730020006D006100740065006D00E100740069006300610073000A006E006F00200073006F006E0020006C006F0020007300750079006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Qué mal lleva\nel negocio est<U+0010><U+0003>ᄀÿāea.",
      "escapedControlUnits": 2,
