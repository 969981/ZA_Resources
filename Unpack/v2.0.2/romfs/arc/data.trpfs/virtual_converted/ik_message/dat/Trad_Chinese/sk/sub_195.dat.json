      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "5630FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "啊啊！<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 960,
      "rawDecodedUtf16Hex": "554A554AFF0100100002011401EA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "啊啊！因為打了對戰而餓肚子的\n莫魯貝可心煩意亂，變得好粗暴！<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 976,
      "rawDecodedUtf16Hex": "554A554AFF0156E070BA62534E865C0D6230800C9913809A5B507684000A83AB9B6F8C9D53EF5FC37169610F4E82FF0C8B8A5F97597D7C9766B4FF0100100002011401EA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "看牠們這個性情，\n可不能把闊星的玄關託付給牠們！<U+0010><U+0002>ĔǪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1048,
