      "rawDecodedUtf16Hex": "4F606765542C542C621160F3627E7684623F5B50000A970089816EE18DB34EC04E4867614EF65427300200100002011401840000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "说到密阿雷，就得提棱镜塔！\n我想住在<U+0010><U+0002>＀<U+0006>眼前就是塔<U+0010><U+0002>＀<U+0000>的房子里。<U+0010><U+0002>ĔƄ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "8BF452305BC6963F96F7FF0C5C315F9763D068F1955C5854FF01000A621160F34F4F572800100002FF000006773C524D5C31662F585400100002FF0000007684623F5B5091CC300200100002011401840000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "说到密阿雷，就得提四季运河！\n我想住在河水优雅流淌的<U+0010><U+0002>＀<U+0006>运河沿岸<U+0010><U+0002>＀<U+0000>。<U+0010><U+0002>ĔƄ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 572,
