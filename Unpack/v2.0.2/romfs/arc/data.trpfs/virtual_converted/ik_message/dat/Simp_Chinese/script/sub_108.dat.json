      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "看得我眼花缭乱，\n决定不了搬去哪里才好。<U+0010><U+0002>ĔƄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
