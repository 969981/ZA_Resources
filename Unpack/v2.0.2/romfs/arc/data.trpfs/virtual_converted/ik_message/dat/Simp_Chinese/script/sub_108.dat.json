      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "你来听听我想找的房子\n需要满足什么条件吧。<U+0010><U+0002>ĔƄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
