    {
      "displayText": "¿Querías algo? Si es un combate Pokémon,\npor mí, genial.<U+0010><U+0002>ĔĨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 200,
