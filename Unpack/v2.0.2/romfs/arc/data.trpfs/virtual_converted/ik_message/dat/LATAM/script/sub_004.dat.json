      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1380,
      "rawDecodedUtf16Hex": "00450073007000650072006100200075006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "¡Como si yo no tuviera nada que hacer!<U+0010><U+0002>ĔĨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1416,
