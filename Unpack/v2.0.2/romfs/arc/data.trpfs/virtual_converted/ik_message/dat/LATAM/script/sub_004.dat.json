      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "¡Prepárate para un combate a distancia!\n¡Seré inalcanzable!<U+0010><U+0002>ĔĨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "00A1005000720065007000E100720061007400650020007000610072006100200075006E00200063006F006D006200610074006500200061002000640069007300740061006E0063006900610021000A00A100530065007200E900200069006E0061006C00630061006E007A00610062006C0065002100100002011401280000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
