      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡List<U+0010><U+0003>ᄀÿāoa... para ganar!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "00A1004C00690073007400100003110000FF0101006F0061002E002E002E00200070006100720061002000670061006E0061007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
