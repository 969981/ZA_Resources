      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "但最近大概是陷入了所谓的低潮期，\n总觉得少了一股灵感……<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
