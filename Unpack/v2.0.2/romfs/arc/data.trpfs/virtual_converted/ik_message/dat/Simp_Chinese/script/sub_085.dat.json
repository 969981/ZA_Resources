      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "在看了你的超级喷火驼之后，\n我一定会创造出新的彩色隐形眼镜！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
