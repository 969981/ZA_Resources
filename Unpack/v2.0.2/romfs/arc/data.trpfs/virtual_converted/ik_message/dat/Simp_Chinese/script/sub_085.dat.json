      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "彩色隐形眼镜的颜色\n新增了熊熊燃烧和心醉神迷。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
