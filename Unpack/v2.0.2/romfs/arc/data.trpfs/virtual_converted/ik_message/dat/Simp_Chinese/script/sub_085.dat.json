    },
    {
      "displayText": "我呀……在做\n彩色隐形眼镜的设计哦！<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 224,
