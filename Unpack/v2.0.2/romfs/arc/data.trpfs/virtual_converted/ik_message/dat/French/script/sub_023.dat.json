      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3384,
      "rawDecodedUtf16Hex": "005000490043004F004F004F0054002000210000",
      "trailingZeroPaddingUnits": 1,
