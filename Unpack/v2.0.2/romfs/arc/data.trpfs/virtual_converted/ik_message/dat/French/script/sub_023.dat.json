      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Il faut que tu captures l’Aspicot Baron !<U+0010><U+0002>Ĕļ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "0049006C0020006600610075007400200071007500650020007400750020006300610070007400750072006500730020006C201900410073007000690063006F00740020004200610072006F006E00200021001000020114013C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
