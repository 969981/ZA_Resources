    },
    {
      "displayText": "Soy Viona, la presidenta de Quastelar S. A.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 328,
      "rawDecodedUtf16Hex": "0053006F0079002000560069006F006E0061002C0020006C006100200070007200650073006900640065006E007400610020006400650020005100750061007300740065006C0061007200200053002E00200041002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Los Pokémon son unas criaturas muy\nsingulares y misteriosas...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "004C006F007300200050006F006B00E9006D006F006E00200073006F006E00200075006E0061007300200063007200690061007400750072006100730020006D00750079000A00730069006E00670075006C0061007200650073002000790020006D006900730074006500720069006F007300610073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Viven en todas partes, incluso aquí,\nentre nosotros.",
