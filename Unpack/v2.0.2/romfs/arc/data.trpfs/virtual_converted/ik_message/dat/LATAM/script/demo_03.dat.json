      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "0044006500200068006500630068006F002C00200073006F006E002000740061006E0074006F00730020006C006F007300200071007500650020006E006F007300200061006700720061006300690061006E000A0063006F006E002000730075002000700072006500730065006E006300690061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
