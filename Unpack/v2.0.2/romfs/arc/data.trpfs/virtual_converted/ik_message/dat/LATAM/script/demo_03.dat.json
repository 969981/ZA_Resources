    {
      "displayText": "Les doy la bienvenida a Ciudad Luminalia,\nun lugar en el que conviven humanos y Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 148,
