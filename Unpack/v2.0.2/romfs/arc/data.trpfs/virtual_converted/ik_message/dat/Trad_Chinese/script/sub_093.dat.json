      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "8ACB00100003110000FF01014F6059B3548C645489D29DF94EBA5C0D62305427300200100002011401760000",
      "trailingZeroPaddingUnits": 1,
