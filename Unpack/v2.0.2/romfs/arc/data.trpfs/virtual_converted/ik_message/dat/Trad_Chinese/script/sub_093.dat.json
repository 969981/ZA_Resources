      "rawDecodedUtf16Hex": "202620266454544030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "很高興能和你交手！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "5F889AD8820880FD548C4F604EA4624BFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
