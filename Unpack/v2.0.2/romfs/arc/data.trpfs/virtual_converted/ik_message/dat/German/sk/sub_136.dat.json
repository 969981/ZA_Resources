      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Vorschlag B: <U+0010><U+0002>＀<U+0006>Mega-Entwicklungs-Allee<U+0010><U+0002>＀<U+0000>!<U+0010><U+0001>븁\nAuch wenn sie nichts mit der Mega-Entwicklung\nzu tun hat, der Name gefällt mir trotzdem.<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 10,
