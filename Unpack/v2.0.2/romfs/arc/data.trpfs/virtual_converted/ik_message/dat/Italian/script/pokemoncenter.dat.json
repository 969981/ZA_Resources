      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 3816,
      "rawDecodedUtf16Hex": "00420075006F006E00200063006F006D0070006C00650061006E006E006F002C0020001000020100000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Questo è un giorno speciale!<U+0010><U+0001>븁\nSo che tecnicamente sarei in anticipo\ndi un giorno, ma... buon compleanno!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 3864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "Ti auguro un anno ricco di felicità!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 4080,
      "rawDecodedUtf16Hex": "00540069002000610075006700750072006F00200075006E00200061006E006E006F00200072006900630063006F002000640069002000660065006C006900630069007400E000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
