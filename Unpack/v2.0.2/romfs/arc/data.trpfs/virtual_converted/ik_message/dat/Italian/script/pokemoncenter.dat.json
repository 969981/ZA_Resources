      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 4256,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Ecco, la tua squadra di Pokémon è\nin perfetta forma!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
