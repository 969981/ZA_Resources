      "rawDecodedUtf16Hex": "004700720061007A00690065002000700065007200200061007600650072006C006F0020007200650067006900730074007200610074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "<U+0010><U+0003>ᄆ<U+0002>̂L’Il <U+0010><U+0002>ȁ<U+0002>/<U+0010><U+0002>ȁ<U+0001> fai un salto al Centro Pokémon!<U+0010><U+0001>븁\nSarà un onore averti da noi il giorno del tuo\ncompleanno!",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Il 29/02 fai un salto al Centro Pokémon!\nE se quest’anno non c’è, passa il 28/02!<U+0010><U+0001>븁\nSarà un onore averti da noi per il tuo\ncompleanno!",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "Puoi registrare il giorno del tuo compleanno in\nqualsiasi momento. Fammi sapere se cambi idea!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 3076,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Torna pure quando vuoi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 3268,
      "rawDecodedUtf16Hex": "0054006F0072006E0061002000700075007200650020007100750061006E0064006F002000760075006F006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0003>ᄆ<U+0002>̂L’Il <U+0010><U+0002>ȁ<U+0002>/<U+0010><U+0002>ȁ<U+0001>? Ma... è oggi!!<U+0010><U+0001>븁\nAspetta un momento, inizio subito i preparativi!",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 3316,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "<U+0010><U+0003>ᄆ<U+0002>̂L’Il <U+0010><U+0002>ȁ<U+0002>/<U+0010><U+0002>ȁ<U+0001>? Siamo al 28... Facciamo che quest’anno\nil tuo compleanno si festeggia oggi, dai!!<U+0010><U+0001>븁\nAspetta un momento, inizio subito i preparativi!",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 3492,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
