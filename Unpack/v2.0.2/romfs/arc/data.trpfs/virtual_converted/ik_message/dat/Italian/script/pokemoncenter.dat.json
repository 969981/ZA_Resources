      "offsetInSection": 3804,
      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Buon compleanno, <U+0010><U+0002>Ā<U+0000>!",
