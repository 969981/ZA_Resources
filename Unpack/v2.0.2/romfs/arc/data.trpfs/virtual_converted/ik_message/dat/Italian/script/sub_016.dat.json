      "index": 13,
      "offsetInSection": 2128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 163
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2456,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oooh! Mi hai portato proprio Pansage, Pansear\ne Panpour!<U+0010><U+0002>ĔĴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2468,
      "rawDecodedUtf16Hex": "004F006F006F006800210020004D0069002000680061006900200070006F0072007400610074006F002000700072006F007000720069006F002000500061006E0073006100670065002C002000500061006E0073006500610072000A0065002000500061006E0070006F00750072002100100002011401340000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Grazie! Allora mi metto subito all’opera.\nNon ci vorrà molto.<U+0010><U+0002>ĔĴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2592,
      "rawDecodedUtf16Hex": "004700720061007A00690065002100200041006C006C006F007200610020006D00690020006D006500740074006F002000730075006200690074006F00200061006C006C2019006F0070006500720061002E000A004E006F006E00200063006900200076006F0072007200E00020006D006F006C0074006F002E00100002011401340000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Grazie per la pazienza!<U+0010><U+0002>ĔĴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2724,
