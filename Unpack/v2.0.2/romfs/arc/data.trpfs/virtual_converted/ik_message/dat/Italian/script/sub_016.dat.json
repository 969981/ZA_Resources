    },
    {
      "displayText": "Come saprai, Luminopoli è disseminata di caffè\nche si fanno una concorrenza spietata.<U+0010><U+0002>ĔĴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Per creare un nuovo menu in grado di tenere\ntesta agli altri posti, ho messo gli occhi su...<U+0010><U+0002>ĔĴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
