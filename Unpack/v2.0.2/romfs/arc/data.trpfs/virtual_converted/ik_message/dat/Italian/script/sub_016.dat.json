      "offsetInSection": 380,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "... Pansage, Pansear e Panpour!<U+0010><U+0002>ĔĴ",
