      "rawDecodedUtf16Hex": "003900390039679AFF0100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "不過在密阿雷市，\n是找不到索財靈的硬幣的。<U+0010><U+0002>Ĕǁ",
