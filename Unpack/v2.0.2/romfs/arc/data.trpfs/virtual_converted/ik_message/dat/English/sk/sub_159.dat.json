      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "Spore-tacular Sales with a Fun Guy!<U+0010><U+0002>Ĕǆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1088,
