      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "I think we could solve that problem if we just had\na certain Pokémon around to help.<U+0010><U+0001>븁\nAnd I’ve got the perfect name for my plan:<U+0010><U+0002>Ĕǆ",
      "escapedControlUnits": 4,
