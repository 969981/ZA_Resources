      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "À Illumis, certaines plaques d’égout sont ornées\nde motifs inspirés des Pokémon.<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "On pourrait même dire que ce sont des...\n« Plakémon d’égout » ! Haha !<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Et en voici une !<U+0010><U+0002>ĔƱ",
