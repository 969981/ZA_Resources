      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "0045007400200065006E00200076006F00690063006900200075006E00650020002100100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Comme tu peux le voir, cette plaque d’égout\nde Beau-Vert arbore un joli motif Chevroum !<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Et maintenant, j’ai une question pour toi !<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "004500740020006D00610069006E00740065006E0061006E0074002C0020006A20190061006900200075006E00650020007100750065007300740069006F006E00200070006F0075007200200074006F00690020002100100002011401B10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Quel Pokémon se trouve sur les plaques\nd’égout du quartier de Maurouge ?<U+0010><U+0001>븁\nMontre-moi ce Pokémon en vrai pour\ndonner ta réponse !<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1360,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Montre-moi le Pokémon qu’on peut voir sur\nles plaques d’égout du quartier de Maurouge !<U+0010><U+0002>ĔƱ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Le voici !",
      "escapedControlUnits": 0,
