      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh! Could I take a few leaves from your Skiddo?<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "004F0068002100200043006F0075006C006400200049002000740061006B00650020006100200066006500770020006C00650061007600650073002000660072006F006D00200079006F0075007200200053006B006900640064006F003F00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "I’ll take just a tiny pinch of leaves from your back,\nall right?<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 972,
      "rawDecodedUtf16Hex": "00492019006C006C002000740061006B00650020006A00750073007400200061002000740069006E0079002000700069006E006300680020006F00660020006C00650061007600650073002000660072006F006D00200079006F007500720020006200610063006B002C000A0061006C006C002000720069006700680074003F00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "There! I’ll get this mixed into a new fragrance\nright away.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1112,
