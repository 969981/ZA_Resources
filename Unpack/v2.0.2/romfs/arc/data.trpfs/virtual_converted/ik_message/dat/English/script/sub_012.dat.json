      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "My Skiddo-leaf perfume is ready!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "004D007900200053006B006900640064006F002D006C006500610066002000700065007200660075006D0065002000690073002000720065006100640079002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "I’m glad to say it’s retained that fresh, lovely scent\nthat Skiddo all seem to share.<U+0010><U+0001>븁\nThe leafy-green aroma is so invigorating, yet so\nrelaxing at the same time!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 4,
