    },
    {
      "displayText": "Hi! I’m a perfumer. My work involves preparing\nand mixing fragrances to be used in perfumes.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Recently, I’ve wanted to create a fragrance using\nleaves from a Pokémon called Skiddo.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "But I don’t have a Skiddo of my own. Would you\nbe so kind as to bring me one?<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0004>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Please let me know when you’ve added a Skiddo\nto your party!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 724,
      "rawDecodedUtf16Hex": "0050006C00650061007300650020006C006500740020006D00650020006B006E006F00770020007700680065006E00200079006F00752019007600650020006100640064006500640020006100200053006B006900640064006F000A0074006F00200079006F00750072002000700061007200740079002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
