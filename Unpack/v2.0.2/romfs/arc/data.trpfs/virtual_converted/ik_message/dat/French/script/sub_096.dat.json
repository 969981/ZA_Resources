      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Merci beaucoup ! Ah, vous êtes vraiment l’as\nd’entre les as !<U+0010><U+0002>ĔŹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "004D0065007200630069002000620065006100750063006F0075007000200021002000410068002C00200076006F00750073002000EA00740065007300200076007200610069006D0065006E00740020006C201900610073000A006420190065006E0074007200650020006C006500730020006100730020002100100002011401790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
