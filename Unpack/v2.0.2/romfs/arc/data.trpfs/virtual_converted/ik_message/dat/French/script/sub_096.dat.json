      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2396,
      "rawDecodedUtf16Hex": "0055006E0020004D00E90064006900740069006B006B006100200073006500200063006F006E00740065006E007400650020006420190075006E00650020004200610069006500200070006100720020006A006F00750072002E001000020114019D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Si vous le nourrissez trop, son métabolisme\ns’en voit bouleversé.<U+0010><U+0002>ĔƝ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "0053006900200076006F007500730020006C00650020006E006F0075007200720069007300730065007A002000740072006F0070002C00200073006F006E0020006D00E9007400610062006F006C00690073006D0065000A007320190065006E00200076006F0069007400200062006F0075006C0065007600650072007300E9002E001000020114019D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Oh... Oh non...<U+0010><U+0002>ĔŹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2636,
      "rawDecodedUtf16Hex": "004F0068002E002E002E0020004F00680020006E006F006E002E002E002E00100002011401790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
