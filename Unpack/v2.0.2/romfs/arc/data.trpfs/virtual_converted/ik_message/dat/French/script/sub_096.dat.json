      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Mon pauvre Méditikka est incapable de\nmaintenir sa concentration !<U+0010><U+0002>ĔŹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "004D006F006E00200070006100750076007200650020004D00E90064006900740069006B006B0061002000650073007400200069006E00630061007000610062006C0065002000640065000A006D00610069006E00740065006E0069007200200073006100200063006F006E00630065006E00740072006100740069006F006E0020002100100002011401790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Pourtant, je le nourris assez pour qu’il puisse\ns’exercer à pleine puissance !<U+0010><U+0002>ĔŹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
