      "rawDecodedUtf16Hex": "0056006F0069006C00E000200076006F007400720065002000700072006F0062006C00E8006D0065002E001000020114019D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
