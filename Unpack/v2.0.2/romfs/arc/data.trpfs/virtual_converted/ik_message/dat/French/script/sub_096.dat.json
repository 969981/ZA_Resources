      "rawDecodedUtf16Hex": "004D00E900640069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Et merci à toi d’avoir trouvé l’as du yoga pour moi.<U+0010><U+0002>ĔŹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2984,
      "rawDecodedUtf16Hex": "004500740020006D0065007200630069002000E000200074006F006900200064201900610076006F00690072002000740072006F0075007600E90020006C20190061007300200064007500200079006F0067006100200070006F007500720020006D006F0069002E00100002011401790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Comme pour Méditikka, je vais bien prendre\nsoin de moi pour améliorer ma concentration !<U+0010><U+0002>ĔŹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
