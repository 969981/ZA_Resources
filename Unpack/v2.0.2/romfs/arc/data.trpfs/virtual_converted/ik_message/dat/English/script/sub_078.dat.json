    {
      "displayText": "We’re about to start filming! Please stay out of\nthe way.<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 312,
