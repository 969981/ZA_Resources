      "index": 21,
      "offsetInSection": 2832,
      "rawDecodedUtf16Hex": "005700610074006300680020006F0075007400210020004900742019007300200061002000430061007200760061006E00680061002100100002011401950000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Heeelp!<U+0010><U+0002>ĔƖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2896,
      "rawDecodedUtf16Hex": "0048006500650065006C0070002100100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Rrr... Urrr...",
      "escapedControlUnits": 0,
