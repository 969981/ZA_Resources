      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2444,
      "rawDecodedUtf16Hex": "004C006500740020006D00650020007400680069006E006B002000610062006F007500740020006900740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Please! I’ll pay you!<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "0050006C00650061007300650021002000492019006C006C002000700061007900200079006F0075002100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "All right, we’ve got everything we need... It’s time\nto begin the shoot!<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2540,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Now then, let’s film the next scene... Lights!\nCamera! Action!<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2696,
      "rawDecodedUtf16Hex": "004E006F00770020007400680065006E002C0020006C0065007420190073002000660069006C006D00200074006800650020006E0065007800740020007300630065006E0065002E002E002E0020004C006900670068007400730021000A00430061006D006500720061002100200041006300740069006F006E002100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Watch out! It’s a Carvanha!<U+0010><U+0002>Ĕƕ",
