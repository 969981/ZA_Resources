      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Insgesamt sind uns <U+0010><U+0002>＀<U+0006>zwölf<U+0010><U+0002>＀<U+0000> Puponcho\nverloren gegangen.<U+0010><U+0002>ĔƗ",
