      "offsetInSection": 608,
      "rawDecodedUtf16Hex": "0049006E00200064006500720020005400610074002E00100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Du da, entschuldige bitte! Man sieht sofort,\ndass du <U+0010><U+0004>ᄀÿሒ<U+0000>ein hervorragendereine hervorragende <U+0010><U+0004>ᄀÿइ<U+0000>TrainerTrainerin bist.<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "Vielleicht kannst du uns ja helfen?<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "005600690065006C006C006500690063006800740020006B0061006E006E0073007400200064007500200075006E00730020006A0061002000680065006C00660065006E003F00100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Wir sind riesige Puponcho-Fans, weißt du?<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "005700690072002000730069006E0064002000720069006500730069006700650020005000750070006F006E00630068006F002D00460061006E0073002C002000770065006900DF0074002000640075003F00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Nur leider haben wir unsere Puponcho hier im\nMuseum aus den Augen verloren...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Und da kommst du ins Spiel.<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1236,
      "rawDecodedUtf16Hex": "0055006E00640020006400610020006B006F006D006D0073007400200064007500200069006E007300200053007000690065006C002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Bitte finde unsere verirrten Puponcho!<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1300,
