      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bitte finde unsere zwölf Puponcho! Sie haben\nsich irgendwo hier im Kunstmuseum verirrt.<U+0010><U+0002>ĔƗ",
