      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Eins... zwei... drei... vier... fünf... sechs...<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 6116,
      "rawDecodedUtf16Hex": "00450069006E0073002E002E002E0020007A007700650069002E002E002E00200064007200650069002E002E002E00200076006900650072002E002E002E0020006600FC006E0066002E002E002E002000730065006300680073002E002E002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Sieben... acht... neun... zehn... elf... zwölf...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 6224,
      "rawDecodedUtf16Hex": "00530069006500620065006E002E002E002E00200061006300680074002E002E002E0020006E00650075006E002E002E002E0020007A00650068006E002E002E002E00200065006C0066002E002E002E0020007A007700F6006C0066002E002E002E00100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Dreizehn...?<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 6332,
      "rawDecodedUtf16Hex": "0044007200650069007A00650068006E002E002E002E003F00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Hä?! Seit wann sind es denn dreizehn?!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6368,
      "rawDecodedUtf16Hex": "004800E4003F002100200053006500690074002000770061006E006E002000730069006E0064002000650073002000640065006E006E00200064007200650069007A00650068006E003F002100100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Was machen wir denn jetzt? Mehr als zwölf\nkönnen wir zu zweit nicht mitnehmen.<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 6456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Es wäre wahrscheinlich am besten, wenn <U+0010><U+0004>ᄀÿԆ<U+0000>dieserdiese\n<U+0010><U+0004>ᄀÿᘔ<U+0000>hilfsbereite Trainerhilfsbereite Trainerin es an sich nimmt.<U+0010><U+0001>븁\nWenn wir es hierlassen, macht es vielleicht die\nKunstwerke schmutzig und bekommt Ärger.<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 219
    },
    {
      "displayText": "Huch? Deine Boxen sind ja voll... So kannst du es\ngar nicht mitnehmen.<U+0010><U+0001>븁\nNa gut, dann passen wir hier so lange auf das\nPuponcho auf.<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 7064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Ich frage mich, ob unsere Puponcho losgezogen\nsind, um nach dem dreizehnten Puponcho zu<U+0010><U+0001>븀\nsuchen.<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 7340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Vielen Dank für deine Hilfe mit unseren\nkleinen Lieblingen!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 7548,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B0020006600FC00720020006400650069006E0065002000480069006C006600650020006D0069007400200075006E0073006500720065006E000A006B006C00650069006E0065006E0020004C006900650062006C0069006E00670065006E002100100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    }
