      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 74,
      "utf16Units": 147
    },
    {
      "displayText": "<U+0010><U+0007>！<U+0002><U+0002>見積みつ見積もりは<U+0010><U+0008>！<U+0002><U+0003>大事だいじ大事だぜ\n<U+0010><U+000C>！<U+0003><U+0006>口約束くちやくそく口約束で<U+0010><U+0005>！<U+0001><U+0001>済す済ますなよ！",
