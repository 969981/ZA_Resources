      "offsetInSection": 6072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 67,
      "utf16Units": 133
    },
    {
      "displayText": "ムクちゃん\nしょいこむタイプだからなー<U+0010><U+0002>Ĕ<U+000F>",
