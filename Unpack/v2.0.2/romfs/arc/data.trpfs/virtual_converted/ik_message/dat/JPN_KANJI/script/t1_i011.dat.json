      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 49,
      "utf16Units": 97
    },
    {
      "displayText": "おかしなファンから<U+0010><U+0006>！<U+0001><U+0002>守まも守るための\nホロカナリィだったが……<U+0010><U+0001>븀\n<U+0010><U+0006>！<U+0001><U+0002>演えん演じるうちに<U+0010><U+0006>！<U+0001><U+0002>楽たの楽しくなったのじゃ！<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 17,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 4912,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 76,
      "utf16Units": 151
    },
    {
      "displayText": "カラフルなネジは\nわしらなりの<U+0010><U+0006>！<U+0001><U+0002>遊あそ遊び<U+0010><U+0007>！<U+0001><U+0003>心ごころ心じゃ！<U+0010><U+0001>븀\n<U+0010><U+0006>！<U+0001><U+0002>楽たの楽しい<U+0010><U+0006>！<U+0001><U+0002>思おも思い<U+0010><U+0005>！<U+0001><U+0001>出で出があれば<U+0010><U+0006>！<U+0001><U+0002>街まち街を<U+0010><U+0005>！<U+0001><U+0001>好す好きになる<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 33,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 5216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 102,
      "utf16Units": 203
    },
    {
      "displayText": "でっかい<U+0010><U+0008>！<U+0002><U+0003>仕事しごと仕事がはじまりそうじゃの！<U+0010><U+0002>Ĕ<U+0010>",
