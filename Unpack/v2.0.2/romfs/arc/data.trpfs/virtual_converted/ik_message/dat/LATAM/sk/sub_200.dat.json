  "messages": [
    {
      "displayText": "Disculpa... Estoy preocupada porque apareció\nun Pokémon que nunca antes había visto.<U+0010><U+0002>Ĕǯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
