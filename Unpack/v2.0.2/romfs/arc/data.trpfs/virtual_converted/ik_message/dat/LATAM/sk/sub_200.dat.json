      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "¿No sería mejor que atraparas a ese Pokémon?\nParece poca cosa, pero seguro que es resistente.<U+0010><U+0002>Ĕǯ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
