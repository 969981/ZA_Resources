      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "太出色了！\n那麼，我們立刻開始下一場對戰吧！<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
