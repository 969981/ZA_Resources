      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 464,
      "rawDecodedUtf16Hex": "800C4E1462119084670370BA001000020100000000100003110000FF02025148751F5C0F59D000100003110000FF01014F6059B3000A8A087B97902352DD7D009304FF0C00100001BE00000A5C317B97662F621176844E009EDE5FC3610FFF0100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0003>ᄀÿȂ先生小姐<U+0010><U+0003>ᄀÿā你妳的最高紀錄是\n<U+0010><U+0003>ȅ<U+0002><U+0000>連勝！<U+0010><U+0002>Ĕ<U+0015>",
