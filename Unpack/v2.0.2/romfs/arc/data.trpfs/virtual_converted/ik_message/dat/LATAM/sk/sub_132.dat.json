  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Tú debes ser <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "005400FA002000640065006200650073002000730065007200200010000201000000002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Me encanta esta foto que subió la streamer\nque más sigo. ¡Mira! Es muy genial.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Naria y su Eelektross, de chill en una banca...\n¡Es lo más!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "004E006100720069006100200079002000730075002000450065006C0065006B00740072006F00730073002C0020006400650020006300680069006C006C00200065006E00200075006E0061002000620061006E00630061002E002E002E000A00A1004500730020006C006F0020006D00E10073002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "¡Yo también quiero sentarme en esa misma\nbanca y tomarme una foto con mi Manectric!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Así que tengo un favorcito que pedirte.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 860,
      "rawDecodedUtf16Hex": "0041007300ED0020007100750065002000740065006E0067006F00200075006E0020006600610076006F0072006300690074006F002000710075006500200070006500640069007200740065002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡Necesito que encuentres la banca de la foto!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "00A1004E006500630065007300690074006F002000710075006500200065006E006300750065006E00740072006500730020006C0061002000620061006E006300610020006400650020006C006100200066006F0074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "¡Nec!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1048,
      "rawDecodedUtf16Hex": "00A1004E0065006300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres ver la foto de la banca otra vez?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200076006500720020006C006100200066006F0074006F0020006400650020006C0061002000620061006E006300610020006F007400720061002000760065007A003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Sí, por favor",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "005300ED002C00200070006F00720020006600610076006F00720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "No hace falta, gracias",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "004E006F00200068006100630065002000660061006C00740061002C002000670072006100630069006100730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Esta es la banca! ¿Sabes dónde está?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "00A100450073007400610020006500730020006C0061002000620061006E006300610021002000BF005300610062006500730020006400F3006E00640065002000650073007400E1003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "¡Necesito que encuentres la banca de la foto!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "00A1004E006500630065007300690074006F002000710075006500200065006E006300750065006E00740072006500730020006C0061002000620061006E006300610020006400650020006C006100200066006F0074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Encontraste la banca de la foto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "00A10045006E0063006F006E0074007200610073007400650020006C0061002000620061006E006300610020006400650020006C006100200066006F0074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Mira esas dos macetas en fila y los edificios del\nfondo... ¡Hasta las montañas son las mismas!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "¡No hay duda! ¡Naria se tomó la foto aquí!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "00A1004E006F0020006800610079002000640075006400610021002000A1004E006100720069006100200073006500200074006F006D00F30020006C006100200066006F0074006F002000610071007500ED002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "¡Vamos, no hay tiempo que perder!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1804,
      "rawDecodedUtf16Hex": "00A100560061006D006F0073002C0020006E006F00200068006100790020007400690065006D0070006F00200071007500650020007000650072006400650072002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¿No me veo igual a Naria en esta pose?\n¡Cualquiera me confundiría con ella!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "¿Te puedo pedir otro favorcito, <U+0010><U+0002>Ā<U+0000>?\n¿Me tomarías una foto igual a la de ella?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Pero que sea exactamente igual, ¿eh?\n¡Mismo ángulo, misma exposición, mismo TODO!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Avísame si quieres ver la foto original de nuevo.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "0041007600ED00730061006D00650020007300690020007100750069006500720065007300200076006500720020006C006100200066006F0074006F0020006F0072006900670069006E0061006C0020006400650020006E007500650076006F002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "¿Quieres ver la foto de Naria?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200076006500720020006C006100200066006F0074006F0020006400650020004E0061007200690061003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Sí, por favor<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2560,
      "rawDecodedUtf16Hex": "005300ED002C00200070006F00720020006600610076006F007200100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "No hace falta, gracias<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "004E006F00200068006100630065002000660061006C00740061002C0020006700720061006300690061007300100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "¡Tómame la foto desde lejos, como la de Naria!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2652,
      "rawDecodedUtf16Hex": "00A1005400F3006D0061006D00650020006C006100200066006F0074006F0020006400650073006400650020006C0065006A006F0073002C00200063006F006D006F0020006C00610020006400650020004E0061007200690061002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sí, es más o menos ahí...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2768,
      "rawDecodedUtf16Hex": "005300ED002C0020006500730020006D00E100730020006F0020006D0065006E006F007300200061006800ED002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "O quizás no.<U+0010><U+0001>븁\nMe parece que el ángulo no es el mismo...\n¡La idea es recrear la escena a la perfección!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 2828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3048,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Ahí! ¡Perfecto! ¡Toma la foto desde ahí!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3060,
      "rawDecodedUtf16Hex": "00A10041006800ED0021002000A10050006500720066006500630074006F0021002000A10054006F006D00610020006C006100200066006F0074006F00200064006500730064006500200061006800ED002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "A ver qué tal salió...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3152,
      "rawDecodedUtf16Hex": "0041002000760065007200200071007500E9002000740061006C002000730061006C006900F3002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "¡E-estoy igual! ¡Me veo exactamente como Naria!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3208,
      "rawDecodedUtf16Hex": "00A10045002D006500730074006F007900200069006700750061006C0021002000A1004D0065002000760065006F0020006500780061006300740061006D0065006E0074006500200063006F006D006F0020004E0061007200690061002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Buenísimo, ahora la publicaré en mis redes...\n¡Listo!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3312,
      "rawDecodedUtf16Hex": "004200750065006E00ED00730069006D006F002C002000610068006F007200610020006C00610020007000750062006C006900630061007200E900200065006E0020006D00690073002000720065006400650073002E002E002E000A00A1004C006900730074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Me pregunto quién tomó la foto original.\n¿Será ese productor suyo del que tanto se habla?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3428,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "¡Debería dedicarse a producir más artículos\nde colección!<U+0010><U+0001>븁\nEl Pan de Naria está bien, pero sería un sueño\ntener figuras y llaveros.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Bueno, voy a seguir recreando más fotos de Naria,\n¡para eso vine a Ciudad Luminalia!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "¡Gracias por tu ayuda, <U+0010><U+0002>Ā<U+0000>!\n¿Y si descansas en la banca, ya que estás aquí?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "¡Nos vemos!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4236,
      "rawDecodedUtf16Hex": "00A1004E006F0073002000760065006D006F0073002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4268,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Para la próxima, estaría buenísimo tomarme\nuna foto donde se celebra la Trivia Nariática!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4280,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "¡Tric!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4472,
      "rawDecodedUtf16Hex": "00A1005400720069006300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    }
