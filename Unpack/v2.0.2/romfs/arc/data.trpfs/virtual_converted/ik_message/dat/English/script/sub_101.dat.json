      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5248,
      "rawDecodedUtf16Hex": "00100002BDFF002A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Thanks to you, I’ve gained something far more\nvaluable than a kitchen knife. I’m so grateful!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
