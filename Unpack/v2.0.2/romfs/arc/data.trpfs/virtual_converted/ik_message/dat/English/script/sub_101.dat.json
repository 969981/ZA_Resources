      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh! It’s a Skarmory feather!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "004F00680021002000490074201900730020006100200053006B00610072006D006F007200790020006600650061007400680065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
