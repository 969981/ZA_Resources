      "rawDecodedUtf16Hex": "00490074201900730020006D0061006E006500200068006100690072002000660072006F006D00200061002000660065006D0061006C00650020005000790072006F00610072002E002E002E00200054006F006F002000620061006400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
