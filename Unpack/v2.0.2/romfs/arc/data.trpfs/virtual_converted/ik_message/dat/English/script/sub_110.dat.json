      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "0053006F002000490020006E00650065006400200079006F007500200074006F00200064006F00200073006F006D0065007400680069006E006700200066006F00720020006D0065002100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Show my Clauncher how cool your Pokémon\nlooks using Water Gun to wash away that sludge!<U+0010><U+0001>븀\nMaybe then it’ll want to give it a try too.<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 4,
