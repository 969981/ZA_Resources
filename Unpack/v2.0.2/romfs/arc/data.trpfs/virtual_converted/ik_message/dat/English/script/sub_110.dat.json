      "rawDecodedUtf16Hex": "00530068007700610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "So I need you to do something for me!<U+0010><U+0002>ĔƆ",
