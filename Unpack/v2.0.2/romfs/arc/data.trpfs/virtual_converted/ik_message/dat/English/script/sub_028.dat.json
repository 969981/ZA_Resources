      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "What a relief! If it really had been paranormal\nactivity, I would’ve had to move across town!<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "But I suppose we can’t let this Dedenne keep\nwreaking havoc with our circuits... What to do?<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
