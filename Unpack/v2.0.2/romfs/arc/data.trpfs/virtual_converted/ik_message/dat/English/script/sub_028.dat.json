      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "00440065006E006E00650065006500650065006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "OK, how about this. Let’s search for a Trainer to\nlook after you properly, shall we?<U+0010><U+0001>븁\nIn the meantime, you’re not to steal electricity.\nIf you do, you’re out on the street—got it?<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 3108,
