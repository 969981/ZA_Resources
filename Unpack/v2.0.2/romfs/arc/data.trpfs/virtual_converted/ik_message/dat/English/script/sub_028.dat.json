      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "The sort of things you might even call “paranormal\nactivity,” if you believe in all that.<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
