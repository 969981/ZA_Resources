      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Speakers in empty rooms have suddenly started\nplaying music, our building keeps losing power...<U+0010><U+0002>ĔĿ",
