      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "나는 순백아가씨라고 해.\n앞으로 잘 부탁해.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
