      "index": 5,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "B098B2940020C21CBC31C544AC00C528002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
