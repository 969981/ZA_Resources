      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "어느 포켓몬을\n순백의 상태로 만들어 줄까?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
