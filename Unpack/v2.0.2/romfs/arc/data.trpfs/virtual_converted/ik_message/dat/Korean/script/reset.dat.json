      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>Ă<U+0003>의\n기초 포인트가 전부 초기화되었다!",
      "escapedControlUnits": 3,
