      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Please purchase either a <U+0010><U+0002>＀<U+0006>Jaw Fossil <U+0010><U+0002>＀<U+0000>or a <U+0010><U+0002>＀<U+0006>Sail<U+0010><U+0002>＀<U+0000>\n<U+0010><U+0002>＀<U+0006>Fossil<U+0010><U+0002>＀<U+0000> for me, then bring it back here.<U+0010><U+0001>븁\nRemember, the Stone Emporium is over on Vernal\nAvenue!<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 22,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1416,
