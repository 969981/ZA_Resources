      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "0054007900720061006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
