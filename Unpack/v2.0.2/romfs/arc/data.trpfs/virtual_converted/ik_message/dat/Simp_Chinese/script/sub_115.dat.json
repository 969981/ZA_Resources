      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "它好像把我的\n树果也全都留下了。<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
