  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 220,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Che meraviglia le zone selvagge! Passo le giornate\na catturare Magikarp.<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 232,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Guarda un po’! Ne ho catturato uno enorme!<U+0010><U+0001>븁\nNon dico mica bugie! Ho controllato pure in \"Info\"\ne dice proprio che è di taglia XL!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 136
    },
    {
      "displayText": "Grosso e pieno di energie! Anche i suoi Splash\ngli fanno fare salti fuori dal comune!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Al mondo non può esserci un Magikarp più\ngrande del mio!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 840,
      "rawDecodedUtf16Hex": "0041006C0020006D006F006E0064006F0020006E006F006E00200070007500F20020006500730073006500720063006900200075006E0020004D006100670069006B00610072007000200070006900F9000A006700720061006E00640065002000640065006C0020006D0069006F0021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Ma se tu dovessi catturarne uno di taglia più\ngrande della XL... Beh, portalo qui! Voglio vederlo!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Ho sentito dire che nella zona selvaggia 2 c’è\nun Magikarp gigante! Magari sono solo dicerie...<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Se catturi un Magikarp più grande del mio,\nportamelo qui! Devo vederlo con i miei occhi!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Non può esistere un Magikarp più grande del mio.<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "004E006F006E00200070007500F200200065007300690073007400650072006500200075006E0020004D006100670069006B00610072007000200070006900F90020006700720061006E00640065002000640065006C0020006D0069006F002E001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Eh no! Non regge il confronto con il mio Magikarp!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "004500680020006E006F00210020004E006F006E00200072006500670067006500200069006C00200063006F006E00660072006F006E0074006F00200063006F006E00200069006C0020006D0069006F0020004D006100670069006B0061007200700021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Lo sapevo che era impossibile! Ah ah ah!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1792,
      "rawDecodedUtf16Hex": "004C006F002000730061007000650076006F0020006300680065002000650072006100200069006D0070006F00730073006900620069006C006500210020004100680020006100680020006100680021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Eh?! Quel Magikarp...!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1884,
      "rawDecodedUtf16Hex": "00450068003F00210020005100750065006C0020004D006100670069006B006100720070002E002E002E0021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Uaaah... Il mio Magikarp l’ha spuntata,\nma proprio per un pelo...<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1940,
      "rawDecodedUtf16Hex": "00550061006100610068002E002E002E00200049006C0020006D0069006F0020004D006100670069006B0061007200700020006C2019006800610020007300700075006E0074006100740061002C000A006D0061002000700072006F007000720069006F002000700065007200200075006E002000700065006C006F002E002E002E001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "C-Cosa?! Ma che razza di Magikarp è questo...?!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "0043002D0043006F00730061003F00210020004D00610020006300680065002000720061007A007A00610020006400690020004D006100670069006B006100720070002000E8002000710075006500730074006F002E002E002E003F0021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Eh? Un alfa...?<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "00450068003F00200055006E00200061006C00660061002E002E002E003F001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Ma come sarebbe a dire un alfa?!\nQuesto è contro le regole!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "004D006100200063006F006D006500200073006100720065006200620065002000610020006400690072006500200075006E00200061006C00660061003F0021000A00510075006500730074006F002000E800200063006F006E00740072006F0020006C00650020007200650067006F006C00650021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "E comunque la sfida non finisce qua!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "004500200063006F006D0075006E0071007500650020006C00610020007300660069006400610020006E006F006E002000660069006E006900730063006500200071007500610021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "La caratteristica intrinseca dei Magikarp sono\ni salti che fa con Splash! Allora facciamo a chi<U+0010><U+0001>븀\nsalta più in alto!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "Pronti... via! Forza, Magikarp XL! Fai vedere di\ncosa sei capace!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2680,
      "rawDecodedUtf16Hex": "00500072006F006E00740069002E002E002E0020007600690061002100200046006F0072007A0061002C0020004D006100670069006B00610072007000200058004C002100200046006100690020007600650064006500720065002000640069000A0063006F00730061002000730065006900200063006100700061006300650021001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "C-Co... sa...? Non è possibile... Quel salto...<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2820,
      "rawDecodedUtf16Hex": "0043002D0043006F002E002E002E002000730061002E002E002E003F0020004E006F006E002000E800200070006F00730073006900620069006C0065002E002E002E0020005100750065006C002000730061006C0074006F002E002E002E001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Abbiamo perso... Una vera disfatta.<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2924,
      "rawDecodedUtf16Hex": "00410062006200690061006D006F00200070006500720073006F002E002E002E00200055006E006100200076006500720061002000640069007300660061007400740061002E001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Non solo l’alfa è enorme, ma salta pure così\nin alto...<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3004,
      "rawDecodedUtf16Hex": "004E006F006E00200073006F006C006F0020006C20190061006C00660061002000E800200065006E006F0072006D0065002C0020006D0061002000730061006C007400610020007000750072006500200063006F007300EC000A0069006E00200061006C0074006F002E002E002E001000020114013D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Che storia, questi alfa... Beh, direi che è deciso.\nSarà il mio prossimo obiettivo!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Voglio una bella schiera di Magikarp giganteschi.\nZona selvaggia 2, arrivo!!<U+0010><U+0002>ĔĽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3300,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
