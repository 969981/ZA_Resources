      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3464,
      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Lo troverò anch’io un Magikarp alfa!\nPuoi starne cert<U+0010><U+0003>ᄀÿāoa!<U+0010><U+0002>ĔĽ",
