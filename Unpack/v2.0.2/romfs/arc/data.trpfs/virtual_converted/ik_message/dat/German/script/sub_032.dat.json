      "rawDecodedUtf16Hex": "004C006F007200210020004C006F007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Sichlor hat sich eine geschmeidige Schnitttechnik\nangeeignet!<U+0010><U+0001>븁\nDir stehen jetzt mehr Frisuren für Coiffwaff\nzur Auswahl.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Ich bin so froh, dass ich dich auch diesmal wieder\num Hilfe gebeten habe. Danke!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
