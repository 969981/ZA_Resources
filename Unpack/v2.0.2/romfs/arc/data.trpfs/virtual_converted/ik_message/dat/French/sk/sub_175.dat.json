      "index": 59,
      "offsetInSection": 7808,
      "rawDecodedUtf16Hex": "0052006500670061007200640065007A00200063006F006D006D006500200046007200690067006F0064006F002000610020006C201900610069007200200068006500750072006500750078002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
