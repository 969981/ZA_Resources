      "offsetInSection": 8756,
      "rawDecodedUtf16Hex": "00100002BDFF00430000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Je vais... Je vais essayer de faire de mon mieux\npour surmonter ma timidité...<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 8768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
