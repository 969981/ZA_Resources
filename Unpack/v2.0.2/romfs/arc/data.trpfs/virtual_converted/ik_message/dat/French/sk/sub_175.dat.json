      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 8936,
      "rawDecodedUtf16Hex": "0044006F00200021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Parlons de nos Pokémon, ça nous permettra\nde mieux nous connaître !<U+0010><U+0002>Ĕǐ",
