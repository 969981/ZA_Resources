      "rawDecodedUtf16Hex": "0010000201000000002E002E002E002000C0002E002E002E002000C00020006C20190061006900640065002E002E002E00100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Regardez comme Frigodo a l’air heureux !",
