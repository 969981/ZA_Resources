      "rawDecodedUtf16Hex": "0052006500670061007200640065007A00200063006F006D006D006500200046007200690067006F0064006F002000610020006C20190061006900720020006D006F00740069007600E9002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Mais... mais... Ces gens... Ils sont tout près...\nJ’ai... j’ai peur...<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 7972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Pas de problème ! Et si nous prenions un peu\nde distance pour parler de nos Pokémon ?<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 8124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Et même si nous n’avons rien à dire, au moins,\nnos Pokémon peuvent s’amuser ensemble !<U+0010><U+0002>ĔǑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 63,
      "offsetInSection": 8304,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Mon Mangriff a plein de qualités !\nEt Frigodo ? Qu’est-ce qui le rend unique ?<U+0010><U+0002>Ĕǒ",
