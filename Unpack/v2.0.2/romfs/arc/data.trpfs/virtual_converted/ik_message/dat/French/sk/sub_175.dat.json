      "rawDecodedUtf16Hex": "0047006F0064006F006F006F002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>... À... À l’aide...<U+0010><U+0002>ĔǏ",
