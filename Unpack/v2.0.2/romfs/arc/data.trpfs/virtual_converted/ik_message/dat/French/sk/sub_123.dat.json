  "initialKey": 0,
  "messages": [
    {
      "displayText": "Sape !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "0053006100700065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Salut ! Merci encore pour ton aide contre\nl’énorme Sapereau !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 276,
      "rawDecodedUtf16Hex": "00530061006C00750074002000210020004D006500720063006900200065006E0063006F0072006500200070006F0075007200200074006F006E0020006100690064006500200063006F006E007400720065000A006C201900E9006E006F0072006D00650020005300610070006500720065006100750020002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "J’ai rien pu faire à part te regarder combattre...\nJe me suis senti complétement inutile.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 408,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Mais ce jour-là, c’est comme si une étincelle\nm’avait embrasé de l’intérieur !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "J’aimerais... non, je VEUX devenir aussi\nfort que toi !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 764,
      "rawDecodedUtf16Hex": "004A201900610069006D00650072006100690073002E002E002E0020006E006F006E002C0020006A00650020005600450055005800200064006500760065006E00690072002000610075007300730069000A0066006F00720074002000710075006500200074006F00690020002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Et je peux te dire que je suis déterminé !<U+0010><U+0001>븁\nJ’ai tout repris de zéro, en tant que Dresseur,\net en tant que Randonneur.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 884,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> !\nBats-toi contre moi, ici et maintenant !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "001000020100000000200021000A0042006100740073002D0074006F006900200063006F006E0074007200650020006D006F0069002C00200069006300690020006500740020006D00610069006E00740065006E0061006E00740020002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Je vais te montrer la force immense du lien que\nj’ai tissé avec mes Pokémon !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Ah, j’en ai des frissons...\nC’est l’anticipation du combat !<U+0010><U+0001>븁\nPrends le temps de te préparer et\nreviens me voir pour qu’on se batte.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "T’es prêt<U+0010><U+0003>ᄀÿĀe pour le combat ?<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "005420190065007300200070007200EA007400100003110000FF0100006500200070006F007500720020006C006500200063006F006D0062006100740020003F00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Carrément !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1772,
      "rawDecodedUtf16Hex": "004300610072007200E9006D0065006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "J’ai encore des trucs à faire...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "004A20190061006900200065006E0063006F007200650020006400650073002000740072007500630073002000E0002000660061006900720065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "OK !\nEn garde !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "004F004B00200021000A0045006E0020006700610072006400650020002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Saaape !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "005300610061006100700065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "C’est parti...<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1924,
      "rawDecodedUtf16Hex": "00432019006500730074002000700061007200740069002E002E002E00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "PAR LA FORCE...<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1964,
      "rawDecodedUtf16Hex": "0050004100520020004C004100200046004F005200430045002E002E002E00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "DE NOTRE PROFONDE...<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "004400450020004E004F005400520045002000500052004F0046004F004E00440045002E002E002E00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "AMITIÉ !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2056,
      "rawDecodedUtf16Hex": "0041004D00490054004900C90020002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2084,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sapereau !\nMontrons-lui la grandeur de notre amitié !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2096,
      "rawDecodedUtf16Hex": "0053006100700065007200650061007500200021000A004D006F006E00740072006F006E0073002D006C007500690020006C00610020006700720061006E00640065007500720020006400650020006E006F00740072006500200061006D00690074006900E90020002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Alors ? T’en as pensé quoi ? C’était pas évident\nde capturer et d’entraîner tous ces Barons !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Y a pas à dire, les Barons sont incroyables...\nC’est comme s’ils regorgeaient de la puissance<U+0010><U+0001>븀\nsauvage de la nature !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "Si ça se trouve, il y a très longtemps,\ntous les Pokémon étaient des Barons !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Moi, je suis né et j’ai grandi à Illumis,\net j’y suis attaché.<U+0010><U+0001>븁\nMais un jour, j’ai réalisé qu’il fallait que je quitte\nma ville natale pour explorer le monde !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 166
    },
    {
      "displayText": "Pendant mes voyages, j’ai fait des tas\nde découvertes et de nouvelles rencontres !<U+0010><U+0001>븁\nEt maintenant que je suis de retour, j’ai bien\nl’intention de continuer sur cette voie.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 178
    },
    {
      "displayText": "Tu sais, tout ça, ça m’a fait réaliser un truc.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3520,
      "rawDecodedUtf16Hex": "0054007500200073006100690073002C00200074006F00750074002000E70061002C002000E700610020006D20190061002000660061006900740020007200E90061006C006900730065007200200075006E00200074007200750063002E00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Tant qu’on garde l’âme d’un voyageur et qu’on\nreste ouvert d’esprit, l’aventure s’offre à nous<U+0010><U+0001>븀\nqu’on soit dans un pays inconnu ou chez soi !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 148
    },
    {
      "displayText": "Je vais rester à Illumis pendant quelque temps,\net voyager ici à ma façon.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Sape-sape !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4080,
      "rawDecodedUtf16Hex": "0053006100700065002D0073006100700065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Merci d’avoir accepté de te battre contre moi.\nUn jour, j’arriverai à ton niveau !<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
