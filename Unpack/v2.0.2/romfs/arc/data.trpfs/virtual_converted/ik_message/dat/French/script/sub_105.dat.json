      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Non, il faut une capacité de type Feu qui génère\nbeaucoup de chaleur, sinon ça ne marchera pas !<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
