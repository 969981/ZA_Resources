      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2060,
      "rawDecodedUtf16Hex": "00C70061002000610020006D006100720063006800E9002000210020004D006F006E0020004300680061006D0061006C006C006F0074002000650073007400200065006E00660069006E0020006C006900620072006500200021000A004D006500720063006900200069006E00660069006E0069006D0065006E00740020002100100002011401800000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Tout va bien, Chamallot ?!<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 2,
