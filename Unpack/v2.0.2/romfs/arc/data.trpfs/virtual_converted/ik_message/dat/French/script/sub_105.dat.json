      "rawDecodedUtf16Hex": "00C00020006C2019006100690064006500200021000A004D006F006E0020004300680061006D0061006C006C006F0074002000650073007400200063006F006D0070006C00E800740065006D0065006E0074002000670065006C00E9002000210021002100100002011401800000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Tu ne devineras jamais ce qui s’est passé ! On se\nbaladait dans une zone sauvage, tranquilles...<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Quand soudain, on s’est retrouvés en plein milieu\nd’une bagarre entre Pokémon sauvages !<U+0010><U+0001>븁\nMon pauvre Chamallot s’est pris pas moins\nde dix Laser Glace en pleine face !<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 174
    },
    {
      "displayText": "Il a beau être de type Feu, la glace ne fond pas\ndu tout !<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "0049006C0020006100200062006500610075002000EA007400720065002000640065002000740079007000650020004600650075002C0020006C006100200067006C0061006300650020006E006500200066006F006E00640020007000610073000A0064007500200074006F007500740020002100100002011401800000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Même mes Antigels ne marchent pas... Il ne reste\ndonc qu’une solution : une capacité de type Feu !<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Toi qui es Dresseu<U+0010><U+0003>ᄀÿȁrse, tu peux utiliser une capacité\nde type Feu assez puissante pour le dégeler ?<U+0010><U+0002>Ĕƀ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
