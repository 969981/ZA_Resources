      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 6084,
      "rawDecodedUtf16Hex": "00410075006E0071007500650020006300720065006F0020007100750065002000740065002000680061007300200063006F006C00610064006F00200065006E00200061006C00670075006E0061000A00700072006500670075006E00740061002C0020006D00650067006100700072006F00660065002E002E002E001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¿Te has equivocado en todo a propósito para ver\nsi nos dábamos cuenta?<U+0010><U+0002>Ĕů",
