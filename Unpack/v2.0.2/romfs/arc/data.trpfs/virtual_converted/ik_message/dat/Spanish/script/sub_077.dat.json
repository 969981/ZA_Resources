      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 6552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
