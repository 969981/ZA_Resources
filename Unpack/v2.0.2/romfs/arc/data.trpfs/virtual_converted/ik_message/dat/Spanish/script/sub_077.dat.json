      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 6868,
      "rawDecodedUtf16Hex": "0059006F002000710075006900650072006F0020006500730074007500640069006100720020007000610072006100200073006500720020006D00650067006100650076006F006C007500630069006F006E00610064006F0072002E001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
