      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 6792,
      "rawDecodedUtf16Hex": "00A1004C00610020006D00650067006100650076006F006C00750063006900F3006E0020006D006F006C00610020006D006F0067006F006C006C00F3006E002100100002011401990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
