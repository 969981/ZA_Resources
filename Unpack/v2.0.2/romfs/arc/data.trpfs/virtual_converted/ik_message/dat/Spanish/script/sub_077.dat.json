      "index": 57,
      "offsetInSection": 5984,
      "rawDecodedUtf16Hex": "00A1004D00650067006100700072006F00660065002C00200073006100620065007300200075006E0020006D006F006E007400F3006E0020006400650020006D00650067006100650076006F006C00750063006900F3006E0021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Aunque creo que te has colado en alguna\npregunta, megaprofe...<U+0010><U+0002>Ĕů",
