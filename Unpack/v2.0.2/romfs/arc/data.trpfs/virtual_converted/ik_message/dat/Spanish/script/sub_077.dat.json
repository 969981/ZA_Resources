      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "¡Vaya preguntas más raras hacéis!\nAhora me toca a mí.<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 5320,
      "rawDecodedUtf16Hex": "00A10056006100790061002000700072006500670075006E0074006100730020006D00E10073002000720061007200610073002000680061006300E9006900730021000A00410068006F007200610020006D006500200074006F00630061002000610020006D00ED002E001000020114019C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Oye, megaevoluciooo... nadorista, ¿cuál\nmegaevolución te parece que es la más fuerte?<U+0010><U+0002>ĔƜ",
