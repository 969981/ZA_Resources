      "rawDecodedUtf16Hex": "004C00750066006600210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Ab jetzt wirst du doch regelmäßig duschen, oder?<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
