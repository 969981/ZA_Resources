      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2616,
      "rawDecodedUtf16Hex": "00100002BDFF00110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich freu mich so, dass du wieder sauber bist,\nKnuddeluff! Und der Gestank ist auch weg!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
