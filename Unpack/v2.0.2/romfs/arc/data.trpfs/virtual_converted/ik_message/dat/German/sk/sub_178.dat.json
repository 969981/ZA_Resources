      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Luff!!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2932,
      "rawDecodedUtf16Hex": "004C0075006600660021002100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Knuddeluff setzt eine gewaltige Ohrfeige ein!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2956,
      "rawDecodedUtf16Hex": "004B006E0075006400640065006C0075006600660020007300650074007A0074002000650069006E006500200067006500770061006C00740069006700650020004F0068007200660065006900670065002000650069006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "W-Was...? Aber warum...?<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3048,
      "rawDecodedUtf16Hex": "0057002D005700610073002E002E002E003F0020004100620065007200200077006100720075006D002E002E002E003F00100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Kann es sein... dass es sein Fell absichtlich\nso schmutzig gemacht hat, weil ich es immerzu<U+0010><U+0001>븀\ngestreichelt habe?<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3108,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Heeey! Warte, Knuddeluff! Warte!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3344,
      "rawDecodedUtf16Hex": "004800650065006500790021002000570061007200740065002C0020004B006E0075006400640065006C0075006600660021002000570061007200740065002100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
