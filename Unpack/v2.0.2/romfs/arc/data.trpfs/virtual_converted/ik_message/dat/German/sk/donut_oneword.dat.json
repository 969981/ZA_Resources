{
  "declaredLength": 10532,
  "decoding": "confirmed-per-slot-XOR-rotate3-index-seed",
  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Solange ich Beeren kriege, kann ich dir jeden\nDonut zaubern!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "0053006F006C0061006E006700650020006900630068002000420065006500720065006E0020006B00720069006500670065002C0020006B0061006E006E002000690063006800200064006900720020006A006500640065006E000A0044006F006E007500740020007A00610075006200650072006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Der Geschmack meiner berühmten Donuts hängt\nganz von der Beerenkombination ab!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 696,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Weißt du, warum Donuts ein Loch haben?\nDamit sie gleichmäßiger garen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "00570065006900DF0074002000640075002C00200077006100720075006D00200044006F006E007500740073002000650069006E0020004C006F0063006800200068006100620065006E003F000A00440061006D00690074002000730069006500200067006C0065006900630068006D00E400DF006900670065007200200067006100720065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Was mag man wohl sehen, wenn man die Welt\ndurch das Loch eines Donuts betrachtet?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Das Kneten von Donutteig macht mir ganz\nbesonders Spaß!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1160,
      "rawDecodedUtf16Hex": "0044006100730020004B006E006500740065006E00200076006F006E00200044006F006E0075007400740065006900670020006D00610063006800740020006D00690072002000670061006E007A000A006200650073006F006E0064006500720073002000530070006100DF00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Ob man den Teig ruhen lässt oder nicht,\nwirkt sich auf die Konsistenz eines Donuts aus!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Antjas Donutladen – das süße Aushängeschild\ndes Hotel Z!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1448,
      "rawDecodedUtf16Hex": "0041006E0074006A0061007300200044006F006E00750074006C006100640065006E0020201300200064006100730020007300FC00DF00650020004100750073006800E4006E006700650073006300680069006C0064000A00640065007300200048006F00740065006C0020005A00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Antjas Donutladen – der Schlüssel zur\nerfolgreichen Dimensionsforschung!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "0041006E0074006A0061007300200044006F006E00750074006C006100640065006E0020201300200064006500720020005300630068006C00FC007300730065006C0020007A00750072000A006500720066006F006C0067007200650069006300680065006E002000440069006D0065006E00730069006F006E00730066006F00720073006300680075006E006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Antjas Donutladen – Hoopas unangefochtene\nNummer 1 unter den Donutläden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1712,
      "rawDecodedUtf16Hex": "0041006E0074006A0061007300200044006F006E00750074006C006100640065006E0020201300200048006F006F00700061007300200075006E0061006E006700650066006F0063006800740065006E0065000A004E0075006D006D006500720020003100200075006E007400650072002000640065006E00200044006F006E00750074006C00E400640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Heute bin ich in Bestform!\nSo gelingt mir jeder Donut!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1860,
      "rawDecodedUtf16Hex": "00480065007500740065002000620069006E002000690063006800200069006E002000420065007300740066006F0072006D0021000A0053006F002000670065006C0069006E006700740020006D006900720020006A006500640065007200200044006F006E0075007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Hereinspaziert! Nehmen Sie Platz! Hihi, ich wollte\nmal so tun, als hätte ich ein echtes Restaurant.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Man könnte wohl sagen, dass die Malasadas aus\nder Alola-Region auch eine Art Donut sind.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Lasst uns Freude in Form von Donuts in die\ngroße, weite Welt hinaustragen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Ich habe schon so viele Donuts gemacht,\naber langweilig wird mir dabei nie!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Ich werde den allerbesten Donut zubereiten, der\nes mit Mega-Essenz ohne Ende aufnehmen kann!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Ich kann jetzt bis zu vier Beeren verwenden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2844,
      "rawDecodedUtf16Hex": "0049006300680020006B0061006E006E0020006A00650074007A007400200062006900730020007A007500200076006900650072002000420065006500720065006E002000760065007200770065006E00640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Ich kann jetzt bis zu fünf Beeren verwenden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2936,
      "rawDecodedUtf16Hex": "0049006300680020006B0061006E006E0020006A00650074007A007400200062006900730020007A00750020006600FC006E0066002000420065006500720065006E002000760065007200770065006E00640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Ich kann jetzt bis zu sechs Beeren verwenden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "0049006300680020006B0061006E006E0020006A00650074007A007400200062006900730020007A0075002000730065006300680073002000420065006500720065006E002000760065007200770065006E00640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Ich kann jetzt bis zu sieben Beeren verwenden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3120,
      "rawDecodedUtf16Hex": "0049006300680020006B0061006E006E0020006A00650074007A007400200062006900730020007A0075002000730069006500620065006E002000420065006500720065006E002000760065007200770065006E00640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ich kann jetzt bis zu acht Beeren verwenden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3216,
      "rawDecodedUtf16Hex": "0049006300680020006B0061006E006E0020006A00650074007A007400200062006900730020007A007500200061006300680074002000420065006500720065006E002000760065007200770065006E00640065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Scharf, frisch, süß, bitter oder sauer.\nWelcher Geschmack darf es sein?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3308,
      "rawDecodedUtf16Hex": "005300630068006100720066002C0020006600720069007300630068002C0020007300FC00DF002C00200062006900740074006500720020006F006400650072002000730061007500650072002E000A00570065006C0063006800650072002000470065007300630068006D00610063006B002000640061007200660020006500730020007300650069006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Bestell fleißig Donuts bei mir und forsche immer\nweiter!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3452,
      "rawDecodedUtf16Hex": "00420065007300740065006C006C00200066006C0065006900DF0069006700200044006F006E00750074007300200062006500690020006D0069007200200075006E006400200066006F0072007300630068006500200069006D006D00650072000A00770065006900740065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Ich erhitze die Butter, um sie zu schmelzen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3568,
      "rawDecodedUtf16Hex": "004900630068002000650072006800690074007A006500200064006900650020004200750074007400650072002C00200075006D00200073006900650020007A00750020007300630068006D0065006C007A0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Bestell am besten mehrere Donuts auf Vorrat,\ndann musst du nicht immer zurück ins Hotel Z.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Der Kniff ist, die Beeren gut zu zerdrücken,\nbis sie zu einer feinen Paste werden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Für meine Donuts verwende ich nur die besten\nZutaten!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 4012,
      "rawDecodedUtf16Hex": "004600FC00720020006D00650069006E006500200044006F006E007500740073002000760065007200770065006E0064006500200069006300680020006E007500720020006400690065002000620065007300740065006E000A005A00750074006100740065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Meine Donuts und Hoopas Kräfte werden euch\nbei eurer Forschung unterstützen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Probiere verschiedene Beerenkombinationen aus,\num die gewünschten Effekte zu erhalten!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4276,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Obwohl das Loch im Donut eigentlich „nicht da“\nist, nehmen wir es als „da“ wahr. Witzig, oder?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Dimensionsbeeren sind und bleiben mir ein\nRätsel...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4644,
      "rawDecodedUtf16Hex": "00440069006D0065006E00730069006F006E007300620065006500720065006E002000730069006E006400200075006E006400200062006C0065006900620065006E0020006D00690072002000650069006E000A005200E4007400730065006C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Du solltest auch den Bonuslevel im Auge\nbehalten, wenn du Donuts bei mir bestellst.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Wenn die Donut-Energie niedrig ist, hast du auch\nnicht so viel Zeit für die Dimensionsforschung!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4916,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Ich würde gern mal einen Donut machen,\nmit dem man Elite-Pokémon öfter begegnet!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 5112,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Ein Donut, mit dem man mehr Schillernden\nPokémon begegnet, wäre auch was Feines, oder?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 5276,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Je höher der Geschmacksrang ist, desto stärker\nist auch die Wirkung eines Donuts!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 5452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Süße Donuts mag Hoopa besonders gern!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5616,
      "rawDecodedUtf16Hex": "005300FC00DF006500200044006F006E0075007400730020006D0061006700200048006F006F007000610020006200650073006F006E00640065007200730020006700650072006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Ich habe den Verdacht, dass süße Donuts bei\nSchillernden Pokémon besonders gut ankommen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Süße Donuts scheinen Effekte zu haben,\ndie Glück bringen... in vielerlei Hinsicht!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5872,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "So ein scharfer Curry-Donut passt doch perfekt\nzum Stil von Hotel Z!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 6040,
      "rawDecodedUtf16Hex": "0053006F002000650069006E002000730063006800610072006600650072002000430075007200720079002D0044006F006E0075007400200070006100730073007400200064006F00630068002000700065007200660065006B0074000A007A0075006D0020005300740069006C00200076006F006E00200048006F00740065006C0020005A00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Meinst du, Schärfe könnte die Angriffskraft von\nPokémon vielleicht steigern...?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 6180,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Ich glaube, scharfe Donuts könnten dir einen\nVorteil in Sachen Angriffskraft verschaffen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 6340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Hoopa liebt auch Donuts mit einer leicht\nsäuerlichen Note.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 6524,
      "rawDecodedUtf16Hex": "0048006F006F007000610020006C00690065006200740020006100750063006800200044006F006E0075007400730020006D00690074002000650069006E006500720020006C00650069006300680074000A007300E4007500650072006C0069006300680065006E0020004E006F00740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Mit einem Donut, der das Sammeln von Beeren\nerleichtert, kannst du ganz viele davon anhäufen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Mit sauren Donuts lassen sich wohl Effekte\nerzielen, die mit Items zu tun haben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Auch wenn man es ihm nicht ansieht, Hoopa mag\nauch bittere Donuts!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6996,
      "rawDecodedUtf16Hex": "0041007500630068002000770065006E006E0020006D0061006E002000650073002000690068006D0020006E006900630068007400200061006E00730069006500680074002C00200048006F006F007000610020006D00610067000A00610075006300680020006200690074007400650072006500200044006F006E00750074007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Es wäre praktisch, wenn man den Schaden durch\nAttacken von bestimmten Typen senken könnte.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 7132,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Ich glaube, bittere Donuts schaffen dir einen\nVorteil in Sachen Verteidigung.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 7316,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Donuts mit frischem Geschmack sind genau das\nRichtige, um Hoopas Gaumen zu kitzeln!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 7472,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Wenn du Pokémon fangen willst, empfehle ich\ndir Donuts mit frischem Geschmack!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 7640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Donuts mit frischem Geschmack scheinen Effekte\nzu haben, die beim Fangen helfen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 7800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Welche Wirkung dieser Donut wohl haben wird?\nDas sehen wir erst, wenn er fertig ist!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 7964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Hier kommt ein megaspezieller Donut für die\nMega-Donut-Großoffensive!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 8136,
      "rawDecodedUtf16Hex": "00480069006500720020006B006F006D006D0074002000650069006E0020006D006500670061007300700065007A00690065006C006C0065007200200044006F006E007500740020006600FC00720020006400690065000A004D006500670061002D0044006F006E00750074002D00470072006F00DF006F006600660065006E007300690076006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Ein Donut voller Beeren führt uns direkt zu\nGroudon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 8276,
      "rawDecodedUtf16Hex": "00450069006E00200044006F006E0075007400200076006F006C006C00650072002000420065006500720065006E0020006600FC00680072007400200075006E007300200064006900720065006B00740020007A0075000A00470072006F00750064006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Ein Donut voller Beeren führt uns direkt zu\nKyogre!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 8384,
      "rawDecodedUtf16Hex": "00450069006E00200044006F006E0075007400200076006F006C006C00650072002000420065006500720065006E0020006600FC00680072007400200075006E007300200064006900720065006B00740020007A0075000A004B0079006F00670072006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ein Donut voller Beeren führt uns direkt zu\nRayquaza!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 8488,
      "rawDecodedUtf16Hex": "00450069006E00200044006F006E0075007400200076006F006C006C00650072002000420065006500720065006E0020006600FC00680072007400200075006E007300200064006900720065006B00740020007A0075000A005200610079007100750061007A006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Ich spüre es schon: Das wird der beste aller\nPlasma-Donuts!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 8596,
      "rawDecodedUtf16Hex": "00490063006800200073007000FC007200650020006500730020007300630068006F006E003A002000440061007300200077006900720064002000640065007200200062006500730074006500200061006C006C00650072000A0050006C00610073006D0061002D0044006F006E00750074007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Was ist denn los? Versuchst du, einen besonders\nausgefallenen Donut zu kreieren?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 8716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Egal, welche Beeren du aussuchst, ich zauber dir\ndaraus einen tollen Donut!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 8880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Fühlst du dich etwas überfordert von den\nunendlichen Kombinationsmöglichkeiten?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 9032,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Wenn du dich nicht entscheiden kannst,\nmach doch einfach ganz viele Donuts auf einmal!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 9192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Du bist vor lauter Grübeln wohl erstarrt...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 9368,
      "rawDecodedUtf16Hex": "004400750020006200690073007400200076006F00720020006C0061007500740065007200200047007200FC00620065006C006E00200077006F0068006C002000650072007300740061007200720074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Schon interessant, dich mal so herrlich verpeilt\nzu erleben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 9456,
      "rawDecodedUtf16Hex": "005300630068006F006E00200069006E0074006500720065007300730061006E0074002C002000640069006300680020006D0061006C00200073006F00200068006500720072006C0069006300680020007600650072007000650069006C0074000A007A0075002000650072006C006500620065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Donuts zu machen bedeutet... Freude zu schaffen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 9580,
      "rawDecodedUtf16Hex": "0044006F006E0075007400730020007A00750020006D0061006300680065006E002000620065006400650075007400650074002E002E002E00200046007200650075006400650020007A007500200073006300680061006600660065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Beim Donutmachen gilt: Grundlagen befolgen\nund viel Herz reinstecken!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 9680,
      "rawDecodedUtf16Hex": "004200650069006D00200044006F006E00750074006D0061006300680065006E002000670069006C0074003A0020004700720075006E0064006C006100670065006E0020006200650066006F006C00670065006E000A0075006E00640020007600690065006C0020004800650072007A0020007200650069006E0073007400650063006B0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Ich gebe mir größte Mühe, Donuts zu machen,\ndie Pokémon gut schmecken!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 9820,
      "rawDecodedUtf16Hex": "004900630068002000670065006200650020006D0069007200200067007200F600DF007400650020004D00FC00680065002C00200044006F006E0075007400730020007A00750020006D0061006300680065006E002C000A00640069006500200050006F006B00E9006D006F006E00200067007500740020007300630068006D00650063006B0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Es heißt, die Essensvorlieben sagen viel über\neine Person aus.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 9964,
      "rawDecodedUtf16Hex": "00450073002000680065006900DF0074002C002000640069006500200045007300730065006E00730076006F0072006C0069006500620065006E00200073006100670065006E0020007600690065006C002000FC006200650072000A00650069006E006500200050006500720073006F006E0020006100750073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Irgendwie ist Nahrung ja auch die Grundlage\ndes Lebens.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 10092,
      "rawDecodedUtf16Hex": "0049007200670065006E006400770069006500200069007300740020004E0061006800720075006E00670020006A00610020006100750063006800200064006900650020004700720075006E0064006C006100670065000A0064006500730020004C006500620065006E0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Bei der Essenszubereitung kommt es auf solide\nGrundlagen an.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 10204,
      "rawDecodedUtf16Hex": "004200650069002000640065007200200045007300730065006E0073007A00750062006500720065006900740075006E00670020006B006F006D006D0074002000650073002000610075006600200073006F006C006900640065000A004700720075006E0064006C006100670065006E00200061006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Lass dir Zeit!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 10328,
      "rawDecodedUtf16Hex": "004C00610073007300200064006900720020005A00650069007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Nur keine Hektik...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 10360,
      "rawDecodedUtf16Hex": "004E007500720020006B00650069006E0065002000480065006B00740069006B002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Mein großes kulinarisches Vorbild ist übrigens\nder Koch Narcisse!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 10400,
      "rawDecodedUtf16Hex": "004D00650069006E002000670072006F00DF006500730020006B0075006C0069006E0061007200690073006300680065007300200056006F007200620069006C00640020006900730074002000FC00620072006900670065006E0073000A0064006500720020004B006F006300680020004E006100720063006900730073006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    }
