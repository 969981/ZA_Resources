      "offsetInSection": 3048,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "The alpha Weedle helps me keep all the other\nWeedle away!<U+0010><U+0002>Ĕļ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3060,
