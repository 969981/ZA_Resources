  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Sei <U+0010><U+0002>Ā<U+0000>, giusto?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "00530065006900200010000201000000002C002000670069007500730074006F003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Guarda un po’ qui... La mia streamer preferita\nha postato questa foto bellissima!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Canary che si riposa su una panchina con il suo\nEelektross accanto! Non sono adorabili?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Vorrei sedermi sulla stessa panchina e farmi\nuna foto con il mio Manectric!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Ed è qui che entri in gioco tu, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "00450064002000E80020007100750069002000630068006500200065006E00740072006900200069006E002000670069006F0063006F002000740075002C00200010000201000000002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Troveresti per me la panchina della foto?\nPer favore!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "00540072006F007600650072006500730074006900200070006500720020006D00650020006C0061002000700061006E006300680069006E0061002000640065006C006C006100200066006F0074006F003F000A0050006500720020006600610076006F00720065002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Ectriiic!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "0045006300740072006900690069006300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vuoi vedere di nuovo la foto con la panchina?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "00560075006F006900200076006500640065007200650020006400690020006E0075006F0076006F0020006C006100200066006F0074006F00200063006F006E0020006C0061002000700061006E006300680069006E0061003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Sì, grazie!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "005300EC002C0020006700720061007A0069006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Non serve!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "004E006F006E00200073006500720076006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Eccola qui! Hai idea di dove possa essere?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "004500630063006F006C00610020007100750069002100200048006100690020006900640065006100200064006900200064006F0076006500200070006F0073007300610020006500730073006500720065003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ti prego, cerca la panchina che appare nella foto!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "0054006900200070007200650067006F002C0020006300650072006300610020006C0061002000700061006E006300680069006E0061002000630068006500200061007000700061007200650020006E0065006C006C006100200066006F0074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hai trovato la panchina che ti hanno chiesto\ndi cercare!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "004800610069002000740072006F007600610074006F0020006C0061002000700061006E006300680069006E00610020006300680065002000740069002000680061006E006E006F0020006300680069006500730074006F000A006400690020006300650072006300610072006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Due vasi con le piante, gli stessi edifici sullo\nsfondo... e si vedono pure le montagne!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Non ci sono dubbi, la panchina nella foto\ndi Canary è proprio questa!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1804,
      "rawDecodedUtf16Hex": "004E006F006E00200063006900200073006F006E006F002000640075006200620069002C0020006C0061002000700061006E006300680069006E00610020006E0065006C006C006100200066006F0074006F000A00640069002000430061006E006100720079002000E8002000700072006F007000720069006F0020007100750065007300740061002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "E allora senza perdere tempo...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1952,
      "rawDecodedUtf16Hex": "004500200061006C006C006F00720061002000730065006E007A006100200070006500720064006500720065002000740065006D0070006F002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Eccomi qui, seduta sulla stessa panchina su cui\nera seduta lei... In pratica sono Canary!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2024,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Allora mi fai questo favore, <U+0010><U+0002>Ā<U+0000>?\nMi scatteresti una foto come quella di Canary?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Dovrai trovare l’angolazione giusta per ricreare\nesattamente la stessa inquadratura!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Quando vuoi rivedere la foto, torna pure da me!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2564,
      "rawDecodedUtf16Hex": "005100750061006E0064006F002000760075006F00690020007200690076006500640065007200650020006C006100200066006F0074006F002C00200074006F0072006E0061002000700075007200650020006400610020006D0065002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Vuoi vedere la foto di Canary?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2668,
      "rawDecodedUtf16Hex": "00560075006F006900200076006500640065007200650020006C006100200066006F0074006F002000640069002000430061006E006100720079003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Sì, grazie!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2740,
      "rawDecodedUtf16Hex": "005300EC002C0020006700720061007A00690065002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Non serve!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2772,
      "rawDecodedUtf16Hex": "004E006F006E002000730065007200760065002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Trova la distanza giusta e fammi apparire\nesattamente come Canary nella sua foto!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2976,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sì, più o meno lì dovrebbe andare...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2988,
      "rawDecodedUtf16Hex": "005300EC002C00200070006900F90020006F0020006D0065006E006F0020006C00EC00200064006F00760072006500620062006500200061006E0064006100720065002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "O forse no.<U+0010><U+0001>븁\nL’angolazione mi sembra un po’ diversa...\nDevi ricreare la stessa inquadratura!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3272,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sì, sì, lì va bene! Scatta la foto da lì!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3284,
      "rawDecodedUtf16Hex": "005300EC002C0020007300EC002C0020006C00EC002000760061002000620065006E0065002100200053006300610074007400610020006C006100200066006F0074006F0020006400610020006C00EC002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Bene, vediamo com’è venuta la foto...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3376,
      "rawDecodedUtf16Hex": "00420065006E0065002C002000760065006400690061006D006F00200063006F006D201900E8002000760065006E0075007400610020006C006100200066006F0074006F002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Oooh! È perfetta! Mi sembra quasi di essere\ndiventata Canary!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 3460,
      "rawDecodedUtf16Hex": "004F006F006F00680021002000C800200070006500720066006500740074006100210020004D0069002000730065006D0062007200610020007100750061007300690020006400690020006500730073006500720065000A0064006900760065006E0074006100740061002000430061006E006100720079002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Adesso la posto sui social... Fatto!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 3592,
      "rawDecodedUtf16Hex": "00410064006500730073006F0020006C006100200070006F00730074006F002000730075006900200073006F006300690061006C002E002E002E00200046006100740074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Chissà se a scattare la foto di Canary è stato\nquel produttore di cui si parla tanto...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Pare ci sia lui dietro l’idea del Pan di Canary.\nChe non è malaccio, ma avrei preferito qualcosa<U+0010><U+0001>븀\ncome dei portachiavi o delle figurine...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3860,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "Le idee non mi mancano di certo!<U+0010><U+0001>븁\nComunque, ci sono altre foto di Canary che vorrei\nricreare. Sono venuta a Luminopoli apposta!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Grazie ancora! Già che ci sei, perché non ti riposi\nun po’ anche tu sulla panchina, <U+0010><U+0002>Ā<U+0000>?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Alla prossima!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 4608,
      "rawDecodedUtf16Hex": "0041006C006C0061002000700072006F007300730069006D0061002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4648,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Adesso mi metto a cercare il posto dove Canary\ntiene il suo quiz. Farò una foto anche lì!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 4660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Ectriiic!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 4848,
