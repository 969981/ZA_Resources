  "initialKey": 0,
  "messages": [
    {
      "displayText": "那……那個……\n請幫幫我吧……<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 428,
      "rawDecodedUtf16Hex": "90A32026202690A3500B20262026000A8ACB5E6B5E6B621154272026202600100002011401E20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "我接下來要跟一位\n喜歡扒手貓的女性約會……<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 468,
