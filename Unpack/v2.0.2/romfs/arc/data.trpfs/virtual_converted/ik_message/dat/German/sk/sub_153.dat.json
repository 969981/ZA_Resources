  "messages": [
    {
      "displayText": "Hach, nichts geht über eine edle\nPause mit einem Konnex-Kaffee!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 308,
      "rawDecodedUtf16Hex": "0048006100630068002C0020006E0069006300680074007300200067006500680074002000FC006200650072002000650069006E0065002000650064006C0065000A005000610075007300650020006D00690074002000650069006E0065006D0020004B006F006E006E00650078002D004B0061006600660065006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Willkommen im Konnex-Café!<U+0010><U+0001>븁\nWer nach Verbindung sucht, ist hier an der\nrichtigen Adresse.<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 4,
