      "offsetInSection": 436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Iiirrgh!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "0049006900690072007200670068002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Mein Kaffee schmeckt total salzig...?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 648,
      "rawDecodedUtf16Hex": "004D00650069006E0020004B006100660066006500650020007300630068006D00650063006B007400200074006F00740061006C002000730061006C007A00690067002E002E002E003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Verzeihung? Unser Konnex-Kaffee zeichnet sich\ndurch leichte Süße und ein feines Aroma aus...<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Salzig dürfte er also ganz und gar nicht sein...<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 924,
      "rawDecodedUtf16Hex": "00530061006C007A006900670020006400FC007200660074006500200065007200200061006C0073006F002000670061006E007A00200075006E006400200067006100720020006E00690063006800740020007300650069006E002E002E002E00100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Saaali!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "0053006100610061006C006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Das ist ja Geosali! Das Steinsalz-Pokémon!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1048,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020006A0061002000470065006F00730061006C00690021002000440061007300200053007400650069006E00730061006C007A002D0050006F006B00E9006D006F006E002100100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Du! Du bist doch <U+0010><U+0004>ᄀÿЃ<U+0000>eineine <U+0010><U+0004>ᄀÿᄏ<U+0000>Pokémon-TrainerPokémon-Trainerin, oder?\nWürdest du mir kurz aushelfen?<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Könntest du das Geosali von vorhin fangen?<U+0010><U+0001>븁\nIch habe den Verdacht, es steckt hinter dem\nsalzigen Kaffee!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Bitte fang das Geosali!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1592,
      "rawDecodedUtf16Hex": "00420069007400740065002000660061006E00670020006400610073002000470065006F00730061006C0069002100100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "BÄH! Igitt! Ist das SALZIG!",
