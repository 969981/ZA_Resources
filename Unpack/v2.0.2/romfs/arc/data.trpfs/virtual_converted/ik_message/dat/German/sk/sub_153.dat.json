      "rawDecodedUtf16Hex": "004B00E4006D007000660065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "In Ruhe lassen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "0049006E002000520075006800650020006C0061007300730065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Saaali!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1976,
      "rawDecodedUtf16Hex": "0053006100610061006C006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Kannst du Geosali fangen? Ich habe den Verdacht,\nes steckt hinter dem salzigen Kaffee!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "BÄH! Igitt! Ist das SALZIG!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2176,
      "rawDecodedUtf16Hex": "004200C400480021002000490067006900740074002100200049007300740020006400610073002000530041004C005A0049004700210000",
      "trailingZeroPaddingUnits": 1,
