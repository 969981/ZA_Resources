      "offsetInSection": 1648,
      "rawDecodedUtf16Hex": "004200C400480021002000490067006900740074002100200049007300740020006400610073002000530041004C005A0049004700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Das ist das Geosali, das du fangen sollst...<U+0010><U+0001>븁\nMöchtest du gegen es kämpfen und versuchen,\nes zu fangen?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
