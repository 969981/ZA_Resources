      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "提高移动速度扰乱敌人\n可是非常爽快的哦！<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
