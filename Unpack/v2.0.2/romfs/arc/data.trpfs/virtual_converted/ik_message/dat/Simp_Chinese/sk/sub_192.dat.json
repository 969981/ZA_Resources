      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "7B544E0D4E0A67655427FF1F00100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "我告诉你。\n听好了，最重要的……<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
