      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "使用<U+0010><U+0002>＀<U+0006>蓄能焰袭<U+0010><U+0002>＀<U+0000>，\n就可以在提高移动速度的同时发动攻击。<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 8,
