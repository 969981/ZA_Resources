      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "8FD996448FD151456EE14E8660126C14FF0C000A6B63572853D1751F4E11964B76844E89626720262026FF0100100002011401400000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
