      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "800C6211611F89C952304E862026202600100002011401400000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
