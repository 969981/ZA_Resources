  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "카친이 되어 버려라! 얍!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 388,
      "rawDecodedUtf16Hex": "CE74CE5CC7740020B418C5B40020BC84B824B77C00210020C58D0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "되어 버려! 되어 버려!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 428,
      "rawDecodedUtf16Hex": "B418C5B40020BC84B82400210020B418C5B40020BC84B8240021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "허접한 가짜네.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 464,
      "rawDecodedUtf16Hex": "D5C8C811D55C0020AC00C9DCB124002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "카나리는\n그런 말 안 해.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 492,
      "rawDecodedUtf16Hex": "CE74B098B9ACB294000AADF8B7F00020B9D00020C5480020D574002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "역시 대단하군.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "C5EDC2DC0020B300B2E8D558AD70002E00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "그렇지만, 카나리의 매력을 많은 사람들에게\n전파하려면 방금 같은 것도 괜찮지 않나?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "ADF8B807C9C0B9CC002C0020CE74B098B9ACC7580020B9E4B825C7440020B9CEC7400020C0ACB78CB4E4C5D0AC8C000AC804D30CD558B824BA740020BC29AE080020AC19C7400020AC83B3C40020AD1CCC2EC9C00020C54AB098003F00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "라이트한 카뉴비들은 필요 없어.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "B77CC774D2B8D55C0020CE74B274BE44B4E4C7400020D544C6940020C5C6C5B4002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "카나리를 진심으로 사랑하는 사람만이\n카친이 될 자격이 있으니까.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "CE74B098B9ACB97C0020C9C4C2ECC73CB85C0020C0ACB791D558B2940020C0ACB78CB9CCC774000ACE74CE5CC7740020B4200020C790ACA9C7740020C788C73CB2C8AE4C002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "당치도 않은 소리!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 788,
      "rawDecodedUtf16Hex": "B2F9CE58B3C40020C54AC7400020C18CB9AC002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "돈과 시간을 들이는 팬뿐만 아니라\n가볍게 좋아하는 팬도 똑같은 팬인 게야!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "B3C8ACFC0020C2DCAC04C7440020B4E4C774B2940020D32CBFD0B9CC0020C544B2C8B77C000AAC00BCCDAC8C0020C88BC544D558B2940020D32CB3C40020B611AC19C7400020D32CC7780020AC8CC57C002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "우우...\n라이트한 카뉴비를 인정한다고?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "C6B0C6B0002E002E002E000AB77CC774D2B8D55C0020CE74B274BE44B97C0020C778C815D55CB2E4ACE0003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "할아버지!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "D560C544BC84C9C00021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "무쿠의 마음도 이해는 하지만,\n둘이 다투는 건 보고 싶지 않거든!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "BB34CFE0C7580020B9C8C74CB3C40020C774D574B2940020D558C9C0B9CC002C000AB458C7740020B2E4D22CB2940020AC740020BCF4ACE00020C2F6C9C00020C54AAC70B4E00021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "그래! 트레이너끼리 다툴 바에\n포켓몬 승부로 담판을 짓도록 하세!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1072,
      "rawDecodedUtf16Hex": "ADF8B79800210020D2B8B808C774B108B07CB9AC0020B2E4D2340020BC14C5D0000AD3ECCF13BAAC0020C2B9BD80B85C0020B2F4D310C7440020C9D3B3C4B85D0020D558C138002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1156,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "기다려 주세요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "여기선 오케이 해야지.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1184,
      "rawDecodedUtf16Hex": "C5ECAE30C1200020C624CF00C7740020D574C57CC9C0002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "카친으로서\n나의 사랑을 증명하겠어.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1220,
      "rawDecodedUtf16Hex": "CE74CE5CC73CB85CC11C000AB098C7580020C0ACB791C7440020C99DBA85D558ACA0C5B4002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "할아버지가 마음대로 굴게 두고 싶진 않지만\n무쿠와는 승부해 보고 싶어.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "D560C544BC84C9C0AC000020B9C8C74CB300B85C0020AD74AC8C0020B450ACE00020C2F6C9C40020C54AC9C0B9CC000ABB34CFE0C640B2940020C2B9BD80D5740020BCF4ACE00020C2F6C5B4002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "나도 실질적으로는 카나리나 다름없으니\n두 명의 카나리와 싸우는 거나 마찬가지라네!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "B098B3C40020C2E4C9C8C801C73CB85CB2940020CE74B098B9ACB0980020B2E4B984C5C6C73CB2C8000AB4500020BA85C7580020CE74B098B9ACC6400020C2F8C6B0B2940020AC70B0980020B9C8CC2CAC00C9C0B77CB124002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1468,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "기다려 주세요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1480,
      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "그러지 말고 승부하자고!\n모처럼의 기회를 버릴 셈이야?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1496,
      "rawDecodedUtf16Hex": "ADF8B7ECC9C00020B9D0ACE00020C2B9BD80D558C790ACE00021000ABAA8CC98B7FCC7580020AE30D68CB97C0020BC84B9B40020C148C774C57C003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "상대해 줄게.\n승리는 내 차지가 되겠지만 말이야!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "C0C1B300D5740020C904AC8C002E000AC2B9B9ACB2940020B0B40020CC28C9C0AC000020B418ACA0C9C0B9CC0020B9D0C774C57C0021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "여기엔 뭐 하러 온 건지...<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "C5ECAE30C5D40020BB500020D558B7EC0020C6280020AC74C9C0002E002E002E00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "내가 이기면 자네의 동료들 모두\n카친이 되어 줘야 할 걸세!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "B0B4AC000020C774AE30BA740020C790B124C7580020B3D9B8CCB4E40020BAA8B450000ACE74CE5CC7740020B418C5B40020C918C57C0020D5600020AC78C138002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "카친으로서\n나의 사랑을 보여 주겠어.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1752,
      "rawDecodedUtf16Hex": "CE74CE5CC73CB85CC11C000AB098C7580020C0ACB791C7440020BCF4C5EC0020C8FCACA0C5B4002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1804,
      "rawDecodedUtf16Hex": "00100002BDFF001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "진짜를 보여 주겠어!\n저리더프! 메가진화로 전압을 올려 보자!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "C9C4C9DCB97C0020BCF4C5EC0020C8FCACA0C5B40021000AC800B9ACB354D50400210020BA54AC00C9C4D654B85C0020C804C555C7440020C62CB8240020BCF4C7900021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "몰드류, 메가진화다!\n나의 지략을 실현하는 거다!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1896,
      "rawDecodedUtf16Hex": "BAB0B4DCB958002C0020BA54AC00C9C4D654B2E40021000AB098C7580020C9C0B7B5C7440020C2E4D604D558B2940020AC70B2E4002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "샹델라...\n메가진화로 사랑을 보여 주자.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1960,
      "rawDecodedUtf16Hex": "C0F9B378B77C002E002E002E000ABA54AC00C9C4D654B85C0020C0ACB791C7440020BCF4C5EC0020C8FCC790002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "나야말로\n진정한 카친이야...!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2028,
      "rawDecodedUtf16Hex": "B098C57CB9D0B85C000AC9C4C815D55C0020CE74CE5CC774C57C002E002E002E002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "무쿠...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2072,
      "rawDecodedUtf16Hex": "BB34CFE0002E002E002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "그렇지만 카나리의 매력은\n많은 사람들에게 전파되어야 해.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2092,
      "rawDecodedUtf16Hex": "ADF8B807C9C0B9CC0020CE74B098B9ACC7580020B9E4B825C740000AB9CEC7400020C0ACB78CB4E4C5D0AC8C0020C804D30CB418C5B4C57C0020D574002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "팬들도 소중하지만\n무쿠가 훨씬 더 소중한 거 알지?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 2164,
      "rawDecodedUtf16Hex": "D32CB4E4B3C40020C18CC911D558C9C0B9CC000ABB34CFE0AC000020D6E8C52C0020B3540020C18CC911D55C0020AC700020C54CC9C0003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "응...♡<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2232,
      "rawDecodedUtf16Hex": "C751002E002E002E266100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "그렇지만 홀로그램 카나리로\n사람들을 속이는 건 옳지 않아.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "ADF8B807C9C0B9CC0020D640B85CADF8B7A80020CE74B098B9ACB85C000AC0ACB78CB4E4C7440020C18DC774B2940020AC740020C633C9C00020C54AC544002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "그렇다는데, 할아버지?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 2328,
      "rawDecodedUtf16Hex": "ADF8B807B2E4B294B370002C0020D560C544BC84C9C0003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "자, 둘에게 이걸 줄게.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2364,
      "rawDecodedUtf16Hex": "C790002C0020B458C5D0AC8C0020C774AC780020C904AC8C002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001> 다른 색의\n카나리 코디 웨어 세트를 손에 넣었다!",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2400,
      "rawDecodedUtf16Hex": "001000020100000000100002190000010020B2E4B9780020C0C9C758000ACE74B098B9AC0020CF54B5140020C6E8C5B40020C138D2B8B97C0020C190C5D00020B123C5C8B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "헤어살롱에서\n내 헤어스타일을 따라 하는 사람도 있다더라.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
