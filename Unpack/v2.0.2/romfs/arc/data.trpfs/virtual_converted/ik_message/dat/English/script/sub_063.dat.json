      "rawDecodedUtf16Hex": "004E006F002C0020007400680061006E006B00730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "That’s fair—being overly cold does you no good.\nLet me know if you change your mind, though!<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1192,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Then it’s time for another iconic quote from my\nfavorite Trainer! Ahem.<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "“Hahaha! Are you ready?”<U+0010><U+0002>ĔŢ",
