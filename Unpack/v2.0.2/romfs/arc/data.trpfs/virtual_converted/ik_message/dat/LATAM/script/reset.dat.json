      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Soy Nicia... Rei Nicia.",
