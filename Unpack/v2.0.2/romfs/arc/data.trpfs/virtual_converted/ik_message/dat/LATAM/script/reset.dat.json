      "index": 8,
      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "00410068006F007200610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Explícame un poco más",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
