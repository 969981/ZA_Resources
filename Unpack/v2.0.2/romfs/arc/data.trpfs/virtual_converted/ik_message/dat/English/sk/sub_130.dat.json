      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Yeah, that’s creepy",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "0059006500610068002C002000740068006100742019007300200063007200650065007000790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "You’re staring at me",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "0059006F0075201900720065002000730074006100720069006E00670020006100740020006D00650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Yes. I need your help. You will help, won’t you?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "005900650073002E002000490020006E00650065006400200079006F00750072002000680065006C0070002E00200059006F0075002000770069006C006C002000680065006C0070002C00200077006F006E2019007400200079006F0075003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "I have this new neighbor. She just moved here\nfrom the Paldea region.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "004900200068006100760065002000740068006900730020006E006500770020006E00650069006700680062006F0072002E00200053006800650020006A0075007300740020006D006F00760065006400200068006500720065000A00660072006F006D0020007400680065002000500061006C00640065006100200072006500670069006F006E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "She brought her Pokémon with her.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "005300680065002000620072006F0075006700680074002000680065007200200050006F006B00E9006D006F006E002000770069007400680020006800650072002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "And it just keeps STARING at my poor Scizor!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "0041006E00640020006900740020006A0075007300740020006B0065006500700073002000530054004100520049004E00470020006100740020006D007900200070006F006F00720020005300630069007A006F0072002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "My Scizor’s not exactly the bravest of Scizor.\nSince they moved in, every day has been a terror!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Please! Can you find out why my new neighbor’s\nTinkatuff keeps staring at my poor Scizor?!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Sci...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1780,
      "rawDecodedUtf16Hex": "005300630069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "I think you’ll find that new neighbor of mine up\non the rooftops.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "00490020007400680069006E006B00200079006F00752019006C006C002000660069006E0064002000740068006100740020006E006500770020006E00650069006700680062006F00720020006F00660020006D0069006E0065002000750070000A006F006E002000740068006500200072006F006F00660074006F00700073002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
