    },
    {
      "displayText": "Hallo! Ich bin Parfümeurin und kreiere Parfüms,\nindem ich vielfältige Duftnoten mische.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Vor Kurzem kam mir die Idee, aus den Blättern\nvon Mähikel eine Mischung herzustellen.<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Vielleicht könntest du mir ja dabei helfen...\nWärst du so nett, mir ein Mähikel zu bringen?<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0004>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 724,
      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sag mir Bescheid, wenn du ein Mähikel in\ndeinem Team hast!<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "0053006100670020006D00690072002000420065007300630068006500690064002C002000770065006E006E002000640075002000650069006E0020004D00E400680069006B0065006C00200069006E000A006400650069006E0065006D0020005400650061006D00200068006100730074002100100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
