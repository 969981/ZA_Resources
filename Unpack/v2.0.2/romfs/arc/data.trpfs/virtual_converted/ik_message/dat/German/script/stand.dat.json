      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Besten Dank! Hier, <U+0010><U+0004>ᄀ<U+0006>Ԅ<U+0000>deindeine <U+0010><U+0002>ĉ<U+0006>.\nDarf’s sonst noch was sein?",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "00420065007300740065006E002000440061006E006B002100200048006900650072002C0020001000041100000605040000006400650069006E006400650069006E006500200010000201090006002E000A00440061007200662019007300200073006F006E007300740020006E006F0063006800200077006100730020007300650069006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Darf’s sonst noch was sein?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 1792,
      "rawDecodedUtf16Hex": "00440061007200662019007300200073006F006E007300740020006E006F0063006800200077006100730020007300650069006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Sorry, aber dafür reicht dein Geld nicht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "0053006F007200720079002C00200061006200650072002000640061006600FC007200200072006500690063006800740020006400650069006E002000470065006C00640020006E0069006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Bitte be-beere uns bald wieder, haha!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 1932,
      "rawDecodedUtf16Hex": "00420069007400740065002000620065002D0062006500650072006500200075006E0073002000620061006C00640020007700690065006400650072002C0020006800610068006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "In deiner Tasche ist leider kein Platz mehr.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "0049006E0020006400650069006E00650072002000540061007300630068006500200069007300740020006C006500690064006500720020006B00650069006E00200050006C00610074007A0020006D006500680072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Kundschaft, wie schön! Wie kann ich helfen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 2100,
      "rawDecodedUtf16Hex": "004B0075006E0064007300630068006100660074002C0020007700690065002000730063006800F6006E002100200057006900650020006B0061006E006E0020006900630068002000680065006C00660065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Vielen Dank! Hier, <U+0010><U+0004>ᄀ<U+0006>Ԅ<U+0000>deindeine <U+0010><U+0002>ĉ<U+0006>.<U+0010><U+0001>븁\nDarf es sonst noch etwas sein?",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 2188,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Oh, du hast leider nicht genug Geld!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2340,
      "rawDecodedUtf16Hex": "004F0068002C002000640075002000680061007300740020006C006500690064006500720020006E0069006300680074002000670065006E00750067002000470065006C006400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Bitte beehre uns bald wieder!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 2416,
      "rawDecodedUtf16Hex": "00420069007400740065002000620065006500680072006500200075006E0073002000620061006C0064002000770069006500640065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Tut mir leid, aber dafür ist in deiner Tasche\nwohl kein Platz.",
