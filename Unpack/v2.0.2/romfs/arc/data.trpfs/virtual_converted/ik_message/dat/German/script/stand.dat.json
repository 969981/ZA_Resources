      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 3928,
      "rawDecodedUtf16Hex": "0045007300200074007500740020006D006900720020006C006500690064002C00200061006200650072002000640075002000730063006800650069006E007300740020006E0069006300680074002000670065006E00750067002000470065006C0064000A007A007500200068006100620065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
