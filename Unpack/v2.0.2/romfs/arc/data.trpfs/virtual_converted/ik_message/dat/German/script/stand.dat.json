      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 2476,
      "rawDecodedUtf16Hex": "0054007500740020006D006900720020006C006500690064002C00200061006200650072002000640061006600FC0072002000690073007400200069006E0020006400650069006E006500720020005400610073006300680065000A0077006F0068006C0020006B00650069006E00200050006C00610074007A002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
