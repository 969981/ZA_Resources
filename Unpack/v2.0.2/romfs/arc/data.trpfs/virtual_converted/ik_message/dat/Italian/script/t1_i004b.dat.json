  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Benvenut<U+0010><U+0003>ᄀÿāoa al Ristorante\nLa Buona Forchetta!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 220,
      "rawDecodedUtf16Hex": "00420065006E00760065006E0075007400100003110000FF0101006F006100200061006C00200052006900730074006F00720061006E00740065000A004C0061002000420075006F006E006100200046006F007200630068006500740074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "È pront<U+0010><U+0003>ᄀÿāoa ad affrontare il nostro\nmenu di degustazione? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Ordina pure quello che vuoi, cara\nsorellina! Oggi offro io!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 472,
      "rawDecodedUtf16Hex": "004F007200640069006E0061002000700075007200650020007100750065006C006C006F0020006300680065002000760075006F0069002C00200063006100720061000A0073006F00720065006C006C0069006E006100210020004F0067006700690020006F006600660072006F00200069006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Se si potesse, ordinerei volentieri\nuna bella lotta Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 592,
      "rawDecodedUtf16Hex": "0053006500200073006900200070006F00740065007300730065002C0020006F007200640069006E006500720065006900200076006F006C0065006E00740069006500720069000A0075006E0061002000620065006C006C00610020006C006F00740074006100200050006F006B00E9006D006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Capisco, tesoro, ma non vorrei\ndar fastidio agli altri commensali...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "004300610070006900730063006F002C0020007400650073006F0072006F002C0020006D00610020006E006F006E00200076006F0072007200650069000A00640061007200200066006100730074006900640069006F002000610067006C006900200061006C00740072006900200063006F006D006D0065006E00730061006C0069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Papà, papà! Voglio mangiare\nassieme ai miei Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "00500061007000E0002C002000700061007000E0002100200056006F0067006C0069006F0020006D0061006E00670069006100720065000A00610073007300690065006D00650020006100690020006D00690065006900200050006F006B00E9006D006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Vediamo un po’ cos’hanno oggi nel menu!\nFormaggio stagionato invecchiato 180 anni...<U+0010><U+0001>븁\nUn erborinato morbido talmente puzzolente\nda far cadere il naso...<U+0010><U+0001>븁\nE un formaggio a crosta lavata prodotto usando\nil veleno di un Arbok femmina.",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 236
    },
    {
      "displayText": "E anche oggi prendo il mio solito dessert:\nun sorbetto di Baccamelos e Baccafrago<U+0010><U+0001>븀\nricoperto di mousse mille erbe!",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Qui si mangia cibo buono... e per di più in grandi\nquantità!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "0051007500690020007300690020006D0061006E0067006900610020006300690062006F002000620075006F006E006F002E002E002E00200065002000700065007200200064006900200070006900F900200069006E0020006700720061006E00640069000A007100750061006E00740069007400E000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "E gli avanzi me li faccio impacchettare e li porto\nai miei adorati Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Papà... Ma da quand’è che siamo\ndiventati ricchi?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "00500061007000E0002E002E002E0020004D00610020006400610020007100750061006E0064201900E800200063006800650020007300690061006D006F000A0064006900760065006E00740061007400690020007200690063006300680069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Davvero possiamo ordinare quello che ci pare?\nAllora io prendo...<U+0010><U+0001>븁\nUna braciola di coda di Slowpoke della Baia\nAzzurra, con contorno di insalata di Baccapayapa<U+0010><U+0001>븀\nabbondantemente cosparsa d’olio extravergine<U+0010><U+0001>븀\ndi Baccarancia, in grado di trasmettere<U+0010><U+0001>븀\nla stessa sensazione di terrore provata<U+0010><U+0001>븀\nda un Gastly davanti a una Streghetta.",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 338
    },
    {
      "displayText": "Quanta generosità oggi... Cos’è,\nhai fatto furore alla Royale Z-A?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2724,
      "rawDecodedUtf16Hex": "005100750061006E00740061002000670065006E00650072006F00730069007400E00020006F006700670069002E002E002E00200043006F0073201900E8002C000A00680061006900200066006100740074006F0020006600750072006F0072006500200061006C006C006100200052006F00790061006C00650020005A002D0041003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ordinate quello che volete!\nOggi non badiamo a spese!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 2860,
      "rawDecodedUtf16Hex": "004F007200640069006E0061007400650020007100750065006C006C006F002000630068006500200076006F006C0065007400650021000A004F0067006700690020006E006F006E002000620061006400690061006D006F0020006100200073007000650073006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Assistere a una bella lotta rende\nogni cibo più gustoso che mai!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "0041007300730069007300740065007200650020006100200075006E0061002000620065006C006C00610020006C006F007400740061002000720065006E00640065000A006F0067006E00690020006300690062006F00200070006900F900200067007500730074006F0073006F00200063006800650020006D0061006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Non c’è condimento migliore\ndi una bella lotta Pokémon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 3100,
      "rawDecodedUtf16Hex": "004E006F006E00200063201900E800200063006F006E00640069006D0065006E0074006F0020006D00690067006C0069006F00720065000A0064006900200075006E0061002000620065006C006C00610020006C006F00740074006100200050006F006B00E9006D006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Non dire così, nonna! Non ti fa piacere passare\nun po’ di tempo con il tuo caro nipotino?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 3212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Veramente io avrei preferito mangiare da sola...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3392,
      "rawDecodedUtf16Hex": "0056006500720061006D0065006E0074006500200069006F002000610076007200650069002000700072006500660065007200690074006F0020006D0061006E0067006900610072006500200064006100200073006F006C0061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Se me ne sto qui in disparte e faccio finta di nulla,\nforse riesco a farmi ignorare...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3492,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Ti piace mangiare, eh?\nSi vede da come ti gusti il cibo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3668,
      "rawDecodedUtf16Hex": "005400690020007000690061006300650020006D0061006E00670069006100720065002C002000650068003F000A005300690020007600650064006500200064006100200063006F006D006500200074006900200067007500730074006900200069006C0020006300690062006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Il trucco per saziarsi veramente\nè mangiare piano piano!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 3784,
      "rawDecodedUtf16Hex": "0049006C002000740072007500630063006F0020007000650072002000730061007A0069006100720073006900200076006500720061006D0065006E00740065000A00E80020006D0061006E006700690061007200650020007000690061006E006F0020007000690061006E006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Non c’è nessuno più carino\ndel mio Swirlix!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3900,
      "rawDecodedUtf16Hex": "004E006F006E00200063201900E80020006E0065007300730075006E006F00200070006900F900200063006100720069006E006F000A00640065006C0020006D0069006F00200053007700690072006C0069007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Ti assicuro che il mio Aromatisse\nè il più incantevole che ci sia!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3988,
      "rawDecodedUtf16Hex": "0054006900200061007300730069006300750072006F002000630068006500200069006C0020006D0069006F002000410072006F006D006100740069007300730065000A00E800200069006C00200070006900F900200069006E00630061006E007400650076006F006C00650020006300680065002000630069002000730069006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Lo dico sempre, io: come cucinano\nla carne qui, non lo fa nessuno!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 4124,
      "rawDecodedUtf16Hex": "004C006F0020006400690063006F002000730065006D007000720065002C00200069006F003A00200063006F006D006500200063007500630069006E0061006E006F000A006C00610020006300610072006E00650020007100750069002C0020006E006F006E0020006C006F0020006600610020006E0065007300730075006E006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Chef Nicodemo è diventato ancora\npiù bravo! Ma chi lo ferma più?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 4260,
      "rawDecodedUtf16Hex": "00430068006500660020004E00690063006F00640065006D006F002000E800200064006900760065006E007400610074006F00200061006E0063006F00720061000A0070006900F900200062007200610076006F00210020004D006100200063006800690020006C006F0020006600650072006D006100200070006900F9003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Oggi ho speso un po’ troppo... Ma\nogni tanto bisogna farsi un regalo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 4392,
      "rawDecodedUtf16Hex": "004F00670067006900200068006F00200073007000650073006F00200075006E00200070006F2019002000740072006F00700070006F002E002E002E0020004D0061000A006F0067006E0069002000740061006E0074006F0020006200690073006F0067006E006100200066006100720073006900200075006E00200072006500670061006C006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "La nostra missione è far venire ai\nclienti la voglia di tornare da noi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4532,
      "rawDecodedUtf16Hex": "004C00610020006E006F00730074007200610020006D0069007300730069006F006E0065002000E80020006600610072002000760065006E006900720065002000610069000A0063006C00690065006E007400690020006C006100200076006F0067006C0069006100200064006900200074006F0072006E0061007200650020006400610020006E006F006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    }
