      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Huh?!<U+0010><U+0002>Ĕť",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2188,
      "rawDecodedUtf16Hex": "004800750068003F002100100002011401650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Do you...feel a chill in the air?<U+0010><U+0002>Ĕť",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "0044006F00200079006F0075002E002E002E006600650065006C002000610020006300680069006C006C00200069006E00200074006800650020006100690072003F00100002011401650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "What?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "0057006800610074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Nope",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "004E006F007000650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "You don’t feel it? This aura of melancholy...<U+0010><U+0001>븁\nMaybe Gwynn’s Chandelure is mad over what I\njust said and now wants to absorb my spirit...<U+0010><U+0002>Ĕť",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 144
    },
    {
      "displayText": "No, please, don’t punish me! I didn’t mean it! I\ntake it back! Please don’t take my spirit!<U+0010><U+0002>Ĕť",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Phew! The aura of melancholy is gone.<U+0010><U+0002>Ĕť",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "005000680065007700210020005400680065002000610075007200610020006F00660020006D0065006C0061006E00630068006F006C007900200069007300200067006F006E0065002E00100002011401650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "It seems talking about Ivor is off-limits even when\nGwynn’s not around...<U+0010><U+0002>Ĕť",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
