      "offsetInSection": 1688,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "I still lost...<U+0010><U+0002>Ĕť",
