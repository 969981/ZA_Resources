      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Even if you surpass us in speed, I have a backup\nplan to bring us back from the brink!<U+0010><U+0002>Ĕť",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1504,
