    },
    {
      "displayText": "Sure do",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "005300750072006500200064006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "No clue",
      "escapedControlUnits": 0,
