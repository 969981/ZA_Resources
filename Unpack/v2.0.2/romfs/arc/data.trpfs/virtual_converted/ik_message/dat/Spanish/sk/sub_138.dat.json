      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>Ă<U+0004> ama a <U+0010><U+0002>Ă<U+0005>.<U+0010><U+0002>ĔƵ",
