      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 4696,
      "rawDecodedUtf16Hex": "00410020007600650072002C0020006D007500E90073007400720061006D006500200071007500E900200050006F006B00E9006D006F006E00200061006C006600610020006800610073002000740072006100ED0064006F002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Vaya, no me sirve. Tiene que ser un Pokémon alfa.<U+0010><U+0002>ĔƵ",
