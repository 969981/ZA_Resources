      "index": 0,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 157
    },
    {
      "displayText": "¡¿En serio?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "00A100BF0045006E00200073006500720069006F003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "¡Enhorabuena!",
