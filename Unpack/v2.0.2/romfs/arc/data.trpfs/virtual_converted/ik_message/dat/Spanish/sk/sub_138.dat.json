      "utf16Units": 15
    },
    {
      "displayText": "Perdona, pero lo que me gustaría es que me\nmostraras un Pokémon de tipo Hada.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>¡<U+0010><U+0002>ā<U+0008> es perfecto! Ya tengo en\nmente<U+0010><U+0001>븀\nqué<U+0010><U+0001>븀\npapel<U+0010><U+0001>븀\nva a desempeñar.<U+0010><U+0002>ĔƵ",
