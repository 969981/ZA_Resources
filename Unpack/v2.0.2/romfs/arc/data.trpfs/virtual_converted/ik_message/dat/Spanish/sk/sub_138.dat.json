      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Así que <U+0010><U+0002>ā\n, ¿eh?\n¡Va a darle un toque ideal a la trama!<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
