      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Y <U+0010><U+0002>Ă<U+0005> ama a <U+0010><U+0002>Ă<U+0002>.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5860,
      "rawDecodedUtf16Hex": "00590020001000020102000500200061006D00610020006100200010000201020002002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Es una historia con un sinfín de posibles tramas\ny resultados! ¿Cómo terminará todo?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5908,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "¡Suena bien!<U+0010><U+0002>ĔƵ",
