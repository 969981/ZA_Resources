      "offsetInSection": 2396,
      "rawDecodedUtf16Hex": "004900630068002000680061006200650020006E00690063006800740073002000620065007300740065006C006C0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Ein kleines Dankeschön des Hauses. Dafür, dass\nSie Sabbaione begleitet haben.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
