      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Na, geht’s meinem kleinen Grummelchen\nwieder besser?<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2940,
