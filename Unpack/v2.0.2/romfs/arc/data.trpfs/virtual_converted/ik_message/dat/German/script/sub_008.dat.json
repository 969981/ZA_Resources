      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "00440061007300200069007300740020006400650069006E0065002000FC0062006C0069006300680065002000420065007300740065006C006C0075006E0067003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Sabb!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
