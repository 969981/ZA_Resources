      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2604,
      "rawDecodedUtf16Hex": "004200610069006F006F006F006E0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Immer noch schlecht drauf?",
