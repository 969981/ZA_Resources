      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2276,
      "rawDecodedUtf16Hex": "0055006E00640020006600FC00720020005300690065002000650069006E006D0061006C002000640065006E00200053006F006C00650069006C002D004B00610066006600650065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
