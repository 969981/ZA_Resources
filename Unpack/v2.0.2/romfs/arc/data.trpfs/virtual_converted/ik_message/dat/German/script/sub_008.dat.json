      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "005300690065006800740020006100750073002C00200061006C0073002000670069006E00670065002000650073002000690068006D00200070007200E40063006800740069006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Hallo! Ich bin hier, um mein Sabbaione\nabzuholen.<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2832,
