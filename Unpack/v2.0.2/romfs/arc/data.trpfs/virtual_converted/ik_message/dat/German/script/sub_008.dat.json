      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "004600FC00720020006D006900630068003F0020004100620065007200200077006100720075006D003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
