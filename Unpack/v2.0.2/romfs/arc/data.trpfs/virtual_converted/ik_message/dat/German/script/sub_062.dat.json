  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 196,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Die meisten Mitglieder von Illumina Citys\nGesellschaft der Kampf-Connaisseurs setzen<U+0010><U+0001>븀\nFeen-Pokémon ein.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Aber es gibt unter uns auch einige Trainer,\ndie Drachen-Pokémon lieben.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 428,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Drachen-Pokémon sind ja bekanntlich im Nachteil\ngegenüber den Typen Drache, Eis und Fee.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Deswegen ist es eigentlich keine gute Idee,\nbei den Kampf-Connaisseurs mit einem Team<U+0010><U+0001>븀\nvon Drachen-Pokémon anzutreten.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Das ist so ein bisschen wie die Beziehung\nzwischen Violette und Astera...<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Nein, die beiden passen eigentlich ganz gut\nzueinander. Bitte vergiss, was ich gesagt habe!<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Lass uns zur Sache kommen, bevor ich noch\nmehr abschweife.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "004C00610073007300200075006E00730020007A007500720020005300610063006800650020006B006F006D006D0065006E002C0020006200650076006F007200200069006300680020006E006F00630068000A006D00650068007200200061006200730063006800770065006900660065002E00100002011401610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Bitte kämpfe gegen mich, damit ich meine\ngeliebten Drachen-Pokémon trainieren kann!<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Sag einfach Bescheid, wenn du gegen mich\nkämpfen möchtest!<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "005300610067002000650069006E0066006100630068002000420065007300630068006500690064002C002000770065006E006E00200064007500200067006500670065006E0020006D006900630068000A006B00E4006D007000660065006E0020006D00F6006300680074006500730074002100100002011401610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1800,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Du wirst doch gegen meine Drachen-Pokémon\nantreten, nicht wahr?<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "0044007500200077006900720073007400200064006F0063006800200067006500670065006E0020006D00650069006E00650020004400720061006300680065006E002D0050006F006B00E9006D006F006E000A0061006E00740072006500740065006E002C0020006E006900630068007400200077006100680072003F00100002011401610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Klar, gerne!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "004B006C00610072002C0020006700650072006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Nee, lass mal...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1976,
      "rawDecodedUtf16Hex": "004E00650065002C0020006C0061007300730020006D0061006C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Warum nicht?!<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2012,
      "rawDecodedUtf16Hex": "0057006100720075006D0020006E0069006300680074003F002100100002011401610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Dann mach dich mal auf Angriffe von Pokémon\ngefasst, die einen Drachenzahn bei sich tragen!<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2240,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Nun ja... Meine Pokémon können sich ja noch\nentwickeln.<U+0010><U+0001>븁\nWie ich anfangs schon sagte, ist es nicht leicht,\nbei den Kampf-Connaisseurs Drachen-Pokémon<U+0010><U+0001>븀\nzu trainieren.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 174
    },
    {
      "displayText": "Ich habe ihnen extra Drachenzähne zum Tragen\ngegeben, damit ihre Attacken verstärkt werden,<U+0010><U+0001>븀\naber es hat nichts genützt...<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "Du bist eben nicht umsonst aus Violettes\nSuperturnier als <U+0010><U+0004>ᄀÿࠆ<U+0000>SiegerSiegerin hervorgegangen.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2860,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Da meine Pokémon sich noch entwickeln können,\nhätte ich ihnen auch einen Evolith zum Tragen<U+0010><U+0001>븀\ngeben können.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Aber Astera sagt immer, Angriff sei die beste\nVerteidigung.<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3288,
      "rawDecodedUtf16Hex": "004100620065007200200041007300740065007200610020007300610067007400200069006D006D00650072002C00200041006E0067007200690066006600200073006500690020006400690065002000620065007300740065000A0056006500720074006500690064006900670075006E0067002E00100002011401610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Allerdings hat Astera es noch nie geschafft,\ngegen Violette zu gewinnen, also sollte sie ihr<U+0010><U+0001>븀\nMotto vielleicht mal überdenken...<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3416,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "Wie dem auch sei... Hier, ich schenke dir diesen\nDrachenzahn als Dankeschön für den Kampf!<U+0010><U+0002>Ĕš",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
