      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Great, you made it across!\nStreamer lady’s just ahead.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4432,
      "rawDecodedUtf16Hex": "00470072006500610074002C00200079006F00750020006D0061006400650020006900740020006100630072006F007300730021000A00530074007200650061006D006500720020006C006100640079201900730020006A007500730074002000610068006500610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Her name is Canari! CA-NA-RI!\nShe’s not some random streamer!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4544,
      "rawDecodedUtf16Hex": "0048006500720020006E0061006D0065002000690073002000430061006E0061007200690021002000430041002D004E0041002D005200490021000A005300680065201900730020006E006F007400200073006F006D0065002000720061006E0064006F006D002000730074007200650061006D0065007200210000",
