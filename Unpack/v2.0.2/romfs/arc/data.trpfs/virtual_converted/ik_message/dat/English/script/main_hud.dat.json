      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 4680,
      "rawDecodedUtf16Hex": "0043006F0075006C006400200079006F0075002000680075007200720079002000690074002000750070003F000A00492019006D002000670065007400740069006E0067002000740069007200650064002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "I’m fine to fight on!\nJustice will be served!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 53,
