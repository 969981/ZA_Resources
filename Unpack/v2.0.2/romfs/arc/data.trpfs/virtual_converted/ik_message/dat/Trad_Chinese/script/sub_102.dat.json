      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "粉噗～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "7C895657FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "我知道了！我會找找看能\n攝取這麼多樹果的方法的！<U+0010><U+0002>Ĕž",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
