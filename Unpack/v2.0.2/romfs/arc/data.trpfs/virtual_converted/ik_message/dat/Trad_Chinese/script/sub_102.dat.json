      "rawDecodedUtf16Hex": "7C895657FF5EFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "怎麼了，粉香香？\n我不懂你為什麼要生氣耶。<U+0010><U+0002>Ĕž",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
