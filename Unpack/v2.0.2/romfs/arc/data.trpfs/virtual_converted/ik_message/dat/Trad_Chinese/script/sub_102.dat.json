      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "粉粉？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 884,
      "rawDecodedUtf16Hex": "7C897C89FF1F0000",
