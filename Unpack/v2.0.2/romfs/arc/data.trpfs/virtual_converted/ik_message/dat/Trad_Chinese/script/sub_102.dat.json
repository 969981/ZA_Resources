      "rawDecodedUtf16Hex": "7C895657FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "但是你也想知道自己的身體\n能夠散發出什麼樣的新香味，對吧？<U+0010><U+0002>Ĕž",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1348,
