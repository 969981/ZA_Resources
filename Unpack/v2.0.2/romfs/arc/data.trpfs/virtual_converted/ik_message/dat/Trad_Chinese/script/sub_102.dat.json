      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "難道是樹果的數量\n太多了嗎？<U+0010><U+0002>Ĕž",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1300,
      "rawDecodedUtf16Hex": "96E39053662F6A39679C7684657891CF000A592A591A4E8655CEFF1F001000020114017E0000",
      "trailingZeroPaddingUnits": 1,
