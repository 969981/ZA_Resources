  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "¡Aaabuuu! No sé qué le pasa a mi Honedge...\nLo he curado y todo, pero sigue igual de pocho.<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Hmm, ¡blanco y en botella, pequeño! No temas,\nque lo que pasa es que necesita un buen afilado.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "¿Y qué tengo que hacer?<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "00BF005900200071007500E9002000740065006E0067006F0020007100750065002000680061006300650072003F00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Conozco un remedio que es mano de santo para\ndevolverle el filo a Honedge, el Pokémon Tizona.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "¡Un Pupitar!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 916,
      "rawDecodedUtf16Hex": "00A10055006E002000500075007000690074006100720021001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "¡¿Un quéee?!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "00A100BF0055006E00200071007500E900650065003F002100100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Pupitar tiene una coraza durísima que impide\nque le hagan pupita.<U+0010><U+0001>븁\n¡Es perfecta para afilar la hoja de Honedge!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Si tú lo dices... Pero... ¿de dónde voy a sacar yo\na un Pupitar de esos?<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "¡Ah! ¡Oye! No tendrás un Pupitar por ahí, ¿no?\n¡Necesito que mi Honedge se enfrente a uno!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1380,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Enfréntate a mi Honedge con un Pupitar, porfa.\nY que sea el único Pokémon en tu equipo, ¿eh?<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Si Honedge arremete varias veces contra el duro\ncuerpo de Pupitar, ¡su filo quedará como nuevo!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1780,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Has traído a un Pupitar! Deja que mi Honedge\ncombata contra él, porfaaa.<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "¡A ver ese filo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2148,
      "rawDecodedUtf16Hex": "00A1004100200076006500720020006500730065002000660069006C006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "No me apetece",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "004E006F0020006D0065002000610070006500740065006300650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "No juegues así con mis sentimientos...<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "004E006F0020006A00750065006700750065007300200061007300ED00200063006F006E0020006D00690073002000730065006E00740069006D00690065006E0074006F0073002E002E002E00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "¡Yupiii! ¡Pues a combatir!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2300,
      "rawDecodedUtf16Hex": "00A10059007500700069006900690021002000A100500075006500730020006100200063006F006D00620061007400690072002100100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2364,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Déjame que te cure, Honedge. ¡Lo has hecho\nmuy bien, aunque no hayamos podido ganar!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "¡Hon, hon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2556,
      "rawDecodedUtf16Hex": "00A10048006F006E002C00200068006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¿Eeeh? ¡Si Honedge vuelve a ser el de siempre!\n¡Tenías razón, abu!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2580,
      "rawDecodedUtf16Hex": "00BF0045006500650068003F002000A10053006900200048006F006E00650064006700650020007600750065006C0076006500200061002000730065007200200065006C0020006400650020007300690065006D0070007200650021000A00A100540065006E00ED00610073002000720061007A00F3006E002C0020006100620075002100100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "¡Jo, jo, jo! Si es que lo que no sepa tu abuelo...<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2724,
      "rawDecodedUtf16Hex": "00A1004A006F002C0020006A006F002C0020006A006F002100200053006900200065007300200071007500650020006C006F00200071007500650020006E006F0020007300650070006100200074007500200061006200750065006C006F002E002E002E001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "¡Nada que un buen Pupitar no pueda solucionar!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "00A1004E006100640061002000710075006500200075006E0020006200750065006E002000500075007000690074006100720020006E006F00200070007500650064006100200073006F006C007500630069006F006E006100720021001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Y lo mejor de todo es que Pupitar también saca\nbeneficio de todo esto.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2940,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Poner a prueba la dureza de su coraza lo ayuda\na relajarse hasta que esté listo para evolucionar.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3092,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Eso sí suena a trola...<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3296,
      "rawDecodedUtf16Hex": "00450073006F0020007300ED0020007300750065006E006100200061002000740072006F006C0061002E002E002E00100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Bueno, lo importante es que Honedge vuelve a\nestar más animado, ¡y todo gracias a tu Pupitar!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "¡Muchas gracias a ti también por ayudarnos!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3548,
      "rawDecodedUtf16Hex": "00A1004D007500630068006100730020006700720061006300690061007300200061002000740069002000740061006D0062006900E9006E00200070006F00720020006100790075006400610072006E006F0073002100100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3644,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Estoy seguro de que muchos Pokémon se ayudan\nentre sí, aunque nosotros no lo sepamos!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3656,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
