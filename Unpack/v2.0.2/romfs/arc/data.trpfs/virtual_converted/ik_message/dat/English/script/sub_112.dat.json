    },
    {
      "displayText": "This poor wild Fennekin doesn’t seem well at all...<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
