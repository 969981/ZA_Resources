      "rawDecodedUtf16Hex": "00460065006E006E006900690069006B00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "You obtained Fennekin!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4760,
      "rawDecodedUtf16Hex": "0059006F00750020006F0062007400610069006E00650064002000460065006E006E0065006B0069006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Do take good care of that Fennekin, won’t you?<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4808,
