      "rawDecodedUtf16Hex": "0050007200750065006200610020006D006900200062006C0065006E0064002000640069006D0065006E00730069006F006E0061006C002C0020006500730020006C006F0020006D0065006A006F007200200070006100720061000A006300750072006100720020006100200074007500100003110100FD0100007300200050006F006B00E9006D006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
