      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Aliviaré el cansancio de su<U+0010><U+0003>ᄁýĀs Pokémon con una\nde nuestras mejores bebidas, ¡la casa invita!",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
