      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "¿Quieres uno de\nnuestros mejores cafés?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
