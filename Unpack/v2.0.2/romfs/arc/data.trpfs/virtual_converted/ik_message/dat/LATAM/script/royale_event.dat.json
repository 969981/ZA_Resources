      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5012,
      "rawDecodedUtf16Hex": "00A10054006F006D006100200075006E0061002000740061007A0061002000640065006C002000630061006600E9002000650073007400720065006C006C0061000A00640065006C002000450071007500690070006F00200046006C0061007200650020004E006F00750076006500610075002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
