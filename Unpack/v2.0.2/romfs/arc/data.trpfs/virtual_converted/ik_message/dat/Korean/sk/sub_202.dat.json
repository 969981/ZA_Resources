      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "폭주 메가진화와는 다른 것 같지만,\n파워의 중심이 좀 신경 쓰인단 말이지.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
