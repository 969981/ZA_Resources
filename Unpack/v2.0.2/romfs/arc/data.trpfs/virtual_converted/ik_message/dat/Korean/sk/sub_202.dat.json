      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1092,
      "rawDecodedUtf16Hex": "C911C2ECC774C694003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "어떤 점이요?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
