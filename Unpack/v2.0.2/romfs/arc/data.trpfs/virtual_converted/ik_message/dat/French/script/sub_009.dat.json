      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Ouf, merci...\nBon ben... allons-y.<U+0010><U+0002>Ĕĭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1700,
