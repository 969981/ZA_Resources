      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Je vais faire de mon mieux pour gagner...\nEt pour rassurer Nanméouïe...<U+0010><U+0002>Ĕĭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
