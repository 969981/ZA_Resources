      "offsetInSection": 1296,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tu veux bien te battre contre mon Nanméouïe ?\nPeut-être maintenant, si tu as le temps... ?<U+0010><U+0002>Ĕĭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "J’ai le temps !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "004A2019006100690020006C0065002000740065006D00700073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Peut-être plus tard.",
