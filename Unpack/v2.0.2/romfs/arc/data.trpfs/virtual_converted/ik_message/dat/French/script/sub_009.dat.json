      "rawDecodedUtf16Hex": "004E0061006E002E002E002E0020006D00E9006F00750069002000210020266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Ha ha ha, comme tu dis !<U+0010><U+0002>Ĕĭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "00480061002000680061002000680061002C00200063006F006D006D0065002000740075002000640069007300200021001000020114012D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Promis, la prochaine fois, j’écouterai plus\nattentivement tes mises en garde, Nanméouïe !<U+0010><U+0002>Ĕĭ",
