      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "你这家伙不赖嘛！\n院子比以前都漂亮了。<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
