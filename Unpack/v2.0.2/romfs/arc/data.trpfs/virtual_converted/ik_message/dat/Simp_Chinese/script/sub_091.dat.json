      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "犯人一定\n也在其他地方挖洞了！<U+0010><U+0001>븀\n赶紧去给我找到那家伙！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "72AF4EBA4E005B9A000A4E5F572851764ED6573065B963166D1E4E86FF0100100001BE00000A8D767D2753BB7ED96211627E523090A35BB64F19FF01001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
