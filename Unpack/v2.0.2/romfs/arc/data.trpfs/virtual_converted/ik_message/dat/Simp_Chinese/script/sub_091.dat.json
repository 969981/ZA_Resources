      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "你要是不想挨他骂，\n就给我去把犯人揪出来！<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
