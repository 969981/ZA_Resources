      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "La mia materia grigia ha prodotto un’idea\nbrillante! Fare soldi ripulendo la città dalla melma!<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
