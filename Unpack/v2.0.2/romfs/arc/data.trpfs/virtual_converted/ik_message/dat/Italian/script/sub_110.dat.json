      "rawDecodedUtf16Hex": "00430048004500450045005200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Senti, ho bisogno che mi dia una mano tu!<U+0010><U+0002>ĔƆ",
