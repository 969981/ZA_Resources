      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Però la mia idea non funziona!<U+0010><U+0001>븁\nClauncher non ne vuole proprio sapere di\nmandare via la melma.<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 4,
