      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Però purtroppo mi servono delle Monete\ndi Gimmighoul per farlo evolvere.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
