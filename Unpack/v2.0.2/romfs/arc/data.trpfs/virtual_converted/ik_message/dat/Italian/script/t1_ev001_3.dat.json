      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 165
    },
    {
      "displayText": "Voglio lottare! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 592,
      "rawDecodedUtf16Hex": "0056006F0067006C0069006F0020006C006F007400740061007200650021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Voglio fare delle lotte davvero entusiasmanti\na Luminopoli!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 656,
      "rawDecodedUtf16Hex": "0056006F0067006C0069006F00200066006100720065002000640065006C006C00650020006C006F0074007400650020006400610076007600650072006F00200065006E007400750073006900610073006D0061006E00740069000A00610020004C0075006D0069006E006F0070006F006C006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "A Luminopoli ci sono tantissimi caffè. Papà avrà\nl’imbarazzo della scelta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Facciamo una sosta in un caffè?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "004600610063006300690061006D006F00200075006E006100200073006F00730074006100200069006E00200075006E0020006300610066006600E8003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Tredici ore di volo sono davvero estenuanti...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "00540072006500640069006300690020006F0072006500200064006900200076006F006C006F00200073006F006E006F0020006400610076007600650072006F00200065007300740065006E00750061006E00740069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Che Pokémon incontreremo?\nNon vedo l’ora di scoprirlo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "00430068006500200050006F006B00E9006D006F006E00200069006E0063006F006E00740072006500720065006D006F003F000A004E006F006E0020007600650064006F0020006C2019006F00720061002000640069002000730063006F0070007200690072006C006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "A Luminopoli, anche in pieno\ncentro ci sono Pokémon selvatici.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "00410020004C0075006D0069006E006F0070006F006C0069002C00200061006E00630068006500200069006E0020007000690065006E006F000A00630065006E00740072006F00200063006900200073006F006E006F00200050006F006B00E9006D006F006E002000730065006C007600610074006900630069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Eccoci a Luminopoli! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "004500630063006F00630069002000610020004C0075006D0069006E006F0070006F006C00690021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Che borsa gigante! Ti auguro un soggiorno felice\na Luminopoli!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "00430068006500200062006F00720073006100200067006900670061006E007400650021002000540069002000610075006700750072006F00200075006E00200073006F006700670069006F0072006E006F002000660065006C006900630065000A00610020004C0075006D0069006E006F0070006F006C006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Voglio scoprire cos’è successo ultimamente\nqui a Luminopoli.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1528,
      "rawDecodedUtf16Hex": "0056006F0067006C0069006F002000730063006F0070007200690072006500200063006F0073201900E800200073007500630063006500730073006F00200075006C00740069006D0061006D0065006E00740065000A007100750069002000610020004C0075006D0069006E006F0070006F006C0069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Luminopoli ha una lunga storia alle spalle, ma\nnon manca di nuove opportunità.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Eccomi qui, Luminopoli!\nDammi un degno benvenuto! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "004500630063006F006D00690020007100750069002C0020004C0075006D0069006E006F0070006F006C00690021000A00440061006D006D006900200075006E0020006400650067006E006F002000620065006E00760065006E00750074006F0021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Per fare in modo che la città mi accolga a braccia\naperte, anch’io devo fare la mia parte e divertirmi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Vado a lasciare i bagagli in hotel\ne poi farò due passi in città.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "005600610064006F002000610020006C006100730063006900610072006500200069002000620061006700610067006C006900200069006E00200068006F00740065006C000A006500200070006F0069002000660061007200F2002000640075006500200070006100730073006900200069006E0020006300690074007400E0002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "È proprio Kalos! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "00C8002000700072006F007000720069006F0020004B0061006C006F00730021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Il paesaggio che ho visto dal finestrino era proprio\nquello che mi aspettavo da Kalos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2348,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
