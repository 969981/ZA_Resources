      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "00530065002000610076006500730073006900200075006E00200050006F006B00E9006D006F006E002C00200070006F0074007200650069000A00760069006100670067006900610072006500200064006100200073006F006C006F00200063006F006E0020006C00750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
