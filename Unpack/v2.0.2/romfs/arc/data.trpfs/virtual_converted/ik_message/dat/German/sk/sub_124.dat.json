{
  "declaredLength": 6004,
  "decoding": "confirmed-per-slot-XOR-rotate3-index-seed",
  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Oh, du hast mir doch damals geholfen!\nVielen Dank dafür nochmals!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 412,
      "rawDecodedUtf16Hex": "004F0068002C002000640075002000680061007300740020006D0069007200200064006F00630068002000640061006D0061006C00730020006700650068006F006C00660065006E0021000A005600690065006C0065006E002000440061006E006B002000640061006600FC00720020006E006F00630068006D0061006C0073002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Donnersteine sind wirklich toll, nicht wahr?<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "0044006F006E006E006500720073007400650069006E0065002000730069006E00640020007700690072006B006C00690063006800200074006F006C006C002C0020006E006900630068007400200077006100680072003F00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Alola!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "0041006C006F006C00610021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Danke, dass du mit mir damals Pokémon\ngetauscht hast!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "00440061006E006B0065002C002000640061007300730020006400750020006D006900740020006D00690072002000640061006D0061006C007300200050006F006B00E9006D006F006E000A006700650074006100750073006300680074002000680061007300740021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Hoffentlich überfallen wir dich damit nicht zu\nsehr, aber wir würden dir gern etwas zeigen!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Und zwar...<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "0055006E00640020007A007700610072002E002E002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Die Mega-Entwicklung unserer Raichu!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "0044006900650020004D006500670061002D0045006E0074007700690063006B006C0075006E006700200075006E0073006500720065007200200052006100690063006800750021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Und wie könnten wir sie besser demonstrieren\nals in einem Kampf? Sag einfach Bescheid,<U+0010><U+0001>븀\nwenn du startklar bist!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bist du bereit, es mit unserem Mega-Raichu-Duo\naufzunehmen?<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1348,
      "rawDecodedUtf16Hex": "00420069007300740020006400750020006200650072006500690074002C0020006500730020006D0069007400200075006E0073006500720065006D0020004D006500670061002D005200610069006300680075002D00440075006F000A006100750066007A0075006E00650068006D0065006E003F00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Bist du bereit, es mit unserem Mega-Raichu-Duo\naufzunehmen?<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "00420069007300740020006400750020006200650072006500690074002C0020006500730020006D0069007400200075006E0073006500720065006D0020004D006500670061002D005200610069006300680075002D00440075006F000A006100750066007A0075006E00650068006D0065006E003F001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Das bin ich!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1604,
      "rawDecodedUtf16Hex": "004400610073002000620069006E002000690063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Einen Moment noch.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "00450069006E0065006E0020004D006F006D0065006E00740020006E006F00630068002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "*seufz* Ich will dir endlich unsere Mega-Raichu\nzeigen!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "002A0073006500750066007A002A0020004900630068002000770069006C006C002000640069007200200065006E0064006C00690063006800200075006E00730065007200650020004D006500670061002D005200610069006300680075000A007A0065006900670065006E002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Oho, neugierig auf ihre Mega-Entwicklung?\nDann bewundere sie jetzt in diesem Kampf!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Ja, du musst dir unbedingt ansehen, wie unsere\nRaichu nach der Mega-Entwicklung aussehen!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Oho, neugierig auf ihre Mega-Entwicklung?\nDann bewundere sie jetzt in diesem Kampf!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Unsere Raichu...!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2332,
      "rawDecodedUtf16Hex": "0055006E00730065007200650020005200610069006300680075002E002E002E002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Sie sehen aus wie Elite-Pokémon!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2376,
      "rawDecodedUtf16Hex": "00530069006500200073006500680065006E0020006100750073002000770069006500200045006C006900740065002D0050006F006B00E9006D006F006E0021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2452,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Los, werde zu Mega-Raichu X und lass deine\nSchweife vor Energie sprühen!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Ich kämpfe heute als Vorsitzende des Vereins zur\nPopularisierung von Mega-Raichu Y!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2796,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Dein Sieg überrascht mich nicht. Schließlich hast\ndu dein Können schon beim Z-A Royale bewiesen.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Und Illumina hast du auch noch gerettet!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3012,
      "rawDecodedUtf16Hex": "0055006E006400200049006C006C0075006D0069006E006100200068006100730074002000640075002000610075006300680020006E006F006300680020006700650072006500740074006500740021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Jetzt haben wir dir erneut herzlich zu danken,\n<U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3104,
      "rawDecodedUtf16Hex": "00100002BD060000004A00650074007A007400200068006100620065006E00200077006900720020006400690072002000650072006E0065007500740020006800650072007A006C0069006300680020007A0075002000640061006E006B0065006E002C000A0010000201000000002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Denn ohne dich wäre unser Raichu-Duo nie\nzustande gekommen.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3228,
      "rawDecodedUtf16Hex": "00440065006E006E0020006F0068006E0065002000640069006300680020007700E40072006500200075006E0073006500720020005200610069006300680075002D00440075006F0020006E00690065000A007A0075007300740061006E00640065002000670065006B006F006D006D0065006E002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Als kleines Dankeschön erhältst du von mir\nein Raichunit X.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3356,
      "rawDecodedUtf16Hex": "0041006C00730020006B006C00650069006E00650073002000440061006E006B006500730063006800F6006E002000650072006800E4006C00740073007400200064007500200076006F006E0020006D00690072000A00650069006E0020005200610069006300680075006E0069007400200058002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Und von mir ein Raichunit Y.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3484,
      "rawDecodedUtf16Hex": "0055006E006400200076006F006E0020006D00690072002000650069006E0020005200610069006300680075006E0069007400200059002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Ich hoffe, man sieht sich mal wieder!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3552,
      "rawDecodedUtf16Hex": "00490063006800200068006F006600660065002C0020006D0061006E002000730069006500680074002000730069006300680020006D0061006C0020007700690065006400650072002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Alola!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3636,
      "rawDecodedUtf16Hex": "0041006C006F006C00610021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3660,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3672,
      "rawDecodedUtf16Hex": "004F0068002C00200010000201000000002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Was für ein Zufall! Wir haben gerade über dich\ngesprochen.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3700,
      "rawDecodedUtf16Hex": "0057006100730020006600FC0072002000650069006E0020005A007500660061006C006C0021002000570069007200200068006100620065006E0020006700650072006100640065002000FC00620065007200200064006900630068000A00670065007300700072006F006300680065006E002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Über mich?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3828,
      "rawDecodedUtf16Hex": "00DC0062006500720020006D006900630068003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Worum ging’s?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3852,
      "rawDecodedUtf16Hex": "0057006F00720075006D002000670069006E006720190073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Wir haben darüber geredet, wie dankbar wir dir\nfür unsere Raichu sind.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Mein Raichu, das ich mit dem Donnerstein\nentwickelt habe, ist übrigens putzmunter!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4032,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Und das Raichu, das du mir im Tausch gegeben\nhast, ist auch wohlauf!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4208,
      "rawDecodedUtf16Hex": "0055006E006400200064006100730020005200610069006300680075002C00200064006100730020006400750020006D0069007200200069006D00200054006100750073006300680020006700650067006500620065006E000A0068006100730074002C00200069007300740020006100750063006800200077006F0068006C0061007500660021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Wir zwei sind uns zufällig in der Stadt über den\nWeg gelaufen und haben gegenseitig unsere<U+0010><U+0001>븀\nRaichu bewundert.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4356,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Dann sind wir ins Gespräch gekommen und es\nhat sich herausgestellt: Wir haben beide unsere<U+0010><U+0001>븀\nRaichu dir zu verdanken!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Da hat’s sofort gefunkt zwischen uns und wir\nhaben beschlossen, das stärkste Raichu-Duo<U+0010><U+0001>븀\nüberhaupt zu gründen!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4836,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Illumina City und du – ihr habt diese Begegnung\nerst möglich gemacht!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5072,
      "rawDecodedUtf16Hex": "0049006C006C0075006D0069006E00610020004300690074007900200075006E006400200064007500202013002000690068007200200068006100620074002000640069006500730065002000420065006700650067006E0075006E0067000A00650072007300740020006D00F60067006C006900630068002000670065006D00610063006800740021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Chu! Chuchuuu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5220,
      "rawDecodedUtf16Hex": "004300680075002100200043006800750063006800750075007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Wir werden auf alle Pikachu, die uns vor die\nAugen kommen einen Donnerstein anwenden!<U+0010><U+0001>븁\nAch, ich mach doch nur Spaß.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 122
    },
    {
      "displayText": "Raichu macht mich mit seiner bloßen\nAnwesenheit schon glücklich.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5496,
      "rawDecodedUtf16Hex": "0052006100690063006800750020006D00610063006800740020006D0069006300680020006D006900740020007300650069006E0065007200200062006C006F00DF0065006E000A0041006E0077006500730065006E00680065006900740020007300630068006F006E00200067006C00FC0063006B006C006900630068002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "<U+0010><U+0002>뷿.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5636,
      "rawDecodedUtf16Hex": "00100002BDFF002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Welches der beiden ist beeindruckender?\nMega-Raichu X oder Mega-Raichu Y?<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Also, Échan! Die ganze Welt weiß doch, dass alle\nRaichu gleich wundervoll sind!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
