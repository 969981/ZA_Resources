      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Questo dimostra che studiare il rapporto tra i tipi\nè fondamentale...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "00510075006500730074006F002000640069006D006F0073007400720061002000630068006500200073007400750064006900610072006500200069006C00200072006100700070006F00720074006F00200074007200610020006900200074006900700069000A00E800200066006F006E00640061006D0065006E00740061006C0065002E002E002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Ma a dire la verità...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2028,
      "rawDecodedUtf16Hex": "004D006100200061002000640069007200650020006C006100200076006500720069007400E0002E002E002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "... non riesco proprio a ricordarmi tutte\nle combinazioni. Sono troppe!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Dimmi, tu hai imparato tutto quello che c’è da\nsapere sul rapporto tra i tipi?<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Alla perfezione!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2404,
      "rawDecodedUtf16Hex": "0041006C006C0061002000700065007200660065007A0069006F006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Non tutto tutto...",
