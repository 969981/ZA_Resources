      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2388,
      "rawDecodedUtf16Hex": "678181F4768499996C144E0E56DE54730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "千年一遇的味道",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "53435E744E0090477684547390530000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "普普通通",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "666E666E901A901A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "您能明白这一点，\n也可以说是花<U+E300>100万换来的经验。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2436,
      "rawDecodedUtf16Hex": "60A880FD660E767D8FD94E0070B9FF0C000A4E5F53EF4EE58BF4662F82B1E3000031003000304E076362676576847ECF9A8C300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "感谢您给出了配得上\n<U+E300>100万的咖啡的美言。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2500,
      "rawDecodedUtf16Hex": "611F8C2260A87ED951FA4E86914D5F974E0A000AE3000031003000304E0776845496556176847F8E8A00300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "那么收您……\n<U+E300>100万。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 2556,
      "rawDecodedUtf16Hex": "90A34E48653660A820262026000AE3000031003000304E07300200100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "能被至高无上的您饮用，\n至高无上的咖啡豆也一定很高兴吧。<U+0010><U+0002>ĔǠ",
      "escapedControlUnits": 2,
