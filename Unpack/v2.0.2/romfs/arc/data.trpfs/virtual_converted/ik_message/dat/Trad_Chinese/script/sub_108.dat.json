      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "就是這裡！不是這裡還能有哪裡！\n我這就去和管理員談談！<U+0010><U+0002>ĔƄ",
      "escapedControlUnits": 2,
