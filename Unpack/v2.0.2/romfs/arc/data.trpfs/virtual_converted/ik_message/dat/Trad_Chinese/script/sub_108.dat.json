      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "只不過這房租……貴爆了。\n付了房租，我大概就什麼都買不起了。<U+0010><U+0002>ĔƄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1808,
      "rawDecodedUtf16Hex": "53EA4E0D904E9019623F79DF202620268CB472064E863002000A4ED84E86623F79DFFF0C6211592769825C314EC09EBC90FD8CB74E0D8D774E86300200100002011401840000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
