      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "太好了！\n管理員說可以立刻租下來呢！<U+0010><U+0002>ĔƄ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
