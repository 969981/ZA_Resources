      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2724,
      "rawDecodedUtf16Hex": "0049006D006D0065007200680069006E002000680061007300740020006400750020006A006100200064006900650073006500730020007200690065007300690067006500200050006F006B00E9006D006F006E0020006600FC0072000A006D0069006300680020007600650072007400720069006500620065006E002100100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
