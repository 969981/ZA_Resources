      "rawDecodedUtf16Hex": "0056006F007200730069006300680074002C00200067006500680020006C006900650062006500720020006E00690063006800740020007A00750020006E00610068002000720061006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0003>",
