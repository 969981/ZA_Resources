      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Vorsicht, geh lieber nicht zu nah ran!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
