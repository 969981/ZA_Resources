      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "0049006E002000520075006800650020006C0061007300730065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Kukmaaar!!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
