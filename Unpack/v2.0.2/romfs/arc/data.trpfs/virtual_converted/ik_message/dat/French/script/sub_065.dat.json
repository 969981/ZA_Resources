      "rawDecodedUtf16Hex": "005000720065006E0064007300200074006F006E002000740065006D00700073002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Tous mes Pokémon sont de type Normal,\net ils ne feront qu’une bouchée des tiens !<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
