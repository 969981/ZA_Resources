      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "La vérité, c’est que...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "004C00610020007600E900720069007400E9002C0020006320190065007300740020007100750065002E002E002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Je suis incapable de les mémoriser !!!\nIl y a trop de combinaisons possibles !!!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Pas vrai ?! Je suis sûr que même toi, tu ne\nconnais pas par cœur toutes les affinités de type !<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
