    },
    {
      "displayText": "Je cogitais sur les types de Pokémon, et après\nmûre réflexion, j’en ai conclu une chose...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
