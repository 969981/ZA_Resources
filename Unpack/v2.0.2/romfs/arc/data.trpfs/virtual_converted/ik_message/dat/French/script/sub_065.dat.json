      "index": 23,
      "offsetInSection": 2628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "Au final, seul le type Spectre lui résiste !\nImpossible de toucher les Pokémon de ce type<U+0010><U+0001>븀\navec des capacités de type Normal...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
