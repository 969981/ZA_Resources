      "index": 14,
      "offsetInSection": 1740,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hmmm... Je suppose que les affinités de type\nsont un poil plus nuancées que ce que je croyais...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
