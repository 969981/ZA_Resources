      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "00530069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "C’est vrai que c’est difficile...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2392,
      "rawDecodedUtf16Hex": "0043201900650073007400200076007200610069002000710075006500200063201900650073007400200064006900660066006900630069006C0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Tu dois être un<U+0010><U+0003>ᄀÿĀe Dresseu<U+0010><U+0003>ᄀÿȁrse d’exception, alors.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2460,
      "rawDecodedUtf16Hex": "0054007500200064006F00690073002000EA00740072006500200075006E00100003110000FF010000650020004400720065007300730065007500100003110000FF02010072007300650020006420190065007800630065007000740069006F006E002C00200061006C006F00720073002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "On est d’accord !<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2584,
      "rawDecodedUtf16Hex": "004F006E0020006500730074002000642019006100630063006F007200640020002100100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Mais je vais quand même continuer à utiliser\nle type Normal. Ce n’est peut-être pas le meilleur,<U+0010><U+0001>븀\nmais il a l’avantage d’être polyvalent !<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
