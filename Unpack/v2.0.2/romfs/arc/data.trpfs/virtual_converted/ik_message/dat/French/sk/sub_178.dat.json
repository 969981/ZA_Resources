      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3292,
      "rawDecodedUtf16Hex": "00100002BDFF00110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Regarde-toi, Grodoudou ! Tu es tout propre !\nEs-tu content ?<U+0010><U+0001>븀\nTu sens bon, en plus. Me voilà satisfait !<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 4,
