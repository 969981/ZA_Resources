      "index": 22,
      "offsetInSection": 3760,
      "rawDecodedUtf16Hex": "00470072006F0064006F00750064006F007500200064006F006E006E006500200075006E0065002000670072006F0073007300650020007000610069007200650020006400650020006200610066006600650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
