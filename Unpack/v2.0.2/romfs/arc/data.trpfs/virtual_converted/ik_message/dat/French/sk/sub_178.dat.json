  "messages": [
    {
      "displayText": "Toi ! Que sais-tu sur la fourrure des Grodoudou ?\nRéponds-moi ! Allez !<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
