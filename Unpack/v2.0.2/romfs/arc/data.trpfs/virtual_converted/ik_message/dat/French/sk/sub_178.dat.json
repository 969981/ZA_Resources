      "index": 21,
      "offsetInSection": 3732,
      "rawDecodedUtf16Hex": "0044004F005500550055002000210021002100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Grodoudou donne une grosse paire de baffes !",
      "escapedControlUnits": 0,
