      "rawDecodedUtf16Hex": "B9C8C784007EB9C8C784007E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "“마임~마임~!”<U+0010><U+0002>ĔǨ",
