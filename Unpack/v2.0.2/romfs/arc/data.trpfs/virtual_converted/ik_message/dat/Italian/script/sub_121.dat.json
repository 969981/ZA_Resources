      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 840,
      "rawDecodedUtf16Hex": "0046006F00720073006500200069006C0020006C006900760065006C006C006F0020006D006500640069006F002000640065006C006C006100200052006F00790061006C00650020005A002D0041002000730069002000E8000A00610062006200610073007300610074006F003F001000020114018D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Vorrei scoprirlo con una lotta Pokémon!\nPreparati ad assaggiare la mia strategia!<U+0010><U+0002>Ĕƍ",
