      "offsetInSection": 960,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Vieni a parlarmi quando sei pront<U+0010><U+0003>ᄀÿāoa a lottare\ncon me!<U+0010><U+0002>Ĕƍ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "005600690065006E0069002000610020007000610072006C00610072006D00690020007100750061006E0064006F0020007300650069002000700072006F006E007400100003110000FF0101006F0061002000610020006C006F00740074006100720065000A0063006F006E0020006D00650021001000020114018D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Sei pront<U+0010><U+0003>ᄀÿāoa ad assaggiare la mia strategia?<U+0010><U+0002>Ĕƍ",
