      "offsetInSection": 400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Però non me lo spiego... Come fa un<U+0010><U+0003>ᄀÿĀa ragazzin<U+0010><U+0003>ᄀÿāoa\ncome te ad avere risultati del genere?<U+0010><U+0002>Ĕƍ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 636,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
