      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Devi solo schivare gli attacchi dei Pokémon\nselvatici in un’area delimitata!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
