    },
    {
      "displayText": "Tuttavia non potrai mandare in campo Pokémon\no lanciare Poké Ball.<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
