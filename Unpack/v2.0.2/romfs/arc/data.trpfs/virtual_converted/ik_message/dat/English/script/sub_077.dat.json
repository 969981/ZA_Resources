      "index": 60,
      "offsetInSection": 6308,
      "rawDecodedUtf16Hex": "004100660074006500720020007400680061007400200063006C006100730073002C00200049002000770061006E006E00610020006C006500610072006E0020006500760065006E0020006D006F00720065002000610062006F00750074000A004D006500670061002000450076006F006C007500740069006F006E0021001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Me too!<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6444,
      "rawDecodedUtf16Hex": "004D006500200074006F006F0021001000020114019C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Have you heard the rumor that’s been going\naround?<U+0010><U+0001>븁\nEveryone’s saying that the strongest Mega\nEvolution user is gonna save Lumiose!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 4,
