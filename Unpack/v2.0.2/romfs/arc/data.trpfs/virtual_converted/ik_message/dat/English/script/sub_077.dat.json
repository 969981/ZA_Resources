      "index": 62,
      "offsetInSection": 6468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "<U+0010><U+0002>뷿?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6744,
      "rawDecodedUtf16Hex": "00100002BDFF003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mega Evolution’s really amazing!<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 6756,
      "rawDecodedUtf16Hex": "004D006500670061002000450076006F006C007500740069006F006E201900730020007200650061006C006C007900200061006D0061007A0069006E0067002100100002011401990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "All this has made me want to find out more about\nMega Evolution.<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 65,
      "offsetInSection": 6832,
      "rawDecodedUtf16Hex": "0041006C006C0020007400680069007300200068006100730020006D0061006400650020006D0065002000770061006E007400200074006F002000660069006E00640020006F007500740020006D006F00720065002000610062006F00750074000A004D006500670061002000450076006F006C007500740069006F006E002E001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "That was WAY more interesting than anything\nwe’ve done at school!<U+0010><U+0002>Ĕƛ",
