      "index": 57,
      "offsetInSection": 5844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "I’m not sure about all of the answers you gave us,\nthough...<U+0010><U+0002>Ĕů",
