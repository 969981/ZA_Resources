      "index": 58,
      "offsetInSection": 6000,
      "rawDecodedUtf16Hex": "00492019006D0020006E006F007400200073007500720065002000610062006F0075007400200061006C006C0020006F0066002000740068006500200061006E0073007700650072007300200079006F007500200067006100760065002000750073002C000A00740068006F007500670068002E002E002E001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Did you give us bogus answers so we’d have to do\nour own research? That’s rough...<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 6132,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
