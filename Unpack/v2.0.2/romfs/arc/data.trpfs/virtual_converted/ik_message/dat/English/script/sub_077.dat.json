    },
    {
      "displayText": "Yeah, I guess there’s no right answer! Each one\nhas its own strengths and weaknesses.<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 5496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Everyone’s had their turn to ask questions, right?\nThen we’re done with class!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 5676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "You know so much about Mega Evolution! You’re\ndefinitely a Mega Teacher!<U+0010><U+0002>Ĕů",
