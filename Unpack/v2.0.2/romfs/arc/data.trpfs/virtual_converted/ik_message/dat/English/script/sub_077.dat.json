      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Hey, is that a Mega Ring? Can you Mega Evolve\nyour Pokémon?!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "004800650079002C00200069007300200074006800610074002000610020004D006500670061002000520069006E0067003F002000430061006E00200079006F00750020004D006500670061002000450076006F006C00760065000A0079006F0075007200200050006F006B00E9006D006F006E003F0021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "I sure can!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "004900200073007500720065002000630061006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Cool, right?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "0043006F006F006C002C002000720069006700680074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Whoaaa, that’s SO COOL!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 744,
      "rawDecodedUtf16Hex": "00570068006F006100610061002C002000740068006100742019007300200053004F00200043004F004F004C0021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "I bet you know lots about Mega Evolution!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "0049002000620065007400200079006F00750020006B006E006F00770020006C006F00740073002000610062006F007500740020004D006500670061002000450076006F006C007500740069006F006E0021001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Hey, maybe <U+0010><U+0003>ᄀÿĀshe can teach us!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 892,
      "rawDecodedUtf16Hex": "004800650079002C0020006D0061007900620065002000100003110000FF0100007300680065002000630061006E0020007400650061006300680020007500730021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿȁHShe’s not just any old Pokémon Trainer, after all—\n<U+0010><U+0003>ᄀÿĀshe’s a supercool Mega Evolution user!<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Pleeease! Teach us about Mega Evolution!!!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "0050006C0065006500650061007300650021002000540065006100630068002000750073002000610062006F007500740020004D006500670061002000450076006F006C007500740069006F006E002100210021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "My dad works at Quasartico, but he still won’t let\nme have a Mega Ring...<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Mega Evolution’s super popular!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1444,
      "rawDecodedUtf16Hex": "004D006500670061002000450076006F006C007500740069006F006E2019007300200073007500700065007200200070006F00700075006C006100720021001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Even our teachers at school can’t Mega Evolve\ntheir Pokémon...<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "004500760065006E0020006F007500720020007400650061006300680065007200730020006100740020007300630068006F006F006C002000630061006E201900740020004D006500670061002000450076006F006C00760065000A0074006800650069007200200050006F006B00E9006D006F006E002E002E002E001000020114019B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "I’m gonna get a Mega Ring of my own, and then\nI’ll Mega Evolve my partner!<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1812,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Can we have a special class about Mega\nEvolution? Pleeease?<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1824,
      "rawDecodedUtf16Hex": "00430061006E00200077006500200068006100760065002000610020007300700065006300690061006C00200063006C006100730073002000610062006F007500740020004D006500670061000A00450076006F006C007500740069006F006E003F00200050006C006500650065006100730065003F001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Sure! Gather round, children",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1952,
      "rawDecodedUtf16Hex": "00530075007200650021002000470061007400680065007200200072006F0075006E0064002C0020006300680069006C006400720065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "I’ll come back another time...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2012,
      "rawDecodedUtf16Hex": "00492019006C006C00200063006F006D00650020006200610063006B00200061006E006F0074006800650072002000740069006D0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "We can wait! We can totally wait!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2076,
      "rawDecodedUtf16Hex": "00570065002000630061006E002000770061006900740021002000570065002000630061006E00200074006F00740061006C006C0079002000770061006900740021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Yesss! We’ll take turns asking you questions, OK?\nI’ll go first!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "0059006500730073007300210020005700652019006C006C002000740061006B00650020007400750072006E0073002000610073006B0069006E006700200079006F00750020007100750065007300740069006F006E0073002C0020004F004B003F000A00492019006C006C00200067006F0020006600690072007300740021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "You know those little spheres you need to Mega\nEvolve your Pokémon? What’re they called?<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Mega Pebbles",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2480,
      "rawDecodedUtf16Hex": "004D00650067006100200050006500620062006C006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Mega Stones",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2508,
      "rawDecodedUtf16Hex": "004D006500670061002000530074006F006E006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Mega Boulders",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "004D00650067006100200042006F0075006C00640065007200730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "I think I heard them being called something else...<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2560,
      "rawDecodedUtf16Hex": "00490020007400680069006E006B002000490020006800650061007200640020007400680065006D0020006200650069006E0067002000630061006C006C0065006400200073006F006D0065007400680069006E006700200065006C00730065002E002E002E001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Ohhh! They’re stones for Mega Evolving, so that\nmeans they’re called Mega Stones! Makes sense!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2672,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Boulders? Aren’t boulders usually bigger, though?<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "0042006F0075006C0064006500720073003F0020004100720065006E2019007400200062006F0075006C006400650072007300200075007300750061006C006C00790020006200690067006700650072002C002000740068006F007500670068003F001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "I’ve got a question! Mega Stones are named after\nthe Pokémon they match with, right?<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 2980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "What kind of Mega Stone does Canari use to\nMega Evolve her Eelektross?<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3160,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Eelektrossite",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 3312,
      "rawDecodedUtf16Hex": "00450065006C0065006B00740072006F007300730069007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Eelektrite",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 3340,
      "rawDecodedUtf16Hex": "00450065006C0065006B007400720069007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Eelektross’s-ite",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3364,
      "rawDecodedUtf16Hex": "00450065006C0065006B00740072006F0073007320190073002D0069007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Yeah, that sounds right! Do all the Mega Stones\nhave that “-ite” at the end? It’s so funny!<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "The correct answer is Eelektrossite...<U+0010><U+0001>븁\nIt’s true that some Mega Stones don’t use the\nPokémon’s full name, but this one does.<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "That...that can’t be right.<U+0010><U+0002>Ĕƛ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3856,
      "rawDecodedUtf16Hex": "0054006800610074002E002E002E0074006800610074002000630061006E20190074002000620065002000720069006700680074002E001000020114019B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "My turn now!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3920,
      "rawDecodedUtf16Hex": "004D00790020007400750072006E0020006E006F00770021001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "When Pokémon Mega Evolve, their moves get\nstronger. But what do you call those moves?<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Max Moves",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4136,
      "rawDecodedUtf16Hex": "004D006100780020004D006F0076006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Surplus Moves",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4156,
      "rawDecodedUtf16Hex": "0053007500720070006C007500730020004D006F0076006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Plus Moves",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4184,
      "rawDecodedUtf16Hex": "0050006C007500730020004D006F0076006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "I think you’ve got it mixed up with Dynamaxing.<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 4208,
      "rawDecodedUtf16Hex": "00490020007400680069006E006B00200079006F007520190076006500200067006F00740020006900740020006D006900780065006400200075007000200077006900740068002000440079006E0061006D006100780069006E0067002E001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Hmm... Are you taking this seriously?<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4312,
      "rawDecodedUtf16Hex": "0048006D006D002E002E002E002000410072006500200079006F0075002000740061006B0069006E00670020007400680069007300200073006500720069006F00750073006C0079003F001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Oh, I get it! Those moves do seem like a real plus!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 4396,
      "rawDecodedUtf16Hex": "004F0068002C0020004900200067006500740020006900740021002000540068006F007300650020006D006F00760065007300200064006F0020007300650065006D0020006C0069006B0065002000610020007200650061006C00200070006C007500730021001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "I heard that some Pokémon change types when\nthey Mega Evolve! Can you name one?<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 4508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Mega Lucario",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4676,
      "rawDecodedUtf16Hex": "004D0065006700610020004C00750063006100720069006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Mega Ampharos",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 4704,
      "rawDecodedUtf16Hex": "004D00650067006100200041006D0070006800610072006F00730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Mega Manectric",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 4732,
      "rawDecodedUtf16Hex": "004D0065006700610020004D0061006E0065006300740072006900630000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Um... Mega Lucario keeps its Fighting and Steel\ntypes.<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 47,
      "offsetInSection": 4764,
      "rawDecodedUtf16Hex": "0055006D002E002E002E0020004D0065006700610020004C00750063006100720069006F0020006B006500650070007300200069007400730020004600690067006800740069006E006700200061006E006400200053007400650065006C000A00740079007000650073002E00100002011401990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "That’s right! Mega Ampharos gains the Dragon\ntype!<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 4884,
      "rawDecodedUtf16Hex": "00540068006100742019007300200072006900670068007400210020004D00650067006100200041006D0070006800610072006F00730020006700610069006E0073002000740068006500200044007200610067006F006E000A0074007900700065002100100002011401990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Um... Mega Manectric stays an Electric type.<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 49,
      "offsetInSection": 4996,
      "rawDecodedUtf16Hex": "0055006D002E002E002E0020004D0065006700610020004D0061006E00650063007400720069006300200073007400610079007300200061006E00200045006C00650063007400720069006300200074007900700065002E00100002011401990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "You’re all a bunch of nerds. I’m gonna ask\nsomething fun!<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 5096,
      "rawDecodedUtf16Hex": "0059006F007520190072006500200061006C006C00200061002000620075006E006300680020006F00660020006E0065007200640073002E002000492019006D00200067006F006E006E0061002000610073006B000A0073006F006D0065007400680069006E0067002000660075006E0021001000020114019C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Lots of Pokémon can Mega Evolve, right? Which\nMega Evolution do you think is the strongest?<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 5220,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
