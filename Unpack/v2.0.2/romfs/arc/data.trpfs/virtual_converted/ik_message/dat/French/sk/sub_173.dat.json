  "messages": [
    {
      "displayText": "Magicarpe et Barpau sont tous les deux\ndes Pokémon Poisson.<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 172,
