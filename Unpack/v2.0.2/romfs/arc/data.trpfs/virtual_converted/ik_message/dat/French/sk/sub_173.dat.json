      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "005300690020006A0061006D006100690073002000740075002000740072006F007500760065007300200075006E0020004200610072007000610075002C00200074007500200070006F007500720072006100690073000A006D00650020006C006500200064006F006E006E006500720020003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0003>",
      "escapedControlUnits": 3,
