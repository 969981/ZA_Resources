      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "00100002BDFF00030000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Pourrais-tu me donner un Barpau ?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 636,
      "rawDecodedUtf16Hex": "0050006F007500720072006100690073002D007400750020006D006500200064006F006E006E0065007200200075006E00200042006100720070006100750020003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "En voici un !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "0045006E00200076006F00690063006900200075006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Non, pas maintenant.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "004E006F006E002C00200070006100730020006D00610069006E00740065006E0061006E0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Lequel tu veux me donner ?<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "004C0065007100750065006C002000740075002000760065007500780020006D006500200064006F006E006E006500720020003F00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Allez, donne-moi un Barpau s’il te plaît !<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 848,
      "rawDecodedUtf16Hex": "0041006C006C0065007A002C00200064006F006E006E0065002D006D006F006900200075006E00200042006100720070006100750020007320190069006C00200074006500200070006C006100EE00740020002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Oh, un Barpau !\nMerci !<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "004F0068002C00200075006E002000420061007200700061007500200021000A004D00650072006300690020002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Oh, il est très gros, ce Barpau !\nMerci !<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "004F0068002C00200069006C002000650073007400200074007200E80073002000670072006F0073002C002000630065002000420061007200700061007500200021000A004D00650072006300690020002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Oh, mais... C’est un Barpau chromatique ?!\nQuelle générosité !<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1092,
      "rawDecodedUtf16Hex": "004F0068002C0020006D006100690073002E002E002E00200043201900650073007400200075006E00200042006100720070006100750020006300680072006F006D0061007400690071007500650020003F0021000A005100750065006C006C00650020006700E9006E00E90072006F00730069007400E90020002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Un Baron ?!<U+0010><U+0001>븁\nEt en plus il est chromatique ?!<U+0010><U+0001>븁\nJe ne sais pas ce que tu as derrière la tête,\nmais en tous cas, merci du fond du cœur !!!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "J’espère que tu deviendras vite amical,\nmon petit Barpau !<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1520,
      "rawDecodedUtf16Hex": "004A201900650073007000E8007200650020007100750065002000740075002000640065007600690065006E00640072006100730020007600690074006500200061006D006900630061006C002C000A006D006F006E00200070006500740069007400200042006100720070006100750020002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
