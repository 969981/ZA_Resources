    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tu te sens assez fra<U+0010><U+0003>ᄀÿЂisîche pour un petit combat\ncontre mes Pokémon Glace ?<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 4,
