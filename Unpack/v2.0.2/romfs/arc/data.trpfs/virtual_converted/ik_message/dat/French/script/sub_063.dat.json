      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "« C’est parti ! »<U+0010><U+0002>ĔŢ",
