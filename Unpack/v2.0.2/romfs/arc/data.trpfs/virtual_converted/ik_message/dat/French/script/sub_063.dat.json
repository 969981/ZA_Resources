      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1344,
      "rawDecodedUtf16Hex": "00500061007300200076007200610069006D0065006E0074002C0020006E006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Je vois que ma proposition te laisse froid<U+0010><U+0003>ᄀÿĀe.\nSi tu changes d’avis, tu sais où me trouver !<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 4,
