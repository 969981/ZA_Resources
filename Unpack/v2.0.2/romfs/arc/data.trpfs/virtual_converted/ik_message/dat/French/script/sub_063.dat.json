      "offsetInSection": 1384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Génial ! Je peux enfin sortir la meilleure réplique\nde ma Dresseuse favorite quand elle va se battre...<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 2,
