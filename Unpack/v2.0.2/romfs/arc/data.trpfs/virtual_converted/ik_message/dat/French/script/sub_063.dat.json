      "index": 16,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 156
    },
    {
      "displayText": "Tu peux aussi la faire fondre avec des capacités\ncomme Roue de Feu, Jet de Vapeur ou Boutefeu !<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
