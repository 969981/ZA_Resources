      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "« C’est bien. Ne baisse toutefois pas ta garde, car\nla Ligue Pokémon te réserve d’autres surprises ! »<U+0010><U+0002>ĔŢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
