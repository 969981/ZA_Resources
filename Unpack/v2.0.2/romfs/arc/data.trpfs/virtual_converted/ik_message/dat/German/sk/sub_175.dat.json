      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 8444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
