      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 7956,
      "rawDecodedUtf16Hex": "004F002D004F006B00610079002E002E002E00200044006100730020006B006C0069006E006700740020006700750074002E00100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Frospi!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 8016,
      "rawDecodedUtf16Hex": "00460072006F007300700069002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>뷿C",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 8036,
      "rawDecodedUtf16Hex": "00100002BDFF00430000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich bin immer noch total schüchtern, aber ich\ngebe mir Mühe...<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 8048,
      "rawDecodedUtf16Hex": "004900630068002000620069006E00200069006D006D006500720020006E006F0063006800200074006F00740061006C002000730063006800FC00630068007400650072006E002C002000610062006500720020006900630068000A00670065006200650020006D006900720020004D00FC00680065002E002E002E00100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Frospi!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 8184,
      "rawDecodedUtf16Hex": "00460072006F007300700069002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Mach dir keine Gedanken! Wenn wir über\nPokémon reden, werden wir uns ganz von selbst<U+0010><U+0001>븀\nbesser kennenlernen!<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 8204,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Ark!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 8432,
      "rawDecodedUtf16Hex": "00410072006B00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
