      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "我要哞哞鲜奶……\n不对不对！还是果汁牛奶吧！<U+0010><U+0002>Ĕ#",
      "escapedControlUnits": 2,
