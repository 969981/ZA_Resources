      "rawDecodedUtf16Hex": "8FD94F4D8BAD7EC35BB6FF0C000A53EF4EE58BF74F605E2E62114E004E2A5C0F5FD95417FF1F00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我得回家看看独自看家的\n宝可梦冻脊龙状况如何，<U+0010><U+0001>븁\n所以想离开店里一下。\n但是店里又不能没人看管。<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "62115F9756DE5BB6770B770B72EC81EA770B5BB67684000A5B9D53EF68A651BB810A9F9972B651B559824F55FF0C00100001BE01000A62404EE560F379BB5F005E9791CC4E004E0B3002000A4F46662F5E9791CC53C84E0D80FD6CA14EBA770B7BA1300200100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "可以请你替我看店吗？<U+0010><U+0001>븁\n如果你能好好看店，\n我会给你丰厚的奖励！<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "53EF4EE58BF74F6066FF6211770B5E975417FF1F00100001BE01000A5982679C4F6080FD597D597D770B5E97FF0C000A62114F1A7ED94F604E30539A7684595652B1FF0100100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "如果你准备好看店了，\n就跟我说一声哦。<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "5982679C4F6051C65907597D770B5E974E86FF0C000A5C318DDF62118BF44E0058F054E6300200100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0004>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "你愿意帮忙看店吗？<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "4F60613F610F5E2E5FD9770B5E975417FF1F00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "愿意！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "613F610FFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "现在不方便",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 916,
      "rawDecodedUtf16Hex": "73B057284E0D65B94FBF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "唉！我好担心家里啊！<U+0010><U+0001>븁\n冻脊龙独自看家，\n会不会把家里冻成硬邦邦的！？<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "5509FF016211597D62C55FC35BB691CC554AFF0100100001BE01000A51BB810A9F9972EC81EA770B5BB6FF0C000A4F1A4E0D4F1A628A5BB691CC51BB6210786C90A690A67684FF01FF1F00100002011401C20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "你要记住商品的价格哦。<U+0010><U+0001>븁\n美味之水　<U+E300>200\n劲爽汽水　<U+E300>300<U+0010><U+0001>븁\n果汁牛奶　<U+E300>400\n哞哞鲜奶　<U+E300>600<U+0010><U+0001>븀\n我很快就会回来的，拜托你啦！<U+0010><U+0002>Ĕǂ",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
