      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "好纠结……\n现在的心情或许该选美味之水吧。<U+0010><U+0002>Ĕ ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
