      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2108,
      "rawDecodedUtf16Hex": "004E006F0020007400650020007000720065006F0063007500700065007300200070006F00720020006D00ED002C002000BF00760061006C0065003F000A0046006C006F0065007400740065002000650073007400E100200063006F006E006D00690067006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Te falta poco para llegar hasta\nZygarde. ¡Lo veo desde aquí!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2216,
      "rawDecodedUtf16Hex": "00540065002000660061006C0074006100200070006F0063006F002000700061007200610020006C006C0065006700610072002000680061007300740061000A005A007900670061007200640065002E002000A1004C006F002000760065006F002000640065007300640065002000610071007500ED00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
