  "initialKey": 0,
  "messages": [
    {
      "displayText": "¡Si te caes, vuelve a subir!\nEl truco es tener equilibrio.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "00A10053006900200074006500200063006100650073002C0020007600750065006C00760065002000610020007300750062006900720021000A0045006C00200074007200750063006F002000650073002000740065006E0065007200200065007100750069006C0069006200720069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "¡Eso es equilibrio y lo\ndemás son tonterías!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "00A100450073006F00200065007300200065007100750069006C0069006200720069006F002000790020006C006F000A00640065006D00E1007300200073006F006E00200074006F006E00740065007200ED0061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Aquí se complica la cosa...\n¡No te lo pienses y lánzate!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "00410071007500ED00200073006500200063006F006D0070006C0069006300610020006C006100200063006F00730061002E002E002E000A00A1004E006F0020007400650020006C006F0020007000690065006E007300650073002000790020006C00E1006E007A00610074006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¡Bonito aterrizaje! Tendría\nque haberlo grabado.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "00A10042006F006E00690074006F0020006100740065007200720069007A0061006A00650021002000540065006E0064007200ED0061000A007100750065002000680061006200650072006C006F0020006700720061006200610064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "¡Qué estilo! ¡Qué agilidad!\nSe me cae la lagrimilla y todo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 776,
      "rawDecodedUtf16Hex": "00A10051007500E900200065007300740069006C006F0021002000A10051007500E90020006100670069006C00690064006100640021000A005300650020006D006500200063006100650020006C00610020006C0061006700720069006D0069006C006C00610020007900200074006F0064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Aquí ya sabes lo que toca...\n¡Valor, <U+0010><U+0002>Ā<U+0000>!",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "00410071007500ED0020007900610020007300610062006500730020006C006F002000710075006500200074006F00630061002E002E002E000A00A100560061006C006F0072002C0020001000020100000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "¡No bajes la guardia!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "00A1004E006F002000620061006A006500730020006C00610020006700750061007200640069006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Vaya, vaya...\n¡Un callejón sin salida!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "0056006100790061002C00200076006100790061002E002E002E000A00A10055006E002000630061006C006C0065006A00F3006E002000730069006E002000730061006C00690064006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Vaya, hombre!\n¡Toca dar media vuelta!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1108,
      "rawDecodedUtf16Hex": "00A10056006100790061002C00200068006F006D0062007200650021000A00A10054006F0063006100200064006100720020006D00650064006900610020007600750065006C0074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Ánimo, sigue hasta el final! Eres\nla gran esperanza de la ciudad.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "00A100C1006E0069006D006F002C00200073006900670075006500200068006100730074006100200065006C002000660069006E0061006C002100200045007200650073000A006C00610020006700720061006E0020006500730070006500720061006E007A00610020006400650020006C00610020006300690075006400610064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ya llevas un buen trecho.\n¡Ahora, no te líes y p'alante!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "005900610020006C006C006500760061007300200075006E0020006200750065006E002000740072006500630068006F002E000A00A100410068006F00720061002C0020006E006F0020007400650020006C00ED00650073002000790020007000270061006C0061006E0074006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¡A saltar\nse ha dicho!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "00A10041002000730061006C007400610072000A0073006500200068006100200064006900630068006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Y fin del recorrido! ¡Un aplauso\npara <U+0010><U+0002>Ā<U+0000>!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "00A10059002000660069006E002000640065006C0020007200650063006F0072007200690064006F0021002000A10055006E002000610070006C006100750073006F000A00700061007200610020001000020100000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Es muy sencillo: siempre que\npuedas, tira p'arriba.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "004500730020006D00750079002000730065006E00630069006C006C006F003A0020007300690065006D0070007200650020007100750065000A007000750065006400610073002C00200074006900720061002000700027006100720072006900620061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Por aquí,\nsígueme.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "0050006F0072002000610071007500ED002C000A007300ED006700750065006D0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
