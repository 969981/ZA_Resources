      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "00430072007500630065006D006F0073000A0065006C0020007000750065006E00740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "¡Esto tiene cada vez peor pinta!\nSerá mejor que te des prisa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "00A1004500730074006F0020007400690065006E006500200063006100640061002000760065007A002000700065006F0072002000700069006E007400610021000A00530065007200E10020006D0065006A006F007200200071007500650020007400650020006400650073002000700072006900730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "¡Esto cada vez pinta peor!\nSerá mejor que te des prisa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1888,
      "rawDecodedUtf16Hex": "00A1004500730074006F00200063006100640061002000760065007A002000700069006E00740061002000700065006F00720021000A00530065007200E10020006D0065006A006F007200200071007500650020007400650020006400650073002000700072006900730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
