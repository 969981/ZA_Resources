      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2000,
      "rawDecodedUtf16Hex": "004E006F0020007400650020007000720065006F0063007500700065007300200070006F00720020006D00ED002C002000BF006F006B00650079003F000A0046006C006F0065007400740065002000650073007400E100200063006F006E006D00690067006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
