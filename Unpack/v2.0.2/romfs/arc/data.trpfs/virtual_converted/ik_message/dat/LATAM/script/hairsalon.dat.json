      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "¿No te convence? No hay problema.\nTómate el tiempo que necesites.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 101,
      "offsetInSection": 3656,
