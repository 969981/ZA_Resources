      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "¡Muy bien! A ver, un segundito...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 93,
      "offsetInSection": 2828,
      "rawDecodedUtf16Hex": "00A1004D007500790020006200690065006E0021002000410020007600650072002C00200075006E00200073006500670075006E006400690074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "¡Muy bien! Te lo guardo en la Bolsa, entonces.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 94,
      "offsetInSection": 2896,
      "rawDecodedUtf16Hex": "00A1004D007500790020006200690065006E00210020005400650020006C006F002000670075006100720064006F00200065006E0020006C006100200042006F006C00730061002C00200065006E0074006F006E006300650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "No puedes ponerte nada en la cabeza con este\npeinado, así que te guardé lo que llevabas<U+0010><U+0001>븀\nen la Bolsa.",
