      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 103,
      "offsetInSection": 3868,
      "rawDecodedUtf16Hex": "00A1004E006F0020007400650020007000720065006F006300750070006500730021002000450073007400E10020006200690065006E002000630061006D0062006900610072000A006400650020006F00700069006E006900F3006E002E002000A1004F007400720061002000760065007A002000730065007200E100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
