      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 104,
      "offsetInSection": 3996,
      "rawDecodedUtf16Hex": "00A1004E006F0020006800610079002000700072006F0062006C0065006D006100210020005400F3006D00610074006500200065006C0020007400690065006D0070006F000A0071007500650020006E00650063006500730069007400650073002E0020004E006F0020006800610079002000700072006900730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
