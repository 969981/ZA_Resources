      "rawDecodedUtf16Hex": "004E002F00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "¡Hola, bienvenid<U+0010><U+0003>ᄀÿāoa! ¿En qué te puedo ayudar hoy?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 2088,
      "rawDecodedUtf16Hex": "00A10048006F006C0061002C0020006200690065006E00760065006E0069006400100003110000FF0101006F00610021002000BF0045006E00200071007500E900200074006500200070007500650064006F002000610079007500640061007200200068006F0079003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "¡Excelente! Pasa y ponte cómod<U+0010><U+0003>ᄀÿāoa mientras\npreparo todo.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 87,
