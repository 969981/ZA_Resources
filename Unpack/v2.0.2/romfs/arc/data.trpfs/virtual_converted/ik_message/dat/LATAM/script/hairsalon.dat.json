      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "¿Estás segur<U+0010><U+0003>ᄀÿāoa? Es parecido a lo que ya tenías.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 98,
      "offsetInSection": 3376,
