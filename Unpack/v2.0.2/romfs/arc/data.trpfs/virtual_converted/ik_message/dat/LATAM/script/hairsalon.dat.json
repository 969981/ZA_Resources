      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Eh... Parece que no tienes suficiente dinero...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 88,
      "offsetInSection": 2320,
      "rawDecodedUtf16Hex": "00450068002E002E002E002000500061007200650063006500200071007500650020006E006F0020007400690065006E0065007300200073007500660069006300690065006E00740065002000640069006E00650072006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Eh... Parece que no tienes suficientes puntos\nde liga...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 89,
      "offsetInSection": 2416,
      "rawDecodedUtf16Hex": "00450068002E002E002E002000500061007200650063006500200071007500650020006E006F0020007400690065006E0065007300200073007500660069006300690065006E007400650073002000700075006E0074006F0073000A006400650020006C006900670061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¡Listo!\nEste estilo te queda fa-bu-lo-so.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 90,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "00A1004C006900730074006F0021000A004500730074006500200065007300740069006C006F002000740065002000710075006500640061002000660061002D00620075002D006C006F002D0073006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "¡Gracias por tu visita!\nEsperamos volver a verte pronto.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 91,
      "offsetInSection": 2616,
      "rawDecodedUtf16Hex": "00A1004700720061006300690061007300200070006F007200200074007500200076006900730069007400610021000A004500730070006500720061006D006F007300200076006F006C00760065007200200061002000760065007200740065002000700072006F006E0074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¿Quieres ponerte lo que llevabas en la cabeza?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 92,
      "offsetInSection": 2732,
