      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Les Pokémon utilisent des capacités physiques\net des capacités spéciales.<U+0010><U+0001>븁\nDepuis le résumé du Pokémon, on peut voir à\nquelle catégorie appartient une capacité.<U+0010><U+0001>븁\nLes capacités physiques sont représentées\npar un symbole à pointes.<U+0010><U+0002>ĔŚ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 238
    },
    {
      "displayText": "Je pense qu’une attaque physique de type\nCombat devrait suffire à le réparer !<U+0010><U+0002>ĔŚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
