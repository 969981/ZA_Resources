      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Je crois qu’il va me falloir l’aide d’un Pokémon\npour régler le problème.<U+0010><U+0002>ĔŚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
