      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Non non, il faut utiliser une capacité physique\nde type Combat, sinon ça marchera pas !<U+0010><U+0002>ĔŚ",
