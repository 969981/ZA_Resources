      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "請對纏紅鶴\n使出<U+0010><U+0002>＀<U+0006>催眠術<U+0010><U+0002>＀<U+0000>和<U+0010><U+0002>＀<U+0006>食夢<U+0010><U+0002>＀<U+0000>！<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 14,
