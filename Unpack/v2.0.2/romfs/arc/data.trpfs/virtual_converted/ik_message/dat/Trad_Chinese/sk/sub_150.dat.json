  "messages": [
    {
      "displayText": "那邊那位<U+0010><U+0003>ᄀÿȂ先生女士，\n請<U+0010><U+0003>ᄀÿā你妳聽我說一下話。<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 244,
      "rawDecodedUtf16Hex": "90A3908A90A34F4D00100003110000FF02025148751F597358EBFF0C000A8ACB00100003110000FF01014F6059B3807D62118AAA4E004E0B8A71300200100002011401BB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "我一時興起開始提供一項服務，\n但現在有一點困擾。<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 316,
