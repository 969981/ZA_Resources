      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "具體來說，就是請<U+0010><U+0003>ᄀÿā你妳對纏紅鶴\n使出<U+0010><U+0002>＀<U+0006>催眠術<U+0010><U+0002>＀<U+0000>和<U+0010><U+0002>＀<U+0006>食夢<U+0010><U+0002>＀<U+0000>！<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 792,
