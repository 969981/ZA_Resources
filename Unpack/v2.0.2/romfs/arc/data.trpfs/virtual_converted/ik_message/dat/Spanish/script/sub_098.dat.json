  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "¡Oye, tú! ¿Podrías poner fin a mi desasosiego?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 352,
      "rawDecodedUtf16Hex": "00A1004F00790065002C0020007400FA0021002000BF0050006F0064007200ED0061007300200070006F006E00650072002000660069006E002000610020006D0069002000640065007300610073006F0073006900650067006F003F001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0002>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 456,
      "rawDecodedUtf16Hex": "00100002BDFF00020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Como puedes observar, soy una artista de pies\na cabeza.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "0043006F006D006F00200070007500650064006500730020006F0062007300650072007600610072002C00200073006F007900200075006E00610020006100720074006900730074006100200064006500200070006900650073000A006100200063006100620065007A0061002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Quería pintar el cuadro de un paisaje urbanístico\npara un concurso...<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "005100750065007200ED0061002000700069006E00740061007200200065006C002000630075006100640072006F00200064006500200075006E002000700061006900730061006A006500200075007200620061006E00ED0073007400690063006F000A007000610072006100200075006E00200063006F006E0063007500720073006F002E002E002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "¡Y fíjate!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 736,
      "rawDecodedUtf16Hex": "00A100590020006600ED006A0061007400650021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "¡Esa zarza ahí plantada justo delante de la fuente\nme estorba sobremanera!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Pero no hay manera de cortarla con los ataques\nde mi Pokémon.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "005000650072006F0020006E006F00200068006100790020006D0061006E00650072006100200064006500200063006F0072007400610072006C006100200063006F006E0020006C006F007300200061007400610071007500650073000A006400650020006D006900200050006F006B00E9006D006F006E002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "¡Uy, me viene un susurro de mi musa!\nSi no se puede cortar, ¿igual se puede incinerar?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "¡Hazme ese favor para poder dar rienda suelta\na mi inspiración!<U+0010><U+0001>븁\nUsa un movimiento Pokémon para que esa zarza\nestorbadora sea pasto de las llamas.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 153
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Utiliza un movimiento Pokémon para que el fuego\nconsuma esa dichosa zarza delante de la fuente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Gracias, gracias de todo corazón!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "00A10047007200610063006900610073002C0020006700720061006300690061007300200064006500200074006F0064006F00200063006F00720061007A00F3006E0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Por fin podré reanudar mi bosquejo.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "0050006F0072002000660069006E00200070006F0064007200E90020007200650061006E00750064006100720020006D006900200062006F0073007100750065006A006F002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¡¿Eh?! ¡No puede ser!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "00A100BF00450068003F0021002000A1004E006F00200070007500650064006500200073006500720021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡La zarza no ha hecho sino crecer! ¡Ay de mí!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "00A1004C00610020007A00610072007A00610020006E006F00200068006100200068006500630068006F002000730069006E006F00200063007200650063006500720021002000A1004100790020006400650020006D00ED0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Pues cuanto mayor es la zarza, mayor es también\nmi ruego.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2088,
      "rawDecodedUtf16Hex": "00500075006500730020006300750061006E0074006F0020006D00610079006F00720020006500730020006C00610020007A00610072007A0061002C0020006D00610079006F0072002000650073002000740061006D0062006900E9006E000A006D006900200072007500650067006F002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Utiliza un movimiento Pokémon para calcinar\nese incordio de zarza delante de la fuente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2396,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Gracias desde lo más hondo de mi corazón!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "00A100470072006100630069006100730020006400650073006400650020006C006F0020006D00E1007300200068006F006E0064006F0020006400650020006D006900200063006F00720061007A00F3006E0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ahora podré ponerme de nuevo manos a la obra,\nliteralmente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "00410068006F0072006100200070006F0064007200E900200070006F006E00650072006D00650020006400650020006E007500650076006F0020006D0061006E006F0073002000610020006C00610020006F006200720061002C000A006C00690074006500720061006C006D0065006E00740065002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "¡¿Eh?! ¡Que me aspen si lo entiendo!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2632,
      "rawDecodedUtf16Hex": "00A100BF00450068003F0021002000A10051007500650020006D006500200061007300700065006E0020007300690020006C006F00200065006E007400690065006E0064006F0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "¡La zarza ha vuelto a crecer! ¡Desdichada de mí!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2716,
      "rawDecodedUtf16Hex": "00A1004C00610020007A00610072007A00610020006800610020007600750065006C0074006F0020006100200063007200650063006500720021002000A100440065007300640069006300680061006400610020006400650020006D00ED0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Pues cuanto mayor aún es la zarza, mayor aún es\nla enjundia del favor que te vuelvo a pedir.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Utiliza un movimiento Pokémon para quemar toda\nesa zarza del demonio delante de la fuente.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 3020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3212,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Mi corazón rebosa gratitud hacia tu maravillosa\npersona!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3224,
      "rawDecodedUtf16Hex": "00A1004D006900200063006F00720061007A00F3006E0020007200650062006F007300610020006700720061007400690074007500640020006800610063006900610020007400750020006D00610072006100760069006C006C006F00730061000A0070006500720073006F006E00610021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Ahora sí que podré retomar mi bosquejo\nde una vez por todas.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3348,
      "rawDecodedUtf16Hex": "00410068006F007200610020007300ED002000710075006500200070006F0064007200E90020007200650074006F006D006100720020006D006900200062006F0073007100750065006A006F000A0064006500200075006E0061002000760065007A00200070006F007200200074006F006400610073002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Pero, francamente, ¿qué estará pasando?\n¿Cómo pueden aparecer zarzas así, de improviso?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3480,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¡Ah, es Phantump, el Pokémon! ¿Acaso era él\nquien me estaba estorbando?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Phannn.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3816,
      "rawDecodedUtf16Hex": "005000680061006E006E006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "¿Por qué me torturas así? Con lo apurada que voy\npara el concurso...<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3832,
      "rawDecodedUtf16Hex": "00BF0050006F007200200071007500E90020006D006500200074006F00720074007500720061007300200061007300ED003F00200043006F006E0020006C006F00200061007000750072006100640061002000710075006500200076006F0079000A007000610072006100200065006C00200063006F006E0063007500720073006F002E002E002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¡Oh, siento como las musas me visitan de nuevo!\n¡Lo veo, lo veo: Phantump y la fuente!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Un Phantump realzando la fuente representa toda\nuna metáfora de la Ciudad Luminalia actual.<U+0010><U+0001>븁\n¡Phantump, quiero que seas mi modelo!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "¡¿Phannn?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4440,
      "rawDecodedUtf16Hex": "00A100BF005000680061006E006E006E003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Juntos crearemos para la posteridad la obra de\narte del siglo, destinada a decorar las galerías<U+0010><U+0001>븀\ndel Museo de Arte de Luminalia.<U+0010><U+0001>븁\n¡No muevas ni una ramita hasta que dé\nla pincelada final, Phantump!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 206
    },
    {
      "displayText": "Phannn...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4876,
      "rawDecodedUtf16Hex": "005000680061006E006E006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "¡Gracias! ¡Tu intervención me servirá en bandeja\nla victoria en el concurso pictórico!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5080,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Las travesuras de Phantump han reavivado aún\nmás si cabe la llama de mi pasión artística!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5092,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Phannn.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5284,
      "rawDecodedUtf16Hex": "005000680061006E006E006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    }
  ],
