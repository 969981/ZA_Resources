      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "¡Una cangrejopelea descontrolada!<U+0010><U+0002>ĔǙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
