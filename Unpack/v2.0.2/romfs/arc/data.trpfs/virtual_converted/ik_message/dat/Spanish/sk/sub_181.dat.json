      "offsetInSection": 788,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Has parado la cangrejopelea descontrolada!\nVeo que no eres un<U+0010><U+0003>ᄀÿĀa Entrenador<U+0010><U+0003>ᄀÿĀa cualquiera.<U+0010><U+0002>ĔǙ",
      "escapedControlUnits": 6,
