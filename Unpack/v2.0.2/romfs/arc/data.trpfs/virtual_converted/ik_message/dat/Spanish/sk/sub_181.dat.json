      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Dicen que los Crabominable siempre quieren ser\nlos mejores y que tienden a zurrar a todo lo que<U+0010><U+0001>븀\nse interponga en su camino.<U+0010><U+0002>ĔǙ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 131
    },
    {
