      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "如果想要使用特殊搜尋系統，\n就必須要有異次元調查的點數。<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "5982679C60F389814F7F752872796B8A641C5C0B7CFB7D71FF0C000A5C315FC598088981670975706B2151438ABF67E576849EDE6578300200100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
