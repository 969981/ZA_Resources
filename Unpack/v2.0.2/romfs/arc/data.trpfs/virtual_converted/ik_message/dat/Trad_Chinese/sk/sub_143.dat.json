      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B36F024EAE57305B8C62104E86000A70CF7FBD5148751F59D48A1700100003110000FF01014F6059B376844E8B4E865462300200100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "煩請<U+0010><U+0003>ᄀÿā你妳到烏羽先生的房間一趟。<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 5,
