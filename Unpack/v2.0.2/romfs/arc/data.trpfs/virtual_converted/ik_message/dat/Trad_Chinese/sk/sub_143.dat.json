      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "特殊？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 256,
      "rawDecodedUtf16Hex": "72796B8AFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "搜尋？",
