      "rawDecodedUtf16Hex": "8F9B82E600100003110000FF01014F6059B34E86300200100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳漂亮地完成了\n烏羽先生委託<U+0010><U+0003>ᄀÿā你妳的事了呢。<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
