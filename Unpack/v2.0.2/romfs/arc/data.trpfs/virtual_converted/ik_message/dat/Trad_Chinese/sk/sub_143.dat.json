      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "因為可以搜尋特殊的異次元扭洞，\n所以叫做特殊搜尋！<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "56E070BA53EF4EE5641C5C0B72796B8A768475706B215143626D6D1EFF0C000A62404EE553EB505A72796B8A641C5C0BFF0100100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "如果<U+0010><U+0003>ᄀÿā你妳想要啟動\n特殊搜尋的系統，<U+0010><U+0001>븀\n就請告訴我一聲。<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1184,
      "rawDecodedUtf16Hex": "5982679C00100003110000FF01014F6059B360F38981555F52D5000A72796B8A641C5C0B76847CFB7D71FF0C00100001BE00000A5C318ACB544A8A3462114E008072300200100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳幹得不錯嘛！<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
