      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "那我這就把<U+0010><U+0003>ᄀÿā你妳蒐集來的資料\n輸入到系統裡……<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1024,
