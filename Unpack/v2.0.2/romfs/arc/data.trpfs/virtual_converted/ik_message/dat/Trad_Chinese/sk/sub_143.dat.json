      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "好囉！\n特殊搜尋完成啦。<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1088,
