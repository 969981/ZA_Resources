      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "每個都不錯吧？<U+0010><U+0001>븁\n所以我們三個現在就像是火、水、草\n三種屬性，在這裡僵持著乾瞪眼。<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1412,
      "rawDecodedUtf16Hex": "6BCF500B90FD4E0D932F5427FF1F00100001BE01000A62404EE5621150114E09500B73FE57285C3150CF662F706B30016C3430018349000A4E097A2E5C6C6027FF0C5728901988E150F5630184574E7E77AA773C300200100002011401B20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
