      "index": 1,
      "offsetInSection": 176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Pour gagner contre quelqu’un comme toi,\nje dois utiliser ma meilleure arme !<U+0010><U+0001>븁\nJe vais donc te défier avec des Pokémon Insecte,\nmon type préféré !<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 152
    },
    {
      "displayText": "Je les aime tant ! Je sais tout sur eux !\nEt comme on dit, le savoir est une arme !<U+0010><U+0001>븀\nAssez discuté ! Tu veux bien te battre ?<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "Reviens me voir si tu veux faire un combat !<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 904,
      "rawDecodedUtf16Hex": "00520065007600690065006E00730020006D006500200076006F006900720020007300690020007400750020007600650075007800200066006100690072006500200075006E00200063006F006D0062006100740020002100100002011401630000",
      "trailingZeroPaddingUnits": 1,
