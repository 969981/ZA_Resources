  "initialKey": 0,
  "messages": [
    {
      "displayText": "Chiedo scusa, sa se questo caffè ha chiuso?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "00430068006900650064006F002000730063007500730061002C002000730061002000730065002000710075006500730074006F0020006300610066006600E8002000680061002000630068006900750073006F003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Così sembrerebbe",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "0043006F007300EC002000730065006D006200720065007200650062006200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "È una storia lunga...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 616,
      "rawDecodedUtf16Hex": "00C800200075006E0061002000730074006F0072006900610020006C0075006E00670061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Capisco...<U+0010><U+0001>븁\nSono dieci anni che manco da questa città, e\nnon vedevo l’ora di gustare di nuovo il loro caffè...<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Senta... Non è che per caso conosce qualcuno\nche lavorava qui?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "00530065006E00740061002E002E002E0020004E006F006E002000E8002000630068006500200070006500720020006300610073006F00200063006F006E006F0073006300650020007100750061006C00630075006E006F000A0063006800650020006C00610076006F00720061007600610020007100750069003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Sì",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "005300EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Vuole che chiami uno di loro?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "00560075006F006C0065002000630068006500200063006800690061006D006900200075006E006F0020006400690020006C006F0072006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Mi farebbe un grande piacere se potesse\ncontattare qualcuno!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "004D00690020006600610072006500620062006500200075006E0020006700720061006E006400650020007000690061006300650072006500200073006500200070006F00740065007300730065000A0063006F006E00740061007400740061007200650020007100750061006C00630075006E006F002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "A chi vuoi chiedere?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "00410020006300680069002000760075006F0069002000630068006900650064006500720065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "A Gris",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "0041002000470072006900730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "A Grise",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1292,
      "rawDecodedUtf16Hex": "00410020004700720069007300650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "A cosa devo questa chiamata?<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "004100200063006F007300610020006400650076006F002000710075006500730074006100200063006800690061006D006100740061003F00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Capisco.<U+0010><U+0001>븁\nIn questo caso, dovresti rivolgerti alla proprietaria\ndel Caffè Nouveau nº 3.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Lei lavorava per il barista.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "004C006500690020006C00610076006F0072006100760061002000700065007200200069006C00200062006100720069007300740061002E00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Servizio a domicilio?<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "00530065007200760069007A0069006F0020006100200064006F006D006900630069006C0069006F003F00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Ah, cerchi qualcuno? Non farmi perdere tempo.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "00410068002C00200063006500720063006800690020007100750061006C00630075006E006F003F0020004E006F006E0020006600610072006D006900200070006500720064006500720065002000740065006D0070006F002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Il barista del Caffè Elisio? Allora devi sentire\nla proprietaria del vagoncino nº 3.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Mi pare che lavorasse per il barista, ai tempi.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1964,
      "rawDecodedUtf16Hex": "004D00690020007000610072006500200063006800650020006C00610076006F00720061007300730065002000700065007200200069006C00200062006100720069007300740061002C002000610069002000740065006D00700069002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Dunque al Caffè Nouveau nº 3 dovrei riuscire a\nsaperne di più sul barista!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Se non sbaglio... si trova nel <U+0010><U+0002>＀<U+0006>Quartiere Rosa<U+0010><U+0002>＀<U+0000>,\ngiusto?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2228,
      "rawDecodedUtf16Hex": "005300650020006E006F006E00200073006200610067006C0069006F002E002E002E002000730069002000740072006F007600610020006E0065006C002000100002FF00000600510075006100720074006900650072006500200052006F0073006100100002FF000000002C000A00670069007500730074006F003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Diamoci appuntamento al Caffè Nouveau nº 3,\nallora!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2364,
      "rawDecodedUtf16Hex": "004400690061006D006F0063006900200061007000700075006E00740061006D0065006E0074006F00200061006C0020004300610066006600E80020004E006F007500760065006100750020006E00BA00200033002C000A0061006C006C006F00720061002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2476,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>! Ben arrivat<U+0010><U+0003>ᄀÿāoa!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "00100002010000000021002000420065006E0020006100720072006900760061007400100003110000FF0101006F0061002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Andiamo a chiedere del barista del Caffè Elisio.<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "0041006E006400690061006D006F00200061002000630068006900650064006500720065002000640065006C00200062006100720069007300740061002000640065006C0020004300610066006600E800200045006C006900730069006F002E00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Non siete qui per ordinare, mi sembra...\nCome posso esservi utile?<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "004E006F006E002000730069006500740065002000710075006900200070006500720020006F007200640069006E006100720065002C0020006D0069002000730065006D006200720061002E002E002E000A0043006F006D006500200070006F00730073006F002000650073007300650072007600690020007500740069006C0065003F00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Capisco, ora è chiaro.<U+0010><U+0001>븁\nIl barista del Caffè Elisio è colui che mi ha\ninsegnato a preparare il caffè.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "Gli farà molto piacere sapere che un suo cliente\nlo stava cercando.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3016,
      "rawDecodedUtf16Hex": "0047006C0069002000660061007200E00020006D006F006C0074006F002000700069006100630065007200650020007300610070006500720065002000630068006500200075006E002000730075006F00200063006C00690065006E00740065000A006C006F002000730074006100760061002000630065007200630061006E0064006F002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Penserò io a contattarlo. Voi fatevi trovare\ndavanti al Caffè Elisio.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3160,
      "rawDecodedUtf16Hex": "00500065006E00730065007200F200200069006F0020006100200063006F006E007400610074007400610072006C006F002E00200056006F00690020006600610074006500760069002000740072006F0076006100720065000A0064006100760061006E0074006900200061006C0020004300610066006600E800200045006C006900730069006F002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Vi aspetterò davanti al Caffè Elisio, allora!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3308,
      "rawDecodedUtf16Hex": "0056006900200061007300700065007400740065007200F200200064006100760061006E0074006900200061006C0020004300610066006600E800200045006C006900730069006F002C00200061006C006C006F00720061002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Penserò io a contattarlo. Voi fatevi trovare\ndavanti al Caffè Elisio.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3408,
      "rawDecodedUtf16Hex": "00500065006E00730065007200F200200069006F0020006100200063006F006E007400610074007400610072006C006F002E00200056006F00690020006600610074006500760069002000740072006F0076006100720065000A0064006100760061006E0074006900200061006C0020004300610066006600E800200045006C006900730069006F002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3556,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Potrò incontrare il barista... Non so, mi sento\nquasi emozionato!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3568,
      "rawDecodedUtf16Hex": "0050006F0074007200F200200069006E0063006F006E0074007200610072006500200069006C00200062006100720069007300740061002E002E002E0020004E006F006E00200073006F002C0020006D0069002000730065006E0074006F000A0071007500610073006900200065006D006F007A0069006F006E00610074006F002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Scusate per l’attesa.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 8,
      "index": 32,
      "offsetInSection": 3708,
      "rawDecodedUtf16Hex": "005300630075007300610074006500200070006500720020006C2019006100740074006500730061002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Lui è il maestro Bartrand, il barista.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3760,
      "rawDecodedUtf16Hex": "004C00750069002000E800200069006C0020006D00610065007300740072006F0020004200610072007400720061006E0064002C00200069006C00200062006100720069007300740061002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Sono il vecchio barista.<U+0010><U+0001>븁\nÈ un onore sapere che desidera bere nuovamente\nil mio caffè dopo ben dieci anni!<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "C’è un solo problema...<U+0010><U+0001>븁\nI chicchi li facevo tostare ricorrendo alla mossa\ndi un Pokémon, ma temo di essere ormai<U+0010><U+0001>븀\narrugginito come Allenatore...<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4076,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 154
    },
    {
      "displayText": "Quindi ho una richiesta per voi.<U+0010><U+0001>븁\nAffrontatemi in una lotta Pokémon, così potrò\nriprendere la mano.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Partecipo anche io, barista!<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4596,
      "rawDecodedUtf16Hex": "00500061007200740065006300690070006F00200061006E00630068006500200069006F002C00200062006100720069007300740061002100100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "<U+0010><U+0002>뷿&",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4664,
      "rawDecodedUtf16Hex": "00100002BDFF00260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Non sapevo fossi l’ero<U+0010><U+0003>ᄀÿ́eina che ha salvato la città...\nGuardandoti lottare ho ripreso la mano!<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Venite pure dentro. Vi preparerò un buon caffè.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4884,
      "rawDecodedUtf16Hex": "00560065006E00690074006500200070007500720065002000640065006E00740072006F002E00200056006900200070007200650070006100720065007200F200200075006E002000620075006F006E0020006300610066006600E8002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "<U+0010><U+0002>뷿)",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4988,
      "rawDecodedUtf16Hex": "00100002BDFF00290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "C’è un po’ di polvere, ma è tutto in buono stato.\nBasterà dare una bella pulita.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5000,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Già... Le servirò un caffè come quello di allora.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5172,
      "rawDecodedUtf16Hex": "0047006900E0002E002E002E0020004C0065002000730065007200760069007200F200200075006E0020006300610066006600E800200063006F006D00650020007100750065006C006C006F00200064006900200061006C006C006F00720061002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Vado a prepararmi, mi aspetti qui.\nSi metta pure comodo.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5280,
      "rawDecodedUtf16Hex": "005600610064006F00200061002000700072006500700061007200610072006D0069002C0020006D0069002000610073007000650074007400690020007100750069002E000A005300690020006D00650074007400610020007000750072006500200063006F006D006F0064006F002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Ah... Questo caffè è proprio come lo ricordavo...<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 45,
      "offsetInSection": 5404,
      "rawDecodedUtf16Hex": "00410068002E002E002E002000510075006500730074006F0020006300610066006600E8002000E8002000700072006F007000720069006F00200063006F006D00650020006C006F0020007200690063006F0072006400610076006F002E002E002E00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Quest’aroma penetrante... Me lo godrò usando\ntutti e cinque i sensi...<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Barista! È lo stesso caffè di dieci anni fa...\nAnzi, direi addirittura superiore!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Non potevo sperare in un complimento migliore.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5836,
      "rawDecodedUtf16Hex": "004E006F006E00200070006F007400650076006F0020007300700065007200610072006500200069006E00200075006E00200063006F006D0070006C0069006D0065006E0074006F0020006D00690067006C0069006F00720065002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Ma deve scusarmi, gentile signore...<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5940,
      "rawDecodedUtf16Hex": "004D0061002000640065007600650020007300630075007300610072006D0069002C002000670065006E00740069006C00650020007300690067006E006F00720065002E002E002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Cosa intende? Perché mai dovrebbe scusarsi per\nquesto caffè delizioso?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6024,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Devo rivelarle che sono stata io a prepararlo.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6176,
      "rawDecodedUtf16Hex": "004400650076006F00200072006900760065006C00610072006C0065002000630068006500200073006F006E006F00200073007400610074006100200069006F00200061002000700072006500700061007200610072006C006F002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Eeeeeh?!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 52,
      "offsetInSection": 6280,
      "rawDecodedUtf16Hex": "004500650065006500650068003F002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Sono stato assunto come barista, ma mi sono\nritirato dopo quanto è accaduto con il Team Flare.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 6308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Ma lei ha insistito tanto affinché il sapore del mio\ncaffè venisse mantenuto...<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 6508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Anche se la città è in continuo cambiamento,\nci sono cose che devono restare invariate.<U+0010><U+0001>븀\nE una di queste è il caffè del barista.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 55,
      "offsetInSection": 6676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "È naturale voler conservare tracce della gente\ne dei Pokémon che abitavano a Luminopoli,<U+0010><U+0001>븀\nche un giorno non ci saranno più.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 6948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "Capisco... Le sono grato per avermi permesso di\nbere nuovamente quel caffè che tanto amavo.<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 7208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Non so quando tornerò a Luminopoli, ma la\nprossima volta chiederò a lei di prepararmi<U+0010><U+0001>븀\nil suo caffè.<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "Volentieri. La aspetto.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7616,
      "rawDecodedUtf16Hex": "0056006F006C0065006E00740069006500720069002E0020004C00610020006100730070006500740074006F002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    }
