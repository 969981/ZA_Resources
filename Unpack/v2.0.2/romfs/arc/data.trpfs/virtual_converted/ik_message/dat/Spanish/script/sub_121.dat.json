  "messages": [
    {
      "displayText": "Tú eres <U+0010><U+0002>Ā<U+0000>, ¿verdad?\nTu cara me suena de los Juegos Z-A.<U+0010><U+0002>Ĕƍ",
      "escapedControlUnits": 5,
