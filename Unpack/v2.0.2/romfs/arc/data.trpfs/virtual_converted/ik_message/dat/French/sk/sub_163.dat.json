  "initialKey": 0,
  "messages": [
    {
      "displayText": "Mmm... C’est pas la joie, Extra Illumis,\nquand même...<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 396,
      "rawDecodedUtf16Hex": "004D006D006D002E002E002E00200043201900650073007400200070006100730020006C00610020006A006F00690065002C00200045007800740072006100200049006C006C0075006D00690073002C000A007100750061006E00640020006D00EA006D0065002E002E002E00100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Je suis d’accord. Ce ne sont que de vulgaires\nbureaux, comme on en trouve dans notre Illumis.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
