      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Allez m<U+0010><U+0003>ᄀÿࠈon petita petite <U+0010><U+0002>Ā<U+0000>,\nmontre-nous ce que tu sais faire !",
      "escapedControlUnits": 5,
