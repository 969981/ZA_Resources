      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1296,
      "rawDecodedUtf16Hex": "004F006E00200073006500200063006F006E00630065006E007400720065002000210020004320190065007300740020007000610073002000660069006E006900200021000A0049006C006C0075006D0069007300200063006F006D007000740065002000730075007200200074006F0069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Tant de chemin parcouru !\nT’y es presque !",
