      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Attention, te déconcentre pas !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "0041007400740065006E00740069006F006E002C0020007400650020006400E90063006F006E00630065006E0074007200650020007000610073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Dommage, hé hé hé !\nC’est un cul-de-sac !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1140,
