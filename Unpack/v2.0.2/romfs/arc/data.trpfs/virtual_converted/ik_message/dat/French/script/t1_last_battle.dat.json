      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "00540061006E00740020006400650020006300680065006D0069006E00200070006100720063006F00750072007500200021000A00542019007900200065007300200070007200650073007100750065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
