      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "쫀도기는 진화하면\n바우첼이 된대!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
