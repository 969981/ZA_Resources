      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "남들은 아는 쫀도기의 귀여운 모습을\n나만 모르는 건 너무 억울하잖아!<U+0010><U+0002>Ĕǃ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 2924,
