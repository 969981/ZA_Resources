      "rawDecodedUtf16Hex": "CAC0B3C5002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, 정말 고마워!<U+0010><U+0002>Ĕǃ",
