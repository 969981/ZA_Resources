      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Se vuoi lottare contro il mio Honedge, metti\nin squadra solo un Pupitar e nient’altro!<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
