      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Mmmh... Allora la diagnosi è semplice.\nSignifica che il filo della sua lama si è smussato!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
