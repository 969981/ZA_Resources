      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "C’è un modo solo per affilare Honedge,\nil Pokémon Armabianca...<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
