      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Prends bien soin de Magearna.<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3784,
      "rawDecodedUtf16Hex": "005000720065006E006400730020006200690065006E00200073006F0069006E0020006400650020004D00610067006500610072006E0061002E001000020114000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Et accepte également cette Méga-Gemme.<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 3852,
      "rawDecodedUtf16Hex": "0045007400200061006300630065007000740065002000E900670061006C0065006D0065006E00740020006300650074007400650020004D00E900670061002D00470065006D006D0065002E001000020114000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Je compte sur toi pour continuer à prendre soin\nde notre belle ville...<U+0010><U+0001>븀\n... et de veiller sur <U+0010><U+0002>Ƌ<U+0001>.<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3940,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
