      "index": 22,
      "offsetInSection": 3232,
      "rawDecodedUtf16Hex": "002A007000730068006800680074002A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Oh ! Magearna s’est réveillé !<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3252,
      "rawDecodedUtf16Hex": "004F0068002000210020004D00610067006500610072006E00610020007320190065007300740020007200E9007600650069006C006C00E900200021001000020114000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "C’est tout bonnement merveilleux...<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3324,
      "rawDecodedUtf16Hex": "0043201900650073007400200074006F0075007400200062006F006E006E0065006D0065006E00740020006D00650072007600650069006C006C006500750078002E002E002E001000020114000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "M<U+0010><U+0003>ᄀÿĂona ch<U+0010><U+0003>ᄀÿ̂erère <U+0010><U+0002>Ā<U+0000>...<U+0010><U+0001>븁\nPrends Magearna et montre-lui à quel point\nle monde a changé pendant son long sommeil.<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Vous recevez Magearna !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3656,
      "rawDecodedUtf16Hex": "0056006F007500730020007200650063006500760065007A0020004D00610067006500610072006E0061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Oh, tes Boîtes semblent pleines...<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 3704,
