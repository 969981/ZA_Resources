      "index": 7,
      "offsetInSection": 536,
      "rawDecodedUtf16Hex": "5982679C5BF653EF59227528683C9B255C6C602776847269740662DB5F0F000A653B64CA516850CF50B3900168AFFF0C8AAA4E0D5B9A5C3180FD4FEE597D4E86FF01001000020114015A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
