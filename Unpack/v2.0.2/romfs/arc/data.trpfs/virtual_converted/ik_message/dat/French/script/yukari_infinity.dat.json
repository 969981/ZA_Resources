      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "00432019006500730074002000700061007200740069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Je vais m’arrêter là.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1976,
      "rawDecodedUtf16Hex": "004A0065002000760061006900730020006D201900610072007200EA0074006500720020006C00E0002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Nous avons seulement combattu <U+0010><U+0003>ȅ<U+0002>  fois...\nSouhaites-tu vraiment abandonner maintenant ?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
