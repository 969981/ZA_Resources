      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "00460069006E0061006C0065006D0065006E0074002C0020006A00650020007600610069007300200063006F006E00740069006E007500650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Oui, ça suffit pour aujourd’hui.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2272,
      "rawDecodedUtf16Hex": "004F00750069002C002000E70061002000730075006600660069007400200070006F00750072002000610075006A006F0075007200642019006800750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Quelle déception ! Dire que les Grands Jeux de\nVioline ∞ touchent déjà à leur fin...<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Cette fois-ci, tu as remporté\n<U+0010><U+0003>ȅ<U+0002>  combat<U+0010><U+0003>ᄁ<U+0002>଀s d’affilée !<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2520,
