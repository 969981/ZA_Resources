      "rawDecodedUtf16Hex": "005700610072007400650020006200690074007400650020006B00750072007A002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Bitte beeil dich! Ich will wissen, was mein\nKranoviz draufhat!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 6832,
      "rawDecodedUtf16Hex": "0042006900740074006500200062006500650069006C0020006400690063006800210020004900630068002000770069006C006C002000770069007300730065006E002C00200077006100730020006D00650069006E000A004B00720061006E006F00760069007A002000640072006100750066006800610074002100100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Zeig <U+0010><U+0004>ᄀÿဎ<U+0000>diesem Trainerdieser Trainerin die Kraft, mit der du sogar\ndas Meer überqueren konntest!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 6968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
