      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 7176,
      "rawDecodedUtf16Hex": "00100002BDFF00390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Kranoviz... Wir haben zwar verloren, aber du bist\ntrotzdem der absolute Wahnsinn!<U+0010><U+0001>븁\nIch werde alles geben, um als Trainer mit dir\nmithalten zu können!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7188,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 156
    },
    {
      "displayText": "Boah, bist du stark, Kranoviz!<U+0010><U+0001>븁\nIch werde alles geben, um als Trainer mit dir\nmithalten zu können!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Kraaa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 7712,
      "rawDecodedUtf16Hex": "004B007200610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Ich werde diesen Tag nie vergessen!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 7728,
