      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Echt vielen, vielen Dank!!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 7808,
      "rawDecodedUtf16Hex": "00450063006800740020007600690065006C0065006E002C0020007600690065006C0065006E002000440061006E006B0021002100100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
