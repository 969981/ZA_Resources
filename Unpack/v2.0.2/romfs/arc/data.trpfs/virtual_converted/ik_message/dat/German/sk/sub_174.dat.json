      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 6768,
      "rawDecodedUtf16Hex": "004C006F0073002000670065006800742019007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Warte bitte kurz...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
