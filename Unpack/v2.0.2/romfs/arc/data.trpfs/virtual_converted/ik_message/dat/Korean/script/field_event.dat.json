      "rawDecodedUtf16Hex": "002E002E002EC5B4B77C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "여기서는 <U+0010><U+0002>ā<U+0000><U+0010><U+0002>ᤀ<U+0002> 탈 수 없다!",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1344,
      "rawDecodedUtf16Hex": "C5ECAE30C11CB2940020001000020101000000100002190000020020D0C80020C2180020C5C6B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "여기서는 <U+0010><U+0002>Ă<U+0000><U+0010><U+0002>ᤀ<U+0002> 탈 수 없다!",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "C5ECAE30C11CB2940020001000020102000000100002190000020020D0C80020C2180020C5C6B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "포켓몬 박스가 가득 찼다!\n...다음에 다시 오자.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1432,
      "rawDecodedUtf16Hex": "D3ECCF13BAAC0020BC15C2A4AC000020AC00B4DD0020CC3CB2E40021000A002E002E002EB2E4C74CC5D00020B2E4C2DC0020C624C790002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001> <U+0010><U+0002>ĉ<U+0001>에\n현재 상황을 적었다!",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
