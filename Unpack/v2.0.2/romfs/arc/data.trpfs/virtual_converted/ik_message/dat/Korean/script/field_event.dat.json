      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "B1240020ADFCCC98C5D0000A0010000201010002C7580020BC18C751C7740020C788C5B4002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
