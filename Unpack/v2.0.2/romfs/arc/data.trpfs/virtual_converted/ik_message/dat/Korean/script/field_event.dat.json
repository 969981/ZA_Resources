      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001> 황급히\n모두가 있는 곳으로 돌아갔다!",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "001000020100000000100002190000010020D669AE09D788000ABAA8B450AC000020C788B2940020ACF3C73CB85C0020B3CCC544AC14B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "든든 에너지가 다 떨어진 것 같다!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1740,
