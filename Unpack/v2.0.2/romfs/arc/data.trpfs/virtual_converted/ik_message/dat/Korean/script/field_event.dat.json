      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "이차원 미르에서 탈출합니다.\n괜찮겠습니까?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1780,
      "rawDecodedUtf16Hex": "C774CC28C6D00020BBF8B974C5D0C11C0020D0C8CD9CD569B2C8B2E4002E000AAD1CCC2EACA0C2B5B2C8AE4C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "예",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "C6080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 2
    },
    {
      "displayText": "아니요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "C544B2C8C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
