      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001>\n<U+0010><U+0002>ĉ<U+0001><U+0010><U+0002>ᤀ<U+0002> 썼다!",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1284,
