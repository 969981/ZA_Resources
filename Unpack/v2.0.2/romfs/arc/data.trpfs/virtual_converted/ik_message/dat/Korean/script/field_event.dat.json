      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "BA54AC00ACE8B8E8ADF8AC00000AACF5ACA9D5740020C654B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "메가갑주무사가\n공격해 왔다!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "BA54AC00AC11C8FCBB34C0ACAC00000AACF5ACA9D5740020C654B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "메가스코빌런이\n공격해 왔다!",
