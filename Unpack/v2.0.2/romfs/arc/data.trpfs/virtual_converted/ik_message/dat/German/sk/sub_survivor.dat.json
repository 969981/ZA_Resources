      "index": 7,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "004400650069006E002000520065006B006F007200640020006C0069006500670074002000620065006900200010000202010002003A0010000202010003002C00100002020100040021000A004E0061002C0020006B0061006E006E00730074002000640075002000640065006E0020006B006E00610063006B0065006E003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Du hast bereits <U+0010><U+0003>ȃ<U+0005><U+0000> Sekunden ausgehalten!<U+0010><U+0002>Ĕ<U+000F>",
