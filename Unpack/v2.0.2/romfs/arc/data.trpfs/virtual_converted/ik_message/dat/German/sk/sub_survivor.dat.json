      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Komm wieder, wenn du ready für ’ne weitere\nRunde des Panik-Simulators bist!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
