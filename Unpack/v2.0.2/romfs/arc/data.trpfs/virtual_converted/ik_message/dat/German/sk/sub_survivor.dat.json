      "index": 20,
      "offsetInSection": 2572,
      "rawDecodedUtf16Hex": "004800E4003F002000480061007300740020006400750020006700650072006100640065002000100002BD0A000400530070005F00310020006700650064007200FC0063006B0074003F000A00470069006200730074002000640075002000650063006800740020007300630068006F006E0020006100750066003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
