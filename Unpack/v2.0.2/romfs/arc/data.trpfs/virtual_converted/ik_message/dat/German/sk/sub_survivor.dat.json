      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Noch <U+0010><U+0002>＀<U+0006>30 Sekunden<U+0010><U+0002>＀<U+0000>!<U+0010><U+0002>Ĕ<U+000F>",
