    {
      "displayText": "Dein Rekord liegt bei <U+0010><U+0002>ȁ<U+0002>:<U+0010><U+0002>ȁ<U+0003>,<U+0010><U+0002>ȁ<U+0004>!\nNa, kannst du den knacken?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 12,
