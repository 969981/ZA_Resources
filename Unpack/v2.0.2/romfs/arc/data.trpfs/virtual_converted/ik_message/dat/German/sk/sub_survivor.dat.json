      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Jetzt gibt’s eine schockierende Ladung Spaß beim\nPanik-Simulator!<U+0010><U+0002>Ĕ<U+000F>",
