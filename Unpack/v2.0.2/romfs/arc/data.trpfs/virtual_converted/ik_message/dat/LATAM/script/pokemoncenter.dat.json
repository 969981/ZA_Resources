      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 4644,
      "rawDecodedUtf16Hex": "005000720069006D00650072006F002000760061006D006F0073002000610020006400650076006F006C007600650072006C00650020006C006100200065006E00650072006700ED006100200061002000740075000A00650071007500690070006F00200050006F006B00E9006D006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "No olvides visitar un Centro Pokémon cuando\nlos miembros de tu equipo pierdan PS.<U+0010><U+0001>븁\nY aprovechando que estás aquí, si necesitas\ncomprar pociones solo tienes que decírmelo.<U+0010><U+0001>븁\n¡Buena suerte!",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 4764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 191
    },
    {
      "displayText": "Tu<U+0010><U+0003>ᄁýሐ Pokémon ya estás Pokémon ya están en buena forma.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
