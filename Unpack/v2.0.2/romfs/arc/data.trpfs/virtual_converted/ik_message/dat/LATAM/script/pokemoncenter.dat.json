      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "¡Gracias por registrar tu cumpleaños!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
