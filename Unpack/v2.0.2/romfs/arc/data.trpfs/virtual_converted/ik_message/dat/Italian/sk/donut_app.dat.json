      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 112,
      "offsetInSection": 7492,
      "rawDecodedUtf16Hex": "00540072006F007600610020006C006500200064006900730074006F007200730069006F006E0069002000730075006C006C00610020006D00610070007000610020006500640020006500730070006C006F00720061000A006C00650020004C0075006D0069006E006F0070006F006C0069002000640069006D0065006E00730069006F006E0061006C006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
