      "offsetInSection": 7088,
      "rawDecodedUtf16Hex": "004F00720061002000700075006F0069002000750073006100720065002000730065007400740065002000620061006300630068006500200070006500720020007000720065007000610072006100720065000A006C00650020006300690061006D00620065006C006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Mi permetto di usare il Burro dimensionale che\nti sei procurat<U+0010><U+0003>ᄀÿāoa, signor<U+0010><U+0003>ᄀÿĀa <U+0010><U+0002>Ā<U+0000>.",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 110,
      "offsetInSection": 7200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
