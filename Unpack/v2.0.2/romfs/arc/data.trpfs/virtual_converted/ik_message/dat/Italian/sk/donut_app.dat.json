      "index": 104,
      "offsetInSection": 6364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Ora puoi usare cinque bacche per preparare\nle ciambelle!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 105,
      "offsetInSection": 6528,
      "rawDecodedUtf16Hex": "004F00720061002000700075006F0069002000750073006100720065002000630069006E007100750065002000620061006300630068006500200070006500720020007000720065007000610072006100720065000A006C00650020006300690061006D00620065006C006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Mi permetto di usare il Burro ultra che ti sei\nprocurat<U+0010><U+0003>ᄀÿāoa, signor<U+0010><U+0003>ᄀÿĀa <U+0010><U+0002>Ā<U+0000>.",
