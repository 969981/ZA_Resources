      "rawDecodedUtf16Hex": "00C8002000760065006E007500740061002000620065006E0069007300730069006D006F0021002000560075006F0069002000700072006500700061007200610072006E006500200061006C007400720065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
