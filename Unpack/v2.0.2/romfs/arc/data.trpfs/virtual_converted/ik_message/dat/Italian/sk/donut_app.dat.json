      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 101,
      "offsetInSection": 5960,
      "rawDecodedUtf16Hex": "00530065002000760075006F0069002000700072006500700061007200610072006500200075006E00610020006300690061006D00620065006C006C0061002C00200074006900200073006500720076006900720061006E006E006F000A007400720065002000620061006300630068006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Mi permetto di usare il Burro super che ti sei\nprocurat<U+0010><U+0003>ᄀÿāoa, signor<U+0010><U+0003>ᄀÿĀa <U+0010><U+0002>Ā<U+0000>.",
