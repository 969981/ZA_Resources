      "offsetInSection": 4892,
      "rawDecodedUtf16Hex": "004E006F006E002000730065006D0062007200610020007400750020006100620062006900610020007300700061007A0069006F002000700065007200200061006C0074007200650020006300690061006D00620065006C006C0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
