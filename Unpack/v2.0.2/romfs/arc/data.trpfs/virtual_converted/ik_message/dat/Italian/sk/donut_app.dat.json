      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 111,
      "offsetInSection": 7380,
      "rawDecodedUtf16Hex": "004F00720061002000700075006F00690020007500730061007200650020006F00740074006F002000620061006300630068006500200070006500720020007000720065007000610072006100720065000A006C00650020006300690061006D00620065006C006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
