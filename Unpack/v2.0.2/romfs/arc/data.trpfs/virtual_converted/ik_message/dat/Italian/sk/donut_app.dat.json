      "offsetInSection": 4756,
      "rawDecodedUtf16Hex": "004E006F006E00200070006F00730073006F00200070007200650070006100720061007200650020006E0075006C006C006100200063006F006E002000710075006500730074006F000A0061006200620069006E0061006D0065006E0074006F00200064006900200069006E006700720065006400690065006E00740069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Non sembra tu abbia spazio per altre ciambelle.",
