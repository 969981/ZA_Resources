      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Prepara con la ricetta della glassata",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 99,
      "offsetInSection": 5856,
      "rawDecodedUtf16Hex": "005000720065007000610072006100200063006F006E0020006C006100200072006900630065007400740061002000640065006C006C006100200067006C0061007300730061007400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Lascia stare",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
