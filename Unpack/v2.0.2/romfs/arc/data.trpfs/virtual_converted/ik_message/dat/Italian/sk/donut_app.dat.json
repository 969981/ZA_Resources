      "flagsUpper16": 4,
      "index": 107,
      "offsetInSection": 6812,
      "rawDecodedUtf16Hex": "004F00720061002000700075006F00690020007500730061007200650020007300650069002000620061006300630068006500200070006500720020007000720065007000610072006100720065000A006C00650020006300690061006D00620065006C006C006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Mi permetto di usare il Burro master che ti sei\nprocurat<U+0010><U+0003>ᄀÿāoa, signor<U+0010><U+0003>ᄀÿĀa <U+0010><U+0002>Ā<U+0000>.",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 108,
      "offsetInSection": 6920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
