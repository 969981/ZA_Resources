    {
      "displayText": "¡Hola, muchach<U+0010><U+0003>ᄀÿāoa! ¿Qué, ya te decidiste a\ncomprar mi Pan de Naria?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
