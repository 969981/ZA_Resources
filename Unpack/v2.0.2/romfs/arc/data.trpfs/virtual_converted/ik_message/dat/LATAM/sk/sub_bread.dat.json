    },
    {
      "displayText": "Eso sí, es una edición limitada y solo se puede\ncomprar un pan al día por persona.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 544,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "¡Pan de Naria! ¡Me lo quitan de las manos!\nDelicioso y adorable, ¿qué más puedes pedir?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¡Al rico Pan de Naria! ¡Es tan bonito que es difícil\ncomérselo! Son <U+E300>1,300 la unidad. ¿Quieres uno?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "¡Me llevo uno!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "00A1004D00650020006C006C00650076006F00200075006E006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "No, gracias",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "004E006F002C002000670072006100630069006100730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "¡Un placer hacer negocios contigo!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "00A10055006E00200070006C00610063006500720020006800610063006500720020006E00650067006F00630069006F007300200063006F006E007400690067006F002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Te falta dinero, muchach<U+0010><U+0003>ᄀÿāoa!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "00A100540065002000660061006C00740061002000640069006E00650072006F002C0020006D00750063006800610063006800100003110000FF0101006F0061002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Parece que no puedes comprar nada más.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "00500061007200650063006500200071007500650020006E006F002000700075006500640065007300200063006F006D00700072006100720020006E0061006400610020006D00E10073002E00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Con lo guapa que sale mi nieta, ¿de verdad no\nlo quieres? Bueno, ¡tú te lo pierdes!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
