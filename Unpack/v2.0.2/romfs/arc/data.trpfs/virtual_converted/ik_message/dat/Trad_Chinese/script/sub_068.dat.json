      "rawDecodedUtf16Hex": "9084662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "這樣啊……<U+0010><U+0002>ĔŦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "90196A23554A2026202600100002011401660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "太棒啦！\n那我們這就開始吧！<U+0010><U+0002>ĔŦ",
