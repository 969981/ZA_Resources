      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Allora, dov’è questo fossile?<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "0041006C006C006F00720061002C00200064006F0076201900E8002000710075006500730074006F00200066006F007300730069006C0065003F00100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Ah, mi hai portato un’Ambra antica!<U+0010><U+0001>븁\nNiente male, ma per adesso vorrei rigenerare un\nPokémon da uno dei due fossili che ti avevo detto.<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
