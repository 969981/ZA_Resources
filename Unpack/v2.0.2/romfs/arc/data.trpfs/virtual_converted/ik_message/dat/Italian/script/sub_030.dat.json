    {
      "displayText": "Oh, sei tu! Non mi dire che hai comprato il fossile!<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1484,
