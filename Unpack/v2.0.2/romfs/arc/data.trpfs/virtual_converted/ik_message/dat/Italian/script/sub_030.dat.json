      "escapedControlUnits": 9,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2116,
      "rawDecodedUtf16Hex": "00480061006900200063006F006D0070007200610074006F002000100003150200020000001000020109000200210020004700720061007A00690065002100100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Allora mi metto al lavoro. Non ci vorrà molto.<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2188,
      "rawDecodedUtf16Hex": "0041006C006C006F007200610020006D00690020006D006500740074006F00200061006C0020006C00610076006F0072006F002E0020004E006F006E00200063006900200076006F0072007200E00020006D006F006C0074006F002E00100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Dal Fossilmascella ho rigenerato... Tyrunt!<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2292,
      "rawDecodedUtf16Hex": "00440061006C00200046006F007300730069006C006D0061007300630065006C006C006100200068006F00200072006900670065006E0065007200610074006F002E002E002E00200054007900720075006E0074002100100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Dal Fossilpinna ho rigenerato... Amaura!<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2388,
