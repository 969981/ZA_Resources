  "initialKey": 0,
  "messages": [
    {
      "displayText": "Welcome, welcome—\nstep right in! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "00570065006C0063006F006D0065002C002000770065006C0063006F006D00652014000A007300740065007000200072006900670068007400200069006E0021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "At Sushi High Roller, our food rolls right onto the\ntongue!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "004100740020005300750073006800690020004800690067006800200052006F006C006C00650072002C0020006F0075007200200066006F006F006400200072006F006C006C00730020007200690067006800740020006F006E0074006F0020007400680065000A0074006F006E00670075006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "I know sushi goes bad quickly,\nbut no need to wolf it down.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "00490020006B006E006F007700200073007500730068006900200067006F00650073002000620061006400200071007500690063006B006C0079002C000A0062007500740020006E006F0020006E00650065006400200074006F00200077006F006C006600200069007400200064006F0077006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "I ate too fast and\nalmost choked!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "0049002000610074006500200074006F006F0020006600610073007400200061006E0064000A0061006C006D006F00730074002000630068006F006B0065006400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Did you know that the fish they use for the sushi\nhere was caught in some far-off region?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Wow! You’re so knowledgeable about these\nthings!<U+0010><U+0001>븁\n*mutter* The fish is from Azure Bay, though...",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Folks are hungry for\nfood AND battles here!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "0046006F006C006B00730020006100720065002000680075006E00670072007900200066006F0072000A0066006F006F006400200041004E004400200062006100740074006C006500730020006800650072006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "I’m no expert, but is this\nplace meant to be chic?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "00492019006D0020006E006F0020006500780070006500720074002C002000620075007400200069007300200074006800690073000A0070006C0061006300650020006D00650061006E007400200074006F00200062006500200063006800690063003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "If you want to eat with your hands,\nwatch how the chef holds sushi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1204,
      "rawDecodedUtf16Hex": "0049006600200079006F0075002000770061006E007400200074006F00200065006100740020007700690074006800200079006F00750072002000680061006E00640073002C000A0077006100740063006800200068006F007700200074006800650020006300680065006600200068006F006C0064007300200073007500730068006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "I love that sushi can also be\nenjoyed in casual settings!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "00490020006C006F0076006500200074006800610074002000730075007300680069002000630061006E00200061006C0073006F002000620065000A0065006E006A006F00790065006400200069006E002000630061007300750061006C002000730065007400740069006E0067007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "How did anyone even come up\nwith the idea of sushi?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1456,
      "rawDecodedUtf16Hex": "0048006F0077002000640069006400200061006E0079006F006E00650020006500760065006E00200063006F006D0065002000750070000A00770069007400680020007400680065002000690064006500610020006F0066002000730075007300680069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "It tastes a bit different from the\nsushi at that place in Alola...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "00490074002000740061007300740065007300200061002000620069007400200064006900660066006500720065006E0074002000660072006F006D0020007400680065000A007300750073006800690020006100740020007400680061007400200070006C00610063006500200069006E00200041006C006F006C0061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "I’m training my grandson’s palate\nso he can surpass me one day...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "00492019006D00200074007200610069006E0069006E00670020006D00790020006700720061006E00640073006F006E20190073002000700061006C006100740065000A0073006F002000680065002000630061006E002000730075007200700061007300730020006D00650020006F006E00650020006400610079002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "When I’m older, I wanna be a\nTrainer and a sushi chef too!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "005700680065006E002000492019006D0020006F006C006400650072002C00200049002000770061006E006E006100200062006500200061000A0054007200610069006E0065007200200061006E0064002000610020007300750073006800690020006300680065006600200074006F006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Please take your time\nand enjoy your meal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "0050006C0065006100730065002000740061006B006500200079006F00750072002000740069006D0065000A0061006E006400200065006E006A006F007900200079006F007500720020006D00650061006C002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "I’m not quite sure whether the taste of the food\nhere merits the price.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2036,
      "rawDecodedUtf16Hex": "00492019006D0020006E006F0074002000710075006900740065002000730075007200650020007700680065007400680065007200200074006800650020007400610073007400650020006F0066002000740068006500200066006F006F0064000A00680065007200650020006D006500720069007400730020007400680065002000700072006900630065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Sushi rolls... What an enchanting combination of\nflavors...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2180,
      "rawDecodedUtf16Hex": "0053007500730068006900200072006F006C006C0073002E002E002E0020005700680061007400200061006E00200065006E006300680061006E00740069006E006700200063006F006D00620069006E006100740069006F006E0020006F0066000A0066006C00610076006F00720073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "An appetite for trying out new ingredients is vital\nin battles too, don’t you think?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2300,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "For sure! People should enjoy battling even when\ntheir opponent serves up something unexpected.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2472,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "So what wouldja like?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "0053006F0020007700680061007400200077006F0075006C0064006A00610020006C0069006B0065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "It’s not me—it’s the sushi!\nThey just end up in my mouth!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2708,
      "rawDecodedUtf16Hex": "00490074201900730020006E006F00740020006D00652014006900742019007300200074006800650020007300750073006800690021000A00540068006500790020006A00750073007400200065006E006400200075007000200069006E0020006D00790020006D006F00750074006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "When you’re having sushi, it’s\nhard to know when to stop!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2824,
      "rawDecodedUtf16Hex": "005700680065006E00200079006F007520190072006500200068006100760069006E0067002000730075007300680069002C00200069007420190073000A006800610072006400200074006F0020006B006E006F00770020007700680065006E00200074006F002000730074006F007000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Don’t eat so much\nthat you get sleepy!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2940,
      "rawDecodedUtf16Hex": "0044006F006E20190074002000650061007400200073006F0020006D007500630068000A007400680061007400200079006F0075002000670065007400200073006C006500650070007900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "My sinuses are on FIRE!\nWhy’s this so spicy?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3020,
      "rawDecodedUtf16Hex": "004D0079002000730069006E007500730065007300200061007200650020006F006E002000460049005200450021000A005700680079201900730020007400680069007300200073006F002000730070006900630079003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "That’ll be the wasabi, dear. I hear\nthey use it as a sauce in Paldea.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3112,
      "rawDecodedUtf16Hex": "00540068006100742019006C006C00200062006500200074006800650020007700610073006100620069002C00200064006500610072002E0020004900200068006500610072000A007400680065007900200075007300650020006900740020006100730020006100200073006100750063006500200069006E002000500061006C006400650061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "With so many Pokémon in the city, it’s a golden\nopportunity to do business.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "The contract negotiations went well, so we’re\nhere to celebrate!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3404,
      "rawDecodedUtf16Hex": "00540068006500200063006F006E007400720061006300740020006E00650067006F00740069006100740069006F006E0073002000770065006E0074002000770065006C006C002C00200073006F002000770065201900720065000A006800650072006500200074006F002000630065006C00650062007200610074006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "We’re rolling out Sushi High\nRoller overseas as well!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3536,
      "rawDecodedUtf16Hex": "0057006520190072006500200072006F006C006C0069006E00670020006F0075007400200053007500730068006900200048006900670068000A0052006F006C006C006500720020006F0076006500720073006500610073002000610073002000770065006C006C00210000",
      "trailingZeroPaddingUnits": 1,
