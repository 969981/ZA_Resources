      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "以宝可梦训练家的身份和我认真打一场！\n各自都只带1只路卡利欧来全力对决！！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "4EE55B9D53EF68A68BAD7EC35BB676848EAB4EFD548C62118BA4771F62534E00573AFF01000A540481EA90FD53EA5E26003153EA8DEF536152296B2767655168529B5BF951B3FF01FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "等到你让队伍里只有1只全力以赴的\n路卡利欧以后，就来和我说一声吧！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "7B4952304F608BA9961F4F0D91CC53EA6709003153EA5168529B4EE58D747684000A8DEF536152296B274EE5540EFF0C5C316765548C62118BF44E0058F05427FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "等你好久啦～！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "7B494F60597D4E455566FF5EFF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
