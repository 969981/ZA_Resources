      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "OK！\n那等你有空了要来找我哦。<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 324,
