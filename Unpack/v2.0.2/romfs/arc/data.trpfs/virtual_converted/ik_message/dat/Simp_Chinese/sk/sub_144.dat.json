      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "8BF77B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我会超级认真地和你全力以赴地打一场哦。\n所以等你做好心理准备后再来挑战吧！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 724,
