      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "好！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 704,
      "rawDecodedUtf16Hex": "597DFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
