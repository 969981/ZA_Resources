      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "谢谢！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 368,
      "rawDecodedUtf16Hex": "8C228C22FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "我想请你帮的忙就是……<U+0010><U+0002>Ĕƒ",
