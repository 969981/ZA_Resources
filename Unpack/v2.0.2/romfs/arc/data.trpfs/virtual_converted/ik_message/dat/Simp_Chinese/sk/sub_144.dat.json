      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "53EA80FD8BA9003153EA8DEF536152296B2753C24E0E5BF9621854E6FF0100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "看来你准备好了呀。\n那就来打宝可梦对战咯！<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
