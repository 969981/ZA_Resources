      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "冰哆哆！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "51B054C654C6FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
