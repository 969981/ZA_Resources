      "index": 13,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "54C7566220262026001000020114018B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "好巨大啊！<U+0010><U+0002>ĔƋ",
