      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B367095E36845780FD80CC003496BB51B05BF67684000A0058004C5C3A5BF851B05CA9602A55CEFF1F001000020114018B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "請讓我看看能背4隻冰寶的\nXL尺寸超大冰岩怪！<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "8ACB8B936211770B770B80FD80CC003496BB51B05BF67684000A0058004C5C3A5BF88D85592751B05CA9602AFF01001000020114018B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "有點不夠大隻……<U+0010><U+0001>븁\n必須要有XL尺寸大，\n不然大概沒辦法背4隻冰寶。<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
