      "index": 21,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "54A6FF1F000A54A654A654A654A6FF1F001000020114018B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "天啊天啊天啊！\n好驚人的按讚數！<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "5929554A5929554A5929554AFF01000A597D9A5A4EBA768463098B9A6578FF01001000020114018B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "原來我想看到的景象\n也是大家想看的景象啊！<U+0010><U+0002>ĔƋ",
