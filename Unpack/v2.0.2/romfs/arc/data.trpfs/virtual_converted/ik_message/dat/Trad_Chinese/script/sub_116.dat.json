      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "很抱歉，\n但洗翠的樣子的冰岩怪就是不對。<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 816,
