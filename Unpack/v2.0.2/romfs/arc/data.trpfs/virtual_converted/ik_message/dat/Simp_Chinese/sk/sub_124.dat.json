      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "621190014F604E004E2A96F74E188FDB531677F300593002001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>，\n让我们有缘再见吧。<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
