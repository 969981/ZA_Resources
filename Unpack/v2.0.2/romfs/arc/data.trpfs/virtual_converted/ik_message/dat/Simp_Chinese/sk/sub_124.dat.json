      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "这是我们的一点心意。\n我送你一个雷丘进化石X。<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
