      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "哎！好想赶快展示\n我们两个的超级雷丘组合。<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
