      "rawDecodedUtf16Hex": "4EC04E488BDD9898FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "我们正说到雷丘的事情，\n在感谢你呢。<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
