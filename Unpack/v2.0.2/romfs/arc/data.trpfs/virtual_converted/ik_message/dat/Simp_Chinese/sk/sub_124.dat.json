      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "哎呀，<U+0010><U+0002>Ā<U+0000>。<U+0010><U+0002>Ĕĥ",
