      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1692,
      "rawDecodedUtf16Hex": "54CE5440FF0C0010000201000000300200100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "好巧啊！\n我们正好聊到了关于你的话题。<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
