      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Combatimos? Mis Cyclizar están listos para\nganar.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1740,
      "rawDecodedUtf16Hex": "00BF0043006F006D0062006100740069006D006F0073003F0020004D006900730020004300790063006C0069007A00610072002000650073007400E1006E0020006C006900730074006F007300200070006100720061000A00670061006E00610072002E00100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Muy bien",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1852,
      "rawDecodedUtf16Hex": "004D007500790020006200690065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Dame un momento",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
