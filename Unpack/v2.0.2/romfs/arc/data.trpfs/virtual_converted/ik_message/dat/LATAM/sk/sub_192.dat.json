      "offsetInSection": 1872,
      "rawDecodedUtf16Hex": "00440061006D006500200075006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Si me haces esperar mucho, nos vamos de\naquí para ir a correr y seguir entrenando.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "¡He aquí el inicio de una leyenda: los Cyclizar más\nrápidos y fuertes habidos y por haber!<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
