      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "¡Son bien fuertes! A lo mejor es que todavía nos\nhace falta más entrenamiento.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2356,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Toma, quédate con esta MT.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2524,
      "rawDecodedUtf16Hex": "0054006F006D0061002C00200071007500E9006400610074006500200063006F006E002000650073007400610020004D0054002E00100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Usa <U+0010><U+0002>＀<U+0006>Carga de Fuego<U+0010><U+0002>＀<U+0000> para atacar y aumentar\nla velocidad de desplazamiento de tu Pokémon.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 8,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 2588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "No sabes qué divertido resulta que se vuelva más\nveloz y marear al rival yendo de un lado para otro.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
