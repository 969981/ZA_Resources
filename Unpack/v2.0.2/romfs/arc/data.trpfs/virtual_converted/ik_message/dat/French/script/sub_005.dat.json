      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Aaah... Je n’ai rien pu faire...<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "0041006100610068002E002E002E0020004A00650020006E2019006100690020007200690065006E002000700075002000660061006900720065002E002E002E00100002011401290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Ça ne change rien au fait que les Pokémon\nde type Fée sont formidables.<U+0010><U+0001>븁\nIls sont immunisés aux attaques de type Dragon !<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Mais bien sûr, ils ont aussi leurs points faibles.<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2176,
      "rawDecodedUtf16Hex": "004D0061006900730020006200690065006E0020007300FB0072002C00200069006C00730020006F006E00740020006100750073007300690020006C006500750072007300200070006F0069006E0074007300200066006100690062006C00650073002E00100002011401290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "C’est inévitable, quand on se spécialise dans\nun type, on développe certaines faiblesses...<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Mais il en faut plus pour me décourager !\nJe suis une fan inconditionnelle du type Fée !<U+0010><U+0002>Ĕĩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2480,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
