      "index": 8,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 60,
      "utf16Units": 119
    },
    {
      "displayText": "Ｆという<U+0010>\t！<U+0002><U+0004>人物じんぶつ人物\nなぜジガルデ１０％と<U+0010>\t！<U+0002><U+0004>一緒いっしょ一緒なんだろ？<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 2360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 51,
      "utf16Units": 101
    },
    {
      "displayText": "<U+0010><U+000B>！<U+0002><U+0006>順調じゅんちょう順調にＺＡロワイヤルの\nランクをあげているようだね<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 7,
