      "utf16Units": 87
    },
    {
      "displayText": "<U+0010><U+0006>！<U+0001><U+0002>楽たの楽しそうにしているもこおと\nスーツを<U+0010><U+0005>！<U+0001><U+0001>着き着た<U+0010>\t！<U+0002><U+0004>男性だんせい男性の<U+0010>\t！<U+0002><U+0004>写真しゃしん写真",
