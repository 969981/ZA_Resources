      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Prego, prego! Il pane che si vende qui è buono\ne bello!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 600,
      "rawDecodedUtf16Hex": "0050007200650067006F002C00200070007200650067006F002100200049006C002000700061006E00650020006300680065002000730069002000760065006E006400650020007100750069002000E8002000620075006F006E006F000A0065002000620065006C006C006F002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Prego, prego! Il Pan di Canary è tanto grazioso\nche pare uno spreco mangiarlo!<U+0010><U+0001>븀\nSono 1.300 <U+E300>, lo vuoi?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
