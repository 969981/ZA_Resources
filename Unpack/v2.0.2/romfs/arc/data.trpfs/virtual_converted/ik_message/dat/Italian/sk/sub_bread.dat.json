      "index": 7,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "004700720061007A0069006500200065002000610072007200690076006500640065007200630069002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
