      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Ma ne puoi comprare solo uno al giorno!<U+0010><U+0002>Ĕ<U+0010>",
