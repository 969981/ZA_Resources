      "offsetInSection": 4404,
      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Capisco...<U+0010><U+0002>ĔǬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4416,
      "rawDecodedUtf16Hex": "004300610070006900730063006F002E002E002E00100002011401EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Era a questo che si riferiva il canale StreghettaTV.<U+0010><U+0002>ĔǬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 27,
      "offsetInSection": 4448,
      "rawDecodedUtf16Hex": "00450072006100200061002000710075006500730074006F002000630068006500200073006900200072006900660065007200690076006100200069006C002000630061006E0061006C00650020005300740072006500670068006500740074006100540056002E00100002011401EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Di conseguenza abbiamo stabilito che quei video\ndicono la verità.<U+0010><U+0002>ĔǬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4564,
      "rawDecodedUtf16Hex": "0044006900200063006F006E00730065006700750065006E007A0061002000610062006200690061006D006F002000730074006100620069006C00690074006F00200063006800650020007100750065006900200076006900640065006F000A006400690063006F006E006F0020006C006100200076006500720069007400E0002E00100002011401EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Informerò l’amministrazione che non si tratta di\nun canale che diffonde bufale.<U+0010><U+0002>ĔǬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 4704,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ti ringrazio di cuore per il tuo aiuto.<U+0010><U+0002>ĔǬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4872,
      "rawDecodedUtf16Hex": "00540069002000720069006E006700720061007A0069006F002000640069002000630075006F00720065002000700065007200200069006C002000740075006F00200061006900750074006F002E00100002011401EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Ma allora...<U+0010><U+0002>ĔǬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4960,
      "rawDecodedUtf16Hex": "004D006100200061006C006C006F00720061002E002E002E00100002011401EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
