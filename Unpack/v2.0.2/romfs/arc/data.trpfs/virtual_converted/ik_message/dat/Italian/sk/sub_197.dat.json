      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3960,
      "rawDecodedUtf16Hex": "004D00650067006C0069006F0020006400690020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
