      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 4192,
      "rawDecodedUtf16Hex": "0044006F0062006200690061006D006F0020007000720065006E006400650072006C006F002000700065007200200063006100700069007200650020007300650020007100750061006E0074006F00200064006900630065000A007100750065006C00200076006900640065006F002000E80020007600650072006F002100100002011401EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 4328,
      "rawDecodedUtf16Hex": "00100002BDFF00170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ehi, ehi! Devi catturarlo!<U+0010><U+0002>ĔǬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 4340,
