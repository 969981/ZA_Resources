      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3988,
      "rawDecodedUtf16Hex": "005000650072006D0065007400740069006D00690020006400690020007600650072006900660069006300610072006500200063006F006E0020007400650020007300650020007100750061006E0074006F00200064006900630065000A007100750065006C00200076006900640065006F002000E80020007600650072006F002100100002011401EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
