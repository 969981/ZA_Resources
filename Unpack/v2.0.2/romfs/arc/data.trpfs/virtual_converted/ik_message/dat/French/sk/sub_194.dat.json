      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4608,
      "rawDecodedUtf16Hex": "0050006100720066006100690074002E000A0051007500650020006C201900E90070007200650075007600650020006400650020006C006100200050006C0061006E0074006500200063006F006D006D0065006E006300650020002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Parfait.\nQue l’épreuve du Feu commence !<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4712,
      "rawDecodedUtf16Hex": "0050006100720066006100690074002E000A0051007500650020006C201900E9007000720065007500760065002000640075002000460065007500200063006F006D006D0065006E006300650020002100100002011401E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Parfait.\nQue l’épreuve de l’Eau commence !<U+0010><U+0002>Ĕǩ",
