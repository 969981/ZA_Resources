      "rawDecodedUtf16Hex": "0050006F007500760065007A002D0076006F007500730020006D2019006500780070006C00690071007500650072002000E00020006E006F007500760065006100750020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
