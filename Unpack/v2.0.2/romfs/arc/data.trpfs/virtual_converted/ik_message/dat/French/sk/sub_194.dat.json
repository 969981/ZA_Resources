      "index": 24,
      "offsetInSection": 3624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 150
    },
    {
      "displayText": "J’attends avec impatience le moment où\ntu changeras d’avis.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3924,
