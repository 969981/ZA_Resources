  "messages": [
    {
      "displayText": "Bonjour. Souhaites-tu en savoir plus sur\nl’art secret des techniques ultimes ?<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
