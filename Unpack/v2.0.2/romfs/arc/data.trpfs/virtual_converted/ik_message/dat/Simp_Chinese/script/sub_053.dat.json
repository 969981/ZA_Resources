      "rawDecodedUtf16Hex": "54E6FF014F60613F610F8DDF62116253554A3002000A90A362115C314E0A54AFFF0100100002011401550000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "既然对战特区出现了，\n全息传送梯也就没办法修咯。<U+0010><U+0002>Ĕŕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 700,
      "rawDecodedUtf16Hex": "65E271365BF962187279533A51FA73B04E86FF0C000A5168606F4F20900168AF4E5F5C316CA1529E6CD54FEE54AF300200100002011401550000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
