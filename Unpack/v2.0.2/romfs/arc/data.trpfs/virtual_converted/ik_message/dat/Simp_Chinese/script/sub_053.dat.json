      "offsetInSection": 760,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "真是场不错的对战！\n我也差不多该结束休息了。<U+0010><U+0002>Ĕŕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 772,
