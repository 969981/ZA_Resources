      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "明明就沒錢，\n<U+0010><U+0003>ᄀÿā你妳是來幹嘛的啊。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
