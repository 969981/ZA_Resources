      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "660E660E5C316C929322FF0C000A00100003110000FF01014F6059B3662F4F865E79561B7684554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "<U+0010><U+0002>Ǐ<U+0000>啊。\n等我一下！",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 1908,
      "rawDecodedUtf16Hex": "0010000201CF0000554A3002000A7B4962114E004E0BFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的火花烘焙咖啡！\n敬請品嚐微微帶焦的豆子帶來的風味。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE7684706B82B170D8711954965561FF01000A656C8ACB54C156905FAE5FAE5E36712676848C465B505E364F86768498A8547330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的噴射火焰烘焙咖啡！\n好好品嚐它帶來的酸味、苦味、甜味吧。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2012,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE768456745C04706B713070D8711954965561FF01000A597D597D54C156905B835E364F86768491785473300182E654733001751C5473542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的大字爆炎烘焙咖啡！\n比起酸味，它的香氣和苦味更強烈喔。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2092,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE768459275B577206708E70D8711954965561FF01000A6BD48D7791785473FF0C5B83768499996C23548C82E6547366F45F3770C8559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的燃盡烘焙咖啡！\n它的烘焙度最深，能品嚐到很強的苦味喔。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2172,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE768471C376E170D8711954965561FF01000A5B83768470D871195EA667006DF1FF0C80FD54C1569052305F885F37768482E65473559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的阿薩姆克兒紅茶！\n它甘甜濃醇……還帶有天空的味道！",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE7684963F85A959C6514B51527D058336FF01000A5B837518751C6FC391872026202690845E36670959297A7A768454739053FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的貓老大吉嶺紅茶！\n它的味道爽口，還隱約帶有高貴的香氣。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2328,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE76848C938001592754095DBA7D058336FF01000A5B83768454739053723D53E3FF0C908496B17D045E3667099AD88CB4768499996C2330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的羅絲雷朵茶！它的香氣濃郁，\n茶性溫和，是在阿羅拉也很受歡迎的茶。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE76847F857D7296F767358336FF015B83768499996C236FC390C1FF0C000A833660276EAB548CFF0C662F5728963F7F8562C94E5F5F8853D76B618FCE7684833630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的哞哞鮮奶！\n這種鮮奶可是營養滿分喔。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE768454DE54DE9BAE5976FF01000A90197A2E9BAE597653EF662F71DF990A6EFF5206559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的美味之水！\n它的鎂含量好像比其他地區還多。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2556,
      "rawDecodedUtf16Hex": "4F86FF0C00100003110000FF01014F6059B39EDE76847F8E54734E4B6C34FF01000A5B8376849382542B91CF597D50CF6BD451764ED6573053409084591A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "來，<U+0010><U+0003>ᄀÿā你妳點的激爽之水！\n好好享受與硬水絕配的滋味吧。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
