      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ha ! Ce chipeur d’Emolga ne faisait pas le poids\ncontre toi !<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 2568,
      "rawDecodedUtf16Hex": "0048006100200021002000430065002000630068006900700065007500720020006420190045006D006F006C006700610020006E00650020006600610069007300610069007400200070006100730020006C006500200070006F006900640073000A0063006F006E00740072006500200074006F006900200021001000020114018A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Et en plus, il a laissé toutes les Baies qu’il m’avait\nprises ! Quelle chance !<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 2700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "J’imagine qu’il va continuer ses chapardages.\nCe qu’il veut, c’est se faire une réserve, après tout.<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Êtres humains ou Pokémon, on doit tous se battre\npour survivre...<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3080,
      "rawDecodedUtf16Hex": "00CA0074007200650073002000680075006D00610069006E00730020006F007500200050006F006B00E9006D006F006E002C0020006F006E00200064006F0069007400200074006F007500730020007300650020006200610074007400720065000A0070006F00750072002000730075007200760069007600720065002E002E002E001000020114018A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Fais-moi voir la tête de notre voleur !<U+0010><U+0002>ĔƊ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3220,
