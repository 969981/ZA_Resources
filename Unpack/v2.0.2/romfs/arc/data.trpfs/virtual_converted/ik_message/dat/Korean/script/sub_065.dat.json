      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "노말타입 기술이\n고스트타입에게도 통하기만 하면...!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
