      "rawDecodedUtf16Hex": "8981662F80FD670953EA82F14FCA768472317BA14F8D202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
