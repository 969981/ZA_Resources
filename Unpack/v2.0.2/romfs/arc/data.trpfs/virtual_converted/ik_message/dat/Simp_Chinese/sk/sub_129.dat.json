      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "就是没有英俊的宝可梦帮忙\n为客人送上厉害密阿雷格雷派饼。<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "5C31662F6CA1670982F14FCA76845B9D53EF68A65E2E5FD9000A4E3A5BA24EBA90014E0A53895BB35BC6963F96F7683C96F76D3E997C300200100002011401AB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "毕竟这家咖啡馆的名字里\n就有英俊！这两个字啊。<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 388,
