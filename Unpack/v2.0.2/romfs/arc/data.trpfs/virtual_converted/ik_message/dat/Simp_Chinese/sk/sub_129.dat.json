  "messages": [
    {
      "displayText": "我要做超越密阿雷格雷派饼的\n厉害密阿雷格雷派饼！<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 228,
