      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "哦～！我感觉到了！\n多么英俊的爱管侍啊！<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 888,
      "rawDecodedUtf16Hex": "54E6FF5EFF016211611F89C952304E86FF01000A591A4E4882F14FCA768472317BA14F8D554AFF0100100002011401AB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "哦～！雌性的爱管侍\n也散发着英俊的气息！<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
