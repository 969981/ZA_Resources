      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "但是目前有一个问题……<U+0010><U+0002>Ĕƫ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 288,
