      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 228,
      "rawDecodedUtf16Hex": "D3EDC8FC0020BA54AC000020ACB0D22C002100100002011401D90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "내버려뒀다가는\n이차원 미르가 무사하지 못할 것이야.<U+0010><U+0002>ĔǙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 256,
