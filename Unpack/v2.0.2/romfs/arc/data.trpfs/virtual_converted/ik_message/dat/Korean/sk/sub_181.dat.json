      "rawDecodedUtf16Hex": "D3EDC8FC0020BA54AC00C9C4D6540020D3ECCF13BAAC0020AC04C758000AACB0D22CAC000020BC8CC5B4C9C0B8240020D558ACE00020C788B2E4B12400210020C774B984D558C5EC002E002E002E00100002011401D90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "폭주 메가 결투!<U+0010><U+0002>ĔǙ",
