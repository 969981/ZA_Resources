    },
    {
      "displayText": "Deux Pokémon Méga-Ferox sont en train\nde se battre !<U+0010><U+0002>ĔǙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 156,
      "rawDecodedUtf16Hex": "004400650075007800200050006F006B00E9006D006F006E0020004D00E900670061002D004600650072006F007800200073006F006E007400200065006E00200074007200610069006E000A0064006500200073006500200062006100740074007200650020002100100002011401D90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "C’EST UNE BASTON MÉGA-FEROX !<U+0010><U+0002>ĔǙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 272,
