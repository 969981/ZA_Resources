      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "004900200068006F007000650020007700652019006C006C002000670065007400200061006C006F006E00670020007300770069006D006D0069006E0067006C0079002C0020004600650065006200610073002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
