      "index": 9,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "0049007420190073002000610020004600650065006200610073002100200057006F0077002C0020007400680061006E006B0073002E00100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "It’s a real lunker of a Feebas! Wow, thanks!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "0049007420190073002000610020007200650061006C0020006C0075006E006B006500720020006F0066002000610020004600650065006200610073002100200057006F0077002C0020007400680061006E006B0073002100100002011401CB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Is that a Shiny Feebas?! Wow, thanks!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1040,
