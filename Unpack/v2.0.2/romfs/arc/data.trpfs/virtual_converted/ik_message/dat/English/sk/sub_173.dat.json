      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 189
    },
    {
      "displayText": "But who cares! Look at the pond here!<U+0010><U+0001>븁\nThe Feebas and Magikarp are having a great time!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 4,
