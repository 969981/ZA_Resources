      "index": 11,
      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Vielleicht hat Octoklammer so gut gewirkt, weil\nKaocto die schmerzende Stelle ausgespart hat?<U+0010><U+0002>Ĕƺ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
