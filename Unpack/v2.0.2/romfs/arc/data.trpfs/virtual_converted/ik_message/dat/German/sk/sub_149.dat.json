      "offsetInSection": 1840,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Dank der Attacke lassen meine Rückenschmerzen\njedenfalls langsam nach...<U+0010><U+0002>Ĕƺ",
