      "index": 6,
      "offsetInSection": 1304,
      "rawDecodedUtf16Hex": "00440075002000620069007300740020006D00650069006E00650020006C00650074007A0074006500200048006F00660066006E0075006E0067002E002E002E00100002011401BA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
