      "rawDecodedUtf16Hex": "00570065006E006E00200069006300680020006D006900630068002000720069006300680074006900670020006500720069006E006E006500720065002C002000680069006500DF0020006400690065002000410074007400610063006B0065000A00100002FF000006004F00630074006F006B006C0061006D006D0065007200100002FF000000002E00100002011401BA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Es tut mir wirklich leid für die Umstände, aber\nkönnte eines deiner Pokémon Octoklammer<U+0010><U+0001>븀\neinsetzen?<U+0010><U+0001>븁\nIch glaube, <U+0010><U+0002>＀<U+0006>Kaocto <U+0010><U+0002>＀<U+0000>kann sie erlernen.<U+0010><U+0002>Ĕƺ",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 155
    },
    {
      "displayText": "Du bist meine letzte Hoffnung...<U+0010><U+0002>Ĕƺ",
