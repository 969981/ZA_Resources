      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Brrrg!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 704,
      "rawDecodedUtf16Hex": "0042007200720072006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "You strike me as a capable Trainer, and so I have\none very, VERY serious request for you.<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "I’d like to borrow an Avalugg big enough to fit all\nfour of my Bergmite on its back.<U+0010><U+0001>븁\nI think one with a size classification of XL should\nbe big enough.<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 159
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
