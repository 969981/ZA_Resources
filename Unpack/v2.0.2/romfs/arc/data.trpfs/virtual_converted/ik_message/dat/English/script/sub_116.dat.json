      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "This is exactly what I wanted to see! My dream’s\ncome true!<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
