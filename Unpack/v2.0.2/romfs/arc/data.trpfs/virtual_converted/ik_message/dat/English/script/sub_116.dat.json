      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Wait, what’s happening...? No way!<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2760,
      "rawDecodedUtf16Hex": "0057006100690074002C0020007700680061007420190073002000680061007000700065006E0069006E0067002E002E002E003F0020004E006F00200077006100790021001000020114018B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
