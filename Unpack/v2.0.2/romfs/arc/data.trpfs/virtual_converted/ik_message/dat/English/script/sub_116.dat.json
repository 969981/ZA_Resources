      "rawDecodedUtf16Hex": "00490074002000730068006F0075006C0064002000660069007400200061006C006C0020006D007900200042006500720067006D00690074006500200066006F0072002000730075007200650021002000410072006500200079006F0075000A00720065006100640079002C0020006D00790020006200610062006900650073003F001000020114018B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Brrrg!",
