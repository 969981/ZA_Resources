      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Yes, that’s right—I want to see all my Bergmite sit\non the back of a giant Avalugg!<U+0010><U+0002>ĔƋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
