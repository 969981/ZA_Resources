      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "00430068006500200063201900E8003F00200054007500740074006F002000620065006E0065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Ecco, vorrei chiederti una mano per una cosa...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "004500630063006F002C00200076006F0072007200650069002000630068006900650064006500720074006900200075006E00610020006D0061006E006F002000700065007200200075006E006100200063006F00730061002E002E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Abbiamo una nuova vicina di casa.\nPare che si sia trasferita da Paldea.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Questa vicina ha un Pokémon...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "00510075006500730074006100200076006900630069006E006100200068006100200075006E00200050006F006B00E9006D006F006E002E002E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "E questo Pokémon non fa che fissare il mio Scizor.\nNon gli stacca gli occhi di dosso!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
