      "index": 28,
      "offsetInSection": 3764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "Una sconosciuta si trasferisce vicino a me e\ntutto a un tratto non posso stare tranquillo<U+0010><U+0001>븀\nper via del suo Pokémon! Ma ti pare?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
