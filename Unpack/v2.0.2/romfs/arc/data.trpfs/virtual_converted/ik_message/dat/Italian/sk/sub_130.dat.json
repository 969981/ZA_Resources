      "rawDecodedUtf16Hex": "004E006F0021002000540069006E006B00610074007500660066002C0020006C006100730063006900610020007300740061007200650020007100750065006C0020006D006500740061006C006C006F0021000A004E006F006E002000700075006F00690020007000720065006E00640065007200740065006C006F002100100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Speriamo vada tutto bene...<U+0010><U+0002>ĔƬ",
