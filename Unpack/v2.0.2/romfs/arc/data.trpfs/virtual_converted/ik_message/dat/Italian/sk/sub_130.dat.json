      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Sai, il mio Scizor è un po’ pauroso e ogni giorno\nva nel panico per via di questo Pokémon.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
