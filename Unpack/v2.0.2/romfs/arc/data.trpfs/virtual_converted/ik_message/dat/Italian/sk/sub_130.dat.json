      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Sì, si tratta di Tinkatuff...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "005300EC002C0020007300690020007400720061007400740061002000640069002000540069006E006B00610074007500660066002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
