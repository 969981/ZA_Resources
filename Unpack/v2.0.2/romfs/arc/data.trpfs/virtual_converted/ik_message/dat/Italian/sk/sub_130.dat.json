      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
