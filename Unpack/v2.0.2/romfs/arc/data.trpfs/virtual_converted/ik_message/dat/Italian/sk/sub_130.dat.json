      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Allenat<U+0010><U+0003>ᄀÿ̂orrice, potresti riferire quello che ti ho detto\nal vicino di casa?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
