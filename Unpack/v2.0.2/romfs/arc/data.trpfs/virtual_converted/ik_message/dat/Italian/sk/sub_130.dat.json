      "rawDecodedUtf16Hex": "004800610020007000610075007200610020006400690020005300630069007A006F0072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Eh?! Ha paura di lui per via del suo sguardo e\nper questo non gli toglie gli occhi di dosso...?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 3328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Eh?! Non si sente tranquillo attorno a Scizor?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 3528,
      "rawDecodedUtf16Hex": "00450068003F00210020004E006F006E002000730069002000730065006E007400650020007400720061006E007100750069006C006C006F0020006100740074006F0072006E006F002000610020005300630069007A006F0072003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Ma questo è il suo sguardo naturale!\nNon lo fa mica apposta!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3632,
      "rawDecodedUtf16Hex": "004D0061002000710075006500730074006F002000E800200069006C002000730075006F0020007300670075006100720064006F0020006E00610074007500720061006C00650021000A004E006F006E0020006C006F0020006600610020006D0069006300610020006100700070006F007300740061002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Capisco che quel Pokémon non si senta\ntranquillo, ma allora il mio? Sempre uno sguardo<U+0010><U+0001>븀\naddosso senza spiegazioni... Fa paura, no?<U+0010><U+0002>ĔƬ",
