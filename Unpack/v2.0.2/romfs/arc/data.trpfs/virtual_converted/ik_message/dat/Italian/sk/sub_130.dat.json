      "offsetInSection": 3208,
      "rawDecodedUtf16Hex": "00C800200070006500720020007600690061002000640065006C006C006F0020007300670075006100720064006F0020006400690020005300630069007A006F0072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Ha paura di Scizor...",
      "escapedControlUnits": 0,
