      "offsetInSection": 5600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Il mio Tinkatuff non assale gli altri Pokémon per\nrubare il loro metallo!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 5852,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Cioè... di solito no...<U+0010><U+0002>Ĕƭ",
