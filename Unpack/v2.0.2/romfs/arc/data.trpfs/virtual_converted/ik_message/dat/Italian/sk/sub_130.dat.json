      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Tutto qui. Però capisco che limitarsi a fissare\nsenza dire niente fa a sua volta paura.<U+0010><U+0002>Ĕƭ",
