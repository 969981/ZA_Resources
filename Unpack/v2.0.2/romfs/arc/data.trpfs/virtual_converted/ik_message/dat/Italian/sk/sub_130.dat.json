      "flagsUpper16": 0,
      "index": 84,
      "offsetInSection": 9912,
      "rawDecodedUtf16Hex": "00540069002000720069006E006700720061007A0069006F00200064006900200074007500740074006F0020007100750065006C006C006F0020006300680065002000680061006900200066006100740074006F000A0070006500720020006D00650020006F006700670069002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
