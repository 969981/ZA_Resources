      "rawDecodedUtf16Hex": "00100002BDFF00450000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bene, adesso faremo avvicinare i nostri Pokémon.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 8676,
