      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6064,
      "rawDecodedUtf16Hex": "00540069006E006B006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Poi pensa a me: mi sono appena trasferita in\nuna nuova casa, le preoccupazioni sono già tante.<U+0010><U+0001>븁\nSentirmi dire che il mio Pokémon fa paura, senza\nnessuna buona ragione, non aiuta di certo.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 6080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 194
    },
    {
      "displayText": "Piuttosto, vorrei che il vicino mi assicurasse che\nScizor non ha preso di mira il mio Pokémon.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 6468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Tinka...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 6668,
      "rawDecodedUtf16Hex": "00540069006E006B0061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>뷿0",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 6688,
      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Allora? Cosa ha detto la vicina?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 49,
      "offsetInSection": 6700,
      "rawDecodedUtf16Hex": "0041006C006C006F00720061003F00200043006F0073006100200068006100200064006500740074006F0020006C006100200076006900630069006E0061003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Chiede se Scizor non li abbia presi di mira",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6776,
      "rawDecodedUtf16Hex": "0043006800690065006400650020007300650020005300630069007A006F00720020006E006F006E0020006C00690020006100620062006900610020007000720065007300690020006400690020006D0069007200610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Garantisce che Tinkatuff non attaccherà",
