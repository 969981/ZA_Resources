{
  "declaredLength": 4572,
  "decoding": "confirmed-per-slot-XOR-rotate3-index-seed",
  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Tú debes de ser <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "005400FA002000640065006200650073002000640065002000730065007200200010000201000000002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Me encanta esta foto que ha subido mi streamer\npreferida. ¡Si es que es la mejor! ¡Mira!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Naria y su Eelektross, de chill en un banco...\n¡Es lo más!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "004E006100720069006100200079002000730075002000450065006C0065006B00740072006F00730073002C0020006400650020006300680069006C006C00200065006E00200075006E002000620061006E0063006F002E002E002E000A00A1004500730020006C006F0020006D00E10073002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "¡Yo también quiero sentarme en ese mismo\nbanco y sacarme una foto con mi Manectric!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Así que tengo un favorcillo que pedirte.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 884,
      "rawDecodedUtf16Hex": "0041007300ED0020007100750065002000740065006E0067006F00200075006E0020006600610076006F007200630069006C006C006F002000710075006500200070006500640069007200740065002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "¡Necesito que encuentres el banco de la foto!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 976,
      "rawDecodedUtf16Hex": "00A1004E006500630065007300690074006F002000710075006500200065006E006300750065006E007400720065007300200065006C002000620061006E0063006F0020006400650020006C006100200066006F0074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "¡Nec!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "00A1004E0065006300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres ver la foto del banco otra vez?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200076006500720020006C006100200066006F0074006F002000640065006C002000620061006E0063006F0020006F007400720061002000760065007A003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Sí, por favor",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1192,
      "rawDecodedUtf16Hex": "005300ED002C00200070006F00720020006600610076006F00720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "No hace falta, gracias",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1220,
      "rawDecodedUtf16Hex": "004E006F00200068006100630065002000660061006C00740061002C002000670072006100630069006100730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Este es el banco! ¿No sabrás dónde está?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "00A1004500730074006500200065007300200065006C002000620061006E0063006F0021002000BF004E006F0020007300610062007200E100730020006400F3006E00640065002000650073007400E1003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Necesito que encuentres el banco de la foto!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1360,
      "rawDecodedUtf16Hex": "00A1004E006500630065007300690074006F002000710075006500200065006E006300750065006E007400720065007300200065006C002000620061006E0063006F0020006400650020006C006100200066006F0074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Has encontrado el banco de la foto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1472,
      "rawDecodedUtf16Hex": "00A100480061007300200065006E0063006F006E0074007200610064006F00200065006C002000620061006E0063006F0020006400650020006C006100200066006F0074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Mira esas dos macetas en línea y los edificios del\nfondo... ¡Hasta las montañas son las mismas!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "¡No hay duda! ¡Naria se sacó la foto aquí!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "00A1004E006F0020006800610079002000640075006400610021002000A1004E0061007200690061002000730065002000730061006300F30020006C006100200066006F0074006F002000610071007500ED002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "¡Venga, ya estamos tardando!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "00A100560065006E00670061002C00200079006100200065007300740061006D006F0073002000740061007200640061006E0064006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "¿A que estoy igualita aquí sentada en el mismo\nbanco? ¡Cualquiera diría que soy la misma Naria!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1912,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "¿Te puedo pedir otro favorcillo, <U+0010><U+0002>Ā<U+0000>?\n¿Me puedes sacar una foto igual que la suya?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2112,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Pero que sea exactamente igual, ¿eh?\n¡El mismo ángulo y el mismo todo!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Si quieres ver la foto original de nuevo, avisa.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "005300690020007100750069006500720065007300200076006500720020006C006100200066006F0074006F0020006F0072006900670069006E0061006C0020006400650020006E007500650076006F002C002000610076006900730061002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "¿Quieres ver la foto de Naria?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200076006500720020006C006100200066006F0074006F0020006400650020004E0061007200690061003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Sí<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2620,
      "rawDecodedUtf16Hex": "005300ED00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "No hace falta<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2636,
      "rawDecodedUtf16Hex": "004E006F00200068006100630065002000660061006C0074006100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "¡Sácame la foto desde lejos, como la de Naria!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2672,
      "rawDecodedUtf16Hex": "00A1005300E100630061006D00650020006C006100200066006F0074006F0020006400650073006400650020006C0065006A006F0073002C00200063006F006D006F0020006C00610020006400650020004E0061007200690061002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sí, es más o menos ahí...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "005300ED002C0020006500730020006D00E100730020006F0020006D0065006E006F007300200061006800ED002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "O igual no.<U+0010><U+0001>븁\nMe parece que el ángulo no es el mismo...\n¡La idea es recrear la escena a la perfección!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 2848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3064,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Ahí! ¡Perfecto! ¡Saca la foto desde ahí!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3076,
      "rawDecodedUtf16Hex": "00A10041006800ED0021002000A10050006500720066006500630074006F0021002000A100530061006300610020006C006100200066006F0074006F00200064006500730064006500200061006800ED002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "A ver qué tal ha quedado...<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3168,
      "rawDecodedUtf16Hex": "0041002000760065007200200071007500E9002000740061006C0020006800610020007100750065006400610064006F002E002E002E00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "¡Pe-pero si está igual! ¡Si parezco Naria y todo!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3232,
      "rawDecodedUtf16Hex": "00A100500065002D007000650072006F002000730069002000650073007400E100200069006700750061006C0021002000A10053006900200070006100720065007A0063006F0020004E00610072006900610020007900200074006F0064006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Vale, pues ahora a subir la foto a las redes...\n¡Listo!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3340,
      "rawDecodedUtf16Hex": "00560061006C0065002C00200070007500650073002000610068006F00720061002000610020007300750062006900720020006C006100200066006F0074006F002000610020006C00610073002000720065006400650073002E002E002E000A00A1004C006900730074006F002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Me pregunto quién sacó la foto original.\n¿Será ese productor suyo del que tanto se habla?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3460,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "¡Pues que se dedique a producir más artículos\nde coleccionista!<U+0010><U+0001>븁\nQue el Pan de Naria no está mal, pero yo lo que\nquiero son figuras y llaveros. ¡Soñar es gratis!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 168
    },
    {
      "displayText": "Bueno, me voy a recrear más fotos de Naria,\nque para eso he venido a Ciudad Luminalia.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "¡Gracias por tu ayuda, <U+0010><U+0002>Ā<U+0000>!\n¿Y si descansas en el banco, ya que estás?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "¡Hasta otra!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4320,
      "rawDecodedUtf16Hex": "00A1004800610073007400610020006F007400720061002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4356,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Para la próxima, estaría genial sacarme una foto\ndonde se celebra el Concurso Nariático!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "¡Tric!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4556,
      "rawDecodedUtf16Hex": "00A1005400720069006300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    }
  ],
