    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un grupo de Pokémon salvajes está rodeando\nel Holotransportador.<U+0010><U+0001>븁\n¿Quieres combatir contra ellos para ahuyentarlos\ny poder usarlo?",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Sí",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
