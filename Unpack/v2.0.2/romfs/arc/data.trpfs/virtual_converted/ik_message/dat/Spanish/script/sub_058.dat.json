      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Pero a ver quién es el guapo que les dice nada.\nSería meterse con cuatro a la vez.<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
