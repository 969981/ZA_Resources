      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3072,
      "rawDecodedUtf16Hex": "00560075006F00690020006C006100730063006900610072006500200069002000520069006600690075007400690020007000720065006C0069006200610074006900200061006300630061006E0074006F002000610069000A006200690064006F006E0069002000640065006C006C00610020007300700061007A007A00610074007500720061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Sì",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3212,
      "rawDecodedUtf16Hex": "005300EC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "No",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3220,
      "rawDecodedUtf16Hex": "004E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
