      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3228,
      "rawDecodedUtf16Hex": "0054007200750075007500750075006200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "I Trubbish stanno mangiando i Rifiuti prelibati\ncon gusto...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3248,
      "rawDecodedUtf16Hex": "00490020005400720075006200620069007300680020007300740061006E006E006F0020006D0061006E006700690061006E0064006F00200069002000520069006600690075007400690020007000720065006C00690062006100740069000A0063006F006E00200067007500730074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Grazie per aver portato i nostri rifiuti fino a\nquesti bidoni!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3372,
      "rawDecodedUtf16Hex": "004700720061007A0069006500200070006500720020006100760065007200200070006F0072007400610074006F002000690020006E006F007300740072006900200072006900660069007500740069002000660069006E006F00200061000A0071007500650073007400690020006200690064006F006E00690021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Da qui l’odore dei Trubbish non dovrebbe arrivare\nfino al caffè.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3508,
      "rawDecodedUtf16Hex": "0044006100200071007500690020006C2019006F0064006F0072006500200064006500690020005400720075006200620069007300680020006E006F006E00200064006F007600720065006200620065002000610072007200690076006100720065000A00660069006E006F00200061006C0020006300610066006600E8002E001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Guardali come sono contenti!\nMangiano con grande gusto.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3648,
      "rawDecodedUtf16Hex": "004700750061007200640061006C006900200063006F006D006500200073006F006E006F00200063006F006E00740065006E007400690021000A004D0061006E006700690061006E006F00200063006F006E0020006700720061006E0064006500200067007500730074006F002E001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Pensavo...<U+0010><U+0001>븁\nVivere insieme ai Pokémon non significa\nnecessariamente stargli accanto tutto il tempo.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Nel senso, ai Trubbish piace il cibo del nostro\ncaffè, ma non possiamo lasciarli mangiare lì.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Trovare la giusta distanza tra esseri umani e\nPokémon può essere la soluzione affinché<U+0010><U+0001>븀\nla convivenza funzioni per tutti.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "<U+0010><U+0002>뷿#",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4432,
      "rawDecodedUtf16Hex": "00100002BDFF00230000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Che carini quei Pokémon\nche ti seguono...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4444,
      "rawDecodedUtf16Hex": "00430068006500200063006100720069006E00690020007100750065006900200050006F006B00E9006D006F006E000A00630068006500200074006900200073006500670075006F006E006F002E002E002E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Uh? Che odore forte...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4532,
      "rawDecodedUtf16Hex": "00550068003F00200043006800650020006F0064006F0072006500200066006F007200740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Mi ricordano Falinks! È un lavoro\nsporco il tuo, ma coraggio!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4580,
      "rawDecodedUtf16Hex": "004D00690020007200690063006F007200640061006E006F002000460061006C0069006E006B00730021002000C800200075006E0020006C00610076006F0072006F000A00730070006F00720063006F00200069006C002000740075006F002C0020006D006100200063006F00720061006700670069006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
