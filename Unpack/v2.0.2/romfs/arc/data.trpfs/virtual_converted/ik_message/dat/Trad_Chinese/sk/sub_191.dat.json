      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 848,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳準備好要領教……\n琳瑯滿目的華麗招式了嗎？<U+0010><U+0002>ĔǦ",
