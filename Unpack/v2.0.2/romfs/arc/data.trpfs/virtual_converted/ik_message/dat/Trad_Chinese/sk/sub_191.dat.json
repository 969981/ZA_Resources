      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "想必這會是一場讓人不禁……<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "60F35FC590196703662F4E0058348B934EBA4E0D79812026202600100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "看華麗的連續招式看到出神的……<U+0010><U+0002>ĔǦ",
