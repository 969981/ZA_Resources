      "rawDecodedUtf16Hex": "CD95D558D569B2C8B2E4002100100001BE01000AD3EDC8FC0020BA54AC000020B7ECC2DC0020CC4CB9B0C9C0C5D0000AB3C4C804D558C2E40020C2180020C788AC8C0020B418C5C8C2B5B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "어느 것에 도전하실 건가요?",
      "escapedControlUnits": 0,
