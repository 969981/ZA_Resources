      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "클리어 타임은\n<U+0010><U+0002>ȁ<U+0005>:<U+0010><U+0002>ȁ<U+0006>:<U+0010><U+0002>ȁ<U+0007>.<U+0010><U+0002>ȁ<U+0008>입니다!",
