      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 2924,
      "rawDecodedUtf16Hex": "AC00D639D55C0020B3C4C804C7740020B4200020D150B370000AC815B9D00020AD1CCC2EC73CC2E0AC00C694003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "예",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 2972,
      "rawDecodedUtf16Hex": "C6080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 2
    },
    {
      "displayText": "아니요",
