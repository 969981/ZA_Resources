      "rawDecodedUtf16Hex": "C9C0AE08AE4CC9C0C7580020AE30B85DC7400020C800C7A5B418C9C0B9CC000AC774C5B4C11C0020B3C4C804D5600020C218B2940020C5C6C2B5B2C8B2E4002E00100001BE00000AADF8B798B3C40020D3ECAE30D558C2E40020AC74AC00C694003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
