      "rawDecodedUtf16Hex": "D3EDC8FC0020BA54AC000020B7ECC2DC0020CC4CB9B0C9C0C5D0000AB3C4C804D558C2E40020AC74AC00C694003F0000",
      "trailingZeroPaddingUnits": 1,
