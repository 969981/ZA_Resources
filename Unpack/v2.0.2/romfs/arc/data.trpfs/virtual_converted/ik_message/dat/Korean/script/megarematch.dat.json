      "rawDecodedUtf16Hex": "D68CBCF5D55CB2E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "그만둔다",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
