      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 3416,
      "rawDecodedUtf16Hex": "C774BC880020D074B9ACC5B40020D0C0C784C740000A0010000202010005003A0010000202010006003A0010000202010007002E0010000202010008C785B2C8B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "격파 수는\n<U+0010><U+0002>ȁ<U+0004>마리입니다!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 3488,
      "rawDecodedUtf16Hex": "ACA9D30C0020C218B294000A0010000202010004B9C8B9ACC785B2C8B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "모든 포켓몬을 쓰러뜨리셨군요!?\n굉장하네요! 축하합니다!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 3524,
