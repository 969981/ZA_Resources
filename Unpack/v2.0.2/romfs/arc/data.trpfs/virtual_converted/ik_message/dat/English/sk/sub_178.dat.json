      "rawDecodedUtf16Hex": "0057006900670067006C007900740075006600660020007500730065006400200061002000660065006100720073006F006D006500200073006C0061007000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "W-Wigglytuff, whyyy?!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "0057002D0057006900670067006C00790074007500660066002C002000770068007900790079003F002100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Was my Wigglytuff letting its fur get gross on\npurpose...to keep me from clinging so much?<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Waaaiiit! Wigglytuff, wait for meee!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3020,
