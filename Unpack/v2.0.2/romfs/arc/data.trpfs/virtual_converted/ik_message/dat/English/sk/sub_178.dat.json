      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "TUUUFFFFFF!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2472,
      "rawDecodedUtf16Hex": "005400550055005500460046004600460046004600210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "You’ll take regular showers from now on, right?\nSo we don’t have to do this again?<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "TUUUFFFFFF!!!<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2672,
      "rawDecodedUtf16Hex": "005400550055005500460046004600460046004600210021002100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Wigglytuff used a fearsome slap!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
