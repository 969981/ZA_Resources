    },
    {
      "displayText": "Falsch, falsch, falsch! Tja, wie solltest du das auch\nwissen?<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
