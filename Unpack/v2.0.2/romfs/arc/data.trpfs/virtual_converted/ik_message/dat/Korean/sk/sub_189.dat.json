      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "샤!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "C0E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "야!\n대답하시는 건 기다려야지!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
