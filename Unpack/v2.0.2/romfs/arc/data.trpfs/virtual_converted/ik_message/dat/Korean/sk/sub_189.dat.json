      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "샤!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "C0E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "기다려, 쥬피썬더!\n아직 이야기하는 중이란 말이야!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
