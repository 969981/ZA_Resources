      "rawDecodedUtf16Hex": "C5EDC2DC0020004D005AB2E80021000AC18CBB38B300B85C0020AC15D558C2DCB124C694002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "제 쥬피썬더,\n성급한 만큼 빠르지 않았나요?<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 780,
