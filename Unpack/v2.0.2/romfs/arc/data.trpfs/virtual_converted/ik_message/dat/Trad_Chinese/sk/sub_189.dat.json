      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "51764ED6908467092026202600100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
