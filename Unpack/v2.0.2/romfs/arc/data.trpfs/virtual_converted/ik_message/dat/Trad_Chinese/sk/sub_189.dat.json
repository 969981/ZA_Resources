      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "只是無論再怎麼快，\n還是得花上3秒才能再使出同一個招式。<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 884,
      "rawDecodedUtf16Hex": "53EA662F71218AD6518D600E9EBC5FEBFF0C000A9084662F5F9782B14E0A003379D2624D80FD518D4F7F51FA540C4E00500B62DB5F0F300200100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
