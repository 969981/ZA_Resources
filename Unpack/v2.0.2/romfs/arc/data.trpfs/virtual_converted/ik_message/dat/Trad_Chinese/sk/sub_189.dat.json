      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "害<U+0010><U+0003>ᄀÿā你妳一頭霧水對吧。<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
