      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "就說了不要不等我\n就自己跑去寶可夢中心啦！<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
