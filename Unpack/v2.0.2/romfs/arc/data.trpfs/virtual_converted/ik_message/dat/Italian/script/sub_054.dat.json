      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1392,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ti porgo le mie più sentite scuse!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "0054006900200070006F00720067006F0020006C00650020006D0069006500200070006900F9002000730065006E00740069007400650020007300630075007300650021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Il mio comportamento è stato imperdonabile!\nNon potevo sapere che eri così forte!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 1484,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "È il mio Holotrasporto preferito, ma ti prego,\nusalo pure come e quando desideri!<U+0010><U+0001>븀\nAnche mille o un milione di volte, se vorrai!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 1656,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "Io resto qui di guardia, così potrai salire e\nscendere senza la minima preoccupazione!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 1928,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
