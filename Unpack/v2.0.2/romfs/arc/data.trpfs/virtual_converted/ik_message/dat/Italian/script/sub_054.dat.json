      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Se devi per forza usare l’Holotrasporto dovrai\nprima lottare con me!!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "0053006500200064006500760069002000700065007200200066006F0072007A00610020007500730061007200650020006C20190048006F006C006F00740072006100730070006F00720074006F00200064006F0076007200610069000A007000720069006D00610020006C006F0074007400610072006500200063006F006E0020006D006500210021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Volentieri!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
