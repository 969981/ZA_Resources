      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Cos’è, vuoi usare questo Holotrasporto?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "0043006F0073201900E8002C002000760075006F0069002000750073006100720065002000710075006500730074006F00200048006F006C006F00740072006100730070006F00720074006F003F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Questo è il mio Holotrasporto preferito!\nSe devi usarlo per forza...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 616,
      "rawDecodedUtf16Hex": "00510075006500730074006F002000E800200069006C0020006D0069006F00200048006F006C006F00740072006100730070006F00720074006F002000700072006500660065007200690074006F0021000A005300650020006400650076006900200075007300610072006C006F002000700065007200200066006F0072007A0061002E002E002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
