      "rawDecodedUtf16Hex": "0056006F006C0065006E0074006900650072006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "No, grazie...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "004E006F002C0020006700720061007A00690065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Saggia decisione. Questo Holotrasporto lo uso\nsolo io: è il mio preferito!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Se perdi sono affari tuoi, sappilo!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "0053006500200070006500720064006900200073006F006E006F0020006100660066006100720069002000740075006F0069002C002000730061007000700069006C006F0021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
