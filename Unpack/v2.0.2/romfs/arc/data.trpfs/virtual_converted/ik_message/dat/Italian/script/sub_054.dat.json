      "rawDecodedUtf16Hex": "002E002E002E00200064006F00760072006100690020007000720069006D00610020006C006F0074007400610072006500200063006F006E0020006D006500210021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Fammi sapere se hai il coraggio di sfidarmi!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
