      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Y este, el de la Avenida Invierno, es el que menos\nPokébolas vende de todos, con mucha diferencia.<U+0010><U+0002>Ĕǆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
