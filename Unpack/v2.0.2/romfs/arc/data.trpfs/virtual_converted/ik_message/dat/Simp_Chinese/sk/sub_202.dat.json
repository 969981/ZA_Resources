      "rawDecodedUtf16Hex": "5F885728610FFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "在扭洞深处……力量中心的，\n好像是胡帕！<U+0010><U+0002>Ĕ<U+0013>",
