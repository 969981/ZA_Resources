      "index": 65,
      "offsetInSection": 8308,
      "rawDecodedUtf16Hex": "005300ED002C002000730065007200E10020006D0065006A006F007200200071007500650020006E006F0020006C006500200065006E0073006500F1006500730020006C006100200076006100730069006A0061002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
