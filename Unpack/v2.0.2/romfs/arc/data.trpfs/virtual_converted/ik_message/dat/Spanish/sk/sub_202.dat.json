      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 8292,
      "rawDecodedUtf16Hex": "00A10048006F006F006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
