      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "¿Qué pasa, Hoopa? ¿Le tienes miedo a esa vasija?<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
