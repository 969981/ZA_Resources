      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Y no solo eso, sino que de su interior se filtra\nuna extraña energía.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1356,
      "rawDecodedUtf16Hex": "00590020006E006F00200073006F006C006F002000650073006F002C002000730069006E006F002000710075006500200064006500200073007500200069006E0074006500720069006F0072002000730065002000660069006C007400720061000A0075006E006100200065007800740072006100F1006100200065006E00650072006700ED0061002E00100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "No es la misma que irradiaba la megaevolución\ndescontrolada, pero me preocupa su origen.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "¿Su origen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1692,
      "rawDecodedUtf16Hex": "00BF005300750020006F0072006900670065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "¿Te preocupa?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "00BF005400650020007000720065006F0063007500700061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "En lo más profundo de la distorsión, se percibe\nun poder... parecido al de Hoopa.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "¡Tenéis que investigarlo a la de ya!<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1916,
      "rawDecodedUtf16Hex": "00A100540065006E00E900690073002000710075006500200069006E00760065007300740069006700610072006C006F002000610020006C0061002000640065002000790061002100100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "¿Qué narices está pasando?<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2000,
      "rawDecodedUtf16Hex": "00BF0051007500E90020006E006100720069006300650073002000650073007400E100200070006100730061006E0064006F003F00100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "¿A qué viene todo esto?<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2064,
      "rawDecodedUtf16Hex": "00BF004100200071007500E90020007600690065006E006500200074006F0064006F0020006500730074006F003F00100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>Ƌ<U+0001>, <U+0010><U+0002>Ā<U+0000>...<U+0010><U+0001>븁\nTengo la impresión de que el miedo de Hoopa\nestá relacionado con esa distorsión.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Hasta parece preocupado de que pueda existir\notro Hoopa.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2324,
      "rawDecodedUtf16Hex": "0048006100730074006100200070006100720065006300650020007000720065006F00630075007000610064006F002000640065002000710075006500200070007500650064006100200065007800690073007400690072000A006F00740072006F00200048006F006F00700061002E00100002011401A50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "¡Hooo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
