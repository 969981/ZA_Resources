      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "¡Tengo noticias urgentes!<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "00A100540065006E0067006F0020006E006F00740069006300690061007300200075007200670065006E007400650073002100100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Ha aparecido una distorsión extraña.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1272,
