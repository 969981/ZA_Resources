      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "0048006F006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Me pregunto a qué se deberá.<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
