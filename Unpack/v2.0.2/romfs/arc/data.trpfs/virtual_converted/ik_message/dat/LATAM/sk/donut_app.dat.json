      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 87,
      "offsetInSection": 4940,
      "rawDecodedUtf16Hex": "00A10055006E006100200064006F006E00610020006200690065006E002000720069006300610021000A00BF00510075006900650072006500730020007100750065002000700072006500700061007200650020006F007400720061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
