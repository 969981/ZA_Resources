      "flagsUpper16": 4,
      "index": 86,
      "offsetInSection": 4796,
      "rawDecodedUtf16Hex": "00410075006E00710075006500200070007200650070006100720061007200610020006D00E1007300200064006F006E00610073002C0020006D0065002000700061007200650063006500200071007500650020006E006F000A00740065006E0064007200ED006100730020006400F3006E006400650020006C006C0065007600610072006C00610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
