      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 1900,
      "rawDecodedUtf16Hex": "004D0065002000700061007200650063006500200071007500650020006E006F0020007400690065006E0065007300200073007500660069006300690065006E00740065002000640069006E00650072006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "¡Espero volver a verte por aquí!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "00A100450073007000650072006F00200076006F006C0076006500720020006100200076006500720074006500200070006F0072002000610071007500ED00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Parece que no tienes suficiente sitio.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2056,
      "rawDecodedUtf16Hex": "00500061007200650063006500200071007500650020006E006F0020007400690065006E0065007300200073007500660069006300690065006E0074006500200073006900740069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
