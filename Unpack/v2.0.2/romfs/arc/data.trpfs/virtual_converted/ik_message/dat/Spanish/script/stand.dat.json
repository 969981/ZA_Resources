      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "¡Vuelve siempre que quieras!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "00A1005600750065006C007600650020007300690065006D00700072006500200071007500650020007100750069006500720061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "¡Pero si no te caben más!",
