      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¿Te gustaría comprar alguna otra cosa?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 1820,
      "rawDecodedUtf16Hex": "00BF00540065002000670075007300740061007200ED006100200063006F006D007000720061007200200061006C00670075006E00610020006F00740072006100200063006F00730061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Me parece que no tienes suficiente dinero.",
