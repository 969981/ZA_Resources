      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "接下来要去上面了！\n总之，目标是上面就对了！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
