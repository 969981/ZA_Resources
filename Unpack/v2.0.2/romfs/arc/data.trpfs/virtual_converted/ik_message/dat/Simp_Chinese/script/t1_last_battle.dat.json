      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "你的平衡感太棒了！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 396,
      "rawDecodedUtf16Hex": "4F6076845E738861611F592A68D24E86FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "那里可是个难关呢！\n一鼓作气跳过去吧。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 416,
