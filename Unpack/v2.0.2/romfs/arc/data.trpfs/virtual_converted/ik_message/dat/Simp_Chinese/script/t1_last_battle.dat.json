      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "漂～亮的落地！\n实况转播的话应该很上镜吧。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 456,
