      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "57288FD98FB9FF01000A8BF78DDF6211676530020000",
      "trailingZeroPaddingUnits": 1,
