      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "怎会有如此矫健的身手！\n好感动……好感动啊！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "600E4F1A670959826B6477EB506576848EAB624BFF01000A597D611F52A820262026597D611F52A8554AFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "来吧！<U+0010><U+0002>Ā<U+0000>，\n鼓起干劲上吧。",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "67655427FF010010000201000000FF0C000A9F138D775E7252B24E0A542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "哎哟哟，\n可不能大意啊。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "54CE54DF54DFFF0C000A53EF4E0D80FD5927610F554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "哎呀，很遗憾！\n那里是死路！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "54CE5440FF0C5F88905761BEFF01000A90A391CC662F6B7B8DEFFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "啊呀，真遗憾！\n那里得原地折返了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "554A5440FF0C771F905761BEFF01000A90A391CC5F97539F573062988FD44E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "不到最后不要放松警惕！\n你就是密阿雷的希望。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 680,
      "rawDecodedUtf16Hex": "4E0D52306700540E4E0D8981653E677E8B6660D5FF01000A4F605C31662F5BC6963F96F776845E0C671B30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "你终于走到这一步了！\n不要迷茫，前进吧！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "4F607EC84E8E8D7052308FD94E006B654E86FF01000A4E0D89818FF7832BFF0C524D8FDB5427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "跳下去吧！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 772,
      "rawDecodedUtf16Hex": "8DF34E0B53BB5427FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
