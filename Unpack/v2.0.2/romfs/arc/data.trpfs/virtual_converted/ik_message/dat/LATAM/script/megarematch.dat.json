      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Tu mejor tiempo contra <U+0010><U+0002>ā<U+0002> es de\n<U+0010><U+0002>ȁ<U+0003> min<U+0010><U+0001>븀\n<U+0010><U+0002>ȁ<U+0004>.<U+0010><U+0002>ȁ<U+0005> s.<U+0010><U+0001>븀\n¿Estás preparad<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0002>Ĕ<U+000E>",
