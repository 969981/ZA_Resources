      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "004E006F0020007400650020007000720065006F0063007500700065007300200073006900200070006900650072006400650073002C00200065007300200073006F006C006F000A0075006E0061002000730069006D0075006C00610063006900F3006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
