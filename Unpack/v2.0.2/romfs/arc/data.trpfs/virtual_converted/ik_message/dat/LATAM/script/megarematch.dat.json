      "escapedControlUnits": 21,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "¡Impresionante! Lograste derrotarlo en\nsolo <U+0010><U+0002>ȁ<U+0003> min, <U+0010><U+0002>ȁ<U+0004>.<U+0010><U+0002>ȁ<U+0005> s.",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 3100,
      "rawDecodedUtf16Hex": "00A10049006D00700072006500730069006F006E0061006E0074006500210020004C006F00670072006100730074006500200064006500720072006F007400610072006C006F00200065006E000A0073006F006C006F002000100002020100030020006D0069006E002C00200010000202010004002E001000020201000500200073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡Felicitaciones! Superaste el récord anterior.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 3236,
      "rawDecodedUtf16Hex": "00A100460065006C0069006300690074006100630069006F006E006500730021002000530075007000650072006100730074006500200065006C0020007200E90063006F0072006400200061006E0074006500720069006F0072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Toma, aquí tienes la recompensa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 3332,
      "rawDecodedUtf16Hex": "0054006F006D0061002C002000610071007500ED0020007400690065006E006500730020006C00610020007200650063006F006D00700065006E00730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
