      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Añadimos nuevos Pokémon al simulador\nde megaevolución descontrolada.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 49,
      "offsetInSection": 3632,
