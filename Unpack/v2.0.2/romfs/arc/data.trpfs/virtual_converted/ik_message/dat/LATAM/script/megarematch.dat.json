      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 6240,
      "rawDecodedUtf16Hex": "004C006F00670072006100730074006500200064006500720072006F007400610072002000610020001000020201000400200050006F006B00E9006D006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Guauuu, ¿lograste vencerlos a todos?\nEres impresionante, ¡felicitaciones!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 6308,
      "rawDecodedUtf16Hex": "004700750061007500750075002C002000BF006C006F006700720061007300740065002000760065006E006300650072006C006F00730020006100200074006F0064006F0073003F000A004500720065007300200069006D00700072006500730069006F006E0061006E00740065002C002000A100660065006C0069006300690074006100630069006F006E0065007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Completaste el desafío en un total de\n<U+0010><U+0002>ȁ<U+0005> h, <U+0010><U+0002>ȁ<U+0006> min y <U+0010><U+0002>ȁ<U+0007>.<U+0010><U+0002>ȁ<U+0008> s.",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 6456,
      "rawDecodedUtf16Hex": "0043006F006D0070006C00650074006100730074006500200065006C00200064006500730061006600ED006F00200065006E00200075006E00200074006F00740061006C002000640065000A001000020201000500200068002C002000100002020100060020006D0069006E0020007900200010000202010007002E001000020201000800200073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
