      "rawDecodedUtf16Hex": "005500700073002E002000C40068002C0020006900630068002000700072006F006200650020006700650072006100640065002000650069006E00200043006F006D00650064007900700072006F006700720061006D006D000A006D006900740020006D00650069006E0065006D00200050006100720074006E00650072002E00100002011401E80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Panti, panti?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1004,
      "rawDecodedUtf16Hex": "00500061006E00740069002C002000700061006E00740069003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Mein Name ist Mimet und ich bin ein\nImitationskünstler.<U+0010><U+0001>븁\nAber eigentlich kann ich nur Pantifrost\nnachahmen.<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Wenn du schon hier bist, könntest du dir doch\nmal unsere Darbietung ansehen!<U+0010><U+0001>븁\nEs handelt sich dabei um einen Pokémon-Kampf,\nin dem die Attacke <U+0010><U+0002>＀<U+0006>Mimikry<U+0010><U+0002>＀<U+0000> eingesetzt wird!<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 182
    },
    {
      "displayText": "Panti, panti!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "00500061006E00740069002C002000700061006E0074006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "„Panti, panti!“<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "201E00500061006E00740069002C002000700061006E007400690021201C00100002011401E80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Sag Bescheid, wenn du bereit bist für einen\nMimikry-Kampf!<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
