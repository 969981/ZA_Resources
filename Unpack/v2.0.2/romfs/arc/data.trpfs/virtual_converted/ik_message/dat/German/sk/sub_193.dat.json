      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3016,
      "rawDecodedUtf16Hex": "0057006100720020006F006B00610079002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "„Panti, panti!“",
