      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Aber sag mal, hat dir unser Mimikry-Kampf Spaß\ngemacht?<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
