      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "„Das hat er!“<U+0010><U+0001>븁\nFreut mich zu hören!<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
