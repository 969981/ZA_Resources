      "offsetInSection": 2012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "„Noch nicht!“<U+0010><U+0002>ĔǨ",
