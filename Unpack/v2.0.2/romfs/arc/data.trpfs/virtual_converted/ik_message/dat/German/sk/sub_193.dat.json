      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "004400610073002000680061007400200065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
