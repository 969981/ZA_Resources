      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Hier, eine TM für dich, damit du mich nicht\nvergisst!<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
