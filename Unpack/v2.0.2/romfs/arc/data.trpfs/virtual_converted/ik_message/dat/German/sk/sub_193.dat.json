      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Ups. Äh, ich probe gerade ein Comedyprogramm\nmit meinem Partner.<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
