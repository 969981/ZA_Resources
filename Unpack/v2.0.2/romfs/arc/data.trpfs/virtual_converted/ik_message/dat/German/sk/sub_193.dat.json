      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bist du bereit für einen Mimikry-Kampf?<U+0010><U+0002>ĔǨ",
