      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 3516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Aber eins sag ich dir. Wir Nachahmer haben es\nschwer. Also, zumindest so schwer wie diejenigen,<U+0010><U+0001>븀\ndie wir gerade nachahmen.<U+0010><U+0002>ĔǨ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
