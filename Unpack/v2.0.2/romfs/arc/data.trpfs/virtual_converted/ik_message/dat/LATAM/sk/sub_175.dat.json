      "offsetInSection": 6580,
      "rawDecodedUtf16Hex": "00A10042006100610061007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, no sé... no sé qué hacer...<U+0010><U+0002>ĔǏ",
