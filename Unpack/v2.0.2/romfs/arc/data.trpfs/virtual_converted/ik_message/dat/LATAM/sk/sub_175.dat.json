      "rawDecodedUtf16Hex": "00A10050006100720065006300650020007100750065002000460072006900670069006200610078002000650073007400E1002000660065006C0069007A00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "¡Mira cómo sonríe Frigibax!",
      "escapedControlUnits": 0,
