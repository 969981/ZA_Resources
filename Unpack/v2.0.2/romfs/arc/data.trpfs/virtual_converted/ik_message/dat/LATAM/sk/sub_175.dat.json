      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 6596,
      "rawDecodedUtf16Hex": "0010000201000000002C0020006E006F0020007300E9002E002E002E0020006E006F0020007300E900200071007500E9002000680061006300650072002E002E002E00100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¡Parece que Frigibax está feliz!",
