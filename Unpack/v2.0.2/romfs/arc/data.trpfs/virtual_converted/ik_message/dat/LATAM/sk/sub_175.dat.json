      "index": 60,
      "offsetInSection": 6740,
      "rawDecodedUtf16Hex": "00A1004D0069007200610020006300F3006D006F00200073006F006E007200ED006500200046007200690067006900620061007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Sí, es ver-verdad, pero... estar tan cerca de otras\npersonas... me agobia... Ay...<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Ah, ¡no te preocupes! Podemos mantener\ndistancia mientras charlamos, si lo prefieres.<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 62,
      "offsetInSection": 6972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Aunque no hablemos demasiado, es genial ver\ndivertirse a nuestros Pokémon, ¿cierto?<U+0010><U+0002>ĔǑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 63,
      "offsetInSection": 7152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Siempre estoy presumiendo a mi Zangoose.\nTú también presume a tu Frigibax conmigo.<U+0010><U+0002>Ĕǒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 7328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
