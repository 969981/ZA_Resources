      "offsetInSection": 7588,
      "rawDecodedUtf16Hex": "00100002BDFF00430000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Soy bastante tímida, pero... es un placer\nconocerlos.<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 7600,
      "rawDecodedUtf16Hex": "0053006F0079002000620061007300740061006E007400650020007400ED006D006900640061002C0020007000650072006F002E002E002E00200065007300200075006E00200070006C0061006300650072000A0063006F006E006F006300650072006C006F0073002E00100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "¡Bax!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
