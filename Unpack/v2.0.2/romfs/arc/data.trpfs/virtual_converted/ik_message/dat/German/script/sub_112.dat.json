  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Diesem wilden Fynx hier scheint irgendetwas\nzu fehlen...<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "00440069006500730065006D002000770069006C00640065006E002000460079006E007800200068006900650072002000730063006800650069006E007400200069007200670065006E006400650074007700610073000A007A00750020006600650068006C0065006E002E002E002E00100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Fy...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 468,
      "rawDecodedUtf16Hex": "00460079002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Es will einfach nichts fressen... Nicht mal im\nPokémon-Center wussten sie Rat.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Oh, da fällt mir ein, früher gab es in Illumina\neinen Heilkundeladen!<U+0010><U+0001>븁\nSein ehemaliger Besitzer weiß ganz bestimmt,\nwelche Medizin dem armen Fynx helfen kann.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 165
    },
    {
      "displayText": "Ich muss hier auf das Kleine aufpassen...<U+0010><U+0001>븁\nWärst du so lieb, den ehemaligen Ladenbesitzer\num Rat zu fragen?<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 114
    },
    {
      "displayText": "Ich weiß, dass er oft das Café à la Mode besucht.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "004900630068002000770065006900DF002C002000640061007300730020006500720020006F006600740020006400610073002000430061006600E9002000E00020006C00610020004D006F0064006500200062006500730075006300680074002E00100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1316,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich weiß, dass der ehemalige Besitzer oft im\nCafé à la Mode einkehrt.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "004900630068002000770065006900DF002C0020006400610073007300200064006500720020006500680065006D0061006C006900670065002000420065007300690074007A006500720020006F0066007400200069006D000A00430061006600E9002000E00020006C00610020004D006F00640065002000650069006E006B0065006800720074002E00100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh, hallo! Kann ich dir irgendwie helfen?<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1488,
      "rawDecodedUtf16Hex": "004F0068002C002000680061006C006C006F00210020004B0061006E006E0020006900630068002000640069007200200069007200670065006E0064007700690065002000680065006C00660065006E003F001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Sind Sie der Spezialist für Heilkunde?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "00530069006E0064002000530069006500200064006500720020005300700065007A00690061006C0069007300740020006600FC00720020004800650069006C006B0075006E00640065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Es geht um ein erschöpftes Pokémon...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1660,
      "rawDecodedUtf16Hex": "004500730020006700650068007400200075006D002000650069006E00200065007200730063006800F60070006600740065007300200050006F006B00E9006D006F006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Ich verstehe. Ein kraftloses Fynx also...<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1736,
      "rawDecodedUtf16Hex": "004900630068002000760065007200730074006500680065002E002000450069006E0020006B0072006100660074006C006F007300650073002000460079006E007800200061006C0073006F002E002E002E001000020114001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Fynx kauen gern auf Zweigen herum. Sie dienen\nihnen als nahrhafte und beruhigende Snacks.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Ich kann mir vorstellen, dass ein Vitalzweig\ndieses Fynx wieder aufpäppeln würde.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Aber Vitalzweige findet man in dieser Stadt nur\ndort, wo sich jetzt Wildsektor 5 befindet...<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2188,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Vitalzweige erkennt man an ihrem süßen Duft.<U+0010><U+0001>븁\nEs ist sicher nicht leicht, nach ihnen Ausschau\nzu halten, während man von wilden Pokémon<U+0010><U+0001>븀\nverfolgt wird... Also viel Glück!<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 179
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2744,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vitalzweige findest du am ehesten in Wildsektor 5\nder Zone Cyan. Man erkennt sie am süßen Duft.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2956,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Dieser Zweig ist ein bisschen verschrumpelt...\nDas scheint kein Vitalzweig zu sein.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Dieser Zweig wurde wohl angeknabbert...\nDas scheint kein Vitalzweig zu sein.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Von diesem Zweig ist ein Stück abgebrochen...\nDas scheint kein Vitalzweig zu sein.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3292,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Dieser Zweig ist ganz trocken und brüchig...\nDas scheint kein Vitalzweig zu sein.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3460,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Von diesem Zweig geht ein süßlicher Duft aus...\nDu hast einen Vitalzweig gefunden!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Bring ihn zum angeschlagenen Fynx!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3792,
      "rawDecodedUtf16Hex": "004200720069006E0067002000690068006E0020007A0075006D00200061006E00670065007300630068006C006100670065006E0065006E002000460079006E007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3864,
      "rawDecodedUtf16Hex": "00100002BDFF001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ein Vitalzweig also...<U+0010><U+0001>븁\nIch wusste ja, dass man sich auf jemanden\nverlassen kann, der mal einen Heilkundeladen<U+0010><U+0001>븀\nbetrieben hat. Und natürlich auf dich!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 159
    },
    {
      "displayText": "Los, gib ihn Fynx, damit es daran knabbern kann!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4196,
      "rawDecodedUtf16Hex": "004C006F0073002C0020006700690062002000690068006E002000460079006E0078002C002000640061006D0069007400200065007300200064006100720061006E0020006B006E00610062006200650072006E0020006B0061006E006E002100100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Du gibst Fynx den Vitalzweig!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4304,
      "rawDecodedUtf16Hex": "00440075002000670069006200730074002000460079006E0078002000640065006E00200056006900740061006C007A0077006500690067002100100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Fyyy!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4372,
      "rawDecodedUtf16Hex": "004600790079007900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Ach, was bin ich erleichtert. Es geht ihm wirklich\nwieder gut!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4384,
      "rawDecodedUtf16Hex": "004100630068002C0020007700610073002000620069006E0020006900630068002000650072006C00650069006300680074006500720074002E00200045007300200067006500680074002000690068006D0020007700690072006B006C006900630068000A0077006900650064006500720020006700750074002100100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Fynx!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4520,
      "rawDecodedUtf16Hex": "00460079006E007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Du liebe Zeit, Fynx scheint dich ja sehr zu mögen.\nWie wäre es, wenn du es bei dir aufnimmst?<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Fynx!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4728,
      "rawDecodedUtf16Hex": "00460079006E007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Du erhältst Fynx!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4740,
      "rawDecodedUtf16Hex": "00440075002000650072006800E4006C007400730074002000460079006E007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Kümmer dich gut um das Kleine, ja?<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4776,
      "rawDecodedUtf16Hex": "004B00FC006D006D0065007200200064006900630068002000670075007400200075006D00200064006100730020004B006C00650069006E0065002C0020006A0061003F00100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Bitte schaffe Platz in deinen Boxen,\ndamit du Fynx mitnehmen kannst.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4856,
      "rawDecodedUtf16Hex": "004200690074007400650020007300630068006100660066006500200050006C00610074007A00200069006E0020006400650069006E0065006E00200042006F00780065006E002C000A00640061006D00690074002000640075002000460079006E00780020006D00690074006E00650068006D0065006E0020006B0061006E006E00730074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "<U+0010><U+0002>뷿'",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4996,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Fynx hat sicher mitbekommen, wie sehr du dich\nfür es ins Zeug gelegt hast.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5008,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
