  "messages": [
    {
      "displayText": "Möchtest du eine Spezialsuche durchführen, um\neine spezielle Dimensionsverzerrung zu finden?<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
