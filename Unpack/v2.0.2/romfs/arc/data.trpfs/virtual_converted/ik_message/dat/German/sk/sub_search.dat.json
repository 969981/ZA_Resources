      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Sag Bescheid, falls du es dir anders überlegst.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 336,
