      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Verstanden. Dann aktiviere ich mal die\nSpezialsuche!<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 440,
      "rawDecodedUtf16Hex": "005600650072007300740061006E00640065006E002E002000440061006E006E00200061006B007400690076006900650072006500200069006300680020006D0061006C0020006400690065000A005300700065007A00690061006C00730075006300680065002100100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Du hast die spezielle Verzerrung, die zuvor geortet\nwurde, noch nicht untersucht.<U+0010><U+0001>븁\nWenn wir eine neue Spezialsuche durchführen,\ngeht sie verloren. Möchtest du trotzdem<U+0010><U+0001>븀\nfortfahren?<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 189
    },
    {
      "displayText": "Gipson hier.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 936,
      "rawDecodedUtf16Hex": "0047006900700073006F006E00200068006900650072002E00100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Du hast genügend Punkte gesammelt und kannst\nsomit nun eine Spezialsuche durchführen.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 972,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Bitte statte dem Boss in seinem Büro einen\nBesuch ab.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "004200690074007400650020007300740061007400740065002000640065006D00200042006F0073007300200069006E0020007300650069006E0065006D0020004200FC0072006F002000650069006E0065006E000A004200650073007500630068002000610062002E00100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Du hast noch nicht genügend Punkte.<U+0010><U+0001>븁\nBitte erfülle mehr Dimensionsaufträge im\nDimensions-Illumina.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 5,
