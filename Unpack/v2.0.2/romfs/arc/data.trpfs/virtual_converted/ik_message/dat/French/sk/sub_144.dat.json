      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "J’aimerais que tu m’accordes un duel de Lucario !\nUn contre un ! Sans retenue ! On donne tout !<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
