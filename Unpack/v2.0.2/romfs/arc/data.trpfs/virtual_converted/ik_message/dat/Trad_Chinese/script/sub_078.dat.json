      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "62119858610F5E6B5FD9FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
