      "rawDecodedUtf16Hex": "7A0D7B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我會付報酬給<U+0010><U+0003>ᄀÿā你妳的！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "621167034ED85831916C7D6600100003110000FF01014F6059B37684FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "演員到齊了！\n開始拍攝吧！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1156,
      "rawDecodedUtf16Hex": "6F1454E152309F4A4E86FF01000A958B59CB62CD651D5427FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "接著拍下一段畫面！\n預備……Action！<U+0010><U+0002>ĔŰ",
