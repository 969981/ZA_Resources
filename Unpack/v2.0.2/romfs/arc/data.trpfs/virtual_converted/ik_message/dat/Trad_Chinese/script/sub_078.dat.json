      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "62CD651D90846C9267098981958B59CB55CEFF1F00100002011401950000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
