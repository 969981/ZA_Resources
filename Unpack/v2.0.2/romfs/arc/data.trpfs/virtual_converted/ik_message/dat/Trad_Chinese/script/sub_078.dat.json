      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "5361FF5EFF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "怎麼了，利牙魚！？\n要嘩～地襲擊上去才行啊！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "600E9EBC4E86FF0C522972599B5AFF01FF1F000A89815629FF5E5730897264CA4E0A53BB624D884C554AFF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "牙叭叭……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1380,
      "rawDecodedUtf16Hex": "725953ED53ED202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "那個……導演……\n我查了一下。<U+0010><U+0002>Ĕƕ",
      "escapedControlUnits": 2,
