      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "00100002BDFF00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "害怕人類的利牙魚……\n就這樣也會是很讚的畫面喔！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
