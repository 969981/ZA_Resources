      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "如果<U+0010><U+0003>ᄀÿā你妳願意幫忙拍攝的話，\n就將利牙魚加入到同行隊伍吧！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "5982679C00100003110000FF01014F6059B39858610F5E6B5FD962CD651D76848A71FF0C000A5C315C07522972599B5A52A051655230540C884C968A4F0D5427FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
