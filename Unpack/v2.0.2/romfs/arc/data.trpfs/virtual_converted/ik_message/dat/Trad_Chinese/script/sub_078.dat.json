      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "不過，被人類嚇得\n瑟瑟發抖的利牙魚嗎……<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "4E0D904EFF0C88AB4EBA985E56875F97000A745F745F767C62967684522972599B5A55CE2026202600100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "這好像也不錯！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1592,
      "rawDecodedUtf16Hex": "9019597D50CF4E5F4E0D932FFF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "雖然和我預想的不一樣，\n但感覺能拍到不錯的畫面！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1616,
      "rawDecodedUtf16Hex": "96D67136548C6211981060F376844E0D4E006A23FF0C000A4F46611F89BA80FD62CD52304E0D932F7684756B9762FF0100100002011401700000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
