      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "哦哦！<U+0010><U+0003>ᄀÿā你妳願意用<U+0010><U+0003>ᄀÿā你妳的利牙魚\n來幫忙拍攝嗎？<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
