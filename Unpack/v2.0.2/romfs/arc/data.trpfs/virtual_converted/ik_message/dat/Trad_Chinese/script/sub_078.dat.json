      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "利牙魚在只有1隻的時候\n好像會變得非常膽小喔。<U+0010><U+0002>Ĕƕ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
