      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 976,
      "rawDecodedUtf16Hex": "597D7DCA5F35554A2026202600100002011401960000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
