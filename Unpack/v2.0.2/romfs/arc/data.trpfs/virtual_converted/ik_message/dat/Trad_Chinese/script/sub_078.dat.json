      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "什麼！這樣沒辦法拍到\n我想像中的畫面啊！<U+0010><U+0002>ĔŰ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
