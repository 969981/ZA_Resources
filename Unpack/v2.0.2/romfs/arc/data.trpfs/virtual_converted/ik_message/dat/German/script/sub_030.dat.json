      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "0052006900690069006E006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ich würde dir gerne dieses <U+0010><U+0002>ā<U+0003>\nüberlassen.<U+0010><U+0001>븁\nDu hast dich so lieb bereit erklärt, meiner\nkomischen Bitte nachzukommen, da habe ich<U+0010><U+0001>븀\nkeine Bedenken, es dir anzuvertrauen.<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 12,
