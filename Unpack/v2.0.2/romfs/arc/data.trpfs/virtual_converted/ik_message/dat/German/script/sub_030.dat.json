      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bitte kauf mir bei der Stein-Boutique entweder\ndas <U+0010><U+0002>＀<U+0006>Kieferfossil<U+0010><U+0002>＀<U+0000> oder das <U+0010><U+0002>＀<U+0006>Flossenfossil<U+0010><U+0002>＀<U+0000>!<U+0010><U+0001>븁\nDu findest die Stein-Boutique auf der\nFrühlingsallee.<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
