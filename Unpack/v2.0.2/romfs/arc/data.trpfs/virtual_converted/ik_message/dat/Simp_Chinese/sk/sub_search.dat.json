      "rawDecodedUtf16Hex": "4E0065E65F0059CB641C7D22FF0C000A5C314F1A627E4E0D52308FD86CA18C0367E5768472796B8A5F026B215143626D6D1E300200100001BE00000A786E5B9A6CA195EE98985417FF1F00100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "辛苦了。<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "8F9B82E64E86300200100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "已经累积到了需要的点数，\n现在可以发动特殊搜寻了。<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 360,
      "rawDecodedUtf16Hex": "5DF27ECF7D2F79EF52304E8697008981768470B96570FF0C000A73B0572853EF4EE553D152A872796B8A641C5BFB4E86300200100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "可以的话，就劳驾你来一趟\n乌羽先生的房间吧。<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 420,
