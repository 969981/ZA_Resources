      "rawDecodedUtf16Hex": "004F007000740069006F006E00200033003A00200042006F00720065007600610072006400200042006F0075006C006500760061007200640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "I’ve got an even better idea",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 4044,
      "rawDecodedUtf16Hex": "004920190076006500200067006F007400200061006E0020006500760065006E0020006200650074007400650072002000690064006500610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Lumiose Grand Avenue!<U+0010><U+0001>븁\nYes! It may be a bit exaggerated now, but in time\nour road will surely grow to deserve such a name!<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 4104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "Mega Evolution Road, yes!<U+0010><U+0001>븁\nAnd in time, people will probably come up with\ntheir own stories about how Mega Evolution grew<U+0010><U+0001>븀\nand developed in this area!<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 4364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 159
    },
    {
      "displayText": "Yes! Borevard Boulevard!<U+0010><U+0001>븁\nThat is the only possible name for this street!<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4684,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Y-you want to throw out all our suggestions and\ngo back to the drawing board?!<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "<U+0010><U+0001>ဃ<U+0010><U+0002>Ā<U+0002>!<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 5012,
      "rawDecodedUtf16Hex": "0010000110030010000201000002002100100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "I think it’s perfect!<U+0010><U+0002>ĔƲ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 5040,
      "rawDecodedUtf16Hex": "00490020007400680069006E006B0020006900742019007300200070006500720066006500630074002100100002011401B20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "I agree.<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 5092,
      "rawDecodedUtf16Hex": "0049002000610067007200650065002E00100002011401B30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "I feel just the same! Nothing boring about that\nidea!<U+0010><U+0002>Ĕƴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 5120,
      "rawDecodedUtf16Hex": "00490020006600650065006C0020006A0075007300740020007400680065002000730061006D006500210020004E006F007400680069006E006700200062006F00720069006E0067002000610062006F0075007400200074006800610074000A0069006400650061002100100002011401B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Then from this day onward, this street shall be\nknown as <U+0010><U+0001>ဃ<U+0010><U+0002>Ā<U+0002>!<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 7,
