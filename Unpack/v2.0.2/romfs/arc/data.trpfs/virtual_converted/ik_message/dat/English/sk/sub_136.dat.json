      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "From this day forward, this street’s name shall be\nLumiose Grand Avenue!<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 5376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "From this day forward, this street’s name shall be\nMega Evolution Road!<U+0010><U+0002>ĔƳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 5532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
