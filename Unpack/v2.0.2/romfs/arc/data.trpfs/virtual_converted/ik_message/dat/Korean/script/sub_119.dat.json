      "rawDecodedUtf16Hex": "B0D0C544C559003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "냐앙!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "B0D0C559002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>,\n우리도 따라가 보자!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 43,
