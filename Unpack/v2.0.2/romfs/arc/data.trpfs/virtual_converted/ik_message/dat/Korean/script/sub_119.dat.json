      "offsetInSection": 2864,
      "rawDecodedUtf16Hex": "00100002BDFF002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "모냥, 홀로베이터 앞에서\n뭐 하는 거야?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2876,
