      "rawDecodedUtf16Hex": "B0D0C559002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "거의 다 온 모양이야.<U+0010><U+0002>Ĕ<U+0008>",
