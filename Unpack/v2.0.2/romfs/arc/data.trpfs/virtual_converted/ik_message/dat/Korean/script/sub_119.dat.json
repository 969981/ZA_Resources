      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 2948,
      "rawDecodedUtf16Hex": "B0D0C559002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "위에 있다는 거지?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2960,
      "rawDecodedUtf16Hex": "C704C5D00020C788B2E4B2940020AC70C9C0003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
