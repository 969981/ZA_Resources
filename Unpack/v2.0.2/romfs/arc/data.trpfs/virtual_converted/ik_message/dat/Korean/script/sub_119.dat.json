      "offsetInSection": 3040,
      "rawDecodedUtf16Hex": "0010000201000000002C000AC704C5D0C11C0020AE30B2E4B9ACACE00020C788C744AC8C002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
