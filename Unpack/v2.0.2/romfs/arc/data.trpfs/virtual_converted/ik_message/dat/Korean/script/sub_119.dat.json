      "rawDecodedUtf16Hex": "AC70C7580020B2E40020C6280020BAA8C591C774C57C002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>,\n위에서 기다리고 있을게!<U+0010><U+0002>Ĕ<U+0008>",
