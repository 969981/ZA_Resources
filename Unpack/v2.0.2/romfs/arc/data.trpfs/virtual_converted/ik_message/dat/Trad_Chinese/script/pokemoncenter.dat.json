      "index": 41,
      "offsetInSection": 1380,
      "rawDecodedUtf16Hex": "8B1D8B1D60A85B8C6210767B9304FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "在您生日的<U+0010><U+0002>ȁ<U+0001>月<U+0010><U+0002>ȁ<U+0002>日時，\n請到寶可夢中心來喔。",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "572860A8751F65E5768400100002020100016708001000020201000265E56642FF0C000A8ACB52305BF653EF59224E2D5FC34F86559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "有您生日那一天的年分請在當天……\n沒有的話請在2月28日<U+0010><U+0001>븀\n到寶可夢中心來喔。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "670960A8751F65E590A34E00592976845E7452068ACB57287576592920262026000A6C92670976848A718ACB5728003267080032003865E500100001BE00000A52305BF653EF59224E2D5FC34F86559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "生日隨時都可以登錄，\n有需要的話請跟我說一聲。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 1544,
      "rawDecodedUtf16Hex": "751F65E596A8664290FD53EF4EE5767B9304FF0C000A67099700898176848A718ACB8DDF62118AAA4E00807230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "期待您再次光臨！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 1592,
      "rawDecodedUtf16Hex": "671F5F8560A8518D6B21514981E8FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>ȁ<U+0001>月<U+0010><U+0002>ȁ<U+0002>日？\n哇，就是今天對吧！？<U+0010><U+0001>븁\n我這就去準備，請您稍等一下！",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 1612,
      "rawDecodedUtf16Hex": "00100002020100016708001000020201000265E5FF1F000A54C7FF0C5C31662F4ECA59295C0D5427FF01FF1F00100001BE01000A621190195C3153BB6E965099FF0C8ACB60A87A0D7B494E004E0BFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "<U+0010><U+0002>ȁ<U+0001>月<U+0010><U+0002>ȁ<U+0002>日？\n今天是2月28日，<U+0010><U+0001>븀\n而且今年要把今天當作生日當天對吧！？<U+0010><U+0001>븁\n我這就去準備，請您稍等一下！",
