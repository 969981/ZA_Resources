      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "00100002020100016708001000020201000265E5FF1F000A4ECA5929662F003267080032003865E5FF0C00100001BE00000A800C4E144ECA5E748981628A4ECA592975764F5C751F65E5757659295C0D5427FF01FF1F00100001BE01000A621190195C3153BB6E965099FF0C8ACB60A87A0D7B494E004E0BFF010000",
      "trailingZeroPaddingUnits": 1,
