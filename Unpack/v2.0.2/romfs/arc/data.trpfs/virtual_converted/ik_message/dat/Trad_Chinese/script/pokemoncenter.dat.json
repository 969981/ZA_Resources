      "rawDecodedUtf16Hex": "0010000201000000FF01000A60A889814E0D8981767B9304751F65E55462FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "只要登錄一次之後就不能變更，\n因此輸入時請小心喔。",
      "escapedControlUnits": 0,
