      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Ouais, c’est bien ce que j’pensais.\nAllez, dégage !<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "004F0075006100690073002C0020006320190065007300740020006200690065006E00200063006500200071007500650020006A201900700065006E0073006100690073002E000A0041006C006C0065007A002C0020006400E9006700610067006500200021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Tu l’auras cherché !<U+0010><U+0002>Ĕ<U+001D>",
