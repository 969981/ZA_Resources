      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Qu’est-ce que tu mates, toi ?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 492,
      "rawDecodedUtf16Hex": "005100752019006500730074002D0063006500200071007500650020007400750020006D0061007400650073002C00200074006F00690020003F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Pas mon Holoporteur, j’espère ?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "0050006100730020006D006F006E00200048006F006C006F0070006F00720074006500750072002C0020006A201900650073007000E8007200650020003F001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "C’est MON Holoporteur, t’as pigé ?\nTu voulais l’utiliser ? Rêve toujours, c’est mort.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Si tu tiens tant qu’ça à l’utiliser, va falloir me\npasser sur le corps !<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "En attendant, disparais ! Et si tu t’repointes ici,\nt’as intérêt à être prêt<U+0010><U+0003>ᄀÿĀe pour la baston !<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
