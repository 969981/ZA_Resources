      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Si tu tiens tant qu’ça à utiliser MON Holoporteur,\nva falloir me passer sur le corps !<U+0010><U+0002>Ĕ<U+001D>",
