      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "ADF8B9CCB454B2E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "말씀하신 싸리용과 다른 걸 보여 주시다니...\n좀 별로네요.<U+0010><U+0002>ĔǞ",
