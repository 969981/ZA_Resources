      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "그럼... 다른 모습의 싸리용도\n부탁드릴게요.<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
