      "index": 9,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "B108BB340020C5F4C2ECD7880020D558B2940020AC700020C544B2C8C57C0021003F000AC774C8200020C138AE30B3C40020D798B4E4B2E4ACE00021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "남은 시간 <U+0010><U+0002>＀<U+0006>30초<U+0010><U+0002>＀<U+0000>!<U+0010><U+0002>Ĕ<U+000F>",
