      "index": 17,
      "offsetInSection": 1156,
      "rawDecodedUtf16Hex": "B9E8BAB80020C11CBC14C774BC84C5D00020B3C4C804D558B2940020AC70B77CBA74000AC5B8C81CB4E0C9C00020D658C601C774B2C80020B6100020B3C4C804D5740020BD100021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
