      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "너무 열심히 하는 거 아니야!?\n이젠 세기도 힘들다고!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
