      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Mais il y a un souci... On ne peut pas installer de\nnouveaux panneaux d’un claquement de doigts.<U+0010><U+0002>Ĕǜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
