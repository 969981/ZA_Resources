      "index": 12,
      "offsetInSection": 1412,
      "rawDecodedUtf16Hex": "004300650074007400650020006600720061006700720061006E006300650020006D0065002000720061007000700065006C006C006500200075006E00200073006F007500760065006E00690072000A006420190065006E00660061006E00630065002E002E002E00100002011401310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "J’étais toute petite, mais je me souviens avoir\nun jour fait le tour d’Illumis à dos de Cabriolaine...<U+0010><U+0002>Ĕı",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
