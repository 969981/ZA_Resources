      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Je peux vous offrir <U+0010><U+0003>ȇ<U+0000>  <U+E300> pour cela.\nEst-ce que vous êtes d’accord ?",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 94,
