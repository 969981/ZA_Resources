      "flagsUpper16": 4,
      "index": 111,
      "offsetInSection": 5860,
      "rawDecodedUtf16Hex": "0049006C00200076006F0075007300200066006100750074002000610075007400720065002000630068006F007300650020003F00100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Merci beaucoup !<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 112,
      "offsetInSection": 5920,
      "rawDecodedUtf16Hex": "004D0065007200630069002000620065006100750063006F007500700020002100100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
