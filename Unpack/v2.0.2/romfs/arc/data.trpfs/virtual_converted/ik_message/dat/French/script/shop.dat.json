      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Vous possédez un grand nombre d’exemplaires\nde cet objet. Vous ne pouvez pas en porter plus.<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
