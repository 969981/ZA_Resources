      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F00750073002000720065006E006F006E006300650072002000E00020006C2019006100630068006100740020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Voulez-vous renoncer à l’achat et\nvendre quelque chose à la place ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 98,
      "offsetInSection": 4364,
      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F00750073002000720065006E006F006E006300650072002000E00020006C201900610063006800610074002000650074000A00760065006E0064007200650020007100750065006C007100750065002000630068006F00730065002000E00020006C006100200070006C0061006300650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Voulez-vous renoncer à la vente ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 99,
      "offsetInSection": 4500,
      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F00750073002000720065006E006F006E006300650072002000E00020006C0061002000760065006E007400650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Voulez-vous renoncer à la vente et\nacheter quelque chose à la place ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 100,
      "offsetInSection": 4568,
      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F00750073002000720065006E006F006E006300650072002000E00020006C0061002000760065006E00740065002000650074000A00610063006800650074006500720020007100750065006C007100750065002000630068006F00730065002000E00020006C006100200070006C0061006300650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Toutes mes excuses, mais on dirait que\nvous n’avez pas assez d’argent.<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 101,
      "offsetInSection": 4708,
      "rawDecodedUtf16Hex": "0054006F00750074006500730020006D0065007300200065007800630075007300650073002C0020006D0061006900730020006F006E00200064006900720061006900740020007100750065000A0076006F007500730020006E2019006100760065007A002000700061007300200061007300730065007A0020006420190061007200670065006E0074002E00100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Vous en possédez déjà un très grand nombre.\nVous ne pouvez pas en porter davantage.<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 102,
      "offsetInSection": 4856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Soyez l<U+0010><U+0003>ᄀÿāea bienvenu<U+0010><U+0003>ᄀÿĀe au Joyau de Kalos !<U+0010><U+0001>븁",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 103,
      "offsetInSection": 5032,
      "rawDecodedUtf16Hex": "0053006F00790065007A0020006C00100003110000FF0101006500610020006200690065006E00760065006E007500100003110000FF010000650020006100750020004A006F0079006100750020006400650020004B0061006C006F00730020002100100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Avez-vous besoin d’autre chose ?<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 104,
      "offsetInSection": 5140,
      "rawDecodedUtf16Hex": "004100760065007A002D0076006F007500730020006200650073006F0069006E00200064201900610075007400720065002000630068006F007300650020003F00100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Nous vous remercions de votre visite !<U+0010><U+0001>븁",
