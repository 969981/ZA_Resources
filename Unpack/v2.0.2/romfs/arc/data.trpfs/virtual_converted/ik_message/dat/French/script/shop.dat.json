      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Vous n’en voulez plus, finalement ?<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 114,
