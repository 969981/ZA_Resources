      "flagsUpper16": 0,
      "index": 95,
      "offsetInSection": 3904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "Nous vous offrons <U+0010><U+0002>ȁ<U+0000> Honor Ball<U+0010><U+0003>ᄁ<U+0000>Ās en cadeau !<U+0010><U+0001>븁",
      "escapedControlUnits": 8,
