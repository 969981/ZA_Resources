      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Toutes mes excuses, mais cet article est\nen rupture de stock.<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 106,
      "offsetInSection": 5296,
      "rawDecodedUtf16Hex": "0054006F00750074006500730020006D0065007300200065007800630075007300650073002C0020006D0061006900730020006300650074002000610072007400690063006C00650020006500730074000A0065006E00200072007500700074007500720065002000640065002000730074006F0063006B002E00100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Souhaitez-vous remettre en rayon ce que\nvous avez choisi ?<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 107,
      "offsetInSection": 5428,
      "rawDecodedUtf16Hex": "0053006F007500680061006900740065007A002D0076006F00750073002000720065006D0065007400740072006500200065006E0020007200610079006F006E0020006300650020007100750065000A0076006F007500730020006100760065007A002000630068006F0069007300690020003F00100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "On dirait que vous n’avez pas assez de sous.<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 108,
      "offsetInSection": 5552,
      "rawDecodedUtf16Hex": "004F006E0020006400690072006100690074002000710075006500200076006F007500730020006E2019006100760065007A002000700061007300200061007300730065007A00200064006500200073006F00750073002E00100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Houla, vous en avez déjà bien assez, non ?<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 109,
      "offsetInSection": 5648,
      "rawDecodedUtf16Hex": "0048006F0075006C0061002C00200076006F0075007300200065006E0020006100760065007A0020006400E9006A00E00020006200690065006E00200061007300730065007A002C0020006E006F006E0020003F00100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Bienvenue !\nJ’espère que vous trouverez votre bonheur !<U+0010><U+0001>븁",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 110,
      "offsetInSection": 5740,
      "rawDecodedUtf16Hex": "004200690065006E00760065006E0075006500200021000A004A201900650073007000E800720065002000710075006500200076006F00750073002000740072006F00750076006500720065007A00200076006F00740072006500200062006F006E00680065007500720020002100100001BE010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Il vous faut autre chose ?<U+0010><U+0001>븁",
