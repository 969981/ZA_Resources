      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "우두머리 뿔충이를\n잡는 데 성공한 모양이군.<U+0010><U+0002>Ĕļ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
