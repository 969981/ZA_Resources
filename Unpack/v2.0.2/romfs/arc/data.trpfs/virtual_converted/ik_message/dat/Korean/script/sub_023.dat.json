      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "내가 정원수를\n너무 훌륭하게 가꾼 건가...?<U+0010><U+0002>Ĕļ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "B0B4AC000020C815C6D0C218B97C000AB108BB340020D6CCB96DD558AC8C0020AC00AFBC0020AC74AC00002E002E002E003F001000020114013C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "쫓아내는 것보다는\n우두머리 뿔충이를 잡아 버리면<U+0010><U+0001>븀\n다른 뿔충이도 오지 않게 될지도 모르겠군.<U+0010><U+0002>Ĕļ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 476,
      "rawDecodedUtf16Hex": "CAD3C544B0B4B2940020AC83BCF4B2E4B294000AC6B0B450BA38B9AC0020BFD4CDA9C774B97C0020C7A1C5440020BC84B9ACBA7400100001BE00000AB2E4B9780020BFD4CDA9C774B3C40020C624C9C00020C54AAC8C0020B420C9C0B3C40020BAA8B974ACA0AD70002E001000020114013C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
