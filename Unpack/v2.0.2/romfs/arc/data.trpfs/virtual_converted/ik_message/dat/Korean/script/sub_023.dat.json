      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "이제 정원수는 안심해도 되겠지?<U+0010><U+0002>Ĕļ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
