      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Cette espèce vit en hauteur.\nOn peut l’apercevoir dans les arbres.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 104,
      "offsetInSection": 2992,
