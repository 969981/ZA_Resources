      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Cette espèce vit en hauteur.\nOn peut l’apercevoir près\ndes étals de marchands.",
      "escapedControlUnits": 0,
