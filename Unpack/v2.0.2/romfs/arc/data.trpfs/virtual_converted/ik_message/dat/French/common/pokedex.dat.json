      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 108,
      "offsetInSection": 3544,
      "rawDecodedUtf16Hex": "00430065007400740065002000650073007000E800630065002000760069007400200065006E00200068006100750074006500750072002E000A0045006C006C0065002000610070007000610072006100EE007400200072006100720065006D0065006E0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
