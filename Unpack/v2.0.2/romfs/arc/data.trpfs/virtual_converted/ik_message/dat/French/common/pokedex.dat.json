      "rawDecodedUtf16Hex": "00430065007400740065002000650073007000E800630065002000610070007000610072006100EE007400200075006E0069007100750065006D0065006E0074002000700061007200200062006500610075002000740065006D00700073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
