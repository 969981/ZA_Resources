      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Goomy! Ti avevo detto di non allontanarti!<U+0010><U+0002>Ĕ!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 3192,
