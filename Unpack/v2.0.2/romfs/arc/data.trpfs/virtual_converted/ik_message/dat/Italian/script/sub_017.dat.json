      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Scusami tanto. Ultimamente in città ci sono così\ntanti Pokémon selvatici che sento di dover fare di<U+0010><U+0001>븀\ntutto per prevenire eventuali problemi.<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 4,
      "flagsUpper16": 8,
      "index": 43,
      "offsetInSection": 3624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 147
    },
    {
