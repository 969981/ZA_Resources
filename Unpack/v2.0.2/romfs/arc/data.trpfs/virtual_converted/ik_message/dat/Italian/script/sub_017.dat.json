      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 3304,
      "rawDecodedUtf16Hex": "00470075006100720064006100200063006F006D006500200068006100690020007200690064006F00740074006F0020006C0061002000700061006E006300680069006E0061002E002E002E000A00C8002000740075007400740061002000610070007000690063006300690063006F00730061002E002E002E002100100002011400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ok, ora è tutto pulito. Forza Goomy, torniamocene\na casa!<U+0010><U+0002>Ĕ!",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 3440,
