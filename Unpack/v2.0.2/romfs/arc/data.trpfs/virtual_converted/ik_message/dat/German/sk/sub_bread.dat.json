      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Aber!! Die sind strikt limitiert! Es gibt jeden Tag\nnur ein Brot pro Person.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Canary-Brot, niedlich und lecker!\nNa, darf’s eins sein?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "00430061006E006100720079002D00420072006F0074002C0020006E006900650064006C00690063006800200075006E00640020006C00650063006B006500720021000A004E0061002C0020006400610072006620190073002000650069006E00730020007300650069006E003F00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Canary-Brot, niedlich und lecker! Na, darf’s\neins sein? Das wären dann 1300 <U+E300>.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Ich hätte gern eins!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "0049006300680020006800E40074007400650020006700650072006E002000650069006E007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Lieber nicht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "004C006900650062006500720020006E0069006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Und bitte! Komm wieder vorbei!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "0055006E006400200062006900740074006500210020004B006F006D006D002000770069006500640065007200200076006F0072006200650069002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Hey, ohne Moneten wird das aber nix!<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1096,
      "rawDecodedUtf16Hex": "004800650079002C0020006F0068006E00650020004D006F006E006500740065006E002000770069007200640020006400610073002000610062006500720020006E00690078002100100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "In deine Tasche passt doch gar nix mehr rein.<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "0049006E0020006400650069006E0065002000540061007300630068006500200070006100730073007400200064006F0063006800200067006100720020006E006900780020006D0065006800720020007200650069006E002E00100002011400100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Nicht? Obwohl es niedlich UND lecker ist?<U+0010><U+0002>Ĕ<U+0010>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1280,
