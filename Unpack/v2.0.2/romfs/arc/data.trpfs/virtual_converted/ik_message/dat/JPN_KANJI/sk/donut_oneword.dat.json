      "offsetInSection": 8084,
      "rawDecodedUtf16Hex": "30583063304F308A800330483066304F306030553044306D0000000000000000000000000000000000000000000000000000",
      "trailingZeroPaddingUnits": 13,
      "utf16Units": 25
    },
    {
