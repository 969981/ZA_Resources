      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1296,
      "rawDecodedUtf16Hex": "0057006F0075006C006400200079006F00750020006C0069006B006500200074006F002000740061006B00650020007000610072007400200069006E0020004C0065002000530075007000650072002D0054006F00750072006E006F0069002000640065000A004A006100630069006E00740068006500200049006E00660069006E006900740065003F00100002011400150000",
      "trailingZeroPaddingUnits": 1,
