      "index": 3,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "00100002BD06000000410074002000700072006500730065006E0074002C00200079006F007500720020007200650063006F0072006400200069007300200010000302050002002C002000770069006E001000031101000201000073002C0020006D007900200064006500610072000A0010000201000000002E00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
