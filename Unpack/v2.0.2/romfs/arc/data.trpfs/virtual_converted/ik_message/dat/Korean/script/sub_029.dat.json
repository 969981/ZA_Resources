      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "이 주위에서 분노로 가득 찬\n추한 싸움이 일어나고 있다는 것을요...!<U+0010><U+0002>Ĕŀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
