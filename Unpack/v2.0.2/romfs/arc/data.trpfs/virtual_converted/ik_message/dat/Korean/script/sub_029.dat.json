      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "님피아의 힘으로\n모두를 진정시켜서<U+0010><U+0001>븀\n싸움을 말려 주세요!<U+0010><U+0002>Ĕŀ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
