      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Ti spiego come funziona. La prova si articola in tre\nparti.<U+0010><U+0002>Ĕǩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
