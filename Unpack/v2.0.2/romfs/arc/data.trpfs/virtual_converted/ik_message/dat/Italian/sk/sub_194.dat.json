      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "La prima è la prova dell’erba! Affronta tre\nPokémon di tipo Fuoco con un Meganium!<U+0010><U+0002>Ĕǩ",
