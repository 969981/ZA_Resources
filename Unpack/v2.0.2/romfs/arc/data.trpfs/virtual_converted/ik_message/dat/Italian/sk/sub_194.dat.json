      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Charizard, Blaziken, Emboar, Delphox.<U+0010><U+0001>븁\nBlastoise, Swampert, Feraligatr, Greninja.<U+0010><U+0001>븁\nVenusaur, Sceptile, Meganium, Chesnaught.<U+0010><U+0002>Ĕǩ",
