      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Vaya, hombre... Bueno, tú avísame si atrapas\nun Gogoat de tamaño XL.<U+0010><U+0002>Ĕĳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "0056006100790061002C00200068006F006D006200720065002E002E002E0020004200750065006E006F002C0020007400FA00200061007600ED00730061006D006500200073006900200061007400720061007000610073000A0075006E00200047006F0067006F00610074002000640065002000740061006D006100F1006F00200058004C002E00100002011401330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Mecachis, este no es de tamaño XL.\nNecesito uno que sea gigantesco.<U+0010><U+0002>Ĕĳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
