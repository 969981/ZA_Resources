      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Arrea! ¡No me digas que me vas a regalar\nun Gogoat de tamaño XL!<U+0010><U+0002>Ĕĳ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "00A1004100720072006500610021002000A1004E006F0020006D006500200064006900670061007300200071007500650020006D006500200076006100730020006100200072006500670061006C00610072000A0075006E00200047006F0067006F00610074002000640065002000740061006D006100F1006F00200058004C002100100002011401330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Aquí tienes",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
