      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¡Corcho! ¡Este Gogoat es descomunal!\nEs XL sin lugar a dudas.<U+0010><U+0002>Ĕĳ",
