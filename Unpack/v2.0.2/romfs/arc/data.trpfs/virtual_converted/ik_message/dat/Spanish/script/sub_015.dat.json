      "index": 7,
      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "004D0065006A006F00720020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡Qué maravilla! ¿Me lo enseñas?<U+0010><U+0002>Ĕĳ",
