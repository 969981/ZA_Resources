      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1348,
      "rawDecodedUtf16Hex": "53734F7F767C751F4E864EC09EBCFF0C000A4E5F80FD99AC4E0A548C597D202620260000",
      "trailingZeroPaddingUnits": 1,
