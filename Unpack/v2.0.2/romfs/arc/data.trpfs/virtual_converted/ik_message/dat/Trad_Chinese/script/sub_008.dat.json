      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "621176F84FE1726076845FC360C54E005B9A5F88597D559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "我來接牠了。<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1092,
      "rawDecodedUtf16Hex": "62114F8663A572604E863002001000020114012C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "心情變好，\n不鬧彆扭了嗎？<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "5FC360C58B8A597DFF0C000A4E0D9B275F46626D4E8655CEFF1F001000020114012C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
