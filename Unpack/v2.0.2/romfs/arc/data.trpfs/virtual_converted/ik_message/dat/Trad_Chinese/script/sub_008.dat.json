      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "咘呢咘呢。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1008,
      "rawDecodedUtf16Hex": "549854625498546230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
