      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "這位陪牠來的客人，也請入座。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "90194F4D966A72604F8676845BA24EBAFF0C4E5F8ACB51655EA730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "咘呢♪",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "54985462266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "好吃嗎？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
