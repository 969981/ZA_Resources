      "rawDecodedUtf16Hex": "597D540355CEFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "你都固定吃那個？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "4F6090FD56FA5B9A540390A3500BFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "咘～呢。",
