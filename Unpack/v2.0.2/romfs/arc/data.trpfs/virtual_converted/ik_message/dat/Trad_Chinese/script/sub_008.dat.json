      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "5498546254985462266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "似乎是心情好得要哼歌囉。\n真不愧是旭日的甜點拼盤。<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1164,
      "rawDecodedUtf16Hex": "4F3C4E4E662F5FC360C5597D5F97898154FC6B4C56C93002000A771F4E0D6127662F65ED65E57684751C9EDE62FC76E43002001000020114012C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "泡沫奶油是謝禮。\n謝謝<U+0010><U+0003>ᄀÿā你妳陪牠來。<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1224,
      "rawDecodedUtf16Hex": "6CE16CAB59766CB9662F8B1D79AE3002000A8B1D8B1D00100003110000FF01014F6059B3966A72604F863002001000020114012C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "那麼，我們回定焦咖啡館去吧。\n客人正在等著呢。<U+0010><U+0002>ĔĬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "90A39EBCFF0C6211501156DE5B9A712654965561992853BB54273002000A5BA24EBA6B6357287B49845754623002001000020114012C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "咘呢～♪",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "54985462FF5E266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "即使發生了什麼，\n也能馬上和好……",
