      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Si tratta di uno Stunfisk che ho catturato nella\nregione di Galar. Guarda, è come questo qui.<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
