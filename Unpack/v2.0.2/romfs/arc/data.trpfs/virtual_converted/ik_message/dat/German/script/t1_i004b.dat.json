  "initialKey": 0,
  "messages": [
    {
      "displayText": "Herzlich willkommen im\nRestaurant chez Norme.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 220,
      "rawDecodedUtf16Hex": "004800650072007A006C006900630068002000770069006C006C006B006F006D006D0065006E00200069006D000A00520065007300740061007500720061006E00740020006300680065007A0020004E006F0072006D0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Na, Appetit auf unser\nKampf-Menü?<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 312,
      "rawDecodedUtf16Hex": "004E0061002C00200041007000700065007400690074002000610075006600200075006E007300650072000A004B0061006D00700066002D004D0065006E00FC003F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Das Essen heute geht auf mich.\nLass es dir schmecken.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 408,
      "rawDecodedUtf16Hex": "00440061007300200045007300730065006E0020006800650075007400650020006700650068007400200061007500660020006D006900630068002E000A004C00610073007300200065007300200064006900720020007300630068006D00650063006B0065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Am liebsten würde ich mir einen\nPokémon-Kampf bestellen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "0041006D0020006C006900650062007300740065006E0020007700FC00720064006500200069006300680020006D00690072002000650069006E0065006E000A0050006F006B00E9006D006F006E002D004B0061006D00700066002000620065007300740065006C006C0065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Der Geruch könnte den anderen\nGästen das Essen verderben...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "00440065007200200047006500720075006300680020006B00F6006E006E00740065002000640065006E00200061006E0064006500720065006E000A004700E4007300740065006E002000640061007300200045007300730065006E002000760065007200640065007200620065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Ich will mit meinen\nPokémon essen!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "004900630068002000770069006C006C0020006D006900740020006D00650069006E0065006E000A0050006F006B00E9006D006F006E00200065007300730065006E002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Der Käse des Tages ist...<U+0010><U+0001>븁\n„Ein 180 Jahre lang gereifter Hartkäse.<U+0010><U+0001>븁\nEin Bissen und man ist im Käsehimmel, obgleich\neinem der Geruch die Nasenhaare verbrennt.<U+0010><U+0001>븁\nDer Käse wird nach alter Tradition mit dem Toxin\neines weiblichen Arbok gewaschen.“<U+0010><U+0001>븁\nUi...",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 258
    },
    {
      "displayText": "Und zum Nachtisch dann das Übliche...<U+0010><U+0001>븁\nEin Sorbet aus Kiwan- und Fragiabeeren\nan feiner Kräuter-Mousse.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Das tolle Geschmackserlebnis war ja zu erwarten,\naber dann auch noch großzügige Portionen, wow!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Wenn wir nicht alles schaffen, lassen wir uns den\nRest einfach für unsere Pokémon einpacken.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Papa... Bist du insgeheim\ntotal reich?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1932,
      "rawDecodedUtf16Hex": "0050006100700061002E002E002E0020004200690073007400200064007500200069006E007300670065006800650069006D000A0074006F00740061006C002000720065006900630068003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Na, wenn ich alles bestellen darf...<U+0010><U+0001>븁\n„Gebratene Flegmon-Rute aus der Azurbucht.<U+0010><U+0001>븁\nAls raffiniert vergessene Beilage verzaubern in\nSinel-Öl sautierte Pyapabeeren-Nudeln.<U+0010><U+0001>븁\nIn ihrer geisterhaften Konsistenz sind sie das\nkulinarische Pendant zu einem Nebulak, das eine<U+0010><U+0001>븀\nHexe unheimlich anstarrt.“ Prima, das nehm ich!",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2012,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 322
    },
    {
      "displayText": "Du bist viel zu gut drauf... Lief’s beim Z-A Royale\netwa so gut?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "00440075002000620069007300740020007600690065006C0020007A00750020006700750074002000640072006100750066002E002E002E0020004C006900650066201900730020006200650069006D0020005A002D004100200052006F00790061006C0065000A006500740077006100200073006F0020006700750074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Bestellt alles, was ihr wollt.\nNur keine Scheu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2788,
      "rawDecodedUtf16Hex": "00420065007300740065006C006C007400200061006C006C00650073002C0020007700610073002000690068007200200077006F006C006C0074002E000A004E007500720020006B00650069006E006500200053006300680065007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Ein guter Pokémon-Kampf gibt\ndem Geschmack mehr Tiefe.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2884,
      "rawDecodedUtf16Hex": "00450069006E00200067007500740065007200200050006F006B00E9006D006F006E002D004B0061006D0070006600200067006900620074000A00640065006D002000470065007300630068006D00610063006B0020006D006500680072002000540069006500660065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Pokémon, die sich ins Zeug legen,\nsind das feinste Gewürz!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2996,
      "rawDecodedUtf16Hex": "0050006F006B00E9006D006F006E002C00200064006900650020007300690063006800200069006E00730020005A0065007500670020006C006500670065006E002C000A00730069006E006400200064006100730020006600650069006E007300740065002000470065007700FC0072007A00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Heute speisen wir nicht als Großmutter und\nEnkel, sondern als Erwachsene.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 3116,
      "rawDecodedUtf16Hex": "004800650075007400650020007300700065006900730065006E00200077006900720020006E006900630068007400200061006C0073002000470072006F00DF006D0075007400740065007200200075006E0064000A0045006E006B0065006C002C00200073006F006E006400650072006E00200061006C0073002000450072007700610063006800730065006E0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Eigentlich genieße ich es durchaus,\nalleine zu speisen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3264,
      "rawDecodedUtf16Hex": "0045006900670065006E0074006C006900630068002000670065006E0069006500DF00650020006900630068002000650073002000640075007200630068006100750073002C000A0061006C006C00650069006E00650020007A00750020007300700065006900730065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Wenn ich mich unauffällig verhalte, dann spricht\nmich vielleicht auch niemand an...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3380,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Du genießt die Essenszeit wirklich\nvon Herzen, was?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3548,
      "rawDecodedUtf16Hex": "00440075002000670065006E0069006500DF0074002000640069006500200045007300730065006E0073007A0065006900740020007700690072006B006C006900630068000A0076006F006E0020004800650072007A0065006E002C0020007700610073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Lässt man sich beim Essen Zeit,\nfreut sich das Sättigungsgefühl.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3652,
      "rawDecodedUtf16Hex": "004C00E40073007300740020006D0061006E002000730069006300680020006200650069006D00200045007300730065006E0020005A006500690074002C000A006600720065007500740020007300690063006800200064006100730020005300E400740074006900670075006E0067007300670065006600FC0068006C002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Mein Flauschling ist\nabsolut hinreißend!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3784,
      "rawDecodedUtf16Hex": "004D00650069006E00200046006C00610075007300630068006C0069006E00670020006900730074000A006100620073006F006C00750074002000680069006E00720065006900DF0065006E006400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Mein Parfinesse hat\nviel mehr Charme!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3868,
      "rawDecodedUtf16Hex": "004D00650069006E002000500061007200660069006E00650073007300650020006800610074000A007600690065006C0020006D00650068007200200043006800610072006D006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Hervorragend! Die Fleischgerichte\nhier sind wie erwartet spitze!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3944,
      "rawDecodedUtf16Hex": "0048006500720076006F00720072006100670065006E00640021002000440069006500200046006C0065006900730063006800670065007200690063006800740065000A0068006900650072002000730069006E0064002000770069006500200065007200770061007200740065007400200073007000690074007A006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Koch Béchamel hat sich mal\nwieder selbst übertroffen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 4076,
      "rawDecodedUtf16Hex": "004B006F006300680020004200E9006300680061006D0065006C0020006800610074002000730069006300680020006D0061006C000A007700690065006400650072002000730065006C006200730074002000FC00620065007200740072006F006600660065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Ich habe etwas viel ausgegeben,\naber das hab ich mir verdient!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 4184,
      "rawDecodedUtf16Hex": "004900630068002000680061006200650020006500740077006100730020007600690065006C0020006100750073006700650067006500620065006E002C000A00610062006500720020006400610073002000680061006200200069006300680020006D006900720020007600650072006400690065006E007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Wenn Gäste wiederkommen,\nhabe ich alles richtig gemacht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4312,
      "rawDecodedUtf16Hex": "00570065006E006E0020004700E40073007400650020007700690065006400650072006B006F006D006D0065006E002C000A0068006100620065002000690063006800200061006C006C0065007300200072006900630068007400690067002000670065006D0061006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    }
