      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Super ! À toi, Roucool !\nPrends ton envol !<U+0010><U+0002>Ĕń",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "0053007500700065007200200021002000C000200074006F0069002C00200052006F00750063006F006F006C00200021000A005000720065006E0064007300200074006F006E00200065006E0076006F006C0020002100100002011401440000",
      "trailingZeroPaddingUnits": 1,
