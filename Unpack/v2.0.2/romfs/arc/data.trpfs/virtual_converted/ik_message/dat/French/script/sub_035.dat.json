      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 201
    },
    {
      "displayText": "Bref, ce que je trouve le plus cool chez\nces Pokémon, c’est leur capacité Vol !<U+0010><U+0002>Ĕń",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Je peux te la montrer, si tu veux ! J’ai un Roucool,\nun Roucoups et un Roucarnage prêts à se battre !<U+0010><U+0002>Ĕń",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Viens me voir si tu veux les affronter !<U+0010><U+0002>Ĕń",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "005600690065006E00730020006D006500200076006F00690072002000730069002000740075002000760065007500780020006C0065007300200061006600660072006F006E0074006500720020002100100002011401440000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1292,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Quand tu verras mes Pokémon oiseaux en action,\ntu les adoreras, toi aussi ! Alors, on se bat ?<U+0010><U+0002>Ĕń",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1304,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Oui !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "004F00750069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Non, merci.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "004E006F006E002C0020006D0065007200630069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Allez, quoi ! Ça va être bien, je te jure !<U+0010><U+0002>Ĕń",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1540,
