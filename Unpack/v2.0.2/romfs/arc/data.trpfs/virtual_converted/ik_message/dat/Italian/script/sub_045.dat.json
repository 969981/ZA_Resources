      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Grazie! La tua collaborazione è stata fantastica!\nE voglio darti un regalo fantastico per sdebitarmi.<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Adesso mi chiedo quale mossa di tipo Veleno\npotrebbe essere la preferita degli Aron.<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Miei cari Aron! Continuerò a portarvi tutta\nla ferraglia che trovo per riempirvi il pancino!<U+0010><U+0002>Ĕō",
