      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Sans surprise, je serai ton adversaire lors de\nla finale. Es-tu prêt<U+0010><U+0003>ᄀÿĀe pour cet ultime combat ?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 5280,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Plus que jamais !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5488,
      "rawDecodedUtf16Hex": "0050006C0075007300200071007500650020006A0061006D006100690073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Un instant !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 49,
      "offsetInSection": 5524,
      "rawDecodedUtf16Hex": "0055006E00200069006E007300740061006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "<U+0010><U+0002>뷿2",
