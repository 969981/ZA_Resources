      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Permets-moi de soigner t<U+0010><U+0003>ᄁýȂones Pokémon.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4300,
      "rawDecodedUtf16Hex": "005000650072006D006500740073002D006D006F006900200064006500200073006F00690067006E006500720020007400100003110100FD0202006F006E0065007300200050006F006B00E9006D006F006E002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Je serai aussi ton adversaire lors du prochain\ncombat. Poursuivons, veux-tu ?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4396,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
