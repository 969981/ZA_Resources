      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 5012,
      "rawDecodedUtf16Hex": "004F00750069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Il me faut plus de temps.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 5024,
      "rawDecodedUtf16Hex": "0049006C0020006D00650020006600610075007400200070006C00750073002000640065002000740065006D00700073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>뷿,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5076,
      "rawDecodedUtf16Hex": "00100002BDFF002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Toutes mes félicitations pour ta victoire !<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5088,
      "rawDecodedUtf16Hex": "0054006F00750074006500730020006D006500730020006600E9006C0069006300690074006100740069006F006E007300200070006F0075007200200074006100200076006900630074006F0069007200650020002100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Permets-moi de soigner t<U+0010><U+0003>ᄁýȂones Pokémon.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
