      "index": 36,
      "offsetInSection": 4560,
      "rawDecodedUtf16Hex": "004A00650020006E20190061007400740065006E006400730020007100750065002000E70061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Un instant !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 4604,
      "rawDecodedUtf16Hex": "0055006E00200069006E007300740061006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
