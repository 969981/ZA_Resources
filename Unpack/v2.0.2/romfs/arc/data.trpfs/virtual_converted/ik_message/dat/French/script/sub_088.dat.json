      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Toutes mes félicitations pour ta victoire !<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4204,
