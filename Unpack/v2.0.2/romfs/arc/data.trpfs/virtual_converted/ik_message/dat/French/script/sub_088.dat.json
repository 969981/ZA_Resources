      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ton adversaire lors de la demi-finale ne sera autre\nque... moi. Es-tu prêt<U+0010><U+0003>ᄀÿĀe ?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 5,
