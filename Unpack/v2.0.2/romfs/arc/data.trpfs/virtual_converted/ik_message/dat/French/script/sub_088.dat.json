      "offsetInSection": 5552,
      "rawDecodedUtf16Hex": "00100002BDFF00320000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tu as remporté les Grands Jeux de Violine S.U. !\nToutes mes félicitations !<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 5564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "J’ai prévu une récompense « digne de mon nom »\npour cette occasion.<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
