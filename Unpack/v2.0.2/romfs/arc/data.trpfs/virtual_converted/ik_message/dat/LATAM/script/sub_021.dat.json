      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Te voy a enseñar lo fuertes que son las barreras.\n¿List<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "0054006500200076006F00790020006100200065006E0073006500F1006100720020006C006F00200066007500650072007400650073002000710075006500200073006F006E0020006C00610073002000620061007200720065007200610073002E000A00BF004C00690073007400100003110000FF0101006F0061003F001000020114013A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "¡List<U+0010><U+0003>ᄀÿāoa!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1048,
      "rawDecodedUtf16Hex": "00A1004C00690073007400100003110000FF0101006F006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Un momento",
