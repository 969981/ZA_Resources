      "rawDecodedUtf16Hex": "0055006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Entiendo que dudes, yo tampoco querría perder\nel combate.<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "0045006E007400690065006E0064006F0020007100750065002000640075006400650073002C00200079006F002000740061006D0070006F0063006F00200071007500650072007200ED00610020007000650072006400650072000A0065006C00200063006F006D0062006100740065002E001000020114013A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Los movimientos que usan mis Pokémon reducen\nel daño de los ataques del rival.<U+0010><U+0001>븁\nEs como si tuviesen una barrera adelante.<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 4,
