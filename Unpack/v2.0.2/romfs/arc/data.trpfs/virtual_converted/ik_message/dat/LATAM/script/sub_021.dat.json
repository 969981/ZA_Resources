      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Increíble, qué nivel tienes! ¡No necesitas que\nte enseñe nada!<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
