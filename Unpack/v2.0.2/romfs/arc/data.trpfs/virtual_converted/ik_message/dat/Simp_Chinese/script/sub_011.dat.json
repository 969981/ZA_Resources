      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "4F60768494B1597D50CF4E0D592A591F54C72026202600100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "品鉴会太令人期待啦。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "54C192744F1A592A4EE44EBA671F5F855566300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
