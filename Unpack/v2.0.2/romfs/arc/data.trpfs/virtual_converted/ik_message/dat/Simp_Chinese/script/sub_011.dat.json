      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我正等着你呢。<U+0010><U+0002>Ĕİ",
