      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "62116B637B4977404F605462300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "但你没带上最关键的含羞苞呀。\n快把它加入同行，然后带过来吧。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1004,
