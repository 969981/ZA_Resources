    },
    {
      "displayText": "这位年轻人……\n你知道含羞苞吗？<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 584,
