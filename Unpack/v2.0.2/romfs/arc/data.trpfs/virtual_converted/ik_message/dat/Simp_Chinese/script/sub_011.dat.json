      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "4F607684540D5B57662F202620260010000201000000FF1F000A50CF662F4E2A80FD5F0051FA4EC04E4882B167657684597D540D5B57554A300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "报名参加品鉴会的费用是\n<U+E300>5800。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1192,
      "rawDecodedUtf16Hex": "62A5540D53C252A054C192744F1A76848D397528662F000AE3000035003800300030300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "我付……！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "62114ED820262026FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
