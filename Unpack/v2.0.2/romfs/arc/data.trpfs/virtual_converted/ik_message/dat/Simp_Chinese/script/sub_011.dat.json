      "rawDecodedUtf16Hex": "54BB82DEFF5EFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "这是……！？<U+0010><U+0002>ĔƓ",
