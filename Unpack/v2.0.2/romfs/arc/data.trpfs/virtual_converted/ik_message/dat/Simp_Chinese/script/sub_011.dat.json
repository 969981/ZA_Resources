      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "接下来是3号参加者，\n明莉的含羞苞。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
