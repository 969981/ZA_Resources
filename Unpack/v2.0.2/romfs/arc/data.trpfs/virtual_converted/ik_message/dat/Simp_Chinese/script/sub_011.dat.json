      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "5B9D54AAFF5EFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "端庄的姿态\n让人感受到它强大的力量。<U+0010><U+0002>ĔƓ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
