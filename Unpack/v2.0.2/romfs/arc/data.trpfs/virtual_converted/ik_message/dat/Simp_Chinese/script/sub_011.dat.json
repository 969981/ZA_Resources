      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "653E5FC35427FF01000A4F60548C542B7F9E82DE80AF5B9A6CA195EE9898FF0100100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "你的钱好像不太够哇……<U+0010><U+0002>Ĕİ",
