      "rawDecodedUtf16Hex": "4E0D8FC7FF0C80FD4ECE5B83768453EB58F04E2D611F523070E68E8120262026000A4F3C4E4E662F79EF7D2F4E864E004E9B538B529B554A300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "最后是4号参加者，\n<U+0010><U+0002>Ā<U+0000>的含羞苞。<U+0010><U+0002>Ĕİ",
