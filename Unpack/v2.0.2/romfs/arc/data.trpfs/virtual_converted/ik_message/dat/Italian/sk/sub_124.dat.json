      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "È merito tuo se abbiamo formato il nostro\nduo di Raichu!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 2780,
      "rawDecodedUtf16Hex": "00C80020006D0065007200690074006F002000740075006F002000730065002000610062006200690061006D006F00200066006F0072006D00610074006F00200069006C0020006E006F007300740072006F000A00640075006F00200064006900200052006100690063006800750021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Accetta questa Raichuite X da parte mia,\nin segno della mia riconoscenza!<U+0010><U+0002>Ĕĥ",
