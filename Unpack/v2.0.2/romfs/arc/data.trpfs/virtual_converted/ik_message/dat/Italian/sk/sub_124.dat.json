      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Grazie di nuovo, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
