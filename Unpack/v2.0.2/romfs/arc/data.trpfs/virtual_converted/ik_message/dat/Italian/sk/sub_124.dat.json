      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3060,
      "rawDecodedUtf16Hex": "004500640020006500630063006F0020006100200074006500200061006E00630068006500200075006E0061002000520061006900630068007500690074006500200059002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Spero di rivederti ancora, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 8,
