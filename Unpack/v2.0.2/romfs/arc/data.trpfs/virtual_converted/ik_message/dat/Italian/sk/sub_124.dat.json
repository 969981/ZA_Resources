      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 3216,
      "rawDecodedUtf16Hex": "0041006C006F006C00610021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001F>",
