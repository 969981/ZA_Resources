      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3240,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh! <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 3252,
      "rawDecodedUtf16Hex": "004F0068002100200010000201000000002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Ma che coincidenza! Stavamo giusto parlando\ndi te.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3280,
      "rawDecodedUtf16Hex": "004D0061002000630068006500200063006F0069006E0063006900640065006E007A00610021002000530074006100760061006D006F002000670069007500730074006F0020007000610072006C0061006E0064006F000A00640069002000740065002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Di cosa parlavate?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3392,
      "rawDecodedUtf16Hex": "0044006900200063006F007300610020007000610072006C00610076006100740065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "In che senso?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 35,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "0049006E0020006300680065002000730065006E0073006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Ti siamo grate per l’aiuto che ci hai offerto\ncon i nostri Raichu.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3460,
      "rawDecodedUtf16Hex": "005400690020007300690061006D006F00200067007200610074006500200070006500720020006C20190061006900750074006F002000630068006500200063006900200068006100690020006F00660066006500720074006F000A0063006F006E002000690020006E006F00730074007200690020005200610069006300680075002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Il Raichu che ho fatto evolvere con una\nPietratuono sta benone!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 37,
      "offsetInSection": 3604,
      "rawDecodedUtf16Hex": "0049006C0020005200610069006300680075002000630068006500200068006F00200066006100740074006F002000650076006F006C007600650072006500200063006F006E00200075006E0061000A00500069006500740072006100740075006F006E006F0020007300740061002000620065006E006F006E0065002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Il Raichu che ho ricevuto da te invece è bello\nvispo!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 3740,
      "rawDecodedUtf16Hex": "0049006C0020005200610069006300680075002000630068006500200068006F00200072006900630065007600750074006F00200064006100200074006500200069006E0076006500630065002000E8002000620065006C006C006F000A0076006900730070006F0021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Sai, ci siamo incrociate per strada e ci siamo\ninnamorate dei rispettivi Raichu!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 3856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "E facendo due chiacchiere abbiamo scoperto\ndi averli ottenuti entrambe grazie a te!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 4028,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "È così che, di comune accordo, abbiamo iniziato\na coltivare il sogno di renderli il duo di Raichu più<U+0010><U+0001>븀\nforte che esista!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 4204,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Siete stati tu e questa città a farci incontrare!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4460,
      "rawDecodedUtf16Hex": "005300690065007400650020007300740061007400690020007400750020006500200071007500650073007400610020006300690074007400E00020006100200066006100720063006900200069006E0063006F006E007400720061007200650021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Raiii! Raiii! Chuuu! Chu!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4568,
      "rawDecodedUtf16Hex": "00520061006900690069002100200052006100690069006900210020004300680075007500750021002000430068007500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Userò una Pietratuono su tutti i Pikachu!\nNo, dai, scherzo...<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 44,
      "offsetInSection": 4620,
      "rawDecodedUtf16Hex": "005500730065007200F200200075006E0061002000500069006500740072006100740075006F006E006F00200073007500200074007500740074006900200069002000500069006B00610063006800750021000A004E006F002C0020006400610069002C002000730063006800650072007A006F002E002E002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Mi basta stare con Raichu per essere felice!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 4752,
      "rawDecodedUtf16Hex": "004D006900200062006100730074006100200073007400610072006500200063006F006E002000520061006900630068007500200070006500720020006500730073006500720065002000660065006C0069006300650021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "<U+0010><U+0002>뷿.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 4852,
      "rawDecodedUtf16Hex": "00100002BDFF002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Qual è il più straordinario tra MegaRaichu X e\nMegaRaichu Y?<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
