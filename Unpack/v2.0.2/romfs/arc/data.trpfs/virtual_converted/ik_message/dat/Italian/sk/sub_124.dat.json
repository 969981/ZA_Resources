      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ecco l’Allenat<U+0010><U+0003>ᄀÿ̂orrice che ha salvato Luminopoli!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
