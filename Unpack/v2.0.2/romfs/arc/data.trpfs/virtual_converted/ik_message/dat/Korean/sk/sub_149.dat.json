      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "허리를 그만 삐끗해 버려서요...<U+0010><U+0002>Ĕƺ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
