      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "덕분에 살았어요!\n정말 상냥하신 분이네요.<U+0010><U+0002>Ĕƺ",
      "escapedControlUnits": 2,
