      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Fallait s’y attendre... C’est un Limonde de Galar,\net il ressemble à ça.<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
