      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Limonde adore se battre, et il est toujours à l’affût\nde gens plus doués que moi en combat Pokémon.<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
