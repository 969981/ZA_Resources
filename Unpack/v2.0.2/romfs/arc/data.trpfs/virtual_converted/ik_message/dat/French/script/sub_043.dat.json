      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Il adore se fondre dans le sol, et quand il le fait,\nil ressemble alors à une Poké Ball posée par terre.<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
