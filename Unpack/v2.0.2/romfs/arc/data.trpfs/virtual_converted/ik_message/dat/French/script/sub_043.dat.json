      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Et je crois qu’il a jeté son dévolu sur toi ! Tu ne\nvoudrais pas devenir s<U+0010><U+0003>ᄀÿᐓon nouveau Dresseura nouvelle Dresseuse ?<U+0010><U+0002>ĔŌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
