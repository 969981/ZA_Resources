      "rawDecodedUtf16Hex": "C790ADF900210021001000020114013B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "알기 쉽게 설명해 드리죠!<U+0010><U+0002>ĔĻ",
