      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "아보, 꼬리를 좀 만져 봐도 될까?<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
