      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "아보의 꼬리를 만져 보고 싶어요!\n잡으면 지닌 포켓몬에 넣고 데려와 주세요!<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "C544BCF4C7580020AF2CB9ACB97C0020B9CCC8380020BCF4ACE00020C2F6C5B4C6940021000AC7A1C73CBA740020C9C0B2CC0020D3ECCF13BAACC5D00020B123ACE00020B370B824C6400020C8FCC138C6940021001000020114012A0000",
      "trailingZeroPaddingUnits": 1,
