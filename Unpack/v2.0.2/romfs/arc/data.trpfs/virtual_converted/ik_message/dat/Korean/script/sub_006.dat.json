      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "아보의 꼬리는\n배랑 다르게 말랑말랑해요!!<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "C544BCF4C7580020AF2CB9ACB294000ABC30B7910020B2E4B974AC8C0020B9D0B791B9D0B791D574C69400210021001000020114012A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "꼬리 말고 다른 곳은 차갑고 매끈매끈한데\n꼬리만은 말랑말랑하고 탱글탱글해요!<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 876,
