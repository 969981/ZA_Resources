      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 780,
      "rawDecodedUtf16Hex": "C0E4C544007E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "살~짝만 만질게...<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 788,
