      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "아보는 어디까지가 꼬리인 걸까요?<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
