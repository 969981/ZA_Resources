      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "004C006500200046006C0061006D0065006E0072006F0075006C00650020006420190075006E006500200063006C00690065006E00740065002000720065006600750073006500200064006500200064006F0072006D006900720020002100100002011401BB0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Fla.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "0046006C0061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "C’est comme s’il avait trop d’énergie dans\nle ventre, impossible de lui faire fermer l’œil...<U+0010><U+0002>ĔƼ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Mumumu...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "004D0075006D0075006D0075002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Nous venons à peine de lancer notre affaire,\net Mushana est déjà si stressé...<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
