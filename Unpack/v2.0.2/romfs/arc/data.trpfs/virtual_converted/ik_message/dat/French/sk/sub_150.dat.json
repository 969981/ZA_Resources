      "escapedControlUnits": 14,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Utilisez <U+0010><U+0002>＀<U+0006>Hypnose <U+0010><U+0002>＀<U+0000>et <U+0010><U+0002>＀<U+0006>Dévorêve<U+0010><U+0002>＀<U+0000> sur Flamenroule,\nje vous en prie !<U+0010><U+0002>Ĕƻ",
