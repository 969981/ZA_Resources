      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1552,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "J’ai toujours admiré les Dresseurs Aériens !\nEn les regardant, on se sent pousser des ailes !<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Les Combats Aériens étaient en vogue à Kalos,\nil y a quelque temps.<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1760,
      "rawDecodedUtf16Hex": "004C0065007300200043006F006D00620061007400730020004100E9007200690065006E0073002000E90074006100690065006E007400200065006E00200076006F006700750065002000E00020004B0061006C006F0073002C000A0069006C00200079002000610020007100750065006C007100750065002000740065006D00700073002E00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "On n’avait le droit d’y participer qu’avec des\nPokémon qui volent ou flottent dans les airs.<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Je suis sûr qu’avec ta force, tu pourrais dominer\nles Combats Aériens !<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2100,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Il suffit d’attendre que les Combats Aériens\nreviennent à la mode !<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "0049006C00200073007500660066006900740020006420190061007400740065006E00640072006500200071007500650020006C0065007300200043006F006D00620061007400730020004100E9007200690065006E0073000A00720065007600690065006E006E0065006E0074002000E00020006C00610020006D006F006400650020002100100002011401480000",
      "trailingZeroPaddingUnits": 1,
