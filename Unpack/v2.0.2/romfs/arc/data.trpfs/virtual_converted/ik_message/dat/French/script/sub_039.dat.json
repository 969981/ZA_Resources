      "index": 1,
      "offsetInSection": 200,
      "rawDecodedUtf16Hex": "00420065006C006C00650020007600750065002C0020007000610073002000760072006100690020003F00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "J’en ai vu, des régions... Mais rien ne donne\nle vertige comme le paysage d’Illumis !<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Que dirais-tu d’un combat Pokémon un peu\noriginal ?<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "0051007500650020006400690072006100690073002D007400750020006420190075006E00200063006F006D00620061007400200050006F006B00E9006D006F006E00200075006E0020007000650075000A006F0072006900670069006E0061006C0020003F00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Je te propose de nous battre avec seulement\ndes Pokémon de type Vol.<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 544,
      "rawDecodedUtf16Hex": "004A0065002000740065002000700072006F0070006F007300650020006400650020006E006F007500730020006200610074007400720065002000610076006500630020007300650075006C0065006D0065006E0074000A00640065007300200050006F006B00E9006D006F006E0020006400650020007400790070006500200056006F006C002E00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Un seul Pokémon ou une équipe entière, comme\ntu veux. Mais seulement de type Vol !<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Quand tu auras composé ton équipe,\nviens me voir.<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "005100750061006E006400200074007500200061007500720061007300200063006F006D0070006F007300E900200074006F006E002000E900710075006900700065002C000A007600690065006E00730020006D006500200076006F00690072002E00100002011401480000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
