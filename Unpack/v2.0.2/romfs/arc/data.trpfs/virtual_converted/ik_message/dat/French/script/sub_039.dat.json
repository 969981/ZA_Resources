      "rawDecodedUtf16Hex": "004A2019006100690020006300680061006E006700E90020006420190061007600690073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Tu veux réfléchir à la composition de ton équipe ?<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1332,
