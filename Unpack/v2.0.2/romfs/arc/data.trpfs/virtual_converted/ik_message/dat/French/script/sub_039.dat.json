      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Voyons quels Pokémon vont régner sur les cieux !<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1444,
