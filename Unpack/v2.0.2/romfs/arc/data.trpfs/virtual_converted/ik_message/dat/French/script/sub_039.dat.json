      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Parfait, tu n’as que des Pokémon de type Vol.\nBattons-nous, alors !<U+0010><U+0002>Ĕň",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
