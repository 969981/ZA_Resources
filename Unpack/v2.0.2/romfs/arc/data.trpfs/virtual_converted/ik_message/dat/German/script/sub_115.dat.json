      "offsetInSection": 2892,
      "rawDecodedUtf16Hex": "00440075002000680061007300740020006400610073002000640069006500620069007300630068006500200045006D006F006C0067006100200069006E002000640069006500200045006E00670065000A00670065007400720069006500620065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Molga!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3000,
      "rawDecodedUtf16Hex": "004D006F006C0067006100210000",
      "trailingZeroPaddingUnits": 1,
