  "messages": [
    {
      "displayText": "Bienvenue à L’Étoilé !\nOù goût, atmosphère et prix riment avec modicité !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 196,
      "rawDecodedUtf16Hex": "004200690065006E00760065006E00750065002000E00020004C201900C90074006F0069006C00E900200021000A004F00F900200067006F00FB0074002C002000610074006D006F00730070006800E80072006500200065007400200070007200690078002000720069006D0065006E0074002000610076006500630020006D006F0064006900630069007400E9002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "N’aie pas peur de viser le sommet !\nTelle est ma devise !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "004E20190061006900650020007000610073002000700065007500720020006400650020007600690073006500720020006C006500200073006F006D006D0065007400200021000A00540065006C006C006500200065007300740020006D00610020006400650076006900730065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Venez goûter notre\nmenu dégustation ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 460,
      "rawDecodedUtf16Hex": "00560065006E0065007A00200067006F00FB0074006500720020006E006F007400720065000A006D0065006E00750020006400E90067007500730074006100740069006F006E00200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Personne ne me fait jamais\nde compliments...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 568,
      "rawDecodedUtf16Hex": "0050006500720073006F006E006E00650020006E00650020006D0065002000660061006900740020006A0061006D006100690073000A0064006500200063006F006D0070006C0069006D0065006E00740073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Ne dis pas ça ! Je parie que tes\nPokémon t’en font tout le temps !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "004E006500200064006900730020007000610073002000E70061002000210020004A006500200070006100720069006500200071007500650020007400650073000A0050006F006B00E9006D006F006E0020007420190065006E00200066006F006E007400200074006F007500740020006C0065002000740065006D00700073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Je me réserve pour\ndéguster le dessert !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 796,
      "rawDecodedUtf16Hex": "004A00650020006D00650020007200E90073006500720076006500200070006F00750072000A006400E90067007500730074006500720020006C006500200064006500730073006500720074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Ici, les crêpes Suzette sont\nsimples, mais délicieuses !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "004900630069002C0020006C0065007300200063007200EA007000650073002000530075007A006500740074006500200073006F006E0074000A00730069006D0070006C00650073002C0020006D0061006900730020006400E9006C00690063006900650075007300650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Qu’il est agréable de manger en\nregardant un combat Pokémon !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "0051007520190069006C0020006500730074002000610067007200E900610062006C00650020006400650020006D0061006E00670065007200200065006E000A0072006500670061007200640061006E007400200075006E00200063006F006D00620061007400200050006F006B00E9006D006F006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "L’amertume de la défaite, ça peut\nvous gâcher un repas...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "004C20190061006D0065007200740075006D00650020006400650020006C00610020006400E900660061006900740065002C002000E7006100200070006500750074000A0076006F007500730020006700E2006300680065007200200075006E002000720065007000610073002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Les enfants trouvent les combats\nplus intéressants que leur assiette.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1236,
      "rawDecodedUtf16Hex": "004C0065007300200065006E00660061006E00740073002000740072006F007500760065006E00740020006C0065007300200063006F006D0062006100740073000A0070006C0075007300200069006E007400E900720065007300730061006E0074007300200071007500650020006C006500750072002000610073007300690065007400740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Je donnerais bien une Baie Sitrus\naux Pokémon en difficulté...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "004A006500200064006F006E006E006500720061006900730020006200690065006E00200075006E0065002000420061006900650020005300690074007200750073000A00610075007800200050006F006B00E9006D006F006E00200065006E00200064006900660066006900630075006C007400E9002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Je vous comprends.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "004A006500200076006F0075007300200063006F006D007000720065006E00640073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Quand je ne peux pas manger ici,\nça me donne envie de pleurer.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1544,
      "rawDecodedUtf16Hex": "005100750061006E00640020006A00650020006E00650020007000650075007800200070006100730020006D0061006E0067006500720020006900630069002C000A00E700610020006D006500200064006F006E006E006500200065006E00760069006500200064006500200070006C00650075007200650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "J’aimerais bien pouvoir profiter de mon repas\ndans le calme...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "004A201900610069006D006500720061006900730020006200690065006E00200070006F00750076006F00690072002000700072006F006600690074006500720020006400650020006D006F006E002000720065007000610073000A00640061006E00730020006C0065002000630061006C006D0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Roger est un chef cuisinier remarquable,\nil se surpasse à chaque fois !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1800,
      "rawDecodedUtf16Hex": "0052006F006700650072002000650073007400200075006E00200063006800650066002000630075006900730069006E006900650072002000720065006D006100720071007500610062006C0065002C000A0069006C002000730065002000730075007200700061007300730065002000E0002000630068006100710075006500200066006F00690073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Pardon, mais j’ignore qui est ce Roger. Le seul\nchef cuisiner que je connaisse, c’est Narcisse.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "C’est ici que nous avons fêté notre\nmariage et nos noces d’argent !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2136,
      "rawDecodedUtf16Hex": "00432019006500730074002000690063006900200071007500650020006E006F00750073002000610076006F006E00730020006600EA007400E90020006E006F007400720065000A006D0061007200690061006700650020006500740020006E006F00730020006E006F0063006500730020006420190061007200670065006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "C’est la preuve que nous formons\nun couple inséparable.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2272,
      "rawDecodedUtf16Hex": "004320190065007300740020006C0061002000700072006500750076006500200071007500650020006E006F0075007300200066006F0072006D006F006E0073000A0075006E00200063006F00750070006C006500200069006E007300E900700061007200610062006C0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "De la soupe en entrée et\ndu poisson en plat principal...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "004400650020006C006100200073006F00750070006500200065006E00200065006E0074007200E90065002000650074000A0064007500200070006F006900730073006F006E00200065006E00200070006C006100740020007000720069006E0063006900700061006C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "C’était son restaurant de\nprédilection, à l’époque...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2500,
      "rawDecodedUtf16Hex": "0043201900E9007400610069007400200073006F006E002000720065007300740061007500720061006E0074002000640065000A0070007200E900640069006C0065006300740069006F006E002C002000E00020006C201900E90070006F007100750065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "La nourriture est d’une simplicité\ntelle que c’en est émouvant.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2608,
      "rawDecodedUtf16Hex": "004C00610020006E006F0075007200720069007400750072006500200065007300740020006420190075006E0065002000730069006D0070006C006900630069007400E9000A00740065006C006C006500200071007500650020006320190065006E0020006500730074002000E9006D006F007500760061006E0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Les plats sont tous aussi bons\nles uns que les autres !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "004C0065007300200070006C00610074007300200073006F006E007400200074006F0075007300200061007500730073006900200062006F006E0073000A006C0065007300200075006E007300200071007500650020006C006500730020006100750074007200650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "J’ai FAIM ! Ça vient, ou il faut\naller se servir en cuisine ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2848,
      "rawDecodedUtf16Hex": "004A2019006100690020004600410049004D00200021002000C700610020007600690065006E0074002C0020006F007500200069006C00200066006100750074000A0061006C006C00650072002000730065002000730065007200760069007200200065006E002000630075006900730069006E00650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Surveille tes manières,\ntout le monde te regarde !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2972,
      "rawDecodedUtf16Hex": "005300750072007600650069006C006C006500200074006500730020006D0061006E006900E8007200650073002C000A0074006F007500740020006C00650020006D006F006E0064006500200074006500200072006500670061007200640065002000210000",
      "trailingZeroPaddingUnits": 1,
