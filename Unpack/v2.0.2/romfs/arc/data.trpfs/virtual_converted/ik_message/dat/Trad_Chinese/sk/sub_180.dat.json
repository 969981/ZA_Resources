      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2500,
      "rawDecodedUtf16Hex": "00100002BDFF002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
