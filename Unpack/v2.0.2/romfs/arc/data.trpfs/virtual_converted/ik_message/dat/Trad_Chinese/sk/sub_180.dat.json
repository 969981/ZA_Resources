      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "00100002BDFF00230000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "請停止一切可疑的行動。\n<U+0010><U+0003>ᄀÿā你妳從正面闖入，我要逮捕<U+0010><U+0003>ᄀÿā你妳！<U+0010><U+0002>ĔǍ",
      "escapedControlUnits": 6,
