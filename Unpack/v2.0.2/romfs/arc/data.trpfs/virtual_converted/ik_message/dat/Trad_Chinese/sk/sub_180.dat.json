      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "90195DF27D934E0D662F8A137DF44E863002000A621189815168529B6311623000100003110000FF01014F6059B3FF0100100002011401CD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>뷿+",
