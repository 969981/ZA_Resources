  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Wir haben hier ein kleines Problem mit Unratütox,\ndem Mülltüten-Pokémon.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Einige Unratütox haben anscheinend Gefallen an\nden Essensresten unseres Cafés gefunden und<U+0010><U+0001>븀\nversammeln sich hier regelmäßig.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 131
    },
    {
      "displayText": "Tooox!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 764,
      "rawDecodedUtf16Hex": "0054006F006F006F007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Ich freue mich ja, dass den Unratütox unser\nEssen schmeckt...<U+0010><U+0001>븁\nAber ihr Geruch ist etwas gewöhnungsbedürftig\nund vergrault uns die Kundschaft.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 780,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "Oh, da kommt mir eine Idee!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1080,
      "rawDecodedUtf16Hex": "004F0068002C0020006400610020006B006F006D006D00740020006D00690072002000650069006E0065002000490064006500650021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Wenn sie auf unsere Reste aus sind, können wir\ndas vielleicht geschickt nutzen!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ich packe dir unseren Gourmetmüll ein und\ndu lockst die Unratütox damit zu den Mülltonnen<U+0010><U+0001>븀\nhier in der Nähe. Wie klingt das?<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 131
    },
    {
      "displayText": "Sag Bescheid, wenn du bereit wärst, das für uns\nzu übernehmen. Es würde uns wirklich helfen!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Hm, heute liegt unser Bereich in einem\nKampfsektor...<U+0010><U+0001>븁\nVerschieben wir die Sache mit den Unratütox\nbesser auf morgen!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1772,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2020,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wärst du bereit, die Unratütox zu den Mülltonnen\nzu führen?<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "005700E40072007300740020006400750020006200650072006500690074002C002000640069006500200055006E00720061007400FC0074006F00780020007A0075002000640065006E0020004D00FC006C006C0074006F006E006E0065006E000A007A00750020006600FC006800720065006E003F001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Aber klar doch!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2160,
      "rawDecodedUtf16Hex": "00410062006500720020006B006C0061007200200064006F0063006800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Moment noch...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2192,
      "rawDecodedUtf16Hex": "004D006F006D0065006E00740020006E006F00630068002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Ich würde es ja selbst machen, aber ich kann hier\nleider gerade nicht weg...<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Vielen lieben Dank! Damit tust du uns echt einen\ngroßen Gefallen.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2388,
      "rawDecodedUtf16Hex": "005600690065006C0065006E0020006C0069006500620065006E002000440061006E006B0021002000440061006D006900740020007400750073007400200064007500200075006E007300200065006300680074002000650069006E0065006E000A00670072006F00DF0065006E00200047006500660061006C006C0065006E002E001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Wenn du das hier bei dir trägst, sollten dir die\nUnratütox bis zu den Mülltonnen folgen.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Lauf nicht zu schnell, damit dir unterwegs\nkein Unratütox verloren geht!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Die Mülltonnen sind einfach geradeaus die\nStraße runter. Danke noch mal!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Die Mülltonnen sind einfach geradeaus die Straße\nrunter. Leg den Gourmetmüll bitte dort ab.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3232,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Führe die Unratütox bis zum Ende der Straße!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3244,
      "rawDecodedUtf16Hex": "004600FC006800720065002000640069006500200055006E00720061007400FC0074006F007800200062006900730020007A0075006D00200045006E0064006500200064006500720020005300740072006100DF006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3336,
      "rawDecodedUtf16Hex": "00100002BDFF00170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Möchtest du den Gourmetmüll hier ablegen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3348,
      "rawDecodedUtf16Hex": "004D00F6006300680074006500730074002000640075002000640065006E00200047006F00750072006D00650074006D00FC006C006C00200068006900650072002000610062006C006500670065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Ablegen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "00410062006C006500670065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Nicht ablegen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3448,
      "rawDecodedUtf16Hex": "004E0069006300680074002000610062006C006500670065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Tütooox!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3476,
      "rawDecodedUtf16Hex": "005400FC0074006F006F006F007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Die Unratütox stürzen sich auf den Gourmetmüll...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3496,
      "rawDecodedUtf16Hex": "00440069006500200055006E00720061007400FC0074006F007800200073007400FC0072007A0065006E002000730069006300680020006100750066002000640065006E00200047006F00750072006D00650074006D00FC006C006C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Vielen Dank, dass du den Müll weggebracht hast!<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3596,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B002C00200064006100730073002000640075002000640065006E0020004D00FC006C006C002000770065006700670065006200720061006300680074002000680061007300740021001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Von hier sollte der Geruch der Unratütox nicht\nbis zum Café hinüberwehen.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Die haben einen ganz schönen Appetit, was?<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3856,
      "rawDecodedUtf16Hex": "00440069006500200068006100620065006E002000650069006E0065006E002000670061006E007A002000730063006800F6006E0065006E00200041007000700065007400690074002C0020007700610073003F001000020114013E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Hm, das stimmt mich etwas nachdenklich...<U+0010><U+0001>븁\nMit Pokémon zusammenzuleben bedeutet mehr,\nals direkt nebeneinander zu existieren.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3952,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "Unratütox lieben die Kost aus unserem Café!\nAber im Laden können sie es leider nicht essen...<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Manchmal bedeutet Zusammenleben vielleicht\nauch, den richtigen Abstand zu finden.<U+0010><U+0002>Ĕľ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4412,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "<U+0010><U+0002>뷿#",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4584,
      "rawDecodedUtf16Hex": "00100002BDFF00230000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wie sie dir hinterherwatscheln...\nDas sieht echt süß aus!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4596,
      "rawDecodedUtf16Hex": "00570069006500200073006900650020006400690072002000680069006E0074006500720068006500720077006100740073006300680065006C006E002E002E002E000A004400610073002000730069006500680074002000650063006800740020007300FC00DF002000610075007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Nanu? Hier riecht es\nauf einmal so streng...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4712,
      "rawDecodedUtf16Hex": "004E0061006E0075003F002000480069006500720020007200690065006300680074002000650073000A006100750066002000650069006E006D0061006C00200073006F00200073007400720065006E0067002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Haha, ihr seht ja fast aus wie ein\nLegios! Na los, du schaffst das!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4804,
      "rawDecodedUtf16Hex": "0048006100680061002C0020006900680072002000730065006800740020006A00610020006600610073007400200061007500730020007700690065002000650069006E000A004C006500670069006F007300210020004E00610020006C006F0073002C002000640075002000730063006800610066006600730074002000640061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Unratütox vernichten\nfür uns den Müll, oder?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4940,
      "rawDecodedUtf16Hex": "0055006E00720061007400FC0074006F00780020007600650072006E00690063006800740065006E000A006600FC007200200075006E0073002000640065006E0020004D00FC006C006C002C0020006F006400650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Na, hast du die kleine Reise mit\nden Unratütox gut überstanden?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5032,
      "rawDecodedUtf16Hex": "004E0061002C0020006800610073007400200064007500200064006900650020006B006C00650069006E00650020005200650069007300650020006D00690074000A00640065006E00200055006E00720061007400FC0074006F00780020006700750074002000FC006200650072007300740061006E00640065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    }
