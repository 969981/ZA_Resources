    },
    {
      "displayText": "¿El Pasaje del Plenilunio? Qué extraño...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4736,
      "rawDecodedUtf16Hex": "00BF0045006C00200050006100730061006A0065002000640065006C00200050006C0065006E0069006C0075006E0069006F003F00200051007500E900200065007800740072006100F1006F002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¿Será que ahora Gengar descubrió su sentido\nde la moda, o qué?<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 4828,
      "rawDecodedUtf16Hex": "00BF00530065007200E10020007100750065002000610068006F00720061002000470065006E00670061007200200064006500730063007500620072006900F3002000730075002000730065006E007400690064006F000A006400650020006C00610020006D006F00640061002C0020006F00200071007500E9003F001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Podría haber ido al Pasaje de la Penumbra, y así\npasaba por Ignis Fatuus, mi tienda preferida.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 4964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "¡Vamos al Pasaje del Plenilunio, entonces!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5164,
      "rawDecodedUtf16Hex": "00A100560061006D006F007300200061006C00200050006100730061006A0065002000640065006C00200050006C0065006E0069006C0075006E0069006F002C00200065006E0074006F006E0063006500730021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Este lugar es mucho más adecuado. No me\nextrañaría que nos lo encontráramos.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 59,
      "offsetInSection": 5260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5424,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Chandelure, ¿notas algo?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5436,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002C002000BF006E006F00740061007300200061006C0067006F003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "¡Chan!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 5496,
      "rawDecodedUtf16Hex": "00A1004300680061006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "¿Gar?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5512,
      "rawDecodedUtf16Hex": "00BF004700610072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "¿Es él?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 5524,
      "rawDecodedUtf16Hex": "00BF00450073002000E9006C003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "No, esa no es su voz.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 5548,
      "rawDecodedUtf16Hex": "004E006F002C00200065007300610020006E006F00200065007300200073007500200076006F007A002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡Gengar! ¡No te alejes demasiado!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 5600,
      "rawDecodedUtf16Hex": "00A100470065006E0067006100720021002000A1004E006F00200074006500200061006C0065006A00650073002000640065006D00610073006900610064006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "¡Nos vamos a casa! Hoy para cenar hay estofado\ncriollo, tu preferido.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 5668,
      "rawDecodedUtf16Hex": "00A1004E006F0073002000760061006D006F00730020006100200063006100730061002100200048006F007900200070006100720061002000630065006E0061007200200068006100790020006500730074006F006600610064006F000A006300720069006F006C006C006F002C002000740075002000700072006500660065007200690064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Gen, gen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 5808,
      "rawDecodedUtf16Hex": "00470065006E002C002000670065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Chandelure, vuelve a intentarlo...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 5828,
      "rawDecodedUtf16Hex": "004300680061006E00640065006C007500720065002C0020007600750065006C007600650020006100200069006E00740065006E007400610072006C006F002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "No será necesario.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 5908,
      "rawDecodedUtf16Hex": "004E006F002000730065007200E10020006E0065006300650073006100720069006F002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Si ni siquiera Chandelure y tú pueden\nencontrarlo, yo me rindo.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 5956,
      "rawDecodedUtf16Hex": "005300690020006E00690020007300690071007500690065007200610020004300680061006E00640065006C007500720065002000790020007400FA002000700075006500640065006E000A0065006E0063006F006E0074007200610072006C006F002C00200079006F0020006D0065002000720069006E0064006F002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Pero...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 6092,
      "rawDecodedUtf16Hex": "005000650072006F002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Sé lo que estás pensando: si lo extraño tanto,\n¿por qué nunca me ofrecí a ser su Entrenador?<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6116,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Pero me di cuenta de que haberlo\nconocido es suficiente para mí.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 6312,
      "rawDecodedUtf16Hex": "005000650072006F0020006D00650020006400690020006300750065006E007400610020006400650020007100750065002000680061006200650072006C006F000A0063006F006E006F006300690064006F00200065007300200073007500660069006300690065006E00740065002000700061007200610020006D00ED002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Así de caprichoso es el destino. Sea como sea,\ngracias por ayudarme a buscarlo.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 75,
      "offsetInSection": 6452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Lamento no haber podido ser de más ayuda...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 6620,
      "rawDecodedUtf16Hex": "004C0061006D0065006E0074006F0020006E006F00200068006100620065007200200070006F006400690064006F00200073006500720020006400650020006D00E10073002000610079007500640061002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "¿Te imaginas que Gengar se obsesionó con\nla moda y se fue de compras o algo?<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 6716,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "<U+0010><U+0002>뷿N",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 6880,
      "rawDecodedUtf16Hex": "00100002BDFF004E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Mira, <U+0010><U+0002>Ā<U+0000>! ¡Gengar volvió!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 6892,
      "rawDecodedUtf16Hex": "00A1004D006900720061002C002000100002010000000021002000A100470065006E00670061007200200076006F006C0076006900F30021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Gen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 6960,
      "rawDecodedUtf16Hex": "00470065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Sé que es posible que se vuelva a ir y no regrese\njamás, así que pienso disfrutar de cada momento<U+0010><U+0001>븀\ncon él mientras dure.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 6976,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Ya le avisé a Inma que Gengar volvió.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 82,
      "offsetInSection": 7232,
      "rawDecodedUtf16Hex": "005900610020006C00650020006100760069007300E90020006100200049006E006D00610020007100750065002000470065006E00670061007200200076006F006C0076006900F3002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Gen, gen...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 7316,
      "rawDecodedUtf16Hex": "00470065006E002C002000670065006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    }
