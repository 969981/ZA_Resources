      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Por lo que me dices, ya veo qué tipo\nde personalidad tiene este Gengar.<U+0010><U+0002>Ĕ<U+0012>",
