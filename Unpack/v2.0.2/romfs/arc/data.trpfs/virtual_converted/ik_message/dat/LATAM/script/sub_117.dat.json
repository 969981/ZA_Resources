      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Te ayudaré, pero con una condición.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1928,
      "rawDecodedUtf16Hex": "00540065002000610079007500640061007200E9002C0020007000650072006F00200063006F006E00200075006E006100200063006F006E006400690063006900F3006E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Quiero un combate.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "00510075006900650072006F00200075006E00200063006F006D0062006100740065002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
