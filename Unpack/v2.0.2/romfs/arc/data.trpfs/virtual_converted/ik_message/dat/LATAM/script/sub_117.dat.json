      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Esta vez sí, obtendré la revancha.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2196,
