      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "004E006F0020007300E90020007300690020006500730020006200750065006E0061002000690064006500610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
