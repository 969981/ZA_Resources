      "index": 20,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Voy a pedirle a Chandelure que siga su rastro.<U+0010><U+0002>Ĕ<U+0012>",
