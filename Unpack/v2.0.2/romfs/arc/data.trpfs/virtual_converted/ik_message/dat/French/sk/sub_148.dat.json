  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Excusez-moi. Qu’est-il arrivé à ce café ?\nAurait-il mis la clé sous la porte ?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Oui, il a fermé.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "004F00750069002C00200069006C002000610020006600650072006D00E9002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Il s’est passé beaucoup de choses, ici...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "0049006C0020007320190065007300740020007000610073007300E9002000620065006100750063006F00750070002000640065002000630068006F007300650073002C0020006900630069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Oh, je vois... C’est dommage.<U+0010><U+0001>븁\nCela fait dix ans que je n’ai pas mis les pieds\nà Illumis, et j’aurais bien aimé boire à nouveau<U+0010><U+0001>븀\nle café qu’on servait ici.<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 772,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 164
    },
    {
      "displayText": "Vous ne sauriez pas à qui appartenait ce café,\npar hasard ?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "0056006F007500730020006E00650020007300610075007200690065007A0020007000610073002000E0002000710075006900200061007000700061007200740065006E006100690074002000630065002000630061006600E9002C000A00700061007200200068006100730061007200640020003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Si, je sais.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "00530069002C0020006A006500200073006100690073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Vous voulez que je les appelle ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "0056006F0075007300200076006F0075006C0065007A00200071007500650020006A00650020006C0065007300200061007000700065006C006C00650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Oh, vraiment ? Vous pourriez les contacter\npour moi ?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "004F0068002C00200076007200610069006D0065006E00740020003F00200056006F0075007300200070006F00750072007200690065007A0020006C0065007300200063006F006E007400610063007400650072000A0070006F007500720020006D006F00690020003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Qui souhaitez-vous appeler ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "00510075006900200073006F007500680061006900740065007A002D0076006F0075007300200061007000700065006C006500720020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Cendro",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "00430065006E00640072006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Cendrie",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "00430065006E00640072006900650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Allô ? Que désires-tu ?<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "0041006C006C00F40020003F00200051007500650020006400E900730069007200650073002D007400750020003F00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Je vois...<U+0010><U+0001>븁\nDans ce cas, je te suggère de t’adresser à\nla gérante du Néo Café nº 3, Thérèse.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Elle a travaillé auprès de l’ancien barista du\nCafé Lysandre.<U+0010><U+0002>Ĕ<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1788,
      "rawDecodedUtf16Hex": "0045006C006C0065002000610020007400720061007600610069006C006C00E90020006100750070007200E800730020006400650020006C20190061006E006300690065006E00200062006100720069007300740061002000640075000A00430061006600E90020004C007900730061006E006400720065002E00100002011400170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Quoi ?! C’est pour une livraison ?<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1920,
      "rawDecodedUtf16Hex": "00510075006F00690020003F002100200043201900650073007400200070006F0075007200200075006E00650020006C006900760072006100690073006F006E0020003F00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Tu cherches quelqu’un ? Pfff, tu m’prends pour\nune détective ou quoi ?<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2000,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "L’ancien barista du Café Lysandre ?\nJ’en sais rien, moi !<U+0010><U+0001>븁\nVa demander à Thérèse !\nC’est elle qui gère le Néo Café nº 3.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "J’crois qu’elle a bossé avec le barista\nqu’tu cherches.<U+0010><U+0002>Ĕ<U+0018>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "004A201900630072006F0069007300200071007520190065006C006C00650020006100200062006F0073007300E9002000610076006500630020006C006500200062006100720069007300740061000A00710075201900740075002000630068006500720063006800650073002E00100002011400180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "On pourra en savoir plus sur l’ancien barista\nen allant au Néo Café nº 3, alors ?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Il me semble qu’il se trouve dans le <U+0010><U+0002>＀<U+0006>quartier\nde Rosavilliers<U+0010><U+0002>＀<U+0000>...<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 8,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Je m’y rends sur-le-champ !\nRetrouvez-moi là-bas !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2856,
      "rawDecodedUtf16Hex": "004A00650020006D20190079002000720065006E006400730020007300750072002D006C0065002D006300680061006D007000200021000A0052006500740072006F007500760065007A002D006D006F00690020006C00E0002D0062006100730020002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ah, <U+0010><U+0002>Ā<U+0000> ! Vous voilà enfin !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2980,
      "rawDecodedUtf16Hex": "00410068002C002000100002010000000020002100200056006F0075007300200076006F0069006C00E000200065006E00660069006E0020002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Renseignons-nous sans plus attendre sur\nle barista du Café Lysandre !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3048,
      "rawDecodedUtf16Hex": "00520065006E0073006500690067006E006F006E0073002D006E006F00750073002000730061006E007300200070006C0075007300200061007400740065006E0064007200650020007300750072000A006C006500200062006100720069007300740061002000640075002000430061006600E90020004C007900730061006E0064007200650020002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Vous n’êtes pas là pour... boire un café,\nà ce que je vois. Que puis-je faire pour vous ?<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Je vois... On vous a bien renseigné. En effet,\nje connais l’ancien barista du Café Lysandre.<U+0010><U+0001>븁\nD’ailleurs, c’est lui qui m’a appris à faire le café.\nC’est mon mentor, en quelque sorte.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 190
    },
    {
      "displayText": "Je pense qu’il serait ravi d’apprendre qu’un client\nréclame ses services, même dix ans après !<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Je vais lui dire que vous souhaitez le voir.\nRetrouvons-nous devant le Café Lysandre.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Je cours de ce pas vous attendre là-bas !\nÀ tout à l’heure !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4144,
      "rawDecodedUtf16Hex": "004A006500200063006F007500720073002000640065002000630065002000700061007300200076006F0075007300200061007400740065006E0064007200650020006C00E0002D00620061007300200021000A00C000200074006F00750074002000E00020006C2019006800650075007200650020002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Je me charge de contacter mon mentor.\nAttendez-moi au Café Lysandre.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4276,
      "rawDecodedUtf16Hex": "004A00650020006D0065002000630068006100720067006500200064006500200063006F006E0074006100630074006500720020006D006F006E0020006D0065006E0074006F0072002E000A0041007400740065006E00640065007A002D006D006F0069002000610075002000430061006600E90020004C007900730061006E006400720065002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4424,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Je suis tellement impatient de revoir le barista\nde ce café ! J’en ai le cœur qui bat la chamade !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4436,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "Pardon, nous vous avons fait attendre.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4644,
      "rawDecodedUtf16Hex": "0050006100720064006F006E002C0020006E006F0075007300200076006F00750073002000610076006F006E00730020006600610069007400200061007400740065006E006400720065002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Permettez-moi de vous présenter le barista du\nCafé Lysandre et mon mentor : Monsieur Barry.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "« Ancien » barista.<U+0010><U+0001>븁\nJ’ai du mal à croire que vous vous souvenez\nde mon café, alors que dix ans se sont écoulés.<U+0010><U+0001>븁\nJe suis vraiment honoré...<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4924,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "Je comprends que vous vouliez goûter à mon café\nà nouveau, mais il y a un problème...<U+0010><U+0001>븁\nVoyez-vous, à l’époque, je torréfiais les grains de\ncafé à l’aide des capacités de mes Pokémon...<U+0010><U+0001>븁\nMais depuis, le temps a passé et je manque\ncruellement d’entraînement.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 265
    },
    {
      "displayText": "Accepteriez-vous de vous battre contre moi ?\nUn combat me permettrait de m’échauffer un peu.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 5756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Monsieur Barry, s’il vous plaît !\nLaissez-moi participer à ce combat !<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5952,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "<U+0010><U+0002>뷿&",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 6104,
      "rawDecodedUtf16Hex": "00100002BDFF00260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ça alors, je ne m’attendais pas à affronter\nl<U+0010><U+0003>ᄀÿࠇe héros’héroïne qui a sauvé notre ville !<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 6116,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "En tout cas, ce combat m’a revigoré.\nEntrez, je vais vous préparer un bon café.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 6308,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "<U+0010><U+0002>뷿)",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 6476,
      "rawDecodedUtf16Hex": "00100002BDFF00290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Les tasses sont un peu poussiéreuses, mais elles\nsont en bon état. Un petit coup d’éponge et ça ira.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6488,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Parfait. Je vais pouvoir vous servir le même café\nqu’à l’époque...<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6700,
      "rawDecodedUtf16Hex": "0050006100720066006100690074002E0020004A00650020007600610069007300200070006F00750076006F0069007200200076006F0075007300200073006500720076006900720020006C00650020006D00EA006D0065002000630061006600E9000A00710075201900E00020006C201900E90070006F007100750065002E002E002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Asseyez-vous donc pendant que nous préparons\ntout cela.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 44,
      "offsetInSection": 6844,
      "rawDecodedUtf16Hex": "004100730073006500790065007A002D0076006F0075007300200064006F006E0063002000700065006E00640061006E007400200071007500650020006E006F0075007300200070007200E9007000610072006F006E0073000A0074006F00750074002000630065006C0061002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Oh... Je le reconnais. C’est le même café...<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 45,
      "offsetInSection": 6964,
      "rawDecodedUtf16Hex": "004F0068002E002E002E0020004A00650020006C00650020007200650063006F006E006E006100690073002E0020004320190065007300740020006C00650020006D00EA006D0065002000630061006600E9002E002E002E00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Son arôme délicieux entre par mes narines\net traverse tout mon corps...<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 7064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Monsieur le barista ! Votre café est aussi\ndélicieux qu’il y a dix ans... Si ce n’est meilleur !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 7216,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Vos compliments me vont droit au cœur.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 7420,
      "rawDecodedUtf16Hex": "0056006F007300200063006F006D0070006C0069006D0065006E007400730020006D006500200076006F006E0074002000640072006F0069007400200061007500200063015300750072002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Mais j’ai un aveu à vous faire...\nJe vous ai menti.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 7508,
      "rawDecodedUtf16Hex": "004D0061006900730020006A20190061006900200075006E00200061007600650075002000E000200076006F00750073002000660061006900720065002E002E002E000A004A006500200076006F007500730020006100690020006D0065006E00740069002E00100002011401B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Que voulez-vous dire ?<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 7620,
      "rawDecodedUtf16Hex": "00510075006500200076006F0075006C0065007A002D0076006F00750073002000640069007200650020003F00100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "En fait, c’est moi qui ai préparé ce café.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 51,
      "offsetInSection": 7676,
      "rawDecodedUtf16Hex": "0045006E00200066006100690074002C0020006320190065007300740020006D006F0069002000710075006900200061006900200070007200E900700061007200E9002000630065002000630061006600E9002E00100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Comment ?!<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 7772,
      "rawDecodedUtf16Hex": "0043006F006D006D0065006E00740020003F002100100002011401B70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "J’ai bel et bien travaillé ici en tant que barista,\nmais j’ai quitté ce milieu suite aux événements<U+0010><U+0001>븀\nprovoqués par la Team Flare...<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 7804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "C’est Thérèse qui a insisté pour que ma spécialité\nne tombe pas dans l’oubli.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 8080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "La ville change, évolue, mais on souhaite malgré\ntout en conserver des souvenirs, des sensations.<U+0010><U+0001>븁\nEt votre café en fait partie, monsieur Barry.<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 8244,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 151
    },
    {
      "displayText": "C’est en effet une manière de laisser une trace,\nun témoin de la vie que mènent la population<U+0010><U+0001>븀\net les Pokémon à Illumis.<U+0010><U+0002>ĔƸ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 8548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Je suis rassuré... Cela signifie que je pourrai\ncontinuer à boire ce délicieux café !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 8804,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Je ne sais pas encore quand je reviendrai à\nIllumis, mais comptez sur moi pour vous rendre<U+0010><U+0001>븀\nà nouveau visite !<U+0010><U+0002>ĔƷ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 8984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 117
    },
    {
      "displayText": "Avec plaisir ! Je vous accueillerai avec une tasse\nde café !<U+0010><U+0002>Ĕƹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 59,
      "offsetInSection": 9220,
      "rawDecodedUtf16Hex": "004100760065006300200070006C00610069007300690072002000210020004A006500200076006F007500730020006100630063007500650069006C006C00650072006100690020006100760065006300200075006E0065002000740061007300730065000A00640065002000630061006600E90020002100100002011401B90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    }
