      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "We are all Trainers who live in the blessed\ncompany of Starmie.<U+0010><U+0002>Ĕż",
      "escapedControlUnits": 2,
