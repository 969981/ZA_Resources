      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 520,
      "rawDecodedUtf16Hex": "800C4E145F9E5C4B98024E0A9084670350B34F86000A8A6D75707684807297F320262026001000020114013F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "不去查原因我就會心惶惶，\n但又總覺得好恐怖……<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
