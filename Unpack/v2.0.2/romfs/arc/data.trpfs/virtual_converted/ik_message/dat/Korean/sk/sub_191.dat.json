      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "좋아요.\n철저히 준비해 주세요.<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
