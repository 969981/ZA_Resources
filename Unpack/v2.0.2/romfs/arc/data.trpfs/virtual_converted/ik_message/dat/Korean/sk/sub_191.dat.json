      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "B610002C0020AE30C220C7440020C0ACC6A9D558B2940020B3D9C548C5D0B2940020BB34BC29BE440020C0C1D0DCB77C000AC0ACC6A9D558B2940020D0C0C774BC0DC7440020C7980020ACE0B824D574C57C002E002E002E00100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "아아... 승부에서 연속 기술을 사용할 때\n고려해야 할 것이 너무 많아요...<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "C544C544002E002E002E0020C2B9BD80C5D0C11C0020C5F0C18D0020AE30C220C7440020C0ACC6A9D5600020B54C000AACE0B824D574C57C0020D5600020AC83C7740020B108BB340020B9CEC544C694002E002E002E00100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "저기...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1612,
      "rawDecodedUtf16Hex": "C800AE30002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "계속하실 건가요?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
