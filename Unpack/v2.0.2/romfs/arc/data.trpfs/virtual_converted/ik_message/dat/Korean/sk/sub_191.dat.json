  "messages": [
    {
      "displayText": "세상에서 가장 화려한 기술...\n그것은 바로 연속 기술!<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
