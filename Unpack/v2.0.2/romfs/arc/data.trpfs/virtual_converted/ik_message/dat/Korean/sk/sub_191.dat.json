      "rawDecodedUtf16Hex": "D654B824D558AC8C002100100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "물 흐르듯!<U+0010><U+0002>ĔǦ",
