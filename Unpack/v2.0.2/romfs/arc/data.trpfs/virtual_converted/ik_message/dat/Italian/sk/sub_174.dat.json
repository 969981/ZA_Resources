      "rawDecodedUtf16Hex": "00530074006F002000630065007200630061006E0064006F00200069006C002000730075006F002000700072006F00700072006900650074006100720069006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Stai cercando la persona il cui nome è ricamato\nsu questa sciarpa... Che storia ricca di stile!<U+0010><U+0002>Ĕ:",
      "escapedControlUnits": 2,
      "flagsUpper16": 8,
