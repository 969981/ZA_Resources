      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 5376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
