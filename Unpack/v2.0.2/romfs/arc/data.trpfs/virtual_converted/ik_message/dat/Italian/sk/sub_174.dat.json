      "offsetInSection": 6248,
      "rawDecodedUtf16Hex": "00100002BDFF00330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Potresti lottare contro me e il mio Corvisquire?<U+0010><U+0002>Ĕǌ",
