      "rawDecodedUtf16Hex": "00100002BDFF00390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Corvisquire... Abbiamo perso, ma sei stato\nfantastico!<U+0010><U+0001>븁\nMi impegnerò per diventare un Allenatore alla tua\naltezza.<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
