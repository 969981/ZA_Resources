      "rawDecodedUtf16Hex": "00530071007500690069006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Ehi, Allenat<U+0010><U+0003>ᄀÿ̂orrice! Hai aiutato Corvisquire a\nritrovarmi, vero? Grazie mille!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 44,
      "offsetInSection": 5592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Ti dispiace se lo tengo con me come mio\nPokémon?<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5768,
      "rawDecodedUtf16Hex": "005400690020006400690073007000690061006300650020007300650020006C006F002000740065006E0067006F00200063006F006E0020006D006500200063006F006D00650020006D0069006F000A0050006F006B00E9006D006F006E003F00100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Ma certo che no",
