      "offsetInSection": 4328,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 153
    },
    {
      "displayText": "Se il proprietario della sciarpa si trova qui a\nLuminopoli, suppongo frequenti l’Istituto Étoile.<U+0010><U+0002>Ĕ:",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
