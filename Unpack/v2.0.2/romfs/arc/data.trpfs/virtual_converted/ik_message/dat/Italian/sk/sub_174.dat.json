      "offsetInSection": 6732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Accidenti! Sei troppo forte!<U+0010><U+0001>븁\nMi impegnerò anch’io per diventare un Allenatore\nalla tua altezza.<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 4,
