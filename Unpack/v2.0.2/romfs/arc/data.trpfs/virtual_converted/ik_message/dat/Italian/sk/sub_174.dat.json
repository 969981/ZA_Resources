      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5528,
      "rawDecodedUtf16Hex": "004D0061002000730065006900200075006E002000660065006E006F006D0065006E006F002100100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
