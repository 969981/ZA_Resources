      "rawDecodedUtf16Hex": "00530071007500690069006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Eri così piccolo... e pure ferito...<U+0010><U+0002>Ĕǌ",
