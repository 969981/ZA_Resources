      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Sono Asami, una semplice stilista!<U+0010><U+0002>Ĕ:",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2884,
      "rawDecodedUtf16Hex": "0053006F006E006F0020004100730061006D0069002C00200075006E0061002000730065006D0070006C0069006300650020007300740069006C00690073007400610021001000020114003A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Sei in cerca di un’altra lotta Pokémon piena di\nstile a colpi di megaevoluzione?<U+0010><U+0002>Ĕ:",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
