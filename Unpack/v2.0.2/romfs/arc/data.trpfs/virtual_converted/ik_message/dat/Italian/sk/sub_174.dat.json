      "rawDecodedUtf16Hex": "0043007200650064006F002000630068006500200061006E0063006800650020006C007500690020006C006F00200076006F0067006C006900610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Posso farti un’altra richiesta? Vorrei che\naffrontassi me e il mio Corvisquire!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Quando sei pront<U+0010><U+0003>ᄀÿāoa a lottare, dimmelo.<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6136,
