  "initialKey": 0,
  "messages": [
    {
      "displayText": "<U+0010><U+0002>뷿",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 300,
      "rawDecodedUtf16Hex": "00100002BDFF00000000",
      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "Votre présence a été détectée !\nUne partie du courant a été rétablie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 312,
      "rawDecodedUtf16Hex": "0056006F00740072006500200070007200E900730065006E0063006500200061002000E9007400E90020006400E9007400650063007400E9006500200021000A0055006E0065002000700061007200740069006500200064007500200063006F007500720061006E007400200061002000E9007400E90020007200E9007400610062006C00690065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Lancement du protocole de sécurité...<U+0010><U+0001>븁\nMéga-Gemmes détectées.\nRéactivation d’une partie des systèmes.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Activation du projet M.<U+0010><U+0001>븁\nDéverrouiller le projet comporte des risques\nmajeurs. Voulez-vous continuer ?",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Déverrouiller",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "004400E90076006500720072006F00750069006C006C006500720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Ne rien faire",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "004E00650020007200690065006E0020006600610069007200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Qu’est-ce que tu fabriques ici, <U+0010><U+0002>Ā<U+0000> ?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "005100752019006500730074002D00630065002000710075006500200074007500200066006100620072006900710075006500730020006900630069002C002000100002010000000020003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Tu te crois de taille à affronter un Pokémon aussi\ndangereux que Mewtwo ?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Si c’est le cas, t’as intérêt à l’attraper !<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1172,
      "rawDecodedUtf16Hex": "005300690020006320190065007300740020006C00650020006300610073002C0020007420190061007300200069006E007400E9007200EA0074002000E00020006C2019006100740074007200610070006500720020002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "T’as intérêt à attraper Mewtwo !<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "005420190061007300200069006E007400E9007200EA0074002000E00020006100740074007200610070006500720020004D0065007700740077006F0020002100100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Meeew !!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1360,
      "rawDecodedUtf16Hex": "004D006500650065007700200021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1380,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Je t’ai dit d’attraper Mewtwo !\nT’es sourd<U+0010><U+0003>ᄀÿĀe, ou quoi ?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1392,
      "rawDecodedUtf16Hex": "004A0065002000742019006100690020006400690074002000642019006100740074007200610070006500720020004D0065007700740077006F00200021000A005420190065007300200073006F00750072006400100003110000FF01000065002C0020006F0075002000710075006F00690020003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Je t’ai dit d’ATTRAPER Mewtwo ! Je sais que\ntu peux le battre, pas la peine de le prouver !<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1520,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Ah, très bien. Belle capture.\nAttends un instant.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1712,
      "rawDecodedUtf16Hex": "00410068002C00200074007200E800730020006200690065006E002E002000420065006C006C006500200063006100700074007500720065002E000A0041007400740065006E0064007300200075006E00200069006E007300740061006E0074002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "*soupir* Chaque fois que je vois l’état de\nce labo, ça me fait quelque chose...<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1820,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Je crois que j’avais encore besoin de constater les\ndégâts de mes propres « holo-yeux », si j’ose dire.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "Tu te demandes sûrement pourquoi t’as affronté\nMewtwo dans les Labos Lysandre.<U+0010><U+0001>븁\nJe peux t’expliquer, si tu veux.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2204,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "J’aimerais bien savoir, oui.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2444,
      "rawDecodedUtf16Hex": "004A201900610069006D006500720061006900730020006200690065006E0020007300610076006F00690072002C0020006F00750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Vous n’avez rien de mieux à faire ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "0056006F007500730020006E2019006100760065007A0020007200690065006E0020006400650020006D0069006500750078002000E00020006600610069007200650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Très bien, j’aime les gens qui vont droit au but.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2576,
      "rawDecodedUtf16Hex": "0054007200E800730020006200690065006E002C0020006A201900610069006D00650020006C00650073002000670065006E0073002000710075006900200076006F006E0074002000640072006F006900740020006100750020006200750074002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "...\nJe vais faire semblant d’avoir rien entendu.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2684,
      "rawDecodedUtf16Hex": "002E002E002E000A004A006500200076006100690073002000660061006900720065002000730065006D0062006C0061006E007400200064201900610076006F006900720020007200690065006E00200065006E00740065006E00640075002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Mewtwo est un Pokémon créé par un scientifique\nqui étudiait l’ADN des Pokémon.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Son énergie est si forte que la Team Flare a étudié\nla possibilité de l’intégrer à l’arme suprême.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2960,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
      "displayText": "C’est à ce moment que la Team Flare a eu vent de\nl’apparition de Mewtwo dans la Grotte Inconnue.<U+0010><U+0001>븁\nElle est partie à sa rencontre et l’a attrapé.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3168,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 151
    },
    {
      "displayText": "Personne sait pourquoi Mewtwo avait décidé\nde venir faire du tourisme à Kalos.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3472,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Peut-être qu’il était attiré par la puissance de\nla Méga-Évolution ?<U+0010><U+0001>븁\nMême en mettant nos cinq brillants cerveaux\nen commun, on a pas réussi à percer ce mystère.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 168
    },
    {
      "displayText": "Et malgré nos tests avec la Mewtwoïte X et\nla Mewtwoïte Y, il refusait de méga-évoluer.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3976,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "En temps normal, Mewtwo reste sédentaire pour\néconomiser son énergie et se préparer au combat.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 4160,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Bref, finalement le projet M a été mis en pause\njusqu’à nouvel ordre... puis laissé de côté.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Mais voilà un nouveau mystère : qu’est-ce qui\na poussé Mewtwo à réagir maintenant ?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Est-ce qu’il a détecté que tu portais à la fois\nune Mewtwoïte X et une Mewtwoïte Y ?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 4732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Et tant qu’on y est... pourquoi tu possèdes\nces deux Méga-Gemmes ?<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 4912,
      "rawDecodedUtf16Hex": "00450074002000740061006E00740020007100752019006F006E002000790020006500730074002E002E002E00200070006F0075007200710075006F006900200074007500200070006F0073007300E8006400650073000A006300650073002000640065007500780020004D00E900670061002D00470065006D006D006500730020003F00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "... Bah, peu importe.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 5056,
      "rawDecodedUtf16Hex": "002E002E002E0020004200610068002C002000700065007500200069006D0070006F007200740065002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Tu possèdes suffisamment de talent pour\nque Mewtwo t’obéisse.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5108,
      "rawDecodedUtf16Hex": "0054007500200070006F0073007300E800640065007300200073007500660066006900730061006D006D0065006E0074002000640065002000740061006C0065006E007400200070006F00750072000A0071007500650020004D0065007700740077006F002000742019006F006200E90069007300730065002E00100002011400070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Moi, j’ai mes responsabilités de directrice adjointe\nà gérer, donc je te laisse. Bye !<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5240,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    }
  ],
