      "index": 4,
      "offsetInSection": 748,
      "rawDecodedUtf16Hex": "005400680069006E006B00200079006F007500200063006F0075006C006400200064006F002000750073002000610020006C006900740074006C00650020006600610076006F0072003F00100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "See, we’re really big Spewpa fans.<U+0010><U+0002>ĔƗ",
