      "rawDecodedUtf16Hex": "004F006E0065002E002E002E00740077006F002E002E002E00740068007200650065002E002E002E0066006F00750072002E002E002E0066006900760065002E002E002E007300690078002E002E002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Seven...eight...nine...ten...eleven...twelve...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5284,
      "rawDecodedUtf16Hex": "0053006500760065006E002E002E002E00650069006700680074002E002E002E006E0069006E0065002E002E002E00740065006E002E002E002E0065006C006500760065006E002E002E002E007400770065006C00760065002E002E002E00100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Thir...teen?<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5388,
      "rawDecodedUtf16Hex": "0054006800690072002E002E002E007400650065006E003F00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "What?! Where’d the thirteenth one come from?!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5424,
      "rawDecodedUtf16Hex": "0057006800610074003F002100200057006800650072006520190064002000740068006500200074006800690072007400650065006E007400680020006F006E006500200063006F006D0065002000660072006F006D003F002100100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "I don’t know, but we can only take twelve of them\nbetween the two of us...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 62,
      "offsetInSection": 5524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "I suppose the best solution would be to have this\nkind Trainer take this new fellow off our hands?<U+0010><U+0001>븁\nWe can’t leave it here alone—it might damage the\nart and end up in real trouble...<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 63,
      "offsetInSection": 5684,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 189
    },
    {
      "displayText": "Oh! But your Boxes are all full, aren’t they?<U+0010><U+0001>븁\nThen we’ll keep an eye on this Spewpa until you\nmake space for it. Come back soon, though!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 64,
      "offsetInSection": 6064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 144
    },
    {
      "displayText": "I wonder if our 12 Spewpa went wandering off to\nfind that 13th Spewpa or something...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 65,
      "offsetInSection": 6352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "We simply can’t thank you enough for helping us\nfind our precious Spewpa!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6532,
