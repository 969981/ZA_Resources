      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "There are <U+0010><U+0002>＀<U+0006>12<U+0010><U+0002>＀<U+0000> of them in all.<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 8,
