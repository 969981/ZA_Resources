      "rawDecodedUtf16Hex": "004800610069002000740072006F007600610074006F00200075006E006F00200053007000650077007000610020006E006100730063006F00730074006F00200069006E00200075006E00200061006E0067006F006C0069006E006F000A00640069006D0065006E00740069006300610074006F002000640065006C0020006D007500730065006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Pew.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 4932,
      "rawDecodedUtf16Hex": "005000650077002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>뷿7",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4944,
      "rawDecodedUtf16Hex": "00100002BDFF00370000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hai trovato tutti i nostri Spewpa! Grazie mille!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 4956,
      "rawDecodedUtf16Hex": "004800610069002000740072006F007600610074006F002000740075007400740069002000690020006E006F0073007400720069002000530070006500770070006100210020004700720061007A006900650020006D0069006C006C0065002100100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Oh, i nostri cari Spewpa...\nFacciamo un conteggio, tanto per stare sicuri.<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 57,
      "offsetInSection": 5064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Uno... Due... Tre... Quattro... Cinque... Sei...<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 5224,
      "rawDecodedUtf16Hex": "0055006E006F002E002E002E0020004400750065002E002E002E0020005400720065002E002E002E0020005100750061007400740072006F002E002E002E002000430069006E007100750065002E002E002E0020005300650069002E002E002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Sette... Otto... Nove... Dieci... Undici... Dodici...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5332,
      "rawDecodedUtf16Hex": "00530065007400740065002E002E002E0020004F00740074006F002E002E002E0020004E006F00760065002E002E002E002000440069006500630069002E002E002E00200055006E0064006900630069002E002E002E00200044006F0064006900630069002E002E002E00100002011401980000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Tredici...?<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5448,
      "rawDecodedUtf16Hex": "0054007200650064006900630069002E002E002E003F00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Ma che?! E il tredicesimo da dov’è saltato fuori?!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5480,
      "rawDecodedUtf16Hex": "004D00610020006300680065003F00210020004500200069006C0020007400720065006400690063006500730069006D006F00200064006100200064006F0076201900E8002000730061006C007400610074006F002000660075006F00720069003F002100100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "E adesso che facciamo? Non c’è spazio per un\ntredicesimo Spewpa nelle nostre squadre!<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 62,
      "offsetInSection": 5592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Ho la soluzione perfetta! Perché non lo diamo\nall’Allenat<U+0010><U+0003>ᄀÿ̂orrice che ci ha aiutati?<U+0010><U+0001>븁\nNon possiamo mica lasciarlo qui nel museo, o\nrovinerebbe tutte le opere d’arte!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 63,
      "offsetInSection": 5772,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 175
    },
    {
      "displayText": "Oh! Vedo che hai i box pieni. Allora terremo\nd’occhio noi questo Spewpa finché non avrai<U+0010><U+0001>븀\nfatto un po’ di spazio per lui, va bene?<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 64,
      "offsetInSection": 6124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "Forse gli altri Spewpa se n’erano andati in giro per\nil museo perché sentivano che qui dentro c’era<U+0010><U+0001>븀\nun loro simile da incontrare...?<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 6400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "Grazie ancora per averci aiutato!<U+0010><U+0002>ĔƗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6680,
      "rawDecodedUtf16Hex": "004700720061007A0069006500200061006E0063006F00720061002000700065007200200061007600650072006300690020006100690075007400610074006F002100100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    }
