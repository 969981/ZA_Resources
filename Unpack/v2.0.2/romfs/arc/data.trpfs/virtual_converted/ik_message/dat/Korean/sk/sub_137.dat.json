      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>ā\n<U+0010><U+0002>ᤀ<U+0006>라!\n오오! 어메이징!<U+0010><U+0001>븁\n내가 상상한 그대로야!\n이걸로 세 마리가 모두 모였구나! 고맙다!<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "001000020101000A0010000219000006B77C0021000AC624C62400210020C5B4BA54C774C9D5002100100001BE01000AB0B4AC000020C0C1C0C1D55C0020ADF8B300B85CC57C0021000AC774AC78B85C0020C1380020B9C8B9ACAC000020BAA8B4500020BAA8C600AD6CB09800210020ACE0B9D9B2E4002100100002011401B50000",
