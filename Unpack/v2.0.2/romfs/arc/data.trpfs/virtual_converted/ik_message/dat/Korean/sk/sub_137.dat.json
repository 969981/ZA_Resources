      "offsetInSection": 3832,
      "rawDecodedUtf16Hex": "0010000201020002B098C774D2B8B97C0020CC3EB2940020BAA8D5D8C744000AACC4C18DD558ACA0B2E4B2940020ACB0C758B97C0020B2E4C9C0AC8C0020B41CB2E4002100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "어때?\n정말 멋진 스토리가 될 것 같지?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
