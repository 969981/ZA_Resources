      "index": 14,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "C870AC74C7440020C124BA85D5740020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "기다려 주세요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
