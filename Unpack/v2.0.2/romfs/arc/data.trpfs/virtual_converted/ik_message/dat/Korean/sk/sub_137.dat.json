      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "두 번째, 화염방사를 배운 포켓몬.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
