      "rawDecodedUtf16Hex": "C774BC88C5D00020AD6CC0C10020C911C7780020AC740020BAA8D5D80020C18CC124C774B780B2E4002E00100001BE01000AD611B825D5740020C9000020B108C5D0AC8C000AC904AC70B9ACB97C0020C0B4C9DD0020AC00B974CCD00020C8FCB9C8002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "칼로스지방의 어느 깊은 숲속...<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
