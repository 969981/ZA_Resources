      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "<U+0010><U+0002>Ă<U+0003><U+0010><U+0002>ᤀ<U+0004> <U+0010><U+0002>Ă<U+0004><U+0010><U+0002>ᤀ<U+0002>\n칼로스의 해신의 굴로 내던져 버렸다!<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 14,
      "flagsUpper16": 0,
