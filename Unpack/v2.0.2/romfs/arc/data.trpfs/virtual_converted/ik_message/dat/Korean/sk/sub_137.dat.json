      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "그럴 것 같아요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 3968,
      "rawDecodedUtf16Hex": "ADF8B7F40020AC830020AC19C544C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
