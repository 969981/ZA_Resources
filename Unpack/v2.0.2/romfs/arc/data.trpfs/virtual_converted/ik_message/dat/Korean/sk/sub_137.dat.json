      "rawDecodedUtf16Hex": "00100002010200030010000219000004002000100002010200040010000219000002000ACE7CB85CC2A4C7580020D574C2E0C7580020AD74B85C0020B0B4B358C8380020BC84B838B2E4002100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "모든 일을 지켜보고 있던\n메가진화를 관장하는 자, <U+0010><U+0002>Ƌ<U+0001><U+0010><U+0002>ᤀ<U+0001>...<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 3552,
      "rawDecodedUtf16Hex": "BAA8B4E00020C77CC7440020C9C0CF1CBCF4ACE00020C788B358000ABA54AC00C9C4D654B97C0020AD00C7A5D558B2940020C790002C002000100002018B00010010000219000001002E002E002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>의 강함을 인정하여\n메가진화의 모습을 부여하였다!<U+0010><U+0002>ĔƵ",
