      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Si tratta di un Pokémon generato artificialmente\ndall’uomo oltre 500 anni fa: Magearna.<U+0010><U+0002>Ĕ<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
