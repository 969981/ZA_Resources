      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Lo abbiamo rinvenuto durante i lavori per il piano\ndi sviluppo urbano, ma sembra addormentato...<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
