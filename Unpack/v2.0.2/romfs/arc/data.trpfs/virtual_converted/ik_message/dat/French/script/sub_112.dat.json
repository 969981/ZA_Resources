      "index": 38,
      "offsetInSection": 4744,
      "rawDecodedUtf16Hex": "0056006F0075007300200064006500760065007A0020006600610069007200650020006400650020006C006100200070006C006100630065002000640061006E007300200076006F007300200042006F00EE00740065007300200070006F00750072000A006100630063007500650069006C006C006900720020004600650075006E006E00650063002E0000",
      "trailingZeroPaddingUnits": 1,
