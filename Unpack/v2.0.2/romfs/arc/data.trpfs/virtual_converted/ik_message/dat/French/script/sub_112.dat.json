      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Feufeu !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4404,
      "rawDecodedUtf16Hex": "004600650075006600650075002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Oh, que c’est mignon ! Il a l’air de vouloir te\nremercier. Et si tu l’emmenais avec toi ?<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4424,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
