      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un Rameau de Vie...<U+0010><U+0001>븁\nL’ancien patron de l’herboristerie est vraiment\nformidable ! Et toi aussi, tu es formidable !<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3852,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Donnons-le au Feunnec tout de suite !<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4096,
