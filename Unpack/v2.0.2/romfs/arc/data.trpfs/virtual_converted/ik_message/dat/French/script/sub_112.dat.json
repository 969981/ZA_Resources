      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Vous donnez le Rameau de Vie au Feunnec.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4180,
