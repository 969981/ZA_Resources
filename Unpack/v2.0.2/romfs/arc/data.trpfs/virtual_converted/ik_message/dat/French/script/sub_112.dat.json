      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2716,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "On peut trouver des Rameaux de Vie dans la zone\nsauvage nº 5, dans le quartier de Valcyan.<U+0010><U+0001>븀\nTu les reconnaîtras à leur odeur sucrée.<U+0010><U+0002>Ĕ<U+001E>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2728,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3008,
      "rawDecodedUtf16Hex": "00100002BDFF00140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Cette branche est toute sèche...\nCela n’a pas l’air d’être un Rameau de Vie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Cette branche a été rongée...\nCela n’a pas l’air d’être un Rameau de Vie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3176,
      "rawDecodedUtf16Hex": "004300650074007400650020006200720061006E00630068006500200061002000E9007400E900200072006F006E006700E90065002E002E002E000A00430065006C00610020006E2019006100200070006100730020006C201900610069007200200064201900EA00740072006500200075006E002000520061006D0065006100750020006400650020005600690065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Cette branche est brisée...\nCela n’a pas l’air d’être un Rameau de Vie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3324,
      "rawDecodedUtf16Hex": "004300650074007400650020006200720061006E00630068006500200065007300740020006200720069007300E90065002E002E002E000A00430065006C00610020006E2019006100200070006100730020006C201900610069007200200064201900EA00740072006500200075006E002000520061006D0065006100750020006400650020005600690065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Cette branche est toute rigide...\nCela n’a pas l’air d’être un Rameau de Vie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
