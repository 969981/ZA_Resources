      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "004E00650063002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Quel soulagement ! Il semble avoir retrouvé\nla santé !<U+0010><U+0002>Ĕƈ",
