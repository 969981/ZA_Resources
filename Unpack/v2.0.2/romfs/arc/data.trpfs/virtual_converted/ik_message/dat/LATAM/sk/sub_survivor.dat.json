      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Completaste el reto en <U+0010><U+0002>ȁ<U+0002>:<U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>.<U+0010><U+0002>Ĕ<U+000F>",
