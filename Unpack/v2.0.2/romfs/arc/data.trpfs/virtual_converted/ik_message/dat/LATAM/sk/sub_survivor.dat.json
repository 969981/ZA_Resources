      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 916,
      "rawDecodedUtf16Hex": "00A1004600750065007200610021001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Tu récord actual es de <U+0010><U+0002>ȁ<U+0002>:<U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>.\n¿Crees que podrás superarlo?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 940,
      "rawDecodedUtf16Hex": "005400750020007200E90063006F00720064002000610063007400750061006C00200065007300200064006500200010000202010002003A0010000202010003003A0010000202010004002E000A00BF00430072006500650073002000710075006500200070006F0064007200E1007300200073007500700065007200610072006C006F003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¡Duraste <U+0010><U+0003>ȃ<U+0005>, segundos!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 8,
