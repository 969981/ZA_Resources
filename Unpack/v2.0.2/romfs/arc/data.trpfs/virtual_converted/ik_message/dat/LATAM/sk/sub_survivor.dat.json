      "offsetInSection": 2272,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh, presionaste <U+0010><U+0002>봊<U+0004>Sp_1. ¿Acaso quieres rendirte?<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "004F0068002C002000700072006500730069006F006E0061007300740065002000100002BD0A000400530070005F0031002E002000BF0041006300610073006F00200071007500690065007200650073002000720065006E00640069007200740065003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Oh, ¿qué pasa? ¿Quieres rendirte?<U+0010><U+0002>Ĕ<U+000F>",
