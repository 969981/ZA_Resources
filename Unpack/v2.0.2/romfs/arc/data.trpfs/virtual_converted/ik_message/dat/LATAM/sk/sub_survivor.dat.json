      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Guau, no duraste ni 30 segundos.<U+0010><U+0001>븁\nLo siento, pero no pudiste superar el reto.\n¡Inténtalo de nuevo cuando quieras!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
