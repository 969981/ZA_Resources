      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Ok, eres demasiado pro. No tiene sentido seguir\ncontando...<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "004F006B002C00200065007200650073002000640065006D00610073006900610064006F002000700072006F002E0020004E006F0020007400690065006E0065002000730065006E007400690064006F0020007300650067007500690072000A0063006F006E00740061006E0064006F002E002E002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "¡Te quedan <U+0010><U+0002>＀<U+0006>30 segundos<U+0010><U+0002>＀<U+0000>!<U+0010><U+0002>Ĕ<U+000F>",
