      "rawDecodedUtf16Hex": "0043006F006D0070006C00650074006100730074006500200065006C0020007200650074006F00200065006E00200010000202010002003A0010000202010003003A0010000202010004002E001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "¡Batiste tu mejor récord! ¡No hay quien pueda\ndetenerte, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
