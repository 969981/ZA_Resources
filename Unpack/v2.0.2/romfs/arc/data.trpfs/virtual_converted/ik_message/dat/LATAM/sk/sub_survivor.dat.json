      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "¡Vuelve cuando quieras y ponte a prueba con\n\"Esquiva como puedas\"!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
