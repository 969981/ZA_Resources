      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "¡Te quedan <U+0010><U+0002>＀<U+0006>10 segundos<U+0010><U+0002>＀<U+0000>!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 9,
