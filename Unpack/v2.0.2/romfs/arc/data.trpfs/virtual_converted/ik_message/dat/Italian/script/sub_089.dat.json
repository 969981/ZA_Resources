      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Quell’arancione suggerisce atmosfere autunnali,\nnon trovi? Voglio creare una tinta di quel colore!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
