      "index": 41,
      "offsetInSection": 5152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 111
    },
    {
      "displayText": "Guardando questo tripudio di colori, mi viene\nvoglia di sperimentare tinte insolite!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Sai cosa ti dico? Voglio osare! Creerò subito tinte\ndi colori unici!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5556,
      "rawDecodedUtf16Hex": "00530061006900200063006F007300610020007400690020006400690063006F003F00200056006F0067006C0069006F0020006F0073006100720065002100200043007200650065007200F2002000730075006200690074006F002000740069006E00740065000A0064006900200063006F006C006F0072006900200075006E006900630069002100100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Ai colori per capelli del Salone Acconciature ora si\nsono aggiunti azzurro, viola e rosa pompelmo!",
