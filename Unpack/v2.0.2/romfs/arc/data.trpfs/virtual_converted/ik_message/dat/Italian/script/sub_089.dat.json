      "rawDecodedUtf16Hex": "00100002BDFF001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "È proprio un Flabébé Fiore Arancione!\nGrazie mille!<U+0010><U+0002>ĔŴ",
