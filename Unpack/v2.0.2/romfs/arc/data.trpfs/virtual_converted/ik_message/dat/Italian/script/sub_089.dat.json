      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oh! Cinque Flabébé di colori diversi! Ci sono tutti:\nil rosso, il giallo, l’arancione, il blu e il bianco!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
