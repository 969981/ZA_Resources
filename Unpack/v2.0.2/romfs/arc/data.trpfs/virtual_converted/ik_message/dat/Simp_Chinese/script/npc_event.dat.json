      "offsetInSection": 6172,
      "rawDecodedUtf16Hex": "00100002BDFF00630000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "今晚也要大赚一笔！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 100,
      "offsetInSection": 6184,
      "rawDecodedUtf16Hex": "4ECA665A4E5F898159278D5A4E007B14FF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "对战特区这地方\n太适合赚零花钱啦！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 101,
      "offsetInSection": 6232,
