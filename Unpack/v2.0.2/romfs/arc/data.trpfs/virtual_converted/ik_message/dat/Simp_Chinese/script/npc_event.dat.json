      "rawDecodedUtf16Hex": "00100002BDFF00670000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "为宝可梦恢复活力！<U+0010><U+0002>봊\nText_icon1",
