      "rawDecodedUtf16Hex": "00100002BDFF005F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "精灵球馆～！<U+0010><U+0002>봊\nText_icon1",
