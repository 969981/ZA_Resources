      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Je détecte plus le gros Pokémon, j’imagine\nque tu l’as délogé... mais, c’est quoi ça ?!<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Un Oyacata... Quel Pokémon gigantesque !<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "0055006E0020004F007900610063006100740061002E002E002E0020005100750065006C00200050006F006B00E9006D006F006E00200067006900670061006E0074006500730071007500650020002100100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "... Cata.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1968,
      "rawDecodedUtf16Hex": "002E002E002E00200043006100740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Tu t’excuses ? Mais y faut pas, voyons ! Tu voulais\njuste explorer, c’est tout ! Je comprends, tu sais.<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 108
    },
    {
      "displayText": "Ça te dirait de devenir mon partenaire ?<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2204,
      "rawDecodedUtf16Hex": "00C70061002000740065002000640069007200610069007400200064006500200064006500760065006E006900720020006D006F006E002000700061007200740065006E00610069007200650020003F00100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Y a plein de Pokémon qui vivent dans les égouts.\nJe serais en sécurité, si tu étais avec moi !<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2296,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Yaca !!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "005900610063006100200021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "C’est décidé, alors !<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2516,
      "rawDecodedUtf16Hex": "004320190065007300740020006400E900630069006400E9002C00200061006C006F007200730020002100100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Quant à toi, merci d’avoir aidé Oyacata !<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2568,
      "rawDecodedUtf16Hex": "005100750061006E0074002000E000200074006F0069002C0020006D006500720063006900200064201900610076006F00690072002000610069006400E90020004F0079006100630061007400610020002100100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Allez, Oyacata ! C’est l’heure d’aller bosser !<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "0041006C006C0065007A002C0020004F007900610063006100740061002000210020004320190065007300740020006C2019006800650075007200650020006420190061006C006C0065007200200062006F00730073006500720020002100100002011401C50000",
