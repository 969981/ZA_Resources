  "messages": [
    {
      "displayText": "Ah ! Quelle chance de tomber sur quelqu’un\nde balèze par ici !<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "00410068002000210020005100750065006C006C00650020006300680061006E0063006500200064006500200074006F006D00620065007200200073007500720020007100750065006C0071007520190075006E000A00640065002000620061006C00E8007A0065002000700061007200200069006300690020002100100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "... Enfin, vu ce qui se passe en ce moment,\non peut pas vraiment dire que j’ai de la chance...<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Je m’explique : un des tuyaux du système d’égout\nest bouché. Un gros Pokémon le bloque.<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Il doit être énorme et donc certainement\ntrès fort... Et c’est là que tu entres en scène.<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Je vais indiquer sur ta carte les endroits où\nle Pokémon est susceptible de se trouver...<U+0010><U+0001>븀\nSers-toi de ton Motismart et va enquêter.<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
      "displayText": "J’ai marqué sur ta carte les endroits à examiner.\nSers-toi de ton Motismart !<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un Oyacata est bloqué dans le tuyau.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1376,
      "rawDecodedUtf16Hex": "0055006E0020004F007900610063006100740061002000650073007400200062006C006F0071007500E9002000640061006E00730020006C0065002000740075007900610075002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Vous pourriez peut-être le libérer en utilisant\nla capacité d’un Pokémon !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1452,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
