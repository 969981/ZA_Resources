      "flagsUpper16": 4,
      "index": 73,
      "offsetInSection": 8576,
      "rawDecodedUtf16Hex": "00550068003F0020004D00610074006900E800720065003F00100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Mi sono data da fare nella Luminopoli\ndimensionale al posto tuo!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 8612,
      "rawDecodedUtf16Hex": "004D006900200073006F006E006F00200064006100740061002000640061002000660061007200650020006E0065006C006C00610020004C0075006D0069006E006F0070006F006C0069000A00640069006D0065006E00730069006F006E0061006C006500200061006C00200070006F00730074006F002000740075006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
