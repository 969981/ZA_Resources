      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 6824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 172
    },
    {
      "displayText": "<U+0010><U+0002>뷿:",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7168,
      "rawDecodedUtf16Hex": "00100002BDFF003A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Groooowl!",
      "escapedControlUnits": 0,
