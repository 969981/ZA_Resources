      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "La SCL es generosa incluso en la otra dimensión.\nToma <U+0010><U+0003>ᜂ<U+0002><U+0000><U+0010><U+0002>Ċ<U+0002>.",
