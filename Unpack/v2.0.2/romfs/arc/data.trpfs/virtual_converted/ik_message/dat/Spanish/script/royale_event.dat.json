      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 960,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "¿Le apetece\nbeber algo?<U+0010><U+0002>봊\nText_icon1",
