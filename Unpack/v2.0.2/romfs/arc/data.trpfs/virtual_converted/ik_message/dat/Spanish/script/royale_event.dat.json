      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>¡Toma <U+0010><U+0003>ᜂ<U+0002><U+0000><U+0010><U+0002>Ċ<U+0002>,\nyo ya tengo un montón!",
