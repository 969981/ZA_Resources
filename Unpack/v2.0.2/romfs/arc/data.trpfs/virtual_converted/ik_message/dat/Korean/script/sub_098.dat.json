      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "덩굴이 더 늘어났잖아!\n어떻게 된 거지!?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
