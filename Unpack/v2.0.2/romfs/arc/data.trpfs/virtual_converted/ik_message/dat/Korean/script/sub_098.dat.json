      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "이제 스케치를 재개할 수 있겠어요.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1020,
