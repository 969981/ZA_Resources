      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "덩굴이 늘어났으니\n추가로 부탁드릴게요!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
