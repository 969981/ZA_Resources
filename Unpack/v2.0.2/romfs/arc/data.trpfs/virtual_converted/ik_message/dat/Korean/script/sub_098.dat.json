    },
    {
      "displayText": "당신!\n혹시 제 고민을 해결해 주실 수 있을까요?<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 352,
