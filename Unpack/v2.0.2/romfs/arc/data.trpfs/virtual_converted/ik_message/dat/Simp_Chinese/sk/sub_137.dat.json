      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "是<U+0010><U+0002>ā<U+0008>啊！不错！\n我脑海中有画面了！<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
