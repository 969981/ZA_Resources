      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "持有超级石的<U+0010><U+0002>Ă<U+0004>出现在\n<U+0010><U+0002>Ă<U+0002>和<U+0010><U+0002>Ā<U+0000>的面前……<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 11,
