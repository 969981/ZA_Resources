      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "我说……也请给我看看\n其他姿势的米立龙吧。<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
