      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "认真的吗？<U+0010><U+0002>Ĕǟ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2428,
      "rawDecodedUtf16Hex": "8BA4771F76845417FF1F00100002011401DF0000",
      "trailingZeroPaddingUnits": 1,
