      "rawDecodedUtf16Hex": "8FD8662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "不给我看我指定的米立龙，\n我不喜欢这样。<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
