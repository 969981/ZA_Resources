      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "62118BF4202620264E5F8BF77ED96211770B770B000A51764ED659FF52BF76847C737ACB9F995427300200100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
