      "rawDecodedUtf16Hex": "4F6089C95F97600E4E486837FF1F00100001BE01000A867D71364E00770B5C3177E59053662F5916884C505A7684FF0C000A4F468FD8662F4F1A8BA94EBA5728610FFF0C62404EE560F370B970B9770B300200100002011401DE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "也就是说，一道既能有些销量，\n又不会让我太忙的餐点完成了。<U+0010><U+0002>ĔǞ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2360,
