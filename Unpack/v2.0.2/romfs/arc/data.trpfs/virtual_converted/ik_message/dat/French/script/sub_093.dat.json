      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3332,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "Moi aussi, je vais faire de mon mieux\npour devenir plus forte avec Brutalibré !<U+0010><U+0002>ĔŶ",
