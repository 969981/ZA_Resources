      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "J’ai bien l’impression qu’il a envie de se battre.<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1212,
