      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Il a le regard perdu au loin, comme s’il se rappelait\nquelque chose...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 952,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
