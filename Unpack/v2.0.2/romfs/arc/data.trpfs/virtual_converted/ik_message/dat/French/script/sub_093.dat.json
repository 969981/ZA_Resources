      "rawDecodedUtf16Hex": "00C70061002C00200063201900E9007400610069007400200075006E006500200072006500760061006E006300680065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "J’ignorais que les combats Pokémon\npouvaient être si grandioses !<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "004A201900690067006E006F007200610069007300200071007500650020006C0065007300200063006F006D006200610074007300200050006F006B00E9006D006F006E000A0070006F00750076006100690065006E0074002000EA0074007200650020007300690020006700720061006E00640069006F0073006500730020002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Il n’est pas question d’écraser l’adversaire,\nmais plutôt de se mesurer à lui...<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
