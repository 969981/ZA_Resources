      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 7792,
      "rawDecodedUtf16Hex": "00BF00500072006500730065006E007400610072002000610020006E00750065007300740072006F007300200050006F006B00E9006D006F006E003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "¡De acuerdo!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 7864,
      "rawDecodedUtf16Hex": "00A1004400650020006100630075006500720064006F002100100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Tanta desconfianza es muy estresante.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 7900,
      "rawDecodedUtf16Hex": "00540061006E0074006100200064006500730063006F006E006600690061006E007A00610020006500730020006D0075007900200065007300740072006500730061006E00740065002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Así también demostraré que mi Tinkatuff no\ntiene ninguna intención de atacar a Scizor.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 66,
      "offsetInSection": 7984,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "¿Tú qué dices? ¿Te parece bien?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 8168,
