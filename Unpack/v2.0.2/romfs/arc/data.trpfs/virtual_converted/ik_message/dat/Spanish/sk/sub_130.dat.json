      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 8664,
      "rawDecodedUtf16Hex": "00BF00540069006E006B006100740075006600660020007400690065006E00650020007600650072006700FC0065006E007A0061003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "¿Scizor tiene miedo?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 8728,
      "rawDecodedUtf16Hex": "00BF005300630069007A006F00720020007400690065006E00650020006D006900650064006F003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "♪¡Tuff!♪",
