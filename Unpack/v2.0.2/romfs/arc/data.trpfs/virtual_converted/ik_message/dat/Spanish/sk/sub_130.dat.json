      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "¡Tinkaaa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 8240,
      "rawDecodedUtf16Hex": "00A100540069006E006B00610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿E",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 8260,
      "rawDecodedUtf16Hex": "00100002BDFF00450000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Muy bien, ahora dejaremos que nuestros\nPokémon se conozcan.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 8272,
      "rawDecodedUtf16Hex": "004D007500790020006200690065006E002C002000610068006F00720061002000640065006A006100720065006D006F007300200071007500650020006E00750065007300740072006F0073000A0050006F006B00E9006D006F006E00200073006500200063006F006E006F007A00630061006E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Y, si pasa cualquier cosa, hacemos que vuelvan\na su Poké Ball inmediatamente.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 8400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "¡Acércate, Scizor!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 8564,
      "rawDecodedUtf16Hex": "00A10041006300E900720063006100740065002C0020005300630069007A006F0072002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Ven aquí, Tinkatuff!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 8612,
      "rawDecodedUtf16Hex": "00A100560065006E002000610071007500ED002C002000540069006E006B00610074007500660066002100100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¿Tinkatuff tiene vergüenza?<U+0010><U+0002>ĔƬ",
