      "rawDecodedUtf16Hex": "00530063006900690069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Tinkatuff no hace ademán de atacar...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 8820,
      "rawDecodedUtf16Hex": "00540069006E006B006100740075006600660020006E006F002000680061006300650020006100640065006D00E1006E0020006400650020006100740061006300610072002E002E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Scizor tampoco parece tenerle manía...\nPor lo visto, era todo un malentendido.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 8904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
