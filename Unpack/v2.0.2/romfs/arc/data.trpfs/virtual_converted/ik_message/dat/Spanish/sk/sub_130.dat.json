      "rawDecodedUtf16Hex": "266A00A100540075006600660021266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Sciii...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 77,
