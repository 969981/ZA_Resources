  "messages": [
    {
      "displayText": "¿Te da miedo cuando alguien te mira fijamente?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 756,
