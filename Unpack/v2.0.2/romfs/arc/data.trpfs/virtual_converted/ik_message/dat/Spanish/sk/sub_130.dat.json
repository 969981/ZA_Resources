      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Bastante",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 860,
      "rawDecodedUtf16Hex": "00420061007300740061006E007400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¿Quieres algo?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200061006C0067006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Pues mira, me gustaría pedirte ayuda con\nun asunto.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "00500075006500730020006D006900720061002C0020006D0065002000670075007300740061007200ED00610020007000650064006900720074006500200061007900750064006100200063006F006E000A0075006E0020006100730075006E0074006F002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Tengo una vecina que se ha mudado hace poco\ndesde Paldea.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "00540065006E0067006F00200075006E006100200076006500630069006E006100200071007500650020007300650020006800610020006D0075006400610064006F0020006800610063006500200070006F0063006F000A00640065007300640065002000500061006C006400650061002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Y su Pokémon...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "005900200073007500200050006F006B00E9006D006F006E002E002E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "¡Siempre está mirando fijamente a mi Scizor!\n¡No le quita ojo de encima!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "El pobre es un poquito miedoso y ahora, por su\nculpa, vive atemorizado y no quiere salir de casa.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "¿Podrías preguntar a mi vecina por qué su\nTinkatuff tiene que mirar así a mi Scizor?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Sciii...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1728,
      "rawDecodedUtf16Hex": "00530063006900690069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Creo que la vecina debe de andar por la azotea.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "004300720065006F00200071007500650020006C006100200076006500630069006E00610020006400650062006500200064006500200061006E00640061007200200070006F00720020006C006100200061007A006F007400650061002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1852,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Sí? ¿Quieres hablar conmigo de algo?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "00BF005300ED003F002000BF00510075006900650072006500730020006800610062006C0061007200200063006F006E006D00690067006F00200064006500200061006C0067006F003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Sí, de tu Tinkatuff",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "005300ED002C002000640065002000740075002000540069006E006B006100740075006600660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Sí, de cierto Scizor",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "005300ED002C002000640065002000630069006500720074006F0020005300630069007A006F00720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Ya... Supongo que es por lo del Pokémon de mi\nvecino.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "00590061002E002E002E0020005300750070006F006E0067006F002000710075006500200065007300200070006F00720020006C006F002000640065006C00200050006F006B00E9006D006F006E0020006400650020006D0069000A0076006500630069006E006F002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Reconozco que mi Tinkatuff no le pierde ojo\na su Scizor.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2148,
      "rawDecodedUtf16Hex": "005200650063006F006E006F007A0063006F00200071007500650020006D0069002000540069006E006B006100740075006600660020006E006F0020006C006500200070006900650072006400650020006F006A006F000A00610020007300750020005300630069007A006F0072002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Pero es porque ese Scizor tiene una mirada y\nuna cara de enfadado que da miedo. Por eso<U+0010><U+0001>븀\nquiere tenerlo siempre vigilado, nada más.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Que nunca le ha hecho nada, pero igualmente da\nyuyu que te miren fijamente con esa cara.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Si no es molestia, ¿te importaría explicarle a mi\nvecino lo que te acabo de contar?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Tinkaaa...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2912,
      "rawDecodedUtf16Hex": "00540069006E006B006100610061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2936,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Has averiguado por qué nos mira tanto\nel Pokémon de la vecina?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2948,
      "rawDecodedUtf16Hex": "00BF0048006100730020006100760065007200690067007500610064006F00200070006F007200200071007500E90020006E006F00730020006D006900720061002000740061006E0074006F000A0065006C00200050006F006B00E9006D006F006E0020006400650020006C006100200076006500630069006E0061003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Porque Scizor tiene cara de enfadado",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "0050006F00720071007500650020005300630069007A006F00720020007400690065006E00650020006300610072006100200064006500200065006E00660061006400610064006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Porque Scizor le da miedo",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3160,
      "rawDecodedUtf16Hex": "0050006F00720071007500650020005300630069007A006F00720020006C00650020006400610020006D006900650064006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¿Eh? ¿Que tiene cara de enfadado?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3212,
      "rawDecodedUtf16Hex": "00BF00450068003F002000BF0051007500650020007400690065006E00650020006300610072006100200064006500200065006E00660061006400610064006F003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¿Eh? ¿Que le da miedo?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3288,
      "rawDecodedUtf16Hex": "00BF00450068003F002000BF0051007500650020006C00650020006400610020006D006900650064006F003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Pero es que él tiene la cara así. No es que esté\nenfadado.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3344,
      "rawDecodedUtf16Hex": "005000650072006F0020006500730020007100750065002000E9006C0020007400690065006E00650020006C00610020006300610072006100200061007300ED002E0020004E006F0020006500730020007100750065002000650073007400E9000A0065006E00660061006400610064006F002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "¡Pues más miedo da que te estén mirando todo\nel rato!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3472,
      "rawDecodedUtf16Hex": "00A100500075006500730020006D00E100730020006D006900650064006F0020006400610020007100750065002000740065002000650073007400E9006E0020006D006900720061006E0064006F00200074006F0064006F000A0065006C0020007200610074006F002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Lo que tengo claro es que no pienso dejar que\nalgo así nos amargue la vida, que aquí estábamos<U+0010><U+0001>븀\nmuy tranquilos.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "He oído que, a veces, los Tinkatuff atacan a otros\nPokémon en su afán de conseguir metales.<U+0010><U+0001>븁\nY mi Scizor es de tipo Acero. A ver si va a ser\nque...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 154
    },
    {
      "displayText": "¡Sciiii!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4132,
      "rawDecodedUtf16Hex": "00A100530063006900690069006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡Tranquilo, Scizor! Si llega el caso, yo te\nprotegeré.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4152,
      "rawDecodedUtf16Hex": "00A1005400720061006E007100750069006C006F002C0020005300630069007A006F007200210020005300690020006C006C00650067006100200065006C0020006300610073006F002C00200079006F002000740065000A00700072006F0074006500670065007200E9002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Hasta que no estemos seguros de que la Tinkatuff\nde la vecina no es un peligro para Scizor, este no<U+0010><U+0001>븀\nse quedará tranquilo.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "¿Puedes hablar con ella y asegurarte?<U+0010><U+0001>븁\nCon tacto, que menudo recibimiento para alguien\nque se acaba de mudar.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Sciii...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4764,
      "rawDecodedUtf16Hex": "00530063006900690069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>뷿$",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4784,
      "rawDecodedUtf16Hex": "00100002BDFF00240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Qué se cuenta mi querido vecino?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4796,
      "rawDecodedUtf16Hex": "00BF0051007500E90020007300650020006300750065006E007400610020006D00690020007100750065007200690064006F00200076006500630069006E006F003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Que les da miedo que los miren tanto",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4872,
      "rawDecodedUtf16Hex": "0051007500650020006C006500730020006400610020006D006900650064006F00200071007500650020006C006F00730020006D006900720065006E002000740061006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Que les da miedo Tinkatuff",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4948,
      "rawDecodedUtf16Hex": "0051007500650020006C006500730020006400610020006D006900650064006F002000540069006E006B006100740075006600660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "¿Eso ha dicho? Qué cosas tiene...<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5004,
      "rawDecodedUtf16Hex": "00BF00450073006F00200068006100200064006900630068006F003F00200051007500E900200063006F0073006100730020007400690065006E0065002E002E002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¡Pero si es un cacho de pan!<U+0010><U+0001>븁\n¡Me parece muy mal por su parte que juzgue así\na mi Pokémon, sin conocerlo siquiera!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Y que sepa que mi Tinkatuff nunca ha hecho\ndaño a nadie ni ha atacado a ningún Pokémon<U+0010><U+0001>븀\npara conseguir metal.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Bueno, casi nunca.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5556,
      "rawDecodedUtf16Hex": "004200750065006E006F002C002000630061007300690020006E0075006E00630061002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "¡Tinkaaa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5604,
      "rawDecodedUtf16Hex": "00A100540069006E006B00610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Menudo follón. Como si no tuviera yo bastante\ncon todo el lío de la mudanza, y ahora encima<U+0010><U+0001>븀\nme entero de que le damos miedo al vecino.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Primero, que me demuestre que su Scizor no le\ntiene manía a mi peque y luego hablamos.<U+0010><U+0001>븀\n¿Podrías...?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5908,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "¿Tuff?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 6124,
      "rawDecodedUtf16Hex": "00BF0054007500660066003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0002>뷿0",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 6140,
      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Qué quiere la vecina?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6152,
      "rawDecodedUtf16Hex": "00BF0051007500E900200071007500690065007200650020006C006100200076006500630069006E0061003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Ver que Scizor no le tiene manía a Tinkatuff",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6208,
      "rawDecodedUtf16Hex": "00560065007200200071007500650020005300630069007A006F00720020006E006F0020006C00650020007400690065006E00650020006D0061006E00ED006100200061002000540069006E006B006100740075006600660000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Que sepas que Tinkatuff no os atacará",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6300,
      "rawDecodedUtf16Hex": "0051007500650020007300650070006100730020007100750065002000540069006E006B006100740075006600660020006E006F0020006F0073002000610074006100630061007200E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¡Cómo va a tenerle manía mi Scizor! ¡Con lo\nmiedoso que es el pobre! ¡Es incapaz!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "¡Me parece muy bonito, pero las palabras se las\nlleva el viento!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 6548,
      "rawDecodedUtf16Hex": "00A1004D006500200070006100720065006300650020006D0075007900200062006F006E00690074006F002C0020007000650072006F0020006C00610073002000700061006C006100620072006100730020007300650020006C00610073000A006C006C00650076006100200065006C0020007600690065006E0074006F002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Entiendo que las mudanzas estresan, que acaba\nde llegar y que cuesta adaptarse a un sitio nuevo.<U+0010><U+0001>븁\nPero nosotros estábamos aquí tan tranquilos y\nmira lo que nos encontramos de repente. Hmm...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 54,
      "offsetInSection": 6688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 197
    },
    {
      "displayText": "¡Muy bien! Le daré la prueba que quiere de que\nno tenemos nada en su contra.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 7084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "¿Y cómo piensas hacerlo?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 7248,
      "rawDecodedUtf16Hex": "00BF00590020006300F3006D006F0020007000690065006E007300610073002000680061006300650072006C006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "¿Eso es posible?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 7300,
      "rawDecodedUtf16Hex": "00BF00450073006F00200065007300200070006F007300690062006C0065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Es sencillo: ¡presentaremos a nuestros Pokémon\npara que se conozcan!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 7336,
      "rawDecodedUtf16Hex": "00450073002000730065006E00630069006C006C006F003A002000A100700072006500730065006E0074006100720065006D006F0073002000610020006E00750065007300740072006F007300200050006F006B00E9006D006F006E000A0070006100720061002000710075006500200073006500200063006F006E006F007A00630061006E002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Tener a sus Entrenadores de cuerpo presente les\ndará tranquilidad.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7484,
      "rawDecodedUtf16Hex": "00540065006E0065007200200061002000730075007300200045006E007400720065006E00610064006F007200650073002000640065002000630075006500720070006F002000700072006500730065006E007400650020006C00650073000A00640061007200E10020007400720061006E007100750069006C0069006400610064002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Así que, si ella no tiene inconveniente, me avisas\ny probamos.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 60,
      "offsetInSection": 7628,
      "rawDecodedUtf16Hex": "0041007300ED0020007100750065002C00200073006900200065006C006C00610020006E006F0020007400690065006E006500200069006E0063006F006E00760065006E00690065006E00740065002C0020006D00650020006100760069007300610073000A0079002000700072006F00620061006D006F0073002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡Sciii!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 7764,
      "rawDecodedUtf16Hex": "00A10053006300690069006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿>",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 7780,
      "rawDecodedUtf16Hex": "00100002BDFF003E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Presentar a nuestros Pokémon?<U+0010><U+0002>Ĕƭ",
