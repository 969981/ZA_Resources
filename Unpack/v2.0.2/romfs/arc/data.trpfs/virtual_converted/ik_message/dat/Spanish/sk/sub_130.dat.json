      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 9072,
      "rawDecodedUtf16Hex": "00A100530063006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "¡Tin!",
