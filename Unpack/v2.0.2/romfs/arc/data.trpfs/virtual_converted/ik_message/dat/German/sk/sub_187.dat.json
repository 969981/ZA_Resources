      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4092,
      "rawDecodedUtf16Hex": "004200690074007400650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Keine Ahnung.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 4108,
      "rawDecodedUtf16Hex": "004B00650069006E0065002000410068006E0075006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
