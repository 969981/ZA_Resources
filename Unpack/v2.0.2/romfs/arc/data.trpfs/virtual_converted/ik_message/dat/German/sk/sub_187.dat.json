      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3056,
      "rawDecodedUtf16Hex": "005A0069006E006B00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Carbon!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3068,
      "rawDecodedUtf16Hex": "0043006100720062006F006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Nein, keine Ahnung.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3084,
      "rawDecodedUtf16Hex": "004E00650069006E002C0020006B00650069006E0065002000410068006E0075006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Okay, verstanden. Es gibt tatsächlich viele\nverschiedene Getränke in dieser Reihe!<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Noch mal zurück zu Protein. Warum gibst du es\ndeinen Pokémon?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3300,
      "rawDecodedUtf16Hex": "004E006F006300680020006D0061006C0020007A0075007200FC0063006B0020007A0075002000500072006F007400650069006E002E00200057006100720075006D002000670069006200730074002000640075002000650073000A006400650069006E0065006E00200050006F006B00E9006D006F006E003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Um den Angriff zu erhöhen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "0055006D002000640065006E00200041006E006700720069006600660020007A0075002000650072006800F600680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
