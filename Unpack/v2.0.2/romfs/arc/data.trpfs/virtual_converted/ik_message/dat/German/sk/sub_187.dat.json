      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3036,
      "rawDecodedUtf16Hex": "004B0061006C007A00690075006D00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
