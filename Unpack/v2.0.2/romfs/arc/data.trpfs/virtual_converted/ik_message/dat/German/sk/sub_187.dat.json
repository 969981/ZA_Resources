      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4080,
      "rawDecodedUtf16Hex": "005300FC00DF003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
