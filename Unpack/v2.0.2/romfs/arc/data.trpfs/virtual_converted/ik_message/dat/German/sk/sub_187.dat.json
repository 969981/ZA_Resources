  "messages": [
    {
      "displayText": "Tragosso! ♪",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "0054007200610067006F00730073006F00210020266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Tragosso schenkt dir ein Fläschchen Protein!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 540,
      "rawDecodedUtf16Hex": "0054007200610067006F00730073006F00200073006300680065006E006B00740020006400690072002000650069006E00200046006C00E4007300630068006300680065006E002000500072006F007400650069006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Herzlichen Glückwunsch!<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "004800650072007A006C0069006300680065006E00200047006C00FC0063006B00770075006E007300630068002100100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Wir veranstalten gerade eine Promo-Kampagne\nund verteilen Protein an Trainer.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Hättest du vielleicht ein klein wenig Zeit?\nDauert auch wirklich nicht lange.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Na gut...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "004E00610020006700750074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Sorry, ich hab keine Zeit.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "0053006F007200720079002C002000690063006800200068006100620020006B00650069006E00650020005A006500690074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Es dauert auch nur einen kleinen Augenblick,\nversprochen!<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1092,
      "rawDecodedUtf16Hex": "004500730020006400610075006500720074002000610075006300680020006E00750072002000650069006E0065006E0020006B006C00650069006E0065006E00200041007500670065006E0062006C00690063006B002C000A007600650072007300700072006F006300680065006E002100100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Oh, besten Dank!<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "004F0068002C002000620065007300740065006E002000440061006E006B002100100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Also: Ich führe momentan eine Umfrage zum\nThema Protein durch. Bitte beantworte mir ein<U+0010><U+0001>븀\npaar Fragen, ja?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Weißt du, was Protein ist?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1484,
      "rawDecodedUtf16Hex": "00570065006900DF0074002000640075002C0020007700610073002000500072006F007400650069006E0020006900730074003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Ja, ich weiß alles darüber!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "004A0061002C0020006900630068002000770065006900DF00200061006C006C00650073002000640061007200FC00620065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Ich hab schon mal davon gehört.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1604,
      "rawDecodedUtf16Hex": "00490063006800200068006100620020007300630068006F006E0020006D0061006C0020006400610076006F006E002000670065006800F600720074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Nein, keine Ahnung.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "004E00650069006E002C0020006B00650069006E0065002000410068006E0075006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Okay, alles klar. Nun, Protein ist ein Getränk\nfür Pokémon.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "004F006B00610079002C00200061006C006C006500730020006B006C00610072002E0020004E0075006E002C002000500072006F007400650069006E0020006900730074002000650069006E0020004700650074007200E4006E006B000A006600FC007200200050006F006B00E9006D006F006E002E00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Wo hast du zum ersten Mal von Protein gehört?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "0057006F002000680061007300740020006400750020007A0075006D002000650072007300740065006E0020004D0061006C00200076006F006E002000500072006F007400650069006E002000670065006800F600720074003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Ich hab online was dazu gesehen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "00490063006800200068006100620020006F006E006C0069006E00650020007700610073002000640061007A00750020006700650073006500680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Freunde haben darüber gesprochen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "0046007200650075006E0064006500200068006100620065006E002000640061007200FC006200650072002000670065007300700072006F006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Es stand was auf einem Poster.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2072,
      "rawDecodedUtf16Hex": "004500730020007300740061006E006400200077006100730020006100750066002000650069006E0065006D00200050006F0073007400650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Es wurde im Pokémon-Center erwähnt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2136,
      "rawDecodedUtf16Hex": "0045007300200077007500720064006500200069006D00200050006F006B00E9006D006F006E002D00430065006E007400650072002000650072007700E40068006E0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Hier gerade, zum ersten Mal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "00480069006500720020006700650072006100640065002C0020007A0075006D002000650072007300740065006E0020004D0061006C002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Ah, interessant! Man kommt ja über alle\nmöglichen Kanäle an Infos heutzutage.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Findest du 5000 <U+E300> einen hohen Preis für\nein Fläschchen Protein?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2432,
      "rawDecodedUtf16Hex": "00460069006E0064006500730074002000640075002000350030003000300020E300002000650069006E0065006E00200068006F00680065006E0020005000720065006900730020006600FC0072000A00650069006E00200046006C00E4007300630068006300680065006E002000500072006F007400650069006E003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Ja, das ist teuer.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2568,
      "rawDecodedUtf16Hex": "004A0061002C00200064006100730020006900730074002000740065007500650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Geht so.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2608,
      "rawDecodedUtf16Hex": "004700650068007400200073006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Nein, das ist günstig.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2628,
      "rawDecodedUtf16Hex": "004E00650069006E002C002000640061007300200069007300740020006700FC006E0073007400690067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Alles klar. Ich merke schon, das Preisempfinden\nist wirklich je nach Person unterschiedlich.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Kennst du auch andere Produkte aus der Reihe,\nzu der Protein gehört?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "004B0065006E006E007300740020006400750020006100750063006800200061006E0064006500720065002000500072006F00640075006B0074006500200061007500730020006400650072002000520065006900680065002C000A007A00750020006400650072002000500072006F007400650069006E002000670065006800F600720074003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Eisen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3020,
      "rawDecodedUtf16Hex": "0045006900730065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
