      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 4496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Das war auch schon alles. Vielen Dank, dass du\nan der Umfrage teilgenommen hast!<U+0010><U+0002>Ĕǡ",
