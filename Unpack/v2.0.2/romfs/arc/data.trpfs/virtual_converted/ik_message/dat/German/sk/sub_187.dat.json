      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 4472,
      "rawDecodedUtf16Hex": "00570065006900DF0020006E0069006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
