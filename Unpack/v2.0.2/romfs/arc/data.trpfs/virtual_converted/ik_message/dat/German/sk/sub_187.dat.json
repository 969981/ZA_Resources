      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3488,
      "rawDecodedUtf16Hex": "0055006D002000640069006500200056006500720074006500690064006900670075006E00670020007A0075002000650072006800F600680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Um den Spezial-Angriff zu erhöhen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 3552,
      "rawDecodedUtf16Hex": "0055006D002000640065006E0020005300700065007A00690061006C002D0041006E006700720069006600660020007A0075002000650072006800F600680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Um die Spezial-Verteidigung zu erhöhen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 3624,
      "rawDecodedUtf16Hex": "0055006D00200064006900650020005300700065007A00690061006C002D0056006500720074006500690064006900670075006E00670020007A0075002000650072006800F600680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Um die Initiative zu erhöhen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 3704,
      "rawDecodedUtf16Hex": "0055006D002000640069006500200049006E006900740069006100740069007600650020007A0075002000650072006800F600680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Aha, okay! Wenn du dir mal nicht sicher bist,\nkannst du dir jederzeit die Infos dazu durchlesen.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 3764,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Was denkst du, wie Protein schmeckt?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 3968,
      "rawDecodedUtf16Hex": "005700610073002000640065006E006B00730074002000640075002C0020007700690065002000500072006F007400650069006E0020007300630068006D00650063006B0074003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Öh... Lecker?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4052,
      "rawDecodedUtf16Hex": "00D60068002E002E002E0020004C00650063006B00650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
