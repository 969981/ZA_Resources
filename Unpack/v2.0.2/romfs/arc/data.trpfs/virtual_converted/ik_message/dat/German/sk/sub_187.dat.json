      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 4136,
      "rawDecodedUtf16Hex": "0049006E0074006500720065007300730061006E007400210020004100630068002C002000770065006E006E0020006D0061006E002000640069006500200050006F006B00E9006D006F006E00200064006F00630068000A006E00750072002000660072006100670065006E0020006B00F6006E006E00740065002E00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Würdest du Protein auch anderen Trainern\nweiterempfehlen?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "005700FC00720064006500730074002000640075002000500072006F007400650069006E0020006100750063006800200061006E0064006500720065006E00200054007200610069006E00650072006E000A0077006500690074006500720065006D0070006600650068006C0065006E003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Oh, absolut!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 4396,
      "rawDecodedUtf16Hex": "004F0068002C0020006100620073006F006C0075007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Ja, schon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4424,
      "rawDecodedUtf16Hex": "004A0061002C0020007300630068006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Eher nicht.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4448,
      "rawDecodedUtf16Hex": "00450068006500720020006E0069006300680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
