      "offsetInSection": 5148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "¡Qué preguntas más raras hacen!\nAhora me toca a mí.<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 5304,
      "rawDecodedUtf16Hex": "00A10051007500E9002000700072006500670075006E0074006100730020006D00E1007300200072006100720061007300200068006100630065006E0021000A00410068006F007200610020006D006500200074006F00630061002000610020006D00ED002E001000020114019C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Oye, megaevoluciooo... nadorista, ¿cuál\nmegaevolución te parece que es la más fuerte?<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 51,
      "offsetInSection": 5416,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Mega-Emboar",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
