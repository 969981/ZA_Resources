      "rawDecodedUtf16Hex": "004D006500670061002D0045006D0062006F006100720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Mega-Meganium",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 5620,
      "rawDecodedUtf16Hex": "004D006500670061002D004D006500670061006E00690075006D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Mega-Feraligatr",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5648,
      "rawDecodedUtf16Hex": "004D006500670061002D0046006500720061006C006900670061007400720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Ah, sí, cada uno tiene sus puntos fuertes y\ndébiles, ¿no?<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 55,
      "offsetInSection": 5680,
      "rawDecodedUtf16Hex": "00410068002C0020007300ED002C0020006300610064006100200075006E006F0020007400690065006E00650020007300750073002000700075006E0074006F00730020006600750065007200740065007300200079000A006400E900620069006C00650073002C002000BF006E006F003F001000020114019C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "¡Como ya preguntamos todos, ya se acabó\nla clase! ¡Vamos al recreo!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 56,
