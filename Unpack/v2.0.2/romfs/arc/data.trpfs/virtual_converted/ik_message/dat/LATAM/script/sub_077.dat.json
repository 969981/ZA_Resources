      "index": 66,
      "offsetInSection": 6944,
      "rawDecodedUtf16Hex": "004500730074006F0020006500730020006D00E10073002000640069007600650072007400690064006F00200071007500650020006C0061007300200063006C00610073006500730020006400650020006C0061002000650073006300750065006C0061002E001000020114019B0000",
