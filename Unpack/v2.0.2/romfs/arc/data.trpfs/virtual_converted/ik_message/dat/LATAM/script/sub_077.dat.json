      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¡Megaprofe, sabes muchísimo\nsobre la megaevolución!<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5948,
      "rawDecodedUtf16Hex": "00A1004D00650067006100700072006F00660065002C0020007300610062006500730020006D00750063006800ED00730069006D006F000A0073006F0062007200650020006C00610020006D00650067006100650076006F006C00750063006900F3006E0021001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Aunque creo que inventaste alguna que otra\nrespuesta, megaprofe...<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 6060,
      "rawDecodedUtf16Hex": "00410075006E0071007500650020006300720065006F002000710075006500200069006E00760065006E0074006100730074006500200061006C00670075006E006100200071007500650020006F007400720061000A007200650073007000750065007300740061002C0020006D00650067006100700072006F00660065002E002E002E001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "¿Te equivocaste en todo a propósito para ver\nsi nos dábamos cuenta?<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 6204,
      "rawDecodedUtf16Hex": "00BF00540065002000650071007500690076006F0063006100730074006500200065006E00200074006F0064006F00200061002000700072006F007000F3007300690074006F002000700061007200610020007600650072000A007300690020006E006F00730020006400E100620061006D006F00730020006300750065006E00740061003F001000020114016F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¡Ahora quiero aprender más cosas\nde la megaevolución!<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 6348,
      "rawDecodedUtf16Hex": "00A100410068006F00720061002000710075006900650072006F00200061007000720065006E0064006500720020006D00E1007300200063006F007300610073000A006400650020006C00610020006D00650067006100650076006F006C00750063006900F3006E0021001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "¡Síii! ¡Yo también!<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6464,
      "rawDecodedUtf16Hex": "00A1005300ED006900690021002000A10059006F002000740061006D0062006900E9006E0021001000020114019C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Yo escuché que el megaevolucionador más fuerte\nva a salvar a Ciudad Luminalia de la destrucción.<U+0010><U+0001>븁\n¿Tú sabías eso?<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 6512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "<U+0010><U+0002>뷿?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6752,
      "rawDecodedUtf16Hex": "00100002BDFF003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡La megaevolución está buenísima!<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 6764,
      "rawDecodedUtf16Hex": "00A1004C00610020006D00650067006100650076006F006C00750063006900F3006E002000650073007400E10020006200750065006E00ED00730069006D0061002100100002011401990000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Yo quiero estudiar para ser megaevolucionador.<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 6840,
      "rawDecodedUtf16Hex": "0059006F002000710075006900650072006F0020006500730074007500640069006100720020007000610072006100200073006500720020006D00650067006100650076006F006C007500630069006F006E00610064006F0072002E001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
