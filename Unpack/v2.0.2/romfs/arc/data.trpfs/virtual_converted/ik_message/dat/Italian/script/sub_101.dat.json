      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1720,
      "rawDecodedUtf16Hex": "0050006500720020006600610076006F00720065002C00200063006500720063006100200075006E0061002000700065006E006E006100200064006900200053006B00610072006D006F00720079000A006E0065006C006C00610020007A006F006E0061002000730065006C007600610067006700690061002000310037002E001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
