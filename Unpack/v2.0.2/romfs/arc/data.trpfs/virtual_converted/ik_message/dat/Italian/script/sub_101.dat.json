      "index": 9,
      "offsetInSection": 1860,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "C’è una penna di Skarmory per terra!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1872,
      "rawDecodedUtf16Hex": "0043201900E800200075006E0061002000700065006E006E006100200064006900200053006B00610072006D006F00720079002000700065007200200074006500720072006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "È un artiglio di Skarmory. Peccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 11,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "00C800200075006E002000610072007400690067006C0069006F00200064006900200053006B00610072006D006F00720079002E0020005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "È un mucchietto di cenere lasciato da Lampent.\nPeccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 2024,
      "rawDecodedUtf16Hex": "00C800200075006E0020006D00750063006300680069006500740074006F002000640069002000630065006E0065007200650020006C006100730063006900610074006F0020006400610020004C0061006D00700065006E0074002E000A005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "È un frammento di una chiave di Klefki. Peccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 2140,
      "rawDecodedUtf16Hex": "00C800200075006E0020006600720061006D006D0065006E0074006F00200064006900200075006E006100200063006800690061007600650020006400690020004B006C00650066006B0069002E0020005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "È un ciuffo di peli di Diggersby. Peccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "00C800200075006E002000630069007500660066006F002000640069002000700065006C00690020006400690020004400690067006700650072007300620079002E0020005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "È una punta di Chespin. Peccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "00C800200075006E0061002000700075006E007400610020006400690020004300680065007300700069006E002E0020005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "È un ciuffo della criniera di un Pyroar femmina.\nPeccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "00C800200075006E002000630069007500660066006F002000640065006C006C00610020006300720069006E006900650072006100200064006900200075006E0020005000790072006F00610072002000660065006D006D0069006E0061002E000A005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "È un ciuffo della criniera di un Pyroar maschio.\nPeccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "00C800200075006E002000630069007500660066006F002000640065006C006C00610020006300720069006E006900650072006100200064006900200075006E0020005000790072006F006100720020006D00610073006300680069006F002E000A005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "È una piccola pietra brillante. Peccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "00C800200075006E006100200070006900630063006F006C006100200070006900650074007200610020006200720069006C006C0061006E00740065002E0020005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "È una perlina scintillante. Peccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "00C800200075006E00610020007000650072006C0069006E00610020007300630069006E00740069006C006C0061006E00740065002E0020005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "È un lustrino luccicoso. Peccato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2816,
      "rawDecodedUtf16Hex": "00C800200075006E0020006C00750073007400720069006E006F0020006C00750063006300690063006F0073006F002E0020005000650063006300610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Immaginavo che avessi già trovato la penna di\nSkarmory e sono venuto fin qui evitando i Pyroar.<U+0010><U+0001>븁\nNe verrà fuori un coltello di gran qualità,\nne sono sicuro!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2888,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 163
    },
    {
      "displayText": "SKAAA!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 22,
      "offsetInSection": 3216,
      "rawDecodedUtf16Hex": "0053004B00410041004100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "ARGH! CHE SUCCEDE?!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3232,
      "rawDecodedUtf16Hex": "00410052004700480021002000430048004500200053005500430043004500440045003F0021001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Ti prego, manda via quello Skarmory!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3280,
      "rawDecodedUtf16Hex": "0054006900200070007200650067006F002C0020006D0061006E0064006100200076006900610020007100750065006C006C006F00200053006B00610072006D006F007200790021001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "SKAAAR!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 25,
      "offsetInSection": 3364,
      "rawDecodedUtf16Hex": "0053004B004100410041005200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3380,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Fiuuu... C’è mancato poco. Perché mai Skarmory\nci avrà attaccato?<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3392,
      "rawDecodedUtf16Hex": "00460069007500750075002E002E002E00200043201900E80020006D0061006E006300610074006F00200070006F0063006F002E00200050006500720063006800E90020006D0061006900200053006B00610072006D006F00720079000A00630069002000610076007200E0002000610074007400610063006300610074006F003F001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "SKAAAR!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 28,
      "offsetInSection": 3532,
      "rawDecodedUtf16Hex": "0053004B004100410041005200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Tieni tanto alle tue penne anche se le perdi?\nIl problema è che sono importanti anche per me!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Voglio farne un coltello eccellente da regalare\na uno chef che conosco.<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "I suoi piatti hanno il potere di rendere felici tutti\na Luminopoli, sia persone che Pokémon!<U+0010><U+0001>븀\nQuindi, ti prego, cedimi una tua penna!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "Skaaar!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 32,
      "offsetInSection": 4176,
      "rawDecodedUtf16Hex": "0053006B006100610061007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Me ne cedi una allora?!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4192,
      "rawDecodedUtf16Hex": "004D00650020006E00650020006300650064006900200075006E006100200061006C006C006F00720061003F0021001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Skaaar!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 34,
      "offsetInSection": 4248,
      "rawDecodedUtf16Hex": "0053006B006100610061007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Grazie di cuore! Riferirò la tua gentilezza\nal mio amico chef!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4264,
      "rawDecodedUtf16Hex": "004700720061007A00690065002000640069002000630075006F0072006500210020005200690066006500720069007200F20020006C00610020007400750061002000670065006E00740069006C0065007A007A0061000A0061006C0020006D0069006F00200061006D00690063006F002000630068006500660021001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ho un’idea! Vienici a trovare quando il coltello\nsarà pronto e lo chef potrà usarlo per cucinare!<U+0010><U+0001>븁\nTi aspettiamo al Ristorante Gourmet!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Skaaar!",
      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 37,
      "offsetInSection": 4684,
      "rawDecodedUtf16Hex": "0053006B006100610061007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Chissà se sono riuscito a comunicargli la mia\ngratitudine. Credi che mi abbia capito?<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Non ho dubbi!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4880,
      "rawDecodedUtf16Hex": "004E006F006E00200068006F00200064007500620062006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Verrà a trovarvi al ristorante, vedrai!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4908,
      "rawDecodedUtf16Hex": "005600650072007200E000200061002000740072006F0076006100720076006900200061006C00200072006900730074006F00720061006E00740065002C002000760065006400720061006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Pensa, ora ho un Pokémon selvatico per amico...\nChe emozione! Chissà cosa mi riserva il futuro!<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
