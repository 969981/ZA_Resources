      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5188,
      "rawDecodedUtf16Hex": "00100002BDFF002A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Grazie a te sono riuscito a ottenere qualcosa di\nmolto più importante di un semplice coltello.<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
