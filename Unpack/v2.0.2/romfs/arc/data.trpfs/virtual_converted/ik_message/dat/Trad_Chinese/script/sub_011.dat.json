      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "動作蠻普通的……\n有點難從心裡產生共鳴。<U+0010><U+0002>ĔƓ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "52D54F5C883B666E901A768420262026000A67099EDE96E35F9E5FC388E17522751F51719CF4300200100002011401930000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "從叫聲可以察覺到\n牠很緊張呢。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1760,
      "rawDecodedUtf16Hex": "5F9E53EB807253EF4EE55BDF89BA5230000A72605F887DCA5F355462300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "接下來是2號參加者，\n琉克的含羞苞。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1800,
      "rawDecodedUtf16Hex": "63A54E0B4F86662F0032865F53C352A08005FF0C000A7409514B7684542B7F9E82DE300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "喊苞！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "558A82DEFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "姿勢端正，\n讓人能感受到牠蘊藏的力道。<U+0010><U+0002>ĔƓ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1856,
      "rawDecodedUtf16Hex": "59FF52E27AEF6B63FF0C000A8B934EBA80FD611F53D752307260860A85CF7684529B9053300200100002011401930000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "叫聲可以算是不錯。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "53EB807253EF4EE57B97662F4E0D932F300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "不過，臉色有點不好呢。\n可能是日光浴的時間不夠唷。<U+0010><U+0002>ĔƔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1932,
      "rawDecodedUtf16Hex": "4E0D904EFF0C81C9827267099EDE4E0D597D54623002000A53EF80FD662F65E551496D747684664295934E0D59205537300200100002011401940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "接下來是3號參加者，\n明莉的含羞苞。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "63A54E0B4F86662F0033865F53C352A08005FF0C000A660E83897684542B7F9E82DE300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "嘩葆～……",
