      "rawDecodedUtf16Hex": "628A542B7F9E82DE52A051655230540C884C968A4F0D88E1518D4F865427300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "那麼首先是1號參加者，\n悠太的含羞苞。<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
