      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 2420,
      "rawDecodedUtf16Hex": "4E0D53EA662F591689C02026202600100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
