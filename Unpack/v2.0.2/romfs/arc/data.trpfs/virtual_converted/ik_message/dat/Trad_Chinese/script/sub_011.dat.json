      "rawDecodedUtf16Hex": "90A39EBC99965148662F0031865F53C352A08005FF0C000A60A0592A7684542B7F9E82DE300200100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "寶咆～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1660,
      "rawDecodedUtf16Hex": "5BF65486FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "花苞的光澤\n相當油亮水嫩唷！<U+0010><U+0002>ĔƔ",
