      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "今天是个特别的日子！<U+0010><U+0001>븁\n虽然早了一天，\n不过仍然要祝您生日快乐！",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
