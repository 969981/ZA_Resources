      "rawDecodedUtf16Hex": "611F8C2260A85B8C6210767B8BB0FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "请在您生日的<U+0010><U+0002>ȁ<U+0001>月<U+0010><U+0002>ȁ<U+0002>日那天，\n到宝可梦中心来哦。",
      "escapedControlUnits": 6,
