      "rawDecodedUtf16Hex": "D3ECCF13BAACC5D0AC8C0020C9C0B2C8AC8C0020D558BA74000AACE0C2A4D2B8D0C0C7850020AE30C220C7580020C704B825C7740020C624B974B29400100001BE00000AC800C8FCC758BD80C801C7440020B4DCB9B40020D14CB2C80020BC1BC5440020C8FCC138C694002E00100002011401650000",
