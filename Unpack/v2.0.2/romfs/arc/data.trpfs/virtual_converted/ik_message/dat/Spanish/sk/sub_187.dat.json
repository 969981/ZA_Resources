      "rawDecodedUtf16Hex": "0050006100720061002000610075006D0065006E007400610072002000730075002000410074006100710075006500200045007300700065006300690061006C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Para aumentar su Defensa Especial",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
