      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4048,
      "rawDecodedUtf16Hex": "00500063006800E9002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "No lo sé",
      "escapedControlUnits": 0,
