      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "A todo esto, ¿a que este Cubone es todo amor?\nEs imposible no hacerle caso.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 54,
      "offsetInSection": 4280,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "♪¡Cuuu, cubooo!♪",
