      "rawDecodedUtf16Hex": "0050006100720061002000610075006D0065006E007400610072002000730075002000560065006C006F006300690064006100640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Muy bien, espera que lo anoto. Recuerda seguir\nsiempre las instrucciones de uso.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
