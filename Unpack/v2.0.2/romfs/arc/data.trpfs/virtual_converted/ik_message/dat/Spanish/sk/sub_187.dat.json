      "index": 51,
      "offsetInSection": 4064,
      "rawDecodedUtf16Hex": "004E006F0020006C006F0020007300E90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Muy bien, entiendo. Eso depende de cada uno.<U+0010><U+0002>Ĕǡ",
