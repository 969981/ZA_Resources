      "displayText": "Es un precio normal",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2388,
      "rawDecodedUtf16Hex": "0045007300200075006E002000700072006500630069006F0020006E006F0072006D0061006C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Diría que es barato",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2428,
      "rawDecodedUtf16Hex": "00440069007200ED00610020007100750065002000650073002000620061007200610074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Perfecto, lo anoto. El valor de las cosas es algo\nmuy personal y subjetivo, claro está.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¿Conoces algún otro suplemento además de\nla Proteína?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
