      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¡Y tanto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 4000,
      "rawDecodedUtf16Hex": "00A10059002000740061006E0074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
