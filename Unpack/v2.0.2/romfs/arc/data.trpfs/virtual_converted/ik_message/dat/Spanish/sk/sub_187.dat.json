      "offsetInSection": 2808,
      "rawDecodedUtf16Hex": "0045006C0020005A0069006E00630000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Los Carbohidratos",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2824,
      "rawDecodedUtf16Hex": "004C006F007300200043006100720062006F006800690064007200610074006F00730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "No",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2860,
      "rawDecodedUtf16Hex": "004E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Vale, muy bien. La verdad es que existe una gran\nvariedad de suplementos.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "¿Para qué le darías a un Pokémon un bote de\nProteína?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3024,
      "rawDecodedUtf16Hex": "00BF005000610072006100200071007500E90020006C0065002000640061007200ED006100730020006100200075006E00200050006F006B00E9006D006F006E00200075006E00200062006F00740065002000640065000A00500072006F0074006500ED006E0061003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Para aumentar su Ataque",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
