      "index": 0,
      "offsetInSection": 516,
      "rawDecodedUtf16Hex": "266A00A100430075002C0020006300750062006F006F006F0021266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "¡Cubone te ha dado un bote de Proteína!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "00A1004300750062006F006E00650020007400650020006800610020006400610064006F00200075006E00200062006F00740065002000640065002000500072006F0074006500ED006E006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "¡Enhorabuenaaa!<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "00A10045006E0068006F00720061006200750065006E006100610061002100100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Te ha tocado un bote de Proteína como parte de\nla campaña que estoy llevando a cabo.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "¿Te importa si te robo un poco de tu tiempo?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 848,
      "rawDecodedUtf16Hex": "00BF0054006500200069006D0070006F00720074006100200073006900200074006500200072006F0062006F00200075006E00200070006F0063006F0020006400650020007400750020007400690065006D0070006F003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Bueno...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "004200750065006E006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Me pillas mal",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "004D0065002000700069006C006C006100730020006D0061006C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Terminaremos en un visto y no visto. Vamos,\n¡hazme este favor!<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "005400650072006D0069006E006100720065006D006F007300200065006E00200075006E00200076006900730074006F002000790020006E006F00200076006900730074006F002E002000560061006D006F0073002C000A00A100680061007A006D0065002000650073007400650020006600610076006F0072002100100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡Muchas graciaaas!<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "00A1004D007500630068006100730020006700720061006300690061006100610073002100100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Empecemos entonces con la encuesta a pie de\ncalle sobre la Proteína.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "0045006D0070006500630065006D006F007300200065006E0074006F006E00630065007300200063006F006E0020006C006100200065006E006300750065007300740061002000610020007000690065002000640065000A00630061006C006C006500200073006F0062007200650020006C0061002000500072006F0074006500ED006E0061002E00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¿Conocías ya la Proteína?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "00BF0043006F006E006F006300ED006100730020007900610020006C0061002000500072006F0074006500ED006E0061003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Sí, y muy bien",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "005300ED002C002000790020006D007500790020006200690065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Más o menos",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1420,
      "rawDecodedUtf16Hex": "004D00E100730020006F0020006D0065006E006F00730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Para nada",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1444,
      "rawDecodedUtf16Hex": "00500061007200610020006E0061006400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Vale, déjame que lo anote...<U+0010><U+0001>븁\nLa Proteína es lo que llamamos un suplemento,\npor cierto.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1464,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Si ya la conocías, ¿dónde oíste hablar de ella por\nprimera vez?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "005300690020007900610020006C006100200063006F006E006F006300ED00610073002C002000BF006400F3006E006400650020006F00ED0073007400650020006800610062006C0061007200200064006500200065006C006C006100200070006F0072000A007000720069006D006500720061002000760065007A003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "En las redes sociales",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1788,
      "rawDecodedUtf16Hex": "0045006E0020006C0061007300200072006500640065007300200073006F006300690061006C006500730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Unos amigos me hablaron de ella",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "0055006E006F007300200061006D00690067006F00730020006D00650020006800610062006C00610072006F006E00200064006500200065006C006C00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "La vi en un póster",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1896,
      "rawDecodedUtf16Hex": "004C006100200076006900200065006E00200075006E0020007000F300730074006500720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "En un Centro Pokémon",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "0045006E00200075006E002000430065006E00740072006F00200050006F006B00E9006D006F006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Es la primera vez que oigo hablar de ella",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "004500730020006C00610020007000720069006D006500720061002000760065007A00200071007500650020006F00690067006F0020006800610062006C0061007200200064006500200065006C006C00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Muy bien, muy bien. Es importante conocer\nla fuente de la que proviene la información.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "¿Te parece caro un precio de 5000 <U+E300> por un bote\nde Proteína?<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2248,
      "rawDecodedUtf16Hex": "00BF0054006500200070006100720065006300650020006300610072006F00200075006E002000700072006500630069006F0020006400650020003500300030003000A0E30000200070006F007200200075006E00200062006F00740065000A00640065002000500072006F0074006500ED006E0061003F00100002011401E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Sí",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "005300ED0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
