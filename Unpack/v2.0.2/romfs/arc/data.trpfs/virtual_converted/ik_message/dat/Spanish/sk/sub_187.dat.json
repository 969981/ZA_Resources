      "rawDecodedUtf16Hex": "004E0069002000690064006500610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Vale, muy bien. Supongo que eso sería mejor\npreguntárselo a un Pokémon.<U+0010><U+0002>Ĕǡ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 3768,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
