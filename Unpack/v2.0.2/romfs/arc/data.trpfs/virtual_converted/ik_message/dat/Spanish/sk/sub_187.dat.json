      "offsetInSection": 3308,
      "rawDecodedUtf16Hex": "0050006100720061002000610075006D0065006E00740061007200200073007500200044006500660065006E0073006100200045007300700065006300690061006C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
