  "messages": [
    {
      "displayText": "Hé, dis ! Pour toi, c’est quoi le plus important\ndans un combat ?<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 260,
      "rawDecodedUtf16Hex": "004800E9002C00200064006900730020002100200050006F0075007200200074006F0069002C002000632019006500730074002000710075006F00690020006C006500200070006C0075007300200069006D0070006F007200740061006E0074000A00640061006E007300200075006E00200063006F006D0062006100740020003F00100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "L’Attaque !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 400,
      "rawDecodedUtf16Hex": "004C20190041007400740061007100750065002000210000",
      "trailingZeroPaddingUnits": 1,
