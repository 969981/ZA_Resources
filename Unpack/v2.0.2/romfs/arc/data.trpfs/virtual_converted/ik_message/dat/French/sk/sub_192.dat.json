      "offsetInSection": 2396,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mais... Vous êtes méga rapides, en fait !!!<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "004D006100690073002E002E002E00200056006F00750073002000EA0074006500730020006D00E90067006100200072006100700069006400650073002C00200065006E00200066006100690074002000210021002100100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "On a encore du chemin à faire si on veut\nrivaliser avec vous un jour...<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Tiens, prends cette CT.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2656,
      "rawDecodedUtf16Hex": "005400690065006E0073002C0020007000720065006E00640073002000630065007400740065002000430054002E00100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Elle contient<U+0010><U+0002>＀<U+0006> Nitrocharge<U+0010><U+0002>＀<U+0000>, une capacité qui permet\nd’attaquer tout en augmentant sa Vitesse.<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 8,
      "flagsUpper16": 4,
      "index": 26,
      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Franchement, y a pas plus grisant que de tourner\nautour d’un adversaire plus lent que soi !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2924,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
