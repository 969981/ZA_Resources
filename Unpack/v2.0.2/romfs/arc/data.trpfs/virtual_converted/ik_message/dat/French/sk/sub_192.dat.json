      "rawDecodedUtf16Hex": "004D006500730020004D006F0074006F00720069007A00610072006400200076006F006E00740020007400650020006D006500740074007200650020006C00610020007000E2007400E90065000A00E0002000760069007400650073007300650020006700720061006E0064002000560020002100100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
