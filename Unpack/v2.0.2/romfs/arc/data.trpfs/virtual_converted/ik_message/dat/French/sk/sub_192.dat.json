      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Alors, prêt<U+0010><U+0003>ᄀÿĀe à passer à la vitesse supérieure\nen affrontant mes Motorizard ?<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Qu’est-ce qu’on attend ? Let’s go !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "005100752019006500730074002D006300650020007100752019006F006E00200061007400740065006E00640020003F0020004C006500742019007300200067006F002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Pas si vite...",
