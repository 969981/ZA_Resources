      "rawDecodedUtf16Hex": "00500061007300200073006900200076006900740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Nous fais pas attendre trop longtemps,\non déteste faire du surplace !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
