      "offsetInSection": 424,
      "rawDecodedUtf16Hex": "004C00610020004400E900660065006E00730065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "La stratégie !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 452,
      "rawDecodedUtf16Hex": "004C006100200073007400720061007400E9006700690065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "La chance !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "004C00610020006300680061006E00630065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Je me doutais que t’aurais pas la bonne réponse !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "004A00650020006D006500200064006F00750074006100690073002000710075006500200074201900610075007200610069007300200070006100730020006C006100200062006F006E006E00650020007200E90070006F006E007300650020002100100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Mais t’inquiète, je vais te la révéler.\nLe secret d’un combat bien mené...<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "C’est la Vitesse !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 776,
      "rawDecodedUtf16Hex": "004320190065007300740020006C0061002000560069007400650073007300650020002100100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "C’est la base des bases du combat !<U+0010><U+0001>븁\nUne Vitesse élevée permet de se déplacer au\nmoment opportun et d’esquiver les attaques !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "Avec mes Motorizard, on file à toute allure à\ntravers Illumis tous les jours, si bien qu’ils ont<U+0010><U+0001>븀\nappris plein de capacités qui boostent la Vitesse !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 156
    },
    {
      "displayText": "On est les plus rapides, et de facto,\nles plus balèzes !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "004F006E00200065007300740020006C0065007300200070006C0075007300200072006100700069006400650073002C00200065007400200064006500200066006100630074006F002C000A006C0065007300200070006C00750073002000620061006C00E8007A006500730020002100100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Rizzz !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1524,
      "rawDecodedUtf16Hex": "00520069007A007A007A002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Zazar !!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "005A0061007A0061007200200021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "ZAAAR !!!!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1560,
      "rawDecodedUtf16Hex": "005A00410041004100520020002100210021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Si tu nous crois pas, t’as qu’à te battre\ncontre nous !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1584,
      "rawDecodedUtf16Hex": "005300690020007400750020006E006F00750073002000630072006F006900730020007000610073002C00200074201900610073002000710075201900E00020007400650020006200610074007400720065000A0063006F006E0074007200650020006E006F007500730020002100100002011401E70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Reviens nous voir quand tu seras prêt<U+0010><U+0003>ᄀÿĀe\nà en découdre !<U+0010><U+0002>Ĕǧ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "00520065007600690065006E00730020006E006F0075007300200076006F006900720020007100750061006E006400200074007500200073006500720061007300200070007200EA007400100003110000FF01000065000A00E000200065006E0020006400E90063006F00750064007200650020002100100002011401E70000",
      "trailingZeroPaddingUnits": 1,
