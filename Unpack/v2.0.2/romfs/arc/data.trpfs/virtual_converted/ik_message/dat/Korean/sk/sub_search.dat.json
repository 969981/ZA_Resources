      "rawDecodedUtf16Hex": "B2E4C74CC5D00020D560AC8CC6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "마음이 바뀌시거든\n언제든지 말씀해 주세요.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
