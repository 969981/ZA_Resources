      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "서치를 실행하면 아직 조사하지 않은\n특별한 이차원의 뒤틀림이 사라집니다만<U+0010><U+0001>븀\n계속 진행할까요?<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "C11CCE58B97C0020C2E4D589D558BA740020C544C9C10020C870C0ACD558C9C00020C54AC740000AD2B9BCC4D55C0020C774CC28C6D0C7580020B4A4D2C0B9BCC7740020C0ACB77CC9D1B2C8B2E4B9CC00100001BE00000AACC4C18D0020C9C4D589D560AE4CC694003F00100002011400140000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "수고 많으십니다.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 432,
