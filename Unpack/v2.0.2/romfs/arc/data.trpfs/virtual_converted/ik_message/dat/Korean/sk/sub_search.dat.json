      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "괜찮으실 때 카라스바 님의 방으로\n와 주시면 감사하겠습니다.<U+0010><U+0002>Ĕ<U+0014>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
