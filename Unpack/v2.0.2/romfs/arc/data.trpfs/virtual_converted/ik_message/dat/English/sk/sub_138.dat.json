      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "To be specific, I’d like to ask you to put the\nfollowing Pokémon in your party to show me.<U+0010><U+0002>ĔƵ",
