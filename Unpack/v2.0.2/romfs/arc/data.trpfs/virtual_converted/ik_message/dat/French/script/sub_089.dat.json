      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "L’orange est une couleur automnale, pas vrai ?\nVoilà une super idée de couleur !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "La teinture orange est désormais disponible\ndans les salons de coiffure !",
