      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "<U+0010><U+0002>뷿(",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4948,
      "rawDecodedUtf16Hex": "00100002BDFF00280000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Rouge, jaune, orange, bleu, blanc... Merci\nde m’avoir montré un arc-en-ciel de Flabébé !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4960,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Cette diversité chromatique me donne envie\nde tester encore plus de nouvelles colorations !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5148,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Aussitôt dit... aussitôt fait !\nJ’ai élargi le choix de teintures disponibles !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 43,
      "offsetInSection": 5340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Les teintures aigue-marine, violette et\nrose fuchsia sont désormais disponibles<U+0010><U+0001>븀\ndans les salons de coiffure !",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Maintenant que j’ai vu ces Flabébé de mes\npropres yeux, j’ai envie d’en élever moi-même !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
