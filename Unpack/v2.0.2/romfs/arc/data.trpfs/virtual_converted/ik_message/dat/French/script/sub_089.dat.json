      "offsetInSection": 3932,
      "rawDecodedUtf16Hex": "004C00610020007400650069006E00740075007200650020006F00720061006E0067006500200065007300740020006400E90073006F0072006D00610069007300200064006900730070006F006E00690062006C0065000A00640061006E00730020006C00650073002000730061006C006F006E007300200064006500200063006F006900660066007500720065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
