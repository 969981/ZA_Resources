      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Le bleu me donne toujours un sentiment de\nliberté... Voilà une super idée de couleur !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
