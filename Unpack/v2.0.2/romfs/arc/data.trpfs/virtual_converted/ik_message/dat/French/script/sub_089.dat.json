      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Le blanc est synonyme de fraîcheur, tu ne trouves\npas ? Voilà une super idée de couleur !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
