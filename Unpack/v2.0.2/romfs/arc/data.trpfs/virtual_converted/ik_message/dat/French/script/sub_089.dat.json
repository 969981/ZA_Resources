      "rawDecodedUtf16Hex": "00100002BDFF001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Quel joli orange... Je te remercie !<U+0010><U+0002>ĔŴ",
