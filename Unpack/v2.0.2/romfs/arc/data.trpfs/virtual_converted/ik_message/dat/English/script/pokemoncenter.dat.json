      "index": 50,
      "offsetInSection": 4388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "I do hope this will be a wonderful year for you—\neach and every day!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 51,
      "offsetInSection": 4664,
