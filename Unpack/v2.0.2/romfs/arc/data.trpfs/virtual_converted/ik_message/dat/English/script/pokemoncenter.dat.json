      "index": 44,
      "offsetInSection": 3368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Come back and see us again whenever you need!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 3548,
      "rawDecodedUtf16Hex": "0043006F006D00650020006200610063006B00200061006E0064002000730065006500200075007300200061006700610069006E0020007700680065006E006500760065007200200079006F00750020006E00650065006400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Hold on... You said <U+0010><U+0002>ȁ<U+0001>/<U+0010><U+0002>ȁ<U+0002>, right? Is that...? Hm?!<U+0010><U+0001>븁\nThat’s today! OK, give me a second while I get\neverything ready!",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 3640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Hold on... You said <U+0010><U+0002>ȁ<U+0001>/<U+0010><U+0002>ȁ<U+0002>, right? Is that...? Hm?!<U+0010><U+0001>븁\nToday is 2/28! So we should celebrate your\nbirthday today, shouldn’t we?<U+0010><U+0001>븁\nOK, give me a second while I get everything ready!",
