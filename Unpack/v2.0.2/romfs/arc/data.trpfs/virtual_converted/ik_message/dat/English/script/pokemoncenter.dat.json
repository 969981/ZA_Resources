      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2892,
      "rawDecodedUtf16Hex": "005400680061006E006B007300200066006F00720020007200650067006900730074006500720069006E006700200079006F00750072002000620069007200740068006400610079002000770069007400680020007400680065000A0050006F006B00E9006D006F006E002000430065006E00740065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "You should stop by on your big day, too!\nWe’ll be expecting you on <U+0010><U+0002>ȁ<U+0001>/<U+0010><U+0002>ȁ<U+0002>!",
