      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Joyeux anniversaire! We wish you a happy\nbirthday, <U+0010><U+0002>Ā<U+0000>!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4272,
      "rawDecodedUtf16Hex": "004A006F007900650075007800200061006E006E00690076006500720073006100690072006500210020005700650020007700690073006800200079006F007500200061002000680061007000700079000A00620069007200740068006400610079002C0020001000020100000000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Oh, today is a bit special, isn’t it?<U+0010><U+0001>븁\nI know it’s a day early, but we wish you a joyeux\nanniversaire! Have a happy birthday tomorrow!",
      "escapedControlUnits": 2,
