      "rawDecodedUtf16Hex": "00100002BDFF00360000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "CHE LUCE ACCECANTE!<U+0010><U+0002>Ĕǖ",
