  "initialKey": 0,
  "messages": [
    {
      "displayText": "Ehi! Tu, del Team MZ!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "0045006800690021002000540075002C002000640065006C0020005400650061006D0020004D005A0021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Dai, dammi una mano ad aiutare della gente.\nOvviamente mi dirai di sì, vero?<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Sì!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 804,
      "rawDecodedUtf16Hex": "005300EC00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Vabbè...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 812,
      "rawDecodedUtf16Hex": "005600610062006200E8002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Ottimo.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "004F007400740069006D006F002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Ho sentito un grido provenire da quell’acquedotto\nlaggiù.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "0048006F002000730065006E007400690074006F00200075006E00200067007200690064006F002000700072006F00760065006E0069007200650020006400610020007100750065006C006C2019006100630071007500650064006F00740074006F000A006C006100670067006900F9002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Dovrei andare a controllare, ma ho sentito dire\nche lì dentro ci vivono un sacco di terribili<U+0010><U+0001>븀\nPokémon di tipo Spettro...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Perciò, visto che il signor Corvin si fida di te, mi\nsembra giusto chiederti aiuto.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Ah, e tanto per la cronaca, non ho mica paura!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1412,
      "rawDecodedUtf16Hex": "00410068002C00200065002000740061006E0074006F00200070006500720020006C0061002000630072006F006E006100630061002C0020006E006F006E00200068006F0020006D0069006300610020007000610075007200610021001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Tu sei forte, no? Quindi non ti lamentare e dammi\nuna mano! Fallo per il bene di questa città!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1516,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "<U+0010><U+0002>뷿\n",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Controlliamo l’interno dell’acquedotto!\nVai avanti tu.<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1728,
      "rawDecodedUtf16Hex": "0043006F006E00740072006F006C006C00690061006D006F0020006C20190069006E007400650072006E006F002000640065006C006C2019006100630071007500650064006F00740074006F0021000A0056006100690020006100760061006E00740069002000740075002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Non ho paura! Ma è meglio che siano quelli forti\nad andare avanti, no?!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Uhm... Beh, non mi sembra esserci niente di\npreoccupante...<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 2000,
      "rawDecodedUtf16Hex": "00550068006D002E002E002E0020004200650068002C0020006E006F006E0020006D0069002000730065006D006200720061002000650073007300650072006300690020006E00690065006E00740065002000640069000A007000720065006F00630063007500700061006E00740065002E002E002E001000020114001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Mh? Ma quello è...<U+0010><U+0002>Ĕ<U+001D>",
