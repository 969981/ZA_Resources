      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 4864,
      "rawDecodedUtf16Hex": "00530069002000700065007200630065007000690073006300650020006C0061002000700072006500730065006E007A006100200064006900200061006C00740072006900200043006F00660061006700720069006700750073000A006E0065006C006C2019006100630071007500650064006F00740074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "<U+0010><U+0002>뷿6",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
