      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4592,
      "rawDecodedUtf16Hex": "00500061007200650020006300680065002000640065006E00740072006F002000710075006500730074006F00200043006F006600610067007200690067007500730020006E006F006E00200063006900200066006F007300730065000A006E0065007300730075006E006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Cofagrigus se n’è andato...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 4704,
      "rawDecodedUtf16Hex": "0043006F006600610067007200690067007500730020007300650020006E201900E800200061006E006400610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Mentre se ne andava, ha lasciato cadere\nqualcosa...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 4760,
      "rawDecodedUtf16Hex": "004D0065006E0074007200650020007300650020006E006500200061006E0064006100760061002C0020006800610020006C006100730063006900610074006F0020006300610064006500720065000A007100750061006C0063006F00730061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Si percepisce la presenza di altri Cofagrigus\nnell’acquedotto...",
