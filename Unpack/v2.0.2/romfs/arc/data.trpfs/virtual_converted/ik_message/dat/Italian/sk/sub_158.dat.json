      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Segnerò sulla tua mappa le coordinate del\nPokémon che sta bloccando il tubo.<U+0010><U+0001>븀\nAttiva il marcatore e vai a dare un’occhiata.<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
