      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "6E056D176D1B625859C676845C5E6027662F7535548C6C34FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "能学会水炮这个招式！\n是水炮的“炮”，不是水泡的“泡”哦！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "80FD5B664F1A6C3470AE8FD94E2A62DB5F0FFF01000A662F6C3470AE7684201C70AE201DFF0C4E0D662F6C346CE17684201C6CE1201D54E6FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "不放洗衣粉，它就不洗衣服，\n这功能多贴心！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1744,
