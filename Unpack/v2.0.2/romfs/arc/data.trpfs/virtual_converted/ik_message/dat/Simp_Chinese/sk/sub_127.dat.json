      "rawDecodedUtf16Hex": "00100002BDFF00220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "切割洛托姆的属性是电和草！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
