  "initialKey": 0,
  "messages": [
    {
      "displayText": "能依靠等离子构成的身体\n进入电器的宝可梦……<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "80FD4F9D97607B4979BB5B506784621076848EAB4F53000A8FDB51657535566876845B9D53EF68A62026202600100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "它就是洛托姆！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "5B835C31662F6D1B625859C6FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "你也有手机洛托姆啊。<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "4F604E5F6709624B673A6D1B625859C6554A300200100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "手机洛托姆的数量取决于\n洛托姆的个体数，所以是很宝贵的！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "624B673A6D1B625859C67684657091CF53D651B34E8E000A6D1B625859C676844E2A4F536570FF0C62404EE5662F5F885B9D8D357684FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "虽然手机洛托姆也很棒，\n但洛托姆的精髓在于能进入电器！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "867D7136624B673A6D1B625859C64E5F5F8868D2FF0C000A4F466D1B625859C676847CBE9AD357284E8E80FD8FDB516575355668FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "你要不要和进入各种电器\n来改变形态的洛托姆来场对战？<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "4F6089814E0D8981548C8FDB5165540479CD75355668000A6765653953D85F62600176846D1B625859C66765573A5BF96218FF1F00100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "如果你想和各种形态的洛托姆对战，\n就来找我吧。<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "5982679C4F6060F3548C540479CD5F62600176846D1B625859C65BF96218FF0C000A5C316765627E62115427300200100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "洛托姆会进入的\n是什么样的电器呢？<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 936,
      "rawDecodedUtf16Hex": "6D1B625859C64F1A8FDB51657684000A662F4EC04E4868377684753556685462FF1F00100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "你想和各种形态的洛托姆对战，\n没错吧？<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "4F6060F3548C540479CD5F62600176846D1B625859C65BF96218FF0C000A6CA195195427FF1F00100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "没错！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "6CA19519FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "现在还不想对战",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1048,
      "rawDecodedUtf16Hex": "73B057288FD84E0D60F35BF962180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "别吊人胃口，快和洛托姆对战吧。<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "522B540A4EBA80C353E3FF0C5FEB548C6D1B625859C65BF962185427300200100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "洛托姆的亮点！精髓！\n在于和电器的组合！<U+0010><U+0001>븀\n先和这只洛托姆对战吧！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "6D1B625859C676844EAE70B9FF017CBE9AD3FF01000A57284E8E548C7535566876847EC45408FF0100100001BE00000A5148548C8FD953EA6D1B625859C65BF962185427FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "洛托姆会进入的\n是什么样的电器呢？<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1184,
      "rawDecodedUtf16Hex": "6D1B625859C64F1A8FDB51657684000A662F4EC04E4868377684753556685462FF1F00100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1228,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "进入烤箱的洛托姆\n被称为加热洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "8FDB516570E47BB176846D1B625859C6000A88AB79F04E3A52A070ED6D1B625859C6FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "属性是电和火！\n幽灵属性消失了！？<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1288,
      "rawDecodedUtf16Hex": "5C5E6027662F7535548C706BFF01000A5E7D70755C5E60276D8859314E86FF01FF1F00100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "能学会过热这个招式！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "80FD5B664F1A8FC770ED8FD94E2A62DB5F0FFF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "它心情好，就会烤得焦香！\n心情不好，就会烤得焦黑！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "5B835FC360C5597DFF0C5C314F1A70E45F9771269999FF01000A5FC360C54E0D597DFF0C5C314F1A70E45F9771269ED1FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "我要在接下来的宝可梦对战……\n好好展示一下洛托姆的长处！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1424,
      "rawDecodedUtf16Hex": "62118981572863A54E0B676576845B9D53EF68A65BF9621820262026000A597D597D5C55793A4E004E0B6D1B625859C67684957F5904FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1492,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "加热洛托姆的热风！\n感觉如何啊？<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "52A070ED6D1B625859C6768470ED98CEFF01000A611F89C959824F55554AFF1F00100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "下一只！进入洗衣机的洛托姆\n被称为清洗洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "4E0B4E0053EAFF018FDB51656D178863673A76846D1B625859C6000A88AB79F04E3A6E056D176D1B625859C6FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "哇～好厉害！！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1604,
      "rawDecodedUtf16Hex": "54C7FF5E597D53895BB3FF01FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
