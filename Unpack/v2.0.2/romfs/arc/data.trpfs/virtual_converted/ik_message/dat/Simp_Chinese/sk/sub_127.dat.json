      "rawDecodedUtf16Hex": "54E6FF01599967814E86FF01FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "<U+0010><U+0002>뷿+",
