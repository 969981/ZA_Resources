      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "不过我也要提醒你，\n它搞不好会把房间给淹了！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "4E0D8FC762114E5F898163D091924F60FF0C000A5B83641E4E0D597D4F1A628A623F95F47ED96DF94E86FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1852,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "清洗洛托姆的水流！\n感觉如何？<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "6E056D176D1B625859C676846C346D41FF01000A611F89C959824F55FF1F00100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "下一只！进入割草机的洛托姆\n被称为切割洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1904,
