      "offsetInSection": 2200,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "切割洛托姆割草的力量！\n感觉如何？<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "520752726D1B625859C6527283497684529B91CFFF01000A611F89C959824F55FF1F00100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "下一只！进入电扇的洛托姆\n被称为旋转洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2256,
      "rawDecodedUtf16Hex": "4E0B4E0053EAFF018FDB51657535624776846D1B625859C6000A88AB79F04E3A65CB8F6C6D1B625859C6FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "哦！妙极了！！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
