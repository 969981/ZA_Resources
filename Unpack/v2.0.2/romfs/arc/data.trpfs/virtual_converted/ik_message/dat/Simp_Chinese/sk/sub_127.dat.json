      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "00100002BDFF002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "旋转洛托姆的属性是电和飞行！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2348,
      "rawDecodedUtf16Hex": "65CB8F6C6D1B625859C676845C5E6027662F7535548C98DE884CFF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "能学会空气之刃这个招式！<U+0010><U+0002>ĔƩ",
