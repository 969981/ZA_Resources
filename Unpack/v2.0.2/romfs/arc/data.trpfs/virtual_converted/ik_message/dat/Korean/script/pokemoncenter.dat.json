      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "BAA8B4500020AC74AC15D574C84CC2B5B2C8B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "포켓몬의 기술을 연달아 맞으면 위험하니\n안전한 곳에서 쉬면서 회복해 주세요.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "D3ECCF13BAACC7580020AE30C220C7440020C5F0B2ECC5440020B9DEC73CBA740020C704D5D8D558B2C8000AC548C804D55C0020ACF3C5D0C11C0020C26CBA74C11C0020D68CBCF5D5740020C8FCC138C694002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "싸울 수 있는 포켓몬이 없다...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 2712,
