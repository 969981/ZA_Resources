      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "등록한 뒤에는 변경하실 수 없으니\n주의해서 입력해 주세요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
