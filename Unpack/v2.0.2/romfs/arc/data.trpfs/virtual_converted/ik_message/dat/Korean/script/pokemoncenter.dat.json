      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> 님의 생일을\n<U+0010><U+0002>ȁ<U+0001>월 <U+0010><U+0002>ȁ<U+0002>일로 등록해 드리면 될까요?",
      "escapedControlUnits": 9,
