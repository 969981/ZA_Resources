      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 1824,
      "rawDecodedUtf16Hex": "B6100020C774C6A9D5740020C8FCC138C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "<U+0010><U+0002>ȁ<U+0001>월 <U+0010><U+0002>ȁ<U+0002>일이라면...\n오늘이네요!?<U+0010><U+0001>븁\n금방 준비할 테니\n잠시만 기다려 주세요!",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 1848,
      "rawDecodedUtf16Hex": "0010000202010001C6D400200010000202010002C77CC774B77CBA74002E002E002E000AC624B298C774B124C6940021003F00100001BE01000AAE08BC290020C900BE44D5600020D14CB2C8000AC7A0C2DCB9CC0020AE30B2E4B8240020C8FCC138C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
