      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "다음에는 이길 수 있도록\n포켓몬과 기술을 점검하자!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 2752,
      "rawDecodedUtf16Hex": "B2E4C74CC5D0B2940020C774AE380020C2180020C788B3C4B85D000AD3ECCF13BAACACFC0020AE30C220C7440020C810AC80D558C79000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
