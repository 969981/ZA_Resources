      "offsetInSection": 3120,
      "rawDecodedUtf16Hex": "004200650068002E002E002E00200069006E00200065006600660065007400740069002E002E002E001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "È il luogo ideale per una sauna, ma non è facile\narrivarci.<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 3172,
      "rawDecodedUtf16Hex": "00C800200069006C0020006C0075006F0067006F00200069006400650061006C0065002000700065007200200075006E00610020007300610075006E0061002C0020006D00610020006E006F006E002000E800200066006100630069006C0065000A006100720072006900760061007200630069002E001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
