      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Non sarà che... gli piace la Sauna Camerupt?!<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
