      "rawDecodedUtf16Hex": "005000610074002000700061007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Sembrano molto contenti, eh?<U+0010><U+0002>Ĕś",
