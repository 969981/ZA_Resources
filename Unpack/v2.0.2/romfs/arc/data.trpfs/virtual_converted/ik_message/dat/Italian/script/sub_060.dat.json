      "offsetInSection": 2340,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ok, ho perso... Ma l’atmosfera si è scaldata\nal punto giusto. Proprio quello che mi serviva...<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "La Sauna Camerupt può aprire i battenti!<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "004C00610020005300610075006E0061002000430061006D0065007200750070007400200070007500F2002000610070007200690072006500200069002000620061007400740065006E007400690021001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Scalderemo questo posto con il magma che\nCamerupt conserva nelle gobbe a una<U+0010><U+0001>븀\ntemperatura di 10.000 ºC.<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 4,
      "flagsUpper16": 8,
      "index": 24,
      "offsetInSection": 2644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Avremo così il calore ideale per la Sauna\nCamerupt! Sarà un successo garantito!<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 2864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
