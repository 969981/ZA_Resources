      "escapedControlUnits": 0,
      "flagsUpper16": 8,
      "index": 30,
      "offsetInSection": 3300,
      "rawDecodedUtf16Hex": "00530063007200610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
