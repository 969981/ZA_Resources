    },
    {
      "displayText": "¿Quieres enfrentarte al superdesafío de\nmegaevolución descontrolada?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4164,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200065006E006600720065006E0074006100720074006500200061006C0020007300750070006500720064006500730061006600ED006F002000640065000A006D00650067006100650076006F006C00750063006900F3006E00200064006500730063006F006E00740072006F006C006100640061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Sí",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 4304,
      "rawDecodedUtf16Hex": "005300ED0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Explícame de qué se trata",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 57,
      "offsetInSection": 4312,
      "rawDecodedUtf16Hex": "004500780070006C00ED00630061006D006500200064006500200071007500E90020007300650020007400720061007400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Comprobar récord",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 4364,
      "rawDecodedUtf16Hex": "0043006F006D00700072006F0062006100720020007200E90063006F007200640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Ahora no",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 59,
      "offsetInSection": 4400,
      "rawDecodedUtf16Hex": "00410068006F007200610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "El <U+0010><U+0002>＀<U+0006>superdesafío <U+0010><U+0002>＀<U+0000>consiste en enfrentarse a todos\nlos Pokémon descontrolados seguidos.<U+0010><U+0001>븁\nNo puedes cambiar a los Pokémon de tu equipo\ny, si pierdes un combate, perderás el desafío.<U+0010><U+0001>븁\nPuedes curar a tus Pokémon entre combates,\npero solo un máximo de tres veces.<U+0010><U+0001>븁\nRegistraremos tu número de victorias y, si logras\nvencerlos a todos, también tu tiempo.",
      "escapedControlUnits": 12,
      "flagsUpper16": 4,
      "index": 60,
      "offsetInSection": 4420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 360
    },
    {
      "displayText": "Es un desafío de armas tomar. ¿Lo aceptas?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 61,
      "offsetInSection": 5140,
      "rawDecodedUtf16Hex": "0045007300200075006E00200064006500730061006600ED006F002000640065002000610072006D0061007300200074006F006D00610072002E002000BF004C006F00200061006300650070007400610073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Sí",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 5228,
      "rawDecodedUtf16Hex": "005300ED0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Mejor no",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5236,
      "rawDecodedUtf16Hex": "004D0065006A006F00720020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¿Quieres enfrentarte al siguiente Pokémon?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 5256,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200065006E006600720065006E0074006100720074006500200061006C0020007300690067007500690065006E0074006500200050006F006B00E9006D006F006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Sí",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 5344,
      "rawDecodedUtf16Hex": "005300ED0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Quiero curar a mi equipo",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 5352,
      "rawDecodedUtf16Hex": "00510075006900650072006F002000630075007200610072002000610020006D0069002000650071007500690070006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Quiero abandonar",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 5404,
      "rawDecodedUtf16Hex": "00510075006900650072006F0020006100620061006E0064006F006E006100720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Ahora mismo puedes curar a tu equipo <U+0010><U+0002>Ȁ<U+0003> ve<U+0010><U+0003>ᄁ<U+0003>́zces.\n¿Quieres hacerlo?",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 68,
      "offsetInSection": 5440,
      "rawDecodedUtf16Hex": "00410068006F007200610020006D00690073006D006F002000700075006500640065007300200063007500720061007200200061002000740075002000650071007500690070006F0020001000020200000300200076006500100003110100030301007A006300650073002E000A00BF0051007500690065007200650073002000680061006300650072006C006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Sí, por favor",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 5588,
      "rawDecodedUtf16Hex": "005300ED002C00200070006F00720020006600610076006F00720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "No hace falta",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 5616,
      "rawDecodedUtf16Hex": "004E006F00200068006100630065002000660061006C007400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Si abandonas, tu progreso quedará registrado,\npero tendrás que empezar de cero la próxima vez.<U+0010><U+0001>븁\n¿Seguro que quieres abandonar?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 5644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "Una pena. Espero que vuelvas a intentar\nel desafío en otra ocasión.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 72,
      "offsetInSection": 5904,
      "rawDecodedUtf16Hex": "0055006E0061002000700065006E0061002E002000450073007000650072006F00200071007500650020007600750065006C0076006100730020006100200069006E00740065006E007400610072000A0065006C00200064006500730061006600ED006F00200065006E0020006F0074007200610020006F006300610073006900F3006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Has logrado derrotar a <U+0010><U+0002>ȁ<U+0004> Pokémon. Espero que\nconsigas batir tu récord la próxima ocasión.",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "¡Tu récord es <U+0010><U+0002>ȁ<U+0005>:<U+0010><U+0002>ȁ<U+0006>:<U+0010><U+0002>ȁ<U+0007>,<U+0010><U+0002>ȁ<U+0008>!",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 6228,
      "rawDecodedUtf16Hex": "00A1005400750020007200E90063006F0072006400200065007300200010000202010005003A0010000202010006003A0010000202010007002C001000020201000800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Has logrado derrotar a <U+0010><U+0002>ȁ<U+0004> Pokémon.",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 6300,
      "rawDecodedUtf16Hex": "0048006100730020006C006F0067007200610064006F00200064006500720072006F007400610072002000610020001000020201000400200050006F006B00E9006D006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Madre mía, ¿has logrado vencerlos a todos?\nEres impresionante, ¡enhorabuena!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 6376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Has completado el desafío en un total de\n<U+0010><U+0002>ȁ<U+0005> h, <U+0010><U+0002>ȁ<U+0006> min y <U+0010><U+0002>ȁ<U+0007>,<U+0010><U+0002>ȁ<U+0008> s.",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 6532,
      "rawDecodedUtf16Hex": "00480061007300200063006F006D0070006C0065007400610064006F00200065006C00200064006500730061006600ED006F00200065006E00200075006E00200074006F00740061006C002000640065000A001000020201000500200068002C002000100002020100060020006D0069006E0020007900200010000202010007002C001000020201000800200073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Espero que vuelvas por aquí a usar el simulador\nde nuevo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 78,
