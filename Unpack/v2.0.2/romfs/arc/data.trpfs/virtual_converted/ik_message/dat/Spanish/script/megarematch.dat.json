    },
    {
      "displayText": "He venido a traerle un café a Airén, pero está tan\nocupado que me ha ordenado encargarme del<U+0010><U+0001>븀\nsimulador en su lugar.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "¿A qué megaevolución descontrolada quieres\nenfrentarte en el simulador?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2576,
      "rawDecodedUtf16Hex": "00BF004100200071007500E90020006D00650067006100650076006F006C00750063006900F3006E00200064006500730063006F006E00740072006F006C00610064006100200071007500690065007200650073000A0065006E006600720065006E0074006100720074006500200065006E00200065006C002000730069006D0075006C00610064006F0072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "¿Qué? ¿Te apetece enfrentarte a otra\nmegaevolución descontrolada?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2720,
      "rawDecodedUtf16Hex": "00BF0051007500E9003F002000BF005400650020006100700065007400650063006500200065006E006600720065006E00740061007200740065002000610020006F007400720061000A006D00650067006100650076006F006C00750063006900F3006E00200064006500730063006F006E00740072006F006C006100640061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Así que a <U+0010><U+0002>ā<U+0002>, ¿eh? ¿Todo listo?",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 42,
      "offsetInSection": 2852,
      "rawDecodedUtf16Hex": "0041007300ED00200071007500650020006100200010000201010002002C002000BF00650068003F002000BF0054006F0064006F0020006C006900730074006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ahora mismo, tu mejor tiempo contra\n<U+0010><U+0002>ā<U+0002><U+0010><U+0001>븀\nes de <U+0010><U+0002>ȁ<U+0003> min, <U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005> s.<U+0010><U+0001>븁\n¿Estás preparad<U+0010><U+0003>ᄀÿāoa?",
      "escapedControlUnits": 21,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "¡Impresionante! Has conseguido derrotarlo en\nsolo <U+0010><U+0002>ȁ<U+0003> min, <U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005> s.",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 3128,
      "rawDecodedUtf16Hex": "00A10049006D00700072006500730069006F006E0061006E007400650021002000480061007300200063006F006E007300650067007500690064006F00200064006500720072006F007400610072006C006F00200065006E000A0073006F006C006F002000100002020100030020006D0069006E002C00200010000202010004002C001000020201000500200073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "¡Enhorabuena! Has batido el anterior récord.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 3276,
      "rawDecodedUtf16Hex": "00A10045006E0068006F00720061006200750065006E006100210020004800610073002000620061007400690064006F00200065006C00200061006E0074006500720069006F00720020007200E90063006F00720064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Toma, aquí tienes la recompensa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 3368,
      "rawDecodedUtf16Hex": "0054006F006D0061002C002000610071007500ED0020007400690065006E006500730020006C00610020007200650063006F006D00700065006E00730061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "No te preocupes si pierdes, es solo\nuna simulación.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 3436,
      "rawDecodedUtf16Hex": "004E006F0020007400650020007000720065006F0063007500700065007300200073006900200070006900650072006400650073002C00200065007300200073006F006C006F000A0075006E0061002000730069006D0075006C00610063006900F3006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Vuelve por aquí cuando te apetezca poner a\nprueba tus habilidades.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 3540,
      "rawDecodedUtf16Hex": "005600750065006C0076006500200070006F0072002000610071007500ED0020006300750061006E0064006F002000740065002000610070006500740065007A0063006100200070006F006E0065007200200061000A007000720075006500620061002000740075007300200068006100620069006C006900640061006400650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Hemos añadido nuevos Pokémon al simulador\nde megaevolución descontrolada.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 3676,
      "rawDecodedUtf16Hex": "00480065006D006F00730020006100F10061006400690064006F0020006E007500650076006F007300200050006F006B00E9006D006F006E00200061006C002000730069006D0075006C00610064006F0072000A006400650020006D00650067006100650076006F006C00750063006900F3006E00200064006500730063006F006E00740072006F006C006100640061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "¡Enhorabuena! Ahora tienes a tu disposición\nel modo superdesafío.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 3824,
      "rawDecodedUtf16Hex": "00A10045006E0068006F00720061006200750065006E00610021002000410068006F007200610020007400690065006E006500730020006100200074007500200064006900730070006F007300690063006900F3006E000A0065006C0020006D006F0064006F0020007300750070006500720064006500730061006600ED006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
