      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "00560061006C0065002C00200063006F006E00740072006100200010000201010002002C002000BF007600650072006400610064003F000A00BF00450073007400E1007300200070007200650070006100720061006400100003110000FF0101006F0061003F001000020114000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Tu mejor tiempo contra <U+0010><U+0002>ā<U+0002> es de\n<U+0010><U+0002>ȁ<U+0003> min<U+0010><U+0001>븀\n<U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005> s.<U+0010><U+0001>븀\n¿Estás preparad<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 24,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
