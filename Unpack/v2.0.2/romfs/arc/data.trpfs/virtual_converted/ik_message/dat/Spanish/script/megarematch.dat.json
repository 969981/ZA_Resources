    },
    {
      "displayText": "Vale, contra <U+0010><U+0002>ā<U+0002>, ¿verdad?\n¿Estás preparad<U+0010><U+0003>ᄀÿāoa?<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 8,
