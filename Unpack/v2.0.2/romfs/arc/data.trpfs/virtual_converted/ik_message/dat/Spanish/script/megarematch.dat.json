      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1580,
      "rawDecodedUtf16Hex": "004E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "¡Bien hecho!\nHas tardado <U+0010><U+0002>ȁ<U+0003> min <U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005> s.<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 12,
