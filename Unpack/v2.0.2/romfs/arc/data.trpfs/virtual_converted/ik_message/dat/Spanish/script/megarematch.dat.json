      "offsetInSection": 1588,
      "rawDecodedUtf16Hex": "00A1004200690065006E00200068006500630068006F0021000A0048006100730020007400610072006400610064006F002000100002020100030020006D0069006E00200010000202010004002C001000020201000500200073002E001000020114000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "¡Fantástico! ¡Un nuevo récord!<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1692,
