      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Por favor, acepta esta recompensa.<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "0050006F00720020006600610076006F0072002C0020006100630065007000740061002000650073007400610020007200650063006F006D00700065006E00730061002E001000020114000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Lo bueno de las simulaciones es que sales sin\nun solo rasguño aunque pierdas.<U+0010><U+0001>븁\nBueno, salvo la herida emocional...<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 5,
