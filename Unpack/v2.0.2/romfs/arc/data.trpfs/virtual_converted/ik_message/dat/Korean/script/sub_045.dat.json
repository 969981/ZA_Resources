      "rawDecodedUtf16Hex": "AC38C544C544C544002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "가보리들이\n맛있게 먹고 있잖아!<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
