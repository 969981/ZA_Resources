      "rawDecodedUtf16Hex": "8981548C621164C5957F56DE590D004800507684000A5B9D53EF68A64EEC5BF962185417FF1F00100002011401670000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "要！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "8981FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "还是算了",
