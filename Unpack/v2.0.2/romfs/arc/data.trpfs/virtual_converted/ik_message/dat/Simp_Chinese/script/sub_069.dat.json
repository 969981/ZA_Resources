      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "怎么样？要和我擅长回复HP的\n宝可梦们对战吗？<U+0010><U+0002>Ĕŧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "600E4E486837FF1F8981548C621164C5957F56DE590D004800507684000A5B9D53EF68A64EEC5BF962185417FF1F00100002011401670000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "要打宝可梦对战的话，\n就来找我哦。<U+0010><U+0002>Ĕŧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 376,
      "rawDecodedUtf16Hex": "898162535B9D53EF68A65BF9621876848BDDFF0C000A5C316765627E621154E6300200100002011401670000",
      "trailingZeroPaddingUnits": 1,
