      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "也就是能回复\n宝可梦的HP的招式！<U+0010><U+0002>Ĕŧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
