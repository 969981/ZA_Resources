      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "嗶耶嗶耶！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "55F6803655F68036FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "涼脊龍……\n你怎麼發出這麼大的聲音？<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "6DBC810A9F8D20262026000A4F60600E9EBC767C51FA90199EBC59277684807297F3FF1F00100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "涼脊龍的感受呢？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
