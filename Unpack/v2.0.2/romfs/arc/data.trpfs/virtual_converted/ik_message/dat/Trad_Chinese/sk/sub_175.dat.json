      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "啊，好的……\n那個……請多多指教。<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 3352,
      "rawDecodedUtf16Hex": "554AFF0C597D768420262026000A90A3500B202620268ACB591A591A63076559300200100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "嗶耶！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
