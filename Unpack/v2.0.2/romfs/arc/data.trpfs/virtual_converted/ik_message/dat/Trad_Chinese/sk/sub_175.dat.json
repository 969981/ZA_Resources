      "rawDecodedUtf16Hex": "55F68036FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>……\n怎、怎麼辦……<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
