      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "唰冰～！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 3540,
      "rawDecodedUtf16Hex": "553051B0FF5EFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "就算訓練家彼此不交談，\n寶可夢們高興的話就夠讚了，對吧。<U+0010><U+0002>ĔǑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 3552,
