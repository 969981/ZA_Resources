      "rawDecodedUtf16Hex": "55EFFF5E2026202696D671365F884E0D597D610F601DFF0C000A4F4662118981653E68C45E6B6DBC810A9F8D4EA4670B53CB4E86300200100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "謝謝<U+0010><U+0003>ᄀÿā你妳代替\n內向的我做出行動。<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 47,
