      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "6DBC810A9F8D7684611F53D75462FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "妳喜歡涼脊龍嗎？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 2732,
      "rawDecodedUtf16Hex": "59B3559C6B616DBC810A9F8D55CEFF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "呃……可是……\n我很內向，話又說不好……<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 2752,
      "rawDecodedUtf16Hex": "54432026202653EF662F20262026000A62115F8851675411FF0C8A7153C88AAA4E0D597D2026202600100002011401CF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "妳是涼脊龍的訓練家對吧！\n請牠和冰寶一起玩吧。<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "59B3662F6DBC810A9F8D76848A137DF45BB65C0D5427FF01000A8ACB7260548C51B05BF64E008D7773A95427300200100002011401D00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "我太想和涼脊龍一起去露營，\n所以主動找上門了！<U+0010><U+0002>ĔǑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 2860,
      "rawDecodedUtf16Hex": "6211592A60F3548C6DBC810A9F8D4E008D7753BB973271DFFF0C000A62404EE54E3B52D5627E4E0A95804E86FF0100100002011401D10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "哦哦！我的貓鼬斬\n好像也很開心呢！<U+0010><U+0002>Ĕǒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 2916,
      "rawDecodedUtf16Hex": "54E654E6FF01621176848C939F2C65AC000A597D50CF4E5F5F88958B5FC35462FF0100100002011401D20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "唰啊！！",
