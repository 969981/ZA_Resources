      "rawDecodedUtf16Hex": "6DBC810A9F8D597D50CF5F88958B5FC354620000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "涼脊龍很積極喔",
