      "offsetInSection": 3408,
      "rawDecodedUtf16Hex": "00100002BDFF00430000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "雖然我是個內向的人，\n但那個……還請多多指教。<U+0010><U+0002>ĔǏ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 3420,
