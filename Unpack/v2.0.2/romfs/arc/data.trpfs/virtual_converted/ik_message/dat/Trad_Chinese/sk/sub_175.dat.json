      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "嗶耶！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 3476,
      "rawDecodedUtf16Hex": "55F68036FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "讓我們聊聊寶可夢的話題，\n互相認識認識吧！<U+0010><U+0002>Ĕǐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
