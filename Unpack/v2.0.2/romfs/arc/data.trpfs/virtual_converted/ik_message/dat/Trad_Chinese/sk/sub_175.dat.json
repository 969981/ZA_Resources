      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "就算訓練家彼此不交談，\n寶可夢們高興的話就夠讚了，對吧。<U+0010><U+0002>ĔǑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 3212,
      "rawDecodedUtf16Hex": "5C317B978A137DF45BB65F7C6B644E0D4EA48AC7FF0C000A5BF653EF592250119AD8820876848A715C3159208B9A4E86FF0C5C0D5427300200100002011401D10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "我會跟妳誇耀我的貓鼬斬的，\n所以請妳跟我說說涼脊龍的優點吧。<U+0010><U+0002>Ĕǒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
