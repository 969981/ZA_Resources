      "rawDecodedUtf16Hex": "00A100410061006100680021002000A10055006E00100003110000FF09070020006C00610064007200F3006E00610020006C006100640072006F006E0061002100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
