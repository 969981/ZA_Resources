      "rawDecodedUtf16Hex": "00A100100003110000FF0A090045006C0020006C00610064007200F3006E004C00610020006C006100640072006F006E006100200073006F00620072006500700061007300F300200065006C00200063006F0072006400F3006E00200070006F006C0069006300690061006C002100100002011401CD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
