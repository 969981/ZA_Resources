      "offsetInSection": 5660,
      "rawDecodedUtf16Hex": "00100002BDFF002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Estuvo bien, pero seguro que nos van a dar un\nbuen regaño cuando presentemos el informe...<U+0010><U+0002>ĔǍ",
