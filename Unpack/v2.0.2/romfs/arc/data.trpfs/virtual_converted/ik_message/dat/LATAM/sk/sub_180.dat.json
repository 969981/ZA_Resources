      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "¡Se dirige hacia las prendas de los antiguos\nsinnohítas del primer piso!<U+0010><U+0002>Ĕ#",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4164,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
