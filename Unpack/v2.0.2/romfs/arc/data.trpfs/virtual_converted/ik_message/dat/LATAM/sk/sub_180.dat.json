      "rawDecodedUtf16Hex": "00100002BDFF002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Te robaste el atuendo de los antiguos sinnohítas.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 5184,
