      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5032,
      "rawDecodedUtf16Hex": "00A1005300650020006100630061006200610072006F006E0020006C006F0073002000730069006D0075006C006100630072006F00730021002000A10054006500200064006500730061006600ED006F00200061000A0075006E00200063006F006D00620061007400650020006400650020007600650072006400610064002100100002011401CD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
