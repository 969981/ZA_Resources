      "index": 35,
      "offsetInSection": 4536,
      "rawDecodedUtf16Hex": "00100002BDFF00230000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Detente de inmediato! ¡Quedas arrestad<U+0010><U+0003>ᄀÿāoa por\ntentativa de robo!<U+0010><U+0002>ĔǍ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
