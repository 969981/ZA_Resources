      "rawDecodedUtf16Hex": "00100002BDFF00250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡<U+0010><U+0003>ᄀÿਉEl ladrónLa ladrona sobrepasó el cordón policial!<U+0010><U+0002>ĔǍ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
