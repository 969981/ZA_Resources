      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "00100002BDFF00040000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "나 대신 가게를 맡아 주지 않을래?<U+0010><U+0002>Ĕǂ",
