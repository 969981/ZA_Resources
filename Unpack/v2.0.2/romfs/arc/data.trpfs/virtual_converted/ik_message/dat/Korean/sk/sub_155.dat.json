      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "C88BC544C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "지금은 좀...",
