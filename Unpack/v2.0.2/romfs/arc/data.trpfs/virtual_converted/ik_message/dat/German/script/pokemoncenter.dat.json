      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "004E00650069006E002C002000640061002000680061007400200073006900630068002000650069006E0020004600650068006C00650072002000650069006E00670065007300630068006C0069006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Ich hab’s mir anders überlegt...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
