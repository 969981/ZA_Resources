      "rawDecodedUtf16Hex": "00470065006E00610075002C00200064006100730020007300740069006D006D007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Nein, da hat sich ein Fehler eingeschlichen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
