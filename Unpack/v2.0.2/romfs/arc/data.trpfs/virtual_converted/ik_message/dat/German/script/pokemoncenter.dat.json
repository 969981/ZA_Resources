      "index": 36,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Dein Geburtstag ist also am <U+0010><U+0002>ȁ<U+0002>.<U+0010><U+0002>ȁ<U+0001>., richtig?",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
