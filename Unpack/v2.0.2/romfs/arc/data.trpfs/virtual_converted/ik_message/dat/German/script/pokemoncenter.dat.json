      "rawDecodedUtf16Hex": "0053006100670020006D0061006C002C0020006D00F60063006800740065007300740020006400750020006400650069006E0065006E00200047006500620075007200740073007400610067002000620065006900200075006E0073000A00720065006700690073007400720069006500720065006E0020006C0061007300730065006E002C00200010000201000000003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Das Datum kann nicht mehr geändert werden,\nalso pass gut auf bei der Eingabe!",
      "escapedControlUnits": 0,
