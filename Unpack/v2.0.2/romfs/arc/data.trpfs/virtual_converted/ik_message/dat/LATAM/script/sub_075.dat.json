      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "¡Sáquenme de aquí!<U+0010><U+0001>븁\n¡Debe haber algún ataque Pokémon que sea lo\nsuficientemente fuerte para romper esta maraña!<U+0010><U+0002>Ĕ<U+0004>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Alguien se quedó atrapado en un saco de hilo\nde Pokémon.<U+0010><U+0001>븁\nUsa un movimiento Pokémon con suficiente\npotencia para romper el hilo y rescatarlo.",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
