      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1456,
      "rawDecodedUtf16Hex": "0046007500650072006F006E00200065006C006C006F0073002E001000020114016D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Estos tres son mis Spinarak.<U+0010><U+0002>Ĕŭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1492,
