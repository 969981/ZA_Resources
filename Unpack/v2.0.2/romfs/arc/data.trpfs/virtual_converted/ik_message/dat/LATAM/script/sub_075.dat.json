      "offsetInSection": 872,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Usa un movimiento más fuerte, por favor!<U+0010><U+0001>븁\nSi quieres comprobar la fuerza de un movimiento,\nabre el menú principal, selecciona al Pokémon<U+0010><U+0001>븀\ny elige \"Gestionar movimientos\".<U+0010><U+0002>Ĕ<U+0004>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 884,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 180
    },
    {
      "displayText": "¡Uf, menos mal!<U+0010><U+0002>Ĕŭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "00A100550066002C0020006D0065006E006F00730020006D0061006C0021001000020114016D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "¡Me salvaste el pellejo! ¡Gracias por ayudarme!<U+0010><U+0002>Ĕŭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "00A1004D0065002000730061006C0076006100730074006500200065006C002000700065006C006C0065006A006F0021002000A1004700720061006300690061007300200070006F00720020006100790075006400610072006D00650021001000020114016D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "¿Qué te pasó?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1388,
      "rawDecodedUtf16Hex": "00BF0051007500E9002000740065002000700061007300F3003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "¿Quién te hizo eso?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
