      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "00BF00510075006900E9006E002000740065002000680069007A006F002000650073006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Fueron ellos.<U+0010><U+0002>Ĕŭ",
