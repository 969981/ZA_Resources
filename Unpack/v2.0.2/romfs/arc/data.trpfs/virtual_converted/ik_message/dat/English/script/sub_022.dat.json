      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Ahem. I suppose you must have heard me talking\nrather loudly to myself there...<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 248,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
