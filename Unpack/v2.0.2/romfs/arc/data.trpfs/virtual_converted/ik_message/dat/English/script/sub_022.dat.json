      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1048,
      "rawDecodedUtf16Hex": "004C006500740020006D00650020006B006E006F00770020007700680065006E00200079006F007520190072006500200072006500610064007900200074006F0020006800610076006500200061002000730069007A007A006C0069006E0067000A0068006F007400200050006F006B00E9006D006F006E00200062006100740074006C00650021001000020114013B0000",
      "trailingZeroPaddingUnits": 1,
