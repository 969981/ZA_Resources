      "rawDecodedUtf16Hex": "005400690065006E00730020003F0020004E00650020007300650072006100690073002D007400750020007000610073002000100002010000000020003F000A004400650020006C00610020005400650061006D0020004D005A0020003F00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "En effet.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "0045006E002000650066006600650074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Je suis son sosie.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 600,
      "rawDecodedUtf16Hex": "004A00650020007300750069007300200073006F006E00200073006F007300690065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "J’en étais sûr !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "004A20190065006E002000E900740061006900730020007300FB00720020002100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Je comprends. Moi aussi je me ferais passer\npour mon sosie, si j’étais aussi célèbre que toi.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "J’imagine que tu es très occupé<U+0010><U+0003>ᄀÿĀe, mais\nest-ce que tu pourrais m’accorder un moment ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Je suis romancier. Je n’ai pas encore rencontré\nle succès, mais je sens que ça y est...<U+0010><U+0001>븁\nJe tiens une bonne idée pour mon prochain\nmanuscrit !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 149
    },
    {
      "displayText": "Mais j’ai un problème : je ne suis pas satisfait\nde mes personnages.<U+0010><U+0001>븁\nJ’ai donc pensé que quelqu’un d’aussi connu\nque toi pourrait m’aider à trouver l’inspiration.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 170
    },
    {
      "displayText": "Concrètement, j’aurais besoin que tu me montres\nune équipe composée sur mesure.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "D’abord, un Pokémon de type Sol.\nEnsuite, un Pokémon qui connaît Lance-Flammes.<U+0010><U+0001>븀\nEnfin, un Pokémon qui porte une Méga-Gemme.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 131
    },
    {
      "displayText": "Une telle équipe devrait me permettre de mieux\nvisualiser mes personnages.<U+0010><U+0001>븁\nRassemble-la et viens me la montrer !\nSi tu veux, je peux te répéter la composition.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 2140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 167
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2476,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Peux-tu me montrer les trois Pokémon\ndont j’ai besoin pour écrire mon roman ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Ils sont avec moi !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 2652,
      "rawDecodedUtf16Hex": "0049006C007300200073006F006E0074002000610076006500630020006D006F0069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Rappelez-moi lesquels vous voulez voir.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2692,
      "rawDecodedUtf16Hex": "00520061007000700065006C0065007A002D006D006F00690020006C00650073007100750065006C007300200076006F0075007300200076006F0075006C0065007A00200076006F00690072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Pas maintenant.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2772,
      "rawDecodedUtf16Hex": "0050006100730020006D00610069006E00740065006E0061006E0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Je veux voir trois Pokémon...<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2804,
      "rawDecodedUtf16Hex": "004A00650020007600650075007800200076006F00690072002000740072006F0069007300200050006F006B00E9006D006F006E002E002E002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "D’abord, un Pokémon de type Sol.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2872,
      "rawDecodedUtf16Hex": "0044201900610062006F00720064002C00200075006E00200050006F006B00E9006D006F006E0020006400650020007400790070006500200053006F006C002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Ensuite, un Pokémon qui connaît Lance-Flammes.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2948,
