  "initialKey": 0,
  "messages": [
    {
      "displayText": "Tiens ? Ne serais-tu pas <U+0010><U+0002>Ā<U+0000> ?\nDe la Team MZ ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
