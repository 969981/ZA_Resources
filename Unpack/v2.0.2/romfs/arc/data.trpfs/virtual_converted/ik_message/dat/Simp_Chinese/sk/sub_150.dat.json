      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "9E64544330020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0010>",
