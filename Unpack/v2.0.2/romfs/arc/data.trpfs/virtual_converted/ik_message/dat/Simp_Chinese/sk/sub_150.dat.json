      "offsetInSection": 972,
      "rawDecodedUtf16Hex": "00100002BDFF00100000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "首先是<U+0010><U+0002>＀<U+0006>催眠术<U+0010><U+0002>＀<U+0000>！<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 8,
