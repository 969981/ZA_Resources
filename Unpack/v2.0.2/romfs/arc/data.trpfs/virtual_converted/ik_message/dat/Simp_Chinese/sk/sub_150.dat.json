      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "哇哦！你示范得太棒了！\n梦梦蚀，你今后可以做到了吧？<U+0010><U+0002>Ĕƻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1356,
