      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Quando sei pront<U+0010><U+0003>ᄀÿāoa, fammi sapere!<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 544,
      "rawDecodedUtf16Hex": "005100750061006E0064006F0020007300650069002000700072006F006E007400100003110000FF0101006F0061002C002000660061006D006D006900200073006100700065007200650021001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
