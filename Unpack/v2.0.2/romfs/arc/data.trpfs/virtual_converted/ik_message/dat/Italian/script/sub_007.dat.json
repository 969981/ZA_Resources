    },
    {
      "displayText": "Mi sto allenando per diventare l’Allenatrice di\nKakuna più brava al mondo! Vuoi lottare con me?<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
