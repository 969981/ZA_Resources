      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ti farò vedere i miei Kakuna! Sei pront<U+0010><U+0003>ᄀÿāoa a lottare?<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "00540069002000660061007200F20020007600650064006500720065002000690020006D0069006500690020004B0061006B0075006E006100210020005300650069002000700072006F006E007400100003110000FF0101006F0061002000610020006C006F00740074006100720065003F001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Sì!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "005300EC00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Aspetta!",
