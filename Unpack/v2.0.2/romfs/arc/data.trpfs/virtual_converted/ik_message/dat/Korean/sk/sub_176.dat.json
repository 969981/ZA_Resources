      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "AD6CC545002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "승부다!<U+0010><U+0002>ĔǕ",
