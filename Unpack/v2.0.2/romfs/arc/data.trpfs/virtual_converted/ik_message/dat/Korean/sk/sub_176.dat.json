      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "너에게 관동 고유의 파 놀림을 보여 주마!<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
