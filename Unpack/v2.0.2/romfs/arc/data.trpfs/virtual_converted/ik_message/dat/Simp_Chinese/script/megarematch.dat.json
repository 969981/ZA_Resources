      "offsetInSection": 2684,
      "rawDecodedUtf16Hex": "901A517365F695F4662F000A0010000202010005003A0010000202010006003A0010000202010007002E0010000202010008FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
