      "rawDecodedUtf16Hex": "662F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 2
    },
    {
      "displayText": "否",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 2424,
      "rawDecodedUtf16Hex": "54260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 2
    },
    {
