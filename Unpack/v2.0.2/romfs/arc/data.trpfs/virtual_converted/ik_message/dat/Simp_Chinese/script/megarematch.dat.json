      "rawDecodedUtf16Hex": "51FB8D25001000020201000453EAFF01000A62117B4977404F60518D6765523765B07EAA5F5530020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
