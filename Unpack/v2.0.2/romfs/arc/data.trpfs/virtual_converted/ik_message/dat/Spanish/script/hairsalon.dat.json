      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Entendido! Pasa y ponte cómod<U+0010><U+0003>ᄀÿāoa mientras lo\npreparo todo.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 87,
