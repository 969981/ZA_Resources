      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "¿Estás segur<U+0010><U+0003>ᄀÿāoa? Es parecido a lo que ya tenías.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 98,
      "offsetInSection": 3404,
      "rawDecodedUtf16Hex": "00BF00450073007400E1007300200073006500670075007200100003110000FF0101006F0061003F00200045007300200070006100720065006300690064006F002000610020006C006F0020007100750065002000790061002000740065006E00ED00610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "¡Menudo cambio! Te sienta genial.\n¿Te parece bien así, entonces?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 99,
      "offsetInSection": 3512,
