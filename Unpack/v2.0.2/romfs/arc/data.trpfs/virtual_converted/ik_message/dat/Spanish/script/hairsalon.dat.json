      "rawDecodedUtf16Hex": "00500075006500730020006D006500200070006F006E0067006F0020006D0061006E006F0073002000610020006C00610020006F006200720061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
