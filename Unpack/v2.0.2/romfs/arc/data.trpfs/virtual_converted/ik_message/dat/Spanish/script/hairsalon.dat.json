      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "¡Hola, bienvenid<U+0010><U+0003>ᄀÿāoa! ¿Qué te apetece hoy?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 86,
