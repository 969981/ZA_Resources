      "rawDecodedUtf16Hex": "00A10045006E00740065006E006400690064006F0021002000500061007300610020007900200070006F006E007400650020006300F3006D006F006400100003110000FF0101006F00610020006D00690065006E00740072006100730020006C006F000A007000720065007000610072006F00200074006F0064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Verás... Es que no tienes suficiente dinero...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 88,
      "offsetInSection": 2312,
      "rawDecodedUtf16Hex": "00560065007200E10073002E002E002E00200045007300200071007500650020006E006F0020007400690065006E0065007300200073007500660069006300690065006E00740065002000640069006E00650072006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Verás... Es que no tienes suficientes puntos de\nliga...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 89,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "00560065007200E10073002E002E002E00200045007300200071007500650020006E006F0020007400690065006E0065007300200073007500660069006300690065006E007400650073002000700075006E0074006F0073002000640065000A006C006900670061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "¡Pues ya está!\nDiría que te queda de maravilla, ¿a que sí?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 90,
      "offsetInSection": 2520,
      "rawDecodedUtf16Hex": "00A10050007500650073002000790061002000650073007400E10021000A00440069007200ED006100200071007500650020007400650020007100750065006400610020006400650020006D00610072006100760069006C006C0061002C002000BF006100200071007500650020007300ED003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "¡Gracias por tu visita!\nEsperamos volver a verte pronto.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 91,
      "offsetInSection": 2640,
      "rawDecodedUtf16Hex": "00A1004700720061006300690061007300200070006F007200200074007500200076006900730069007400610021000A004500730070006500720061006D006F007300200076006F006C00760065007200200061002000760065007200740065002000700072006F006E0074006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¿Quieres ponerte lo que llevabas en la cabeza?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 92,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200070006F006E00650072007400650020006C006F00200071007500650020006C006C00650076006100620061007300200065006E0020006C006100200063006100620065007A0061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "¡Vale! A ver, un segundito...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
