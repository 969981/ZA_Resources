      "offsetInSection": 2852,
      "rawDecodedUtf16Hex": "00A100560061006C00650021002000410020007600650072002C00200075006E00200073006500670075006E006400690074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "¡Vale! Te lo guardo en la Bolsa, entonces.",
      "escapedControlUnits": 0,
