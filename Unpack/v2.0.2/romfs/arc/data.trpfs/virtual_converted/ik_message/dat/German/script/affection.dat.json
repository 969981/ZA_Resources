      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Du und dein <U+0010><U+0002>ā<U+0001>, ich bin sicher,\nihr könntet<U+0010><U+0001>븀\neuch<U+0010><U+0001>븀\nnoch<U+0010><U+0001>븀\nbesser<U+0010><U+0001>븀\nverstehen!",
