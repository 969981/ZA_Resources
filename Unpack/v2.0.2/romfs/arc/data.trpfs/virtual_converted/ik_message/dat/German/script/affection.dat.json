      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "00490068007200200076006500720073007400650068007400200065007500630068002000670061006E007A0020006700750074002C0020006100620065007200200064006100200069007300740020006E006F00630068000A004C0075006600740020006E0061006300680020006F00620065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
