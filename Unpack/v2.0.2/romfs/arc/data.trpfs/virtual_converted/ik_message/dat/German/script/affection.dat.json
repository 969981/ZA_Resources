      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "004E00610020006A0061002E002E002E002000440061007300200045006900730020006D00750073007300200077006F0068006C002000650072007300740020006E006F0063006800200067006500620072006F006300680065006E000A00770065007200640065006E002C0020006F006400650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
