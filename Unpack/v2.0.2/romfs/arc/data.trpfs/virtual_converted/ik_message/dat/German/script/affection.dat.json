      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1268,
      "rawDecodedUtf16Hex": "0044006F00630068002C002000690063006800200073006500680065002000640061002000650069006E0020006700650077006900730073006500730020005A007500740072006100750065006E0021000A00440061007300200069007300740020006A00610020007300630068006F006E0020006D0061006C0020007700610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
