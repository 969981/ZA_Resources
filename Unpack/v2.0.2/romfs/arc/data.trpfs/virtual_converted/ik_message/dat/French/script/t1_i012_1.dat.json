      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "004500740020006C0061002000730061006C006C00650020006420190065006E00740072006100EE006E0065006D0065006E00740020006500730074000A006A0075007300740065002000660061006E002D007400610073002D00740069007100750065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
