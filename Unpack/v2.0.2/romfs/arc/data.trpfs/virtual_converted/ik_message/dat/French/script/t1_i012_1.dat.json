      "rawDecodedUtf16Hex": "004200690065006E00760065006E007500650020006100750020004700720061006E00640020004800F400740065006C000A004C006500200043007200E9007300750073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
