  "messages": [
    {
      "displayText": "Bienvenue au Grand Hôtel Le Crésus.\nIci, nos prestations sont irréprochables !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 188,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Dame Violine a raison.<U+0010><U+0001>븁\nUn grand pouvoir implique d’offrir un moment\nde joie aux Pokémon et à leurs partenaires !",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "C’est son rêve de faire d’Illumis la ville parfaite\npour tout le monde !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 580,
      "rawDecodedUtf16Hex": "0043201900650073007400200073006F006E0020007200EA007600650020006400650020006600610069007200650020006420190049006C006C0075006D006900730020006C0061002000760069006C006C0065002000700061007200660061006900740065000A0070006F0075007200200074006F007500740020006C00650020006D006F006E00640065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Dame Violine et la FRIM sont des\nphares qui guident Illumis !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "00440061006D0065002000560069006F006C0069006E00650020006500740020006C00610020004600520049004D00200073006F006E00740020006400650073000A0070006800610072006500730020007100750069002000670075006900640065006E007400200049006C006C0075006D00690073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "C’est grâce à Mademoiselle\nCélestine qu’on se sent si bien ici.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 852,
      "rawDecodedUtf16Hex": "0043201900650073007400200067007200E200630065002000E00020004D006100640065006D006F006900730065006C006C0065000A004300E9006C0065007300740069006E00650020007100752019006F006E002000730065002000730065006E00740020007300690020006200690065006E0020006900630069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "La concierge donne des plans de\nla ville. Idéal pour se balader !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "004C006100200063006F006E00630069006500720067006500200064006F006E006E0065002000640065007300200070006C0061006E0073002000640065000A006C0061002000760069006C006C0065002E00200049006400E90061006C00200070006F00750072002000730065002000620061006C0061006400650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "J’suis pas venu jouer au touriste, moi !\nJe veux faire des combats !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "004A201900730075006900730020007000610073002000760065006E00750020006A006F00750065007200200061007500200074006F007500720069007300740065002C0020006D006F006900200021000A004A006500200076006500750078002000660061006900720065002000640065007300200063006F006D0062006100740073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Il y a même un salon de toilettage,\nc’est dingue-han !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 7,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "0049006C00200079002000610020006D00EA006D006500200075006E002000730061006C006F006E00200064006500200074006F0069006C006500740074006100670065002C000A00632019006500730074002000640069006E006700750065002D00680061006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
