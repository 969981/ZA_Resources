      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "004E006F006E002C0020007300690020006C201900610075007400720065002000660069006C006C00650020006E006F00750073002000740072006F007500760065002C0020006F006E000A00760061002000700061007300730065007200200075006E002000730061006C006500200071007500610072007400200064201900680065007500720065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Comment allez-vous entraîner votre prochain\nPokémon principal, très chère ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "J’hésite encore, très chère.<U+0010><U+0001>븁\nDevrais-je lui apprendre des capacités variées\nou le spécialiser contre un type particulier ?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
