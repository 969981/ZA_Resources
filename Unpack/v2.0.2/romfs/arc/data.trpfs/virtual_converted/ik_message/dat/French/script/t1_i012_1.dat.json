      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2144,
      "rawDecodedUtf16Hex": "004D0065007300200061006D006900730020006D2019006F006E0074002000640065006D0061006E006400E90020006400650020006C006500750072000A00720061006D0065006E0065007200200070006C00650069006E00200064006500200073006F007500760065006E006900720073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Viens, on s’incruste à la fête\nde la FRIM !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "005600690065006E0073002C0020006F006E0020007320190069006E006300720075007300740065002000E00020006C00610020006600EA00740065000A006400650020006C00610020004600520049004D002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
