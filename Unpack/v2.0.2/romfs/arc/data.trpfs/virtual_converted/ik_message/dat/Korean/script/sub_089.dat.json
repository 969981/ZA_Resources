      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "꽃의 색은\n빨간 꽃, 노란 꽃,<U+0010><U+0001>븀\n오렌지색 꽃, 파란 꽃,<U+0010><U+0001>븀\n그리고 하얀 꽃으로 총 5종류가 있어.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 552,
