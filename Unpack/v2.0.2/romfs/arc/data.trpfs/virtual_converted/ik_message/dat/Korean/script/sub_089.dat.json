      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "난 5종류의 플라베베를\n모두 보고 싶어!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 680,
