      "rawDecodedUtf16Hex": "84DD9E264E5F4F1A9AD8517476840000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "我可以再拜托你一件事吗？\n请和我的蓝鸦对战吧！<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
