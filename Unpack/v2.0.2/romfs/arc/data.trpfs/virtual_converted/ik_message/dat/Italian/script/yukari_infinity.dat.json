      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Il suo record attuale è di <U+0010><U+0003>ȅ<U+0002>. vittori<U+0010><U+0003>ᄁ<U+0002>āae\nconsecutiv<U+0010><U+0003>ᄁ<U+0002>āae!<U+0010><U+0002>Ĕ<U+0015>",
