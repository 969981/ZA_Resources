      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Che amarezza... Speravo che il nostro tempo\ninsieme potesse continuare all’infinito, e invece<U+0010><U+0001>븀\nfinisce qui...<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 5,
