      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Allora... dilettiamoci in questa lotta nº <U+0010><U+0003>ȅ<U+0002>.!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
