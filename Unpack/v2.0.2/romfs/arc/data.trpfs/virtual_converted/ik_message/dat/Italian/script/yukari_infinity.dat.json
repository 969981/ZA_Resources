      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "In qualunque momento si sentirà pront<U+0010><U+0003>ᄀÿāoa,\ntorni da me!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
