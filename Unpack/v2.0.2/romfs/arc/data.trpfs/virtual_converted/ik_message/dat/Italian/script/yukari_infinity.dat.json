      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Splendido! Allora procediamo con la prossima\nsfida!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 8,
      "index": 11,
      "offsetInSection": 1796,
