      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "上吧，皮卡丘！\n展示出世界最强的力量吧！<U+0010><U+0002>Ĕũ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 776,
