      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "皮卡丘也别灰心！\n你只要变得更强就好啦！<U+0010><U+0002>Ĕũ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
