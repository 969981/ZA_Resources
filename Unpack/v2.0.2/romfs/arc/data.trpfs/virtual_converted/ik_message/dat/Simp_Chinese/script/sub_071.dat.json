      "offsetInSection": 224,
      "rawDecodedUtf16Hex": "76AE5361FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "强大的秘密是电气球！<U+0010><U+0002>Ĕũ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 232,
