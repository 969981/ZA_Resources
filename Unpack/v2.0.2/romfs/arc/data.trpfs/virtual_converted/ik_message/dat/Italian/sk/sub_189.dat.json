      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1484,
      "rawDecodedUtf16Hex": "004300650072007400650020006E00610074007500720065002000680061006E006E006F00200075006E0020006500660066006500740074006F00200070006F00730069007400690076006F002000730075006C006C0061000A00560065006C006F00630069007400E0002000640065006900200050006F006B00E9006D006F006E002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Ciò vale non solo per la natura Lesta, ma anche\nper quelle Timida, Allegra e Ingenua.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
