      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Jolteon e gli altri miei Pokémon erano velocissimi,\nvero? È perché hanno tutti una natura Lesta!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
