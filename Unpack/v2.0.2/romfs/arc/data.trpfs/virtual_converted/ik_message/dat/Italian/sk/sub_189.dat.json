      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Ma per quanto possa essere veloce, per sferrare\ndi nuovo la stessa mossa ci metterà sempre<U+0010><U+0001>븀\ntre secondi.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 4,
