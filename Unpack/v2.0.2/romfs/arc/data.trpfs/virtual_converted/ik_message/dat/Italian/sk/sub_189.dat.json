      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Si è già fiondato all’arena perché aveva intuito\nche voglio lottare...<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 628,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
