      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Purrrr...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 644,
      "rawDecodedUtf16Hex": "005000750072007200720072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Ma temo di essere troppo teso per riuscire a\nparlarle naturalmente, perciò ti chiedo un piacere!<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Assistimi nella nostra conversazione!\nTi prego! Per favore!<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "0041007300730069007300740069006D00690020006E0065006C006C00610020006E006F007300740072006100200063006F006E00760065007200730061007A0069006F006E00650021000A0054006900200070007200650067006F002100200050006500720020006600610076006F00720065002100100002011401E20000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Fammi sapere quando è tutto pronto. Davvero,\nho assolutamente bisogno del tuo aiuto...<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
