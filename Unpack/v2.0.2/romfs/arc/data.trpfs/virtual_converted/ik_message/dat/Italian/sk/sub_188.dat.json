      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "00500075007200720072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
