  "messages": [
    {
      "displayText": "E-Ehm... Mi servirebbe il tuo aiuto...<U+0010><U+0002>ĔǢ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 0,
      "offsetInSection": 428,
