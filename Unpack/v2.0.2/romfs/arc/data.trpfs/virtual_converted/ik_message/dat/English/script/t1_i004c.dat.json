  "messages": [
    {
      "displayText": "We are proud to offer only the best. Welcome to\nRestaurant Le Wow.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "005700650020006100720065002000700072006F0075006400200074006F0020006F00660066006500720020006F006E006C0079002000740068006500200062006500730074002E002000570065006C0063006F006D006500200074006F000A00520065007300740061007500720061006E00740020004C006500200057006F0077002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Seeking a luxury full course?\nStep right this way, then. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 348,
      "rawDecodedUtf16Hex": "005300650065006B0069006E0067002000610020006C00750078007500720079002000660075006C006C00200063006F0075007200730065003F000A0053007400650070002000720069006700680074002000740068006900730020007700610079002C0020007400680065006E002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Restaurant Le Wow\nis simply, well...wow!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 492,
      "rawDecodedUtf16Hex": "00520065007300740061007500720061006E00740020004C006500200057006F0077000A00690073002000730069006D0070006C0079002C002000770065006C006C002E002E002E0077006F007700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "These flavors are to die for.\nI’m so happy to be alive!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "0054006800650073006500200066006C00610076006F00720073002000610072006500200074006F002000640069006500200066006F0072002E000A00492019006D00200073006F00200068006100700070007900200074006F00200062006500200061006C00690076006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "I hope we can reach a\nsatisfactory agreement...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "004900200068006F00700065002000770065002000630061006E00200072006500610063006800200061000A007300610074006900730066006100630074006F00720079002000610067007200650065006D0065006E0074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Can’t think on empty bellies.\nFirst, some fine dining!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "00430061006E201900740020007400680069006E006B0020006F006E00200065006D007000740079002000620065006C006C006900650073002E000A00460069007200730074002C00200073006F006D0065002000660069006E0065002000640069006E0069006E006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Anything can happen in\nthe world of battling, Mom.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 896,
      "rawDecodedUtf16Hex": "0041006E0079007400680069006E0067002000630061006E002000680061007000700065006E00200069006E000A00740068006500200077006F0072006C00640020006F006600200062006100740074006C0069006E0067002C0020004D006F006D002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "You and your Pokémon\nRULE at battles, Sis!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "0059006F007500200061006E006400200079006F0075007200200050006F006B00E9006D006F006E000A00520055004C004500200061007400200062006100740074006C00650073002C002000530069007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "...Can you really make ends\nmeet as a Pokémon Trainer?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1088,
      "rawDecodedUtf16Hex": "002E002E002E00430061006E00200079006F00750020007200650061006C006C00790020006D0061006B006500200065006E00640073000A006D0065006500740020006100730020006100200050006F006B00E9006D006F006E00200054007200610069006E00650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "I believe in you, Sis.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "0049002000620065006C006900650076006500200069006E00200079006F0075002C0020005300690073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Seriously, this jerk at my company is so annoying.\nI just want to wallop him in a Pokémon battle.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Mm-hm, totally. You’re so right.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1444,
      "rawDecodedUtf16Hex": "004D006D002D0068006D002C00200074006F00740061006C006C0079002E00200059006F007520190072006500200073006F002000720069006700680074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "This crème brûlée is the\ncrème de la crème...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "005400680069007300200063007200E8006D006500200062007200FB006C00E900650020006900730020007400680065000A0063007200E8006D00650020006400650020006C006100200063007200E8006D0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "The caramelized top\nis perfection itself!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1604,
      "rawDecodedUtf16Hex": "00540068006500200063006100720061006D0065006C0069007A0065006400200074006F0070000A00690073002000700065007200660065006300740069006F006E00200069007400730065006C006600210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "It’s not every day you find a place that attracts\nPokémon Trainers and gourmets alike.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1688,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "The owner, Christophe, said this restaurant is his\nway of honing both battles and flavors...<U+0010><U+0001>븁\nWhen you stop to think about it, it doesn’t make\nmuch sense, does it?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 166
    },
    {
      "displayText": "Our meals should only be tasted when perfectly\nready.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2196,
      "rawDecodedUtf16Hex": "004F007500720020006D00650061006C0073002000730068006F0075006C00640020006F006E006C007900200062006500200074006100730074006500640020007700680065006E00200070006500720066006500630074006C0079000A00720065006100640079002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "You up for a quick\nbattle after we eat?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2304,
      "rawDecodedUtf16Hex": "0059006F007500200075007000200066006F00720020006100200071007500690063006B000A0062006100740074006C00650020006100660074006500720020007700650020006500610074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Sure! Battles are the best\nway to get to know a person.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "0053007500720065002100200042006100740074006C006500730020006100720065002000740068006500200062006500730074000A00770061007900200074006F002000670065007400200074006F0020006B006E006F00770020006100200070006500720073006F006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "I trained my partner Pokémon\nto enjoy fancy desserts like I do.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2496,
      "rawDecodedUtf16Hex": "004900200074007200610069006E006500640020006D007900200070006100720074006E0065007200200050006F006B00E9006D006F006E000A0074006F00200065006E006A006F0079002000660061006E006300790020006400650073007300650072007400730020006C0069006B00650020004900200064006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "I burned myself out at work today,\nso this is a little pick-me-up.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "00490020006200750072006E006500640020006D007900730065006C00660020006F0075007400200061007400200077006F0072006B00200074006F006400610079002C000A0073006F00200074006800690073002000690073002000610020006C006900740074006C00650020007000690063006B002D006D0065002D00750070002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "All I can think about is when\nus waitstaff get to eat, too.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2760,
      "rawDecodedUtf16Hex": "0041006C006C00200049002000630061006E0020007400680069006E006B002000610062006F007500740020006900730020007700680065006E000A007500730020007700610069007400730074006100660066002000670065007400200074006F0020006500610074002C00200074006F006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "It’s important to experience quality from a young\nage. Now eat up!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2880,
      "rawDecodedUtf16Hex": "004900742019007300200069006D0070006F007200740061006E007400200074006F00200065007800700065007200690065006E006300650020007100750061006C006900740079002000660072006F006D0020006100200079006F0075006E0067000A006100670065002E0020004E006F0077002000650061007400200075007000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "It’s not where you eat—it’s who you eat with! As\nlong as the food’s OK, I’d be happy anywhere.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3016,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "If we get too used to the food at Le Wow, we’ll\nstop being able to enjoy anywhere else...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Well, I’d say that Le Wow’s fine dining gives us a\nbetter understanding of food in general!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3388,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    }
