      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Je vois...\nMon Pokémon serait donc un Arbok... ?<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2504,
      "rawDecodedUtf16Hex": "004A006500200076006F00690073002E002E002E000A004D006F006E00200050006F006B00E9006D006F006E002000730065007200610069007400200064006F006E006300200075006E0020004100720062006F006B002E002E002E0020003F00100002011401BD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "... Et si je l’ai appelé Séverin, c’est parce que je\nm’y connais pas assez ? Y a pas de quoi être fier...<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
