      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Quoi ? Tu préfères quand même « Séverin » ?\nEntendu, je continuerai de t’appeler comme ça !<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Bo boook !<U+0010><U+0002>Ĕƾ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3280,
      "rawDecodedUtf16Hex": "0042006F00200062006F006F006F006B0020002100100002011401BE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
