      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Enfin... Il est peut-être pas trop tard pour\ncommencer à t’appeler... « Arbert », t’en dis quoi ?<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
