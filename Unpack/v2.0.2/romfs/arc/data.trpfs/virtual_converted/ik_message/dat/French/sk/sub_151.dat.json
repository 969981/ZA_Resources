      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2444,
      "rawDecodedUtf16Hex": "00500061007300200064007500200074006F00750074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
