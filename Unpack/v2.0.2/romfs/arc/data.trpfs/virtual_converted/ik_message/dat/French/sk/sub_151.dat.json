  "messages": [
    {
      "displayText": "Regarde-moi ça ! Il est pas beau, mon Séviper ?\nOn en voit pas tous les jours à Illumis, hein ?<U+0010><U+0002>Ĕƽ",
      "escapedControlUnits": 2,
