      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "挥指后会出现哪种招式呢？\n我也不知道！<U+0010><U+0001>븀\n这同时也是一场考验你运气的对战！<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "63256307540E4F1A51FA73B054EA79CD62DB5F0F5462FF1F000A62114E5F4E0D77E59053FF0100100001BE00000A8FD9540C65F64E5F662F4E00573A80039A8C4F608FD06C1476845BF96218FF0100100002011401500000",
      "trailingZeroPaddingUnits": 1,
