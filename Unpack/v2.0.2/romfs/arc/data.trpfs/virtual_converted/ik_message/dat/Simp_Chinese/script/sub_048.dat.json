    {
      "displayText": "我为了看完\n全部宝可梦的招式，<U+0010><U+0001>븀\n要不断地挥指！<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 168,
