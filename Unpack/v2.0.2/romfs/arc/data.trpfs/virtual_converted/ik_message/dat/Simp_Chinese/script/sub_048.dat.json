      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "运气不好就会出现不得了的招式，\n于是你就会输掉咯！<U+0010><U+0002>ĔŐ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
