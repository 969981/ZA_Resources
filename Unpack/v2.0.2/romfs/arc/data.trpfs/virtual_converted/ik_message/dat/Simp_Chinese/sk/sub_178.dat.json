      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "胖可唔！！<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "80D653EF5514FF01FF0100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
