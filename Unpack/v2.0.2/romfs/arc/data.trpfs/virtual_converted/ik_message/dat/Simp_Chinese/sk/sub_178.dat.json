      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "用泡沫光线\n让胖可丁闪闪发光吧。<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
