      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "洗澡吧！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "6D176FA15427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "请等一下",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 836,
      "rawDecodedUtf16Hex": "8BF77B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我家胖可丁不仅硬邦邦，\n还臭烘烘的啊！<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
