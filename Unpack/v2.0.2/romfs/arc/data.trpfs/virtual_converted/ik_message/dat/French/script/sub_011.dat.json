      "rawDecodedUtf16Hex": "0049006C00200073201900650073007400200065006E00740072006100EE006E00E90020006400750072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Quelle affirmation décrit le mieux la routine que\nRozbouton et toi suivez habituellement ?<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 6812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
