      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 7168,
      "rawDecodedUtf16Hex": "005100750065006C006C0065002000650073007400200074006100200064006500760069007300650020003F00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Pour bien grandir, il faut bien dormir.",
