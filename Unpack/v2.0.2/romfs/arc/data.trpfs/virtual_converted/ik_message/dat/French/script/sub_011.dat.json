      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7004,
      "rawDecodedUtf16Hex": "004C2019006100760065006E00690072002000610070007000610072007400690065006E0074002000E00020006300650075007800200071007500690020007300650020006C00E800760065006E00740020007400F40074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Trois repas et une sieste par jour.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7096,
      "rawDecodedUtf16Hex": "00540072006F0069007300200072006500700061007300200065007400200075006E0065002000730069006500730074006500200070006100720020006A006F00750072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Quelle est ta devise ?<U+0010><U+0002>Ĕİ",
