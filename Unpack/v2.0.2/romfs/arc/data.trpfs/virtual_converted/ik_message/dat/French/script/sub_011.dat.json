      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 7224,
      "rawDecodedUtf16Hex": "0050006F007500720020006200690065006E0020006700720061006E006400690072002C00200069006C002000660061007500740020006200690065006E00200064006F0072006D00690072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
