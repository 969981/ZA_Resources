      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 7304,
      "rawDecodedUtf16Hex": "0054006F007500740020007600690065006E0074002000E000200070006F0069006E0074002000E000200071007500690020007300610069007400200061007400740065006E006400720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Voilà qui ne me surprend guère !<U+0010><U+0001>븁\nTu as parfaitement entraîné ton Rozbouton et\nrépondu à mes questions tout aussi parfaitement.<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 7384,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Mon intuition était juste : ton Rozbouton est\nextraordinaire.<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 7652,
      "rawDecodedUtf16Hex": "004D006F006E00200069006E00740075006900740069006F006E002000E900740061006900740020006A00750073007400650020003A00200074006F006E00200052006F007A0062006F00750074006F006E0020006500730074000A00650078007400720061006F007200640069006E0061006900720065002E00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Tu remportes ce concours ! En récompense,\nnous te remettons 10 000 <U+E300>.<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 7784,
      "rawDecodedUtf16Hex": "00540075002000720065006D0070006F007200740065007300200063006500200063006F006E0063006F0075007200730020002100200045006E0020007200E90063006F006D00700065006E00730065002C000A006E006F00750073002000740065002000720065006D006500740074006F006E007300200031003000200030003000300020E300002E00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Mes félicitations, tu es vraiment un<U+0010><U+0003>ᄀÿĀe Dresseu<U+0010><U+0003>ᄀÿȁrse\nremarquable !<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 6,
