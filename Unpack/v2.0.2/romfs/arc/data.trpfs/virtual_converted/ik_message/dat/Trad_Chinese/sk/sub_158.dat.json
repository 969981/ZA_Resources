      "offsetInSection": 696,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "寶可夢吃吼霸堵住了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "5BF653EF59225403543C973858354F4F4E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "只要用寶可夢的招式給予衝擊，\n或許可以讓牠從管線裡出來！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "53EA898175285BF653EF5922768462DB5F0F7D664E88885D64CAFF0C000A62168A3153EF4EE58B9372605F9E7BA17DDA88E151FA4F86FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
