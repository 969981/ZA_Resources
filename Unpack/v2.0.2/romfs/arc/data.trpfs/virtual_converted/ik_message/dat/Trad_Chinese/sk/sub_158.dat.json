  "messages": [
    {
      "displayText": "沒想到能在這種地方遇到看起來\n有兩把刷子的訓練家，我還真走運！<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 212,
