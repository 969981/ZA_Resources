      "offsetInSection": 604,
      "rawDecodedUtf16Hex": "62116703628A5EA76A1950B3523000100003110000FF01014F6059B37684573057164E0A7684FF0C000A00100003110000FF01014F6059B3518D75285C0E822A4E4B985E76845E6B62118ABF67E55566300200100002011401C50000",
      "trailingZeroPaddingUnits": 1,
