      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "在密阿雷社交對戰俱樂部\n我們會比賽一晚能收集到多少獎金幣，<U+0010><U+0001>븀\n但我就特別把它分給<U+0010><U+0003>ᄀÿā你妳了。",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1844,
      "rawDecodedUtf16Hex": "57285BC6963F96F7793E4EA45C0D62304FF16A0290E8000A6211501167036BD48CFD4E00665A80FD653696C65230591A5C11734E91D15E63FF0C00100001BE00000A4F4662115C3172795225628A5B8352067D6600100003110000FF01014F6059B34E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>\n獲得了獎金幣！",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "0010000201000000000A73725F974E86734E91D15E63FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>獲得了\n<U+0010><U+0002>＀<U+0008><U+0010><U+0002>ĉ<U+0002><U+0010><U+0002>＀<U+0000>！",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1976,
      "rawDecodedUtf16Hex": "001000020100000073725F974E86000A00100002FF000008001000020109000200100002FF000000FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "這異次元樹果\n就送給<U+0010><U+0003>ᄀÿā你妳了！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2020,
      "rawDecodedUtf16Hex": "901975706B2151436A39679C000A5C3190017D6600100003110000FF01014F6059B34E86FF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "我在異次元密阿雷收集的<U+0010><U+0002>ĉ<U+0002>\n就送給<U+0010><U+0003>ᄀÿā你妳當禮物了！",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
