      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳想不想要\n異次元樹果呢？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B360F34E0D60F38981000A75706B2151436A39679C5462FF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "讓我送上<U+0010><U+0002>ĉ<U+0002>，\n來讚揚<U+0010><U+0003>ᄀÿā你妳的強大吧！",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 2220,
      "rawDecodedUtf16Hex": "8B93621190014E0A0010000201090002FF0C000A4F868B9A63DA00100003110000FF01014F6059B376845F3759275427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "需要我幫<U+0010><U+0003>ᄀÿā你妳的\n寶可夢回復嗎？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2272,
      "rawDecodedUtf16Hex": "9700898162115E6B00100003110000FF01014F6059B37684000A5BF653EF592256DE5FA955CEFF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "在神秘的異次元密阿雷，\n我也要幫寶可夢恢復活力！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "5728795E79D8768475706B2151435BC6963F96F7FF0C000A62114E5F89815E6B5BF653EF592260625FA96D3B529BFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "即使身在異次元，\n您要不要也來一杯咖啡呢？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2396,
      "rawDecodedUtf16Hex": "53734F7F8EAB572875706B215143FF0C000A60A889814E0D89814E5F4F864E00676F549655615462FF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "在不可思議的異次元喝下的咖啡，\n會讓寶可夢們恢復活力呢。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2468,
      "rawDecodedUtf16Hex": "57284E0D53EF601D8B70768475706B215143559D4E0B768454965561FF0C000A67038B935BF653EF5922501160625FA96D3B529B546230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "來杯咖啡吧？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2528,
      "rawDecodedUtf16Hex": "4F86676F549655615427FF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "這是異次元特調咖啡。\n喝下去就會神奇地恢復活力喔。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2572,
      "rawDecodedUtf16Hex": "9019662F75706B21514372798ABF549655613002000A559D4E0B53BB5C316703795E5947573060625FA96D3B529B559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "嚐嚐新咖啡\n自豪的咖啡吧！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "5690569065B054965561000A81EA8C6A7684549655615427FF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "我不懂自己為什麼在這裡，但只要喝下\n大字爆炎烘焙咖啡，寶可夢就會恢復活力喔。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2680,
      "rawDecodedUtf16Hex": "62114E0D61C281EA5DF170BA4EC09EBC5728901988E1FF0C4F4653EA8981559D4E0B000A59275B577206708E70D8711954965561FF0C5BF653EF59225C31670360625FA96D3B529B559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "喝杯新咖啡\n自豪的咖啡吧！<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2760,
      "rawDecodedUtf16Hex": "559D676F65B054965561000A81EA8C6A7684549655615427FF0100100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "新咖啡壓箱的燃盡烘焙咖啡，即使在異次元，\n喝下去連寶可夢也會恢復活力喔。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 2816,
      "rawDecodedUtf16Hex": "65B05496556158D37BB1768471C376E170D8711954965561FF0C53734F7F572875706B215143FF0C000A559D4E0B53BB90235BF653EF59224E5F670360625FA96D3B529B559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "我可以送<U+0010><U+0003>ᄀÿā你妳獎勵卡之外的\n好東西。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2892,
      "rawDecodedUtf16Hex": "621153EF4EE5900100100003110000FF01014F6059B3734E52F553614E4B59167684000A597D6771897F300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "說起來，<U+0010><U+0002>ĉ<U+0002>是\n非常特別稀有！",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "8AAA8D774F86FF0C0010000201090002662F000A975E5E38727952257A006709FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "來，這是貴重的道具。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 3004,
      "rawDecodedUtf16Hex": "4F86FF0C9019662F8CB491CD768490535177300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "雖然是貴重的<U+0010><U+0002>ĉ<U+0002>，\n但我這裡有很多。",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 3056,
      "rawDecodedUtf16Hex": "96D67136662F8CB491CD76840010000201090002FF0C000A4F466211901988E167095F88591A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "我送<U+0010><U+0003>ᄀÿā你妳好東西吧。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 3100,
      "rawDecodedUtf16Hex": "6211900100100003110000FF01014F6059B3597D6771897F5427300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "不過就是<U+0010><U+0002>ĉ<U+0002>，\n但被我擁有，價值就上升了。",
