  "initialKey": 0,
  "messages": [
    {
      "displayText": "獎賞是為打贏的人而存在的。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 420,
      "rawDecodedUtf16Hex": "734E8CDE662F70BA62538D0F76844EBA800C5B5857287684300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "就讓我送上這個<U+0010><U+0002>ĉ<U+0002>，\n給贏得勝利的寶可夢訓練家吧！",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 476,
      "rawDecodedUtf16Hex": "5C318B93621190014E0A9019500B0010000201090002FF0C000A7D668D0F5F9752DD522976845BF653EF59228A137DF45BB65427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "我有個給贏家的禮物。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "62116709500B7D668D0F5BB6768479AE7269300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "請讓我送上這個<U+0010><U+0002>ĉ<U+0002>，\n給贏得勝利的寶可夢訓練家！",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 584,
      "rawDecodedUtf16Hex": "8ACB8B93621190014E0A9019500B0010000201090002FF0C000A7D668D0F5F9752DD522976845BF653EF59228A137DF45BB6FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "需要我幫<U+0010><U+0003>ᄀÿā你妳的寶可夢\n恢復活力嗎？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "9700898162115E6B00100003110000FF01014F6059B376845BF653EF5922000A60625FA96D3B529B55CEFF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "那麼，我來幫<U+0010><U+0003>ᄀÿā你妳的寶可夢恢復活力吧！\n……畢竟這才是我比較拿手的事呀。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 716,
      "rawDecodedUtf16Hex": "90A39EBCFF0C62114F865E6B00100003110000FF01014F6059B376845BF653EF592260625FA96D3B529B5427FF01000A2026202675627ADF9019624D662F62116BD48F0362FF624B76844E8B544030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "您想喝一杯咖啡嗎？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "60A860F3559D4E00676F5496556155CEFF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "請享用這頂級的一杯，\n療癒您在寶可夢對戰的疲勞。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 848,
      "rawDecodedUtf16Hex": "8ACB4EAB7528901998027D1A76844E00676FFF0C000A7642765260A857285BF653EF59225C0D6230768475B252DE30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "要來杯咖啡嗎？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "89814F86676F5496556155CEFF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "這是專為寶可夢特調的咖啡。\n喝下去就會恢復活力喔。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "9019662F5C0870BA5BF653EF592272798ABF7684549655613002000A559D4E0B53BB5C31670360625FA96D3B529B559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "要不要嚐嚐\n新咖啡自豪的咖啡？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "89814E0D898156905690000A65B05496556181EA8C6A768454965561FF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "只要喝下新咖啡引以為傲的\n大字爆炎烘焙咖啡，<U+0010><U+0001>븀\n連寶可夢也會恢復活力喔。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1056,
      "rawDecodedUtf16Hex": "53EA8981559D4E0B65B0549655615F154EE570BA50B27684000A59275B577206708E70D8711954965561FF0C00100001BE00000A90235BF653EF59224E5F670360625FA96D3B529B559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "要喝杯新咖啡自豪的咖啡嗎？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "8981559D676F65B05496556181EA8C6A76845496556155CEFF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "新咖啡壓箱的燃盡烘焙咖啡，\n喝下去連寶可夢也會恢復活力喔。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1192,
      "rawDecodedUtf16Hex": "65B05496556158D37BB1768471C376E170D8711954965561FF0C000A559D4E0B53BB90235BF653EF59224E5F670360625FA96D3B529B559430020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "要我送張獎勵卡給<U+0010><U+0003>ᄀÿā你妳，\n也是可以啦。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "8981621190015F35734E52F553617D6600100003110000FF01014F6059B3FF0C000A4E5F662F53EF4EE55566300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "讓我從今晚獲得的自豪的卡片中，\n選1張送給<U+0010><U+0003>ᄀÿā你妳吧！",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "8B9362115F9E4ECA665A73725F97768481EA8C6A7684536172474E2DFF0C000A907800315F3590017D6600100003110000FF01014F6059B35427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "來，這是獎金幣。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1392,
      "rawDecodedUtf16Hex": "4F86FF0C9019662F734E91D15E63300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "這些是我收集的獎金幣，\n但全部都送給<U+0010><U+0003>ᄀÿā你妳吧。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "90194E9B662F6211653696C67684734E91D15E63FF0C000A4F46516890E890FD90017D6600100003110000FF01014F6059B3542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳需要獎金幣嗎？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1496,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B397008981734E91D15E6355CEFF1F00100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "獎金幣只要再收集就行了。\n這些就全部都送給贏得勝利的<U+0010><U+0003>ᄀÿā你妳囉。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1556,
      "rawDecodedUtf16Hex": "734E91D15E6353EA8981518D653696C65C31884C4E863002000A90194E9B5C31516890E890FD90017D668D0F5F9752DD5229768400100003110000FF01014F6059B356C930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "讓我把獎金幣\n賞給<U+0010><U+0003>ᄀÿā你妳吧。<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "8B936211628A734E91D15E63000A8CDE7D6600100003110000FF01014F6059B35427300200100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "我將這獎金幣贈予<U+0010><U+0003>ᄀÿā你妳作為勝利的證明吧！\n還附上來自由紫小姐的愛唷。",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1696,
      "rawDecodedUtf16Hex": "62115C079019734E91D15E638D084E8800100003110000FF01014F6059B34F5C70BA52DD522976848B49660E5427FF01000A908496444E0A4F8681EA75317D2B5C0F59D07684611B553730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "我猜猜，\n<U+0010><U+0003>ᄀÿā你妳想要獎金幣？<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1776,
