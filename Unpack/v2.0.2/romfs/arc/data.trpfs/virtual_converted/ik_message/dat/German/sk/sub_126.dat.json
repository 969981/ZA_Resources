      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Danke, dass du dem Gerücht für mich\nnachgegangen bist, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
