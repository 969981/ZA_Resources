      "rawDecodedUtf16Hex": "00440061006E006B0065002C00200064006100730073002000640075002000640065006D002000470065007200FC0063006800740020006600FC00720020006D006900630068000A006E0061006300680067006500670061006E00670065006E00200062006900730074002C00200010000201000000002100100002011401A70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Hinter dem wandelnden Grab stecken also nur ein\nFriedwuff und ein paar Gruff?<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Na, so was. Kaum kennt man die Tatsachen,\nschon ist die ganze Aufregung dahin.<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Aber... Moment mal!<U+0010><U+0001>븁\nWoher sind Friedwuff und die Gruff eigentlich\ngekommen?<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 3508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Und die Vorstellung, nachts auf einem Friedhof\nvon Friedwuff und Gruff umzingelt zu werden...<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 3676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Wie grausig gruselig!<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 3872,
      "rawDecodedUtf16Hex": "00570069006500200067007200610075007300690067002000670072007500730065006C00690067002100100002011401A70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "<U+0010><U+0002>뷿(",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 3924,
      "rawDecodedUtf16Hex": "00100002BDFF00280000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Man kann also sagen, an dem Gerücht war was\ndran.<U+0010><U+0001>븁\nNachts auf einem Friedhof von Friedwuff und\nGruff umzingelt zu sein ist grausig gruselig!<U+0010><U+0002>ĔƧ",
