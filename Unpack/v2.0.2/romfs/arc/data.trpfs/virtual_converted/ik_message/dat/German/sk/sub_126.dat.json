      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Drittens: Man muss durch den Eingang im\nNorden reinkommen.<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1096,
