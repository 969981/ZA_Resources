  "messages": [
    {
      "displayText": "Hast du schon gehört? Unter uns Lieferanten ist\ngerade ein interessantes Gerücht im Umlauf.<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Du kennst doch den Friedhof Bonne Nuit, oder?\nDort soll sich nachts ein Grab bewegen!<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Meine Lieferantenfreunde munkeln, dass es sich\naber nur unter bestimmten Bedingungen bewegt.<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Erstens: Es muss Nacht sein.<U+0010><U+0002>ĔƧ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "00450072007300740065006E0073003A0020004500730020006D0075007300730020004E00610063006800740020007300650069006E002E00100002011401A70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Zweitens: Man darf nur ein einziges Pokémon\ndabeihaben.<U+0010><U+0002>ĔƧ",
