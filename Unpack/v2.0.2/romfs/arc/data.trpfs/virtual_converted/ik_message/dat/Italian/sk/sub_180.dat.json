      "index": 9,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "0041007300700065007400740061002E002E002E001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
