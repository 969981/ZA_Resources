      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1032,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "La polizia di Luminopoli svolge delle esercitazioni\nperiodiche e ora è la volta del museo.<U+0010><U+0002>Ĕ+",
