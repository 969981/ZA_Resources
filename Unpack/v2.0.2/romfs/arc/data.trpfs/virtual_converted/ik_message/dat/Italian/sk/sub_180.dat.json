      "rawDecodedUtf16Hex": "00540065006D006F00200063006800650020006C0065002000700072006F007300730069006D0065002000650073006500720063006900740061007A0069006F006E006900200073006100720061006E006E006F000A0061006E0063006F0072006100200070006900F900200069006D007000650067006E00610074006900760065002E00100002011401CD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
