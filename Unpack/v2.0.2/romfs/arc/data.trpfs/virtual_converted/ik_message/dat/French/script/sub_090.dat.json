      "rawDecodedUtf16Hex": "004A006500200064006F0069007300200064201900610062006F007200640020006D006500200070007200E900700061007200650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Je comprends. Affronter cinq adversaires à la fois,\nça ne s’improvise pas.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Vous êtes prêts, mes petits ?\nFaites-lui en voir de toutes les couleurs !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000E>",
