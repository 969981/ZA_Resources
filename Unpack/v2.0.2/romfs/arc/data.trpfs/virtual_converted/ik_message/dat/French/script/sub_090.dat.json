      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Flo-flo !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 452,
      "rawDecodedUtf16Hex": "0046006C006F002D0066006C006F002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "J’aimerais beaucoup les voir se battre\ntous les cinq en même temps.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 472,
      "rawDecodedUtf16Hex": "004A201900610069006D00650072006100690073002000620065006100750063006F007500700020006C0065007300200076006F006900720020007300650020006200610074007400720065000A0074006F007500730020006C00650073002000630069006E007100200065006E0020006D00EA006D0065002000740065006D00700073002E00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Ça me donnerait sûrement plein d’idées\npour de nouvelles teintures de cheveux !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "C’est là que tu interviens !<U+0010><U+0001>븁\nEst-ce que tu voudrais bien faire un combat\ncontre mes cinq Floette simultanément ?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Si tu es d’accord, fais-moi signe.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "00530069002000740075002000650073002000642019006100630063006F00720064002C00200066006100690073002D006D006F00690020007300690067006E0065002E00100002011401740000",
      "trailingZeroPaddingUnits": 1,
