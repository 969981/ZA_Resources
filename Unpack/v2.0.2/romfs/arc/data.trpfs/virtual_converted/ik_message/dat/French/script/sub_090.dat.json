      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "J’ai élevé des Flabébé de cinq couleurs\ndifférentes et je les ai tous fait évoluer !<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
