      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Alors, tu veux bien affronter mes cinq Floette\nen même temps ?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 9,
      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "0041006C006F00720073002C002000740075002000760065007500780020006200690065006E00200061006600660072006F006E0074006500720020006D00650073002000630069006E007100200046006C006F0065007400740065000A0065006E0020006D00EA006D0065002000740065006D007000730020003F00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "C’est parti !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "00432019006500730074002000700061007200740069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
