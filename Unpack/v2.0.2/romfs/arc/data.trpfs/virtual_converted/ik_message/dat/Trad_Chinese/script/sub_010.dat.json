    },
    {
      "displayText": "我～是～說！\n說到異常狀態，當然就是<U+0010><U+0002>＀<U+0006>中毒<U+0010><U+0002>＀<U+0000>！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 464,
      "rawDecodedUtf16Hex": "6211FF5E662FFF5E8AAAFF01000A8AAA523075705E3872C0614BFF0C757671365C31662F00100002FF0000064E2D6BD200100002FF000000FF01001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "中毒能讓HP越減越少，\n技巧性地拿下勝利！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
