      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "是吧！？我就說吧！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2180,
      "rawDecodedUtf16Hex": "662F5427FF01FF1F62115C318AAA5427FF01001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "等等哪！\n麻痺也不會輸給中毒的！<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "7B497B4954EAFF01000A9EBB75FA4E5F4E0D67038F387D664E2D6BD27684FF01001000020114012F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "啥啊！？<U+0010><U+0002>ĔĮ",
