      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "竟然能戰勝麻痺戰術，\n<U+0010><U+0003>ᄀÿā你妳還真有兩把刷子呢。<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1448,
      "rawDecodedUtf16Hex": "7ADF713680FD623052DD9EBB75FA62308853FF0C000A00100003110000FF01014F6059B39084771F67095169628A52375B5054623002001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "下一個換我！\n看我用毒一點一滴地削減你們！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "4E0B4E00500B63DB6211FF01000A770B621175286BD24E009EDE4E006EF45730524A6E1B4F605011FF01001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
