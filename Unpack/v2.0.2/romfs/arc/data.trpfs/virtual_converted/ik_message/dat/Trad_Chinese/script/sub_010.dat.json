      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "如果您的寶可夢陷入了麻痺狀態，\n請用解麻藥幫牠治療！<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1384,
