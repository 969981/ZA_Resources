      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 2252,
      "rawDecodedUtf16Hex": "5565554AFF01FF1F001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "您覺得異常狀態\n根本是小菜一碟嗎！？<U+0010><U+0002>Ĕį",
