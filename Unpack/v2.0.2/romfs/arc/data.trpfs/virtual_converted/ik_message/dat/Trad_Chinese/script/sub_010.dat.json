      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "哎呀，對了！麻痺狀態是\n在對戰結束後也不會治癒的喔！<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1320,
