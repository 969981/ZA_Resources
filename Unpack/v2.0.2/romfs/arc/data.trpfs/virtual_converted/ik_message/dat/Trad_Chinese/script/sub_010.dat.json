      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "就是說吧！果然是\n麻痺讓<U+0010><U+0003>ᄀÿā他她陷入了大苦戰！<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2116,
