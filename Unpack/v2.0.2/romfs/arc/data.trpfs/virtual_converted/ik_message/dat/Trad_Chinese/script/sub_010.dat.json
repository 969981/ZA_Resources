      "rawDecodedUtf16Hex": "90FD4E0D7B974EC09EBCFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳說什麼！？<U+0010><U+0002>ĔĮ",
