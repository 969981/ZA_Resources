      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳老實回答我，\n究竟是中毒還是麻痺比較難纏？<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 4,
