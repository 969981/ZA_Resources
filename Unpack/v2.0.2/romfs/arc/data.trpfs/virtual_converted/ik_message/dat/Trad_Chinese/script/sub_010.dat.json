      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "5C0D62305427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "還是算了",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1644,
      "rawDecodedUtf16Hex": "9084662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "看來<U+0010><U+0003>ᄀÿā你妳是被中毒戰術的厲害\n給嚇到了吧！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
