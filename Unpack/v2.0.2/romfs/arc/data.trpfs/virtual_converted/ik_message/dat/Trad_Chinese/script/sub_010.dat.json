      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "陷入中毒狀態的寶可夢\n會持續受到傷害。<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1716,
      "rawDecodedUtf16Hex": "967751654E2D6BD272C0614B76845BF653EF5922000A670363017E8C53D7523050B75BB33002001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "那究竟有多恐怖……\n<U+0010><U+0003>ᄀÿā你妳就細細品嚐一番吧！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "90A37A767ADF6709591A6050601620262026000A00100003110000FF01014F6059B35C317D307D3054C156904E00756A5427FF01001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
