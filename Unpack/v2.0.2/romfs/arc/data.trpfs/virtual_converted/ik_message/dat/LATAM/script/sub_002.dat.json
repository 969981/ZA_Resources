      "index": 18,
      "offsetInSection": 2404,
      "rawDecodedUtf16Hex": "00A10051007500E90020006D006900650064006F002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "¡Es increíble!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
