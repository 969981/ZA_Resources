      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Por aquí es por donde vi a ese Bunnelby\ndescomunal.<U+0010><U+0001>븁\nAyyy... ¡me tiemblan las piernas solo de pensarlo!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "¡¿Bun?!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2212,
      "rawDecodedUtf16Hex": "00A100BF00420075006E003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "¿Qué pasa, amiguito? No me digas que...\n¡¿Está aquí?!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2228,
      "rawDecodedUtf16Hex": "00BF0051007500E900200070006100730061002C00200061006D00690067007500690074006F003F0020004E006F0020006D00650020006400690067006100730020007100750065002E002E002E000A00A100BF00450073007400E1002000610071007500ED003F002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "¡¡Bunneee!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "00A100A100420075006E006E006500650065002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "¡Es gigante!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2368,
