      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "004D00650020007200650066006900650072006F00200061002E002E002E00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Un enorme...<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
