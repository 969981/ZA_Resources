    {
      "displayText": "Ah, bueno... Entonces, tendré que conformarme.\nSi Matière te dejó a cargo, confío en su criterio.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Bien, iré al grano. ¡Un individuo temible anda\nsuelto por Ciudad Luminalia!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Me refiero a...<U+0010><U+0002>ĔĦ",
