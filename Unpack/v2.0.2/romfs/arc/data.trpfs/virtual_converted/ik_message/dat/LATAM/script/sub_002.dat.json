      "offsetInSection": 2552,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡No puedo creer que hayas derrotado a ese\nBunnelby gigante!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2564,
      "rawDecodedUtf16Hex": "00A1004E006F00200070007500650064006F002000630072006500650072002000710075006500200068006100790061007300200064006500720072006F007400610064006F002000610020006500730065000A00420075006E006E0065006C0062007900200067006900670061006E00740065002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Por cierto, al verte combatir\nme acordé de algo.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2692,
