      "index": 20,
      "offsetInSection": 2476,
      "rawDecodedUtf16Hex": "00A100450073002000E9006C0021002000A1004E006F002000680061007900200064007500640061002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡¡Nelbyyy!!",
