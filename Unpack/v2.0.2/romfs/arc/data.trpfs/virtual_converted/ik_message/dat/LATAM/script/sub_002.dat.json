      "index": 19,
      "offsetInSection": 2436,
      "rawDecodedUtf16Hex": "00A10045007300200069006E00630072006500ED0062006C0065002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "¡Es él! ¡No hay duda!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
