      "rawDecodedUtf16Hex": "5F8868D25427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "好厲害！好厲害！好厲害！<U+0010><U+0002>Ĕů",
