      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "我說我說，\n<U+0010><U+0003>ᄀÿā你妳很了解超級進化嗎？<U+0010><U+0002>Ĕƚ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 704,
      "rawDecodedUtf16Hex": "62118AAA62118AAAFF0C000A00100003110000FF01014F6059B35F884E8689E38D857D1A9032531655CEFF1F001000020114019A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "我們讓這位寶可夢訓練家\n來教教我們吧！<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
