      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "等<U+0010><U+0003>ᄀÿā你妳！等<U+0010><U+0003>ᄀÿā你妳！我們會等<U+0010><U+0003>ᄀÿā你妳的！<U+0010><U+0002>Ĕů",
