      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 900,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我爸爸明明在闊星公司上班，\n卻不給我超級環。<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
