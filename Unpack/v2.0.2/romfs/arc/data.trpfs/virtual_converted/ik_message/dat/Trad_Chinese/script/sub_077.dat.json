      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "人家也要拿到超級環\n讓搭檔超級進化！<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
