      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 684,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B3770BFF0C000A662F61F262124E4B58FAFF0100100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "嗶啪……",
