      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我在整理AZ的房間時，\n找到好東西了呢！<U+0010><U+0002>Ĕ<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
