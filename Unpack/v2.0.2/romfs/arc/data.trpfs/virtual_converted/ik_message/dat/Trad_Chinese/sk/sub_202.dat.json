      "offsetInSection": 1720,
      "rawDecodedUtf16Hex": "4E5F7B97662F70BA4E8680E15E15FF0C000A00100003110000FF01014F6059B353BB8ABF67E551FA73FE768490A3500B626D6D1E5427300200100002011400050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
