      "offsetInSection": 728,
      "rawDecodedUtf16Hex": "55F6556A202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "胡帕，難道是\n那個壺會讓你害怕嗎？<U+0010><U+0002>Ĕƥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
