      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳打倒異次元的胡帕啦！<U+0010><U+0002>Ĕ<U+0006>",
