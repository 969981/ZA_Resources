      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳看，\n是懲戒之壺！<U+0010><U+0002>Ĕ<U+0005>",
