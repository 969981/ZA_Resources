      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳看，\n是懲戒之壺！<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
