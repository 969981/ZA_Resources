      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳打倒異次元的胡帕了對不對！！<U+0010><U+0002>Ĕ<U+0005>",
