      "rawDecodedUtf16Hex": "0049006D0070006500630063006100620069006C0065002100100002011401D40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Faaar! Faar, faaaarrrrr!!",
      "escapedControlUnits": 0,
