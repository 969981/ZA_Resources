  "messages": [
    {
      "displayText": "Ehi, tu, Allenat<U+0010><U+0003>ᄀÿ̂orrice in gamba! Ho dei bei Porri\nper te!<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 4,
