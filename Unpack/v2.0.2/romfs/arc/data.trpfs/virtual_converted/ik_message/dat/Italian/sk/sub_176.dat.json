      "offsetInSection": 3916,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Non riesco a crederci, hanno perso entrambi...<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4120,
      "rawDecodedUtf16Hex": "004E006F006E002000720069006500730063006F00200061002000630072006500640065007200630069002C002000680061006E006E006F00200070006500720073006F00200065006E007400720061006D00620069002E002E002E00100002011401D40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Il Trio del Porro rischia di perdere l’onore.<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 4224,
      "rawDecodedUtf16Hex": "0049006C0020005400720069006F002000640065006C00200050006F00720072006F00200072006900730063006800690061002000640069002000700065007200640065007200650020006C2019006F006E006F00720065002E00100002011401D40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Io sono Bushi, capo del trio... In altre parole,\nsono il più forte fra noi tre.<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 4324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Ti mostrerò le tecniche della scherma del Porro\ndella scuola di Kanto!<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4492,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Poco importa se il tuo è un Farfetch’d di Galar!\nTi sconvolgerò con la scherma del Porro di Kanto!<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 103
    },
    {
