      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Che potenza strabiliante... Quanto devi esserti\nallenat<U+0010><U+0003>ᄀÿāoa per giungere a un tale risultato?<U+0010><U+0002>ĔǓ",
      "escapedControlUnits": 4,
