      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "낼게요...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "B0BCAC8CC694002E002E002E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
