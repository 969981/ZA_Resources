      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "이런, 돈이 부족하군...<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
