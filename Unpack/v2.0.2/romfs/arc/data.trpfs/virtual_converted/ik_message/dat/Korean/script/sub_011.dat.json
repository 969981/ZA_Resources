      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "자네에게서 꼬몽울을 꽃피울 수 있는\n트레이너로서의 재능이 느껴지는군.<U+0010><U+0001>븀\n괜찮다면 우리 품평회에 나와 주지 않겠나?<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "C790B124C5D0AC8CC11C0020AF2CBABDC6B8C7440020AF43D53CC6B80020C2180020C788B294000AD2B8B808C774B108B85CC11CC7580020C7ACB2A5C7740020B290AEF4C9C0B294AD70002E00100001BE00000AAD1CCC2EB2E4BA740020C6B0B9AC0020D488D3C9D68CC5D00020B098C6400020C8FCC9C00020C54AACA0B098003F00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "블르 8번지의 분수 광장으로 와 주게...\n기다리고 있겠네.<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "BE14B97400200038BC88C9C0C7580020BD84C2180020AD11C7A5C73CB85C0020C6400020C8FCAC8C002E002E002E000AAE30B2E4B9ACACE00020C788ACA0B124002E00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
