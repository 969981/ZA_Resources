      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "꼬몽울에게 있어서 중요한 건\n건강함입니다.<U+0010><U+0002>ĔƔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
