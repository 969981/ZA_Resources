      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "움직임은 평범한 것 같고...\n별로 마음을 울리는 것 같지는 않네.<U+0010><U+0002>ĔƓ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
