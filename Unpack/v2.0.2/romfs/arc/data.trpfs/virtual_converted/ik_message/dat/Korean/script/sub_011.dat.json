      "rawDecodedUtf16Hex": "AF2CBAA8C639266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "꼬몽울은 꽃봉오리를 피울 때까지\n추위를 견디는 포켓몬이지.<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 664,
