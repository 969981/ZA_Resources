      "index": 5,
      "offsetInSection": 796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Do you think you could look for Toxie’s lost\nLumiose Galette?<U+0010><U+0002>ĔǇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
