      "index": 38,
      "offsetInSection": 3552,
      "rawDecodedUtf16Hex": "0054006F006800210020266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "I get that wild Pokémon might sometimes have to\nsteal food from people in order to survive...<U+0010><U+0001>븁\nBut this is Lumiose. We can try for a friendlier\nway of coexisting with Pokémon!<U+0010><U+0002>ĔǇ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 3568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 182
    },
    {
      "displayText": "All’s well that ends well. Looks like Toxie’s got a\nnew friend now, thanks to you.<U+0010><U+0001>븁\nThank you for your help!<U+0010><U+0002>ĔǇ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 3932,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
