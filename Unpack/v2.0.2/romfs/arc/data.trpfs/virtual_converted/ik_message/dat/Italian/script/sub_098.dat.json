      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "00410064006500730073006F00200070006F00730073006F002000660069006E0061006C006D0065006E0074006500200074006F0072006E0061007200650020006100200064006900700069006E0067006500720065002E002E002E001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Ma...?! Non è possibile!!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
