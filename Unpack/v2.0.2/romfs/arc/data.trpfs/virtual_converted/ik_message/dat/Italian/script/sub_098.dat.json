      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Usa le mosse de<U+0010><U+0003>ᄁý؅l tuoi tuoi Pokémon per bruciare quei\nrovi che guastano la vista della fontana!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
