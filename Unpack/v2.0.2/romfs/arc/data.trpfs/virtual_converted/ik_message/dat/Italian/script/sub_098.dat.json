      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5444,
      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Le marachelle di questo Phantump hanno finito\nper ravvivare la fiamma del mio spirito d’artista!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
