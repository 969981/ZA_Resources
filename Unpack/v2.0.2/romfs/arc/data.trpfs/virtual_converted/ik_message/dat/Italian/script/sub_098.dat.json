    {
      "displayText": "Come puoi ben vedere, hai di fronte un’artista.<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 512,
