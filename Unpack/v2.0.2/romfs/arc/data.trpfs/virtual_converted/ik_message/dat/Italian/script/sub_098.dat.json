      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "I rovi sono aumentati ancora di più! Che storia è\nmai questa?!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2904,
      "rawDecodedUtf16Hex": "004900200072006F0076006900200073006F006E006F002000610075006D0065006E007400610074006900200061006E0063006F0072006100200064006900200070006900F900210020004300680065002000730074006F007200690061002000E8000A006D006100690020007100750065007300740061003F0021001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Di fronte a questi nuovi ostacoli, non posso che\nrinnovare la mia richiesta d’aiuto!<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
