      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Sto cercando di realizzare un bel paesaggio per\nun concorso di pittura, ma...<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 8,
      "index": 4,
