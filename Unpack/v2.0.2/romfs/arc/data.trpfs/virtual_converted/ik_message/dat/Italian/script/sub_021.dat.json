    },
    {
      "displayText": "Vincere sferrando la mossa più forte? Tsk!\nLe lotte Pokémon non sono mica così semplici!<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Voglio continuare a lottare per far capire agli altri\nquesta verità.<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "0056006F0067006C0069006F00200063006F006E00740069006E0075006100720065002000610020006C006F00740074006100720065002000700065007200200066006100720020006300610070006900720065002000610067006C006900200061006C007400720069000A00710075006500730074006100200076006500720069007400E0002E001000020114013A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Se aspiri a diventare forte, ti farò capire quanto\nsono importanti le mosse che riducono i danni<U+0010><U+0001>븀\nsubiti. Mi riferisco alle \"barriere\".<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Se vuoi lottare, vieni a dirmelo.<U+0010><U+0002>Ĕĺ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 796,
      "rawDecodedUtf16Hex": "00530065002000760075006F00690020006C006F00740074006100720065002C0020007600690065006E0069002000610020006400690072006D0065006C006F002E001000020114013A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
