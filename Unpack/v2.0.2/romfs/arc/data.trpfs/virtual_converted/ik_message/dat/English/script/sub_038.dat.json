      "rawDecodedUtf16Hex": "00520069006700680074003F002100100002011401470000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Not at all!!!<U+0010><U+0002>ĔŇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1956,
      "rawDecodedUtf16Hex": "004E006F007400200061007400200061006C006C00210021002100100002011401470000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Sure, they both prevent your Pokémon from\ntaking damage...<U+0010><U+0002>ĔŇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1992,
