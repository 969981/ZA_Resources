      "rawDecodedUtf16Hex": "004800610068002E002E002E00200057006800650077002E002E002E00100002011401470000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "So? What’d you think of how my Pokémon used\nDetect? Way different from Protect, right?<U+0010><U+0002>ĔŇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Yeah, totally different",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "0059006500610068002C00200074006F00740061006C006C007900200064006900660066006500720065006E00740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "They do the same thing",
