    },
    {
      "displayText": "Mh? Sto riparando questo Holotrasporto.\nAnche se in realtà adesso sono in pausa.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 216,
