    },
    {
      "displayText": "いろんな<U+0010><U+0006>！<U+0001><U+0002>人ひと人いろんなポケモンすべてが\n<U+0010>\t！<U+0002><U+0004>満足まんぞく満足する<U+0010><U+0006>！<U+0001><U+0002>街まち街なんてさすがに<U+0010><U+0007>！<U+0002><U+0002>無理むり無理だろう",
      "escapedControlUnits": 15,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2956,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 72,
      "utf16Units": 143
    },
    {
      "displayText": "<U+0010><U+0007>！<U+0002><U+0002>無理むり無理でも<U+0010><U+0008>！<U+0002><U+0003>可能かのう可能かもと<U+0010><U+0006>！<U+0001><U+0002>思おも思わせるのが\nみんなにとって<U+0010><U+0008>！<U+0002><U+0003>大事だいじ大事なことなのよ",
