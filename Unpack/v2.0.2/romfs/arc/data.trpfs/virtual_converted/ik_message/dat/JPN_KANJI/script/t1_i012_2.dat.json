      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 57,
      "utf16Units": 113
    },
    {
      "displayText": "なにが<U+0010><U+0005>！<U+0001><U+0001>起お起きてもうちが<U+0010><U+0006>！<U+0001><U+0002>守まも守るよ\nユカリさまも……みんなも！<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 47,
      "utf16Units": 93
    },
    {
      "displayText": "ユカリさまと<U+0010><U+0007>！<U+0002><U+0002>出会であ出会ってしまった<U+0010><U+0008>！<U+0002><U+0003>不幸ふこう不幸……\nうちにはよくわかりますから<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 11,
