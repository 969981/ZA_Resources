      "trailingZeroPaddingUnits": 26,
      "utf16Units": 51
    },
    {
      "displayText": "ポケモンと<U+0010><U+0005>！<U+0001><U+0001>暮く暮らす<U+0010><U+0006>！<U+0001><U+0002>街まち街なら\nトレーナーとしての<U+0010>\n！<U+0002><U+0005>力量りきりょう力量が<U+0010><U+0005>！<U+0001><U+0001>問と問われるね",
      "escapedControlUnits": 15,
      "flagsUpper16": 0,
      "index": 10,
