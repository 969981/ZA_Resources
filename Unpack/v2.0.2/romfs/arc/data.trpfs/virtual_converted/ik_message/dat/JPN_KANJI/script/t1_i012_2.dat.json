      "trailingZeroPaddingUnits": 54,
      "utf16Units": 107
    },
    {
      "displayText": "ユカリさまが<U+0010>\t！<U+0002><U+0004>満足まんぞく満足してくれれば\nすべて<U+0010><U+0007>！<U+0002><U+0002>無事ぶじ無事に<U+0010><U+0005>！<U+0001><U+0001>終お終わります……<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 14,
