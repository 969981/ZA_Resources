      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "用泡沫光線擊中胖可丁，\n讓牠變得閃亮亮的吧！<U+0010><U+0001>븀\n總之再幫我一次啦！<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "75286CE16CAB51497DDA64CA4E2D80D653EF4E01FF0C000A8B9372608B8A5F9795834EAE4EAE76845427FF0100100001BE00000A7E3D4E4B518D5E6B62114E006B215566FF0100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "00100002BDFF00110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "胖可丁！\n你變得閃亮亮真是太好了呢！<U+0010><U+0001>븀\n本來臭烘烘的氣味也沒了耶。<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1048,
