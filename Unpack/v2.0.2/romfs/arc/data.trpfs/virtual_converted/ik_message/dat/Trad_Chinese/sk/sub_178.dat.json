      "rawDecodedUtf16Hex": "5F9E4ECA4EE55F8C000A4F6053EF89814E564E566D176FA15594300200100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "胖可嗚！！<U+0010><U+0002>ĔǗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "80D653EF55DAFF01FF0100100002011401D70000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "胖可丁使出了\n過度激烈的巴掌！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "80D653EF4E014F7F51FA4E86000A904E5EA66FC070C876845DF4638CFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
