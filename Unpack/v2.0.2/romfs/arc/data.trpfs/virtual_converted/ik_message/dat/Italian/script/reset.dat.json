      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2592,
      "rawDecodedUtf16Hex": "00440069201900200061006400640069006F00200061006C0020007000610073007300610074006F002C00200069006C002000740075006F0020006600610074006F002000E800200063006F006E002000740065002000720069006E00610074006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
