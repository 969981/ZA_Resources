      "rawDecodedUtf16Hex": "004400690020007100750061006C006500200050006F006B00E9006D006F006E002000760075006F0069002000720069007000720069007300740069006E00610072006500200069002000700075006E0074006900200062006100730065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Seleziona",
