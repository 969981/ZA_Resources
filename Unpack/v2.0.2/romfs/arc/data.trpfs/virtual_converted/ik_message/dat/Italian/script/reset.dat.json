      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Non è ancora ora di rifarti i connotati, o sbaglio?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 292,
      "rawDecodedUtf16Hex": "004E006F006E002000E800200061006E0063006F007200610020006F00720061002000640069002000720069006600610072007400690020006900200063006F006E006E006F0074006100740069002C0020006F00200073006200610067006C0069006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Io sono Garçonne Ripristina. Posso offrirti uno\ndei nostri servizi... al giusto prezzo.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 396,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Il mio lavoro consiste nel ripristinare i punti base\ndei Pokémon... dando loro la possibilità di iniziare<U+0010><U+0001>븀\nuna nuova vita.",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 572,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Per ripristinare i punti base di un Pokémon mi\nservono <U+0010><U+0003>Ȅ<U+0002><U+0000> Megaframment<U+0010><U+0003>ᄁ<U+0002>āoi.<U+0010><U+0001>븀\nFammi un fischio se t’interessa.",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Garçonne Ripristina, al tuo servizio.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "00470061007200E7006F006E006E0065002000520069007000720069007300740069006E0061002C00200061006C002000740075006F002000730065007200760069007A0069006F002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Vuoi ripristinare i punti base di un Pokémon in\ncambio di <U+0010><U+0003>Ȅ<U+0002><U+0000> Megaframment<U+0010><U+0003>ᄁ<U+0002>āoi?",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Ci sto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1308,
      "rawDecodedUtf16Hex": "00430069002000730074006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Forse è meglio di no",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "0046006F007200730065002000E80020006D00650067006C0069006F0020006400690020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Come funziona?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "0043006F006D0065002000660075006E007A0069006F006E0061003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Posso azzerare i punti base che un Pokémon\nha accumulato durante le sue avventure.<U+0010><U+0001>븁\nIn cambio di questo servizio richiedo un modesto\npagamento di <U+0010><U+0003>Ȅ<U+0002><U+0000> Megaframment<U+0010><U+0003>ᄁ<U+0002>āoi.<U+0010><U+0001>븀\nFammi sapere se hai bisogno di me.",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 213
    },
    {
      "displayText": "Mi servono <U+0010><U+0003>Ȅ<U+0002><U+0000> Megaframment<U+0010><U+0003>ᄁ<U+0002>āoi per\nripristinare i punti base di un Pokémon.",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
