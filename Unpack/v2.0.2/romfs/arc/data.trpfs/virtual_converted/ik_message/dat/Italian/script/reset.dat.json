      "rawDecodedUtf16Hex": "00100002BD06000000530065006900200073006900630075007200100003110000FF0101006F006100200064006900200076006F006C00650072002000720069007000720069007300740069006E00610072006500200069002000700075006E0074006900200062006100730065000A0064006900200010000201020003003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
