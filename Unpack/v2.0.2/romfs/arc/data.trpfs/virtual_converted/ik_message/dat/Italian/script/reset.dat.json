  "messages": [
    {
      "displayText": "Vuoi che ti rimetta a nuovo? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 204,
