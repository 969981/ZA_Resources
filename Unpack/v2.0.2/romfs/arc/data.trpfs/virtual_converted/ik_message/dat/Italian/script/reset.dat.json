      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2460,
      "rawDecodedUtf16Hex": "00560061002000620065006E0065002C00200061006C006C006F0072006100200069006E0069007A00690061006D006F002E002000500072006F006E0074006F002000700065007200200075006E0061002000620065006C006C0061000A0074006100620075006C006100200072006100730061002C00200010000201020003003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
