      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2700,
      "rawDecodedUtf16Hex": "00100002BD0600000049002000700075006E00740069002000620061007300650020006400690020001000020102000300200073006F006E006F002000730074006100740069000A0061007A007A0065007200610074006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
