      "index": 18,
      "offsetInSection": 2292,
      "rawDecodedUtf16Hex": "004E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Ma qui non c’è niente da ripristinare! I punti base\ndi <U+0010><U+0002>Ă<U+0003> sono già al minimo.",
      "escapedControlUnits": 3,
