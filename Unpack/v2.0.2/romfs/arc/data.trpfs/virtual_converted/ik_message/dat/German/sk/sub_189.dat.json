    },
    {
      "displayText": "Hey! Lass <U+0010><U+0004>ᄀÿഋ<U+0000>den Trainerdie Trainerin doch erst mal antworten!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 5,
