      "index": 3,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "0053006F007200720079002C002000640075002000620069007300740020006A00650074007A00740020007300690063006800650072002000760065007200770069007200720074002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Mein Blitza ist vom Wesen Hastig.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 644,
