      "index": 21,
      "offsetInSection": 2844,
      "rawDecodedUtf16Hex": "0048006100630068002C00200064007500200073006900650068007300740020006A0061002C00200077006100730020005300610063006800650020006900730074002E00200041006C0073006F002000640061006E006E002C000A007400730063006800FC00730073006900200075006E0064002000640061006E006B0065002100100002011401E40000",
