      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Kaum wittert es einen Kampf, schon düst es ab\nzum Kampfplatz...<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "004B00610075006D00200077006900740074006500720074002000650073002000650069006E0065006E0020004B0061006D00700066002C0020007300630068006F006E0020006400FC00730074002000650073002000610062000A007A0075006D0020004B0061006D007000660070006C00610074007A002E002E002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Würdest du also bitte einen Kampf gegen uns\naustragen? Ich warte beim Kampfplatz auf dich.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
