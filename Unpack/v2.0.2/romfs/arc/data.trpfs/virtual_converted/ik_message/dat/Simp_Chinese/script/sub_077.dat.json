      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "超级进化训练家！\n给我们上节超级进化课吧！<U+0010><U+0002>Ĕů",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 812,
