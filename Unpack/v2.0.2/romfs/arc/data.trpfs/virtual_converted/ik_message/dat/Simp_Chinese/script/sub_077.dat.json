      "index": 9,
      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我爸爸在阔星公司工作，\n但却不肯给我超级环。<U+0010><U+0002>Ĕƙ",
