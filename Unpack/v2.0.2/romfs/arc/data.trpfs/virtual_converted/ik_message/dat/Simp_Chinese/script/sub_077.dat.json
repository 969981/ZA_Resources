      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 968,
      "rawDecodedUtf16Hex": "8FDE5B666821768480015E08000A4E5F75284E0D4E868D857EA78FDB53163002001000020114019B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "我也要拿到超级环，\n让搭档超级进化！<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "62114E5F898162FF52308D857EA773AFFF0C000A8BA9642D68638D857EA78FDB5316FF01001000020114019C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
