      "rawDecodedUtf16Hex": "8FD84E0D662F4E0A8BFE768465F650190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "我等！我等！我等你哦！<U+0010><U+0002>Ĕů",
