      "rawDecodedUtf16Hex": "5F884E0D95195427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "好厉害！好厉害！好厉害！<U+0010><U+0002>Ĕů",
