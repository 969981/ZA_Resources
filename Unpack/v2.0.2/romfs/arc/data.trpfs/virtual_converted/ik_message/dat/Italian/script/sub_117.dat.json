      "index": 55,
      "offsetInSection": 5200,
      "rawDecodedUtf16Hex": "004C0061002000470061006C006C006500720069006100200043006C0061006900720020006400650020004C0075006E0065003F0020004D006F006C0074006F00200073007400720061006E006F002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Che Gengar sia andato a fare shopping?\nChe gusti costosi che ha...<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5296,
      "rawDecodedUtf16Hex": "004300680065002000470065006E006700610072002000730069006100200061006E006400610074006F0020006100200066006100720065002000730068006F007000700069006E0067003F000A00430068006500200067007500730074006900200063006F00730074006F007300690020006300680065002000680061002E002E002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Se fosse stato per me sarei andata al Passage de\nl’Ombre, dove c’è La Lanterna. È uno dei miei<U+0010><U+0001>븀\nnegozi preferiti.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5440,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Allora ci vediamo alla Galleria Clair de Lune.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 5680,
      "rawDecodedUtf16Hex": "0041006C006C006F00720061002000630069002000760065006400690061006D006F00200061006C006C0061002000470061006C006C006500720069006100200043006C0061006900720020006400650020004C0075006E0065002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Questo sì che sembra un posto adatto a Gengar!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5784,
      "rawDecodedUtf16Hex": "00510075006500730074006F0020007300EC0020006300680065002000730065006D00620072006100200075006E00200070006F00730074006F002000610064006100740074006F00200061002000470065006E0067006100720021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "<U+0010><U+0002>뷿<",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5888,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hai trovato una pista, Chandelure?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 61,
      "offsetInSection": 5900,
      "rawDecodedUtf16Hex": "004800610069002000740072006F007600610074006F00200075006E0061002000700069007300740061002C0020004300680061006E00640065006C007500720065003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Cha!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 5980,
      "rawDecodedUtf16Hex": "00430068006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Gaaar?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5992,
      "rawDecodedUtf16Hex": "00470061006100610072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Allora? È lui il fuggiasco?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 64,
      "offsetInSection": 6008,
      "rawDecodedUtf16Hex": "0041006C006C006F00720061003F002000C80020006C0075006900200069006C002000660075006700670069006100730063006F003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "No... Il suo verso è completamente diverso.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 6072,
      "rawDecodedUtf16Hex": "004E006F002E002E002E00200049006C002000730075006F00200076006500720073006F002000E800200063006F006D0070006C006500740061006D0065006E007400650020006400690076006500720073006F002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Gengar! Non allontanarti troppo da me, da bravo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6168,
      "rawDecodedUtf16Hex": "00470065006E00670061007200210020004E006F006E00200061006C006C006F006E00740061006E0061007200740069002000740072006F00700070006F0020006400610020006D0065002C00200064006100200062007200610076006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Adesso torniamo a casa. E stasera ti preparo\nlo stufato che ti piace tanto!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 67,
      "offsetInSection": 6268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Gar gaaar!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 6420,
      "rawDecodedUtf16Hex": "00470061007200200067006100610061007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Proviamo ancora una volta, Chandelure.\nNon possiamo arrenderci.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 6444,
      "rawDecodedUtf16Hex": "00500072006F007600690061006D006F00200061006E0063006F0072006100200075006E006100200076006F006C00740061002C0020004300680061006E00640065006C007500720065002E000A004E006F006E00200070006F0073007300690061006D006F00200061007200720065006E00640065007200630069002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Non c’è bisogno. Basta così.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 6580,
      "rawDecodedUtf16Hex": "004E006F006E00200063201900E80020006200690073006F0067006E006F002E00200042006100730074006100200063006F007300EC002E001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Se nemmeno voi siete riusciti a trovarlo...\nAllora non mi resta che lasciar perdere.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 6648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Ma...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 6828,
      "rawDecodedUtf16Hex": "004D0061002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "So cosa pensi. Che se ci tenevo così tanto a quel\nGengar, avrei dovuto catturarlo e diventare<U+0010><U+0001>븀\nil suo Allenatore.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Ma a me importa solo sapere che è da qualche\nparte. Vicino, lontano, va bene lo stesso.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 7088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Ogni relazione è diversa, dopotutto. In ogni caso,\napprezzo che mi abbiate aiutato a cercare il mio<U+0010><U+0001>븀\namico Gengar. Grazie davvero.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 75,
      "offsetInSection": 7272,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "Mi dispiace non aver potuto fare di più...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 7548,
      "rawDecodedUtf16Hex": "004D00690020006400690073007000690061006300650020006E006F006E0020006100760065007200200070006F007400750074006F0020006600610072006500200064006900200070006900F9002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Che Gengar abbia una passione per la moda?\nSarebbe davvero una sorpresa!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 7644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "<U+0010><U+0002>뷿N",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 7800,
      "rawDecodedUtf16Hex": "00100002BDFF004E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>! Guarda un po’ chi è tornato!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 7812,
      "rawDecodedUtf16Hex": "00100002010000000021002000470075006100720064006100200075006E00200070006F20190020006300680069002000E800200074006F0072006E00610074006F0021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Ge...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 7892,
      "rawDecodedUtf16Hex": "00470065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Magari domani ripartirà, e forse senza fare\npiù ritorno... Ma non fa niente.<U+0010><U+0001>븁\nHo imparato ad apprezzare i momenti in cui è\ncon me, e a non chiedere niente di più.<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 7904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 169
    },
    {
      "displayText": "Ho già detto a Imma che Gengar è tornato\na trovarmi!<U+0010><U+0002>Ĕƌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 82,
      "offsetInSection": 8244,
      "rawDecodedUtf16Hex": "0048006F00200067006900E000200064006500740074006F0020006100200049006D006D00610020006300680065002000470065006E006700610072002000E800200074006F0072006E00610074006F000A0061002000740072006F007600610072006D00690021001000020114018C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Ge ge...!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 8360,
      "rawDecodedUtf16Hex": "00470065002000670065002E002E002E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    }
