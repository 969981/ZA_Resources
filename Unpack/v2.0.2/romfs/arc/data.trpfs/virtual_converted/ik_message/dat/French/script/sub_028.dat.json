    },
    {
      "displayText": "Ce Dedenne avait l’air d’absorber de l’électricité\nà l’aide de sa queue.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "0043006500200044006500640065006E006E00650020006100760061006900740020006C2019006100690072002000642019006100620073006F00720062006500720020006400650020006C201900E9006C0065006300740072006900630069007400E9000A00E00020006C20190061006900640065002000640065002000730061002000710075006500750065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Rattrapez-le !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
