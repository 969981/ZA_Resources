  "messages": [
    {
      "displayText": "Qui a gagné ?\nJ’ai une récompense ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 420,
      "rawDecodedUtf16Hex": "005100750069002000610020006700610067006E00E90020003F000A004A20190061006900200075006E00650020007200E90063006F006D00700065006E0073006500200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Voici une récompense pour l<U+0010><U+0003>ᄀÿਉe gagnanta gagnante !\nC’est <U+0010><U+0003>ᐂ<U+0002><U+0000><U+0010><U+0002>Ċ<U+0002>.",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 524,
      "rawDecodedUtf16Hex": "0056006F00690063006900200075006E00650020007200E90063006F006D00700065006E0073006500200070006F007500720020006C00100003110000FF0A0900650020006700610067006E0061006E007400610020006700610067006E0061006E0074006500200021000A0043201900650073007400200010000314020002000000100002010A0002002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "J’ai quelque chose pour toi, en\nl’honneur de ta victoire. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "004A2019006100690020007100750065006C007100750065002000630068006F0073006500200070006F0075007200200074006F0069002C00200065006E000A006C20190068006F006E006E00650075007200200064006500200074006100200076006900630074006F006900720065002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "J’ai un colis pour toi, afin de célébrer ta victoire.\nC’est <U+0010><U+0003>ᐂ<U+0002><U+0000><U+0010><U+0002>ĉ<U+0002>.",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "004A20190061006900200075006E00200063006F006C0069007300200070006F0075007200200074006F0069002C0020006100660069006E0020006400650020006300E9006C00E9006200720065007200200074006100200076006900630074006F006900720065002E000A004320190065007300740020001000031402000200000010000201090002002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Veux-tu que je soigne\ntes Pokémon ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 960,
      "rawDecodedUtf16Hex": "0056006500750078002D0074007500200071007500650020006A006500200073006F00690067006E0065000A00740065007300200050006F006B00E9006D006F006E0020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Allez, je vais soigner tes Pokémon !\nJe suis plus douée pour ça que pour les combats...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Que dirais-tu\nd’un café ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "0051007500650020006400690072006100690073002D00740075000A006420190075006E002000630061006600E90020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Je vais donner à tes Pokémon notre meilleure\nboisson pour les requinquer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Je te sers\nun café ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1476,
      "rawDecodedUtf16Hex": "004A006500200074006500200073006500720073000A0075006E002000630061006600E90020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Tiens, c’est un mélange créé spécialement pour\nles Pokémon. Ça les remettra d’aplomb !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Tu prendras bien une tasse de la\nboisson phare du Néo Café ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Le Café Déflagration est l’un des produits phare\ndu Néo Café. Ça fera du bien à tes Pokémon !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Laisse-toi tenter par la boisson\nphare du Néo Café ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2064,
      "rawDecodedUtf16Hex": "004C00610069007300730065002D0074006F0069002000740065006E00740065007200200070006100720020006C006100200062006F006900730073006F006E000A007000680061007200650020006400750020004E00E9006F002000430061006600E900200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "La spécialité du Néo Café, le Café Flamme Ultime,\nest aussi bon pour les humains que les Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2200,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Je veux bien me séparer\nd’une carte bonus. <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2396,
      "rawDecodedUtf16Hex": "004A0065002000760065007500780020006200690065006E0020006D00650020007300E900700061007200650072000A006420190075006E006500200063006100720074006500200062006F006E00750073002E002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "J’ai mis la main sur des cartes trop cool ce soir.\nTiens, je t’en offre une !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Je distribue\ndes médailles ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2668,
      "rawDecodedUtf16Hex": "004A00650020006400690073007400720069006200750065000A0064006500730020006D00E9006400610069006C006C0065007300200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Voilà toutes les médailles que j’avais réussi\nà rassembler ! Considère ça comme un cadeau.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Qui veut des\nmédailles ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2940,
      "rawDecodedUtf16Hex": "005100750069002000760065007500740020006400650073000A006D00E9006400610069006C006C006500730020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Prends mes médailles, puisque tu as gagné !\nJe pourrai toujours en récupérer plus tard.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Je fais don de\nmes médailles ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3196,
      "rawDecodedUtf16Hex": "004A00650020006600610069007300200064006F006E002000640065000A006D006500730020006D00E9006400610069006C006C0065007300200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Je te remets mes médailles, preuves de ta victoire.\nAvec les compliments de Dame Violine !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Tu ne voudrais pas quelques\nmédailles ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3472,
      "rawDecodedUtf16Hex": "005400750020006E006500200076006F00750064007200610069007300200070006100730020007100750065006C0071007500650073000A006D00E9006400610069006C006C006500730020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "À la fédération, nous concourons pour savoir qui\npeut remporter le plus de médailles en une nuit.<U+0010><U+0001>븀\nExceptionnellement, je vais partager avec toi.",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 3584,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 148
    },
    {
      "displayText": "Vous avez reçu des médailles !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3880,
      "rawDecodedUtf16Hex": "0056006F007500730020006100760065007A00200072006500E7007500200064006500730020006D00E9006400610069006C006C00650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Vous recevez\n<U+0010><U+0003>ᐂ<U+0002><U+0000><U+0010><U+0002>＀<U+0008><U+0010><U+0002>Ċ<U+0002><U+0010><U+0002>＀<U+0000> !",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3944,
      "rawDecodedUtf16Hex": "00100002BD0600000056006F007500730020007200650063006500760065007A000A0010000314020002000000100002FF00000800100002010A000200100002FF000000002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Qui veut des Baies\nextradimensionnelles ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 4020,
      "rawDecodedUtf16Hex": "005100750069002000760065007500740020006400650073002000420061006900650073000A0065007800740072006100640069006D0065006E00730069006F006E006E0065006C006C006500730020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "J’ai trouvé ces <U+0010><U+0001>ခ<U+0010><U+0002>Ċ<U+0002>\nà Extra Illumis ! Je te les offre !",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 4136,
      "rawDecodedUtf16Hex": "004A201900610069002000740072006F0075007600E90020006300650073002000100001100100100002010A0002000A00E000200045007800740072006100200049006C006C0075006D00690073002000210020004A00650020007400650020006C006500730020006F0066006600720065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Qui a besoin de Baies\nextradimensionnelles ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 4256,
      "rawDecodedUtf16Hex": "005100750069002000610020006200650073006F0069006E002000640065002000420061006900650073000A0065007800740072006100640069006D0065006E00730069006F006E006E0065006C006C006500730020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Pour faire honneur à tes aptitudes en combat,\nvoici des <U+0010><U+0001>ခ<U+0010><U+0002>Ċ<U+0002> !",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4376,
      "rawDecodedUtf16Hex": "0050006F0075007200200066006100690072006500200068006F006E006E006500750072002000E00020007400650073002000610070007400690074007500640065007300200065006E00200063006F006D006200610074002C000A0076006F0069006300690020006400650073002000100001100100100002010A0002002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Voulez-vous que je soigne\nvos Pokémon ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4508,
      "rawDecodedUtf16Hex": "0056006F0075006C0065007A002D0076006F0075007300200071007500650020006A006500200073006F00690067006E0065000A0076006F007300200050006F006B00E9006D006F006E0020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Les Pokémon ont toujours besoin de soins, même\ndans un lieu aussi étrange qu’Extra Illumis !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Je vous offre un petit café\nextradimensionnel ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4808,
      "rawDecodedUtf16Hex": "004A006500200076006F007500730020006F006600660072006500200075006E002000700065007400690074002000630061006600E9000A0065007800740072006100640069006D0065006E00730069006F006E006E0065006C0020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Aussi étrange que cela puisse paraître, le café\nsoigne les Pokémon dans l’extradimension !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 4936,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Un petit café ? <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 5120,
      "rawDecodedUtf16Hex": "0055006E002000700065007400690074002000630061006600E90020003F002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "C’est un café spécialement préparé pour\nl’extradimension. Il possède des vertus curatives.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Goûtez au café\ndu Néo Café ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5368,
      "rawDecodedUtf16Hex": "0047006F00FB00740065007A002000610075002000630061006600E9000A006400750020004E00E9006F002000430061006600E900200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Je ne sais pas ce que je fais ici, mais tant pis !\nSoignez vos Pokémon avec ce Café Déflagration !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Essayez donc le café\ndu Néo Café ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 38,
      "offsetInSection": 5656,
      "rawDecodedUtf16Hex": "004500730073006100790065007A00200064006F006E00630020006C0065002000630061006600E9000A006400750020004E00E9006F002000430061006600E900200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Extradimension ou pas, je vous prie de boire ce\nCafé Flamme Ultime pour soigner vos Pokémon !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 5756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "J’ai pas de cartes à donner,\nj’ai beaucoup mieux ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5944,
      "rawDecodedUtf16Hex": "004A20190061006900200070006100730020006400650020006300610072007400650073002000E000200064006F006E006E00650072002C000A006A201900610069002000620065006100750063006F007500700020006D006900650075007800200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Tu trouveras rien de plus rare que\nces <U+0010><U+0001>ခ<U+0010><U+0002>Ċ<U+0002> !",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 6076,
      "rawDecodedUtf16Hex": "00540075002000740072006F0075007600650072006100730020007200690065006E00200064006500200070006C00750073002000720061007200650020007100750065000A006300650073002000100001100100100002010A0002002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "J’ai des objets de luxe ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6176,
      "rawDecodedUtf16Hex": "004A20190061006900200064006500730020006F0062006A0065007400730020006400650020006C00750078006500200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Prends ces <U+0010><U+0001>ခ<U+0010><U+0002>Ċ<U+0002> !\nN’hésite pas, j’en ai encore plein chez moi !",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6260,
      "rawDecodedUtf16Hex": "005000720065006E006400730020006300650073002000100001100100100002010A000200200021000A004E2019006800E900730069007400650020007000610073002C0020006A20190065006E00200061006900200065006E0063006F0072006500200070006C00650069006E0020006300680065007A0020006D006F0069002000210000",
      "trailingZeroPaddingUnits": 1,
