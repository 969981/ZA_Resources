      "rawDecodedUtf16Hex": "00100002BDFF00330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres combatir contra nosotros?<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6596,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200063006F006D0062006100740069007200200063006F006E0074007200610020006E006F0073006F00740072006F0073003F00100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Sí!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 6676,
      "rawDecodedUtf16Hex": "00A1005300ED00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Aún no",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
