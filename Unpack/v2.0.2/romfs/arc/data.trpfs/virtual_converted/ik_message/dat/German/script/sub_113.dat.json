      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Du hast noch <U+0010><U+0002>＀<U+0006>40 Sekunden<U+0010><U+0002>＀<U+0000>.",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 20,
