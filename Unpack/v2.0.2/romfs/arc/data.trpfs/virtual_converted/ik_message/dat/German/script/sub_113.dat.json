      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 4876,
      "rawDecodedUtf16Hex": "004C0061006E006700730061006D00200077006900720064201900730020006D00690072002000650069006E00660061006300680020007A00750020007600690065006C002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Komm schon! Zeig diesem Froxy, was wir\nMenschen, nein, was DU draufhast!<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 4948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Das lob ich mir! Beweise Froxy ein letztes Mal,\nwie toll du bist!<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5104,
      "rawDecodedUtf16Hex": "0044006100730020006C006F006200200069006300680020006D00690072002100200042006500770065006900730065002000460072006F00780079002000650069006E0020006C00650074007A0074006500730020004D0061006C002C000A00770069006500200074006F006C006C00200064007500200062006900730074002100100002011401890000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "<U+0010><U+0002>뷿2",
