      "index": 14,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Auf die Plätze, fertig...<U+0010><U+0002>ĔƉ",
