      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2124,
      "rawDecodedUtf16Hex": "004C004F004F004F00530021002100100002011401890000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
