      "rawDecodedUtf16Hex": "00460072006F006F006F007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Froxy ist bestimmt schon auf dem Weg zum\nnächsten Abschnitt des Parcours.<U+0010><U+0002>ĔƉ",
