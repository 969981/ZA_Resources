      "rawDecodedUtf16Hex": "0044006100730020007700610072201900730021002100100002011401890000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Schade! Die Zeit ist abgelaufen!<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 2,
