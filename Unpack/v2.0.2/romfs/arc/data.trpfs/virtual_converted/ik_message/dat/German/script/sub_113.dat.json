      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2596,
      "rawDecodedUtf16Hex": "004700650073006300680061006100610066006600740021002100100002011401890000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Du hast es in der vorgegebenen Zeit geschafft!!<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 2,
