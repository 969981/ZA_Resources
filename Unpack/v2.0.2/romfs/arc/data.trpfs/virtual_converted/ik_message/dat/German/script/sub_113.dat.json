      "offsetInSection": 4804,
      "rawDecodedUtf16Hex": "004B00650069006E00200050006100720063006F0075007200730020006B0061006E006E0020006D006900630068002000610075006600680061006C00740065006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
