      "offsetInSection": 504,
      "rawDecodedUtf16Hex": "4E3A4E8652A06DF15B9D53EF68A6548C4EBA4E4B95F4768472757ECA202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
