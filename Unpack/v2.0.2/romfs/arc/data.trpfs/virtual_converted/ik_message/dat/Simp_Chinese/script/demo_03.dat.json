      "offsetInSection": 292,
      "rawDecodedUtf16Hex": "4E0D8FC7FF0C8FD167655B834EEC4E5F7ECF5E3857285E02518573B08EAB30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
