      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "我们可以从视觉上\n获取关于密阿雷市的各种资讯了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 628,
