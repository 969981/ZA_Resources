      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 540,
      "rawDecodedUtf16Hex": "9614661F516C53F86B63572863A88FDB90FD5E025F0053D18BA1521230020000",
      "trailingZeroPaddingUnits": 1,
