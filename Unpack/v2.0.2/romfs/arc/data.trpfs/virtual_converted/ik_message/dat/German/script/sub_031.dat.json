      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "So kann es jedem Coiffwaff eine neue Frisur\nschneiden, da bin ich sicher!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
