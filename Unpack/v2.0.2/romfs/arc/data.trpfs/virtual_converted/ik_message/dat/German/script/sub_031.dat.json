      "rawDecodedUtf16Hex": "0053006900630068006C006F007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Vielen Dank an dich und dein Pokémon!<U+0010><U+0002>Ĕł",
