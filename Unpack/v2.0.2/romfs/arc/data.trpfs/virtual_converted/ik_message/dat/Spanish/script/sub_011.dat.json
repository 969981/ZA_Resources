      "rawDecodedUtf16Hex": "005400650020006800610073002000670061006E00610064006F0020006D0065007200650063006900640061006D0065006E0074006500200065006C0020007000720065006D0069006F000A00640065002000310030202F003000300030202FE300002E00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "¡Sin duda posees un gran talento como\nEntrenador<U+0010><U+0003>ᄀÿĀa!<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 7064,
      "rawDecodedUtf16Hex": "00A100530069006E0020006400750064006100200070006F007300650065007300200075006E0020006700720061006E002000740061006C0065006E0074006F00200063006F006D006F000A0045006E007400720065006E00610064006F007200100003110000FF01000061002100100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
