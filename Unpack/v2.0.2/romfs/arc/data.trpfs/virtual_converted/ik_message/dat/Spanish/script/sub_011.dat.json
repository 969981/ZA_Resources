      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 6836,
      "rawDecodedUtf16Hex": "004D006900200069006E0074007500690063006900F3006E0020006E006F0020006D006500200065006E0067006100F1006100620061002C00200065007300200075006E002000420075006400650077000A0066006F0072006D0069006400610062006C0065002E00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
