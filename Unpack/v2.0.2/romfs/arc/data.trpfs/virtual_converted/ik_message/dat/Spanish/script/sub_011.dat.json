      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Tenemos ante nosotros a un Budew de excepción.<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 5592,
      "rawDecodedUtf16Hex": "00540065006E0065006D006F007300200061006E007400650020006E006F0073006F00740072006F00730020006100200075006E0020004200750064006500770020006400650020006500780063006500700063006900F3006E002E00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "¿Cómo encontraste a este Budew?<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 5696,
