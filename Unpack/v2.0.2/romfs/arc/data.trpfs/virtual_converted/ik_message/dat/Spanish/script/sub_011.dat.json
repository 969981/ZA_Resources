      "offsetInSection": 5984,
      "rawDecodedUtf16Hex": "0055006E006F0020006D0075007900200065007300740072006900630074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "¿Hay algún aspecto del día a día que consideres\nesencial a la hora de criar a tus Pokémon?<U+0010><U+0002>Ĕİ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
