      "index": 63,
      "offsetInSection": 6600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Mi intuición no me engañaba, es un Budew\nformidable.<U+0010><U+0002>Ĕİ",
