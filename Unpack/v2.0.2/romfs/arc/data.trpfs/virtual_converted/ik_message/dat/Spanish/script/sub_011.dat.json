      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5844,
      "rawDecodedUtf16Hex": "00BF0051007500E900200063006C00610073006500200064006500200065006E007400720065006E0061006D00690065006E0074006F00200068006100200072006500630069006200690064006F003F00100002011401300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
