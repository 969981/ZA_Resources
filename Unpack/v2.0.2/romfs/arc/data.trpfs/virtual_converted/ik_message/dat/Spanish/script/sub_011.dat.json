      "rawDecodedUtf16Hex": "00460075006500200063006F00730061002000640065006C002000640065007300740069006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "¿Qué clase de entrenamiento ha recibido?<U+0010><U+0002>Ĕİ",
