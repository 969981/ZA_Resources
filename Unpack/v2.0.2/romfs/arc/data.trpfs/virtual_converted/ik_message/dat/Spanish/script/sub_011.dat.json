      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Por casualidad",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 5768,
      "rawDecodedUtf16Hex": "0050006F0072002000630061007300750061006C00690064006100640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
