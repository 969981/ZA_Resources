      "rawDecodedUtf16Hex": "8ACB7B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳願意幫可憐的小毒電\n找一找的話，我會感激不盡的。<U+0010><U+0002>ĔǇ",
      "escapedControlUnits": 4,
