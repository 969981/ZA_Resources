      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "I am SO ready!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1444,
      "rawDecodedUtf16Hex": "004900200061006D00200053004F00200072006500610064007900210000",
      "trailingZeroPaddingUnits": 1,
