      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "00100002BDFF00060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ready to leave your Pokémon and Poké Balls\nbehind...and become a Defenseless Dodger?<U+0010><U+0002>Ĕ<U+000F>",
