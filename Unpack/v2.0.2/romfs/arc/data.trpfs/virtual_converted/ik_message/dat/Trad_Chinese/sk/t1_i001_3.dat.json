      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "用來剪輯影片的筆記型電腦。\n還是別看了吧……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
