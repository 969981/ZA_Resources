      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "桌上也囤積著\n運動飲料。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "684C4E0A4E5F56E47A4D8457000A904B52D598F2659930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
