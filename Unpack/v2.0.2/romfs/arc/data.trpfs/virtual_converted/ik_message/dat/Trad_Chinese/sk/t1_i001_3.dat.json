      "offsetInSection": 308,
      "rawDecodedUtf16Hex": "53055305FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "作為找人的一環而收集的\n密阿雷相關的舊報紙。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "4F5C70BA627E4EBA76844E0074B0800C653696C67684000A5BC6963F96F776F895DC7684820A58317D1930020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
