      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 4656,
      "rawDecodedUtf16Hex": "BCBCB9AC266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
