      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 3456,
      "rawDecodedUtf16Hex": "C815B9D00020C9F8B824BCF80020AC8C0020C544B2C8B0D0B294B370C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "공격할 일은 없을 테니 안심하래요",
