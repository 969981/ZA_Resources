      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "벼리...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 3388,
      "rawDecodedUtf16Hex": "BCBCB9AC002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "<U+0010><U+0002>뷿0",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 3400,
      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "이웃분께서는 뭐라고 하시던가요?<U+0010><U+0002>ĔƬ",
