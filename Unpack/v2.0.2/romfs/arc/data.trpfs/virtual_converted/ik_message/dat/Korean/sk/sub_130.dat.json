      "offsetInSection": 4380,
      "rawDecodedUtf16Hex": "00100002BDFF00450000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "지금부터 서로의 포켓몬을\n대면시키는 겁니다!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 4392,
