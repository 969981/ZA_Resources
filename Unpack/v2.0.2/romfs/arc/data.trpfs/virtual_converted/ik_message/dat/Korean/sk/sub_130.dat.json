      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 3792,
      "rawDecodedUtf16Hex": "C88BC544C6940021000AC9F8B824BCF4C9C00020C54AC558B2E4B2940020AC780020C99DBA85D5740020BCF4C774C8E0002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "어떻게요?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 3852,
      "rawDecodedUtf16Hex": "C5B4B5BBAC8CC694003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "할 수 있어요?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 3864,
      "rawDecodedUtf16Hex": "D5600020C2180020C788C5B4C694003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "핫삼과 벼리짱을\n대면시켜 보면 알 수 있겠죠.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
