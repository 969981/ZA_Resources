      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "포켓몬들의 거리가 가까워진 것 같네요!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
