      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 3412,
      "rawDecodedUtf16Hex": "C774C6C3BD84AED8C11CB2940020BB50B77CACE00020D558C2DCB358AC00C694003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "정말 째려본 게 아니냐는데요",
