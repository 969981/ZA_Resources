      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "벼리!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 4372,
      "rawDecodedUtf16Hex": "BCBCB9AC00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
