      "rawDecodedUtf16Hex": "D2B8B808C774B108B2D8002C000AC624B298C7400020C5ECB7ECBAA8B85C0020AC10C0ACD588C5B4C694002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "앗! 벼리짱!\n거기에 있는 금속은 떼면 안 돼!!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
