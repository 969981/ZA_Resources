      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Bah, esto de que no me sigas el rollo es una lata.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
