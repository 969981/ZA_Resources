      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Hola. Tengo algo para ti.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
