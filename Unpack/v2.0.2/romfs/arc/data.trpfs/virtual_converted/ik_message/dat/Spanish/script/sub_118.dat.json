      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Supongo que ya sabrás qué es lo que voy a darte.<U+0010><U+0002>Ĕ<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 616,
