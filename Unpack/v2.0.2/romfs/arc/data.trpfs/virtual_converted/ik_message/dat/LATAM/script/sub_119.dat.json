      "offsetInSection": 4820,
      "rawDecodedUtf16Hex": "00100002BDFF002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Qué le pasa a este Holotransportador, Peluchín?<U+0010><U+0002>Ĕ<U+0008>",
