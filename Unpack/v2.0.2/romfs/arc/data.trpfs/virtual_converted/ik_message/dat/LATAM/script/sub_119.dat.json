      "offsetInSection": 4432,
      "rawDecodedUtf16Hex": "0047007200610063006900610073002C002000500065006C00750063006800ED006E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
