      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5024,
      "rawDecodedUtf16Hex": "00A100450073007000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
