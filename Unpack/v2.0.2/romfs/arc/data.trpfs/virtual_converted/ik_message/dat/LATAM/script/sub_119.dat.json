      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 4480,
      "rawDecodedUtf16Hex": "0054006F006D0065006D006F007300200075006E002000640065007300630061006E007300690074006F0020007000610072006100200063006F006D00650072002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¡Estaba delicioso!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4556,
      "rawDecodedUtf16Hex": "00A1004500730074006100620061002000640065006C006900630069006F0073006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Bueno, ¿nos vas a mostrar ahora a dónde querías\nir, Peluchín?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4604,
