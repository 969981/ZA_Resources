      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Puedes oír los pensamientos de Matière en tu\ncabeza gracias al poder de Peluchín.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "...<U+0010><U+0001>븁\n(¿Qué le pasa a Peluchín?).<U+0010><U+0001>븁\n(Ay, me ruge la tripa...).",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4112,
      "rawDecodedUtf16Hex": "002E002E002E00100001BE01000A002800BF0051007500E90020006C00650020007000610073006100200061002000500065006C00750063006800ED006E003F0029002E00100001BE01000A002800410079002C0020006D0065002000720075006700650020006C0061002000740072006900700061002E002E002E0029002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
