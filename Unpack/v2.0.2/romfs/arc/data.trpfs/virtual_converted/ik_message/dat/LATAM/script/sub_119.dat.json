      "rawDecodedUtf16Hex": "00100002BD06000000A100560061006D006F0073002C002000100002010000000021000A00A100530069006700E1006D006F0073006C006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3852,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Peluchín, ¿me estás leyendo la mente?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3864,
