      "offsetInSection": 4760,
      "rawDecodedUtf16Hex": "00A100450073007000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡Tras él, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 43,
