      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Y por su culpa el Holotransportador ha quedado\nfuera de servicio.<U+0010><U+0002>ĔŖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 624,
