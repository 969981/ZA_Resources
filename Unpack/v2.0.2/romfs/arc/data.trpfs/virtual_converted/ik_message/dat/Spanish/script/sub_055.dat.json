      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Podrías echar de aquí al Pokémon que se\nha instalado delante del Holotransportador?<U+0010><U+0002>ĔŖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 932,
