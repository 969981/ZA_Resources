    },
    {
      "displayText": "Mira esto. Hay un hoyo enorme delante\ndel Holotransportador.<U+0010><U+0002>ĔŖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "004D0069007200610020006500730074006F002E002000480061007900200075006E00200068006F0079006F00200065006E006F0072006D0065002000640065006C0061006E00740065000A00640065006C00200048006F006C006F007400720061006E00730070006F0072007400610064006F0072002E00100002011401560000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Quizá algún Pokémon salvaje ha excavado aquí\nsu madriguera.<U+0010><U+0002>ĔŖ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
