      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1504,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "¡Adelante!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1680,
      "rawDecodedUtf16Hex": "00A1004100640065006C0061006E0074006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Ahora no",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "00410068006F007200610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡Naaa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1724,
      "rawDecodedUtf16Hex": "00A1004E00610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Atrapa a ese Nacli, por favor. ¡Seguro que fue\nel causante de que el café esté salado de repente!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
