      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 880,
      "rawDecodedUtf16Hex": "0045007300200069006D0070006F007300690062006C006500200071007500650020007300650061002000730061006C00610064006F002E00100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "¡Naaa!",
