      "rawDecodedUtf16Hex": "004E006F002000700075006400690073007400650020006100740072006100700061007200200061006C0020004E00610063006C0069002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
