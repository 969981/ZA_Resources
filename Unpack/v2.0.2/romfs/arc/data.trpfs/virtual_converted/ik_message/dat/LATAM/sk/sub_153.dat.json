      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1944,
      "rawDecodedUtf16Hex": "00A100BF00510075006900E9006E0020006C0065002000650063006800F3002000730061006C002000610020006D0069002000630061006600E9003F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
