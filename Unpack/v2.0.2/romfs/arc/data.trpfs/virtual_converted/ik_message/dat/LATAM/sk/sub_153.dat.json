      "index": 6,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "00A1004E00610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "¡Un Nacli! ¡El Pokémon Halita!<U+0010><U+0002>Ĕǀ",
