      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Eres un<U+0010><U+0003>ᄀÿĀa Entrenador<U+0010><U+0003>ᄀÿĀa, ¿verdad? ¡Ayúdame!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 8,
      "offsetInSection": 1036,
      "rawDecodedUtf16Hex": "004500720065007300200075006E00100003110000FF0100006100200045006E007400720065006E00610064006F007200100003110000FF01000061002C002000BF007600650072006400610064003F002000A10041007900FA00640061006D0065002100100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Atrapa a ese Nacli, por favor. ¡Seguro que fue\nel causante de que el café esté salado de repente!<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
