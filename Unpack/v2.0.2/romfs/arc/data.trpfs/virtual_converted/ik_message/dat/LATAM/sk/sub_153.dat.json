      "index": 2,
      "offsetInSection": 604,
      "rawDecodedUtf16Hex": "00A10047007500E100630061006C006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "¡Este café está salado! ¡Qué asco!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "00A10045007300740065002000630061006600E9002000650073007400E1002000730061006C00610064006F0021002000A10051007500E90020006100730063006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "¿Cómo? Si precisamente nuestro blend Rubor\nes famoso por su suavidad y su dulce aroma.<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 696,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
