      "rawDecodedUtf16Hex": "00A100440069007300660072007500740061002000640065006C00200074006F00710075006500200073006F00660069007300740069006300610064006F000A0064006500200075006E0061002000740061007A006100200064006500200062006C0065006E00640020005200750062006F007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Bienvenid<U+0010><U+0003>ᄀÿāoa al Café Rubor, para los que quieren\nsocializar... pero de lejitos.<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 4,
