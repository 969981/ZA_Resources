      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "È questo il segreto per diventare sempre\npiù amici con loro!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "00C8002000710075006500730074006F00200069006C0020007300650067007200650074006F002000700065007200200064006900760065006E0074006100720065002000730065006D007000720065000A0070006900F900200061006D00690063006900200063006F006E0020006C006F0072006F002100100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Mi raccomando, passa anche tu tanto tempo\nassieme a<U+0010><U+0003>ᄁý؅l tuoi tuoi Pokémon!<U+0010><U+0002>ĔĹ",
