      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2100,
      "rawDecodedUtf16Hex": "00410068002C0020006D00610020006F007200610020006300680065002000630069002000700065006E0073006F002E002E002E00100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Di sicuro i miei Pokémon saranno scossi per aver\nperso!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2164,
      "rawDecodedUtf16Hex": "00440069002000730069006300750072006F002000690020006D00690065006900200050006F006B00E9006D006F006E00200073006100720061006E006E006F002000730063006F007300730069002000700065007200200061007600650072000A0070006500720073006F002100100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Devo farli riposare un po’ al caffè, come sempre!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2284,
      "rawDecodedUtf16Hex": "004400650076006F0020006600610072006C00690020007200690070006F007300610072006500200075006E00200070006F201900200061006C0020006300610066006600E8002C00200063006F006D0065002000730065006D007000720065002100100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
