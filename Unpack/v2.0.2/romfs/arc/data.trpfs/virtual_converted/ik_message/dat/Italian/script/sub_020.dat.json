      "rawDecodedUtf16Hex": "004D0061002000740075002000650020006C0061002000740075006100200073007100750061006400720061002000730069006500740065002000700072006F007000720069006F000A0063006F006F007200640069006E006100740069007300730069006D0069002100100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Scommetto che hai lo stesso livello di amicizia\nche ho io con i miei Pokémon!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 8,
      "index": 18,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
