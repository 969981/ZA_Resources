      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "00420065006E0065002C00200061006C006C006F007200610020006300680065002000730069006100200075006E00610020006C006F00740074006100200061006C006C20190069006E007300650067006E0061000A00640065006C006C20190061006D006900630069007A00690061002100100002011401390000",
      "trailingZeroPaddingUnits": 1,
