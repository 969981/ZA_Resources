      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Però penso che nessuno sia al nostro livello.<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "00500065007200F2002000700065006E0073006F00200063006800650020006E0065007300730075006E006F002000730069006100200061006C0020006E006F007300740072006F0020006C006900760065006C006C006F002E00100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "I miei Pokémon all’inizio erano un Cleffa\ne un Buneary.<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 4,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "00490020006D00690065006900200050006F006B00E9006D006F006E00200061006C006C20190069006E0069007A0069006F0020006500720061006E006F00200075006E00200043006C0065006600660061000A006500200075006E002000420075006E0065006100720079002E00100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Poi, dopo tanti viaggi insieme, si sono evoluti\nin Clefairy e Lopunny!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Sai, questi Pokémon non si evolvono se non\nsono molto amici dei propri Allenatori!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Che idea! Perché non lottiamo, così puoi vedere\nquanto sono amica dei miei Pokémon?<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Fammi sapere quando puoi lottare con me!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1300,
      "rawDecodedUtf16Hex": "00460061006D006D006900200073006100700065007200650020007100750061006E0064006F002000700075006F00690020006C006F0074007400610072006500200063006F006E0020006D0065002100100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1392,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Lotta con me, Clefairy e Lopunny: la squadra\ndell’amicizia!<U+0010><U+0002>ĔĹ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "004C006F00740074006100200063006F006E0020006D0065002C00200043006C006500660061006900720079002000650020004C006F00700075006E006E0079003A0020006C006100200073007100750061006400720061000A00640065006C006C20190061006D006900630069007A00690061002100100002011401390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Lottiamo!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1532,
      "rawDecodedUtf16Hex": "004C006F0074007400690061006D006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
