      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "00100002BDFF000A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "請用寶可夢的招式，把噴水池前\n那礙事的藤蔓痕跡燒掉吧。<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 832,
      "rawDecodedUtf16Hex": "8ACB75285BF653EF5922768462DB5F0FFF0C628A56746C346C60524D000A90A379194E8B768485E4851375D58DE171D2638954273002001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000C>",
