      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "是我眼花了嗎！？<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "662F6211773C82B14E8655CEFF01FF1F001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "藤蔓痕跡不減反增！\n這是怎麼回事！？<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1008,
      "rawDecodedUtf16Hex": "85E4851375D58DE14E0D6E1B53CD589EFF01000A9019662F600E9EBC56DE4E8BFF01FF1F001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "痕跡變多，\n我的請求也會變多！<U+0010><U+0002>ĔŻ",
