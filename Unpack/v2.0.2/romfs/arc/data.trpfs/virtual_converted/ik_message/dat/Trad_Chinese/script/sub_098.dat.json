      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "啊啊！寶可夢小木靈！\n是這傢伙在礙我的事！？<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1612,
      "rawDecodedUtf16Hex": "554A554AFF015BF653EF59225C0F67289748FF01000A662F901950A24F1957287919621176844E8BFF01FF1F001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "小嘀～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "5C0F5600FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "距離比賽沒剩幾天，我已經是火燒屁股了，\n你為什麼要欺負我。<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "8DDD96E26BD48CFD6C9252695E7E5929FF0C62115DF27D93662F706B71D25C4180A14E86FF0C000A4F6070BA4EC09EBC89816B3A8CA062113002001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "啊！從天而降的靈感！\n小木靈與噴水池！<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "554AFF015F9E5929800C964D76849748611FFF01000A5C0F67289748820756746C346C60FF01001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "讓噴水池加上小木靈，\n等於是對當今密阿雷的一種觀點。<U+0010><U+0001>븁\n小木靈！\n你來當我這幅畫的模特兒。<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 1792,
      "rawDecodedUtf16Hex": "8B9356746C346C6052A04E0A5C0F67289748FF0C000A7B4965BC662F5C0D75764ECA5BC6963F96F776844E007A2E89C09EDE300200100001BE01000A5C0F67289748FF01000A4F604F867576621190195E45756B76846A21727951523002001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "小嘀！？",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 1896,
      "rawDecodedUtf16Hex": "5C0F5600FF01FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我們兩個合作的話，\n肯定能將世紀大傑作送進密阿雷美術館！<U+0010><U+0001>븁\n在我完成這幅畫之前，小木靈，\n你就在那裡不准動喔！<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 1908,
      "rawDecodedUtf16Hex": "621150115169500B54084F5C76848A71FF0C000A80AF5B9A80FD5C074E167D00592750914F5C900190325BC6963F96F77F8E88539928FF0100100001BE01000A572862115B8C621090195E45756B4E4B524DFF0C5C0F67289748FF0C000A4F605C31572890A388E14E0D51C652D55594FF01001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "小嘀～……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "5C0F5600FF5E202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "謝謝！多虧有<U+0010><U+0003>ᄀÿā你妳，\n這次比賽的優勝非我莫屬了！<U+0010><U+0002>ĔŻ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "8B1D8B1DFF01591A8667670900100003110000FF01014F6059B3FF0C000A90196B216BD48CFD7684512A52DD975E621183AB5C6C4E86FF01001000020114017B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
