      "index": 106,
      "offsetInSection": 4472,
      "rawDecodedUtf16Hex": "621190FD8981559C6B224E0A72E08FA369124E86FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "光是闻着香味，我就要流泪了！\n我好爱狠辣椒。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 107,
