      "flagsUpper16": 0,
      "index": 108,
      "offsetInSection": 4544,
      "rawDecodedUtf16Hex": "00100002BDFF006C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "辣椒庆典是一场\n疯狂的盛会。",
