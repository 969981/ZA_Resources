      "rawDecodedUtf16Hex": "8FA369125E865178FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "升到三星的确也很重要，\n但今天客人们的笑容更加重要。<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 120,
      "offsetInSection": 4808,
      "rawDecodedUtf16Hex": "534752304E09661F7684786E4E5F5F8891CD8981FF0C000A4F464ECA59295BA24EBA4EEC76847B115BB966F452A091CD89813002001000020114013B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
