      "rawDecodedUtf16Hex": "5149662F95FB774099995473FF0C62115C3189816D416CEA4E86FF01000A6211597D723172E08FA3691230020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "<U+0010><U+0002>뷿l",
