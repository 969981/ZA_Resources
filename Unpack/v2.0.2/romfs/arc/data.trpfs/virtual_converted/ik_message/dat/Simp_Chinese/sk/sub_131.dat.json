      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "辣党有！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 116,
      "offsetInSection": 4760,
      "rawDecodedUtf16Hex": "8FA3515A6709FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
