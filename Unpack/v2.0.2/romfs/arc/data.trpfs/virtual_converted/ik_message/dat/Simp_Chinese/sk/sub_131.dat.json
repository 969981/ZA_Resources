      "offsetInSection": 1160,
      "rawDecodedUtf16Hex": "523A6FC0FF01FF01001000020114013B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "简单来说的话！<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1180,
      "rawDecodedUtf16Hex": "7B80535567658BF476848BDDFF01001000020114013B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "就是辣党有、辣党吃、辣党享的……<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
