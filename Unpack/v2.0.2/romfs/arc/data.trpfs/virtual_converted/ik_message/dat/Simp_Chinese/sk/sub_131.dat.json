      "index": 110,
      "offsetInSection": 4588,
      "rawDecodedUtf16Hex": "505A8FD94E2A7B56521276844EBA000A8111888B91CC90FD572860F34EC04E485462FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "呀哈～！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 111,
      "offsetInSection": 4628,
      "rawDecodedUtf16Hex": "544054C8FF5EFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "辣椒精华真是个\n了不得的招式啊！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
