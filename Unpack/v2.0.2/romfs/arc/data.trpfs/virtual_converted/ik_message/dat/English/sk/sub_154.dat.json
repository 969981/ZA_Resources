      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3328,
      "rawDecodedUtf16Hex": "004E002D006E006F002C0020006E00650076006500720020006D0069006E0064002E002E002E00200049002000730068006F0075006C0064006E20190074002000680061007600650020006500760065006E002000610073006B00650064002E002E002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "Instead, I’ll collect enough coins to evolve a\nGimmighoul on my own!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 3440,
      "rawDecodedUtf16Hex": "0049006E00730074006500610064002C002000492019006C006C00200063006F006C006C00650063007400200065006E006F00750067006800200063006F0069006E007300200074006F002000650076006F006C0076006500200061000A00470069006D006D006900670068006F0075006C0020006F006E0020006D00790020006F0077006E002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Let’s golden-GO!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3588,
      "rawDecodedUtf16Hex": "004C006500742019007300200067006F006C00640065006E002D0047004F002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Gholdengo’s brilliance even makes ME shine!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3632,
      "rawDecodedUtf16Hex": "00470068006F006C00640065006E0067006F201900730020006200720069006C006C00690061006E006300650020006500760065006E0020006D0061006B006500730020004D00450020007300680069006E0065002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "I can’t possibly repay you for all that effort you put\ninto evolving Gimmighoul.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 31,
      "offsetInSection": 3728,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "<U+0010><U+0002>뷿 ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
