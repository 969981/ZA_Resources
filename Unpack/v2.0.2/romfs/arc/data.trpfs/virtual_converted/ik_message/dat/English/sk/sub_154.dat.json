      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2848,
      "rawDecodedUtf16Hex": "00440069006400200079006F0075002000650076006F006C00760065002000470069006D006D006900670068006F0075006C003F002000530068006F00770020006D00650021002000530068006F00770020006D0065002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Whoaaa. It’s...blinding.<U+0010><U+0002>Ĕǁ",
