      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Look. I know this sounds rich coming from me,\nbut I gotta ask...<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3008,
      "rawDecodedUtf16Hex": "004C006F006F006B002E002000490020006B006E006F00770020007400680069007300200073006F0075006E006400730020007200690063006800200063006F006D0069006E0067002000660072006F006D0020006D0065002C000A0062007500740020004900200067006F007400740061002000610073006B002E002E002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Gimme that Gholdengo! Please! Pretty please!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3148,
      "rawDecodedUtf16Hex": "00470069006D006D006500200074006800610074002000470068006F006C00640065006E0067006F002100200050006C00650061007300650021002000500072006500740074007900200070006C0065006100730065002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Sure, you can have it",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3248,
      "rawDecodedUtf16Hex": "0053007500720065002C00200079006F0075002000630061006E002000680061007600650020006900740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Wait, wait—what?",
