      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "You received 413 Gimmighoul Coins!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2112,
      "rawDecodedUtf16Hex": "0059006F00750020007200650063006500690076006500640020003400310033002000470069006D006D006900670068006F0075006C00200043006F0069006E007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Please evolve my Gimmighoul for me!<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "0050006C0065006100730065002000650076006F006C007600650020006D0079002000470069006D006D006900670068006F0075006C00200066006F00720020006D0065002100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Here are all the Gimmighoul Coins I managed to\ncollect in Paldea.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "0048006500720065002000610072006500200061006C006C0020007400680065002000470069006D006D006900670068006F0075006C00200043006F0069006E0073002000490020006D0061006E006100670065006400200074006F000A0063006F006C006C00650063007400200069006E002000500061006C006400650061002E00100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Come show me once you’ve managed to evolve\nmy Gimmighoul!<U+0010><U+0001>븁\nYou should be able to evolve it once you’ve got\n999 Gimmighoul Coins!<U+0010><U+0002>Ĕǁ",
