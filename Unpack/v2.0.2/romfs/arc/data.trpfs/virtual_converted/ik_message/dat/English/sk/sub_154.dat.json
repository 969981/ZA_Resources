      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3292,
      "rawDecodedUtf16Hex": "0057006100690074002C0020007700610069007420140077006800610074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
