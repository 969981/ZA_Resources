      "offsetInSection": 3900,
      "rawDecodedUtf16Hex": "00100002BDFF00200000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "I managed to get a Gholdengo as my partner, and\nit was all thanks to your hard work!<U+0010><U+0001>븁\nThanks, friend! I hope my appreciation makes it all\nfeel worth it.<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 33,
      "offsetInSection": 3912,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 159
    },
    {
