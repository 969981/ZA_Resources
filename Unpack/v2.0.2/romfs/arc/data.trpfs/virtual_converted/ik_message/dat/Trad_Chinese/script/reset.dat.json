      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "我是空溜溜大姐頭。\n今後還請多指教啊。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 300,
