      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Magnifique! ¿List<U+0010><U+0003>ᄀÿāoa para el siguiente combate?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
