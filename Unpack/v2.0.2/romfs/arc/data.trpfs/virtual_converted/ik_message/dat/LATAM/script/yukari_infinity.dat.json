      "escapedControlUnits": 9,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2076,
      "rawDecodedUtf16Hex": "00410068002C002000BF0065006E00200073006500720069006F003F002000BF0044006500730070007500E9007300200064006500200010000302050002002C00200063006F006D0062006100740065001000031101000201000073003F00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
