      "rawDecodedUtf16Hex": "0050006F0072002000610068006F007200610020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Très bien!<U+0010><U+0002>Ĕ<U+0015>",
