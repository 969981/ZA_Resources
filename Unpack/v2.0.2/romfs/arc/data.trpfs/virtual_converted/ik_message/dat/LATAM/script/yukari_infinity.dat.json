      "offsetInSection": 1664,
      "rawDecodedUtf16Hex": "0054007200E800730020006200690065006E002100100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Veamos... ¡Es hora del combate número <U+0010><U+0003>ȅ<U+0002>,!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
