      "rawDecodedUtf16Hex": "5C318AAA54273002000A767C97F3807D8D774F865C314E0D662F5BC6963F96F781543002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "要是<U+0010><U+0003>ᄀÿā你妳願意再配合一些，\n我就好辦事了。<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1000,
      "rawDecodedUtf16Hex": "8981662F00100003110000FF01014F6059B39858610F518D914D54084E004E9BFF0C000A62115C31597D8FA64E8B4E863002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "我再確認一次，\n這隻黏黏寶不是<U+0010><U+0003>ᄀÿā你妳的寶可夢？<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 27,
