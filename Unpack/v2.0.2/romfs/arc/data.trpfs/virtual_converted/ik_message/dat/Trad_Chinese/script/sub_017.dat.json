      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "4E5F5C31662F5F85696D4E2D56C93002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "太可疑了。<U+0010><U+0002>Ĕ+",
