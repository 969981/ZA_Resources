      "rawDecodedUtf16Hex": "6211518D78BA8A8D4E006B21FF0C000A901996BB9ECF9ECF5BF64E0D662F00100003110000FF01014F6059B376845BF653EF5922FF1F001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "不是",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1124,
      "rawDecodedUtf16Hex": "4E0D662F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "我不認識牠",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "62114E0D8A8D8B5872600000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "要是對我說謊，\n事情是會鬧大的喔。<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1144,
      "rawDecodedUtf16Hex": "8981662F5C0D62118AAA8B0AFF0C000A4E8B60C5662F67039B275927768455943002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "黏噢～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "9ECF5662FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "既然不是<U+0010><U+0003>ᄀÿā你妳的寶可夢，\n牠怎麼還這麼黏<U+0010><U+0003>ᄀÿā你妳。<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "65E271364E0D662F00100003110000FF01014F6059B376845BF653EF5922FF0C000A7260600E9EBC908490199EBC9ECF00100003110000FF01014F6059B33002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "要說牠不是<U+0010><U+0003>ᄀÿā你妳的寶可夢的話，\n就讓我看看<U+0010><U+0003>ᄀÿā你妳的同行寶可夢吧。<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "89818AAA72604E0D662F00100003110000FF01014F6059B376845BF653EF592276848A71FF0C000A5C318B936211770B770B00100003110000FF01014F6059B37684540C884C5BF653EF592254273002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳聽得懂我的意思吧。\n我要在寶可夢對戰中瞧瞧牠們。<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B3807D5F9761C262117684610F601D54273002000A6211898157285BF653EF59225C0D62304E2D77A777A7726050113002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "<U+0010><U+0002>뷿#",
      "escapedControlUnits": 2,
