      "rawDecodedUtf16Hex": "592A53EF75914E863002001000020114002B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "說起來<U+0010><U+0003>ᄀÿā你妳根本就不是\n密阿雷的人吧。<U+0010><U+0002>Ĕ+",
      "escapedControlUnits": 4,
