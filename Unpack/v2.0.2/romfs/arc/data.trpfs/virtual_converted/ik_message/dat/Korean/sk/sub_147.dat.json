      "rawDecodedUtf16Hex": "D3ECCF13BAACACFC0020BCFCC7440020C0ACC6A9D558C9C00020C54AACE0000AACC4C18DD574C11C0020C57CC0DD0020D3ECCF13BAACC7580020ACF5ACA9C7440020D53CD558B29400100001BE00000AB9E8BAB80020C11CBC14C774BC84C5D00020B3C4C804D5740020BCFCB798003F001000020114000F0000",
      "trailingZeroPaddingUnits": 1,
