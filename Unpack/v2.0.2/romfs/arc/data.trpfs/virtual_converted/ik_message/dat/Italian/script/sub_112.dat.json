      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Se vuoi portare con te questo Fennekin, dovrai\nprima fare un po’ di spazio nei tuoi box!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
