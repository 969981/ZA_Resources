      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5340,
      "rawDecodedUtf16Hex": "004B006900690069006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Hai ottenuto Fennekin!",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 5356,
      "rawDecodedUtf16Hex": "0048006100690020006F007400740065006E00750074006F002000460065006E006E0065006B0069006E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Mi raccomando, prenditi cura di Fennekin!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5404,
