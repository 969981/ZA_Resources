      "offsetInSection": 5028,
      "rawDecodedUtf16Hex": "004B0049004E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ma è fantastico...! Fennekin sembra come nuovo!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 5040,
      "rawDecodedUtf16Hex": "004D0061002000E8002000660061006E007400610073007400690063006F002E002E002E0021002000460065006E006E0065006B0069006E002000730065006D00620072006100200063006F006D00650020006E0075006F0076006F002100100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "KIIIN!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 5144,
      "rawDecodedUtf16Hex": "004B004900490049004E00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Oh oh oh! Sembra proprio che Fennekin si sia\naffezionato a te! Vuoi prenderlo con te?<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 5160,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
