      "offsetInSection": 4524,
      "rawDecodedUtf16Hex": "00100002BDFF001B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Un Rametto energizzante...?! Incredibile!<U+0010><U+0001>븁\nSapevo che l’erborista avrebbe saputo cosa fare!\nE grazie infinite a te per averlo trovato!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 28,
      "offsetInSection": 4536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "Proviamo subito a farlo sgranocchiare a Fennekin.<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4820,
      "rawDecodedUtf16Hex": "00500072006F007600690061006D006F002000730075006200690074006F002000610020006600610072006C006F00200073006700720061006E006F006300630068006900610072006500200061002000460065006E006E0065006B0069006E002E00100002011401880000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Hai dato il Rametto energizzante a Fennekin!<U+0010><U+0002>Ĕƈ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 30,
      "offsetInSection": 4928,
