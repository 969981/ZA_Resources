      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Che grattacapo questi Beldum che bloccano\nl’Holotrasporto...<U+0010><U+0002>Ĕř",
