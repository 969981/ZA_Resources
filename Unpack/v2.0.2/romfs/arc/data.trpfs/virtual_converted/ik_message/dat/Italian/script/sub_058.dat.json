      "offsetInSection": 1652,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hai davvero scacciato i Beldum! Grazie mille!<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 1664,
      "rawDecodedUtf16Hex": "0048006100690020006400610076007600650072006F002000730063006100630063006900610074006F00200069002000420065006C00640075006D00210020004700720061007A006900650020006D0069006C006C0065002100100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Ooooh! Finalmente si potrà...<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "004F006F006F006F00680021002000460069006E0061006C006D0065006E0074006500200073006900200070006F0074007200E0002E002E002E00100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Ma... Ma... Sono di nuovo qui?!<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "004D0061002E002E002E0020004D0061002E002E002E00200053006F006E006F0020006400690020006E0075006F0076006F0020007100750069003F002100100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Accidenti... Perché capitano tutte a me...?<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 1904,
