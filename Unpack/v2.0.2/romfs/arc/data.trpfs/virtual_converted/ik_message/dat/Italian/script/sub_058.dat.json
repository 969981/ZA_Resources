      "rawDecodedUtf16Hex": "0043006800650020006700720061007400740061006300610070006F0020007100750065007300740069002000420065006C00640075006D002000630068006500200062006C006F006300630061006E006F000A006C20190048006F006C006F00740072006100730070006F00720074006F002E002E002E00100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "<U+0010><U+0002>뷿\t",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Dei Pokémon selvatici si sono raggruppati attorno\na un Holotrasporto...<U+0010><U+0001>븁\nVuoi lottare contro di loro per liberare il passaggio\ne utilizzarlo?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 144
    },
    {
