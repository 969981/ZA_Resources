      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "它叫做盐石宝，\n身体由岩盐组成。<U+0010><U+0001>븀\n它走路时会磨损，掉下盐来。<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1168,
      "rawDecodedUtf16Hex": "5B8353EB505A76D077F35B9DFF0C000A8EAB4F5375315CA976D07EC46210300200100001BE00000A5B838D708DEF65F64F1A78E8635FFF0C63894E0B76D06765300200100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "变咸的咖啡\n我们会为您更换……<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "53D854B8768454965561000A62114EEC4F1A4E3A60A866F463622026202600100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "那之后我继续喝了几口，\n现在已经迷上咸味咖啡了！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "90A34E4B540E62117EE77EED559D4E8651E053E3FF0C000A73B057285DF27ECF8FF74E0A54B85473549655614E86FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
