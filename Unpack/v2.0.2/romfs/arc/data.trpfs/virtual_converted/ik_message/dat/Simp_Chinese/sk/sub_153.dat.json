      "index": 3,
      "offsetInSection": 436,
      "rawDecodedUtf16Hex": "8FD9549655614E5F592A54B84E865427FF01FF1F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "我家帕生混合咖啡的卖点\n明明是淡淡的甜味和香气。<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 460,
      "rawDecodedUtf16Hex": "62115BB65E15751F6DF75408549655617684535670B9000A660E660E662F6DE16DE17684751C5473548C99996C14300200100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "不可能会有咸味才对啊。<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 520,
      "rawDecodedUtf16Hex": "4E0D53EF80FD4F1A670954B85473624D5BF9554A300200100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "盐盐～",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "76D076D0FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "那是盐石宝！\n岩盐宝可梦，盐石宝。<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 560,
      "rawDecodedUtf16Hex": "90A3662F76D077F35B9DFF01000A5CA976D05B9D53EF68A6FF0C76D077F35B9D300200100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "这位训练家，\n就拜托你了！<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 604,
      "rawDecodedUtf16Hex": "8FD94F4D8BAD7EC35BB6FF0C000A5C3162DC62584F604E86FF0100100002011401C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "咖啡会变咸，\n是不是和那只盐石宝有关呢？<U+0010><U+0001>븀\n我想调查一下，请你捉住它吧！<U+0010><U+0002>Ĕǀ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 640,
