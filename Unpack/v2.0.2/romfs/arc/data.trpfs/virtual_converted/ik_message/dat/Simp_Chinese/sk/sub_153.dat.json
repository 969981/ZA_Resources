      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1336,
      "rawDecodedUtf16Hex": "52A076D0559D768454965561FF0C000A786E5B9E4E5F662F6709768454E630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "请一定要把它加进\n帕生咖啡店的新菜单。",
      "escapedControlUnits": 0,
