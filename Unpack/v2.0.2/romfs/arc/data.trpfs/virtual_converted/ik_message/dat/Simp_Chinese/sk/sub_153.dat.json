      "offsetInSection": 424,
      "rawDecodedUtf16Hex": "597D54B8FF5EFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "这咖啡也太咸了吧！？",
