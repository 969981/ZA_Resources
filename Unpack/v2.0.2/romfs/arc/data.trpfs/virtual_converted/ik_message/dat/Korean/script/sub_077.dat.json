      "offsetInSection": 2644,
      "rawDecodedUtf16Hex": "BA54AC00C804B8E10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "메가썬더볼트",
      "escapedControlUnits": 0,
