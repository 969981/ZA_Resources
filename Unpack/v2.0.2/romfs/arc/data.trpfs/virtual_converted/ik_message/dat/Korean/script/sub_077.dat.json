      "rawDecodedUtf16Hex": "BA54AC00C36CB354BCFCD2B80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "메가루카리오는\n격투타입이랑 강철타입 모두 그대로잖아!<U+0010><U+0002>Ĕƙ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 2672,
