      "rawDecodedUtf16Hex": "BA54AC00C7A5D06CB85CB2E4C77C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "맞아요. 셋은 서로 상성이 맞물리니까\n전부 다 정답이에요!<U+0010><U+0002>ĔƜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 3032,
