    },
    {
      "displayText": "再更大！要再更大啊！\n我要的是更大的火力啊啊！！<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 168,
