      "rawDecodedUtf16Hex": "71C371D25427FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "還是算了",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 732,
      "rawDecodedUtf16Hex": "9084662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "真冷淡。\n這樣下去客人都要失望了。<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 744,
      "rawDecodedUtf16Hex": "771F51B76DE13002000A90196A234E0B53BB5BA24EBA90FD89815931671B4E863002001000020114013B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "拜託了，打出一場火熱得就像是\n要被火屬性招式灼傷似的對戰吧！<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 788,
