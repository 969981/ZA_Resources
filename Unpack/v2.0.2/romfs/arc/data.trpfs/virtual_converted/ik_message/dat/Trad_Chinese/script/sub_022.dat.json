      "index": 12,
      "offsetInSection": 860,
      "rawDecodedUtf16Hex": "00100002BDFF000C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "真是一場連我這個訓練家\n都快要燒起來的對戰。<U+0010><U+0002>ĔĻ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
