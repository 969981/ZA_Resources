{
  "declaredLength": 11312,
  "decoding": "confirmed-per-slot-XOR-rotate3-index-seed",
  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Hey, du. Macht es dich auch nervös, wenn dich\njemand anstarrt?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 756,
      "rawDecodedUtf16Hex": "004800650079002C002000640075002E0020004D006100630068007400200065007300200064006900630068002000610075006300680020006E00650072007600F60073002C002000770065006E006E00200064006900630068000A006A0065006D0061006E006400200061006E007300740061007200720074003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ja, schon...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 892,
      "rawDecodedUtf16Hex": "004A0061002C0020007300630068006F006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Äh, warum fragst du?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "00C40068002C00200077006100720075006D0020006600720061006700730074002000640075003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Ich brauche deine Hilfe.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "004900630068002000620072006100750063006800650020006400650069006E0065002000480069006C00660065002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Nebenan ist eine Person aus Paldea eingezogen.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "004E006500620065006E0061006E0020006900730074002000650069006E006500200050006500720073006F006E0020006100750073002000500061006C006400650061002000650069006E00670065007A006F00670065006E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Und das Pokémon, das sie bei sich hat...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "0055006E0064002000640061007300200050006F006B00E9006D006F006E002C002000640061007300200073006900650020006200650069002000730069006300680020006800610074002E002E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Es starrt mein armes Scherox die ganze Zeit an!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1220,
      "rawDecodedUtf16Hex": "0045007300200073007400610072007200740020006D00650069006E002000610072006D00650073002000530063006800650072006F00780020006400690065002000670061006E007A00650020005A00650069007400200061006E002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Scherox ist eher der schüchterne Typ und lebt\nseitdem jeden Tag in Angst!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1324,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Könntest du bitte für mich in Erfahrung bringen,\nwarum das Tafforgita meiner Nachbarin mein<U+0010><U+0001>븀\nScherox ständig anglotzt?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1480,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Rox...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1732,
      "rawDecodedUtf16Hex": "0052006F0078002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Du solltest meine Nachbarin auf dem Dach\ndes Hauses finden können.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "0044007500200073006F006C006C00740065007300740020006D00650069006E00650020004E0061006300680062006100720069006E0020006100750066002000640065006D00200044006100630068000A0064006500730020004800610075007300650073002000660069006E00640065006E0020006B00F6006E006E0065006E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1892,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hm? Stimmt etwas nicht?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1904,
      "rawDecodedUtf16Hex": "0048006D003F0020005300740069006D006D00740020006500740077006100730020006E0069006300680074003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Es geht um Tafforgita.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1960,
      "rawDecodedUtf16Hex": "004500730020006700650068007400200075006D00200054006100660066006F00720067006900740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Es geht um Scherox.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2008,
      "rawDecodedUtf16Hex": "004500730020006700650068007400200075006D002000530063006800650072006F0078002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Ach, bestimmt hat dich mein Nachbar geschickt.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "004100630068002C002000620065007300740069006D006D00740020006800610074002000640069006300680020006D00650069006E0020004E00610063006800620061007200200067006500730063006800690063006B0074002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "Mein Tafforgita schaut sein Scherox wirklich die\nganze Zeit an. Das kann ich nicht leugnen.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Aber Scherox schaut immer so grimmig drein,\nda kriegt man schon etwas Angst.<U+0010><U+0001>븁\nDeshalb behält mein Tafforgita es im Auge,\nnur zur Sicherheit.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 147
    },
    {
      "displayText": "Also, ich glaube zumindest, dass das der Grund\nist. Aber ich kann auch verstehen, dass es<U+0010><U+0001>븀\ngruselig ist, wortlos angestarrt zu werden...<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 143
    },
    {
      "displayText": "Könntest du meinem Nachbarn bitte erklären,\nwas ich dir grad erzählt habe? Das macht dir<U+0010><U+0001>븀\ndoch sicher nichts aus, oder?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2928,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
    {
      "displayText": "Gita...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 3180,
      "rawDecodedUtf16Hex": "0047006900740061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3196,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Hast du herausfinden können, warum Tafforgita\ndie ganze Zeit so starrt?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Scherox schaut so grimmig.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3360,
      "rawDecodedUtf16Hex": "00530063006800650072006F0078002000730063006800610075007400200073006F0020006700720069006D006D00690067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Es hat Angst vor Scherox.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3416,
      "rawDecodedUtf16Hex": "00450073002000680061007400200041006E00670073007400200076006F0072002000530063006800650072006F0078002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Was? Es starrt mein Scherox nur an, weil es\nfindet, dass es gruselig aussieht?!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3468,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Was? Mein Scherox macht ihm Angst?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3636,
      "rawDecodedUtf16Hex": "005700610073003F0020004D00650069006E002000530063006800650072006F00780020006D0061006300680074002000690068006D00200041006E006700730074003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Das tut mir zwar leid, aber für sein Gesicht kann\nScherox ja nichts.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3716,
      "rawDecodedUtf16Hex": "00440061007300200074007500740020006D006900720020007A0077006100720020006C006500690064002C002000610062006500720020006600FC00720020007300650069006E002000470065007300690063006800740020006B0061006E006E000A00530063006800650072006F00780020006A00610020006E00690063006800740073002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "Das mag ja sein, aber die ganze Zeit einfach\nstillschweigend angeschaut zu werden,<U+0010><U+0001>븀\nist halt trotzdem nicht schön!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 121
    },
    {
      "displayText": "Ich hätte niemals gedacht, dass mir ein\nPokémon meinen friedlichen Alltag<U+0010><U+0001>븀\nzunichtemachen könnte!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4108,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Moment... Ich hab mal gehört, dass Tafforgita\nPokémon überfallen, um Metall zu sammeln...<U+0010><U+0001>븁\nHat es Tafforgita etwa auf Scherox abgesehen,\nweil es ein Stahl-Pokémon ist?!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4316,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 175
    },
    {
      "displayText": "Rox!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4668,
      "rawDecodedUtf16Hex": "0052006F007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Keine Sorge, Scherox! Wenn es hart auf hart\nkommt, werde ich dich beschützen!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4680,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Solange wir nicht sicher wissen, dass Tafforgita\nes nicht auf es abgesehen hat, wird Scherox nie<U+0010><U+0001>븀\nruhig schlafen können!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4844,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Sie hat sicher genug um die Ohren, schließlich ist\nsie ja gerade erst hergezogen...<U+0010><U+0001>븁\nAber meinst du, du könntest ihr irgendwie\nschonend beibringen, wie das für uns ist?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 5100,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 175
    },
    {
      "displayText": "Scheee...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5452,
      "rawDecodedUtf16Hex": "005300630068006500650065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿$",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5472,
      "rawDecodedUtf16Hex": "00100002BDFF00240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Na, was hat er gesagt?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5484,
      "rawDecodedUtf16Hex": "004E0061002C002000770061007300200068006100740020006500720020006700650073006100670074003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Scherox fühlt sich nicht sicher.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5540,
      "rawDecodedUtf16Hex": "00530063006800650072006F00780020006600FC0068006C0074002000730069006300680020006E00690063006800740020007300690063006800650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Scherox hat Angst vor Tafforgita.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5608,
      "rawDecodedUtf16Hex": "00530063006800650072006F0078002000680061007400200041006E00670073007400200076006F007200200054006100660066006F00720067006900740061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Aha. Das hat er also gesagt, ja?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5676,
      "rawDecodedUtf16Hex": "004100680061002E0020004400610073002000680061007400200065007200200061006C0073006F0020006700650073006100670074002C0020006A0061003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Tafforgita ist so lieb. Wie kann er so etwas sagen,\nobwohl er es gar nicht kennt?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5752,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Mein Tafforgita würde NIE einfach andere\nPokémon überfallen, um Metall zu sammeln.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5924,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Oder zumindest fast nie.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6100,
      "rawDecodedUtf16Hex": "004F0064006500720020007A0075006D0069006E0064006500730074002000660061007300740020006E00690065002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Gita!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6160,
      "rawDecodedUtf16Hex": "004700690074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Ich meine... Ich bin ja selbst gerade erst\nhergezogen und noch total verunsichert!<U+0010><U+0001>븁\nDa ist es gar nicht toll, wenn man einfach so für\ndubios gehalten wird.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 6172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 162
    },
    {
      "displayText": "Ich hätte schon gerne, dass mir der Herr Nachbar\nbeweist, dass sein Scherox uns nicht absichtlich<U+0010><U+0001>븀\nso böse anstarrt!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 6496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Gita...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 6744,
      "rawDecodedUtf16Hex": "0047006900740061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿0",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 6760,
      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Und, was hat sie dir gesagt?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6772,
      "rawDecodedUtf16Hex": "0055006E0064002C00200077006100730020006800610074002000730069006500200064006900720020006700650073006100670074003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "Scherox soll aufhören zu starren.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 6840,
      "rawDecodedUtf16Hex": "00530063006800650072006F007800200073006F006C006C0020006100750066006800F600720065006E0020007A00750020007300740061007200720065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Tafforgita tut nichts, also keine Angst.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 6908,
      "rawDecodedUtf16Hex": "0054006100660066006F0072006700690074006100200074007500740020006E00690063006800740073002C00200061006C0073006F0020006B00650069006E006500200041006E006700730074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Mein ängstliches Scherox würde doch nie\njemanden böse anstarren! Unmöglich!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 6992,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Pfft, behaupten kann man viel, aber ob das dann\nauch stimmt...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 7152,
      "rawDecodedUtf16Hex": "0050006600660074002C002000620065006800610075007000740065006E0020006B0061006E006E0020006D0061006E0020007600690065006C002C002000610062006500720020006F00620020006400610073002000640061006E006E000A00610075006300680020007300740069006D006D0074002E002E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Ich kann ja verstehen, dass man sich an fremden\nOrten etwas unsicher fühlt, aber...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 7288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Na schön! Ich werde ihr beweisen, dass mein\nScherox nicht starrt.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 7464,
      "rawDecodedUtf16Hex": "004E0061002000730063006800F6006E00210020004900630068002000770065007200640065002000690068007200200062006500770065006900730065006E002C002000640061007300730020006D00650069006E000A00530063006800650072006F00780020006E00690063006800740020007300740061007200720074002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Und wie genau?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 7604,
      "rawDecodedUtf16Hex": "0055006E00640020007700690065002000670065006E00610075003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Kann man das denn beweisen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 7636,
      "rawDecodedUtf16Hex": "004B0061006E006E0020006D0061006E0020006400610073002000640065006E006E00200062006500770065006900730065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Scherox und Tafforgita müssen sich begegnen\nund einander direkt gegenüberstehen!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 7692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "Allerdings würde ich mich etwas wohler bei der\nSache fühlen, wenn du dabei sein könntest.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 7864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Könntest du meine Nachbarin kurz fragen,\nob es für sie in Ordnung ist, unsere Pokémon<U+0010><U+0001>븀\naufeinandertreffen zu lassen?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 8052,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Scherooox.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 8300,
      "rawDecodedUtf16Hex": "00530063006800650072006F006F006F0078002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "<U+0010><U+0002>뷿>",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 8324,
      "rawDecodedUtf16Hex": "00100002BDFF003E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Unsere Pokémon sollen aufeinandertreffen...?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 8336,
      "rawDecodedUtf16Hex": "0055006E007300650072006500200050006F006B00E9006D006F006E00200073006F006C006C0065006E002000610075006600650069006E0061006E006400650072007400720065006600660065006E002E002E002E003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Okay.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 8436,
      "rawDecodedUtf16Hex": "004F006B00610079002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Tafforgita und ich kommen ohnehin nicht zur\nRuhe, wenn wir den Eindruck haben, ständig<U+0010><U+0001>븀\nbeobachtet zu werden.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 8456,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Ich werde schon beweisen, dass es Scherox nicht\nüberfällt.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 8688,
      "rawDecodedUtf16Hex": "0049006300680020007700650072006400650020007300630068006F006E00200062006500770065006900730065006E002C00200064006100730073002000650073002000530063006800650072006F00780020006E0069006300680074000A00FC006200650072006600E4006C006C0074002E00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Das bekommen wir doch hin, oder, Tafforgita?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 8816,
      "rawDecodedUtf16Hex": "004400610073002000620065006B006F006D006D0065006E002000770069007200200064006F00630068002000680069006E002C0020006F006400650072002C00200054006100660066006F00720067006900740061003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Gita!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 8916,
      "rawDecodedUtf16Hex": "004700690074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "<U+0010><U+0002>뷿E",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 8928,
      "rawDecodedUtf16Hex": "00100002BDFF00450000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wir werden jetzt beide unsere Pokémon\nvortreten lassen.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 8940,
      "rawDecodedUtf16Hex": "005700690072002000770065007200640065006E0020006A00650074007A007400200062006500690064006500200075006E007300650072006500200050006F006B00E9006D006F006E000A0076006F007200740072006500740065006E0020006C0061007300730065006E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Und falls irgendetwas schiefläuft, rufen wir sie\nsofort wieder zurück.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 9060,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Also dann, Scherox!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 9212,
      "rawDecodedUtf16Hex": "0041006C0073006F002000640061006E006E002C002000530063006800650072006F0078002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Los, Tafforgita!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 9260,
      "rawDecodedUtf16Hex": "004C006F0073002C00200054006100660066006F00720067006900740061002100100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Huch? Tafforgita ist ja ganz verlegen.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 9304,
      "rawDecodedUtf16Hex": "0048007500630068003F00200054006100660066006F0072006700690074006100200069007300740020006A0061002000670061006E007A0020007600650072006C006500670065006E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Nanu? Hat Scherox etwa Angst?<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 9392,
      "rawDecodedUtf16Hex": "004E0061006E0075003F0020004800610074002000530063006800650072006F00780020006500740077006100200041006E006700730074003F00100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Gita. ♪",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 9460,
      "rawDecodedUtf16Hex": "0047006900740061002E0020266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Rox...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 9476,
      "rawDecodedUtf16Hex": "0052006F0078002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Tafforgita greift ja tatsächlich nicht an...<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 9492,
      "rawDecodedUtf16Hex": "0054006100660066006F0072006700690074006100200067007200650069006600740020006A00610020007400610074007300E400630068006C0069006300680020006E006900630068007400200061006E002E002E002E00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Und Scherox schaut halt ein bisschen streng\ndrein, aber das macht ja nichts...<U+0010><U+0001>븁\nIch glaube, wir haben uns gegenseitig einfach\nmissverstanden.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 9592,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 148
    },
    {
      "displayText": "Scherox!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 9888,
      "rawDecodedUtf16Hex": "00530063006800650072006F007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Gita!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 9908,
      "rawDecodedUtf16Hex": "004700690074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Die beiden scheinen langsam miteinander warm\nzu werden!<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 82,
      "offsetInSection": 9920,
      "rawDecodedUtf16Hex": "004400690065002000620065006900640065006E002000730063006800650069006E0065006E0020006C0061006E006700730061006D0020006D0069007400650069006E0061006E0064006500720020007700610072006D000A007A0075002000770065007200640065006E002100100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Das stimmt. Und... vielleicht könnten wir ja auch\nFreunde werden?<U+0010><U+0001>븁\nIch bin neu in Illumina und kenne mich noch\nkaum aus. Ich könnte bei Gelegenheit also etwas<U+0010><U+0001>븀\nHilfe gebrauchen...<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 10040,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 188
    },
    {
      "displayText": "Vielen Dank für deine Hilfe heute!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 84,
      "offsetInSection": 10416,
      "rawDecodedUtf16Hex": "005600690065006C0065006E002000440061006E006B0020006600FC00720020006400650069006E0065002000480069006C00660065002000680065007500740065002100100002011401AD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Oh, Tafforgita! Nein, das Metall dort darfst du\nnicht einfach abreißen!<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 85,
      "offsetInSection": 10496,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Äh... Ich brauche aber keine Angst zu haben, ja...?<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 10648,
      "rawDecodedUtf16Hex": "00C40068002E002E002E002000490063006800200062007200610075006300680065002000610062006500720020006B00650069006E006500200041006E0067007300740020007A007500200068006100620065006E002C0020006A0061002E002E002E003F00100002011401AC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Rox...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 87,
      "offsetInSection": 10760,
      "rawDecodedUtf16Hex": "0052006F0078002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Gita!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 88,
      "offsetInSection": 10776,
      "rawDecodedUtf16Hex": "004700690074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "<U+0010><U+0002>뷿Y",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 89,
      "offsetInSection": 10788,
      "rawDecodedUtf16Hex": "00100002BDFF00590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ich unterhalte mich jetzt häufiger mit Ferrea.<U+0010><U+0001>븁\nUnd Scherox und Tafforgita scheinen sich auch\ngut zu verstehen...<U+0010><U+0001>븁\nZumindest vorerst.<U+0010><U+0002>ĔƬ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 90,
      "offsetInSection": 10800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "Scherox!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 91,
      "offsetInSection": 11084,
      "rawDecodedUtf16Hex": "00530063006800650072006F007800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Coupin bringt mir so einiges über Illumina bei!<U+0010><U+0001>븁\nTafforgita klebt auch förmlich an Scherox.<U+0010><U+0002>Ĕƭ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 92,
      "offsetInSection": 11104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Gita!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 93,
      "offsetInSection": 11300,
      "rawDecodedUtf16Hex": "004700690074006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    }
