      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1396,
      "rawDecodedUtf16Hex": "00BF005400650020006D006F006C0065007300740061007200ED00610020006900720020006100200065006300680061007200200075006E002000760069007300740061007A006F00200070006F00720020006D00ED003F001000020114013F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1496,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
