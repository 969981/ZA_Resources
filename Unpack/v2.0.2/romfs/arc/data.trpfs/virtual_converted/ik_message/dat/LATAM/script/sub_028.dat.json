      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Ahora todo tiene sentido: ¡los incidentes\nestaban relacionados con la electricidad!<U+0010><U+0001>븀\nLos altavoces, los apagones...<U+0010><U+0002>ĔĿ",
      "escapedControlUnits": 4,
