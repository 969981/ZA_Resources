      "rawDecodedUtf16Hex": "00100002BDFF003B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "You should aim to get the fastest times on all our\nother scaffolding courses too!<U+0010><U+0002>ĔƉ",
