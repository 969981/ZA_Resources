      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Wait, does the fact that you’re here talking to me\nmean you’re giving up on my bestest-ever course?<U+0010><U+0002>ĔƉ",
