      "offsetInSection": 6760,
      "rawDecodedUtf16Hex": "00100002BDFF003D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "You pressed <U+0010><U+0002>봊<U+0004>Sp_1—does that mean you’re giving up\non beating my bestest-ever course?<U+0010><U+0002>ĔƉ",
      "escapedControlUnits": 5,
