      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "004900660020006900742019007300200063006F006F006C0020007700690074006800200079006F0075002C0020006420190079006F0075002000770061006E006E00610020006200650020006D007900200070006100720074006E00650072003F00100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Lotsa Pokémon live down in these sewers, so I’d\nfeel safer with you around!<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
