      "index": 20,
      "offsetInSection": 2408,
      "rawDecodedUtf16Hex": "004C006F006F006B00730020006C0069006B00650020006900742019007300200073006500740074006C00650064002100100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Don’t think I forgot about you! Thanks for savin’\nthis doozy of a Dondozo!<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
