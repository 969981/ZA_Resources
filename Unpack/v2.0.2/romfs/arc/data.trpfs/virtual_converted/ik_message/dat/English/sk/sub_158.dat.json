    },
    {
      "displayText": "My phone stopped picking up the stuck Pokémon,\nso I came to see what’s up. What IS this thing?!<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
