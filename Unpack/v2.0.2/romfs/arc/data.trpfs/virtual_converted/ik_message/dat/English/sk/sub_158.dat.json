      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Aw, don’t be sorry! All you wanted to do was\nwriggle through the pipe! I totally get that!<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
