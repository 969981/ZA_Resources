      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5736,
      "rawDecodedUtf16Hex": "00100002BDFF003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Grimpe à l’échelle derrière l’hôtel !\nJe vais t’apprendre un truc cool.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
