      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "<U+0010><U+0002>뷿9",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5308,
      "rawDecodedUtf16Hex": "00100002BDFF00390000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "On avance bien !\nCorvault est plus très loin !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 58,
      "offsetInSection": 5320,
      "rawDecodedUtf16Hex": "004F006E0020006100760061006E006300650020006200690065006E00200021000A0043006F0072007600610075006C0074002000650073007400200070006C0075007300200074007200E800730020006C006F0069006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "À son tour d’avoir une dette\nenvers nous !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 59,
      "offsetInSection": 5416,
