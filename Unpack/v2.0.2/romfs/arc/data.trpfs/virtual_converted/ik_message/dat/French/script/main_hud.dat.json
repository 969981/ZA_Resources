      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5504,
      "rawDecodedUtf16Hex": "00100002BDFF003C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Tant que j’aurai mon Ohmassacre,\nça sera « gg, easy » !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5516,
      "rawDecodedUtf16Hex": "00540061006E007400200071007500650020006A2019006100750072006100690020006D006F006E0020004F0068006D0061007300730061006300720065002C000A00E7006100200073006500720061002000AB002000670067002C00200065006100730079002000BB002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Concentre-toi sur le combat !\nAie confiance en toi !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 5628,
