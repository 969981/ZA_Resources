      "rawDecodedUtf16Hex": "00100002BDFF002D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "On arrive au point de rendez-vous\navec Nivis et les autres !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 46,
      "offsetInSection": 4400,
      "rawDecodedUtf16Hex": "004F006E002000610072007200690076006500200061007500200070006F0069006E0074002000640065002000720065006E00640065007A002D0076006F00750073000A00610076006500630020004E00690076006900730020006500740020006C006500730020006100750074007200650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "On compte sur toi pour les aider\nquand tu les auras rejoints !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 47,
      "offsetInSection": 4524,
      "rawDecodedUtf16Hex": "004F006E00200063006F006D007000740065002000730075007200200074006F006900200070006F007500720020006C00650073002000610069006400650072000A007100750061006E00640020007400750020006C00650073002000610075007200610073002000720065006A006F0069006E00740073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "<U+0010><U+0002>뷿0",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 4652,
      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Te voilà ! Ouf !\nCarina est juste devant !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4664,
      "rawDecodedUtf16Hex": "0054006500200076006F0069006C00E0002000210020004F0075006600200021000A0043006100720069006E006100200065007300740020006A007500730074006500200064006500760061006E0074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Elle s’appelle Narica !\nNA-RI-CA !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 50,
      "offsetInSection": 4752,
      "rawDecodedUtf16Hex": "0045006C006C00650020007320190061007000700065006C006C00650020004E0061007200690063006100200021000A004E0041002D00520049002D00430041002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "<U+0010><U+0002>뷿3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 4824,
      "rawDecodedUtf16Hex": "00100002BDFF00330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Je suis... épuisée...\nFais vite...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 4836,
      "rawDecodedUtf16Hex": "004A006500200073007500690073002E002E002E002000E9007000750069007300E90065002E002E002E000A004600610069007300200076006900740065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Ma force ne m’a pas abandonné !\nLa justice vaincra !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 4908,
      "rawDecodedUtf16Hex": "004D006100200066006F0072006300650020006E00650020006D2019006100200070006100730020006100620061006E0064006F006E006E00E900200021000A004C00610020006A0075007300740069006300650020007600610069006E006300720061002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "<U+0010><U+0002>뷿6",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5016,
      "rawDecodedUtf16Hex": "00100002BDFF00360000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "J’te kiffe comme adversaire, mais\nlà, j’kiffe de t’avoir comme alliée !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 5028,
      "rawDecodedUtf16Hex": "004A2019007400650020006B006900660066006500200063006F006D006D006500200061006400760065007200730061006900720065002C0020006D006100690073000A006C00E0002C0020006A2019006B006900660066006500200064006500200074201900610076006F0069007200200063006F006D006D006500200061006C006C006900E90065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Nous nous affronterons à nouveau\nquand cette histoire sera réglée !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
