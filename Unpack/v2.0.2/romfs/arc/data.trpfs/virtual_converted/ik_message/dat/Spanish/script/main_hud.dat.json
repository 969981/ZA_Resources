      "offsetInSection": 4896,
      "rawDecodedUtf16Hex": "00100002BDFF00360000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Luchar contigo, ya sea contra o\njunto a ti, es siempre un placer!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4908,
      "rawDecodedUtf16Hex": "00A1004C0075006300680061007200200063006F006E007400690067006F002C002000790061002000730065006100200063006F006E0074007200610020006F000A006A0075006E0074006F00200061002000740069002C0020006500730020007300690065006D00700072006500200075006E00200070006C006100630065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Cuando se haya resuelto todo\nel asunto, te volveré a retar.",
