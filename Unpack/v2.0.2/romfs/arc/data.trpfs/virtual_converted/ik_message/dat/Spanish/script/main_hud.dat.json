      "index": 59,
      "offsetInSection": 5268,
      "rawDecodedUtf16Hex": "00A10050006F0072002000660069006E0020006C006500200074006F0063006100200061002000E9006C00200065006E00630061007200670061007200730065000A0064006500200075006E006F0020006400650020007300750073002000740072006100620061006A0069006C006C006F007300210000",
      "trailingZeroPaddingUnits": 1,
