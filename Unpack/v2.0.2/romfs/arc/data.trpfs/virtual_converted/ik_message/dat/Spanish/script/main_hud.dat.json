      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5176,
      "rawDecodedUtf16Hex": "00A10056006100730020006D007500790020006200690065006E00210020004300F30072006100780020007400650020006500730070006500720061000A006D00E100730020006100640065006C0061006E00740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "¡Por fin le toca a él encargarse\nde uno de sus trabajillos!",
