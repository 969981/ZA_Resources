      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Veo que has logrado cruzar el río!\nLa coletas tiene que andar cerca.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4480,
      "rawDecodedUtf16Hex": "00A100560065006F002000710075006500200068006100730020006C006F0067007200610064006F0020006300720075007A0061007200200065006C0020007200ED006F0021000A004C006100200063006F006C00650074006100730020007400690065006E0065002000710075006500200061006E006400610072002000630065007200630061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡¡Oye, a Naria me la respetas!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4620,
      "rawDecodedUtf16Hex": "00A100A1004F00790065002C002000610020004E00610072006900610020006D00650020006C0061002000720065007300700065007400610073002100210000",
      "trailingZeroPaddingUnits": 1,
