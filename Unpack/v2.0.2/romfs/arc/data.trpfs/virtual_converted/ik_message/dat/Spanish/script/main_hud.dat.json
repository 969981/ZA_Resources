    },
    {
      "displayText": "¡Albar e Inma están\nun poco más adelante!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 4292,
      "rawDecodedUtf16Hex": "00A10041006C0062006100720020006500200049006E006D0061002000650073007400E1006E000A0075006E00200070006F0063006F0020006D00E100730020006100640065006C0061006E0074006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Échales un cable cuando te reúnas\ncon ellos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 47,
      "offsetInSection": 4376,
      "rawDecodedUtf16Hex": "00C9006300680061006C0065007300200075006E0020006300610062006C00650020006300750061006E0064006F00200074006500200072006500FA006E00610073000A0063006F006E00200065006C006C006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿0",
