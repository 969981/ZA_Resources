      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "¡El ambiente está más animado\ndesde que te uniste a la pandilla!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 956,
