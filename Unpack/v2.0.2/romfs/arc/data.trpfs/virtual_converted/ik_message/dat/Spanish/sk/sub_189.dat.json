      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2636,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Si llevas contigo a un Jolteon de naturaleza activa,\nterminas haciendo de todo, te lo aseguro.<U+0010><U+0001>븁\n¡Es la mar de divertido!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
