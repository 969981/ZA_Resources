      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "¡Joool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 272,
      "rawDecodedUtf16Hex": "00A1004A006F006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "¡Espera, Jolteon! ¿No ves que estamos en mitad\nde una conversación?<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 288,
      "rawDecodedUtf16Hex": "00A1004500730070006500720061002C0020004A006F006C00740065006F006E0021002000BF004E006F0020007600650073002000710075006500200065007300740061006D006F007300200065006E0020006D0069007400610064000A0064006500200075006E006100200063006F006E007600650072007300610063006900F3006E003F00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Pero bueno, ¿qué le habrá picado?<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "005000650072006F0020006200750065006E006F002C002000BF0071007500E90020006C00650020006800610062007200E1002000700069006300610064006F003F00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Mi Jolteon es de naturaleza activa. ¡No para\nquieto ni un segundo!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "004D00690020004A006F006C00740065006F006E0020006500730020006400650020006E00610074007500720061006C0065007A00610020006100630074006900760061002E002000A1004E006F00200070006100720061000A00710075006900650074006F0020006E006900200075006E00200073006500670075006E0064006F002100100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Ha notado que me apetecía combatir y estaba\ndesfilando ya a una arena de combate.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "¡Así que por favor, combate contra nosotros!\nTe estaré esperando en la arena de combate.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 824,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1012,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres combatir contra nosotros?<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1024,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200063006F006D0062006100740069007200200063006F006E0074007200610020006E006F0073006F00740072006F0073003F00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Joool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "00A1004A006F006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Pero bueno, ¡que aún no ha respondido!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "005000650072006F0020006200750065006E006F002C002000A10071007500650020006100FA006E0020006E006F00200068006100200072006500730070006F006E006400690064006F002100100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000B>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "00100002BDFF000B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Cómo se nota que perteneces al Equipo MZ!\nNo me esperaba menos de alguien como tú.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1220,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Mi Jolteon es de naturaleza activa, por eso es tan\nrápido.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1396,
      "rawDecodedUtf16Hex": "004D00690020004A006F006C00740065006F006E0020006500730020006400650020006E00610074007500720061006C0065007A00610020006100630074006900760061002C00200070006F0072002000650073006F002000650073002000740061006E000A007200E1007000690064006F002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "La naturaleza del Pokémon puede aumentar o\ndisminuir características como la Velocidad.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1524,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¡Y no hablo solo de la naturaleza activa!\nLa miedosa, la alegre o la ingenua también.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1708,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Cuanto más veloz sea un Pokémon, menos\ntardará en ejecutar sus movimientos.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1888,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Sin embargo, por muy veloz que sea, deberá\nesperar al menos 3 segundos antes de poder<U+0010><U+0001>븀\nvolver a usar un mismo movimiento.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 128
    },
    {
      "displayText": "Y, por si eso fuera poco...<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2304,
      "rawDecodedUtf16Hex": "0059002C00200070006F0072002000730069002000650073006F00200066007500650072006100200070006F0063006F002E002E002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "¡Joool!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2368,
      "rawDecodedUtf16Hex": "00A1004A006F006F006F006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Oye, ¡que te he dicho que no vayas al Centro\nPokémon sin mí!<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2384,
      "rawDecodedUtf16Hex": "004F00790065002C002000A100710075006500200074006500200068006500200064006900630068006F00200071007500650020006E006F00200076006100790061007300200061006C002000430065006E00740072006F000A0050006F006B00E9006D006F006E002000730069006E0020006D00ED002100100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Bueno, me tengo que ir. ¡Hasta luego!\nY muchas gracias.<U+0010><U+0002>ĔǤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2516,
      "rawDecodedUtf16Hex": "004200750065006E006F002C0020006D0065002000740065006E0067006F0020007100750065002000690072002E002000A1004800610073007400610020006C007500650067006F0021000A00590020006D0075006300680061007300200067007200610063006900610073002E00100002011401E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
