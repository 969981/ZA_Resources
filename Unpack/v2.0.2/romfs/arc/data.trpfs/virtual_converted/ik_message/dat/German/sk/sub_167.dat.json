  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Verrate mir, weshalb strebst du nach Stärke?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "00560065007200720061007400650020006D00690072002C002000770065007300680061006C0062002000730074007200650062007300740020006400750020006E00610063006800200053007400E40072006B0065003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Einzig und allein für mich selbst.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "00450069006E007A0069006700200075006E006400200061006C006C00650069006E0020006600FC00720020006D006900630068002000730065006C006200730074002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Also ich will stärker werden, damit ich Gwynn\nbeschützen kann... Und alle anderen natürlich<U+0010><U+0001>븀\nauch!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 512,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 105
    },
    {
      "displayText": "Bisher habe ich es noch nicht geschafft,\ngegen Violette zu gewinnen...<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 724,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Doch genau aus dieser Schmach ziehe ich Stärke.\nMein Wille ist dadurch eiserner denn je!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Wenn ich eines Tages Violette übertreffe,\nweiß ich: Niemand kann mich mehr schlagen.<U+0010><U+0001>븁\nUm an diesen Punkt zu gelangen, kämpfe ich\nweiter!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1064,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 143
    },
    {
      "displayText": "Du kämpfst also wirklich nur für dich und sonst\nniemanden.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "004400750020006B00E4006D007000660073007400200061006C0073006F0020007700690072006B006C0069006300680020006E007500720020006600FC00720020006400690063006800200075006E006400200073006F006E00730074000A006E00690065006D0061006E00640065006E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Meinst du denn, das ist als Pokémon-Trainerin\ndie richtige Haltung?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1480,
      "rawDecodedUtf16Hex": "004D00650069006E00730074002000640075002000640065006E006E002C0020006400610073002000690073007400200061006C007300200050006F006B00E9006D006F006E002D0054007200610069006E006500720069006E000A006400690065002000720069006300680074006900670065002000480061006C00740075006E0067003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Hey, hier drüben!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "004800650079002C0020006800690065007200200064007200FC00620065006E002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Ich benutz dich mal eben, um dieser Diskussion\nhier ein Ende zu bereiten, ja?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Hey, <U+0010><U+0002>Ā<U+0000> ist auch hier. Klärt doch\neinfach<U+0010><U+0001>븀\nmit<U+0010><U+0001>븀\neinem<U+0010><U+0001>븀\nKampf,<U+0010><U+0001>븀\nwer von<U+0010><U+0001>븀\neuch<U+0010><U+0001>븀\nbeiden<U+0010><U+0001>븀\nrecht<U+0010><U+0001>븀\nhat.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 25,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1832,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "Okay, ich bin dabei!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2080,
      "rawDecodedUtf16Hex": "004F006B00610079002C0020006900630068002000620069006E00200064006100620065006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Moment noch...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2124,
      "rawDecodedUtf16Hex": "004D006F006D0065006E00740020006E006F00630068002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Wenn es um Stärke geht, sprechen nicht Worte,\nsondern Fäuste!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "00570065006E006E00200065007300200075006D00200053007400E40072006B006500200067006500680074002C00200073007000720065006300680065006E0020006E006900630068007400200057006F007200740065002C000A0073006F006E006400650072006E0020004600E40075007300740065002100100002011400160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>Ā<U+0000>! Stell dich zusammen mit mir\nder<U+0010><U+0001>븀\nFaust<U+0010><U+0001>븀\nder<U+0010><U+0001>븀\nGerechten!<U+0010><U+0001>븁\nIch muss meinen Willen unter Beweis stellen!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 17,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2288,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Mir ist immer nach einem Kampf!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "004D00690072002000690073007400200069006D006D006500720020006E006100630068002000650069006E0065006D0020004B0061006D00700066002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Ich kämpfe nur, weil ich so schnell wie möglich\nwieder nach Hause gehen will.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2620,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Okay, ich bin dabei!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2784,
      "rawDecodedUtf16Hex": "004F006B00610079002C0020006900630068002000620069006E00200064006100620065006900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Moment noch...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2828,
      "rawDecodedUtf16Hex": "004D006F006D0065006E00740020006E006F00630068002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Wahrer Fortschritt lässt sich nur durch den Sieg\ngegen einen starken Gegner erzielen!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2860,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Muskeln sind Kraft!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 3040,
      "rawDecodedUtf16Hex": "004D00750073006B0065006C006E002000730069006E00640020004B0072006100660074002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Hätte nicht gedacht, dass du so unentschlossen\nbist...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 3088,
      "rawDecodedUtf16Hex": "004800E40074007400650020006E006900630068007400200067006500640061006300680074002C0020006400610073007300200064007500200073006F00200075006E0065006E0074007300630068006C006F007300730065006E000A0062006900730074002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Kraft ist Gerechtigkeit!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3208,
      "rawDecodedUtf16Hex": "004B007200610066007400200069007300740020004700650072006500630068007400690067006B006500690074002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>Ā<U+0000>! Stell dich zusammen mit mir\nder<U+0010><U+0001>븀\nFaust<U+0010><U+0001>븀\nder<U+0010><U+0001>븀\nGerechten!<U+0010><U+0001>븁\nIch muss meinen Willen unter Beweis stellen!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 17,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 3268,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0019>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3516,
      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Los, Legios! Vollziehe die Mega-Entwicklung und\nverhilf der Gerechtigkeit zum Sieg!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3528,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Los, Skelabra! Vollzieh die Mega-Entwicklung und\nramm deinen Gegner ungespitzt in den Boden!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3704,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Dann lass ich mal meine Geheimwaffe aus dem\nSack: Tandrak, Mega-Entwicklung!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3900,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4064,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Manche kämpfen für sich selbst...\nManche kämpfen für andere...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4076,
      "rawDecodedUtf16Hex": "004D0061006E0063006800650020006B00E4006D007000660065006E0020006600FC007200200073006900630068002000730065006C006200730074002E002E002E000A004D0061006E0063006800650020006B00E4006D007000660065006E0020006600FC007200200061006E0064006500720065002E002E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Da gibt es kein Richtig oder Falsch. Das lässt sich\neigentlich gar nicht erst vergleichen.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Ja! Du schöpfst eben Kraft daraus, andere\nbeschützen zu wollen. Das ist bewundernswert!<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 4404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Unser Kampf hat mich zutiefst bewegt!\nHier, bitte nimm diese Uniform als Dank!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Tut mir leid. Ich habe mir auferlegt, dieses Outfit\nzu tragen, bis ich mich eines Tages von Violette<U+0010><U+0001>븀\nbefreien kann.<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 4756,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Das leuchtet ein. Nun gut, dann sollst du sie\nhaben, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 5004,
      "rawDecodedUtf16Hex": "0044006100730020006C0065007500630068007400650074002000650069006E002E0020004E0075006E0020006700750074002C002000640061006E006E00200073006F006C006C007300740020006400750020007300690065000A0068006100620065006E002C00200010000201000000002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Du erhältst Gavins Uniform (Alternatives\nFarbschema)!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 5132,
      "rawDecodedUtf16Hex": "00440075002000650072006800E4006C00740073007400200047006100760069006E007300200055006E00690066006F0072006D002000280041006C007400650072006E006100740069007600650073000A00460061007200620073006300680065006D0061002900210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Anscheinend gibt’s echt ein paar Irre, die im\nFriseursalon nach Gavins Frisur fragen...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5240,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Das Streben nach Stärke hat kein Ende!\nAlso schau ruhig wieder auf ein Match vorbei!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5424,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Ich würde mal behaupten, Astera ist viel besser\nfür das Dojo geeignet als ich.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5604,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Ich hab irgendwie ein Dé­jà-vu... Ich glaube, ich\nhab als Kind schon mal gegen Gavin gekämpft...?<U+0010><U+0002>Ĕ<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 5772,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    }
  ],
