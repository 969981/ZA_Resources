      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "不愧是我做的穿搭！\n现在你在密阿雷可是独一无二的哦！<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
