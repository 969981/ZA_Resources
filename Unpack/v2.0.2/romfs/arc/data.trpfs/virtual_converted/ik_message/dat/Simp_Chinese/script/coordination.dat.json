      "rawDecodedUtf16Hex": "5C31662F4F60FF0100100002011401910000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "我要擅自地庆祝这场邂逅，\n为你做一个全身的穿搭！<U+0010><U+0002>ĔƑ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
