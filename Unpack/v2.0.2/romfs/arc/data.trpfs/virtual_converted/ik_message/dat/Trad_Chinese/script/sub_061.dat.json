      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 4984,
      "rawDecodedUtf16Hex": "63118D775C0D6230FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
