      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 4876,
      "rawDecodedUtf16Hex": "8CED4E0A5C0D591A9E977C734E9E7684611B800C5168529B5C0D62307684573065B9FF0C000A90A35C31662F591A9E977C734E9E806F76DFFF0100100001BE00000A4F86FF0C8B93621150115F7C6B647684611B78B0649E51FA706B82B15427FF0100100002011401600000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
