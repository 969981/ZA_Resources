      "rawDecodedUtf16Hex": "6B4C821E4F0E7684771F9AD3572865BC8D8551E176845275610FFF0C000A800C62117ADF71368D0F4E0D904E00100003110000FF01014F6059B3FF0C771F662F59298981584C4E0B4F864E863002001000020114015C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
