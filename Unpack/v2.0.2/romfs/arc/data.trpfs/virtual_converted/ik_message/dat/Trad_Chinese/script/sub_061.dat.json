      "rawDecodedUtf16Hex": "8ACB7B494E004E0B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "人家想和歌舞伎造型的多麗米亞\n一起擺出亮相時的招牌姿勢啊！<U+0010><U+0002>ĔŜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1560,
