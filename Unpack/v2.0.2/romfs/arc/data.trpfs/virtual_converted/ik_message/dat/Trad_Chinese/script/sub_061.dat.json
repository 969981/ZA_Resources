      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "若想挑戰我，就請在同行隊伍裡\n只帶著多麗米亞前來。<U+0010><U+0002>ĔŜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "82E560F3631162306211FF0C5C318ACB5728540C884C968A4F0D88E1000A53EA5E368457591A9E977C734E9E524D4F863002001000020114015C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "我會在對戰中告訴<U+0010><U+0003>ᄀÿā你妳\n多麗米亞歌舞伎造型是多麼有魅力的！<U+0010><U+0002>ĔŜ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1464,
      "rawDecodedUtf16Hex": "6211670357285C0D62304E2D544A8A3400100003110000FF01014F6059B3000A591A9E977C734E9E6B4C821E4F0E9020578B662F591A9EBC67099B45529B7684FF01001000020114015C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "開打吧",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1540,
      "rawDecodedUtf16Hex": "958B625354270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
