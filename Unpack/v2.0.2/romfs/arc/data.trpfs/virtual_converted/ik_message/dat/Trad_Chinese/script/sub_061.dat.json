      "rawDecodedUtf16Hex": "4F46591A9E977C734E9E56DB5929738B76845BE6529B000A53EF4E0D53EA662F90197A0B5EA6FF01001000020114015C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
