      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "我是多麗米亞聯盟四天王中\n專愛歌舞伎造型的彌葉。<U+0010><U+0002>ĔŜ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
