      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "不好意思，其實我們是\n電影《三人的大蔥》的影迷。<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
