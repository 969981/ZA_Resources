      "index": 12,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "547154C7FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "格蔥無論！<U+0010><U+0002>ĔǕ",
