      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "甘拜下風！<U+0010><U+0002>ĔǓ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1912,
      "rawDecodedUtf16Hex": "751862DC4E0B98A8FF0100100002011401D30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "何等的強大啊……\n得積累多少修練才能到此地步……<U+0010><U+0002>ĔǓ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1932,
      "rawDecodedUtf16Hex": "4F557B4976845F375927554A20262026000A5F977A4D7D2F591A5C114FEE7DF4624D80FD52306B6457306B652026202600100002011401D30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "沒想到那兩人都被打倒……<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "6C9260F3523090A351694EBA90FD88AB625350122026202600100002011401D40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "這樣下去，\n豈不是讓我們大蔥三人幫的聲名掃地。<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 2028,
