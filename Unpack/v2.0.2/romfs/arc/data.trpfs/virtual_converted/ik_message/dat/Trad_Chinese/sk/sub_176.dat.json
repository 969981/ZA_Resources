      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "對了。<U+0010><U+0002>Ĕǔ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "5C0D4E86300200100002011401D40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
