      "index": 38,
      "offsetInSection": 2376,
      "rawDecodedUtf16Hex": "4F69670D4F69670DFF0100100002011401D40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "咕哇！咕～哇呱哇！！",
