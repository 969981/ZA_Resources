      "rawDecodedUtf16Hex": "00100002BDFF00250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "佩服佩服！<U+0010><U+0002>Ĕǔ",
