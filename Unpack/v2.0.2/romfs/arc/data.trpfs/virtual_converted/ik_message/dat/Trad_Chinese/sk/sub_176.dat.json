      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "咕哇！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2320,
      "rawDecodedUtf16Hex": "549554C7FF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
