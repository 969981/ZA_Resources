      "rawDecodedUtf16Hex": "683C852571218AD6FF0100100002011401D30000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0019>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
