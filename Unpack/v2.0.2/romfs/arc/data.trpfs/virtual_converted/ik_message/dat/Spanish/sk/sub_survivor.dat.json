      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Tu récord actual es de <U+0010><U+0002>ȁ<U+0006>:<U+0010><U+0002>ȁ<U+0007>:<U+0010><U+0002>ȁ<U+0008>.\n¡Ánimo, que seguro que puedes superarlo!<U+0010><U+0002>Ĕ<U+000F>",
