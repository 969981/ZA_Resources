      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "¡Has batido tu mejor marca! ¡Estás que te sales,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 6,
