      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "¡Vas a flipar con la experiencia! ¡Toda una\ndescarga de electroadrenalina!<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 3,
