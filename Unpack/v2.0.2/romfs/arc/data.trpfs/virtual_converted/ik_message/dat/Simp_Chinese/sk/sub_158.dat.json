      "index": 20,
      "offsetInSection": 1108,
      "rawDecodedUtf16Hex": "90A35C318FD94E485B9A4E86FF0100100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "谢谢！\n你帮了吃吼霸一把。<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1132,
      "rawDecodedUtf16Hex": "8C228C22FF01000A4F605E2E4E865403543C97384E00628A300200100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
