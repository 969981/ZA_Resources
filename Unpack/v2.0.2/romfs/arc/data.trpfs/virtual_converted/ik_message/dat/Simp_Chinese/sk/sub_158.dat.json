      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "……吼啊。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "20262026543C554A30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "这是在道歉吗？别放在心上！\n你是想通过这里试试吧？我懂的。<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 924,
      "rawDecodedUtf16Hex": "8FD9662F572890536B495417FF1F522B653E57285FC34E0AFF01000A4F60662F60F3901A8FC78FD991CC8BD58BD55427FF1F621161C27684300200100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "只要你愿意的话，\n就来当我的同伴吧。<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "53EA89814F60613F610F76848BDDFF0C000A5C3167655F5362117684540C4F345427300200100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "下水道里住着很多宝可梦，\n有你在我就放心了。<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1040,
      "rawDecodedUtf16Hex": "4E0B6C34905391CC4F4F77405F88591A5B9D53EF68A6FF0C000A67094F60572862115C31653E5FC34E86300200100002011401C50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "吼吼啊！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1096,
      "rawDecodedUtf16Hex": "543C543C554AFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "那就这么定了！<U+0010><U+0002>Ĕǅ",
      "escapedControlUnits": 2,
