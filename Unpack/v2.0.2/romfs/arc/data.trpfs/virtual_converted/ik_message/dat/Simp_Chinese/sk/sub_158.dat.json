    },
    {
      "displayText": "宝可梦吃吼霸卡住了。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "5B9D53EF68A65403543C973853614F4F4E8630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "用宝可梦的招式给予冲击，\n或许能把它从管道里弄出来！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
