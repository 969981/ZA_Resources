  "initialKey": 0,
  "messages": [
    {
      "displayText": "어쩐지 낯설지 않은 장소네요.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 316,
      "rawDecodedUtf16Hex": "C5B4CA50C9C00020B0AFC124C9C00020C54AC7400020C7A5C18CB124C694002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "여기서도 시로와 함께라니...\n운명도 잔인하지...<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 360,
      "rawDecodedUtf16Hex": "C5ECAE30C11CB3C40020C2DCB85CC6400020D568AED8B77CB2C8002E002E002E000AC6B4BA85B3C40020C794C778D558C9C0002E002E002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "저스티스회 사람들 맞지?\n나한테 메가진화를 보여 주지 않을래!?<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 428,
      "rawDecodedUtf16Hex": "C800C2A4D2F0C2A4D68C0020C0ACB78CB4E40020B9DEC9C0003F000AB098D55CD14C0020BA54AC00C9C4D654B97C0020BCF4C5EC0020C8FCC9C00020C54AC744B7980021003F00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>!\n다 같이 2 대 2로 승부하자!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 508,
      "rawDecodedUtf16Hex": "00100002010000000021000AB2E40020AC19C774002000320020B30000200032B85C0020C2B9BD80D558C790002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "기다려 주세요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>,\n승부는 흐름과 기세가 중요하다구!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 592,
      "rawDecodedUtf16Hex": "0010000201000000002C000AC2B9BD80B2940020D750B984ACFC0020AE30C138AC000020C911C694D558B2E4AD6C002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "계승자로서\n다양한 메가진화를 접해 보겠어!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "ACC4C2B9C790B85CC11C000AB2E4C591D55C0020BA54AC00C9C4D654B97C0020C811D5740020BCF4ACA0C5B4002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 708,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "시합은 저도 바라던 바입니다!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 720,
      "rawDecodedUtf16Hex": "C2DCD569C7400020C800B3C40020BC14B77CB3580020BC14C785B2C8B2E4002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "이 전개...\n거부권은 없는 것 같네.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 764,
      "rawDecodedUtf16Hex": "C7740020C804AC1C002E002E002E000AAC70BD80AD8CC7400020C5C6B2940020AC830020AC19B124002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 816,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "기다려 주세요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 828,
      "rawDecodedUtf16Hex": "AE30B2E4B8240020C8FCC138C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "강한 상대를 이겨야만\n얻을 수 있는 경험이 있습니다.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 844,
      "rawDecodedUtf16Hex": "AC15D55C0020C0C1B300B97C0020C774ACA8C57CB9CC000AC5BBC7440020C2180020C788B2940020ACBDD5D8C7740020C788C2B5B2C8B2E4002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "힘이야말로 파워!!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "D798C774C57CB9D0B85C0020D30CC6CC0021002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "의외로 우유부단하구나?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 944,
      "rawDecodedUtf16Hex": "C758C678B85C0020C6B0C720BD80B2E8D558AD6CB098003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "힘이야말로 저스티스!!<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 980,
      "rawDecodedUtf16Hex": "D798C774C57CB9D0B85C0020C800C2A4D2F0C2A40021002100100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "미르는 최고인 것 같지 않아?\n이차원 미르에도 다양한 메가진화가 있잖아!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "BBF8B974B2940020CD5CACE0C7780020AC830020AC19C9C00020C54AC544003F000AC774CC28C6D00020BBF8B974C5D0B3C40020B2E4C591D55C0020BA54AC00C9C4D654AC000020C788C796C544002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1108,
      "rawDecodedUtf16Hex": "00100002BDFF00120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "대여르! 메가진화로\n저스티스를 드높여 승리하는 겁니다!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "B300C5ECB97400210020BA54AC00C9C4D654B85C000AC800C2A4D2F0C2A4B97C0020B4DCB192C5EC0020C2B9B9ACD558B2940020AC81B2C8B2E4002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "샹델라...\n메가진화로 쓰러뜨리자.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1192,
      "rawDecodedUtf16Hex": "C0F9B378B77C002E002E002E000ABA54AC00C9C4D654B85C0020C4F0B7ECB728B9ACC790002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "생명 폭발!!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1240,
      "rawDecodedUtf16Hex": "C0DDBA850020D3EDBC1C0021002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1264,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "메가대여르도\n메가샹델라도 정말 굉장했어!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1276,
      "rawDecodedUtf16Hex": "BA54AC00B300C5ECB974B3C4000ABA54AC00C0F9B378B77CB3C40020C815B9D00020AD49C7A5D588C5B4002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "메가진화의 파워면\n상대를 분쇄할 수 있을 줄 알았는데 말이죠...<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1332,
      "rawDecodedUtf16Hex": "BA54AC00C9C4D654C7580020D30CC6CCBA74000AC0C1B300B97C0020BD84C1C4D5600020C2180020C788C7440020C9040020C54CC558B294B3700020B9D0C774C8E0002E002E002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "포켓몬이 메가진화를 하면\n확실히 더 강해지게 돼.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1416,
      "rawDecodedUtf16Hex": "D3ECCF13BAACC7740020BA54AC00C9C4D654B97C0020D558BA74000AD655C2E4D7880020B3540020AC15D574C9C0AC8C0020B3FC002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "그렇지만 트레이너 자신이\n메가진화에 대해 잘 알고 있어야<U+0010><U+0001>븀\n포켓몬이 가진 개성을 잘 살릴 수 있는 거야.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 1480,
      "rawDecodedUtf16Hex": "ADF8B807C9C0B9CC0020D2B8B808C774B1080020C790C2E0C774000ABA54AC00C9C4D654C5D00020B300D5740020C7980020C54CACE00020C788C5B4C57C00100001BE00000AD3ECCF13BAACC7740020AC00C9C40020AC1CC131C7440020C7980020C0B4B9B40020C2180020C788B2940020AC70C57C002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "네!\n앞으로 더 정진하겠습니다!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1612,
      "rawDecodedUtf16Hex": "B1240021000AC55EC73CB85C0020B3540020C815C9C4D558ACA0C2B5B2C8B2E4002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "시로가 저렇게 얌전하다니,\n코르니 씨... 굉장한 사람.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1656,
      "rawDecodedUtf16Hex": "C2DCB85CAC000020C800B807AC8C0020C58CC804D558B2E4B2C8002C000ACF54B974B2C80020C528002E002E002E0020AD49C7A5D55C0020C0ACB78C002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "감동적인 승부였습니다!\n부디 이 의상을 받아 주세요!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1728,
      "rawDecodedUtf16Hex": "AC10B3D9C801C7780020C2B9BD80C600C2B5B2C8B2E40021000ABD80B5140020C7740020C758C0C1C7440020BC1BC5440020C8FCC138C694002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "고마워!\n그렇지만 사양할게.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "ACE0B9C8C6CC0021000AADF8B807C9C0B9CC0020C0ACC591D560AC8C002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "나한테는 이미 사라시티의 체육관 관장이자\n메가진화의 계승자라는 캐릭터가 있으니까.<U+0010><U+0001>븀\n지금은 MZ단의 일원이기도 하고.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "B098D55CD14CB2940020C774BBF80020C0ACB77CC2DCD2F0C7580020CCB4C721AD000020AD00C7A5C774C790000ABA54AC00C9C4D654C7580020ACC4C2B9C790B77CB2940020CE90B9ADD130AC000020C788C73CB2C8AE4C002E00100001BE00000AC9C0AE08C7400020004D005AB2E8C7580020C77CC6D0C774AE30B3C40020D558ACE0002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "롤러스케이트도 포기했는데\n저스티스회의 도복까지 입으면<U+0010><U+0001>븀\n너무 복잡해질 것 같아서 말이야.<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "B864B7ECC2A4CF00C774D2B8B3C40020D3ECAE30D588B294B370000AC800C2A4D2F0C2A4D68CC7580020B3C4BCF5AE4CC9C00020C785C73CBA7400100001BE00000AB108BB340020BCF5C7A1D574C9C80020AC830020AC19C544C11C0020B9D0C774C57C002E00100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "알겠습니다.\n그럼, <U+0010><U+0002>Ā<U+0000> 씨에게 드리겠습니다.<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2092,
      "rawDecodedUtf16Hex": "C54CACA0C2B5B2C8B2E4002E000AADF8B7FC002C002000100002010000000020C528C5D0AC8C0020B4DCB9ACACA0C2B5B2C8B2E4002E00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001>\n시로 코디 도복 세트를 손에 넣었다!",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "00100002010000000010000219000001000AC2DCB85C0020CF54B5140020B3C4BCF50020C138D2B8B97C0020C190C5D00020B123C5C8B2E400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "시로, 무례해.<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 2216,
      "rawDecodedUtf16Hex": "C2DCB85C002C0020BB34B840D574002E00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "트레이너로서의 저 자신도\n메가진화시켜 보겠습니다!<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 2244,
      "rawDecodedUtf16Hex": "D2B8B808C774B108B85CC11CC7580020C8000020C790C2E0B3C4000ABA54AC00C9C4D654C2DCCF1C0020BCF4ACA0C2B5B2C8B2E4002100100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "여기는...\n어디에도 없는 장소?<U+0010><U+0002>Ĕ<U+0012>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 2308,
      "rawDecodedUtf16Hex": "C5ECAE30B294002E002E002E000AC5B4B514C5D0B3C40020C5C6B2940020C7A5C18C003F00100002011400120000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "지나치게 강한 힘은\n고통을 동반하기 마련이야...<U+0010><U+0001>븁\n그걸 뛰어넘을 수 있게 해 주는 게\n포켓몬과 트레이너의 유대인 거지!<U+0010><U+0002>Ĕƒ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2356,
      "rawDecodedUtf16Hex": "C9C0B098CE58AC8C0020AC15D55C0020D798C740000AACE0D1B5C7440020B3D9BC18D558AE300020B9C8B828C774C57C002E002E002E00100001BE01000AADF8AC780020B6F0C5B4B118C7440020C2180020C788AC8C0020D5740020C8FCB2940020AC8C000AD3ECCF13BAACACFC0020D2B8B808C774B108C7580020C720B300C7780020AC70C9C0002100100002011401920000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    }
