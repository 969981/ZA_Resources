      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "0048006500790021002000410072006500200079006F00750020004F004B003F002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Oh, thank goodness... I was worried you’d never\nwake up.<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 2388,
