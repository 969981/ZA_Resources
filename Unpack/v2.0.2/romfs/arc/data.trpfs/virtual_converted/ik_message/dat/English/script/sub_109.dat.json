      "offsetInSection": 1900,
      "rawDecodedUtf16Hex": "00440069006400200069007400200067006F00200069006E002000740068006500720065002E002E002E003F00100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
