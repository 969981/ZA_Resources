      "rawDecodedUtf16Hex": "0059006F007500200067006F007400740061002000680065006C00700020006D0065002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "My little sister wandered off after a Litwick!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 368,
      "rawDecodedUtf16Hex": "004D00790020006C006900740074006C00650020007300690073007400650072002000770061006E006400650072006500640020006F00660066002000610066007400650072002000610020004C00690074007700690063006B002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "I’ve heard about Litwick... They’re the Pokémon\nthat suck out your life force!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 472,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "What if my sister has all her life force drained...?\nWhat if she never comes back...?<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Please! You’ve gotta help me find my sister!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "0050006C0065006100730065002100200059006F007520190076006500200067006F007400740061002000680065006C00700020006D0065002000660069006E00640020006D00790020007300690073007400650072002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Fwoop... Shoo...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 920,
      "rawDecodedUtf16Hex": "00460077006F006F0070002E002E002E002000530068006F006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
