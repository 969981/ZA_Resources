      "index": 7,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "00540068006100740020007700610073002000610020004C00690074007700690063006B002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Maybe if we follow it, we’ll be able to find my\nsister!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1004,
      "rawDecodedUtf16Hex": "004D006100790062006500200069006600200077006500200066006F006C006C006F0077002000690074002C0020007700652019006C006C002000620065002000610062006C006500200074006F002000660069006E00640020006D0079000A007300690073007400650072002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
