      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "My sister says she came here to help this Litwick.<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2512,
      "rawDecodedUtf16Hex": "004D00790020007300690073007400650072002000730061007900730020007300680065002000630061006D00650020006800650072006500200074006F002000680065006C0070002000740068006900730020004C00690074007700690063006B002E00100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "The poor little thing seemed really weak, so I was\nletting it absorb some of my life force.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "I heard somewhere that’s what helps Litwick stay\nhappy and healthy...<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 32,
      "offsetInSection": 2816,
      "rawDecodedUtf16Hex": "004900200068006500610072006400200073006F006D006500770068006500720065002000740068006100742019007300200077006800610074002000680065006C007000730020004C00690074007700690063006B00200073007400610079000A0068006100700070007900200061006E00640020006800650061006C007400680079002E002E002E00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Y-you should leave that kind of thing to someone\ngrown-up like me! I have way more life force!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2964,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Yeah, I guess...<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3164,
      "rawDecodedUtf16Hex": "0059006500610068002C00200049002000670075006500730073002E002E002E00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Thanks for coming to find me, anyway.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3208,
      "rawDecodedUtf16Hex": "005400680061006E006B007300200066006F007200200063006F006D0069006E006700200074006F002000660069006E00640020006D0065002C00200061006E0079007700610079002E00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
