      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Maybe you should go further into the sewers and\nsee what you can find.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "004D006100790062006500200079006F0075002000730068006F0075006C006400200067006F0020006600750072007400680065007200200069006E0074006F0020007400680065002000730065007700650072007300200061006E0064000A0073006500650020007700680061007400200079006F0075002000630061006E002000660069006E0064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Is my sister really down here? I hope she’s OK...<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 1716,
