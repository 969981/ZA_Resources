      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Oooh! Il tuo MegaCamerupt sembrava sul punto\ndi esplodere! Mi ha rubato il cuore!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
