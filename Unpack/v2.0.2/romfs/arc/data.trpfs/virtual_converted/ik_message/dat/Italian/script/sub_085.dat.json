      "index": 4,
      "offsetInSection": 752,
      "rawDecodedUtf16Hex": "002E002E002E0020004D00450047004100450056004F004C0055005A0049004F004E0045002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Ho bisogno di una trasformazione! Di vedere\nil potere sconvolgente della megaevoluzione!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "In particolare, so che vedere un MegaCamerupt\nin eruzione riaccenderebbe la mia vena creativa!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 99
    },
    {
      "displayText": "Perciò ho un favore da chiederti: lotta contro di me\ne mostrami un MegaCamerupt!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1188,
