      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "La mia creatività è in fiamme!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2720,
      "rawDecodedUtf16Hex": "004C00610020006D00690061002000630072006500610074006900760069007400E0002000E800200069006E0020006600690061006D006D0065002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "Appassionati di lenti a contatto di Luminopoli,\nvi consegnerò un nuovo mondo di colori!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Adesso hai a disposizione due nuovi colori\ndi lenti a contatto: \"Fiamme\" e \"Cuori\".",
