    },
    {
      "displayText": "Che senso ha lottare se poi non mi mostri\nun MegaCamerupt?! Avanti, riproviamo!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
