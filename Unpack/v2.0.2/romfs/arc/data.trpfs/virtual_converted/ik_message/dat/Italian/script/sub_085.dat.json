      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2048,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Il tuo MegaCamerupt mi ispirerà una nuova\ngamma di lenti a contatto!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "0049006C002000740075006F0020004D00650067006100430061006D006500720075007000740020006D00690020006900730070006900720065007200E000200075006E00610020006E0075006F00760061000A00670061006D006D00610020006400690020006C0065006E007400690020006100200063006F006E0074006100740074006F002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
