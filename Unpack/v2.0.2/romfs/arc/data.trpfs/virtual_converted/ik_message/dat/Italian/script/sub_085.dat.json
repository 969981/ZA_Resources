      "flagsUpper16": 4,
      "index": 23,
      "offsetInSection": 2976,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 84
    },
    {
      "displayText": "Abbina la megaevoluzione alle lenti e ottieni\nrisultati... eccel-lenti!<U+0010><U+0002>Ĕų",
