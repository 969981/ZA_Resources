      "offsetInSection": 1260,
      "rawDecodedUtf16Hex": "BB34C11CC6CC002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "엄청나!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1280,
      "rawDecodedUtf16Hex": "C5C4CCADB098002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
