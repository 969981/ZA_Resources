      "offsetInSection": 276,
      "rawDecodedUtf16Hex": "B1240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 2
    },
    {
      "displayText": "대리인이에요",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
