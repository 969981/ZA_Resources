      "rawDecodedUtf16Hex": "D30CC5570021003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "왜 그래, 파트너!\n설마... 녀석이!?<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "C65C0020ADF8B798002C0020D30CD2B8B1080021000AC124B9C8002E002E002E0020B140C11DC7740021003F00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "바르르!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "BC14B974B974002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "크다!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "D06CB2E4002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
