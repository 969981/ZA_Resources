      "offsetInSection": 632,
      "rawDecodedUtf16Hex": "ADF8AC740020BC14B85C002E002E002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "라이츄들의 메가진화!<U+0010><U+0002>ĔŪ",
