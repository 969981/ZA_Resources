      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2492,
      "rawDecodedUtf16Hex": "ADF8B798C11C0020B458C7740020C758AE30D22CD569D574C11C000ACD5CAC15C7580020B77CC774CE040020CF64BE44AC000020B418C790B29400100001BE00000AAFC8C7740020C0DDACBCC5B4C694002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
