      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "어머, <U+0010><U+0002>Ā<U+0000> 씨!<U+0010><U+0002>Ĕĥ",
