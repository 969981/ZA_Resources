      "offsetInSection": 492,
      "rawDecodedUtf16Hex": "C54CB85CB77C0021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "포켓몬 교환도 멋지지 않나요?<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
