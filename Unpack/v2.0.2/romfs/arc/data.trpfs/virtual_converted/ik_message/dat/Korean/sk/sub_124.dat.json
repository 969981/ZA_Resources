      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "갑작스럽지만 오늘은 당신에게\n보여 드리고 싶은 게 있어요!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "AC11C791C2A4B7FDC9C0B9CC0020C624B298C7400020B2F9C2E0C5D0AC8C000ABCF4C5EC0020B4DCB9ACACE00020C2F6C7400020AC8C0020C788C5B4C6940021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "그건 바로...<U+0010><U+0002>Ĕĥ",
