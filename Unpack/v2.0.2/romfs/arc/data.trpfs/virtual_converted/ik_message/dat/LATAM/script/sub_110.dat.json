      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 352,
      "rawDecodedUtf16Hex": "00100002BDFF00020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Ya te diste cuenta de que últimamente hay\nmucho lodo por toda la ciudad?<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Como esa pila de ahí, sin ir más lejos.<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 520,
      "rawDecodedUtf16Hex": "0043006F006D006F0020006500730061002000700069006C006100200064006500200061006800ED002C002000730069006E0020006900720020006D00E100730020006C0065006A006F0073002E00100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Un día estaba meditando y tuve una idea genial:\n¡poner un negocio de limpieza y ganar millones!<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Así que corrí a capturar un Clauncher porque\nse les da muy bien usar Chorro de Agua.<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
      "offsetInSection": 808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "¡Pero no resultó como esperaba! A mi Clauncher\nno le interesa ni un poco eso de limpiar.<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 988,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "¡Cheeer!",
