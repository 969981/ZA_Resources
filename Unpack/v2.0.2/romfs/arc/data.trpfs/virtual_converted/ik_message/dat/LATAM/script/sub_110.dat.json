      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "00A100430068006500650065007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡¿Te molesta si te pido un favor?!<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "00A100BF005400650020006D006F006C00650073007400610020007300690020007400650020007000690064006F00200075006E0020006600610076006F0072003F002100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¿Podrías pedirle a uno de tus Pokémon que use\nChorro de Agua para limpiar ese lodo y enseñarle<U+0010><U+0001>븀\na mi Clauncher lo genial que es hacerlo?<U+0010><U+0001>븁\nYo creo que, si lo ve, tal vez se inspire.<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 6,
