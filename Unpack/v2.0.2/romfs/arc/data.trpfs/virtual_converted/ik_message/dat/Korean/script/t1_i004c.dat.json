  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "항상 최상의 서비스를...\n궁극 레스토랑입니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "D56DC0C10020CD5CC0C1C7580020C11CBE44C2A4B97C002E002E002E000AAD81ADF90020B808C2A4D1A0B791C785B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "최상의 풀코스에\n도전해 주세요<U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 268,
      "rawDecodedUtf16Hex": "CD5CC0C1C7580020D480CF54C2A4C5D0000AB3C4C804D5740020C8FCC138C69400100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "역시 궁극이야,\n이름 그대로라니까!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 332,
      "rawDecodedUtf16Hex": "C5EDC2DC0020AD81ADF9C774C57C002C000AC774B9840020ADF8B300B85CB77CB2C8AE4C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "내가 이 맛을 즐기게 되다니,\n살아 있길 잘했어!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 372,
      "rawDecodedUtf16Hex": "B0B4AC000020C7740020B9DBC7440020C990AE30AC8C0020B418B2E4B2C8002C000AC0B4C5440020C788AE380020C798D588C5B400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "좋은 결론이 나오면 좋겠네",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 428,
      "rawDecodedUtf16Hex": "C88BC7400020ACB0B860C7740020B098C624BA740020C88BACA0B1240000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "배가 고프면 판단력이 흐려지니\n최고의 요리로 배를 채워야지",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 460,
      "rawDecodedUtf16Hex": "BC30AC000020ACE0D504BA740020D310B2E8B825C7740020D750B824C9C0B2C8000ACD5CACE0C7580020C694B9ACB85C0020BC30B97C0020CC44C6CCC57CC9C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "승부의 세계에\n절대란 건 없어",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "C2B9BD80C7580020C138ACC4C5D0000AC808B300B7800020AC740020C5C6C5B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "누나랑 포켓몬이 싸우는 모습은\n정말 멋지다니까!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 564,
      "rawDecodedUtf16Hex": "B204B098B7910020D3ECCF13BAACC7740020C2F8C6B0B2940020BAA8C2B5C740000AC815B9D00020BA4BC9C0B2E4B2C8AE4C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "포켓몬 트레이너만 해서\n먹고살 수 있겠어?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 620,
      "rawDecodedUtf16Hex": "D3ECCF13BAAC0020D2B8B808C774B108B9CC0020D574C11C000ABA39ACE0C0B40020C2180020C788ACA0C5B4003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "나는 언니 편!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 668,
      "rawDecodedUtf16Hex": "B098B2940020C5B8B2C80020D3B800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "회사에 짜증 나는 사람이 있는데,\n포켓몬 승부로 날려 버리고 싶을 정도라니까.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 688,
      "rawDecodedUtf16Hex": "D68CC0ACC5D00020C9DCC99D0020B098B2940020C0ACB78CC7740020C788B294B370002C000AD3ECCF13BAAC0020C2B9BD80B85C0020B0A0B8240020BC84B9ACACE00020C2F6C7440020C815B3C4B77CB2C8AE4C002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "응응, 그렇구나.\n응응, 그 마음 잘 알지.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 776,
      "rawDecodedUtf16Hex": "C751C751002C0020ADF8B807AD6CB098002E000AC751C751002C0020ADF80020B9C8C74C0020C7980020C54CC9C0002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "크렘 브륄레 ~궁극~\n정말 궁극이야...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 828,
      "rawDecodedUtf16Hex": "D06CB8180020BE0CB944B8080020007EAD81ADF9007E000AC815B9D00020AD81ADF9C774C57C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "그야말로 최고의 카라멜리제!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 876,
      "rawDecodedUtf16Hex": "ADF8C57CB9D0B85C0020CD5CACE0C7580020CE74B77CBA5CB9ACC81C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "포켓몬 트레이너와\n미식가가 모이는 가게라니 굉장하지 않아?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "D3ECCF13BAAC0020D2B8B808C774B108C640000ABBF8C2DDAC00AC000020BAA8C774B2940020AC00AC8CB77CB2C80020AD49C7A5D558C9C00020C54AC544003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "이곳은 오너인 크리스토프 씨가\n포켓몬 승부와 음식의 궁극을 추구하는 가게.<U+0010><U+0001>븀\n...솔직히 무슨 소린지 모르겠어.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 976,
      "rawDecodedUtf16Hex": "C774ACF3C7400020C624B108C7780020D06CB9ACC2A4D1A0D5040020C528AC00000AD3ECCF13BAAC0020C2B9BD80C6400020C74CC2DDC7580020AD81ADF9C7440020CD94AD6CD558B2940020AC00AC8C002E00100001BE00000A002E002E002EC194C9C1D7880020BB34C2A80020C18CB9B0C9C00020BAA8B974ACA0C5B4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "저희 가게의 요리에는\n저마다 먹기 좋은 타이밍이 있답니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1108,
      "rawDecodedUtf16Hex": "C800D76C0020AC00AC8CC7580020C694B9ACC5D0B294000AC800B9C8B2E40020BA39AE300020C88BC7400020D0C0C774BC0DC7740020C788B2F5B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "다 먹고 나면\n포켓몬 승부를 할까?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "B2E40020BA39ACE00020B098BA74000AD3ECCF13BAAC0020C2B9BD80B97C0020D560AE4C003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "서로를 이해하기에는\n승부가 제일이지",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1216,
      "rawDecodedUtf16Hex": "C11CB85CB97C0020C774D574D558AE30C5D0B294000AC2B9BD80AC000020C81CC77CC774C9C00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "단골손님만을 위한 디저트를\n먹기 위해 파트너와 단련했어",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "B2E8ACE8C190B2D8B9CCC7440020C704D55C0020B514C800D2B8B97C000ABA39AE300020C704D5740020D30CD2B8B108C6400020B2E8B828D588C5B40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "많이 노력한 자신에게\n상을 주러 왔답니다",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1320,
      "rawDecodedUtf16Hex": "B9CEC7740020B178B825D55C0020C790C2E0C5D0AC8C000AC0C1C7440020C8FCB7EC0020C654B2F5B2C8B2E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "제 머릿속에는 온통\n직원식 생각뿐이에요...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "C81C0020BA38B9BFC18DC5D0B2940020C628D1B5000AC9C1C6D0C2DD0020C0DDAC01BFD0C774C5D0C694002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "젊었을 때부터 좋은 것을 경험해 보는 건\n중요한 일이니 사양 말고 많이 먹으렴.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1420,
      "rawDecodedUtf16Hex": "C80AC5C8C7440020B54CBD80D1300020C88BC7400020AC83C7440020ACBDD5D8D5740020BCF4B2940020AC74000AC911C694D55C0020C77CC774B2C80020C0ACC5910020B9D0ACE00020B9CEC7740020BA39C73CB834002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "식사에서 중요한 것은 누구와 함께 먹는가야.\n맛없지만 않으면 가게는 어디든 상관없어.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1512,
      "rawDecodedUtf16Hex": "C2DDC0ACC5D0C11C0020C911C694D55C0020AC83C7400020B204AD6CC6400020D568AED80020BA39B294AC00C57C002E000AB9DBC5C6C9C0B9CC0020C54AC73CBA740020AC00AC8CB2940020C5B4B514B4E00020C0C1AD00C5C6C5B4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "궁극의 맛을 알고 나면\n다른 곳의 요리로는 만족할 수 없게 되거든.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1608,
      "rawDecodedUtf16Hex": "AD81ADF9C7580020B9DBC7440020C54CACE00020B098BA74000AB2E4B9780020ACF3C7580020C694B9ACB85CB2940020B9CCC871D5600020C2180020C5C6AC8C0020B418AC70B4E0002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "궁극의 맛을 알고 나면\n다른 요리의 수준을 알 수 있게 돼.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "AD81ADF9C7580020B9DBC7440020C54CACE00020B098BA74000AB2E4B9780020C694B9ACC7580020C218C900C7440020C54C0020C2180020C788AC8C0020B3FC002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    }
