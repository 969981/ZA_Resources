      "index": 3,
      "offsetInSection": 440,
      "rawDecodedUtf16Hex": "0045006C0020007400690070006F0020004E006F0072006D0061006C0020006E006F0020007400690065006E00650020006300610073006900200064006500620069006C006900640061006400650073002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Vamos, que es un tipo invencible ante cualquier\nadversario.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "00560061006D006F0073002C002000710075006500200065007300200075006E0020007400690070006F00200069006E00760065006E006300690062006C006500200061006E007400650020006300750061006C00710075006900650072000A006100640076006500720073006100720069006F002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Lo digo yo, que estoy muy viajado y he combatido\ncontra toda clase de Pokémon por el mundo.<U+0010><U+0001>븁\nNo puedo estar equivocado.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 660,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
    {
      "displayText": "¡Permíteme que te demuestre mi teoría sobre\nel tipo Normal con un combate Pokémon!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 912,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
