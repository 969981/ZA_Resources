      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Todos mis Pokémon son de tipo Normal.\nMe eches lo que me eches, seguro que gano.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
