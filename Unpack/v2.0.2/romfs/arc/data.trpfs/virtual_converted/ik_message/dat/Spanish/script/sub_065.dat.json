      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2140,
      "rawDecodedUtf16Hex": "00440065002000700065002000610020007000610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
