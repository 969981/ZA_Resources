      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿List<U+0010><U+0003>ᄀÿāoa para una demostración práctica\nde mi teoría sobre el tipo Normal?<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 4,
