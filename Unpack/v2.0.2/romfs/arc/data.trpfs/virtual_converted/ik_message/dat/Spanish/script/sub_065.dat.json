      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 2604,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
