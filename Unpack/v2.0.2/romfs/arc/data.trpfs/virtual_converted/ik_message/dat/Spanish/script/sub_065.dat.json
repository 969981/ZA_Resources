      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1632,
      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Supongo que tendré que estudiar más a fondo\nla compatibilidad entre tipos...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1644,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Pero tengo un problema...<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1808,
      "rawDecodedUtf16Hex": "005000650072006F002000740065006E0067006F00200075006E002000700072006F0062006C0065006D0061002E002E002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
