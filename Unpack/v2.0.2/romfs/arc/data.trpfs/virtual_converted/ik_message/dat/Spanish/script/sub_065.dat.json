      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "¡Eres un<U+0010><U+0003>ᄀÿĀa Entrenador<U+0010><U+0003>ᄀÿĀa increíble!<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "00A1004500720065007300200075006E00100003110000FF0100006100200045006E007400720065006E00610064006F007200100003110000FF0100006100200069006E00630072006500ED0062006C0065002100100002011401640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "No te preocupes, estamos todos igual.<U+0010><U+0002>ĔŤ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2304,
