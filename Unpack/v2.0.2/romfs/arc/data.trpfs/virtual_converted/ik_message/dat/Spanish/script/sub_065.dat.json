      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2824,
      "rawDecodedUtf16Hex": "00530069002000650073006F0020006E006F00200066007500650073006500200061007300ED002C00200070006F0064007200ED00610020006C0075006300680061007200200063006F006E007400720061000A006300750061006C007100750069006500720061002000730069006E0020006D006900650064006F002E00100002011401640000",
      "trailingZeroPaddingUnits": 1,
