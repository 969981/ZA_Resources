      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "List<U+0010><U+0003>ᄀÿāoa",
