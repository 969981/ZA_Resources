      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Noch ist es ein bisschen früh für einen\nNeuanfang, meinst du nicht?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 280,
      "rawDecodedUtf16Hex": "004E006F006300680020006900730074002000650073002000650069006E00200062006900730073006300680065006E00200066007200FC00680020006600FC0072002000650069006E0065006E000A004E006500750061006E00660061006E0067002C0020006D00650069006E007300740020006400750020006E0069006300680074003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Man nennt mich Madame Neuanfang.\nWir werden uns sicher gut verstehen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 416,
      "rawDecodedUtf16Hex": "004D0061006E0020006E0065006E006E00740020006D0069006300680020004D006100640061006D00650020004E006500750061006E00660061006E0067002E000A005700690072002000770065007200640065006E00200075006E007300200073006900630068006500720020006700750074002000760065007200730074006500680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Mein Job ist es, die Basispunkte von Pokémon\nzurückzusetzen und ihnen so zu ermöglichen,<U+0010><U+0001>븀\neinen neuen Weg einzuschlagen...",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 556,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 125
    },
    {
      "displayText": "Für schlappe <U+0010><U+0003>Ȅ<U+0002>  Mega-Splitter kann ich die\nBasispunkte eines Pokémon zurücksetzen.<U+0010><U+0001>븁\nWenn du einen Neuanfang brauchst, sprich mich\neinfach an.",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 808,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 147
    },
    {
      "displayText": "Ich bin Madame Neuanfang.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1104,
      "rawDecodedUtf16Hex": "004900630068002000620069006E0020004D006100640061006D00650020004E006500750061006E00660061006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Willst du mir <U+0010><U+0003>Ȅ<U+0002>  Mega-Splitter geben,\num die Basispunkte von einem deiner Pokémon<U+0010><U+0001>븀\nzurückzusetzen?",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Ja",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1364,
      "rawDecodedUtf16Hex": "004A00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Ein andermal...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1372,
      "rawDecodedUtf16Hex": "00450069006E00200061006E006400650072006D0061006C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Erklärung anhören",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1404,
      "rawDecodedUtf16Hex": "00450072006B006C00E400720075006E006700200061006E006800F600720065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "Ich kann sämtliche Basispunkte von Pokémon,\ndie sie durch hartes Training gesammelt haben,<U+0010><U+0001>븀\nzurücksetzen. So, als wär nie was passiert.<U+0010><U+0001>븁\nDafür benötige ich <U+0010><U+0003>Ȅ<U+0002>  Mega-Splitter.\nWenn dir danach ist, sprich mich einfach an.",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1440,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 226
    },
    {
      "displayText": "Um die Basispunkte zurückzusetzen, benötige ich\n<U+0010><U+0003>Ȅ<U+0002>  Mega-Splitter.",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1892,
      "rawDecodedUtf16Hex": "0055006D002000640069006500200042006100730069007300700075006E006B007400650020007A0075007200FC0063006B007A0075007300650074007A0065006E002C002000620065006E00F600740069006700650020006900630068000A0010000302040002202F0020004D006500670061002D00530070006C00690074007400650072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Welches Pokémon soll einen neuen Anfang\nmachen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2032,
      "rawDecodedUtf16Hex": "00570065006C006300680065007300200050006F006B00E9006D006F006E00200073006F006C006C002000650069006E0065006E0020006E006500750065006E00200041006E00660061006E0067000A006D0061006300680065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Auswählen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2128,
      "rawDecodedUtf16Hex": "004100750073007700E40068006C0065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
