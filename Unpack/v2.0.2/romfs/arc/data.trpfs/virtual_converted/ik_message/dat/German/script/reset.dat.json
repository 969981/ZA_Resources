      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Ja",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2340,
      "rawDecodedUtf16Hex": "004A00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Nein",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2348,
      "rawDecodedUtf16Hex": "004E00650069006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Was soll ich da zurücksetzen?\nDie Basispunkte von <U+0010><U+0002>Ă<U+0003> sind<U+0010><U+0001>븀\ndoch<U+0010><U+0001>븀\nschon<U+0010><U+0001>븀\nauf dem<U+0010><U+0001>븀\nMinimum!",
      "escapedControlUnits": 14,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Also dann, <U+0010><U+0002>Ă<U+0003>. Zeit für einen\nNeuanfang.",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2568,
      "rawDecodedUtf16Hex": "00100002BD0600000041006C0073006F002000640061006E006E002C00200010000201020003002E0020005A0065006900740020006600FC0072002000650069006E0065006E000A004E006500750061006E00660061006E0067002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ein frischer Start, alles neu sortiert.\nDeine Vergangenheit ist ausradiert.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Die Basispunkte von <U+0010><U+0002>Ă<U+0003> wurden\nzurückgesetzt.",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2816,
      "rawDecodedUtf16Hex": "00100002BD06000000440069006500200042006100730069007300700075006E006B0074006500200076006F006E00200010000201020003002000770075007200640065006E000A007A0075007200FC0063006B00670065007300650074007A0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
