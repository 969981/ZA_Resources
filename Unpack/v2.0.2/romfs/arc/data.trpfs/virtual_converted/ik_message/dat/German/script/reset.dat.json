      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2164,
      "rawDecodedUtf16Hex": "00410062006200720065006300680065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Möchtest du wirklich, dass <U+0010><U+0002>Ă<U+0003>\nalle<U+0010><U+0001>븀\nseine<U+0010><U+0001>븀\nBasispunkte<U+0010><U+0001>븀\nverliert?",
