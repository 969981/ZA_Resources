      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2148,
      "rawDecodedUtf16Hex": "00420065007200690063006800740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
