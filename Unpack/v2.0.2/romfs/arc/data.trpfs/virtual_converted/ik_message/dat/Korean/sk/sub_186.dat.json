      "offsetInSection": 3192,
      "rawDecodedUtf16Hex": "C6B8D2B8B77C0020D504B9ACBBF8C5C40020C5BCD2F0BA54C774D2B80020CEE4D53C002E002E002E000AC5BCD2F0BA54C774D2B80020C2A4D398C15CC7440020B9C8C2E40020C900BE44B2940020B418C168B098C694003F00100002011401E00000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
