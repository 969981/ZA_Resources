      "offsetInSection": 2640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "그냥 좀 주세요!!!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
