      "offsetInSection": 1128,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Do you want to see the bench in the photo again?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1140,
      "rawDecodedUtf16Hex": "0044006F00200079006F0075002000770061006E007400200074006F00200073006500650020007400680065002000620065006E0063006800200069006E0020007400680065002000700068006F0074006F00200061006700610069006E003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Yeah, let me see",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "0059006500610068002C0020006C006500740020006D006500200073006500650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "I think I’m good",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 10,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "00490020007400680069006E006B002000492019006D00200067006F006F00640000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Here you go! Do you recognize the bench?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1320,
      "rawDecodedUtf16Hex": "004800650072006500200079006F007500200067006F002100200044006F00200079006F00750020007200650063006F0067006E0069007A00650020007400680065002000620065006E00630068003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "I really hope you can help me find it!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1412,
