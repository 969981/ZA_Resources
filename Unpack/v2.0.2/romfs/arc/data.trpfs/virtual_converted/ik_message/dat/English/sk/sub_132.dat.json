    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Oh! Hello, you’re <U+0010><U+0002>Ā<U+0000>,\nright?<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 0,
