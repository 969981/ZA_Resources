      "offsetInSection": 1112,
      "rawDecodedUtf16Hex": "0042006F0077007A007A007A00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0007>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
