      "rawDecodedUtf16Hex": "00100002BD060000004F00680021002000480065006C006C006F002C00200079006F007520190072006500200010000201000000002C000A00720069006700680074003F00100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "My favorite streamer in the whole world posted\nthis photo the other day! Just LOOK at it!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 420,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "It’s too good, right? Canari just chilling on a\nbench with her Eelektross, looking AMAZING.<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 2,
      "offsetInSection": 608,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "I want to sit on the exact same bench and get my\nown shot with Manectric!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 3,
      "offsetInSection": 800,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>So I could really use your help,\n<U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "00100002BD0600000053006F0020004900200063006F0075006C00640020007200650061006C006C0079002000750073006500200079006F00750072002000680065006C0070002C000A0010000201000000002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Help me find that bench!<U+0010><U+0002>ĔƮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1052,
      "rawDecodedUtf16Hex": "00480065006C00700020006D0065002000660069006E006400200074006800610074002000620065006E00630068002100100002011401AE0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "Bowzzz!",
