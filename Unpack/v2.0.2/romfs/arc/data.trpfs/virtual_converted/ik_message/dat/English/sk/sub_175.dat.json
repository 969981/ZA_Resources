      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "I don’t think it’s happy",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 50,
      "offsetInSection": 5748,
      "rawDecodedUtf16Hex": "004900200064006F006E201900740020007400680069006E006B002000690074201900730020006800610070007000790000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
