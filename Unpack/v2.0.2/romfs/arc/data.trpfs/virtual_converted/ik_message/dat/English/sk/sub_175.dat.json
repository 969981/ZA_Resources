      "rawDecodedUtf16Hex": "0053006800610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Whoa! You’re lookin’ for friends for your brave\nFrigibax here, huh?<U+0010><U+0002>Ĕǒ",
