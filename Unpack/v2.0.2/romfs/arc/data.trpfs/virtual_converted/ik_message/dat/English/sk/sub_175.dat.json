      "offsetInSection": 5620,
      "rawDecodedUtf16Hex": "004200410042004100580021002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Frigibax! What’s the matter? Why are you yelling?<U+0010><U+0002>ĔǏ",
