      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 2464,
      "rawDecodedUtf16Hex": "4F60771F662F68D2900F4E86FF0100100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "啊嘎！",
