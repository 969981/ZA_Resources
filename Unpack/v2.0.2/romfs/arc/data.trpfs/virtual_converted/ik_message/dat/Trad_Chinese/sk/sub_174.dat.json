      "offsetInSection": 1920,
      "rawDecodedUtf16Hex": "4F3C4E4E6B635728627E570D5DFE76844E3B4EBA0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "正在找上頭刺繡的名字的人……\n好時髦的故事喔！<U+0010><U+0002>Ĕ:",
