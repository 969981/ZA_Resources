      "rawDecodedUtf16Hex": "70BA4E8685CD9D094E5F597DFF0C000A8ACB627E51FA570D5DFE76844E3B4EBA5427300200100002011401CD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
