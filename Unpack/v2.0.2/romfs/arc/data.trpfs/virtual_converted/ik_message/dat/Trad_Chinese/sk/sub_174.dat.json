      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "等等，你該不會\n是那時候的稚山雀？<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
