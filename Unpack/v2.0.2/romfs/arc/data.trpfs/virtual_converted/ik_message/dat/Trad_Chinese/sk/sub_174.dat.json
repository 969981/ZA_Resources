      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳是信賴身為設計師的我，\n才會讓我做這個鑑定對吧。<U+0010><U+0002>Ĕ:",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1624,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B3662F4FE18CF48EAB70BA8A2D8A085E2B76846211FF0C000A624D67038B936211505A9019500B94515B9A5C0D54273002001000020114003A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "這條圍巾……<U+0010><U+0002>Ĕ:",
