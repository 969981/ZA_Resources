      "rawDecodedUtf16Hex": "554A560EFF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "你明明受過傷……\n當時明明那麼小一隻……<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2376,
      "rawDecodedUtf16Hex": "4F60660E660E53D7904E50B720262026000A75766642660E660E90A39EBC5C0F4E0096BB2026202600100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "居然來找搬到密阿雷的我啊。<U+0010><U+0002>Ĕǌ",
