      "offsetInSection": 548,
      "rawDecodedUtf16Hex": "8ACB00100003110000FF01014F6059B3770B770B901996BB85CD9D09300200100002011401CD0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "牠好像很珍惜地帶著一條\n破破爛爛的絲綢圍巾呢。<U+0010><U+0002>ĔǍ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 588,
