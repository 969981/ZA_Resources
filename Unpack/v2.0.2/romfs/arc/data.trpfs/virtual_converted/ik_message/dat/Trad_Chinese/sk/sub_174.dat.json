      "rawDecodedUtf16Hex": "771F768450477684FF01FF1F000A6211501153EF662F57284F3D52D2723E5730534076F8904776848036300200100001BE00000A4F607ADF713698DB8D8A6D776D0B904E4F86FF1F00100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "啊嘎！",
      "escapedControlUnits": 0,
