      "rawDecodedUtf16Hex": "5C4571364F86627E642C52305BC6963F96F776846211554A300200100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "你真是棒透了！<U+0010><U+0002>Ĕǌ",
