    },
    {
      "displayText": "¡Hola! ¿Has visto a mis Floette?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 200,
