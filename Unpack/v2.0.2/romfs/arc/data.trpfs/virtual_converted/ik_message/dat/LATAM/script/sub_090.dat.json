      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "¡Ahora puedes elegir entre nueve tintes pastel\nnuevos en la peluquería!",
