      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "En el tumulto del combate, los cinco colores de\nsus flores se entremezclaron y es como si<U+0010><U+0001>븀\nhubiera surgido un color completamente nuevo...<U+0010><U+0001>븁\n¡Tengo que ponerme manos a la obra!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 6,
      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 1700,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 184
    },
    {
      "displayText": "¡Si a los colores les añades blanco,\nconsigues un tono pastel superprecioso!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
