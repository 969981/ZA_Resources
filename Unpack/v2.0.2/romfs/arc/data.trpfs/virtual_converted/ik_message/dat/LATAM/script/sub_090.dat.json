      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2232,
      "rawDecodedUtf16Hex": "00A100410068006F00720061002000700075006500640065007300200065006C006500670069007200200065006E0074007200650020006E0075006500760065002000740069006E007400650073002000700061007300740065006C000A006E007500650076006F007300200065006E0020006C0061002000700065006C0075007100750065007200ED006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Puedes estar orgullos<U+0010><U+0003>ᄀÿāoa. Gracias a ti, la gente de\nCiudad Luminalia podrá disfrutar de tintes de pelo<U+0010><U+0001>븀\nmucho más coloridos ahora.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 6,
