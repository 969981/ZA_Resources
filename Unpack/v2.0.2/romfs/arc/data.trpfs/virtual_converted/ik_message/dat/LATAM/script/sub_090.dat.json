      "index": 19,
      "offsetInSection": 2376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "Siempre serás bienvenid<U+0010><U+0003>ᄀÿāoa en mi peluquería\ncuando tengas ganas de un cambio de estilo.<U+0010><U+0002>ĔŴ",
