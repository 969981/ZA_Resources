  "format": "GF Trinity encrypted UTF-16 message DAT",
  "initialKey": 0,
  "messages": [
    {
      "displayText": "Bienvenue au Firmament, où\nservice et goût côtoient les étoiles.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 212,
      "rawDecodedUtf16Hex": "004200690065006E00760065006E007500650020006100750020004600690072006D0061006D0065006E0074002C0020006F00F9000A007300650072007600690063006500200065007400200067006F00FB00740020006300F40074006F00690065006E00740020006C00650073002000E90074006F0069006C00650073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Venez donc goûter à un menu\ndégustation de qualité ! <U+0010><U+0002>봊\nText_icon1",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 344,
      "rawDecodedUtf16Hex": "00560065006E0065007A00200064006F006E006300200067006F00FB007400650072002000E000200075006E0020006D0065006E0075000A006400E90067007500730074006100740069006F006E0020006400650020007100750061006C0069007400E900200021002000100002BD0A000A0054006500780074005F00690063006F006E00310000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Les mets sont ravissants, ici !\nJ’ai des étoiles plein les yeux !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 480,
      "rawDecodedUtf16Hex": "004C006500730020006D00650074007300200073006F006E007400200072006100760069007300730061006E00740073002C002000690063006900200021000A004A2019006100690020006400650073002000E90074006F0069006C0065007300200070006C00650069006E0020006C0065007300200079006500750078002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Quel honneur de pouvoir\nprofiter de ces délices !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 612,
      "rawDecodedUtf16Hex": "005100750065006C00200068006F006E006E00650075007200200064006500200070006F00750076006F00690072000A00700072006F0066006900740065007200200064006500200063006500730020006400E9006C0069006300650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "J’espère que ça va aller...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 712,
      "rawDecodedUtf16Hex": "004A201900650073007000E8007200650020007100750065002000E7006100200076006100200061006C006C00650072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "On ne peut pas réfléchir le\nventre vide, alors mangeons !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 768,
      "rawDecodedUtf16Hex": "004F006E0020006E00650020007000650075007400200070006100730020007200E90066006C00E900630068006900720020006C0065000A00760065006E00740072006500200076006900640065002C00200061006C006F007200730020006D0061006E00670065006F006E0073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Lors d’un combat,\ntout peut arriver !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 884,
      "rawDecodedUtf16Hex": "004C006F007200730020006420190075006E00200063006F006D006200610074002C000A0074006F007500740020007000650075007400200061007200720069007600650072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Tes Pokémon et toi, vous avez trop\nla classe quand vous vous battez !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 960,
      "rawDecodedUtf16Hex": "00540065007300200050006F006B00E9006D006F006E00200065007400200074006F0069002C00200076006F007500730020006100760065007A002000740072006F0070000A006C006100200063006C00610073007300650020007100750061006E006400200076006F0075007300200076006F00750073002000620061007400740065007A002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Je me demande juste si tu peux\ngagner ta vie en étant Dresseuse.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "004A00650020006D0065002000640065006D0061006E006400650020006A007500730074006500200073006900200074007500200070006500750078000A006700610067006E00650072002000740061002000760069006500200065006E002000E900740061006E00740020004400720065007300730065007500730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Moi, je crois en toi, en tout cas !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1232,
      "rawDecodedUtf16Hex": "004D006F0069002C0020006A0065002000630072006F0069007300200065006E00200074006F0069002C00200065006E00200074006F007500740020006300610073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Parfois, mes collègues m’énervent tellement que\nj’ai envie de les écraser dans un combat Pokémon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1304,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Hmmm ? Oui, oui, tout à fait.\nJe suis d’accord.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1500,
      "rawDecodedUtf16Hex": "0048006D006D006D0020003F0020004F00750069002C0020006F00750069002C00200074006F00750074002000E000200066006100690074002E000A004A006500200073007500690073002000642019006100630063006F00720064002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Cette crème brûlée me ravit\nles papilles !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 1596,
      "rawDecodedUtf16Hex": "0043006500740074006500200063007200E8006D006500200062007200FB006C00E900650020006D0065002000720061007600690074000A006C0065007300200070006100700069006C006C00650073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "La couche de caramel est\ntout bonnement sublime !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1684,
      "rawDecodedUtf16Hex": "004C006100200063006F007500630068006500200064006500200063006100720061006D0065006C0020006500730074000A0074006F0075007400200062006F006E006E0065006D0065006E00740020007300750062006C0069006D0065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Cet établissement plaît autant aux fines bouches\nqu’aux adeptes de combats Pokémon ! C’est fou !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Christophe, le propriétaire, veut mettre à l’honneur\nles combats Pokémon et la cuisine...<U+0010><U+0001>븀\nQuand on y réfléchit, ça n’a aucun sens.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1980,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
      "displayText": "Nos plats ne sauraient être servis autrement\nque parfaits.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2248,
      "rawDecodedUtf16Hex": "004E006F007300200070006C0061007400730020006E006500200073006100750072006100690065006E0074002000EA0074007200650020007300650072007600690073002000610075007400720065006D0065006E0074000A007100750065002000700061007200660061006900740073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "On se fait un combat\naprès manger ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2368,
      "rawDecodedUtf16Hex": "004F006E0020007300650020006600610069007400200075006E00200063006F006D006200610074000A00610070007200E800730020006D0061006E0067006500720020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Allez ! Rien de tel pour apprendre\nà se connaître !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2440,
      "rawDecodedUtf16Hex": "0041006C006C0065007A002000210020005200690065006E002000640065002000740065006C00200070006F00750072002000610070007000720065006E006400720065000A00E000200073006500200063006F006E006E006100EE007400720065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "J’ai appris à mon Pokémon\nà apprécier les desserts.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2544,
      "rawDecodedUtf16Hex": "004A2019006100690020006100700070007200690073002000E00020006D006F006E00200050006F006B00E9006D006F006E000A00E00020006100700070007200E900630069006500720020006C00650073002000640065007300730065007200740073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Après l’effort, le réconfort !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2648,
      "rawDecodedUtf16Hex": "00410070007200E800730020006C2019006500660066006F00720074002C0020006C00650020007200E90063006F006E0066006F00720074002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Je pense sans cesse à ce que\nje vais manger pendant ma pause.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2712,
      "rawDecodedUtf16Hex": "004A0065002000700065006E00730065002000730061006E0073002000630065007300730065002000E00020006300650020007100750065000A006A0065002000760061006900730020006D0061006E006700650072002000700065006E00640061006E00740020006D0061002000700061007500730065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Il faut savoir apprécier la bonne cuisine dès le\nplus jeune âge. Commande tout ce que tu veux !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "Moi, tant que c’est bon, ça me va !\nL’important, c’est d’être en bonne compagnie !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3028,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Une fois qu’on a goûté à la cuisine du Firmament,\ntout le reste paraît fade.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 24,
      "offsetInSection": 3196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Une fois qu’on a goûté à la cuisine du Firmament,\non peut reconnaître plein de saveurs différentes.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 25,
      "offsetInSection": 3352,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    }
