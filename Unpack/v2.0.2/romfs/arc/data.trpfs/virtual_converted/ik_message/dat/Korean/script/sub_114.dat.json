      "trailingZeroPaddingUnits": 2,
      "utf16Units": 5
    },
    {
      "displayText": "시로 님이 부재중이지만\n이건 저에게 기회이기도 해요.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 360,
      "rawDecodedUtf16Hex": "C2DCB85C0020B2D8C7740020BD80C7ACC911C774C9C0B9CC000AC774AC740020C800C5D0AC8C0020AE30D68CC774AE30B3C40020D574C694002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> 씨!\n갑작스럽지만 저와 승부해 주세요!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 428,
