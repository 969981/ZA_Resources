      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2480,
      "rawDecodedUtf16Hex": "B135002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> 씨,\n오늘은 정말 고마웠어요!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
