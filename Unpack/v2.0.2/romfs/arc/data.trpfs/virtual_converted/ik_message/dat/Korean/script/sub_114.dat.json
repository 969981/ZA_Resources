      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000> 씨!\n수고 많으셨어요!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "00100002010000000020C5280021000AC218ACE00020B9CEC73CC168C5B4C694002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "쿠오?",
