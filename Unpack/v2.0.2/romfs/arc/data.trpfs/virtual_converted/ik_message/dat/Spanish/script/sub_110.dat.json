      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "00A1005000650072006F0020006E006F0073002000680065006D006F007300200063006F006D00700072006F006D0065007400690064006F002000790020006C006F0020006C0069006D00700069006100720065006D006F0073000A0069006700750061006C002100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
