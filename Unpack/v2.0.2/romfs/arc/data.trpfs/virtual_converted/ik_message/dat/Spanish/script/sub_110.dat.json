      "offsetInSection": 1600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 188
    },
    {
      "displayText": "¡Eh, que la gracia es que tu Pokémon use\n<U+0010><U+0002>＀<U+0006>Pistola Agua<U+0010><U+0002>＀<U+0000>!<U+0010><U+0002>ĔƆ",
