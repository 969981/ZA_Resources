      "rawDecodedUtf16Hex": "00A100450068002C00200071007500650020006C00610020006700720061006300690061002000650073002000710075006500200074007500200050006F006B00E9006D006F006E0020007500730065000A00100002FF0000060050006900730074006F006C00610020004100670075006100100002FF000000002100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
