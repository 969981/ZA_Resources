      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¿Has visto? Un buen chorro y adiós lodo.<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2212,
