      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 2436,
      "rawDecodedUtf16Hex": "0041006C007500630069006E006F002E002E002E002000A100BF0045006E00200073006500720069006F00200068006100200072006500760065006E007400610064006F00200075006E006100200072006F0063006100200063006F006E000A0050006900730074006F006C006100200041006700750061003F002100100002011401860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡Clauncher, amigo, eres la bomba!<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2572,
