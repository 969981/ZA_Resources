      "rawDecodedUtf16Hex": "C57CC0DD0020D3ECCF13BAACC7740020B3C4C2DCC5D0C11C0020C0ACB2940020AC74000AD798B4E40020AC70B77C0020C0DDAC01D588C5C8B294B370002C00100001BE00000AD3ECCF13BAACB4E4C7400020C81C0020C0DDAC01BCF4B2E40020B3540020AC15D55C0020AC830020AC19B124C694002E00100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
