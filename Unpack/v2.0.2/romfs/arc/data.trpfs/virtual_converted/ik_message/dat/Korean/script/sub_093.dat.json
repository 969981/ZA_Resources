      "offsetInSection": 700,
      "rawDecodedUtf16Hex": "C384C57C002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "에엥?\n루차불, 무슨 일이야!?<U+0010><U+0002>ĔŶ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
