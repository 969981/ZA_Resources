      "rawDecodedUtf16Hex": "B8E8CC28BD88ACFC0020C2B9BD80D5740020C8FCC154C11C0020AC10C0ACD574C694002100100002011401760000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
