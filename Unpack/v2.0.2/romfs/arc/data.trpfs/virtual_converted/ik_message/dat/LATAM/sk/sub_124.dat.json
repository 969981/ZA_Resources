  "initialKey": 0,
  "messages": [
    {
      "displayText": "¡Hola! Gracias de nuevo por haberme dado ese\nPikachu.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
