      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Las Piedras Trueno son una maravilla.\n¡Adoro a mi Raichu!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 528,
      "rawDecodedUtf16Hex": "004C006100730020005000690065006400720061007300200054007200750065006E006F00200073006F006E00200075006E00610020006D00610072006100760069006C006C0061002E000A00A100410064006F0072006F002000610020006D00690020005200610069006300680075002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "¡Alola!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 652,
      "rawDecodedUtf16Hex": "00A10041006C006F006C00610021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Y no hay que menospreciar los intercambios\nPokémon. El Raichu que me diste es un primor.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Pero vayamos al grano. Hoy tenemos algo que\nmostrarte.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 864,
      "rawDecodedUtf16Hex": "005000650072006F00200076006100790061006D006F007300200061006C0020006700720061006E006F002E00200048006F0079002000740065006E0065006D006F007300200061006C0067006F0020007100750065000A006D006F0073007400720061007200740065002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Así es. Nada más ni nada menos que...<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 5,
      "offsetInSection": 984,
      "rawDecodedUtf16Hex": "0041007300ED002000650073002E0020004E0061006400610020006D00E100730020006E00690020006E0061006400610020006D0065006E006F00730020007100750065002E002E002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "¡Las formas megaevolucionadas de nuestros\nRaichu!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1068,
      "rawDecodedUtf16Hex": "00A1004C0061007300200066006F0072006D006100730020006D00650067006100650076006F006C007500630069006F006E00610064006100730020006400650020006E00750065007300740072006F0073000A0052006100690063006800750021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "¿Y qué mejor forma de hacerlo que con\nun combate Pokémon? Así que prepárate<U+0010><U+0001>븀\ny ven a vernos cuando estés list<U+0010><U+0003>ᄀÿāoa.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1176,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1424,
      "rawDecodedUtf16Hex": "00100002BDFF00080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quieres combatir contra nuestros Raichu\nmegaevolucionados?<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1436,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200063006F006D0062006100740069007200200063006F006E0074007200610020006E00750065007300740072006F00730020005200610069006300680075000A006D00650067006100650076006F006C007500630069006F006E00610064006F0073003F00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "¿Quieres combatir contra nuestro dúo de Raichu\nmegaevolucionados?<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1564,
      "rawDecodedUtf16Hex": "00BF005100750069006500720065007300200063006F006D0062006100740069007200200063006F006E0074007200610020006E00750065007300740072006F0020006400FA006F0020006400650020005200610069006300680075000A006D00650067006100650076006F006C007500630069006F006E00610064006F0073003F001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "¡Vamos!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1704,
      "rawDecodedUtf16Hex": "00A100560061006D006F007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Un momento",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 1720,
      "rawDecodedUtf16Hex": "0055006E0020006D006F006D0065006E0074006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¿Tienes algo mejor que hacer o qué?\n¡Te queremos mostrar a nuestros Mega-Raichu!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1744,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 85
    },
    {
      "displayText": "¡Prepárate para verlos en primera fila!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1916,
      "rawDecodedUtf16Hex": "00A1005000720065007000E10072006100740065002000700061007200610020007600650072006C006F007300200065006E0020007000720069006D006500720061002000660069006C0061002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡No tardes mucho, que queremos mostrarte\nnuestros Mega-Raichu!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "00A1004E006F00200074006100720064006500730020006D007500630068006F002C0020007100750065002000710075006500720065006D006F00730020006D006F0073007400720061007200740065000A006E00750065007300740072006F00730020004D006500670061002D0052006100690063006800750021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡Prepárate para verlos en primera fila!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2140,
      "rawDecodedUtf16Hex": "00A1005000720065007000E10072006100740065002000700061007200610020007600650072006C006F007300200065006E0020007000720069006D006500720061002000660069006C00610021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡¿Raichu?!...<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2228,
      "rawDecodedUtf16Hex": "00A100BF005200610069006300680075003F0021002E002E002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "¡Qué grandes! ¡Son como alfas!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 2264,
      "rawDecodedUtf16Hex": "00A10051007500E90020006700720061006E0064006500730021002000A10053006F006E00200063006F006D006F00200061006C0066006100730021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
