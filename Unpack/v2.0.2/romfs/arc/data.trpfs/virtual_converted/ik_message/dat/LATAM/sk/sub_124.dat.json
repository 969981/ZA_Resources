      "offsetInSection": 2336,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Mega-Raichu X, desata toda tu fuerza eléctrica\npor las colas!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2348,
      "rawDecodedUtf16Hex": "00A1004D006500670061002D00520061006900630068007500200058002C002000640065007300610074006100200074006F0064006100200074007500200066007500650072007A006100200065006C00E9006300740072006900630061000A0070006F00720020006C0061007300200063006F006C00610073002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡Este combate lo patrocina el nuevo Comité para\nla Popularización de Mega-Raichu Y!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2484,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0016>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "00100002BDFF00160000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "No me extraña que te fuera tan bien en\nlos Juegos Z-A.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2672,
      "rawDecodedUtf16Hex": "004E006F0020006D006500200065007800740072006100F100610020007100750065002000740065002000660075006500720061002000740061006E0020006200690065006E00200065006E000A006C006F00730020004A007500650067006F00730020005A002D0041002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "No esperaba menos de la persona que salvó\nla ciudad de la catástrofe.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2792,
      "rawDecodedUtf16Hex": "004E006F0020006500730070006500720061006200610020006D0065006E006F00730020006400650020006C006100200070006500720073006F006E00610020007100750065002000730061006C007600F3000A006C006100200063006900750064006100640020006400650020006C0061002000630061007400E1007300740072006F00660065002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Gracias de nuevo, <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2940,
      "rawDecodedUtf16Hex": "00470072006100630069006100730020006400650020006E007500650076006F002C00200010000201000000002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Sin tu colaboración, no hubiéramos podido\nformar nuestro dúo de Raichu.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Toma esta Raichunita X como muestra de\nmi agradecimiento.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3148,
      "rawDecodedUtf16Hex": "0054006F006D0061002000650073007400610020005200610069006300680075006E0069007400610020005800200063006F006D006F0020006D007500650073007400720061002000640065000A006D0069002000610067007200610064006500630069006D00690065006E0074006F002E00100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Y, de mi parte, una Raichunita Y.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3272,
      "rawDecodedUtf16Hex": "0059002C0020006400650020006D0069002000700061007200740065002C00200075006E00610020005200610069006300680075006E00690074006100200059002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "¡Hasta la próxima, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3348,
      "rawDecodedUtf16Hex": "00A1004800610073007400610020006C006100200070007200F300780069006D0061002C00200010000201000000002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "¡Alola!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 3408,
      "rawDecodedUtf16Hex": "00A10041006C006F006C00610021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001F>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 3432,
      "rawDecodedUtf16Hex": "00100002BDFF001F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Uy, pero si es <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3444,
      "rawDecodedUtf16Hex": "00A100550079002C0020007000650072006F00200073006900200065007300200010000201000000002100100002011401250000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡Qué casualidad! Justo estábamos hablando de\nti.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 3496,
      "rawDecodedUtf16Hex": "00A10051007500E9002000630061007300750061006C006900640061006400210020004A007500730074006F002000650073007400E100620061006D006F00730020006800610062006C0061006E0064006F002000640065000A00740069002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Nada malo, espero",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3604,
      "rawDecodedUtf16Hex": "004E0061006400610020006D0061006C006F002C002000650073007000650072006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "¿Y eso?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3640,
      "rawDecodedUtf16Hex": "00BF0059002000650073006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Hablábamos de lo agradecidas que estamos por\ntu ayuda.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3656,
      "rawDecodedUtf16Hex": "004800610062006C00E100620061006D006F00730020006400650020006C006F002000610067007200610064006500630069006400610073002000710075006500200065007300740061006D006F007300200070006F0072000A00740075002000610079007500640061002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "¡El Raichu que evolucionó de tu Pikachu con\nmi Piedra Trueno está mejor que nunca!<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 3776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "¡Y el Raichu que me intercambiaste también está\nestupendamente!<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 3952,
      "rawDecodedUtf16Hex": "00A1005900200065006C002000520061006900630068007500200071007500650020006D006500200069006E00740065007200630061006D006200690061007300740065002000740061006D0062006900E9006E002000650073007400E1000A006500730074007500700065006E00640061006D0065006E007400650021001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Es que nos encontramos de casualidad en la calle\ny nos pusimos a admirar a nuestros Raichu...<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 39,
      "offsetInSection": 4088,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 98
    },
    {
      "displayText": "Y, cuando nos pusimos a hablar del tema, resultó\nque ambos los habíamos conseguido gracias a ti.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4284,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 101
    },
    {
      "displayText": "Ahí nació nuestra amistad y nuestro sueño de\nformar el dúo de Raichu más fuerte del mundo.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 41,
      "offsetInSection": 4488,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "Si nos llegamos a conocer, fue gracias a ti y\na esta ciudad.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 4680,
      "rawDecodedUtf16Hex": "005300690020006E006F00730020006C006C006500670061006D006F00730020006100200063006F006E006F006300650072002C0020006600750065002000670072006100630069006100730020006100200074006900200079000A0061002000650073007400610020006300690075006400610064002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "¡Raaai!...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4812,
      "rawDecodedUtf16Hex": "00A1005200610061006100690021002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¡Voy a usar una Piedra Trueno con todos\nlos Pikachu del mundo!<U+0010><U+0001>븁\nEs broma, yo nunca haría eso.<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4836,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Mi Raichu es todo lo que necesito en esta vida.<U+0010><U+0002>ĔŪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 5036,
      "rawDecodedUtf16Hex": "004D0069002000520061006900630068007500200065007300200074006F0064006F0020006C006F00200071007500650020006E006500630065007300690074006F00200065006E0020006500730074006100200076006900640061002E001000020114016A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "<U+0010><U+0002>뷿.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 5140,
      "rawDecodedUtf16Hex": "00100002BDFF002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Me pregunto cuál es mejor, si Mega-Raichu X o\nMega-Raichu Y...<U+0010><U+0002>Ĕĥ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
