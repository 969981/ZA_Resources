      "utf16Units": 44
    },
    {
      "displayText": "Dales una mano cuando te\nreúnas con ellos.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 4216,
      "rawDecodedUtf16Hex": "00440061006C0065007300200075006E00610020006D0061006E006F0020006300750061006E0064006F002000740065000A0072006500FA006E0061007300200063006F006E00200065006C006C006F0073002E0000",
      "trailingZeroPaddingUnits": 1,
