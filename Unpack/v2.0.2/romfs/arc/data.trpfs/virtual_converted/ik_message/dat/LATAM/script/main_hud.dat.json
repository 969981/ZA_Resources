      "rawDecodedUtf16Hex": "00100002BDFF00300000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Veo que lograste cruzar el río!\nLa \"Daria\" esa debe estar cerca.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4316,
      "rawDecodedUtf16Hex": "00A100560065006F00200071007500650020006C006F0067007200610073007400650020006300720075007A0061007200200065006C0020007200ED006F0021000A004C006100200022004400610072006900610022002000650073006100200064006500620065002000650073007400610072002000630065007200630061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Se llama Naria, no Daria.\n¡¡Más respeto!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4448,
      "rawDecodedUtf16Hex": "005300650020006C006C0061006D00610020004E0061007200690061002C0020006E006F002000440061007200690061002E000A00A100A1004D00E100730020007200650073007000650074006F002100210000",
