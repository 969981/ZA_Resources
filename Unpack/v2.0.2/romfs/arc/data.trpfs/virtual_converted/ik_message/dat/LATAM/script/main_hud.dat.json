      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Yo sigo fresco como una lechuga.\n¡La justicia no descansa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 4616,
      "rawDecodedUtf16Hex": "0059006F0020007300690067006F002000660072006500730063006F00200063006F006D006F00200075006E00610020006C006500630068007500670061002E000A00A1004C00610020006A00750073007400690063006900610020006E006F002000640065007300630061006E0073006100210000",
      "trailingZeroPaddingUnits": 1,
