      "index": 12,
      "offsetInSection": 2452,
      "rawDecodedUtf16Hex": "00BF0043007500E1006C00200065007300200065006C00200050006F006B00E9006D006F006E0020006300750079006F0073002000700075006E0074006F007300200064006500200062006100730065000A00710075006900650072006500730020007200650073007400610062006C0065006300650072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
