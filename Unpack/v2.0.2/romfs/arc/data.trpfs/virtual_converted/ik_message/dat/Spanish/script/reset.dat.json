      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Supongo que aún es pronto para hacer borrón y\ncuenta nueva, ¿no?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 312,
      "rawDecodedUtf16Hex": "005300750070006F006E0067006F00200071007500650020006100FA006E002000650073002000700072006F006E0074006F0020007000610072006100200068006100630065007200200062006F0072007200F3006E00200079000A006300750065006E007400610020006E0075006500760061002C002000BF006E006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Me llamo Nicia... Rei Nicia. Quiero proponerte\nuna cosa, a ver qué te parece.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Si quieres, puedo restablecer los puntos de base\nde algún Pokémon para limpiar su expediente y<U+0010><U+0001>븀\ndarle otra oportunidad en la vida.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 600,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Si quieres que le haga borrón y cuenta nueva a\nalgún Pokémon, necesito <U+0010><U+0003>Ȅ<U+0002>  Megaesquirla<U+0010><U+0003>ᄁ<U+0002>Ās.<U+0010><U+0001>븁\nAvísame cuando requieras mis servicios.",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 868,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 140
    },
    {
      "displayText": "Soy Nicia... Rei Nicia.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1148,
      "rawDecodedUtf16Hex": "0053006F00790020004E0069006300690061002E002E002E00200052006500690020004E0069006300690061002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>¿Quieres que restablezca los puntos de base de\nalgún Pokémon a cambio de<U+0010><U+0001>븀\n<U+0010><U+0003>Ȅ<U+0002>  Megaesquirla<U+0010><U+0003>ᄁ<U+0002>Ās?",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "Venga",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "00560065006E006700610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
