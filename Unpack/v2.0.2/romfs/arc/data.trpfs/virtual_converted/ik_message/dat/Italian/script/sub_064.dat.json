      "rawDecodedUtf16Hex": "00560061002000620065006E006500210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Lasciamo stare",
      "escapedControlUnits": 0,
