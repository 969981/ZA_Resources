      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2352,
      "rawDecodedUtf16Hex": "00500061007A007A006500730063006F00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Dicono che quest’AZ abbia fatto delle ricerche per\nconto proprio sull’origine della megaevoluzione<U+0010><U+0001>븀\nin una lontana regione chiamata Hoenn.<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2372,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "E, sempre stando alle voci, avrebbe poi\ncomunicato alla Q-asar Inc. i risultati delle sue<U+0010><U+0001>븀\nricerche. Mi chiedo che intenzioni abbia.<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2664,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 139
    },
    {
