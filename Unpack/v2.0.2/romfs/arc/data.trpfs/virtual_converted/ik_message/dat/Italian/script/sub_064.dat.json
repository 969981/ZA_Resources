      "rawDecodedUtf16Hex": "004700720061007A00690065002C0020004D00650067006100500069006E007300690072002E0020004500200061006E006300680065002000610067006C006900200061006C007400720069002E000A004100760065007400650020006C006F0074007400610074006F002000620065006E0065002E00100002011401630000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Ultimamente gli Allenatori che usano\nla megaevoluzione sono aumentati.<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 1916,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Gira voce che la Q-asar Inc. abbia trovato il modo\ndi produrre i Megacerchi.<U+0010><U+0001>븁\nPare che dietro ci sia lo zampino di un certo AZ.<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2068,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 134
    },
    {
