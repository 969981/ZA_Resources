      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Avanti! Perché non vieni a sfidare i miei Pokémon\ndi tipo Coleottero?<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 6,
