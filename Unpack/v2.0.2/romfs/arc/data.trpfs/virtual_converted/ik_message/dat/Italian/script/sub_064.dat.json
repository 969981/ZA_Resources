      "trailingZeroPaddingUnits": 1,
      "utf16Units": 203
    },
    {
      "displayText": "Dove c’è amore c’è ingegno, e dove c’è ingegno\nc’è forza! Avanti, fatti sotto!<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 2,
