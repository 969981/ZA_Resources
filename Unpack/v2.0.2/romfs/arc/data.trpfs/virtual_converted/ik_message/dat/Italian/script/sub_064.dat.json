      "index": 3,
      "offsetInSection": 740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Se vuoi sfidarmi, preparati alla lotta e poi vieni\na parlare con me!<U+0010><U+0002>Ĕţ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 908,
      "rawDecodedUtf16Hex": "00530065002000760075006F00690020007300660069006400610072006D0069002C002000700072006500700061007200610074006900200061006C006C00610020006C006F0074007400610020006500200070006F00690020007600690065006E0069000A00610020007000610072006C00610072006500200063006F006E0020006D0065002100100002011401630000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 73
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0005>",
