      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Tu as vu ça, Flingouste ? C’est comme ça\nqu’il faut utiliser Pistolet à O !<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
