      "index": 26,
      "offsetInSection": 3248,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 126
    },
    {
      "displayText": "Toi et moi, on va devenir les champions du\nnettoyage et du combat ! Rien ne nous arrêtera !<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
