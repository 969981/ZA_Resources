      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "T’es trop fort, Flingouste !<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2800,
