      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2488,
      "rawDecodedUtf16Hex": "004F0075007300740065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Mais non, pas le rocher ! C’est la boue qu’il\nfaut viser ! La boue !!!<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
