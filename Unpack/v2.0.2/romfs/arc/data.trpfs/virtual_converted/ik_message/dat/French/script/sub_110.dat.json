      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "J’hallucine ! Il a éclaté le rocher avec\nPistolet à O !!!<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
