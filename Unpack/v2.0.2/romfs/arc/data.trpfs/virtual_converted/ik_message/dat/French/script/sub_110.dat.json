      "offsetInSection": 1748,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 180
    },
    {
      "displayText": "Hé !\nC’est <U+0010><U+0002>＀<U+0006>Pistolet à O<U+0010><U+0002>＀<U+0000> qu’il faut utiliser !<U+0010><U+0002>ĔƆ",
      "escapedControlUnits": 8,
