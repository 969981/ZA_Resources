      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 964,
      "rawDecodedUtf16Hex": "B098C544007E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "잉어킹과 사이좋게 지낼 수 있게\n빈티나를 연못에 풀어 줬어요!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 972,
