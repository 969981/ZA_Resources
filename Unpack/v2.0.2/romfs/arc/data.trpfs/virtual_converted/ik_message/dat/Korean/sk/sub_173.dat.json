      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "빈티나, 우리 사이좋게 지내자!<U+0010><U+0002>Ĕǋ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
