      "rawDecodedUtf16Hex": "8D228D22FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "它是我在帕底亚地区旅游的时候\n捉到的宝可梦。<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
