      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "天灵灵地灵灵，等的就是你这句话！！<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1460,
      "rawDecodedUtf16Hex": "592970757075573070757075FF0C7B4976845C31662F4F608FD953E58BDDFF01FF0100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "赛富豪的光芒……\n好像连我也闪闪发光了！<U+0010><U+0002>Ĕǁ",
