      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "但要让索财灵进化，\n必须要有索财灵的硬币才行。<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 444,
      "rawDecodedUtf16Hex": "4F4689818BA97D228D2270758FDB5316FF0C000A5FC5987B898167097D228D2270757684786C5E01624D884C300200100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "需要的数量竟然是……<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 500,
      "rawDecodedUtf16Hex": "970089817684657091CF7ADF7136662F2026202600100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "999枚！<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 532,
      "rawDecodedUtf16Hex": "003900390039679AFF0100100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "但在密阿雷市\n是找不到索财灵的硬币的。<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 552,
      "rawDecodedUtf16Hex": "4F4657285BC6963F96F75E02000A662F627E4E0D52307D228D2270757684786C5E017684300200100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "我有一个请求！拜托你听一听！\n我把索财灵托付给你，让它进化吧！<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 600,
