      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "让索财灵进化吧。<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 892,
      "rawDecodedUtf16Hex": "8BA97D228D2270758FDB53165427300200100002011401C10000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "顺便收下我在帕底亚地区\n收集的索财灵的硬币吧。<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
