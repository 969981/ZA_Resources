      "offsetInSection": 384,
      "rawDecodedUtf16Hex": "97F3FF5E55EF30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "发生什么事了吗？",
