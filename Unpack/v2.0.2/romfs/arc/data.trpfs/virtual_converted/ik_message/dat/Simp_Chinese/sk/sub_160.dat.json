      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "00100002BDFF00290000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "生活在城市里的野生宝可梦\n真是够强健的啊。<U+0010><U+0002>ĔǇ",
      "escapedControlUnits": 2,
