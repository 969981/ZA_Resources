      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "这是新买的密阿雷格雷派饼。\n和小电音一起吃吧。<U+0010><U+0002>ĔǇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
