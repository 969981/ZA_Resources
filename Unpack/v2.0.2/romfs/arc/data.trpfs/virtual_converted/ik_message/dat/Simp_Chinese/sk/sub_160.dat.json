      "index": 34,
      "offsetInSection": 1464,
      "rawDecodedUtf16Hex": "20262026563630020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "你要是想吃，就表现出来嘛。\n那样的话，我会分一些给你的。<U+0010><U+0002>ĔǇ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
