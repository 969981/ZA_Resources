      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0002>ᤀ<U+0001>\n움직일 수 없게 되었다...",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
