      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "그럼, 다음 방문을 기대하고 있겠습니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 92,
      "offsetInSection": 7052,
