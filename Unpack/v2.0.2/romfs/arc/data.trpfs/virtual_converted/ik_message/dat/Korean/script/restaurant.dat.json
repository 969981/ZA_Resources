      "rawDecodedUtf16Hex": "D3ECCF13BAAC0020C2B9BD80B97C000AB05DAE4CC9C00020B4DCC2DCC9C00020BABBD574C11C0020C544C27DB124C694002E00100001BE00000AB2E4C74CC5D00020B6100020B3C4C804D5740020C8FCC2EDC2DCC624002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "훌륭하십니다!<U+0010><U+0001>븁\n이건 저희 가게의 코스를 만끽해 주신\n답례입니다.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 5604,
      "rawDecodedUtf16Hex": "D6CCB96DD558C2EDB2C8B2E4002100100001BE01000AC774AC740020C800D76C0020AC00AC8CC7580020CF54C2A4B97C0020B9CCB07DD5740020C8FCC2E0000AB2F5B840C785B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "다음부터는 100000원을 받습니다만\n또 방문해 주시기를 기대하고 있겠습니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 5684,
      "rawDecodedUtf16Hex": "B2E4C74CBD80D130B2940020003100300030003000300030C6D0C7440020BC1BC2B5B2C8B2E4B9CC000AB6100020BC29BB38D5740020C8FCC2DCAE30B97C0020AE30B300D558ACE00020C788ACA0C2B5B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "<U+0010><U+0002>뷿J",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 5772,
      "rawDecodedUtf16Hex": "00100002BDFF004A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "헤이! 어서 오세요!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 5784,
      "rawDecodedUtf16Hex": "D5E4C77400210020C5B4C11C0020C624C138C694002100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "동양적인 매력이 폭발!\n돌아가는 OSUSHI 레스토랑<U+0010><U+0001>븀\n롤링 드리머입니다!!<U+0010><U+0001>븁\n어떻습니까, 손님?\n갓 잡은 포켓몬과 최상의 포켓몬 승부<U+0010><U+0001>븀\n5연전에 도전하시겠습니까?<U+0010><U+0001>븁\n물론 첫 회는 무료입니다!\n단, 상대는 포켓몬이죠!",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 5812,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "동양적인 매력이 폭발!\n돌아가는 OSUSHI 레스토랑<U+0010><U+0001>븀\n롤링 드리머입니다!!<U+0010><U+0001>븁\n어떻습니까, 손님?\n갓 잡은 포켓몬과 최상의 포켓몬 승부<U+0010><U+0001>븀\n5연전을 30000원에 도전하시겠습니까?",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 6072,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 106
    },
    {
      "displayText": "도전한다",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 6284,
      "rawDecodedUtf16Hex": "B3C4C804D55CB2E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "설명을 듣는다",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 6296,
      "rawDecodedUtf16Hex": "C124BA85C7440020B4E3B294B2E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "그만둔다",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 6312,
      "rawDecodedUtf16Hex": "ADF8B9CCB454B2E40000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "알겠습니다.\n이쪽으로 오세요.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 6324,
      "rawDecodedUtf16Hex": "C54CACA0C2B5B2C8B2E4002E000AC774CABDC73CB85C0020C624C138C694002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "대단히 죄송합니다만\n돈이 부족하신 것 같습니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 82,
      "offsetInSection": 6360,
      "rawDecodedUtf16Hex": "B300B2E8D7880020C8C4C1A1D569B2C8B2E4B9CC000AB3C8C7740020BD80C871D558C2E00020AC830020AC19C2B5B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "포켓몬을 회복시키지 않고\n5번 연속으로 승리해 주시면 됩니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 6416,
      "rawDecodedUtf16Hex": "D3ECCF13BAACC7440020D68CBCF5C2DCD0A4C9C00020C54AACE0000A0035BC880020C5F0C18DC73CB85C0020C2B9B9ACD5740020C8FCC2DCBA740020B429B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "다음 방문을 기대하고 있겠습니다.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 84,
      "offsetInSection": 6488,
      "rawDecodedUtf16Hex": "B2E4C74C0020BC29BB38C7440020AE30B300D558ACE00020C788ACA0C2B5B2C8B2E4002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "첫 번째 코스는\n화원의 모양을 곁들인 벌레포켓몬입니다.<U+0010><U+0001>븀\n그럼, 맛있게 드십시오.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 85,
      "offsetInSection": 6528,
      "rawDecodedUtf16Hex": "CCAB0020BC88C9F80020CF54C2A4B294000AD654C6D0C7580020BAA8C591C7440020ACC1B4E4C7780020BC8CB808D3ECCF13BAACC785B2C8B2E4002E00100001BE00000AADF8B7FC002C0020B9DBC788AC8C0020B4DCC2EDC2DCC624002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "두 번째 코스는\n미르와르 도로산 포켓몬들입니다.<U+0010><U+0001>븀\n그럼, 맛있게 드십시오.",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 6624,
