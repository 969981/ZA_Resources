      "offsetInSection": 2420,
      "rawDecodedUtf16Hex": "00A10051007500E90020006D006900650064006F002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "¡Es increíble!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2452,
      "rawDecodedUtf16Hex": "00A10045007300200069006E00630072006500ED0062006C0065002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "¡Es él! ¡No hay duda!<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2492,
      "rawDecodedUtf16Hex": "00A100450073002000E9006C0021002000A1004E006F002000680061007900200064007500640061002100100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "¡¡Nelbyyy!!",
