      "rawDecodedUtf16Hex": "005300ED0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Soy <U+0010><U+0003>ᄀÿਊel becariola becaria",
