      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Hace mucho tiempo, en otra región, a los\nPokémon enormes y violentos con los ojos<U+0010><U+0001>븀\nbrillantes como este los llamaban Pokémon <U+0010><U+0002>＀<U+0006>alfa<U+0010><U+0002>＀<U+0000>.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 10,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2848,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 145
    },
    {
      "displayText": "No tengo ni idea de cómo ha llegado un Pokémon\ncomo esos a Ciudad Luminalia.<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3140,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "¿Qué dices tú, colega?\n¿No te da muy mal rollo todo esto?<U+0010><U+0002>ĔĦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 3304,
      "rawDecodedUtf16Hex": "00BF0051007500E90020006400690063006500730020007400FA002C00200063006F006C006500670061003F000A00BF004E006F0020007400650020006400610020006D007500790020006D0061006C00200072006F006C006C006F00200074006F0064006F0020006500730074006F003F00100002011401260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Bun, bun, bunn...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 28,
