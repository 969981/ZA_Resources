      "rawDecodedUtf16Hex": "0049006C002000740075006F0020004D006500670061005300610062006C0065007900650020006D00690020006900730070006900720065007200E000200075006E00610020006E0075006F00760061002000670061006D006D0061000A006400690020006C0065006E007400690020006100200063006F006E0074006100740074006F002100100002011401730000",
