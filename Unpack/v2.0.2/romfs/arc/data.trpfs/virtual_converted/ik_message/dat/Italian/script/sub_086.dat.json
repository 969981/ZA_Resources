      "rawDecodedUtf16Hex": "00440061006D006D006900200075006E00200061007400740069006D006F002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Ma io ho bisogno di creare nuove lenti a contatto\nper il bene della gente!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Il tuo MegaSableye mi ispirerà una nuova gamma\ndi lenti a contatto!<U+0010><U+0002>Ĕų",
