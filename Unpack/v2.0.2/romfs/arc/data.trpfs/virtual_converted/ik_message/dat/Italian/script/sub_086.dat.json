      "offsetInSection": 2588,
      "rawDecodedUtf16Hex": "00100002BDFF00130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Guardo gli occhi di Sableye e mi sembra di vedere\ndelle stelle!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2600,
      "rawDecodedUtf16Hex": "00470075006100720064006F00200067006C00690020006F00630063006800690020006400690020005300610062006C006500790065002000650020006D0069002000730065006D0062007200610020006400690020007600650064006500720065000A00640065006C006C00650020007300740065006C006C0065002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "Un Pokémon Oscurità come lui mi richiama alla\nmente atmosfere nere e spente.<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 21,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Appassionati di lenti a contatto di Luminopoli,\nvi consegnerò un nuovo mondo di colori!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 22,
      "offsetInSection": 2900,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Adesso hai a disposizione due nuovi colori\ndi lenti a contatto: \"Stelle\" e \"Nero spento\".",
