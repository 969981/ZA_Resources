      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3904,
      "rawDecodedUtf16Hex": "0047006F0067006F0067006F002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Un jour, moi aussi je ferai évoluer un Mordudor,\ntu verras !<U+0010><U+0002>Ĕǁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 35,
