      "rawDecodedUtf16Hex": "0056006F0072007200650069002000760065006400650072006C00690020006C006F0074007400610072006500200074007500740074006900200069006E007300690065006D0065000A0063006F006E00740065006D0070006F00720061006E00650061006D0065006E00740065002E00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Credo che guardarli mi darebbe l’ispirazione\nper nuove tinte di capelli!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 576,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
