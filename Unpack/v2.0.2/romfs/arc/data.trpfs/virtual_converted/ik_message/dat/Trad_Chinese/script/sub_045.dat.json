      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "哦哦！污泥炸彈讓我熟悉的鐵屑\n散發出刺激的氣味了。<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 948,
      "rawDecodedUtf16Hex": "54E654E6FF016C616CE570B85F488B936211719F6089768494355C51000A6563767C51FA523A6FC076846C2354734E863002001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "鎗啊啊啊！！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1008,
      "rawDecodedUtf16Hex": "9397554A554A554AFF01FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "可可多拉們\n吃得津津有味！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
