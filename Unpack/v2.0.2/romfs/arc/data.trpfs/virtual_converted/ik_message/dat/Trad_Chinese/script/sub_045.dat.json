      "rawDecodedUtf16Hex": "53EF53EF591A62C95011000A54035F976D256D2567095473FF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "雖然是個突發奇想的點子，\n但能順利成功真是太好了！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1060,
      "rawDecodedUtf16Hex": "96D67136662F500B7A81767C594760F376849EDE5B50FF0C000A4F4680FD980652296210529F771F662F592A597D4E86FF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "<U+0010><U+0003>ᄀÿā你妳願意協助我變換鐵屑的口味，\n也真是太讚啦！我要獻上最大的感謝！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1120,
      "rawDecodedUtf16Hex": "00100003110000FF01014F6059B39858610F535452A962118B8A63DB94355C51768453E35473FF0C000A4E5F771F662F592A8B9A5566FF0162118981737B4E0A670059277684611F8B1DFF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "再來要調查的就是可可多拉牠們\n最愛哪種毒屬性招式了。<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1208,
      "rawDecodedUtf16Hex": "518D4F8689818ABF67E576845C31662F53EF53EF591A62C972605011000A6700611B54EA7A2E6BD25C6C602762DB5F0F4E863002001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "可可多拉們！\n以後我也會餵你們吃很多的鐵屑喔！<U+0010><U+0002>Ĕō",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1272,
      "rawDecodedUtf16Hex": "53EF53EF591A62C95011FF01000A4EE55F8C62114E5F670399354F60501154035F88591A768494355C515594FF01001000020114014D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0017>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1328,
      "rawDecodedUtf16Hex": "00100002BDFF00170000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
