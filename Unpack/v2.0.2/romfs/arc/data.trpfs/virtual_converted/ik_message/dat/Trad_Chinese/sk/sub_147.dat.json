      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "但是禁止<U+0010><U+0003>ᄀÿā你妳派出寶可夢，\n或是投球喔。<U+0010><U+0002>Ĕ<U+000F>",
      "escapedControlUnits": 5,
