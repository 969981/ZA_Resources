      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ach, perfekt! Ein <U+0010><U+0002>ā<U+000B>! Das nenne\nich<U+0010><U+0001>븀\nmal<U+0010><U+0001>븀\neine<U+0010><U+0001>븀\nFigur<U+0010><U+0001>븀\nmit<U+0010><U+0001>븀\nTiefe!<U+0010><U+0002>ĔƵ",
