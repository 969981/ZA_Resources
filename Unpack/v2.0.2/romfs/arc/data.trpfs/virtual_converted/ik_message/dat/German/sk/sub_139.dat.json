      "offsetInSection": 4120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "Welches von ihnen ist das Normal-Pokémon?<U+0010><U+0002>ĔƵ",
