      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Ein <U+0010><U+0002>ā\n! Ausgezeichnet! Und schon\nnehmen<U+0010><U+0001>븀\ndie<U+0010><U+0001>븀\nFiguren<U+0010><U+0001>븀\nvor<U+0010><U+0001>븀\nmeinem<U+0010><U+0001>븀\ninneren<U+0010><U+0001>븀\nAuge<U+0010><U+0001>븀\nGestalt an!<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 21,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 4904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 119
    },
    {
      "displayText": "Welches von ihnen hat Teleport drauf?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 5144,
