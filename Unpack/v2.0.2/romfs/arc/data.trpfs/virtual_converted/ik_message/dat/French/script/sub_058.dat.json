      "rawDecodedUtf16Hex": "00100002BDFF000E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ça alors, t’as réussi à les chasser ! Merci !<U+0010><U+0002>Ĕř",
