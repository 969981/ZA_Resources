      "rawDecodedUtf16Hex": "004F006E00200076006100200065006E00660069006E00200070006F00750076006F00690072002E002E002E00100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Quoi ? Ils sont de retour ?!<U+0010><U+0002>Ĕř",
