      "index": 18,
      "offsetInSection": 1732,
      "rawDecodedUtf16Hex": "005900200061002000710075201900E00020006D006F00690020007100750065002000E700610020006100720072006900760065002C002000630065002000670065006E0072006500200064006500200074007200750063002E002E002E00100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Hé ! Claimant ! Qu’est-ce qui va pas ?",
      "escapedControlUnits": 0,
