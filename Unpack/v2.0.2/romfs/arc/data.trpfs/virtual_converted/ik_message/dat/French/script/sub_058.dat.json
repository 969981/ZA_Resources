      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "004800E90020002100200043006C00610069006D0061006E0074002000210020005100752019006500730074002D00630065002000710075006900200076006100200070006100730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Ah, merci d’être venu aussi vite ! En fait...<U+0010><U+0002>Ĕř",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 20,
      "offsetInSection": 1916,
      "rawDecodedUtf16Hex": "00410068002C0020006D006500720063006900200064201900EA007400720065002000760065006E0075002000610075007300730069002000760069007400650020002100200045006E00200066006100690074002E002E002E00100002011401590000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Oh, c’est des Terhal ? T’en as de la chance !",
