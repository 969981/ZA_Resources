      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "如果<U+0010><U+0003>ᄀÿā你妳捉到了阿柏蛇，\n拜託讓我也摸摸看吧！<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "5982679C00100003110000FF01014F6059B3634952304E86963F67CF86C7FF0C000A62DC8A178B9362114E5F64786478770B5427FF01001000020114012A0000",
      "trailingZeroPaddingUnits": 1,
