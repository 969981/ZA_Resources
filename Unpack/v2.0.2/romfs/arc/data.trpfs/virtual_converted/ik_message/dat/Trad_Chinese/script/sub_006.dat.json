      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "說不定小阿柏蛇也知道\n自己的尾巴很好摸。<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
