      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "阿柏蛇的尾巴和肚子之類的\n部位不一樣，摸起來感覺肉肉的！！<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
