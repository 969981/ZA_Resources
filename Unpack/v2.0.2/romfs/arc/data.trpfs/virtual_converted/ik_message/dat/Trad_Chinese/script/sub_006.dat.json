      "trailingZeroPaddingUnits": 1,
      "utf16Units": 33
    },
    {
      "displayText": "但是到哪個部分為止\n是阿柏蛇的尾巴呢？<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
