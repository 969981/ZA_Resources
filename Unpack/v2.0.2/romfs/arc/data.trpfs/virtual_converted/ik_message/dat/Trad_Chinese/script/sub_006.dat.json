      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "嘶～♪",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "5636FF5E266A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "只要摸了阿柏蛇的尾巴，\n不管什麼時候心情都能好起來！<U+0010><U+0002>ĔĪ",
      "escapedControlUnits": 2,
