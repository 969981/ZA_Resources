      "rawDecodedUtf16Hex": "8FD8662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "面对我的麻痹战术，\n你是不是害怕了？<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 14,
