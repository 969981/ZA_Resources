      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "异常状态还有很多种……\n得把变幻自如的招式钻研到极致才行！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
