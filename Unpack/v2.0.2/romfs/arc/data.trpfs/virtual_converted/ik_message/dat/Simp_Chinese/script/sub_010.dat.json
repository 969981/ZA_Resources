      "rawDecodedUtf16Hex": "90FD6CA14EC04E48FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "你说什么！？<U+0010><U+0002>ĔĮ",
