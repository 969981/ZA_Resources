      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 1628,
      "rawDecodedUtf16Hex": "8FD8662F7B974E860000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "看来你被中毒战术的厉害\n吓得不轻啊！<U+0010><U+0002>ĔĮ",
