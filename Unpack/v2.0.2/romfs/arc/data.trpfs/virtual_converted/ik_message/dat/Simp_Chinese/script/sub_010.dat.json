      "index": 40,
      "offsetInSection": 2004,
      "rawDecodedUtf16Hex": "4F608BF44EC04E48FF01FF1F001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "我就说吧！\n果然麻痹让你陷入了苦战！<U+0010><U+0002>Ĕį",
