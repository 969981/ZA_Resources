      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "啊，对了对了！麻痹状态\n在对战结束后也不会治愈哦！<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
