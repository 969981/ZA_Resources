      "rawDecodedUtf16Hex": "97625BF9621176849EBB75F96218672FFF0C000A4F60662F4E0D662F5BB360154E86FF1F001000020114012F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "陷入麻痹状态的宝可梦，\n移动速度会变慢！<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1076,
      "rawDecodedUtf16Hex": "967751659EBB75F972B6600176845B9D53EF68A6FF0C000A79FB52A8901F5EA64F1A53D86162FF01001000020114012F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "趁你的宝可梦不能自如行动的时候，\n我会一口气进攻，终结对战！<U+0010><U+0002>Ĕį",
