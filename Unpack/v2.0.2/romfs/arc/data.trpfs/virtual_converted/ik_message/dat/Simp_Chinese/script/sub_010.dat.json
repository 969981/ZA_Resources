      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "陷入中毒状态的宝可梦，\n会持续受到伤害。<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
