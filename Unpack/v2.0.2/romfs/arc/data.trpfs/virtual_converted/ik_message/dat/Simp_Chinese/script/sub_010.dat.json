      "index": 42,
      "offsetInSection": 2076,
      "rawDecodedUtf16Hex": "662F5427FF01FF1F62115C318BF45427FF01001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "喂！\n麻痹才不输给中毒呢！<U+0010><U+0002>Ĕį",
