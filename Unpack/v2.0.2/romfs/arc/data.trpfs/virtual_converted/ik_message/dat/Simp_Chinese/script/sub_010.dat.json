      "rawDecodedUtf16Hex": "4EC04E48FF01FF1F001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "你觉得异常状态\n小菜一碟吗！？<U+0010><U+0002>Ĕį",
