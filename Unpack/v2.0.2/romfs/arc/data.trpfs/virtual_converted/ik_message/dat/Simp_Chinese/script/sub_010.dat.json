      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 888,
      "rawDecodedUtf16Hex": "00100002BDFF00090000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "中毒还是麻痹！\n你愿意让我们测试一下哪种更厉害吗？<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
