      "rawDecodedUtf16Hex": "6211FF5E90FDFF5E8BF4FF5E4E86FF01000A8BF48D775F025E3872B66001FF0C5F537136662F00100002FF0000064E2D6BD200100002FF000000FF01001000020114012E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "中毒会让HP越来越少，\n靠技巧取胜！<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
