      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "00100002BDFF00110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "中毒战术才是最强的，\n但打宝可梦对战的优先顺序姑且让给你吧。<U+0010><U+0002>ĔĮ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
