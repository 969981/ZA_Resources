      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "如果你的宝可梦陷入了麻痹状态，\n就用解麻药帮它治疗吧！<U+0010><U+0002>Ĕį",
      "escapedControlUnits": 2,
