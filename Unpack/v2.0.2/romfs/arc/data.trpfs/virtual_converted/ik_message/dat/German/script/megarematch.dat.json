      "index": 41,
      "offsetInSection": 3372,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>ā<U+0002>? Alles klar! Hast du alle nötigen\nVorbereitungen<U+0010><U+0001>븀\ngetroffen?",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 3548,
      "rawDecodedUtf16Hex": "00100002BD0600000010000201010002003F00200041006C006C006500730020006B006C0061007200210020004800610073007400200064007500200061006C006C00650020006E00F60074006900670065006E000A0056006F00720062006500720065006900740075006E00670065006E00100001BE00000A0067006500740072006F006600660065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Deine Rekordzeit für den Kampf gegen\n<U+0010><U+0002>ā<U+0002> beträgt <U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005>.<U+0010><U+0001>븁\nHast du alle nötigen Vorbereitungen getroffen?",
      "escapedControlUnits": 14,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 3692,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 116
    },
    {
      "displayText": "Wow! Deine Zeit betrug <U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005>.",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 3924,
      "rawDecodedUtf16Hex": "0057006F007700210020004400650069006E00650020005A006500690074002000620065007400720075006700200010000202010003003A0010000202010004002C0010000202010005002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Wahnsinn! Du hast einen neuen Rekord\naufgestellt!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 4004,
      "rawDecodedUtf16Hex": "005700610068006E00730069006E006E002100200044007500200068006100730074002000650069006E0065006E0020006E006500750065006E002000520065006B006F00720064000A00610075006600670065007300740065006C006C007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Hier, deine Belohnung!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 4104,
      "rawDecodedUtf16Hex": "0048006900650072002C0020006400650069006E0065002000420065006C006F0068006E0075006E006700210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Es ist ja nur eine Simulation, also selbst wenn du\nverlierst, kommst du unversehrt davon.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 47,
      "offsetInSection": 4152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Komm jederzeit wieder vorbei, um dich an einer\nKampfsimulation zu versuchen!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 4332,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Dem Megamanie-Kampfsimulator wurden neue\nPokémon hinzugefügt.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 4488,
      "rawDecodedUtf16Hex": "00440065006D0020004D006500670061006D0061006E00690065002D004B0061006D0070006600730069006D0075006C00610074006F0072002000770075007200640065006E0020006E006500750065000A0050006F006B00E9006D006F006E002000680069006E007A007500670065006600FC00670074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
      "displayText": "Herzlichen Glückwunsch!<U+0010><U+0001>븁\nDu kannst dich nun am Megamanie-Marathon\nversuchen!",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 4612,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Wonach steht dir der Sinn?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 51,
      "offsetInSection": 4772,
      "rawDecodedUtf16Hex": "0057006F006E00610063006800200073007400650068007400200064006900720020006400650072002000530069006E006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "Megamanie-Simulator",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 4828,
      "rawDecodedUtf16Hex": "004D006500670061006D0061006E00690065002D00530069006D0075006C00610074006F00720000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
