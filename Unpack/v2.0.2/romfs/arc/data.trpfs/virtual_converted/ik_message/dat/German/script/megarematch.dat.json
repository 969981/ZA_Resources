    {
      "displayText": "Gegen welche Megamanie-Entwicklung möchtest\ndu als Nächstes im Kampfsimulator antreten?<U+0010><U+0002>Ĕ<U+000E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
