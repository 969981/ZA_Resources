      "offsetInSection": 4908,
      "rawDecodedUtf16Hex": "00410062006200720065006300680065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Du möchtest dich am Megamanie-Marathon\nversuchen?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4928,
      "rawDecodedUtf16Hex": "004400750020006D00F60063006800740065007300740020006400690063006800200061006D0020004D006500670061006D0061006E00690065002D004D00610072006100740068006F006E000A00760065007200730075006300680065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Ja!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5028,
      "rawDecodedUtf16Hex": "004A006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Kannst du mir das genauer erklären?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 5036,
      "rawDecodedUtf16Hex": "004B0061006E006E007300740020006400750020006D006900720020006400610073002000670065006E0061007500650072002000650072006B006C00E400720065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Was ist mein momentaner Rekord?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5108,
      "rawDecodedUtf16Hex": "00570061007300200069007300740020006D00650069006E0020006D006F006D0065006E00740061006E00650072002000520065006B006F00720064003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "Nein danke.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5172,
      "rawDecodedUtf16Hex": "004E00650069006E002000640061006E006B0065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Beim <U+0010><U+0002>＀<U+0006>Megamanie-Marathon<U+0010><U+0002>＀<U+0000> trittst du gegen alle\nMegamanie-Pokémon hintereinander an.<U+0010><U+0001>븁\nDabei kannst du die Zusammenstellung deines\nTeams nicht ändern und wenn du verlierst,<U+0010><U+0001>븀\ndann war’s das.<U+0010><U+0001>븁\nDu kannst dein Team zwar heilen, aber nur\ndrei Mal!<U+0010><U+0001>븁\nWir zeichnen auf, wie viele Pokémon du besiegst,\nund wenn du gegen alle Megamanie-Pokémon<U+0010><U+0001>븀\ngewinnst, messen wir auch deine Zeit.<U+0010><U+0001>븁\nAlso, wonach steht dir der Sinn?",
      "escapedControlUnits": 18,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5196,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 424
    },
    {
      "displayText": "Bist du sicher, dass du dich dieser extrem\nschwierigen Herausforderung stellen möchtest?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 6044,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Ja!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 6224,
      "rawDecodedUtf16Hex": "004A006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Nein...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6232,
      "rawDecodedUtf16Hex": "004E00650069006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Bist du bereit für das nächste Pokémon?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 6248,
      "rawDecodedUtf16Hex": "004200690073007400200064007500200062006500720065006900740020006600FC007200200064006100730020006E00E40063006800730074006500200050006F006B00E9006D006F006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "Kämpfen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 6328,
      "rawDecodedUtf16Hex": "004B00E4006D007000660065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Heilen",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6344,
      "rawDecodedUtf16Hex": "004800650069006C0065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Aufgeben",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 6360,
      "rawDecodedUtf16Hex": "0041007500660067006500620065006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Du kannst dein Team noch <U+0010><U+0002>Ȁ<U+0003> Mal heilen.\nMöchtest du fortfahren?",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 6380,
      "rawDecodedUtf16Hex": "004400750020006B0061006E006E007300740020006400650069006E0020005400650061006D0020006E006F00630068002000100002020000030020004D0061006C0020006800650069006C0065006E002E000A004D00F600630068007400650073007400200064007500200066006F0072007400660061006800720065006E003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
      "displayText": "Ja",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 6512,
      "rawDecodedUtf16Hex": "004A00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "Nein",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 6520,
      "rawDecodedUtf16Hex": "004E00650069006E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Wir zeichnen deinen Rekord auf, aber beim\nnächsten Mal musst du wieder von vorn<U+0010><U+0001>븀\nanfangen. Möchtest du wirklich aufgeben?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 6532,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 124
    },
    {
      "displayText": "Schade! Ich hoffe, du versuchst es irgendwann\nnoch mal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 6780,
      "rawDecodedUtf16Hex": "0053006300680061006400650021002000490063006800200068006F006600660065002C002000640075002000760065007200730075006300680073007400200065007300200069007200670065006E006400770061006E006E000A006E006F006300680020006D0061006C002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Du hast <U+0010><U+0002>ȁ<U+0004> Pokémon besiegt. Ich bin gespannt,\nob du nächstes Mal deinen Rekord brichst!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6892,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Deine Rekordzeit für diese Herausforderung\nbeträgt <U+0010><U+0002>ȁ<U+0005>:<U+0010><U+0002>ȁ<U+0006>:<U+0010><U+0002>ȁ<U+0007>,<U+0010><U+0002>ȁ<U+0008>!",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 7072,
      "rawDecodedUtf16Hex": "004400650069006E0065002000520065006B006F00720064007A0065006900740020006600FC007200200064006900650073006500200048006500720061007500730066006F00720064006500720075006E0067000A006200650074007200E40067007400200010000202010005003A0010000202010006003A0010000202010007002C001000020201000800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Du hast <U+0010><U+0002>ȁ<U+0004> Pokémon besiegt!",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 7216,
      "rawDecodedUtf16Hex": "00440075002000680061007300740020001000020201000400200050006F006B00E9006D006F006E0020006200650073006900650067007400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Moment mal... Du hast sie ja alle besiegt!\nWow, Wahnsinn! Herzlichen Glückwunsch!!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 7276,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Deine Rekordzeit für diese Herausforderung\nbeträgt <U+0010><U+0002>ȁ<U+0005>:<U+0010><U+0002>ȁ<U+0006>:<U+0010><U+0002>ȁ<U+0007>,<U+0010><U+0002>ȁ<U+0008>!",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 7444,
      "rawDecodedUtf16Hex": "004400650069006E0065002000520065006B006F00720064007A0065006900740020006600FC007200200064006900650073006500200048006500720061007500730066006F00720064006500720075006E0067000A006200650074007200E40067007400200010000202010005003A0010000202010006003A0010000202010007002C001000020201000800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Komm gerne jederzeit wieder vorbei!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 7588,
      "rawDecodedUtf16Hex": "004B006F006D006D0020006700650072006E00650020006A0065006400650072007A006500690074002000770069006500640065007200200076006F007200620065006900210000",
      "trailingZeroPaddingUnits": 1,
