      "rawDecodedUtf16Hex": "C900BE44AC000020B418BA740020B9D0C7440020AC78B3C4B85D0020D574002E001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
