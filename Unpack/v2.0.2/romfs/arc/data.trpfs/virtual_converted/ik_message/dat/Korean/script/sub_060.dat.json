      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "우라아!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1804,
      "rawDecodedUtf16Hex": "C6B0B77CC54400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "뭐야, 야생 포켓몬이잖아...?<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 1816,
      "rawDecodedUtf16Hex": "BB50C57C002C0020C57CC0DD0020D3ECCF13BAACC774C796C544002E002E002E003F001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
