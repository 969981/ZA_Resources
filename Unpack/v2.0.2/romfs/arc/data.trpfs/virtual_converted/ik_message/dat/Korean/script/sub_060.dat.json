      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "내 폭타와\n뜨거운 승부를 겨뤄 줘!<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1140,
      "rawDecodedUtf16Hex": "B0B40020D3EDD0C0C640000AB728AC70C6B40020C2B9BD80B97C0020ACA8B9040020C9180021001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1188,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
