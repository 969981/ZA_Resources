      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1200,
      "rawDecodedUtf16Hex": "C0ACC591D560AC8CC6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "뭐야, 그 차가운 대답은!<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "BB50C57C002C0020ADF80020CC28AC00C6B40020B300B2F5C7400021001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "뜨거운 대답에 걸맞은\n뜨거운 승부를 부탁하겠어!<U+0010><U+0002>Ĕś",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1252,
      "rawDecodedUtf16Hex": "B728AC70C6B40020B300B2F5C5D00020AC78B9DEC740000AB728AC70C6B40020C2B9BD80B97C0020BD80D0C1D558ACA0C5B40021001000020114015B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
