      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "너의 스마트로토무에...\n수상한 정보를 삑삑삑!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
