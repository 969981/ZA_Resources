  "messages": [
    {
      "displayText": "게노세크트라는 포켓몬에 대해서는\n당연히 알고 있겠지?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 164,
