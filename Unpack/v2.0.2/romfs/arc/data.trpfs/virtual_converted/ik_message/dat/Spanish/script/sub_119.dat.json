      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "<U+0010><U+0002>뷿4",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 5340,
      "rawDecodedUtf16Hex": "00100002BDFF00340000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Es aquí de donde sale lo que has percibido?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 5352,
      "rawDecodedUtf16Hex": "00BF00450073002000610071007500ED00200064006500200064006F006E00640065002000730061006C00650020006C006F00200071007500650020006800610073002000700065007200630069006200690064006F003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "¡Espuuurr!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 5452,
      "rawDecodedUtf16Hex": "00A10045007300700075007500750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Está lleno de megacristales... Esto no es natural.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 55,
      "offsetInSection": 5476,
      "rawDecodedUtf16Hex": "00450073007400E10020006C006C0065006E006F0020006400650020006D006500670061006300720069007300740061006C00650073002E002E002E0020004500730074006F0020006E006F0020006500730020006E00610074007500720061006C002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 55
    },
    {
      "displayText": "¡Espu, pu, purr!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 5588,
      "rawDecodedUtf16Hex": "00A10045007300700075002C002000700075002C0020007000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Esos dos son Carbink...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 57,
      "offsetInSection": 5624,
      "rawDecodedUtf16Hex": "00450073006F007300200064006F007300200073006F006E002000430061007200620069006E006B002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "¿Pero qué Pokémon es ese que está con ellos?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 5680,
      "rawDecodedUtf16Hex": "00BF005000650072006F00200071007500E900200050006F006B00E9006D006F006E00200065007300200065007300650020007100750065002000650073007400E100200063006F006E00200065006C006C006F0073003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "¿Tendrá algo que ver con esa Megapiedra que\ntienes?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 5780,
      "rawDecodedUtf16Hex": "00BF00540065006E0064007200E100200061006C0067006F0020007100750065002000760065007200200063006F006E00200065007300610020004D0065006700610070006900650064007200610020007100750065000A007400690065006E00650073003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "¡Purr!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 5892,
      "rawDecodedUtf16Hex": "00A1005000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "¡Vas a tener que capturarlo para averiguarlo!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5908,
      "rawDecodedUtf16Hex": "00A100560061007300200061002000740065006E006500720020007100750065002000630061007000740075007200610072006C006F002000700061007200610020006100760065007200690067007500610072006C006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Espupupurr...",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 62,
      "offsetInSection": 6008,
      "rawDecodedUtf16Hex": "0045007300700075007000750070007500720072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>뷿?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 6036,
      "rawDecodedUtf16Hex": "00100002BDFF003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Diaaa!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 6048,
      "rawDecodedUtf16Hex": "00A10044006900610061006100210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "<U+0010><U+0002>뷿A",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 6064,
      "rawDecodedUtf16Hex": "00100002BDFF00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Tienes que capturarlo!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 6076,
      "rawDecodedUtf16Hex": "00A1005400690065006E006500730020007100750065002000630061007000740075007200610072006C006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "¡Debes capturarlo sin debilitarlo!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 6132,
      "rawDecodedUtf16Hex": "00A100440065006200650073002000630061007000740075007200610072006C006F002000730069006E00200064006500620069006C0069007400610072006C006F002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Muchas gracias! No sé qué haría sin ti.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 6212,
      "rawDecodedUtf16Hex": "00A1004D007500630068006100730020006700720061006300690061007300210020004E006F0020007300E900200071007500E9002000680061007200ED0061002000730069006E002000740069002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "A ver, enséñame al Pokémon...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 69,
      "offsetInSection": 6304,
      "rawDecodedUtf16Hex": "00410020007600650072002C00200065006E007300E900F10061006D006500200061006C00200050006F006B00E9006D006F006E002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Es precioso...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 70,
      "offsetInSection": 6372,
      "rawDecodedUtf16Hex": "00450073002000700072006500630069006F0073006F002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "Su brillo me recuerda al Reloj Solar de Fluxus.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 6412,
      "rawDecodedUtf16Hex": "005300750020006200720069006C006C006F0020006D006500200072006500630075006500720064006100200061006C002000520065006C006F006A00200053006F006C0061007200200064006500200046006C0075007800750073002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "¿Fluxus?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 72,
      "offsetInSection": 6516,
      "rawDecodedUtf16Hex": "00BF0046006C0075007800750073003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¿Qué reloj?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6536,
      "rawDecodedUtf16Hex": "00BF0051007500E9002000720065006C006F006A003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Verás, en Ciudad Fluxus hay un reloj solar muy\nextraño, del que se dice que guarda relación con<U+0010><U+0001>븀\nlas Megapiedras.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 6560,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 120
    },
    {
      "displayText": "Esto me trae muchos recuerdos...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 75,
      "offsetInSection": 6800,
      "rawDecodedUtf16Hex": "004500730074006F0020006D0065002000740072006100650020006D007500630068006F007300200072006500630075006500720064006F0073002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Desde que Handsome se fue, he conocido a un\nmontón de gente.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 6876,
      "rawDecodedUtf16Hex": "004400650073006400650020007100750065002000480061006E00640073006F006D00650020007300650020006600750065002C00200068006500200063006F006E006F006300690064006F0020006100200075006E000A006D006F006E007400F3006E002000640065002000670065006E00740065002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Por ejemplo, A. Z., y también el Profesor Ciprés.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 7008,
      "rawDecodedUtf16Hex": "0050006F007200200065006A0065006D0070006C006F002C00200041002E0020005A002E002C00200079002000740061006D0062006900E9006E00200065006C002000500072006F006600650073006F00720020004300690070007200E90073002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "Este último estudiaba la megaevolución y me\ncontó algunas de las conversaciones que tuvo<U+0010><U+0001>븀\ncon A. Z....<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 78,
      "offsetInSection": 7116,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "Su teoría era que las Megapiedras son piedras\nirradiadas por la luz que disparó el arma definitiva<U+0010><U+0001>븀\nhace 3000 años; una luz que en realidad era la<U+0010><U+0001>븀\nenergía de los Pokémon legendarios.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 7336,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 192
    },
    {
      "displayText": "A. Z. comparte esa teoría, y también cree que\neso explica que ahora estén apareciendo nuevas<U+0010><U+0001>븀\nMegapiedras...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 80,
      "offsetInSection": 7720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "Ya que el arma definitiva se disparó de nuevo\nhace cinco años.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 81,
      "offsetInSection": 7952,
      "rawDecodedUtf16Hex": "00590061002000710075006500200065006C002000610072006D006100200064006500660069006E00690074006900760061002000730065002000640069007300700061007200F30020006400650020006E007500650076006F000A0068006100630065002000630069006E0063006F0020006100F1006F0073002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "Purr...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 82,
      "offsetInSection": 8088,
      "rawDecodedUtf16Hex": "0050007500720072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "No te preocupes, Peluchín.<U+0010><U+0001>븁\nLa ciudad está a salvo ahora que estamos\n<U+0010><U+0002>Ā<U+0000> y yo para protegerla.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 83,
      "offsetInSection": 8104,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Te pido que cuides a este Pokémon como se\nmerece, por favor.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 84,
      "offsetInSection": 8308,
      "rawDecodedUtf16Hex": "005400650020007000690064006F00200071007500650020006300750069006400650073002000610020006500730074006500200050006F006B00E9006D006F006E00200063006F006D006F002000730065000A006D00650072006500630065002C00200070006F00720020006600610076006F0072002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Ojalá en esta ciudad hubiese más gente como tú,\ncon esa facilidad que tienes para hacer buenas<U+0010><U+0001>븀\nmigas con cualquier Pokémon...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 85,
      "offsetInSection": 8440,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "Bueno, es hora de que vuelva al despacho.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 8708,
      "rawDecodedUtf16Hex": "004200750065006E006F002C00200065007300200068006F0072006100200064006500200071007500650020007600750065006C0076006100200061006C00200064006500730070006100630068006F002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Por cierto, A. Z. también me contó otra cosa...<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 87,
      "offsetInSection": 8800,
      "rawDecodedUtf16Hex": "0050006F0072002000630069006500720074006F002C00200041002E0020005A002E002000740061006D0062006900E9006E0020006D006500200063006F006E007400F30020006F00740072006100200063006F00730061002E002E002E00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Durante su largo viaje en busca de Floette,\npasó por una lejana región llamada Hoenn.<U+0010><U+0001>븁\nDice que allí presenció un fenómeno que,\nen su opinión, podría considerarse el origen de<U+0010><U+0001>븀\nla megaevolución.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 88,
      "offsetInSection": 8904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 203
    },
    {
      "displayText": "A lo mejor por eso no ha dejado nunca de pensar\nen los lazos que nos unen con los Pokémon.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 89,
      "offsetInSection": 9312,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 95
    },
    {
      "displayText": "En fin, muchas gracias por todo.\n¡Cuento contigo para la próxima!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 4,
      "index": 90,
      "offsetInSection": 9504,
      "rawDecodedUtf16Hex": "0045006E002000660069006E002C0020006D007500630068006100730020006700720061006300690061007300200070006F007200200074006F0064006F002E000A00A1004300750065006E0074006F00200063006F006E007400690067006F002000700061007200610020006C006100200070007200F300780069006D0061002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    }
  ],
