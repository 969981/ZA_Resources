      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 5172,
      "rawDecodedUtf16Hex": "00A100450073007000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Creo que nos estamos acercando.<U+0010><U+0002>Ĕ<U+0008>",
