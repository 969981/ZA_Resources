      "rawDecodedUtf16Hex": "00BF005400690065006E00650073002000680061006D006200720065003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "Je, je... Pues un poco, la verdad.<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
