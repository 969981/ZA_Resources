      "offsetInSection": 4012,
      "rawDecodedUtf16Hex": "00100002BDFF001D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Peluchín, ¿me estás leyendo la mente?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4024,
      "rawDecodedUtf16Hex": "00500065006C00750063006800ED006E002C002000BF006D0065002000650073007400E100730020006C006500790065006E0064006F0020006C00610020006D0065006E00740065003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Puedes oír los pensamientos de Matière en tu\ncabeza gracias al poder de Peluchín.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4108,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "...<U+0010><U+0001>븁\n(¿Qué le pasa a Peluchín?).<U+0010><U+0001>븁\n(Ay, qué buena pinta tiene ese pan...).",
      "escapedControlUnits": 4,
