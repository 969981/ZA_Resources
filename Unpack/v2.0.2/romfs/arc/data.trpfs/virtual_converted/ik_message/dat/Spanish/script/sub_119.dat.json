      "rawDecodedUtf16Hex": "00A100450073007000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡Venga, <U+0010><U+0002>Ā<U+0000>!\n¡No nos quedemos atrás!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 3928,
      "rawDecodedUtf16Hex": "00A100560065006E00670061002C002000100002010000000021000A00A1004E006F0020006E006F0073002000710075006500640065006D006F0073002000610074007200E10073002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
