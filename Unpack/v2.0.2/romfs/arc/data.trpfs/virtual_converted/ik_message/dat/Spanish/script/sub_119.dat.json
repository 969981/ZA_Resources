      "rawDecodedUtf16Hex": "00A100450073007000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¿Quieres subir?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 5132,
      "rawDecodedUtf16Hex": "00BF0051007500690065007200650073002000730075006200690072003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "¡Espurr!",
