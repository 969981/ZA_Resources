      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¡Jo, qué rico estaba!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4704,
      "rawDecodedUtf16Hex": "00A1004A006F002C00200071007500E90020007200690063006F0020006500730074006100620061002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Bueno, ¿nos vas a mostrar ahora adónde querías\nir, Peluchín?<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 4756,
      "rawDecodedUtf16Hex": "004200750065006E006F002C002000BF006E006F00730020007600610073002000610020006D006F00730074007200610072002000610068006F0072006100200061006400F3006E006400650020007100750065007200ED00610073000A00690072002C002000500065006C00750063006800ED006E003F00100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "¿Pu, purr?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 4888,
      "rawDecodedUtf16Hex": "00BF00500075002C00200070007500720072003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "¡Espurr!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
