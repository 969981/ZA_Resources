      "offsetInSection": 4912,
      "rawDecodedUtf16Hex": "00A100450073007000750072007200210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "¡Vamos, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ<U+0008>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 4932,
      "rawDecodedUtf16Hex": "00A100560061006D006F0073002C00200010000201000000002100100002011400080000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "<U+0010><U+0002>뷿,",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 4968,
      "rawDecodedUtf16Hex": "00100002BDFF002C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Qué le pasa a este Holotransportador, Peluchín?<U+0010><U+0002>Ĕ<U+0008>",
