      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "而且，傷腦筋的是牠會到處亂撒割下的草，\n然後一副自信滿滿、很得意的樣子！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 2316,
      "rawDecodedUtf16Hex": "800C4E14FF0C50B781667B4B7684662F72606703523086554E82649252724E0B76848349FF0C000A71365F8C4E00526F81EA4FE16EFF6EFF30015F885F97610F76846A235B50FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
