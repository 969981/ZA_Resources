      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2124,
      "rawDecodedUtf16Hex": "592954EAFF01771F9A5A5947FF01FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
