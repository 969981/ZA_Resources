      "index": 34,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "00100002BDFF00220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "切割洛托姆的屬性是\n電還有草！<U+0010><U+0002>Ĕƨ",
