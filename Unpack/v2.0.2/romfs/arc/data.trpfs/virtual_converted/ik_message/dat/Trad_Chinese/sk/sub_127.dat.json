      "rawDecodedUtf16Hex": "6E056D176D1B625859C676846C346D41FF01000A00100003110000FF01014F6059B389BA5F9759824F555462FF1F00100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "接下來！進到割草機裡的洛托姆，\n會被稱為切割洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2060,
