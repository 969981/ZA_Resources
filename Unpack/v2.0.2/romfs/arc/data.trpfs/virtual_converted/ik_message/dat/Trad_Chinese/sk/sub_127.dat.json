      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "接下來！進到洗衣機裡的洛托姆，\n會被稱為清洗洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1672,
      "rawDecodedUtf16Hex": "63A54E0B4F86FF01903252306D1788636A5F88E176846D1B625859C6FF0C000A670388AB7A3170BA6E056D176D1B625859C6FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "哎呀，好～厲害！！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1736,
      "rawDecodedUtf16Hex": "54CE5440FF0C597DFF5E53B25BB3FF01FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0019>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1764,
      "rawDecodedUtf16Hex": "00100002BDFF00190000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "清洗洛托姆的屬性是\n電還有水！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
