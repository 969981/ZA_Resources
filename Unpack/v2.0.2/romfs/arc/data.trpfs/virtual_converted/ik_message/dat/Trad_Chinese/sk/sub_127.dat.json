      "rawDecodedUtf16Hex": "00100002BDFF00270000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "切割洛托姆割草的能力！\n<U+0010><U+0003>ᄀÿā你妳覺得如何呢？<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 40,
      "offsetInSection": 2412,
      "rawDecodedUtf16Hex": "520752726D1B625859C652728349768480FD529BFF01000A00100003110000FF01014F6059B389BA5F9759824F555462FF1F00100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "接下來！進到電風扇裡的洛托姆，\n會被稱為旋轉洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 2472,
      "rawDecodedUtf16Hex": "63A54E0B4F86FF019032523096FB98A8624788E176846D1B625859C6FF0C000A670388AB7A3170BA65CB8F496D1B625859C6FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "哇喔！好神奇！！<U+0010><U+0002>ĔƩ",
