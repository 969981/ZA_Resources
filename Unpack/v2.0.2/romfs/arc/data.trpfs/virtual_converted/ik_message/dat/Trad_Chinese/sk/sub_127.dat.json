      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "但我必須先告知一聲，\n牠有可能會讓房間淹水喔！<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "4F4662115FC598085148544A77E54E008072FF0C000A7260670953EF80FD67038B93623F95936DF96C345594FF0100100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001E>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 1992,
      "rawDecodedUtf16Hex": "00100002BDFF001E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "清洗洛托姆的水流！\n<U+0010><U+0003>ᄀÿā你妳覺得如何呢？<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 4,
