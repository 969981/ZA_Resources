      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1340,
      "rawDecodedUtf16Hex": "00100002BDFF000F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "進到烤箱微波爐裡的洛托姆，\n被稱為加熱洛托姆！<U+0010><U+0002>Ĕƨ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1352,
      "rawDecodedUtf16Hex": "9032523070E47BB15FAE6CE2721088E176846D1B625859C6FF0C000A88AB7A3170BA52A071B16D1B625859C6FF0100100002011401A80000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "屬性是電還有火！\n幽靈屬性消失了呢！？<U+0010><U+0002>ĔƩ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1408,
      "rawDecodedUtf16Hex": "5C6C6027662F96FB90846709706BFF01000A5E7D97485C6C60276D8859314E865462FF01FF1F00100002011401A90000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "牠能學會「過熱」這個招式！<U+0010><U+0002>Ĕƨ",
