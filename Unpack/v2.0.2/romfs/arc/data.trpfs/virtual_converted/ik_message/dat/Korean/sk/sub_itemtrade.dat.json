      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "미안하지만 그건 받을 수 없어.\n다른 도구로 교환해 줘!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
