      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "남는 도구가 있으면\n다음에 또 교환해 줘!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
