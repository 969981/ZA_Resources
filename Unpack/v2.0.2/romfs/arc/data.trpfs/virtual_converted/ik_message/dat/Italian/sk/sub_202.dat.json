      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Non sembra essere una megaevoluzione ferox,\nperò mi preoccupa la fonte di quel potere.<U+0010><U+0002>Ĕ<U+0013>",
