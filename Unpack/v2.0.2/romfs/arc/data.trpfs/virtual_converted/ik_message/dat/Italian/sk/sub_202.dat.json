      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "Durante il tuo sopralluogo ho fatto qualche\nricerca su Hoopa e sul Vaso del vincolo!<U+0010><U+0002>Ĕ<U+0005>",
