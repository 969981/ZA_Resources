      "offsetInSection": 1640,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "E quindi ti tocca anda’ a investiga’!<U+0010><U+0002>Ĕ<U+0013>",
