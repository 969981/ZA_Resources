      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "Che starà succedendo?<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1900,
      "rawDecodedUtf16Hex": "0043006800650020007300740061007200E000200073007500630063006500640065006E0064006F003F00100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "Che starà succedendo?<U+0010><U+0002>Ĕ<U+0005>",
