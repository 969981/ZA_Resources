      "rawDecodedUtf16Hex": "0048006F006F00700061006100610061002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "Cosa gli sarà preso?<U+0010><U+0002>Ĕƥ",
