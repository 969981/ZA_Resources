      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Mentre riordinavo la stanza di AZ, ho trovato\nqualcosa di incredibile!<U+0010><U+0002>Ĕ<U+0005>",
