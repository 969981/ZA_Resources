      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "我担心得想在一旁照看它，\n但要是我跟在后边，就会被它发现。<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
