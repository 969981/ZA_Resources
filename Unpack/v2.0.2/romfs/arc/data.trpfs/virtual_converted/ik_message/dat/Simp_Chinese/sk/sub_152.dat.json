      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 704,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "你准备好照看\n要第一次去收集信件的魔尼尼了吗？<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
