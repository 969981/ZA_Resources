      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "所以拜托你！<U+0010><U+0001>븁\n请你代替我，\n去照看魔尼尼工作吧！<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 588,
      "rawDecodedUtf16Hex": "62404EE562DC62584F60FF0100100001BE01000A8BF74F604EE366FF6211FF0C000A53BB7167770B9B545C3C5C3C5DE54F5C5427FF0100100002011401BF0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "等你准备好照看魔尼尼后，\n请和我说一声。<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 652,
