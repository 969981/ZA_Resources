    {
      "displayText": "You’ve got gusto, I’ll give you that. I’m gonna let\nyou join the Rust Syndicate as one of my<U+0010><U+0001>븀\nunderlings! That should keep you outta trouble!<U+0010><U+0002>Ĕ<U+001D>",
      "escapedControlUnits": 5,
