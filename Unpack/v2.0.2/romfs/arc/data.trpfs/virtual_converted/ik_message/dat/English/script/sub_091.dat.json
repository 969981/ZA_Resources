      "rawDecodedUtf16Hex": "00420061002D006400720069006C00210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "Hey, not bad! Looks even better than before.<U+0010><U+0002>Ĕ<U+001D>",
