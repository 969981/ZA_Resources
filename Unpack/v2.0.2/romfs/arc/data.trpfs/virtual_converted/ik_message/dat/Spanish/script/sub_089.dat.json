      "offsetInSection": 2280,
      "rawDecodedUtf16Hex": "00410071007500ED0020007400690065006E0065007300200075006E00200046006C0061006200E9006200E900200063006F006E00200075006E006100200066006C006F00720020006E006100720061006E006A00610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Aquí tienes un Flabébé con una flor azul",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 12,
      "offsetInSection": 2368,
      "rawDecodedUtf16Hex": "00410071007500ED0020007400690065006E0065007300200075006E00200046006C0061006200E9006200E900200063006F006E00200075006E006100200066006C006F007200200061007A0075006C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Aquí tienes un Flabébé con una flor blanca",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 13,
      "offsetInSection": 2452,
      "rawDecodedUtf16Hex": "00410071007500ED0020007400690065006E0065007300200075006E00200046006C0061006200E9006200E900200063006F006E00200075006E006100200066006C006F007200200062006C0061006E006300610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
