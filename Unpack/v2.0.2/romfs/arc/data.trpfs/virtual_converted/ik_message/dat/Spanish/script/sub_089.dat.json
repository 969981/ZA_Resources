      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Ay, muchas gracias! Este Flabébé tiene\nuna flor amarilla.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 3664,
      "rawDecodedUtf16Hex": "00A100410079002C0020006D007500630068006100730020006700720061006300690061007300210020004500730074006500200046006C0061006200E9006200E90020007400690065006E0065000A0075006E006100200066006C006F007200200061006D006100720069006C006C0061002E00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "¡El amarillo es un color muy animado!<U+0010><U+0001>븁\n¡Me encargaré de que a partir de ahora se ofrezca\neste color de tinte en las peluquerías!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 3792,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 135
    },
    {
      "displayText": "¡Ahora puedes teñirte el pelo de color amarillo\nlimón en las peluquerías!",
