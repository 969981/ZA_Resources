      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5932,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 100
    },
    {
      "displayText": "Solo con ver a estos pequeños tan coloridos\nme entran ganas de experimentar aún más<U+0010><U+0001>븀\ncon los tintes de pelo.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 6132,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 115
    },
    {
      "displayText": "¿Y sabes qué? ¿Por qué no? Voy a incluir algunas\nideas que se me han ocurrido ahora.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 6364,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 89
    },
    {
      "displayText": "¡Ahora puedes teñirte el pelo de azul aguamarina,\nmorado y rosa chillón en las peluquerías!",
