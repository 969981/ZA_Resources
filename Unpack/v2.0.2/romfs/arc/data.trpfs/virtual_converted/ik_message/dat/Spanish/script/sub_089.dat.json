      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 3524,
      "rawDecodedUtf16Hex": "00A100410068006F00720061002000700075006500640065007300200074006500F1006900720074006500200065006C002000700065006C006F00200064006500200063006F006C006F007200200072006F006A006F000A0065006E0020006C00610073002000700065006C0075007100750065007200ED0061007300210000",
