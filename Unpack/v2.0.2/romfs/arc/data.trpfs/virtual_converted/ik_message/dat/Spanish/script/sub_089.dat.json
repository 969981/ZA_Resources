      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Qué maj<U+0010><U+0003>ᄀÿāoa eres! Me encanta la flor azul\nde este Flabébé.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 4796,
      "rawDecodedUtf16Hex": "00A10051007500E90020006D0061006A00100003110000FF0101006F00610020006500720065007300210020004D006500200065006E00630061006E007400610020006C006100200066006C006F007200200061007A0075006C000A006400650020006500730074006500200046006C0061006200E9006200E9002E00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "¡El azul transmite una sensación de libertad!<U+0010><U+0001>븁\n¡Me encargaré de que a partir de ahora se ofrezca\neste color de tinte en las peluquerías!<U+0010><U+0002>ĔŴ",
