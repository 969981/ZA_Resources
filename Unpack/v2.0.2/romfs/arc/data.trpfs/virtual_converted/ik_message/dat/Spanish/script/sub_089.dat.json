      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 2540,
      "rawDecodedUtf16Hex": "00410068006F007200610020006D00690073006D006F0020006E006F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "Ay, ¿me has traído un Flabébé Flor Roja?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 15,
      "offsetInSection": 2572,
      "rawDecodedUtf16Hex": "00410079002C002000BF006D00650020006800610073002000740072006100ED0064006F00200075006E00200046006C0061006200E9006200E900200046006C006F007200200052006F006A0061003F00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Ay, ¿me has traído un Flabébé Flor Amarilla?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
