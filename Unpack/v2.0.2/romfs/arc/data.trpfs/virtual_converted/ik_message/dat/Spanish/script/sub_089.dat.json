      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Ay, ¿me has traído un Flabébé Flor Naranja?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2764,
      "rawDecodedUtf16Hex": "00410079002C002000BF006D00650020006800610073002000740072006100ED0064006F00200075006E00200046006C0061006200E9006200E900200046006C006F00720020004E006100720061006E006A0061003F00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Ay, ¿me has traído un Flabébé Flor Blanca?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2860,
      "rawDecodedUtf16Hex": "00410079002C002000BF006D00650020006800610073002000740072006100ED0064006F00200075006E00200046006C0061006200E9006200E900200046006C006F007200200042006C0061006E00630061003F00100002011401740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 47
    },
    {
      "displayText": "Ay, ¿me has traído un Flabébé Flor Azul?<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 19,
      "offsetInSection": 2956,
