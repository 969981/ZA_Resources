      "rawDecodedUtf16Hex": "00100002BDFF001C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¡Te lo agradezco un montón! La flor naranja\nde este Flabébé es preciosa.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 4224,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "¡El naranja es un color muy otoñal!<U+0010><U+0001>븁\n¡Me encargaré de que a partir de ahora se ofrezca\neste color de tinte en las peluquerías!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 4380,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 133
    },
    {
      "displayText": "¡Ahora puedes teñirte el pelo de color naranja\nen las peluquerías!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 4648,
      "rawDecodedUtf16Hex": "00A100410068006F00720061002000700075006500640065007300200074006500F1006900720074006500200065006C002000700065006C006F00200064006500200063006F006C006F00720020006E006100720061006E006A0061000A0065006E0020006C00610073002000700065006C0075007100750065007200ED0061007300210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
