      "flagsUpper16": 0,
      "index": 44,
      "offsetInSection": 6544,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "¿Sabes de qué me han dado ganas ahora?\nDe buscarme mis propios Flabébé y cuidarlos.<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
