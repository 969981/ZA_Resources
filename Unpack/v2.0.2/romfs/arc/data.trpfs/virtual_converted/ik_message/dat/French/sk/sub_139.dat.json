      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Il me semblait t’avoir demandé un Pokémon\nde type Normal...<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 32,
