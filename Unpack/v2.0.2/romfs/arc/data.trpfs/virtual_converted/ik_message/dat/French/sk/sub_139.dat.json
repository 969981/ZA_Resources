      "rawDecodedUtf16Hex": "004A201900610069002000610075007400720065002000630068006F00730065002000E0002000660061006900720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
      "displayText": "C’est d’un Pokémon Baron dont j’ai besoin !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 29,
      "offsetInSection": 3920,
      "rawDecodedUtf16Hex": "004320190065007300740020006420190075006E00200050006F006B00E9006D006F006E0020004200610072006F006E00200064006F006E00740020006A2019006100690020006200650073006F0069006E0020002100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Oh ! Un <U+0010><U+0002>ā<U+0008> ! Son rôle dans\nl’histoire devient clair dans ma tête !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
