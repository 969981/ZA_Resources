      "rawDecodedUtf16Hex": "004D0061006900730020006E006F006E00200021002000430068006F006900730069007300200075006E00200050006F006B00E9006D006F006E00200064006500200074007900700065000A005400E9006E00E800620072006500730020002100100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Un <U+0010><U+0002>ā\n ? Ça y est ! Je comprends\nles motivations de mes personnages !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 36,
      "offsetInSection": 4712,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 75
    },
    {
      "displayText": "Le quatrième Pokémon doit connaître la capacité\nTéléport. C’est lequel ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 37,
      "offsetInSection": 4864,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Mais enfin, je t’ai dit que je voulais voir\nun Pokémon qui connaît Téléport !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 38,
      "offsetInSection": 5020,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Mais bien sûr ! Un <U+0010><U+0002>ā<U+000B> !\nIl a même l’air sur le point de se téléporter !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Il ne reste plus que le dernier.\nLequel est un Pokémon de type Combat ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 40,
      "offsetInSection": 5340,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 76
    },
    {
      "displayText": "Mais voyons, tu le fais exprès ?\nJe veux voir un Pokémon de type Combat !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 41,
      "offsetInSection": 5492,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "<U+0010><U+0002>ā<U+000C> ! Quel choix excellent !<U+0010><U+0001>븁\nNotre distribution des rôles est parfaite.\nJe savais que je pouvais compter sur toi !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 42,
      "offsetInSection": 5648,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 123
    },
    {
      "displayText": "Maintenant, réfléchissons au mystère que\nnos enquêteurs vont devoir tenter d’élucider...<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 43,
      "offsetInSection": 5896,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 93
    },
    {
      "displayText": "Au fin fond des montagnes de Kalos se trouve\nle manoir du milliardaire <U+0010><U+0002>Ă<U+0002>...<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 4,
      "index": 44,
      "offsetInSection": 6084,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Cette histoire mêle les destins de trois invités...\net un trésor caché !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 45,
      "offsetInSection": 6252,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 77
    },
    {
      "displayText": "Le premier invité est un Dresseur nommé\n<U+0010><U+0002>Ă<U+0003>.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 46,
      "offsetInSection": 6408,
      "rawDecodedUtf16Hex": "004C00650020007000720065006D00690065007200200069006E00760069007400E9002000650073007400200075006E0020004400720065007300730065007500720020006E006F006D006D00E9000A0010000201020003002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Ensuite vient <U+0010><U+0002>Ă<U+0004>, qui sort\nd’une rupture amoureuse avec le milliardaire,<U+0010><U+0001>븀\npuis un collectionneur de pierres précieuses,<U+0010><U+0001>븀\nun certain <U+0010><U+0002>Ă<U+0005>.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 12,
      "flagsUpper16": 4,
      "index": 47,
      "offsetInSection": 6508,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 148
    },
    {
      "displayText": "Les invités sont accueillis par <U+0010><U+0002>Ƌ<U+0001>,\nl’intendant<U+0010><U+0003>ᄀÿ<U+0001>e du manoir.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 8,
      "flagsUpper16": 0,
      "index": 48,
      "offsetInSection": 6804,
      "rawDecodedUtf16Hex": "004C0065007300200069006E00760069007400E9007300200073006F006E00740020006100630063007500650069006C006C006900730020007000610072002000100002018B0001002C000A006C20190069006E00740065006E00640061006E007400100003110000FF000100650020006400750020006D0061006E006F00690072002E00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "Les présentations faites, le milliardaire invite\nses convives à passer dans le salon.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 6948,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Il s’agit en réalité d’un énorme coffre-fort !<U+0010><U+0001>븁\n<U+0010><U+0002>Ƌ<U+0001> explique que même la capacité\nPoing de Colère serait incapable de l’ébrécher.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 7,
      "flagsUpper16": 4,
      "index": 50,
      "offsetInSection": 7128,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "Un magnifique joyau est exposé au centre de la\npièce. Il s’agit de la Larme <U+0010><U+0003>ᐈ<U+0006><U+0001><U+0010><U+0002>Ă<U+0006>.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 9,
      "flagsUpper16": 4,
      "index": 51,
      "offsetInSection": 7404,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "La légende raconte que le joyau fut offert au\nmilliardaire par A.Z. lorsqu’il régnait sur la région.<U+0010><U+0001>븁\nLe propriétaire du manoir contemple la pierre\nprécieuse matin et soir pour embellir sa journée.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 7588,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 204
    },
    {
      "displayText": "Le lendemain matin, tout le monde est réveillé\npar un hurlement à glacer le sang !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 53,
      "offsetInSection": 7996,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "Les invités se rassemblent devant le coffre-fort, où\nle milliardaire gémit : « Mon trésor a été volé ! »<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 54,
      "offsetInSection": 8172,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 109
    },
    {
      "displayText": "« Le voleur ne peut pas être mon intendant<U+0010><U+0003>ᄀÿ<U+0001>e,\nc’est donc l’un d’entre vous ! »<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 8392,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 87
    },
    {
      "displayText": "« Pourquoi sommes-nous suspects, alors qu’<U+0010><U+0003>ᄀÿȄelleil\nne l’est pas ? », s’insurge <U+0010><U+0002>Ă<U+0004>.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
      "index": 56,
      "offsetInSection": 8568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "« <U+0010><U+0002>Ƌ<U+0001> et moi avons joué aux cartes\njusqu’à l’aube », répond le milliardaire.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 57,
      "offsetInSection": 8752,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000><U+0010><U+0002>Ă<U+0003> et <U+0010><U+0002>Ă<U+0005> acceptent\nqu’on les inspecte et qu’on fouille leurs bagages.<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 11,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 8916,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 82
    },
    {
      "displayText": "Mais le joyau reste introuvable...<U+0010><U+0001>븁\nSeule une Poké Ball est découverte sur\n<U+0010><U+0002>Ă<U+0003>, et quoi de plus normal<U+0010><U+0001>븀\npour un Dresseur ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 9,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 9080,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 132
    },
    {
      "displayText": "Alors ! À ton avis, qui a volé la Larme\n<U+0010><U+0003>ᐈ<U+0006><U+0001><U+0010><U+0002>Ă<U+0006> ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 9,
      "flagsUpper16": 4,
      "index": 60,
      "offsetInSection": 9344,
      "rawDecodedUtf16Hex": "0041006C006F0072007300200021002000C000200074006F006E00200061007600690073002C00200071007500690020006100200076006F006C00E90020006C00610020004C00610072006D0065000A0010000314080006000100100002010200060020003F00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>Ă<U+0003> !",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 9456,
      "rawDecodedUtf16Hex": "0010000201020003002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0002>Ă<U+0004> !",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 62,
      "offsetInSection": 9472,
      "rawDecodedUtf16Hex": "0010000201020004002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "<U+0010><U+0002>Ă<U+0005> !",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 9488,
      "rawDecodedUtf16Hex": "0010000201020005002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Tiens donc ! Tu n’as pas trouvé la clé de\nmon énigme ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 9504,
      "rawDecodedUtf16Hex": "005400690065006E007300200064006F006E0063002000210020005400750020006E2019006100730020007000610073002000740072006F0075007600E90020006C006100200063006C00E9002000640065000A006D006F006E002000E9006E00690067006D00650020003F00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Hé hé ! Je savais que tu comprendrais\nimmédiatement la ruse de mon récit !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 9624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Le Dresseur a laissé son Pokémon dans\nle coffre-fort et c’est LUI qui a volé le joyau !<U+0010><U+0001>븁\nQuand les invités se réunissent le lendemain,\nle complice rappelle discrètement son Pokémon<U+0010><U+0001>븀\ndans sa Poké Ball et hop ! Le tour est joué !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 9784,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 236
    },
    {
      "displayText": "Que penses-tu de cet incroyable tour\nde passe-passe ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 10256,
      "rawDecodedUtf16Hex": "005100750065002000700065006E007300650073002D00740075002000640065002000630065007400200069006E00630072006F007900610062006C006500200074006F00750072000A00640065002000700061007300730065002D007000610073007300650020003F00100002011401B50000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Ce roman est un chef-d’œuvre !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 10372,
      "rawDecodedUtf16Hex": "0043006500200072006F006D0061006E002000650073007400200075006E00200063006800650066002D0064201901530075007600720065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "La solution est évidente, non ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 69,
      "offsetInSection": 10436,
      "rawDecodedUtf16Hex": "004C006100200073006F006C007500740069006F006E0020006500730074002000E90076006900640065006E00740065002C0020006E006F006E0020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "L’indice était peut-être trop flagrant...\nMais ça fonctionne quand même, non ?<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 10500,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 83
    },
    {
      "displayText": "Grâce à toi, j’ai réussi à faire un bon en avant\nprodigieux dans ma carrière littéraire !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 10668,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "En remerciement, je te propose de réinterpréter\nmes romans pour toi.<U+0010><U+0001>븁\nMontre-moi d’autres Pokémon et ça sera à\nleur tour de jouer les rôles dans mes histoires !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 72,
      "offsetInSection": 10856,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 167
    }
  ],
