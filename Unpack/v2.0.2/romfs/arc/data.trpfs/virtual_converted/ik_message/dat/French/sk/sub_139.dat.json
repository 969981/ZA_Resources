      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Un <U+0010><U+0002>ā\t... Mais bien sûr !\nJe visualise le décor !<U+0010><U+0002>ĔƵ",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
