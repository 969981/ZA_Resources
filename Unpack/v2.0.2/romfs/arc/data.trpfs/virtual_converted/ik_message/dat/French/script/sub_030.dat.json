      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Je vais le restaurer de suite. J’en ai pour\nune minute !<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2716,
      "rawDecodedUtf16Hex": "004A0065002000760061006900730020006C00650020007200650073007400610075007200650072002000640065002000730075006900740065002E0020004A20190065006E00200061006900200070006F00750072000A0075006E00650020006D0069006E0075007400650020002100100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "Et voilà ! Je te présente le Pokémon issu\ndu Fossile Mâchoire : Ptyranidur !<U+0010><U+0002>ĔŁ",
