      "flagsUpper16": 4,
      "index": 16,
      "offsetInSection": 2840,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Et voilà ! Je te présente le Pokémon issu\ndu Fossile Nageoire : Amagara !<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
