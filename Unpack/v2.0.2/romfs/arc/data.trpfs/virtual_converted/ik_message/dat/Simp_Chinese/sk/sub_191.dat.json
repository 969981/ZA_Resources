      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 392,
      "rawDecodedUtf16Hex": "653B51FB597D51E06B21300200100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "全部命中的话，\n必定会造成巨大伤害！<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
