      "rawDecodedUtf16Hex": "8FD867092026202600100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "我说……",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
