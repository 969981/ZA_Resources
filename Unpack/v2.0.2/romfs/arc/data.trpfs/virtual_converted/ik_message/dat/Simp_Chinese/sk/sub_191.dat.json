      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "可以错开“守住”这类\n让攻击无效的招式发起攻击……<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 464,
