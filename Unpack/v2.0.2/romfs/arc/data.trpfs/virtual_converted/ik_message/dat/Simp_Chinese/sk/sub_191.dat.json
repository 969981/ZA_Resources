      "rawDecodedUtf16Hex": "534E4E3D5730FF0100100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "一气呵成地！<U+0010><U+0002>ĔǦ",
