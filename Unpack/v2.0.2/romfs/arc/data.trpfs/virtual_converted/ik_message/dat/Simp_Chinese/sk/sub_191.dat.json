      "offsetInSection": 368,
      "rawDecodedUtf16Hex": "4E006C14547562105730FF0100100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "攻击好几次。<U+0010><U+0002>ĔǦ",
