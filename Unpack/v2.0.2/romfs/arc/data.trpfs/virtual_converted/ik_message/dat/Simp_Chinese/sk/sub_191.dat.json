      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
    {
      "displayText": "连续招式全部命中就会有很强的威力，\n但有时也会打偏。<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
