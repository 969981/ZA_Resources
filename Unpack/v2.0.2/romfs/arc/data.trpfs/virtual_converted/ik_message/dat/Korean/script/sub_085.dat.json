      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "그중에서도 메가폭타의 분화를 보면\n뭔가 영감이 떠오를 것만 같아!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 588,
