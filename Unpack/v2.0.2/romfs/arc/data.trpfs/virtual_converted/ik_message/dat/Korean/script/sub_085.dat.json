      "offsetInSection": 1116,
      "rawDecodedUtf16Hex": "B108C7580020BA54AC00D3EDD0C0B97C0020BCF4ACE0000AC0C8B85CC6B40020CEECB7EC0020CF58D0DDD2B8B80CC988B97C0020B9CCB4E4ACE00020B9D0ACA0C5B4002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
