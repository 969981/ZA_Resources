      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1016,
      "rawDecodedUtf16Hex": "BCF4C5EC0020B4DCB9B4AC8CC69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "잠시만요",
