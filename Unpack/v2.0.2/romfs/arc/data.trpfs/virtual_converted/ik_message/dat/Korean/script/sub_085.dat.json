    },
    {
      "displayText": "나는 컬러 콘택트렌즈를\n디자인하고 있어!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 224,
