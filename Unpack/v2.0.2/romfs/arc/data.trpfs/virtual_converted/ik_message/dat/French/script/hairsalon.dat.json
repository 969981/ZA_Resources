    },
    {
      "displayText": "Coupe : <U+0010><U+0003>ȃ<U+0000>  <U+E300>",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "0043006F0075007000650020003A0020001000030203000000200020E3000000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "N/A",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 1868,
      "rawDecodedUtf16Hex": "004E002F00410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Je n’ai besoin de rien, merci.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 1876,
      "rawDecodedUtf16Hex": "004A00650020006E2019006100690020006200650073006F0069006E0020006400650020007200690065006E002C0020006D0065007200630069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Je vais le porter, oui.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 1940,
      "rawDecodedUtf16Hex": "004A0065002000760061006900730020006C006500200070006F0072007400650072002C0020006F00750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Pas besoin !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 79,
      "offsetInSection": 1988,
      "rawDecodedUtf16Hex": "0050006100730020006200650073006F0069006E002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
