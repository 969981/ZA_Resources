      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 105,
      "offsetInSection": 4224,
      "rawDecodedUtf16Hex": "0041006C006F00720073002C0020007100752019006500730074002D0063006500200071007500650020007400750020007600650075007800200063006F006D006D006500200063006F0075007000650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
