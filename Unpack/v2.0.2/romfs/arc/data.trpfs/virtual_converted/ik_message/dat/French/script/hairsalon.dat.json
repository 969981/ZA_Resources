      "offsetInSection": 2372,
      "rawDecodedUtf16Hex": "004A2019006100690020006200690065006E0020007000650075007200200071007500650020007400750020006E20190061006900650073002000700061007300200061007300730065007A00200064006500200050004C002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "C’est plutôt pas mal, tu trouves pas ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 90,
      "offsetInSection": 2468,
      "rawDecodedUtf16Hex": "0043201900650073007400200070006C0075007400F4007400200070006100730020006D0061006C002C002000740075002000740072006F007500760065007300200070006100730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Reviens quand tu veux !\nAu plaisir !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 91,
      "offsetInSection": 2548,
      "rawDecodedUtf16Hex": "00520065007600690065006E00730020007100750061006E00640020007400750020007600650075007800200021000A0041007500200070006C00610069007300690072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "Et le chapeau, qu’est-ce qu’on en fait ?\nTu le remets ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 92,
      "offsetInSection": 2624,
      "rawDecodedUtf16Hex": "004500740020006C006500200063006800610070006500610075002C0020007100752019006500730074002D006300650020007100752019006F006E00200065006E002000660061006900740020003F000A005400750020006C0065002000720065006D0065007400730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "Et hop !\nC’est très joli avec un chapeau aussi !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 93,
      "offsetInSection": 2736,
      "rawDecodedUtf16Hex": "0045007400200068006F007000200021000A0043201900650073007400200074007200E800730020006A006F006C00690020006100760065006300200075006E00200063006800610070006500610075002000610075007300730069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 49
    },
    {
      "displayText": "Dans ce cas, je vais remettre ton chapeau\ndans ton Sac. Et hop !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 94,
      "offsetInSection": 2836,
      "rawDecodedUtf16Hex": "00440061006E00730020006300650020006300610073002C0020006A006500200076006100690073002000720065006D0065007400740072006500200074006F006E00200063006800610070006500610075000A00640061006E007300200074006F006E0020005300610063002E00200045007400200068006F0070002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "Comme ton chapeau ne va pas avec cette coupe\nde cheveux, je l’ai rangé dans ton Sac !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 95,
      "offsetInSection": 2968,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Alors, ça te fera <U+0010><U+0003>Ȇ<U+0000>  <U+E300> !\nComment est-ce que tu veux payer ?",
      "escapedControlUnits": 4,
      "flagsUpper16": 4,
      "index": 96,
      "offsetInSection": 3140,
      "rawDecodedUtf16Hex": "0041006C006F00720073002C002000E70061002000740065002000660065007200610020001000030206000000200020E30000200021000A0043006F006D006D0065006E00740020006500730074002D006300650020007100750065002000740075002000760065007500780020007000610079006500720020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Tu es sûr<U+0010><U+0003>ᄀÿĀe que c’est ce que tu veux ?\nOn y va ?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 97,
      "offsetInSection": 3268,
      "rawDecodedUtf16Hex": "005400750020006500730020007300FB007200100003110000FF0100006500200071007500650020006320190065007300740020006300650020007100750065002000740075002000760065007500780020003F000A004F006E002000790020007600610020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Ça ressemble beaucoup à ton look actuel.\nC’est bien ce que tu veux ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 98,
      "offsetInSection": 3376,
      "rawDecodedUtf16Hex": "00C70061002000720065007300730065006D0062006C0065002000620065006100750063006F00750070002000E000200074006F006E0020006C006F006F006B002000610063007400750065006C002E000A004320190065007300740020006200690065006E0020006300650020007100750065002000740075002000760065007500780020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Génial, ça devrait te changer complètement !\nOn part là-dessus, alors ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 99,
      "offsetInSection": 3516,
      "rawDecodedUtf16Hex": "004700E9006E00690061006C002C002000E70061002000640065007600720061006900740020007400650020006300680061006E00670065007200200063006F006D0070006C00E800740065006D0065006E007400200021000A004F006E002000700061007200740020006C00E0002D006400650073007300750073002C00200061006C006F007200730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "C’est parti !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 100,
      "offsetInSection": 3660,
      "rawDecodedUtf16Hex": "00432019006500730074002000700061007200740069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Tu as changé d’avis ?\nJe t’en prie, prends ton temps pour réfléchir !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 101,
      "offsetInSection": 3688,
      "rawDecodedUtf16Hex": "005400750020006100730020006300680061006E006700E900200064201900610076006900730020003F000A004A00650020007420190065006E00200070007200690065002C0020007000720065006E0064007300200074006F006E002000740065006D0070007300200070006F007500720020007200E90066006C00E90063006800690072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Tu ne veux plus changer de coiffure, finalement ?\nOn arrête tout, alors ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 102,
      "offsetInSection": 3828,
      "rawDecodedUtf16Hex": "005400750020006E00650020007600650075007800200070006C007500730020006300680061006E00670065007200200064006500200063006F006900660066007500720065002C002000660069006E0061006C0065006D0065006E00740020003F000A004F006E002000610072007200EA0074006500200074006F00750074002C00200061006C006F007200730020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "D’accord.\nJe te raccompagne à la réception, dans ce cas !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 103,
      "offsetInSection": 3976,
      "rawDecodedUtf16Hex": "00442019006100630063006F00720064002E000A004A006500200074006500200072006100630063006F006D007000610067006E0065002000E00020006C00610020007200E900630065007000740069006F006E002C002000640061006E00730020006300650020006300610073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "D’accord, prends tout le temps dont tu as besoin\npour réfléchir !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 104,
      "offsetInSection": 4092,
      "rawDecodedUtf16Hex": "00442019006100630063006F00720064002C0020007000720065006E0064007300200074006F007500740020006C0065002000740065006D0070007300200064006F006E00740020007400750020006100730020006200650073006F0069006E000A0070006F007500720020007200E90066006C00E90063006800690072002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 66
    },
    {
