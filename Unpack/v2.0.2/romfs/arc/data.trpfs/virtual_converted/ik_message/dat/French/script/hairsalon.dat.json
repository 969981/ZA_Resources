      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 2016,
      "rawDecodedUtf16Hex": "0050006100790065007200200065006E0020006C0069007100750069006400650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
