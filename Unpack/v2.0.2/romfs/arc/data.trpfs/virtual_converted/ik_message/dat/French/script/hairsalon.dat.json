      "offsetInSection": 2268,
      "rawDecodedUtf16Hex": "004A2019006100690020006200690065006E0020007000650075007200200071007500650020007400750020006E20190061006900650073002000700061007300200061007300730065007A0020006420190061007200670065006E0074002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "J’ai bien peur que tu n’aies pas assez de PL...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
