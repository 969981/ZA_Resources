      "flagsUpper16": 4,
      "index": 106,
      "offsetInSection": 4312,
      "rawDecodedUtf16Hex": "004F006E002000700061007200740020006C00E0002D006400650073007300750073002C00200064007500200063006F007500700020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
