      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "Bienvenue !\nQu’est-ce qu’on te fait, aujourd’hui ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "004200690065006E00760065006E0075006500200021000A005100752019006500730074002D006300650020007100752019006F006E00200074006500200066006100690074002C002000610075006A006F00750072006420190068007500690020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 51
    },
    {
      "displayText": "OK, allons-y, alors !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 87,
      "offsetInSection": 2224,
      "rawDecodedUtf16Hex": "004F004B002C00200061006C006C006F006E0073002D0079002C00200061006C006F00720073002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "J’ai bien peur que tu n’aies pas assez d’argent...",
