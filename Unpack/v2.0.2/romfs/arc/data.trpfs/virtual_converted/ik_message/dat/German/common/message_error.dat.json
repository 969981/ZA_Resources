      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1648,
      "rawDecodedUtf16Hex": "004400690065002000560065007200620069006E00640075006E00670020007A0075006D002000530065007200760065007200200077007500720064006500200075006E00740065007200620072006F006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Der Verbindungsaufbau zum Spielpartner ist\nfehlgeschlagen. Bitte führe alle Schritte noch\neinmal durch.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Die Verbindung zum Spielpartner wurde\nunterbrochen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1948,
      "rawDecodedUtf16Hex": "004400690065002000560065007200620069006E00640075006E00670020007A0075006D00200053007000690065006C0070006100720074006E00650072002000770075007200640065000A0075006E00740065007200620072006F006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Ein Systemfehler ist aufgetreten.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 2052,
      "rawDecodedUtf16Hex": "00450069006E002000530079007300740065006D006600650068006C00650072002000690073007400200061007500660067006500740072006500740065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Ein Fehler ist aufgetreten. Es ist kein\nPokémon-Tausch zustande gekommen.\n\nBitte drücke den HOME-Knopf, um das Spiel zu\nbeenden.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 2120,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 129
    },
    {
      "displayText": "Es wurden keine Speicherdaten auf deiner\nKonsole erkannt.\n\nBitte schalte die Konsole aus und versuche es\nnoch einmal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2380,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 118
    },
    {
      "displayText": "Die Teilnahme ist nicht möglich, da die\nTeilnahmefrist bereits abgelaufen ist.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 2616,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Die Teilnahme ist nicht möglich, da die maximale\nTeilnehmerzahl bereits erreicht wurde.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2776,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
    },
    {
      "displayText": "Es konnten keine Mitspieler gefunden werden.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2952,
      "rawDecodedUtf16Hex": "004500730020006B006F006E006E00740065006E0020006B00650069006E00650020004D006900740073007000690065006C0065007200200067006500660075006E00640065006E002000770065007200640065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Die Verbindung zum Internet ist fehlgeschlagen.\nBitte versuche es erneut.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 3044,
      "rawDecodedUtf16Hex": "004400690065002000560065007200620069006E00640075006E00670020007A0075006D00200049006E007400650072006E0065007400200069007300740020006600650068006C00670065007300630068006C006100670065006E002E000A00420069007400740065002000760065007200730075006300680065002000650073002000650072006E006500750074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 74
    },
    {
      "displayText": "Es ist ein Fehler auf dem Server aufgetreten.\nBitte versuche es erneut.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 3192,
      "rawDecodedUtf16Hex": "004500730020006900730074002000650069006E0020004600650068006C006500720020006100750066002000640065006D002000530065007200760065007200200061007500660067006500740072006500740065006E002E000A00420069007400740065002000760065007200730075006300680065002000650073002000650072006E006500750074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 72
    },
    {
      "displayText": "Der Server wird momentan gewartet.\nBitte versuche es später noch einmal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 3336,
      "rawDecodedUtf16Hex": "0044006500720020005300650072007600650072002000770069007200640020006D006F006D0065006E00740061006E002000670065007700610072007400650074002E000A0042006900740074006500200076006500720073007500630068006500200065007300200073007000E40074006500720020006E006F00630068002000650069006E006D0061006C002E0000",
      "trailingZeroPaddingUnits": 1,
