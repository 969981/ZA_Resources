      "offsetInSection": 692,
      "rawDecodedUtf16Hex": "00440069006500730065007200200053006500720076006900630065002000770069007200640020006E00690063006800740020006D00650068007200200075006E0074006500720073007400FC0074007A0074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "Beim Überprüfen des Seriencodes ist ein Fehler\nauf dem Server aufgetreten. Bitte versuche es\nspäter noch einmal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 3,
