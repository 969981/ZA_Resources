      "index": 7,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "00440065007200200056006F007200670061006E00670020007700750072006400650020006100750066006700720075006E0064002000650069006E006500730020004600650068006C006500720073000A006200650065006E006400650074002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Die Verbindung zum Server wurde unterbrochen.",
