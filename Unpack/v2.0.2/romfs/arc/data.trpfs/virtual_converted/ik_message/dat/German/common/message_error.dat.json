      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Der Server, über den die Seriencodes überprüft\nwerden, ist aufgrund von Wartungsarbeiten nicht\nerreichbar. Bitte versuche es später noch einmal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
