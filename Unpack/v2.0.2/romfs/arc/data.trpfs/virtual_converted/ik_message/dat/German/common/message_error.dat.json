      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Beim Überprüfen des Seriencodes ist ein Fehler\nauf dem Server aufgetreten. Bitte versuche es\nspäter noch einmal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 1008,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 113
    },
    {
      "displayText": "Der Server, über den die Seriencodes überprüft\nwerden, ist ausgelastet. Bitte versuche es später\nnoch einmal.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 1236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 110
    },
    {
      "displayText": "Die Verbindung zum Server wurde unterbrochen.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 1456,
      "rawDecodedUtf16Hex": "004400690065002000560065007200620069006E00640075006E00670020007A0075006D002000530065007200760065007200200077007500720064006500200075006E00740065007200620072006F006300680065006E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Der Vorgang wurde aufgrund eines Fehlers\nbeendet.",
