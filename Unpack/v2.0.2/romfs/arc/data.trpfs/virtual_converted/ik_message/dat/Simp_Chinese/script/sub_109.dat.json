      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "只要追着烛光灵，\n也许就能找到我妹妹！<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 580,
