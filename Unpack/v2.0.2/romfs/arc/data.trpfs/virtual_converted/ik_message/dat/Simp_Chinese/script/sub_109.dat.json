      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "要是我妹妹的生命力被吸取掉……\n就这么回不来了的话……<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "8981662F621159B959B97684751F547D529B88AB543853D6638920262026000A5C318FD94E4856DE4E0D67654E8676848BDD2026202600100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 32
    },
    {
      "displayText": "拜托你！\n帮我找到我妹妹吧！<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "62DC62584F60FF01000A5E2E6211627E5230621159B959B95427FF0100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "咻啵……啵啵……",
