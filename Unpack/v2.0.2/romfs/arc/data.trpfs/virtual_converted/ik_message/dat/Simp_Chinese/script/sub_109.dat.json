      "rawDecodedUtf16Hex": "54BB55752026202655755575202620260000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "是烛光灵！！<U+0010><U+0002>Ĕƅ",
