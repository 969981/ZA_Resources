      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 848,
      "rawDecodedUtf16Hex": "8C0367E54E004E0B000A4E0B6C34905376846DF15904542730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
