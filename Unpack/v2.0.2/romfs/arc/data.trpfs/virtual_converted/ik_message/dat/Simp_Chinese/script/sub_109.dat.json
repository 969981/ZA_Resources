      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "这、这种事\n你要交给我这个大人呀！<U+0010><U+0001>븀\n而且我比你更有生命力！<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1428,
