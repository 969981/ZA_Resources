      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "5E2E5E2E6211FF0100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "我的妹妹\n跟着烛光灵走了！<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
