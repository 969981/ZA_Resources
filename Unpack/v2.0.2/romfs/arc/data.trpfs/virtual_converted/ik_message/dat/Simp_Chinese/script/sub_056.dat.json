      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "就是那家伙！\n那只超大的步哨鼠！<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 312,
      "rawDecodedUtf16Hex": "5C31662F90A35BB64F19FF01000A90A353EA8D85592776846B6554E89F20FF0100100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "我在等那家伙离开\n全息传送梯，<U+0010><U+0001>븀\n但那家伙就是一动不动的……<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 356,
      "rawDecodedUtf16Hex": "621157287B4990A35BB64F1979BB5F00000A5168606F4F20900168AFFF0C00100001BE00000A4F4690A35BB64F195C31662F4E0052A84E0D52A876842026202600100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 37
    },
    {
      "displayText": "那么大的家伙，\n我的宝可梦肯定打不赢……<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 432,
      "rawDecodedUtf16Hex": "90A34E48592776845BB64F19FF0C000A621176845B9D53EF68A680AF5B9A62534E0D8D622026202600100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "啊～有没有强到能打倒\n那家伙的训练家呀～？<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 484,
      "rawDecodedUtf16Hex": "554AFF5E67096CA167095F3A523080FD62535012000A90A35BB64F1976848BAD7EC35BB65440FF5EFF1F00100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
