      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "还能发现稀有的\n宝可梦或道具什么的。<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 892,
      "rawDecodedUtf16Hex": "8FD880FD53D173B07A0067097684000A5B9D53EF68A66216905351774EC04E487684300200100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "虽然我不想被别人先找到，\n但这次就让给你吧！<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 940,
