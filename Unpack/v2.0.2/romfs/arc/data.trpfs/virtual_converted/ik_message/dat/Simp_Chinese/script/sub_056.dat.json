    },
    {
      "displayText": "嘘～！\n会被那家伙发现的！<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 276,
