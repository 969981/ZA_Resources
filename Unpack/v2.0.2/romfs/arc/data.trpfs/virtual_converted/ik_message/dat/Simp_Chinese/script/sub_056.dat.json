      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "你也想乘全息传送梯\n到上面去吗？<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
