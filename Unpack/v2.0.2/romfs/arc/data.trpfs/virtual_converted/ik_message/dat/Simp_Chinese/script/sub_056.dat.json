      "rawDecodedUtf16Hex": "4F604E5F60F34E585168606F4F20900168AF000A52304E0A976253BB5417FF1F00100002011401570000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "屋顶的探险会令人兴奋不已，对吧？\n各种建筑物都连通在一起！<U+0010><U+0002>Ĕŗ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
