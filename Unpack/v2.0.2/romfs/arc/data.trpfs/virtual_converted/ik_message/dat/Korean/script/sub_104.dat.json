      "offsetInSection": 3068,
      "rawDecodedUtf16Hex": "D2B8B808C774B108B2D8C5D0AC8C0020B9E1AE30B2940020AC8C000ACD5CC120C774C9C00020C54AC744AE4C003F00100001BE01000AC5ECAE30C5D00020BC29CE58D5740020B480B2E4AC00000AC791D488C7440020B354B7FDD788AE30B77CB3C40020D588B2E4AC040020D070C77CC774C796C544002E00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
