      "offsetInSection": 2928,
      "rawDecodedUtf16Hex": "C5F4C14B002E002E002E003F00100002011401970000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "오잉!?\n13마리로 늘어났잖아...!?<U+0010><U+0002>ĔƗ",
