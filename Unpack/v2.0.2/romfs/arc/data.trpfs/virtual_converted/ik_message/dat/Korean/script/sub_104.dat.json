      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "분떠도리들을 그만\n미술관에서 잃어버리고 말았어요...<U+0010><U+0002>ĔƘ",
      "escapedControlUnits": 2,
