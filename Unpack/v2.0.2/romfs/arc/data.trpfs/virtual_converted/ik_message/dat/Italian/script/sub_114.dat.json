    },
    {
      "displayText": "Non per niente sei l’Allenat<U+0010><U+0003>ᄀÿ̂orrice più forte\ndi Luminopoli.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
