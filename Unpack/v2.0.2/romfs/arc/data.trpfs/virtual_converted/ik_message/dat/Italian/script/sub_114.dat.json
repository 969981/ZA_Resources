      "offsetInSection": 1572,
      "rawDecodedUtf16Hex": "0041006C00200063006F006E00660072006F006E0074006F002C00200069006F002E002E002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
