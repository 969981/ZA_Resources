      "rawDecodedUtf16Hex": "0049006E0020007200650061006C007400E00020006400650076006F00200061006E00640061007200650000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Capisco. Anche tu hai le tue faccende a cui\npensare...<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1096,
      "rawDecodedUtf16Hex": "004300610070006900730063006F002E00200041006E00630068006500200074007500200068006100690020006C00650020007400750065002000660061006300630065006E00640065002000610020006300750069000A00700065006E0073006100720065002E002E002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "Sarà un onore far pratica con un<U+0010><U+0003>ᄀÿଊ Allenator’Allenatrice\ndi rango A.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 4,
