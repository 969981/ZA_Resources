      "rawDecodedUtf16Hex": "0047006F0072006F003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Avanti, voi due, l’uscita è di là.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 2800,
      "rawDecodedUtf16Hex": "004100760061006E00740069002C00200076006F00690020006400750065002C0020006C2019007500730063006900740061002000E80020006400690020006C00E0002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Maestro Albis!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2880,
      "rawDecodedUtf16Hex": "004D00610065007300740072006F00200041006C006200690073002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, Semina... Avete scacciato voi\nquei due Pangoro?<U+0010><U+0002>Ĕ<U+0011>",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2920,
      "rawDecodedUtf16Hex": "0010000201000000002C002000530065006D0069006E0061002E002E002E002000410076006500740065002000730063006100630063006900610074006F00200076006F0069000A00710075006500690020006400750065002000500061006E0067006F0072006F003F00100002011400110000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Sì! Quei due piantagrane hanno avuto una bella\nlezione, grazie all’aiuto di <U+0010><U+0002>Ā<U+0000>.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 3036,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "Non per niente è <U+0010><U+0003>ᄀÿఋil salvatorla salvatrice di Luminopoli.\nOggi ho potuto intravedere la sua vera forza.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 4,
