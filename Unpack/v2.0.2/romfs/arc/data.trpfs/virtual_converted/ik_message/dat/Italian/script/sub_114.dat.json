      "rawDecodedUtf16Hex": "00500041004E0047004F004F004F004800210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 10
    },
    {
      "displayText": "Quelli sono i famigerati Pangoro scatenati!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 2060,
      "rawDecodedUtf16Hex": "005100750065006C006C006900200073006F006E006F00200069002000660061006D0069006700650072006100740069002000500061006E0067006F0072006F002000730063006100740065006E006100740069002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Sono due Pangoro che vanno in giro a seminare\nil panico tenendosi alla larga dalle zone selvagge.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
