      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ottimo lavoro, <U+0010><U+0002>Ā<U+0000>!<U+0010><U+0002>Ĕ3",
