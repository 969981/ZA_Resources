      "offsetInSection": 2156,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 102
    },
    {
      "displayText": "Sono così pericolosi che persino il maestro Albis\nfa fatica a scacciarli.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2360,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 78
    },
    {
      "displayText": "Ma in assenza del maestro, è compito mio\ndifendere questo dojo.<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 2516,
      "rawDecodedUtf16Hex": "004D006100200069006E00200061007300730065006E007A0061002000640065006C0020006D00610065007300740072006F002C002000E800200063006F006D007000690074006F0020006D0069006F000A0064006900660065006E0064006500720065002000710075006500730074006F00200064006F006A006F002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 68
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000>, lotta con me per favore!<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2652,
      "rawDecodedUtf16Hex": "0010000201000000002C0020006C006F00740074006100200063006F006E0020006D006500200070006500720020006600610076006F00720065002100100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+001A>",
