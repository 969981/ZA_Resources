      "index": 12,
      "offsetInSection": 1368,
      "rawDecodedUtf16Hex": "005300650069002000710075006900200070006500720020006C0061002000730066006900640061003F00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 26
    },
    {
