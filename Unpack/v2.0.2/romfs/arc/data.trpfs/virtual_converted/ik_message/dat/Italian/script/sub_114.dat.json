      "index": 33,
      "offsetInSection": 3208,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 112
    },
    {
      "displayText": "Al confronto, io...<U+0010><U+0002>Ĕ3",
