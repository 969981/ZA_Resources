      "rawDecodedUtf16Hex": "004E006F006E00200070006500720020006E00690065006E0074006500200073006500690020006C20190041006C006C0065006E0061007400100003110000FF0302006F0072007200690063006500200070006900F900200066006F007200740065000A006400690020004C0075006D0069006E006F0070006F006C0069002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 69
    },
    {
      "displayText": "Al confronto, io...<U+0010><U+0002>Ĕ3",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
