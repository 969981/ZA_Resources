      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1620,
      "rawDecodedUtf16Hex": "002E002E002E0020006E006F006E00200068006F0020006E00650061006E00630068006500200075006E002000620072006900630069006F006C006F002000640065006C006C0061002000740075006100200066006F0072007A0061002E00100002011400330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
