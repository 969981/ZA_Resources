      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "¡Despierta! ¡¿Estás bien?!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 28,
      "offsetInSection": 2280,
      "rawDecodedUtf16Hex": "00A10044006500730070006900650072007400610021002000A100BF00450073007400E100730020006200690065006E003F002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Uf, menos mal que volviste en ti.<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 29,
      "offsetInSection": 2344,
      "rawDecodedUtf16Hex": "00550066002C0020006D0065006E006F00730020006D0061006C002000710075006500200076006F006C0076006900730074006500200065006E002000740069002E00100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "Mi hermana dice que vino aquí a ayudar\nal Litwick...<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 30,
      "offsetInSection": 2420,
      "rawDecodedUtf16Hex": "004D00690020006800650072006D0061006E0061002000640069006300650020007100750065002000760069006E006F002000610071007500ED002000610020006100790075006400610072000A0061006C0020004C00690074007700690063006B002E002E002E00100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 57
    },
    {
      "displayText": "Tengo entendido que los Litwick absorben\nla energía vital de la gente para recuperarse.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 31,
      "offsetInSection": 2536,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 92
    },
    {
      "displayText": "Y este pobre no se encontraba muy bien,\nasí que vine para prestarle un poco de la mía.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 2720,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "¡¿Pero qué?! Deja que nos encarguemos de esas\ncosas los mayores, ¿entendiste? Ya sabes<U+0010><U+0001>븀\nque yo tengo mucha más fuerza vital que tú.<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 2904,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 138
    },
    {
      "displayText": "Tienes razón, lo sieeento.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 34,
      "offsetInSection": 3180,
      "rawDecodedUtf16Hex": "005400690065006E00650073002000720061007A00F3006E002C0020006C006F002000730069006500650065006E0074006F002E00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Te agradezco que te hayas tomado la molestia\nde venir a buscarme.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 3244,
      "rawDecodedUtf16Hex": "005400650020006100670072006100640065007A0063006F002000710075006500200074006500200068006100790061007300200074006F006D00610064006F0020006C00610020006D006F006C00650073007400690061000A00640065002000760065006E00690072002000610020006200750073006300610072006D0065002E00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Bueno, espero que te sientas mejor pronto.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 36,
      "offsetInSection": 3384,
      "rawDecodedUtf16Hex": "004200750065006E006F002C002000650073007000650072006F00200071007500650020007400650020007300690065006E0074006100730020006D0065006A006F0072002000700072006F006E0074006F002E00100002011400220000",
      "trailingZeroPaddingUnits": 1,
