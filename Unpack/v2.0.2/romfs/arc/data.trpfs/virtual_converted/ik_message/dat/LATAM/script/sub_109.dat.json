      "offsetInSection": 1928,
      "rawDecodedUtf16Hex": "00530061006D00750065006C0020006D00650020007000690064006900F30020006100790075006400610000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
