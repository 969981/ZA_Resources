      "rawDecodedUtf16Hex": "00BF004400F3006E00640065002000650073007400E100200065006C0020004C00690074007700690063006B003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
    {
      "displayText": "Ji, ji... ¿Por eso viniste a buscarme?<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 2020,
      "rawDecodedUtf16Hex": "004A0069002C0020006A0069002E002E002E002000BF0050006F0072002000650073006F002000760069006E0069007300740065002000610020006200750073006300610072006D0065003F00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "Mi hermano siempre se preocupa demasiado.<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 26,
      "offsetInSection": 2108,
      "rawDecodedUtf16Hex": "004D00690020006800650072006D0061006E006F0020007300690065006D0070007200650020007300650020007000720065006F0063007500700061002000640065006D00610073006900610064006F002E00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 46
    },
    {
      "displayText": "Ji, ji, ji... Ya falta muy poco...<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 27,
      "offsetInSection": 2200,
