      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1468,
      "rawDecodedUtf16Hex": "004E006F0020007300650020007600650020006E006900200075006E00200073006F006C006F00200050006F006B00E9006D006F006E002000730061006C00760061006A0065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Investiga el interior de las alcantarillas.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 1548,
      "rawDecodedUtf16Hex": "0049006E007600650073007400690067006100200065006C00200069006E0074006500720069006F00720020006400650020006C0061007300200061006C00630061006E0074006100720069006C006C00610073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 44
    },
    {
      "displayText": "¿Mi hermana está aquí dentro?\nEspero que esté bien...<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1636,
      "rawDecodedUtf16Hex": "00BF004D00690020006800650072006D0061006E0061002000650073007400E1002000610071007500ED002000640065006E00740072006F003F000A00450073007000650072006F0020007100750065002000650073007400E90020006200690065006E002E002E002E00100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "¡Date prisa! ¡No lo perdamos de vista!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1752,
      "rawDecodedUtf16Hex": "00A100440061007400650020007000720069007300610021002000A1004E006F0020006C006F002000700065007200640061006D006F0073002000640065002000760069007300740061002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 43
    },
    {
      "displayText": "¿Entró ahí...?<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1840,
      "rawDecodedUtf16Hex": "00BF0045006E0074007200F300200061006800ED002E002E002E003F00100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+0015>",
      "escapedControlUnits": 3,
