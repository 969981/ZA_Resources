      "offsetInSection": 1880,
      "rawDecodedUtf16Hex": "00100002BDFF00150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "¿Quién eres?<U+0010><U+0002>Ĕ\"",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1892,
      "rawDecodedUtf16Hex": "00BF00510075006900E9006E00200065007200650073003F00100002011400220000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Samuel me pidió ayuda",
