    },
    {
      "displayText": "¡Necesito ayuda!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 320,
      "rawDecodedUtf16Hex": "00A1004E006500630065007300690074006F002000610079007500640061002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "¡Mi hermanita se fue detrás de un Litwick\ny no ha regresado!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 364,
      "rawDecodedUtf16Hex": "00A1004D00690020006800650072006D0061006E00690074006100200073006500200066007500650020006400650074007200E1007300200064006500200075006E0020004C00690074007700690063006B000A00790020006E006F002000680061002000720065006700720065007300610064006F002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 65
    },
    {
      "displayText": "¡Sé que los Litwick absorben la energía vital\nde la gente!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 496,
      "rawDecodedUtf16Hex": "00A1005300E900200071007500650020006C006F00730020004C00690074007700690063006B0020006100620073006F007200620065006E0020006C006100200065006E00650072006700ED006100200076006900740061006C000A006400650020006C0061002000670065006E00740065002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 63
    },
    {
      "displayText": "Solo con imaginar que eso pueda pasarle a mi\nhermana... Solo con pensar en que no volverá...<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 624,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 97
    },
    {
      "displayText": "¡Porfa! ¡Tienes que ayudarme a encontrarla!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 820,
      "rawDecodedUtf16Hex": "00A10050006F0072006600610021002000A1005400690065006E0065007300200071007500650020006100790075006400610072006D00650020006100200065006E0063006F006E0074007200610072006C0061002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Lit, lit... wick...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 6,
      "offsetInSection": 916,
      "rawDecodedUtf16Hex": "004C00690074002C0020006C00690074002E002E002E0020007700690063006B002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "¡Un Litwick!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 956,
      "rawDecodedUtf16Hex": "00A10055006E0020004C00690074007700690063006B002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "¡A lo mejor podemos seguirlo para encontrar\na mi hermana!<U+0010><U+0002>Ĕƅ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "00A100410020006C006F0020006D0065006A006F007200200070006F00640065006D006F00730020007300650067007500690072006C006F0020007000610072006100200065006E0063006F006E0074007200610072000A00610020006D00690020006800650072006D0061006E0061002100100002011401850000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 62
    },
    {
