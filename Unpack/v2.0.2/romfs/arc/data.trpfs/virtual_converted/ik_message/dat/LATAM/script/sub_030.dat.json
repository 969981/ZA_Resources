      "trailingZeroPaddingUnits": 1,
      "utf16Units": 59
    },
    {
      "displayText": "¡Listo! ¡Logré recrear un Tyrunt a partir\ndel Fósil Mandíbula!<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2668,
