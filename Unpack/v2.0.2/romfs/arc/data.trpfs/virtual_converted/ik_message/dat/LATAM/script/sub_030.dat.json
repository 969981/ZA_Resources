      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 104
    },
    {
      "displayText": "Por cierto, primero asegúrate de tener\nespacio libre en las cajas.<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 2280,
      "rawDecodedUtf16Hex": "0050006F0072002000630069006500720074006F002C0020007000720069006D00650072006F0020006100730065006700FA0072006100740065002000640065002000740065006E00650072000A006500730070006100630069006F0020006C006900620072006500200065006E0020006C00610073002000630061006A00610073002E00100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 71
    },
    {
      "displayText": "<U+0010><U+0002>봆<U+0000>Así que me trajiste\nun <U+0010><U+0002>ĉ<U+0002>, ¿eh?<U+0010><U+0001>븀\n¡Muchas gracias!<U+0010><U+0002>ĔŁ",
      "escapedControlUnits": 10,
