      "rawDecodedUtf16Hex": "00A1004A006F00760065006E00630069007400100003110000FF0101006F00610021002000BF004D006500200063006F006D00700072006100730074006500200065006C0020006600F300730069006C0020007100750065002000740065002000700065006400ED003F00100002011401410000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 58
    },
    {
      "displayText": "Eh... ¿No me compraste ningún fósil todavía?<U+0010><U+0002>ĔŁ",
