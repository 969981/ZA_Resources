      "trailingZeroPaddingUnits": 1,
      "utf16Units": 31
    },
    {
      "displayText": "Airmu !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 34,
      "offsetInSection": 4020,
      "rawDecodedUtf16Hex": "004100690072006D0075002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 8
    },
    {
      "displayText": "Merci beaucoup ! Je parlerai de toi au chef !<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 35,
      "offsetInSection": 4036,
