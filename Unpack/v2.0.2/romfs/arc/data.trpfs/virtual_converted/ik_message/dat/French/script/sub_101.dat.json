      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2992,
      "rawDecodedUtf16Hex": "004D007500750075002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Hein ?! Oh, non !<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
