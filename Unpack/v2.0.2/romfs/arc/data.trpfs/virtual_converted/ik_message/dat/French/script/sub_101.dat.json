      "offsetInSection": 3148,
      "rawDecodedUtf16Hex": "00100002BDFF001A0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Ouf, il s’est calmé... Mais pourquoi cet Airmure\nnous a-t-il attaqués ?<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
