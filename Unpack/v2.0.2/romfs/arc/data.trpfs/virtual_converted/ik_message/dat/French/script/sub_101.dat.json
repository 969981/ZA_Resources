      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "Passe au Firmament pour goûter les plats\nqu’il va préparer avec son nouveau couteau !<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
