      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "C’était une perle décorative. Dommage !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 2532,
      "rawDecodedUtf16Hex": "0043201900E9007400610069007400200075006E00650020007000650072006C00650020006400E90063006F007200610074006900760065002E00200044006F006D006D006100670065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 40
    },
    {
      "displayText": "C’était un sequin scintillant. Dommage !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 2612,
      "rawDecodedUtf16Hex": "0043201900E9007400610069007400200075006E002000730065007100750069006E0020007300630069006E00740069006C006C0061006E0074002E00200044006F006D006D006100670065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Je t’ai vu<U+0010><U+0003>ᄀÿĀe ramasser cette plume d’Airmure,\ndonc je suis venu en évitant les Némélios.<U+0010><U+0001>븀\nElle va faire un excellent couteau de cuisine !<U+0010><U+0002>ĔŽ",
