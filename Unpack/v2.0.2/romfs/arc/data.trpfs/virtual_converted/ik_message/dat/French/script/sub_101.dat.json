      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 4420,
      "rawDecodedUtf16Hex": "004A0065002000700065006E00730065002C0020006F00750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 15
    },
