      "offsetInSection": 756,
      "rawDecodedUtf16Hex": "C0ACC591D560AC8CC6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "정말이지 멋진 대답이네요!<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 8,
