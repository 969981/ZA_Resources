      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "정말 멋지시네요!\n그럼, 다음 승부를 시작해 볼까요?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 928,
      "rawDecodedUtf16Hex": "C815B9D00020BA4BC9C0C2DCB124C6940021000AADF8B7FC002C0020B2E4C74C0020C2B9BD80B97C0020C2DCC791D5740020BCFCAE4CC694003F00100002011400150000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "시작해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 996,
      "rawDecodedUtf16Hex": "C2DCC791D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
