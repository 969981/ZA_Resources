      "offsetInSection": 1008,
      "rawDecodedUtf16Hex": "ADF8B9CCD560B798C6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "아직 <U+0010><U+0003>ȅ<U+0002><U+0000>번밖에 안 싸웠는데\n벌써 그만두시는 건가요?<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 7,
      "flagsUpper16": 0,
