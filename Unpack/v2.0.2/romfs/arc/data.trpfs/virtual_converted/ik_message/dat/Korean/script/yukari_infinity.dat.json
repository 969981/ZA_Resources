      "rawDecodedUtf16Hex": "ACC4C18DD574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "그만하게 해 주세요...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
