      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "<U+0010><U+0002>Ā<U+0000><U+0010><U+0003>ᄀÿȂ先生小姐，\n<U+0010><U+0003>ᄀÿā你妳可知<U+0010><U+0002>＀<U+0006>D<U+0010><U+0002>＀<U+0000>代表著什麼嗎？<U+0010><U+0002>Ĕ<U+0015>",
