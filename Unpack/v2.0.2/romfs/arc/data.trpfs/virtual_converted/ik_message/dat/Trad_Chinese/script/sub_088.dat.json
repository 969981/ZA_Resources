      "rawDecodedUtf16Hex": "90FD712162408B020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "太可惜了！我的存在本身就是頂級，\n不需要特意放進名稱裡。<U+0010><U+0002>Ĕ<U+0015>",
      "escapedControlUnits": 3,
