      "rawDecodedUtf16Hex": "005200690065006E00200070006F007500720020006C00650020006D006F006D0065006E00740000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Souhaitez-vous lancer le Défi Méga-Furieux ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 55,
      "offsetInSection": 4540,
      "rawDecodedUtf16Hex": "0053006F007500680061006900740065007A002D0076006F007500730020006C0061006E0063006500720020006C00650020004400E9006600690020004D00E900670061002D00460075007200690065007500780020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 45
    },
    {
      "displayText": "Oui !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 56,
      "offsetInSection": 4632,
      "rawDecodedUtf16Hex": "004F00750069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "En quoi ça consiste ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 57,
      "offsetInSection": 4644,
      "rawDecodedUtf16Hex": "0045006E002000710075006F0069002000E7006100200063006F006E007300690073007400650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "Quel est mon meilleur score ?",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 58,
      "offsetInSection": 4688,
      "rawDecodedUtf16Hex": "005100750065006C00200065007300740020006D006F006E0020006D00650069006C006C006500750072002000730063006F007200650020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 30
    },
    {
      "displayText": "Non merci.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 59,
      "offsetInSection": 4748,
      "rawDecodedUtf16Hex": "004E006F006E0020006D0065007200630069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 11
    },
    {
      "displayText": "Le <U+0010><U+0002>＀<U+0006>Défi Méga-Furieux<U+0010><U+0002>＀<U+0000> consiste en une série de\ncombats contre des Pokémon Méga-Ferox<U+0010><U+0001>븀\nau cours desquels certaines règles s’appliquent.<U+0010><U+0001>븁\nVous ne pouvez pas changer les Pokémon\nde votre équipe.<U+0010><U+0001>븁\nLe défi prend fin dès que vous perdez un combat.<U+0010><U+0001>븁\nVous pouvez soigner votre équipe,\nmais seulement TROIS fois.<U+0010><U+0001>븁\nEnfin, si vous parvenez à vaincre tous les Pokémon\ndu défi, j’enregistrerai votre temps.",
      "escapedControlUnits": 16,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 4772,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 411
    },
    {
      "displayText": "Je vous préviens, ce défi est très difficile.\nÊtes-vous sûr<U+0010><U+0003>ᄀÿĀe de vouloir le relever ?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 61,
      "offsetInSection": 5596,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Oui !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 62,
      "offsetInSection": 5776,
      "rawDecodedUtf16Hex": "004F00750069002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "Non...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 63,
      "offsetInSection": 5788,
      "rawDecodedUtf16Hex": "004E006F006E002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "Prêt<U+0010><U+0003>ᄀÿĀe pour le combat suivant ?",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 64,
      "offsetInSection": 5804,
      "rawDecodedUtf16Hex": "0050007200EA007400100003110000FF0100006500200070006F007500720020006C006500200063006F006D006200610074002000730075006900760061006E00740020003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 36
    },
    {
      "displayText": "Je suis prêt<U+0010><U+0003>ᄀÿĀe !",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 65,
      "offsetInSection": 5876,
      "rawDecodedUtf16Hex": "004A00650020007300750069007300200070007200EA007400100003110000FF01000065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 21
    },
    {
      "displayText": "Je veux soigner mon équipe.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 66,
      "offsetInSection": 5920,
      "rawDecodedUtf16Hex": "004A00650020007600650075007800200073006F00690067006E006500720020006D006F006E002000E900710075006900700065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
      "displayText": "Je préfère abandonner...",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 67,
      "offsetInSection": 5976,
      "rawDecodedUtf16Hex": "004A006500200070007200E9006600E8007200650020006100620061006E0064006F006E006E00650072002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Vous pouvez soigner votre équipe encore <U+0010><U+0002>Ȁ<U+0003> fois.\nVoulez-vous vraiment soigner vos Pokémon ?",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 68,
      "offsetInSection": 6028,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 94
    },
    {
      "displayText": "Oui.",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 69,
      "offsetInSection": 6216,
      "rawDecodedUtf16Hex": "004F00750069002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Non, pas encore.",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 70,
      "offsetInSection": 6228,
      "rawDecodedUtf16Hex": "004E006F006E002C002000700061007300200065006E0063006F00720065002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 17
    },
    {
      "displayText": "Si vous abandonnez maintenant, j’enregistrerai\nvotre nombre de victoires, mais vous devrez<U+0010><U+0001>븀\nreprendre le défi depuis le début la prochaine fois.<U+0010><U+0001>븁\nVoulez-vous vraiment abandonner ?",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 6264,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 184
    },
    {
      "displayText": "Oh non, quel dommage...\nN’hésitez pas à retenter votre chance !",
      "escapedControlUnits": 0,
      "flagsUpper16": 4,
      "index": 72,
      "offsetInSection": 6632,
      "rawDecodedUtf16Hex": "004F00680020006E006F006E002C0020007100750065006C00200064006F006D006D006100670065002E002E002E000A004E2019006800E90073006900740065007A0020007000610073002000E000200072006500740065006E00740065007200200076006F0074007200650020006300680061006E00630065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "Vous avez remporté <U+0010><U+0002>ȁ<U+0004> victoire<U+0010><U+0003>ᄁ<U+0004>Ās !\nRecommencez pour battre votre record !",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 73,
      "offsetInSection": 6760,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 80
    },
    {
      "displayText": "Vous avez remporté le défi en <U+0010><U+0002>ȁ<U+0005>:<U+0010><U+0002>ȁ<U+0006>:<U+0010><U+0002>ȁ<U+0007>,<U+0010><U+0002>ȁ<U+0008> !",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 74,
      "offsetInSection": 6920,
      "rawDecodedUtf16Hex": "0056006F007500730020006100760065007A002000720065006D0070006F0072007400E90020006C00650020006400E90066006900200065006E00200010000202010005003A0010000202010006003A0010000202010007002C0010000202010008002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Votre record est de <U+0010><U+0002>ȁ<U+0004> victoire<U+0010><U+0003>ᄁ<U+0004>Ās.",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 7024,
      "rawDecodedUtf16Hex": "0056006F0074007200650020007200650063006F0072006400200065007300740020006400650020001000020201000400200076006900630074006F006900720065001000031101000401000073002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "Ça alors, vous avez vaincu tous les Pokémon !\nFélicitations ! C’est un véritable exploit !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 76,
      "offsetInSection": 7108,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 91
    },
    {
      "displayText": "Vous avez remporté le défi en <U+0010><U+0002>ȁ<U+0005>:<U+0010><U+0002>ȁ<U+0006>:<U+0010><U+0002>ȁ<U+0007>,<U+0010><U+0002>ȁ<U+0008> !",
      "escapedControlUnits": 12,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 7292,
      "rawDecodedUtf16Hex": "0056006F007500730020006100760065007A002000720065006D0070006F0072007400E90020006C00650020006400E90066006900200065006E00200010000202010005003A0010000202010006003A0010000202010007002C0010000202010008002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Revenez me voir quand vous voulez pour\nrecommencer !",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 78,
      "offsetInSection": 7396,
      "rawDecodedUtf16Hex": "0052006500760065006E0065007A0020006D006500200076006F006900720020007100750061006E006400200076006F0075007300200076006F0075006C0065007A00200070006F00750072000A007200650063006F006D006D0065006E006300650072002000210000",
      "trailingZeroPaddingUnits": 1,
