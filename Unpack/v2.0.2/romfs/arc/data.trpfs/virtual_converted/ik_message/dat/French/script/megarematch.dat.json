      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Bravo !\nVotre temps pour ce combat est de <U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005> !<U+0010><U+0002>Ĕ<U+000E>",
