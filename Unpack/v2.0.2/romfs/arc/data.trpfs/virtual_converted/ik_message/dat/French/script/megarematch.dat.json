      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "<U+0010><U+0002>ā<U+0002> ? Très bien.\nÊtes-vous prêt<U+0010><U+0003>ᄀÿĀe pour le combat ?<U+0010><U+0002>Ĕ<U+000E>",
