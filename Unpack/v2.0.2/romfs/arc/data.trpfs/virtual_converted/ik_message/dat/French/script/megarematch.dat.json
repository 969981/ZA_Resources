      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Votre record de temps contre <U+0010><U+0002>ā<U+0002>\nest de <U+0010><U+0002>ȁ<U+0003>:<U+0010><U+0002>ȁ<U+0004>,<U+0010><U+0002>ȁ<U+0005>.<U+0010><U+0001>븀\nÊtes-vous prêt<U+0010><U+0003>ᄀÿĀe pour un autre combat ?<U+0010><U+0002>Ĕ<U+000E>",
