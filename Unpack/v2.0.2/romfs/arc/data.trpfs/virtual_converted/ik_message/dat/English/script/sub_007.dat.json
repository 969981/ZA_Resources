      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "Oh nooo... My Kakuna evolved into a Beedrill!<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
