    },
    {
      "displayText": "Wow, you’re real strong. My Kakuna must’ve\nlearned a lot from that battle.<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1152,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 79
    },
    {
      "displayText": "Ah! I hope they didn’t get too many Exp. Points\nthough!<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 14,
      "offsetInSection": 1312,
