      "index": 15,
      "offsetInSection": 1432,
      "rawDecodedUtf16Hex": "004F00680020006E006F006F006F002E002E002E0020004D00790020004B0061006B0075006E0061002000650076006F006C00760065006400200069006E0074006F002000610020004200650065006400720069006C006C0021001000020114012B0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 50
    },
    {
      "displayText": "At this rate, I won’t have a team of the strongest\nKakuna...<U+0010><U+0002>Ĕī",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 16,
