      "rawDecodedUtf16Hex": "00100002BDFF00180000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Vielen Dank! Das ist also ein Flabébé\nmit einer gelben Blume!<U+0010><U+0002>ĔŴ",
