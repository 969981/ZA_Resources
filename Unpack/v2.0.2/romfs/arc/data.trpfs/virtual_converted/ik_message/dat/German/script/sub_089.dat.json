      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1664,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Es heißt, man findet dieses Pokémon in der Nähe\nvon Blumenbeeten sowie auf Dachterrassen,<U+0010><U+0001>븀\ndie nur selten von Menschen frequentiert werden.<U+0010><U+0001>븁\nZeig mir bitte fünf Flabébé, deren Blume jeweils\neine andere Farbe hat!<U+0010><U+0002>ĔŴ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 8,
      "offsetInSection": 1676,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 221
    },
