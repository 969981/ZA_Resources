      "offsetInSection": 5316,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 127
    },
    {
      "displayText": "Im Friseursalon ist jetzt die Haarfarbe Weiß\nverfügbar.",
