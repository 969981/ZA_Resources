      "index": 30,
      "offsetInSection": 4236,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 141
    },
    {
      "displayText": "Im Friseursalon ist jetzt die Haarfarbe Orange\nverfügbar.",
