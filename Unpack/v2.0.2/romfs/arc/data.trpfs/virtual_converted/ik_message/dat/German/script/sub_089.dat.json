      "flagsUpper16": 0,
      "index": 39,
      "offsetInSection": 5572,
      "rawDecodedUtf16Hex": "0049006D0020004600720069007300650075007200730061006C006F006E00200069007300740020006A00650074007A007400200064006900650020004800610061007200660061007200620065002000570065006900DF000A007600650072006600FC0067006200610072002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 56
    },
    {
      "displayText": "<U+0010><U+0002>뷿(",
      "escapedControlUnits": 2,
