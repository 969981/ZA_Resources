      "trailingZeroPaddingUnits": 1,
      "utf16Units": 48
    },
    {
      "displayText": "Und aus ihr tritt eine merkwürdige Energie aus.<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 10,
      "offsetInSection": 1344,
      "rawDecodedUtf16Hex": "0055006E006400200061007500730020006900680072002000740072006900740074002000650069006E00650020006D00650072006B007700FC0072006400690067006500200045006E006500720067006900650020006100750073002E00100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 52
    },
    {
      "displayText": "Mit der Megamanie-Entwicklung scheint das\ndiesmal nix zu tun zu haben...<U+0010><U+0001>븁\nAber mit der Quelle dieser Energie ist trotzdem\nnicht zu spaßen, kapiert?<U+0010><U+0002>Ĕ<U+0013>",
      "escapedControlUnits": 5,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1448,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 154
    },
    {
      "displayText": "Der Quelle?",
