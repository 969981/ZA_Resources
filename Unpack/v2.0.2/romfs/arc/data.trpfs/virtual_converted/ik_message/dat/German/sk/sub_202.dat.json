      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1796,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 90
    },
    {
      "displayText": "Geht der Sache auf den Grund.<U+0010><U+0002>Ĕ<U+0013>",
