      "offsetInSection": 1780,
      "rawDecodedUtf16Hex": "0057006100720075006D003F0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 7
    },
    {
      "displayText": "In der Verzerrung... im Zentrum dieser Energie...\nscheint sich ein Hoopa zu befinden.<U+0010><U+0002>Ĕ<U+0013>",
