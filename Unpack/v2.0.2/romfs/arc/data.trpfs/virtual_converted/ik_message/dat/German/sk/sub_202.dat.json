      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 1976,
      "rawDecodedUtf16Hex": "004700650068007400200064006500720020005300610063006800650020006100750066002000640065006E0020004700720075006E0064002E00100002011400130000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "Was ist da los?<U+0010><U+0002>Ĕ<U+0006>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 2044,
      "rawDecodedUtf16Hex": "00570061007300200069007300740020006400610020006C006F0073003F00100002011400060000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 20
    },
    {
      "displayText": "Was ist da los?<U+0010><U+0002>Ĕ<U+0005>",
