      "trailingZeroPaddingUnits": 1,
      "utf16Units": 61
    },
    {
      "displayText": "<U+0010><U+0002>뷿<U+000D>",
      "escapedControlUnits": 3,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 1924,
      "rawDecodedUtf16Hex": "00100002BDFF000D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Es-tu prêt<U+0010><U+0003>ᄀÿĀe à admirer l’élégance, la rapidité\net la fluidité de mes capacités à coups multiples ?<U+0010><U+0002>ĔǦ",
