      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "C’était si beau...<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 2524,
      "rawDecodedUtf16Hex": "0043201900E9007400610069007400200073006900200062006500610075002E002E002E00100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 23
    },
    {
      "displayText": "Ce combat était tout bonnement fantastique.\nJ’ai beaucoup appris.<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 2572,
      "rawDecodedUtf16Hex": "0043006500200063006F006D006200610074002000E9007400610069007400200074006F0075007400200062006F006E006E0065006D0065006E0074002000660061006E00740061007300740069007100750065002E000A004A201900610069002000620065006100750063006F007500700020006100700070007200690073002E00100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 70
    },
    {
      "displayText": "Certes, si tous les coups font mouche, les dégâts\nsont dévastateurs, mais rien ne garantit que<U+0010><U+0001>븀\nchaque coup touchera sa cible...<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 4,
