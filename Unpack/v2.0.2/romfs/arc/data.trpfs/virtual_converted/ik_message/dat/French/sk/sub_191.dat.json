      "offsetInSection": 1936,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 107
    },
    {
      "displayText": "Prêt<U+0010><U+0003>ᄀÿĀe !",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 15,
      "offsetInSection": 2152,
      "rawDecodedUtf16Hex": "0050007200EA007400100003110000FF01000065002000210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
    {
      "displayText": "Pas encore...",
