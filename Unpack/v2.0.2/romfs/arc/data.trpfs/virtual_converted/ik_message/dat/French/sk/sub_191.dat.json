  "messages": [
    {
      "displayText": "Les capacités à coups multiples sont de véritables\nmerveilles de stratégie !<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 0,
      "offsetInSection": 284,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 81
    },
    {
      "displayText": "Elles sont rapides !<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 1,
      "offsetInSection": 448,
      "rawDecodedUtf16Hex": "0045006C006C0065007300200073006F006E0074002000720061007000690064006500730020002100100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 25
    },
    {
      "displayText": "Élégantes !<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
