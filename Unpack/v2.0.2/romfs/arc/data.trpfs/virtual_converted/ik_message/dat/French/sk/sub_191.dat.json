      "rawDecodedUtf16Hex": "00500061007300200065006E0063006F00720065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Aucun problème. Prends ton temps !<U+0010><U+0002>ĔǦ",
      "escapedControlUnits": 2,
      "flagsUpper16": 4,
      "index": 17,
      "offsetInSection": 2208,
      "rawDecodedUtf16Hex": "0041007500630075006E002000700072006F0062006C00E8006D0065002E0020005000720065006E0064007300200074006F006E002000740065006D007000730020002100100002011401E60000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Alors, c’est parti pour ce combat qui enchaînera\nrapidité...<U+0010><U+0002>ĔǦ",
