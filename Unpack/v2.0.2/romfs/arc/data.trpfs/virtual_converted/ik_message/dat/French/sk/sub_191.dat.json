      "flagsUpper16": 4,
      "index": 18,
      "offsetInSection": 2288,
      "rawDecodedUtf16Hex": "0041006C006F00720073002C00200063201900650073007400200070006100720074006900200070006F0075007200200063006500200063006F006D006200610074002000710075006900200065006E00630068006100EE006E006500720061000A007200610070006900640069007400E9002E002E002E00100002011401E60000",
      "trailingZeroPaddingUnits": 1,
