      "rawDecodedUtf16Hex": "0045006E0020006D00690020006E006F002000740061006E002000680075006D0069006C006400650020006F00700069006E006900F3006E002C0020006300720065006F002000710075006500200064006500620065007200ED00610073000A0070006100720074006900630069007000610072002E00100002011400160000",
      "trailingZeroPaddingUnits": 1,
