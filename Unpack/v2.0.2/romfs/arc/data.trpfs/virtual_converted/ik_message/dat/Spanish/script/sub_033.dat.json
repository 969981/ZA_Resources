      "offsetInSection": 184,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "¡Quiero que aprenda Psicocorte, un movimiento\nque usa cuchillas psíquicas y mola un montón!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 2,
      "offsetInSection": 376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 96
    },
    {
      "displayText": "¡Sí, sí, así como lo oyes!<U+0010><U+0001>븁\nImagina la precisión que tendría mi compañero\nsi pudiera cortar cosas con el poder de la mente.<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 3,
      "offsetInSection": 568,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 130
    },
    {
      "displayText": "Quiero que le pidas a un Pokémon que ataque\na este muñeco sustituto con <U+0010><U+0002>＀<U+0006>Psicocorte<U+0010><U+0002>＀<U+0000>, porfa.<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 8,
