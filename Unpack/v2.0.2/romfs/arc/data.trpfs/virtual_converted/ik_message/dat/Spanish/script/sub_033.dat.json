      "offsetInSection": 2100,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 137
    },
    {
      "displayText": "Ahora que mi compañero controla todos los\ncortes de Furfrou habidos y por haber, va siendo<U+0010><U+0001>븀\nhora de aceptar clientes de manera oficial.<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 4,
