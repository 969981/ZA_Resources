      "rawDecodedUtf16Hex": "00100002BDFF00050000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Pídele a algún Pokémon que use <U+0010><U+0002>＀<U+0006>Psicocorte<U+0010><U+0002>＀<U+0000> para\natacar a este muñeco sustituto, ¿vale?<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 8,
