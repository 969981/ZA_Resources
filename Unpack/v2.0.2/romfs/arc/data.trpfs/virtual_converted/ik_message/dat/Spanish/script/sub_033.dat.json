    },
    {
      "displayText": "Scyther necesita seguir puliendo sus dotes\nde peluquero, así que ¿puedo pedirte otro favor?<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
