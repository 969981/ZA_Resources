      "flagsUpper16": 0,
      "index": 7,
      "offsetInSection": 1244,
      "rawDecodedUtf16Hex": "00100002BDFF00070000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "Pero bueno, ¡que te he pedido usar <U+0010><U+0002>＀<U+0006>Psicocorte<U+0010><U+0002>＀<U+0000>!\n¿Me estás vacilando o qué?<U+0010><U+0002>Ĕł",
