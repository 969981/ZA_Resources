      "index": 8,
      "offsetInSection": 1256,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 86
    },
    {
      "displayText": "¡Cómo impresiona Psicocorte viéndolo en directo!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 9,
      "offsetInSection": 1428,
      "rawDecodedUtf16Hex": "00A1004300F3006D006F00200069006D00700072006500730069006F006E006100200050007300690063006F0063006F00720074006500200076006900E9006E0064006F006C006F00200065006E0020006400690072006500630074006F002100100002011401420000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "Nada como unas cuchillas formadas por energía\npsíquica para conseguir un resultado profesional.<U+0010><U+0002>Ĕł",
