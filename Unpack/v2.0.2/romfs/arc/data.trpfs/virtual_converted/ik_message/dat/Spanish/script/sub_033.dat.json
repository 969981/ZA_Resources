      "index": 16,
      "offsetInSection": 2376,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 142
    },
    {
      "displayText": "¡No sé qué habría sido de nuestro negocio\nde no ser por tu ayuda!<U+0010><U+0002>Ĕł",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 2660,
      "rawDecodedUtf16Hex": "00A1004E006F0020007300E900200071007500E90020006800610062007200ED00610020007300690064006F0020006400650020006E00750065007300740072006F0020006E00650067006F00630069006F000A006400650020006E006F002000730065007200200070006F0072002000740075002000610079007500640061002100100002011401420000",
      "trailingZeroPaddingUnits": 1,
