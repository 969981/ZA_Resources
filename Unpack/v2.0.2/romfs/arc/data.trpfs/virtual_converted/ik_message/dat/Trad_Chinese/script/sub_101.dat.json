      "trailingZeroPaddingUnits": 1,
      "utf16Units": 22
    },
    {
      "displayText": "真可惜……！\n是鑰圈兒的鑰匙碎片。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 13,
      "offsetInSection": 992,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A662F947057085152768494705319788E724730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "真可惜……！\n是掘地兔的體毛。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 14,
      "offsetInSection": 1028,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A662F63985730515476849AD46BDB30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "真可惜……！\n是哈力栗的刺的一部分。",
