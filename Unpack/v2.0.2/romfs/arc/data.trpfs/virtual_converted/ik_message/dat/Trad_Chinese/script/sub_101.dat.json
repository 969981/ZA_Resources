      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "真可惜……！\n是雌性火炎獅的鬃毛。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 16,
      "offsetInSection": 1100,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A662F96CC6027706B708E734576849B036BDB30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "真可惜……！\n是雄性火炎獅的鬃毛。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 17,
      "offsetInSection": 1136,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A662F96C46027706B708E734576849B036BDB30020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "真可惜……！\n這是閃閃發光的小石子。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 18,
      "offsetInSection": 1172,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A9019662F95839583767C514976845C0F77F35B5030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 19
    },
    {
      "displayText": "真可惜……！\n這是閃閃發光的珠子。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 19,
      "offsetInSection": 1212,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A9019662F95839583767C5149768473E05B5030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "真可惜……！\n這是閃閃發光的亮片。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 20,
      "offsetInSection": 1248,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A9019662F95839583767C514976844EAE724730020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "我察覺到<U+0010><U+0003>ᄀÿā你妳找到了盔甲鳥的羽毛，\n所以就躲開火炎獅過來了！<U+0010><U+0001>븀\n這會是很厲害的菜刀喔！<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 6,
      "flagsUpper16": 0,
      "index": 21,
      "offsetInSection": 1284,
      "rawDecodedUtf16Hex": "62115BDF89BA523000100003110000FF01014F6059B3627E52304E8676D475329CE576847FBD6BDBFF0C000A62404EE55C318EB2958B706B708E7345904E4F864E86FF0100100001BE00000A90196703662F5F8853B25BB3768483DC52005594FF01001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
