      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "呼……為什麼盔甲鳥\n會襲擊過來呢？<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
