    },
    {
      "displayText": "鋼甲鳥寶可夢盔甲鳥……<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 1,
      "offsetInSection": 376,
