      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 22,
      "offsetInSection": 1392,
      "rawDecodedUtf16Hex": "93D7FF5E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "怎麼會這樣！？<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 23,
      "offsetInSection": 1400,
      "rawDecodedUtf16Hex": "600E9EBC670390196A23FF01FF1F001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 12
    },
    {
      "displayText": "不好意思，\n拜託<U+0010><U+0003>ᄀÿā你妳把盔甲鳥趕走吧。<U+0010><U+0002>ĔŽ",
      "escapedControlUnits": 4,
      "flagsUpper16": 0,
      "index": 24,
      "offsetInSection": 1424,
      "rawDecodedUtf16Hex": "4E0D597D610F601DFF0C000A62DC8A1700100003110000FF01014F6059B3628A76D475329CE58D958D7054273002001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 28
    },
    {
