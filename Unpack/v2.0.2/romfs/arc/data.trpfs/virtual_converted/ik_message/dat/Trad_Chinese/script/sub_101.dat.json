      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 25,
      "offsetInSection": 1480,
      "rawDecodedUtf16Hex": "93D7FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
