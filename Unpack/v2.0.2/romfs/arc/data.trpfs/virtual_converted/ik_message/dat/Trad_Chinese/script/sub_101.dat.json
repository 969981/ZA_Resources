      "flagsUpper16": 0,
      "index": 33,
      "offsetInSection": 1836,
      "rawDecodedUtf16Hex": "4F609858610F8B937D66621155CEFF1F001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 13
    },
