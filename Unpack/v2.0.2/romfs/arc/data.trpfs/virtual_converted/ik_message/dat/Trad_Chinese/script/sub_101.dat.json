      "rawDecodedUtf16Hex": "76D475329CE576847FBD6BDB6389572857304E0A20262026FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "真可惜……！\n是盔甲鳥的爪子。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 916,
      "rawDecodedUtf16Hex": "771F53EF60DC20262026FF01000A662F76D475329CE57684722A5B5030020000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 16
    },
    {
      "displayText": "真可惜……！\n是燈火幽靈的火焰燒剩的殘渣。",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 12,
      "offsetInSection": 948,
