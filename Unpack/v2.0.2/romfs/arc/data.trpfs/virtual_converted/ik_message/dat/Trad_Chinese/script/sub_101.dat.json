      "index": 31,
      "offsetInSection": 1720,
      "rawDecodedUtf16Hex": "53EA89814ED6505A51FA8D8A591A597D5403768465997406FF0C000A5C3180FD8B935BC6963F96F776844EBA501162165BF653EF59225E78798F300200100001BE00000A62DC8A174F604E86FF018ACB628A7FBD6BDB8B937D66621154273002001000020114017D0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "鏗！",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 32,
      "offsetInSection": 1828,
      "rawDecodedUtf16Hex": "93D7FF010000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 3
    },
    {
      "displayText": "你願意讓給我嗎？<U+0010><U+0002>ĔŽ",
