  "messages": [
    {
      "displayText": "Bonjour ! Tu es Dresseu<U+0010><U+0003>ᄀÿȁrse, non ? Enchantée !\nMoi, c’est Ervie, je suis factrice !<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 4,
