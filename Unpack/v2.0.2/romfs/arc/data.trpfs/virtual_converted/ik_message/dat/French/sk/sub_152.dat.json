      "trailingZeroPaddingUnits": 1,
      "utf16Units": 39
    },
    {
      "displayText": "Très bien, je vais expliquer à Mime Jr. ce qu’il\ndoit faire, et toi, tu devras le surveiller.<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
