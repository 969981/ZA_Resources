      "offsetInSection": 1712,
      "rawDecodedUtf16Hex": "00500061007300200065006E0063006F00720065002E002E002E0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 14
    },
    {
      "displayText": "Je sais... je t’en demande beaucoup...\nMais je t’en prie... fais-le pour Mime Jr. !<U+0010><U+0002>Ĕƿ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 11,
      "offsetInSection": 1740,
      "rawDecodedUtf16Hex": "",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 88
