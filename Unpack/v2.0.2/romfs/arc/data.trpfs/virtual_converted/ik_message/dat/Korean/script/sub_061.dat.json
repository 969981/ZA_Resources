      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "네가 트리미앙을 충분히 빛낼 때까지\n기다리고 있을게.<U+0010><U+0002>Ĕŝ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
