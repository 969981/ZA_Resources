      "trailingZeroPaddingUnits": 1,
      "utf16Units": 60
    },
    {
      "displayText": "저와 승부할 수 있는 조건은\n지닌 포켓몬에 트리미앙만을 넣는 것!<U+0010><U+0002>ĔŠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
