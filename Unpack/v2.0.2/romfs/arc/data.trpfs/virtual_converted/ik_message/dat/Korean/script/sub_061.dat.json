      "index": 81,
      "offsetInSection": 5560,
      "rawDecodedUtf16Hex": "C7A0C2DCB9CCC6940000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "후후...\n충분히 준비하고 오세요.<U+0010><U+0002>ĔŠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 82,
