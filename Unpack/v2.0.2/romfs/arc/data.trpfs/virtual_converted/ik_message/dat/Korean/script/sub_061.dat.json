      "trailingZeroPaddingUnits": 1,
      "utf16Units": 64
    },
    {
      "displayText": "승부해요!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 80,
      "offsetInSection": 5548,
      "rawDecodedUtf16Hex": "C2B9BD80D574C69400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 6
    },
    {
      "displayText": "잠시만요",
