      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
    {
      "displayText": "완벽한 커트를 자랑하는\n저의 트리미앙 6마리를 이길 수 있을까요?<U+0010><U+0002>ĔŠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 75,
      "offsetInSection": 5128,
      "rawDecodedUtf16Hex": "C644BCBDD55C0020CEE4D2B8B97C0020C790B791D558B294000AC800C7580020D2B8B9ACBBF8C55900200036B9C8B9ACB97C0020C774AE380020C2180020C788C744AE4CC694003F00100002011401600000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 41
    },
