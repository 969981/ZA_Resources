      "rawDecodedUtf16Hex": "00100002BDFF004C0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "트리미앙 챔피언의 왕좌를 건\n최후의 결전을 시작하시죠!<U+0010><U+0002>ĔŠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 77,
      "offsetInSection": 5224,
      "rawDecodedUtf16Hex": "D2B8B9ACBBF8C5590020CC54D53CC5B8C7580020C655C88CB97C0020AC74000ACD5CD6C4C7580020ACB0C804C7440020C2DCC791D558C2DCC8E0002100100002011401600000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 35
    },
    {
