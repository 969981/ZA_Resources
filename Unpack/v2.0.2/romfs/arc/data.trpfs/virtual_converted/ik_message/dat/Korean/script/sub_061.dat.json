      "offsetInSection": 5740,
      "rawDecodedUtf16Hex": "C9C0AE08002E002E002E0020C7740020BBF8B974C5D0C11C000AB204AD6CBCF4B2E40020D2B8B9ACBBF8C559C7440020C0ACB791D558B2940020C0ACB78CC74000100001BE00000A0010000201000000002C0020B2F9C2E0C774AD70C694002100100002011401600000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 53
    },
    {
      "displayText": "트리미앙 챔피언이 되신 것을 축하드려요!<U+0010><U+0002>ĔŠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 86,
      "offsetInSection": 5848,
      "rawDecodedUtf16Hex": "D2B8B9ACBBF8C5590020CC54D53CC5B8C7740020B418C2E00020AC83C7440020CD95D558B4DCB824C694002100100002011401600000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "축하드려요!<U+0010><U+0002>Ĕł",
