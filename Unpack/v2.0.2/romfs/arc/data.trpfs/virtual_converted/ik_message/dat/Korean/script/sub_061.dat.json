      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "트리미앙 사천왕\n다이아컷 전문가 금강이라고 한다.<U+0010><U+0002>ĔŞ",
      "escapedControlUnits": 2,
