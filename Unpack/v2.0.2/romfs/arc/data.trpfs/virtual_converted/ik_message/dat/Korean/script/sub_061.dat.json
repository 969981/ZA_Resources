      "trailingZeroPaddingUnits": 1,
      "utf16Units": 34
    },
    {
      "displayText": "하지만 트리미앙리그는\n아직 끝나지 않았답니다.<U+0010><U+0002>ĔŠ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 71,
      "offsetInSection": 4784,
