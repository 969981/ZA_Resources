      "rawDecodedUtf16Hex": "00100002BDFF00330000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 5
    },
    {
      "displayText": "제 파크로우와\n승부해 주실 건가요?<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 52,
      "offsetInSection": 3440,
      "rawDecodedUtf16Hex": "C81C0020D30CD06CB85CC6B0C640000AC2B9BD80D5740020C8FCC2E40020AC74AC00C694003F00100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 24
    },
