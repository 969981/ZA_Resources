      "trailingZeroPaddingUnits": 1,
      "utf16Units": 54
    },
    {
      "displayText": "까아!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 60,
      "offsetInSection": 3912,
      "rawDecodedUtf16Hex": "AE4CC54400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "트레이너님,\n오늘 일은 절대 못 잊을 거예요.<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
