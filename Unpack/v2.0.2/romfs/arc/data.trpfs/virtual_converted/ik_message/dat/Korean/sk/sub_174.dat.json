      "trailingZeroPaddingUnits": 1,
      "utf16Units": 42
    },
    {
      "displayText": "승부할 준비가 되면\n제게 말을 걸어 주세요!<U+0010><U+0002>Ĕǌ",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 49,
      "offsetInSection": 3360,
      "rawDecodedUtf16Hex": "C2B9BD80D5600020C900BE44AC000020B418BA74000AC81CAC8C0020B9D0C7440020AC78C5B40020C8FCC138C694002100100002011401CC0000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 29
    },
    {
      "displayText": "까아!",
      "escapedControlUnits": 0,
      "flagsUpper16": 0,
      "index": 50,
      "offsetInSection": 3420,
      "rawDecodedUtf16Hex": "AE4CC54400210000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 4
    },
    {
      "displayText": "<U+0010><U+0002>뷿3",
