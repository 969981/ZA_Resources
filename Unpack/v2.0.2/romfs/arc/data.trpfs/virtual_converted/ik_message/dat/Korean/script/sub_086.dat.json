      "trailingZeroPaddingUnits": 1,
      "utf16Units": 18
    },
    {
      "displayText": "어둠포켓몬 특유의 다크한 느낌!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
