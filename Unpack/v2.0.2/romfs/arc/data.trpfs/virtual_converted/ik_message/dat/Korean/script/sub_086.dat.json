      "trailingZeroPaddingUnits": 1,
      "utf16Units": 38
    },
    {
      "displayText": "부탁할게!\n배틀에서 내게 메가깜까미를 보여 줘!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
