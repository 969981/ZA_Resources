      "trailingZeroPaddingUnits": 1,
      "utf16Units": 67
    },
    {
      "displayText": "깜까미!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 4,
      "offsetInSection": 488,
      "rawDecodedUtf16Hex": "AE5CAE4CBBF8002100100002011401730000",
      "trailingZeroPaddingUnits": 1,
      "utf16Units": 9
    },
    {
      "displayText": "특히 메가깜까미의 눈을 보면\n뭔가 영감이 떠오를 것만 같아!<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
      "flagsUpper16": 0,
      "index": 5,
      "offsetInSection": 508,
