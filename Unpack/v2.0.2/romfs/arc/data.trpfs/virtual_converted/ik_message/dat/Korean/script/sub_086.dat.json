      "trailingZeroPaddingUnits": 1,
      "utf16Units": 27
    },
    {
      "displayText": "컬러 콘택트렌즈의 메가진화는\n이게 끝이 아닐 거야...<U+0010><U+0002>Ĕų",
      "escapedControlUnits": 2,
